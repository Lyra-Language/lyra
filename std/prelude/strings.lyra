module std.prelude
//! String helpers: trimming, prefix and suffix tests, searching and splitting.
//!
//! Everything here is **rune-indexed**, matching `s[i]` and `s.len()` — an offset or a
//! result named an index counts code points, never bytes. The searches walk bytes
//! internally, which is an implementation detail reconciled at the boundary.

// Written here in Lyra rather than as compiler builtins, by the same rule that
// puts `parse_i64` here and `read_line` in the compiler: `len`, `slice` and `s[i]`
// are primitive because a UTF-8 walk needs the decoder, and everything built on
// them is ordinary code. Trimming is a loop over runes and one slice, so it is
// ordinary code.

/// Whether this rune is one of the five ASCII whitespace characters: space, tab, newline,
/// carriage return, form feed.
///
/// **Deliberately not Unicode's full `White_Space` set.** That larger set needs a table
/// (U+00A0, U+2000–200A, U+3000 and more), and a table belongs in a real Unicode library
/// rather than smuggled into a prelude; a caller trimming input from a keyboard or a file
/// wants exactly these five. Anything wider should be an explicit choice made against a
/// real table, not a default nobody can see.
pub let is_ascii_space = pure noalloc (self: rune) -> bool => {
  let c = i64(self);
  c == 32 || c == 9 || c == 10 || c == 13 || c == 12
}

/// `self` with leading whitespace removed.
///
/// Whitespace is what `is_ascii_space` accepts. Allocates: a substring is a copy, since a
/// ref-counted box's header sits at its start and a pointer into the middle cannot reach
/// it — so this is `pure` but not `noalloc`.
pub let trim_start = pure (self: string) -> string => {
  let n = self.len();
  var i = 0;
  var scanning = true;
  for scanning && i < n {
    if self[i].is_ascii_space() { i = i + 1 } else { scanning = false }
  }
  self.slice(i, n)
}

/// `self` with trailing whitespace removed.
///
/// Allocates, as `trim_start` does.
pub let trim_end = pure (self: string) -> string => {
  let n = self.len();
  var end = n;
  var scanning = true;
  for scanning && end > 0 {
    if self[end - 1].is_ascii_space() { end = end - 1 } else { scanning = false }
  }
  self.slice(0, end)
}

/// `self` with whitespace removed from both ends.
///
/// One pass over each end and a **single** allocation — `self.trim_start().trim_end()`
/// reads better and allocates twice, building a whole intermediate string only to copy
/// most of it again. An all-whitespace input yields `""`.
///
/// # Complexity
///
/// |            | Best | Average | Worst |
/// | ---------- | ---- | ------- | ----- |
/// | **Time**   | O(n) | O(n)    | O(n)  |
/// | **Memory** | O(1) | O(n)    | O(n)  |
///
/// Both ends are scanned whatever they hold, so time does not vary. Memory is the copy
/// `slice` makes: an all-whitespace input yields `""` and copies nothing, a string with no
/// whitespace copies all of it.
///
/// # Examples
///
/// ```
/// let name = read_line().unwrap_or("").trim()
/// ```
pub let trim = pure (self: string) -> string => {
  let n = self.len();
  var i = 0;
  var scanning = true;
  for scanning && i < n {
    if self[i].is_ascii_space() { i = i + 1 } else { scanning = false }
  }
  var end = n;
  scanning = true;
  for scanning && end > i {
    if self[end - 1].is_ascii_space() { end = end - 1 } else { scanning = false }
  }
  self.slice(i, end)
}

// **Byte-level, and that is not an approximation.** UTF-8 is prefix-free and
// self-synchronizing, so for well-formed strings a byte-prefix is exactly a
// rune-prefix and a byte-suffix exactly a rune-suffix — every Lyra string is
// well-formed, so one memcmp answers the language-level question. This is the same
// property `impl Ord for string` leans on: byte order is code-point order.
//
// The rune-indexed version these replaced was O(m²) for a prefix and O(n·m) for a
// suffix, because `s[i]` is O(i) — and it paid an O(n) `len()` before comparing
// anything, so `s.starts_with("--")` on a 2000-rune string decoded the whole string
// to answer a question about its first two bytes. Measured, the length calls alone
// were 99.7% of it. These are O(m) with no decoding at all.

/// Whether `self` begins with `other`.
///
/// Every string is the prefix of itself, and `""` is a prefix of everything.
///
/// # Complexity
///
/// |            | Best | Average | Worst |
/// | ---------- | ---- | ------- | ----- |
/// | **Time**   | O(1) | O(m)    | O(m)  |
/// | **Memory** | O(1) | O(1)    | O(1)  |
///
/// m is the length of `other`, and the bound is in *m* rather than n — one `memcmp`, no
/// decoding, and no O(n) length call, which is what makes this usable from the code that
/// most wants a cheap prefix test. The best case is a difference in the first byte.
///
/// # Examples
///
/// ```
/// if arg.starts_with("--") { … }
/// ```
pub let starts_with = pure noalloc (self: string, other: string) -> bool =>
  self.compare_bytes_at(0, other) == 0

// The suffix test is the prefix test **offset**, and that is the whole of it: the
// comparison must start where the suffix would, not at 0. Comparing `self[i]` against
// `other[i]` is a prefix test whichever direction the loop runs — which is what
// `ends_with` first did, so `"hello".ends_with("lo")` was false and
// `"hello".ends_with("he")` was true, each answering the other one's question.
//
// A negative offset needs no guard: `compare_bytes_at` is total, and answers negative
// for a range that does not exist.

/// Whether `self` ends with `other`.
///
/// # Complexity
///
/// |            | Best | Average | Worst |
/// | ---------- | ---- | ------- | ----- |
/// | **Time**   | O(1) | O(m)    | O(m)  |
/// | **Memory** | O(1) | O(1)    | O(1)  |
///
/// The same `memcmp` as `starts_with`, offset to where the suffix would begin.
pub let ends_with = pure noalloc (self: string, other: string) -> bool =>
  self.compare_bytes_at(self.byte_len() - other.byte_len(), other) == 0

/// How many bytes this rune encodes to in UTF-8: 1 below U+0080, 2 below U+0800, 3 below
/// U+10000, 4 above.
///
/// Computed from the code point alone, so it needs no string to look at. It is what lets a
/// rune walk keep a byte cursor alongside it — the trick that makes `index` linear, since
/// advancing by `s[i]` instead would be quadratic.
pub let utf8_len = pure noalloc (self: rune) -> i64 => {
  let cp = i64(self);
  if cp < 128 { 1 } else if cp < 2048 { 2 } else if cp < 65536 { 3 } else { 4 }
}

/// A position in a string, counted in runes.
pub type Index = i64
/// A span of a string, counted in runes.
pub type Length = i64

/// Things that can be searched for in a string.
///
/// Implemented for `rune` and `string`, and open to user types — a type implementing it
/// works with `index`, `contains` and `split` at no further cost.
pub trait Needle {
  /// Where this needle first occurs in `haystack` at or after `offset`: the rune index the
  /// match starts at, and how many runes it spans. `None` if it does not occur.
  ///
  /// **A span rather than a position**, so a needle whose match length varies — a
  /// predicate matching a run, a pattern with alternatives — can report it. The two
  /// implementations here are fixed-width and would be served by a position plus a
  /// separate length method; returning the pair keeps that from being baked into the
  /// trait. `split` is the caller that needs the length: after a match it must step
  /// *past* the separator.
  ///
  /// A zero-length match is legitimate and must be reported: `"".index("")` answering
  /// `Some((0, 0))` is what makes a search for an empty needle terminate. It is `split`,
  /// not this method, that refuses to act on one.
  found_at: (Self, string, Index) -> Maybe<(Index, Length)>
}

/// A rune matches a single code point, spanning one rune.
impl Needle for rune {
  found_at = pure (needle, haystack, offset) => {
    if offset < 0 {
      return None
    }
    var rune_i = 0;
    for c in haystack {
      if rune_i >= offset && c == needle {
        return Some((rune_i, 1))
      }
      rune_i += 1;
    }
    None
  }
}

/// A string matches its own contents, spanning its own rune length.
impl Needle for string {
  found_at = pure (needle, haystack, offset) => {
    if offset < 0 {
      return None
    }
    var rune_i = 0;
    var byte_i = 0;
    for c in haystack {
      if rune_i >= offset && haystack.compare_bytes_at(byte_i, needle) == 0 {
        return Some((rune_i, needle.len()))
      }
      byte_i += c.utf8_len();
      rune_i += 1;
    }
    // The end position, checked after the loop because a `for-in` does not visit it.
    // Only an empty needle can match there, and it must: `"".index("")` and
    // `s.index("", s.len())` are `Some`, which is what makes `split` on an empty
    // separator terminate rather than run off the end.
    if rune_i >= offset && haystack.compare_bytes_at(byte_i, needle) == 0 {
      return Some((rune_i, needle.len()))
    }
    None
  }
}

/// The rune index where `needle` first occurs at or after `offset`, or `None`.
///
/// Both `offset` and the result are **rune** indices, so the answer feeds straight into
/// `slice`. A negative `offset` is `None`.
///
/// The scan is naive rather than Rabin–Karp, which would trade a libc memcmp for
/// byte-at-a-time arithmetic in Lyra and buy only an *expected* bound. A real guarantee
/// wants a `memmem` builtin.
///
/// # Complexity
///
/// |            | Best | Average | Worst  |
/// | ---------- | ---- | ------- | ------ |
/// | **Time**   | O(m) | O(n)    | O(n·m) |
/// | **Memory** | O(1) | O(1)    | O(1)   |
///
/// n is the haystack and m the needle. The columns differ here, and that is the point of
/// the table: a naive scan behaves like O(n) on ordinary text, where a mismatch is usually
/// found in the first byte or two, and degrades to O(n·m) on input built to defeat it —
/// a needle that repeatedly *almost* matches. The best case is a match at the offset.
///
/// # Examples
///
/// ```
/// let at = "a::b::c".index("::").unwrap_or(-1)   // 1
/// ```
pub let index<t> where t: Needle = pure noalloc(self: string, needle: t, offset: Index = 0) -> Maybe<Index> =>
  match needle.found_at(self, offset) {
    None => None,
    Some((idx, _)) => Some(idx)
  }

/// Whether `needle` occurs in `self` at or after `offset`.
pub let contains<t> where t: Needle = pure noalloc(self: string, needle: t, offset: Index = 0) -> bool =>
  self.index(needle, offset).is_some()

/// The string's runes, one element each.
///
/// This is what "split on an empty separator" actually means, stated as what it returns
/// rather than smuggled through a degenerate argument — Go's `strings.Split(s, "")` is the
/// implicit version of this function, and `split` refuses that spelling and names this one
/// instead.
///
/// `[]rune`, not `[]string`: a caller who wants characters wants code points, and a box
/// per character would buy nothing.
///
/// # Complexity
///
/// |            | Best | Average | Worst |
/// | ---------- | ---- | ------- | ----- |
/// | **Time**   | O(n) | O(n)    | O(n)  |
/// | **Memory** | O(n) | O(n)    | O(n)  |
///
/// One decoding pass, one `rune` out per code point in. n counts runes, not bytes, so a
/// string of multi-byte characters costs less than its byte length suggests.
pub let to_runes = pure (self: string) -> []rune => {
  var out: []rune = [];
  for c in self { out.push(c) }
  out
}

/// `self` split on every occurrence of `sep`, with the separators removed.
///
/// Always returns at least one part: a string not containing `sep` splits into itself, and
/// adjacent separators yield empty parts.
///
/// # Panics
///
/// Traps when `sep` is an empty string — it matches everywhere without consuming anything,
/// so there is no answer to give. Use `to_runes` to split a string into its characters. A
/// `rune` separator cannot be empty, so that call never risks it.
///
/// # Complexity
///
/// |            | Best | Average | Worst  |
/// | ---------- | ---- | ------- | ------ |
/// | **Time**   | O(n) | O(n)    | O(n·m) |
/// | **Memory** | O(n) | O(n)    | O(n)   |
///
/// `index`'s scan repeated across the string, so it inherits that row: linear on ordinary
/// text, O(n·m) against a needle built to almost-match. Memory is O(n) whatever the
/// separator does — the parts together hold about as many runes as the input, since
/// `slice` copies each one.
///
/// # Examples
///
/// ```
/// let fields = "a::b::c".split("::")   // ["a", "b", "c"]
/// let chars  = "abc".to_runes()        // not split("")
/// ```
pub let split<t> where t: Needle = pure(self: string, sep: t) -> []string => {
  var parts: []string = [];
  var start = 0;
  for {
    match sep.found_at(self, start) {
      Some((at, span)) => {
        // A zero-span match can never advance the cursor, so it is not a question this
        // loop can answer — an empty separator would sit here forever. A trap rather
        // than a Maybe, on `slice`'s reasoning about its inverted range: this is a
        // caller bug, not an answer, and the empty result a soft path would hand back
        // is indistinguishable from a real one. A rune separator cannot be empty, so
        // the common call never pays for the check it cannot fail.
        //
        // The guard lives here and not in Needle because a zero-length match is
        // *legitimate* to `found_at`: `"".index("")` answering `Some((0, 0))` is what
        // makes a search for an empty needle terminate.
        if span == 0 {
          panic("split: empty separator; to split a string into its runes, use to_runes()")
        }
        parts.push(self.slice(start, at));
        start = at + span;
      },
      None => { parts.push(self.slice(start, self.len())); break; },
    }
  }
  parts
}

/// The parts joined with `sep` between them — `split`'s inverse.
///
/// Generic over the element rather than taking `[]string`, so a list of anything
/// printable joins without being converted first: `[1, 2, 3].join(", ")` is `"1, 2, 3"`.
/// A `[]string` pays nothing for that, since `impl Show for string` returns the value
/// rather than interpolating it.
///
/// An empty array joins to `""`, and a single element to itself — `sep` appears between
/// parts, never around them, so `parts.len() - 1` separators are used.
///
/// # Complexity
///
/// |            | Best | Average | Worst |
/// | ---------- | ---- | ------- | ----- |
/// | **Time**   | O(1) | O(n)    | O(n)  |
/// | **Memory** | O(1) | O(n)    | O(n)  |
///
/// n is the total length of the output, not the number of parts. Linear because the result
/// is accumulated as **bytes** and decoded once at the end: `push` grows by doubling, so
/// the n bytes cost O(n) copying across every reallocation together. Building it with `++`
/// instead is quadratic — a string is immutable, so each concatenation copies everything
/// accumulated so far — which is what this used to do and what a caller writing the loop by
/// hand still would. Measured against this prelude, joining `"field${i}"` with `", "`:
/// 215 µs → 100 µs over 600 parts, 1.54 ms → 0.34 ms over 2400, and 35.7 ms → 1.13 ms over
/// 9600 — a 31× gap that keeps widening, since quadrupling the input costs the old shape
/// 23× and this one 3.3×. The best column is the empty and single-element cases, which
/// return without accumulating anything.
///
/// # Examples
///
/// ```
/// let row = ["a", "b", "c"].join("")       // "abc"
/// let csv = ["x", "y"].join(", ")          // "x, y"
/// let out = rows.join("\n")                // a frame, one string
/// ```
pub let join<t> where t: Show = pure (self: []t, sep: string = "") -> string => {
  if self.len() == 0 {
    ""
  } else if self.len() == 1 {
    // Not merely the loop's base case: one part is the whole answer already, so returning
    // it costs nothing where going through the buffer would encode and decode it — two
    // copies of a string to arrive back at the string. `rows.join("\n")` on a one-row
    // frame is an ordinary call, not a degenerate one.
    self[0].show()
  } else {
    // **Bytes, not `++`.** A string is immutable, so concatenation has to copy the whole
    // accumulator every time and n parts cost O(n²). A `[]u8` is mutable and `push` grows
    // by doubling, so the same n bytes cost O(n) across every reallocation together — the
    // asymptotic difference, not a constant. It needs no size known up front, which is
    // what the earlier note here assumed a linear version would require; what it needed
    // was amortized growth and a way to read a string's bytes, and `encode_utf8` is that.
    //
    // The result is valid UTF-8 because every part is, and `decode_utf8` counts runes as
    // the non-continuation bytes — so the length is right without a validating pass.
    var bytes: []u8 = []
    for b in self[0].show().encode_utf8() { bytes.push(b) }
    // Hoisted: the separator is the same bytes every time round.
    let sb = sep.encode_utf8()
    for i in 1..<self.len() {
      for b in sb { bytes.push(b) }
      for b in self[i].show().encode_utf8() { bytes.push(b) }
    }
    bytes.decode_utf8()
  }
}
