module std.prelude

// Trimming.
//
// Written here in Lyra rather than as compiler builtins, by the same rule that
// puts `parse_i64` here and `read_line` in the compiler: `len`, `slice` and `s[i]`
// are primitive because a UTF-8 walk needs the decoder, and everything built on
// them is ordinary code. Trimming is a loop over runes and one slice, so it is
// ordinary code.
//
// **Whitespace is the five ASCII characters** — space, tab, newline, carriage
// return, form feed — and deliberately not Unicode's full `White_Space` set. That
// larger set needs a table (U+00A0, U+2000–200A, U+3000 and more), and a table is
// the sort of thing that belongs in a real Unicode library rather than smuggled
// into a prelude; a caller trimming input from a keyboard or a file wants exactly
// these five. Anything wider should be an explicit choice made against a real
// table, not a default nobody can see.
//
// Each is `pure` but **not `noalloc`** — `slice` builds a fresh string, which is
// what a substring costs when every string is a ref-counted box.
pub let is_ascii_space = pure noalloc (self: rune) -> bool => {
  let c = i64(self);
  c == 32 || c == 9 || c == 10 || c == 13 || c == 12
}

// Drop leading whitespace.
pub let trim_start = pure (self: string) -> string => {
  let n = self.len();
  var i = 0;
  var scanning = true;
  for scanning && i < n {
    if self[i].is_ascii_space() { i = i + 1 } else { scanning = false }
  }
  self.slice(i, n)
}

// Drop trailing whitespace.
pub let trim_end = pure (self: string) -> string => {
  let n = self.len();
  var end = n;
  var scanning = true;
  for scanning && end > 0 {
    if self[end - 1].is_ascii_space() { end = end - 1 } else { scanning = false }
  }
  self.slice(0, end)
}

// Drop whitespace from both ends.
//
// One pass over each end and a *single* slice, rather than `self.trim_start()
// .trim_end()` — which reads better and allocates twice, building a whole
// intermediate string only to copy most of it again. An all-whitespace input finds
// `i == n` and yields "" without the second scan running at all.
pub let trim = pure (self: string) -> string => {
  let n = self.len();
  var i = 0;
  var scanning = true;
  for scanning && i < n {
    if self[i].is_ascii_space() { i = i + 1 } else { scanning = false }
  }
  var end = n;
  scanning = true;
  for scanning && end > i {
    if self[end - 1].is_ascii_space() { end = end - 1 } else { scanning = false }
  }
  self.slice(i, end)
}

// Prefix and suffix tests.
//
// **Byte-level, and that is not an approximation.** UTF-8 is prefix-free and
// self-synchronizing, so for well-formed strings a byte-prefix is exactly a
// rune-prefix and a byte-suffix exactly a rune-suffix — every Lyra string is
// well-formed, so one memcmp answers the language-level question. This is the same
// property `impl Ord for string` leans on: byte order is code-point order.
//
// The rune-indexed version these replaced was O(m²) for a prefix and O(n·m) for a
// suffix, because `s[i]` is O(i) — and it paid an O(n) `len()` before comparing
// anything, so `s.starts_with("--")` on a 2000-rune string decoded the whole string
// to answer a question about its first two bytes. Measured, the length calls alone
// were 99.7% of it. These are O(m) with no decoding at all.
//
// Both are `pure noalloc` — no `slice`, so nothing is copied — which is what makes
// them usable from the code that most wants a cheap prefix test.
pub let starts_with = pure noalloc (self: string, other: string) -> bool =>
  self.compare_bytes_at(0, other) == 0

// The suffix test is the prefix test **offset**, and that is the whole of it: the
// comparison must start where the suffix would, not at 0. Comparing `self[i]` against
// `other[i]` is a prefix test whichever direction the loop runs — which is what
// `ends_with` first did, so `"hello".ends_with("lo")` was false and
// `"hello".ends_with("he")` was true, each answering the other one's question.
//
// A negative offset needs no guard: `compare_bytes_at` is total, and answers negative
// for a range that does not exist.
pub let ends_with = pure noalloc (self: string, other: string) -> bool =>
  self.compare_bytes_at(self.byte_len() - other.byte_len(), other) == 0

// The number of bytes this rune encodes to in UTF-8, from the code point alone —
// 1 below U+0080, 2 below U+0800, 3 below U+10000, 4 above.
//
// It is what lets `index` below keep a byte cursor while walking runes, which is the
// whole trick that makes the scan linear: `s[i]` is O(i), so advancing by index would
// make the walk quadratic, while `for c in s` decodes each rune exactly once and this
// turns each one into the step the byte cursor needs.
pub let utf8_len = pure noalloc (self: rune) -> i64 => {
  let cp = i64(self);
  if cp < 128 { 1 } else if cp < 2048 { 2 } else if cp < 65536 { 3 } else { 4 }
}

// The rune index of the first occurrence of `needle` at or after `offset`, or `None`.
//
// **Both `offset` and the result are rune indices**, like `s[i]`, `len()` and `slice`
// — so the answer can be handed straight to `slice` without a conversion that would be
// silently wrong on the first non-ASCII input. The *scan* underneath is byte-level, and
// the two are reconciled by carrying a byte cursor alongside the rune counter rather
// than converting afterwards, which nothing in the language could do anyway.
//
// **Scanning at byte positions is rune-correct**, and needs no boundary check: a
// well-formed needle begins with a lead byte, and a lead byte can never equal a
// continuation byte, so a match can only land on a rune boundary. Same
// self-synchronizing property `starts_with` leans on.
//
// A naive scan, deliberately: each candidate is rejected by one `compare_bytes_at`,
// which is libc's memcmp, and on real text the first byte rejects nearly all of them.
// O(n·m) worst case, O(n) in practice. Rabin–Karp would replace that memcmp with
// byte-at-a-time arithmetic in Lyra — the thing measured at three orders of magnitude
// slower when `starts_with` was written that way — and buys only an *expected* bound,
// its worst case being O(n·m) too. If this ever needs a real guarantee, the answer is
// a `memmem` builtin (glibc's is Two-Way: O(n+m), constant space), not an algorithm
// written here.
//
// A **negative offset is `None`**, and deliberately *not* a position counted from the
// end even though `s[-1]` and `s.slice(-3, -1)` are (08/08). An offset here is a
// resumption point for a scan, not an index: `index(needle, k)` means "resume at k and
// keep going forward", and there is no reading of a negative k that continues to the
// end of the string. Python's `str.find` does count its `start` from the end and it is a
// well-known source of confusion for exactly that reason.
pub let index = pure noalloc (self: string, needle: string, offset: i64 = 0) -> Maybe<i64> => {
  if offset < 0 {
    return None
  }
  var rune_i = 0;
  var byte_i = 0;
  for c in self {
    if rune_i >= offset && self.compare_bytes_at(byte_i, needle) == 0 {
      return Some(rune_i)
    }
    byte_i = byte_i + c.utf8_len();
    rune_i = rune_i + 1;
  }
  // The end position, checked after the loop because a `for-in` does not visit it.
  // Only an empty needle can match there, and it must: `"".index("")` and
  // `s.index("", s.len())` are `Some`, which is what will make `split` on an empty
  // separator terminate rather than run off the end.
  if rune_i >= offset && self.compare_bytes_at(byte_i, needle) == 0 {
    return Some(rune_i)
  }
  None
}

pub let contains = pure noalloc (self: string, needle: string) -> bool => self.index(needle).is_some()
