module std.prelude
//! Parsing text into values.
//!
//! This is where a program meets input it did not choose, which is why the failures here
//! are `Maybe` rather than traps: a malformed line is data, not a bug.

// Written in Lyra rather than as a compiler builtin, and that division is the rule to
// follow when adding more: `read_line` *has* to be a builtin, because the line comes from
// libc and Lyra has no FFI, while parsing the line is ordinary arithmetic over a string.
// Anything expressible in the language goes here, where it is readable, testable and
// replaceable; the builtin registry stays whatever is genuinely primitive.
//
// **It accumulates negatively**, which is the one thing here that looks wrong and
// is not. The i64 range is asymmetric — there is no `+9223372036854775808` to
// mirror the minimum — so a magnitude-then-negate parser cannot represent its own
// most negative input, and would have to reject `-9223372036854775808`, a
// perfectly good i64. Building the value on the negative side covers the whole
// range with one code path. (Go's strconv does the same, for the same reason.)
//
// The range guard runs *before* each digit is folded in rather than checking the
// result afterwards, because there is no result to check: arithmetic traps on
// overflow in this language, so `acc * 10 - d` on a too-long input would abort the
// program instead of returning the `None` this function exists to return. The
// limit is the last value that can still be multiplied by ten, and the final digit
// is bounded separately — by 8 for a negative number and 7 for a positive one,
// which is exactly the asymmetry described above, applied one digit at a time.

impl string {
  /// Parses a base-10 `i64`, with an optional leading `+` or `-`.
  ///
  /// **Strict**: `None` for anything that is not exactly a number — an empty string, a lone
  /// sign, a stray character, surrounding whitespace, or a value outside the i64 range. The
  /// caller asked whether this *is* a number, and `"1abc"` is not one. Call `trim` first if
  /// the input may be padded.
  ///
  /// An out-of-range value is `None` rather than a trap, which is what arithmetic would
  /// give: parsing is exactly the boundary where a number too large is the input's problem
  /// and not the program's.
  ///
  /// Named for its width rather than being a bare `parse`, because a function's return type
  /// cannot be chosen by the context it is called in.
  ///
  /// # Complexity
  ///
  /// |            | Best | Average | Worst |
  /// | ---------- | ---- | ------- | ----- |
  /// | **Time**   | O(n) | O(n)    | O(n)  |
  /// | **Memory** | O(1) | O(1)    | O(1)  |
  ///
  /// One pass over the runes, and it does not stop early on bad input — a stray character
  /// sets the failure flag and the walk continues, so a malformed string costs the same as
  /// a well-formed one. Nothing is allocated: the accumulator is an `i64`.
  ///
  /// # Examples
  ///
  /// ```
  /// println("42".parse_i64().unwrap_or(0))        // 42
  /// println("-7".parse_i64().unwrap_or(0))        // -7
  /// println(" 42".parse_i64().unwrap_or(0))       // 0 — leading space is not a number
  /// println("1abc".parse_i64().unwrap_or(0))      // 0 — trailing garbage
  /// ```
  pub let parse_i64 = pure noalloc (self) -> Maybe<i64> => {
    var acc = 0;
    var digits = 0;
    var negative = false;
    var at_start = true;
    var bad = false;
    for c in self {
      let code = i64(c);
      if at_start && (code == 43 || code == 45) {
        negative = code == 45;
      } else if code < 48 || code > 57 {
        bad = true;
      } else {
        let d = code - 48;
        let last_digit = if negative { 8 } else { 7 };
        if acc < -922337203685477580 || (acc == -922337203685477580 && d > last_digit) {
          bad = true;
        } else {
          acc = acc * 10 - d;
          digits = digits + 1;
        }
      }
      at_start = false;
    }
    if bad || digits == 0 {
      None
    } else if negative {
      Some acc
    } else {
      Some(-acc)
    }
  }

  /// Parses a decimal `f64`: an optional `+` or `-`, digits with an optional `.` (`1.`, `.5`
  /// and `1.5` all count, so long as there is a digit), then an optional exponent (`e` or
  /// `E`, an optional sign, digits).
  ///
  /// **Correctly rounded**: the result is the `f64` nearest the decimal, ties to even, for
  /// any number of digits — the same `f64` Go's `strconv.ParseFloat` and Rust's `parse` give.
  /// A value too small for an `f64` is `0.0` (or the nearest subnormal), keeping its sign.
  ///
  /// **Strict**, as [parse_i64] is: `None` for anything that is not exactly a number —
  /// surrounding whitespace, a stray character, no digits, `inf`, `nan`, a hexadecimal
  /// float — and for a value too large for an `f64`, which would round to infinity. Call
  /// `trim` first if the input may be padded.
  ///
  /// # Complexity
  ///
  /// |            | Best | Average | Worst  |
  /// | ---------- | ---- | ------- | ------ |
  /// | **Time**   | O(n) | O(n)    | O(n·e) |
  /// | **Memory** | O(1) | O(n)    | O(n)   |
  ///
  /// A number of at most 15 significant digits whose exponent is within about 22 — what
  /// people and most programs write — is one multiply or divide, with nothing allocated.
  /// Any other is worked out exactly in decimal, at most 800 digits of it, shifted by powers
  /// of two until it is in range: `e` is the size of the exponent.
  ///
  /// # Examples
  ///
  /// ```
  /// println("37.5".parse_f64().unwrap_or(0.0))    // 37.5
  /// println("-1e3".parse_f64().unwrap_or(0.0))    // -1000
  /// println(".5".parse_f64().unwrap_or(0.0))      // 0.5
  /// println("1e400".parse_f64().unwrap_or(0.0))   // 0 — too large for an f64
  /// println(" 2".parse_f64().unwrap_or(0.0))      // 0 — leading space is not a number
  /// ```
  pub let parse_f64 = pure (self) -> Maybe<f64> => {
    let Some(read) = read_decimal(self) else { return None }
    if let Some(quick) = read.exact_f64() { return Some(quick) }
    var d = read
    let (bits, overflow) = d.float_bits(F64_FORMAT)
    if overflow { None } else { Some(bits.f64_from_bits()) }
  }

  /// Parses a decimal `f32`, as [parse_f64] does an `f64`: the same syntax, correctly
  /// rounded to the nearest `f32` — rounded once, from the decimal, so it is not always
  /// `f32(s.parse_f64())`, which rounds twice — and `None` for a value too large for an
  /// `f32`.
  ///
  /// # Examples
  ///
  /// ```
  /// println("0.1".parse_f32().unwrap_or(0.0))     // 0.1
  /// println("1e39".parse_f32().unwrap_or(0.0))    // 0 — too large for an f32
  /// ```
  pub let parse_f32 = pure (self) -> Maybe<f32> => {
    let Some(read) = read_decimal(self) else { return None }
    var d = read
    let (bits, overflow) = d.float_bits(F32_FORMAT)
    if overflow { None } else { Some(u32(bits).f32_from_bits()) }
  }
}

// parse_f64 and parse_f32 are Go's strconv, written again: a fast path where IEEE arithmetic
// on exact values is exact (Clinger's), and otherwise the decimal itself, held as digits and
// shifted by powers of two — each shift exact — until the binary exponent is known, then the
// mantissa's bits read off and rounded half to even. Eisel–Lemire, Go's middle path, needs a
// table of 128-bit powers of five; the slow path is correct on its own, only slower.

/// A decimal number as digits: `0.d₁d₂… × 10^point`, the digits most significant first,
/// at most [MAX_DIGITS] of them, `truncated` when nonzero digits beyond those were dropped.
struct ParsedDecimal {
  digits: []u8 = [],
  point: i64 = 0,
  negative: bool = false,
  truncated: bool = false,
}

/// A binary float's shape: bits of mantissa (the leading one implied), bits of exponent, and
/// the bias, less one, as Go's `floatInfo` has it.
struct FloatFormat {
  mantissa_bits: u64,
  exponent_bits: i64,
  bias: i64,
}

/// IEEE 754's binary64, an `f64`.
const F64_FORMAT: FloatFormat = FloatFormat {
  mantissa_bits: 52,
  exponent_bits: 11,
  bias: -1023
}

/// IEEE 754's binary32, an `f32`.
const F32_FORMAT: FloatFormat = FloatFormat {
  mantissa_bits: 23,
  exponent_bits: 8,
  bias: -127
}

/// The digits a decimal keeps: enough to decide any halfway case of an `f64`, whose exact
/// decimal expansions run to 767 significant digits.
const MAX_DIGITS: i64 = 800

/// The furthest one shift moves by: a digit (under 16) times `2^60` and carried fits a `u64`.
const MAX_SHIFT: u64 = 60

/// How far to shift for a decimal point at each position: `2^n` has `point` digits.
const POWER_SHIFTS: [9]i64 = #[1, 3, 6, 9, 13, 16, 19, 23, 26]

/// The powers of ten an `f64` holds exactly, `10^0` to `10^22`.
const EXACT_POWERS: [23]f64 = #[
  1.0e0, 1.0e1, 1.0e2, 1.0e3, 1.0e4, 1.0e5, 1.0e6, 1.0e7, 1.0e8, 1.0e9, 1.0e10, 1.0e11,
  1.0e12, 1.0e13, 1.0e14, 1.0e15, 1.0e16, 1.0e17, 1.0e18, 1.0e19, 1.0e20, 1.0e21, 1.0e22,
]

/// `text` read as a decimal number — sign, digits, point and exponent — or `None` if it is
/// not one.
let read_decimal = pure (text: string) -> Maybe<ParsedDecimal> => {
  let b = text.encode_utf8()
  var d = ParsedDecimal {}
  var i = 0
  if i < b.len() && (b[i] == 43 || b[i] == 45) { // + -
    d.negative = b[i] == 45
    i += 1
  }
  var seen = 0 // significant digits, kept or not
  var any_digit = false
  var dot = false
  while i < b.len() {
    let c = b[i]
    if c == 46 { // .
      if dot { return None }
      dot = true
      d.point = seen
    } else if c >= 48 && c <= 57 {
      any_digit = true
      if c == 48 && seen == 0 {
        // A leading zero: after the point it moves the point; before it, nothing.
        d.point -= 1
      } else {
        seen += 1
        if d.digits.len() < MAX_DIGITS { d.digits.push(c - 48) } else if c != 48 {
          d.truncated = true
        }
      }
    } else {
      break
    }
    i += 1
  }
  if !any_digit { return None }
  if !dot { d.point = seen }
  if i < b.len() && (b[i] == 101 || b[i] == 69) { // e E
    i += 1
    var exp_negative = false
    if i < b.len() && (b[i] == 43 || b[i] == 45) {
      exp_negative = b[i] == 45
      i += 1
    }
    if i >= b.len() || b[i] < 48 || b[i] > 57 { return None }
    var exp = 0
    while i < b.len() && b[i] >= 48 && b[i] <= 57 {
      if exp < 100000 { exp = exp * 10 + i64(b[i] - 48) }
      i += 1
    }
    d.point += if exp_negative { 0 - exp } else { exp }
  }
  if i != b.len() { return None }
  d.drop_trailing_zeros()
  Some(d)
}

impl ParsedDecimal {
  /// The `f64` this is, where arithmetic finds it exactly: a mantissa below `2^52` (so its
  /// `f64` is exact) times or divided by an exact power of ten, which IEEE rounds once —
  /// correctly. `None` where it cannot.
  let exact_f64 = pure (self) -> Maybe<f64> => {
    if self.truncated || self.digits.len() > 15 { return None }
    var mantissa = 0.0
    for digit in self.digits { mantissa = mantissa * 10.0 + f64(digit) }
    var exp = self.point - self.digits.len()
    var f = mantissa
    if self.digits.len() == 0 || exp == 0 {
      // As it is.
    } else if exp > 0 && exp <= 15 + 22 {
      // A short mantissa can take a few of the zeros into itself, exactly.
      if exp > 22 {
        f = f * EXACT_POWERS[exp - 22]
        exp = 22
      }
      if f > 1.0e15 { return None }
      f = f * EXACT_POWERS[exp]
    } else if exp < 0 && exp >= 0 - 22 {
      f = f / EXACT_POWERS[0 - exp]
    } else {
      return None
    }
    // Negated, not subtracted from zero: `-0` keeps its sign.
    Some(if self.negative { -f } else { f })
  }

  /// The bits of the float of `format` nearest this, rounded half to even, and whether it is
  /// too large for one (the bits are then infinity's).
  let float_bits = (self: mut, format: FloatFormat) -> (u64, bool) => {
    let top = (1 << format.exponent_bits) - 1
    var exp = format.bias
    var mantissa: u64 = 0
    var overflow = false
    if self.digits.len() == 0 {
      // Zero, keeping its sign.
    } else if self.point > 310 {
      overflow = true
    } else if self.point < 0 - 330 {
      // Too small for any subnormal: zero.
    } else {
      // Halved or doubled until it is in [0.5, 1): `exp` counts how often.
      exp = 0
      while self.point > 0 {
        let n = if self.point >= 9 { 27 } else { POWER_SHIFTS[self.point] }
        self.shift(0 - n)
        exp += n
      }
      while self.point < 0 || (self.point == 0 && self.digits[0] < 5) {
        let n = if 0 - self.point >= 9 { 27 } else { POWER_SHIFTS[0 - self.point] }
        self.shift(n)
        exp -= n
      }
      // A float's mantissa is in [1, 2).
      exp -= 1
      // Below the least normal exponent, a subnormal: fewer bits of mantissa.
      if exp < format.bias + 1 {
        let n = format.bias + 1 - exp
        self.shift(0 - n)
        exp += n
      }
      if exp - format.bias >= top {
        overflow = true
      } else {
        self.shift(i64(format.mantissa_bits) + 1)
        mantissa = self.rounded_integer()
        // Rounding up may carry into another bit.
        if mantissa == 2 << format.mantissa_bits {
          mantissa = mantissa >> 1
          exp += 1
          if exp - format.bias >= top { overflow = true }
        }
        if mantissa & (1 << format.mantissa_bits) == 0 { exp = format.bias }
      }
    }
    if overflow {
      mantissa = 0
      exp = top + format.bias
    }
    var bits = mantissa & ((1 << format.mantissa_bits) - 1)
    bits = bits | (u64((exp - format.bias) & top) << format.mantissa_bits)
    if self.negative {
      bits = bits | (1 << (format.mantissa_bits + u64(format.exponent_bits)))
    }
    (bits, overflow)
  }

  /// This times `2^k` — halved for a negative `k` — exactly but for digits beyond
  /// [MAX_DIGITS], `MAX_SHIFT` bits at a time.
  let shift = (self: mut, k: i64) -> void => {
    if self.digits.len() == 0 { return }
    var left = k
    while left > i64(MAX_SHIFT) {
      self.double(MAX_SHIFT)
      left -= i64(MAX_SHIFT)
    }
    while left < 0 - i64(MAX_SHIFT) {
      self.halve(MAX_SHIFT)
      left += i64(MAX_SHIFT)
    }
    if left > 0 { self.double(u64(left)) } else if left < 0 { self.halve(u64(0 - left)) }
  }

  /// This times `2^k`, `k` at most [MAX_SHIFT]: each digit, least significant first, shifted
  /// and carried, the new digits written most significant first.
  let double = (self: mut, k: u64) -> void => {
    var reversed: []u8 = []
    var n: u64 = 0
    var r = self.digits.len() - 1
    while r >= 0 {
      n += u64(self.digits[r]) << k
      reversed.push(u8(n % 10))
      n = n / 10
      r -= 1
    }
    while n > 0 {
      reversed.push(u8(n % 10))
      n = n / 10
    }
    let grown = reversed.len() - self.digits.len()
    var out: []u8 = []
    var w = reversed.len() - 1
    while w >= 0 {
      if out.len() < MAX_DIGITS { out.push(reversed[w]) } else if reversed[w] != 0 {
        self.truncated = true
      }
      w -= 1
    }
    self.digits = out
    self.point += grown
    self.drop_trailing_zeros()
  }

  /// This divided by `2^k`, `k` at most [MAX_SHIFT]: enough leading digits read to divide,
  /// then a digit put down for each read, then the remainder's.
  let halve = (self: mut, k: u64) -> void => {
    let mask: u64 = (1 << k) - 1
    var r = 0
    var n: u64 = 0
    while n >> k == 0 {
      if r >= self.digits.len() {
        // Every digit read and still under 2^k: carry on with zeros.
        while n >> k == 0 {
          n = n * 10
          r += 1
        }
        break
      }
      n = n * 10 + u64(self.digits[r])
      r += 1
    }
    self.point -= r - 1
    var out: []u8 = []
    while r < self.digits.len() {
      let digit = n >> k
      n = n & mask
      out.push(u8(digit))
      n = n * 10 + u64(self.digits[r])
      r += 1
    }
    while n > 0 {
      let digit = n >> k
      n = n & mask
      if out.len() < MAX_DIGITS { out.push(u8(digit)) } else if digit > 0 {
        self.truncated = true
      }
      n = n * 10
    }
    self.digits = out
    self.drop_trailing_zeros()
  }

  /// The integer part, rounded half to even by the digits after it (and up, past a tie, when
  /// digits were dropped). Called with fewer than 20 integer digits.
  let rounded_integer = pure (self) -> u64 => {
    var n: u64 = 0
    var i = 0
    while i < self.point && i < self.digits.len() {
      n = n * 10 + u64(self.digits[i])
      i += 1
    }
    while i < self.point {
      n = n * 10
      i += 1
    }
    if self.rounds_up(self.point) { n + 1 } else { n }
  }

  /// Whether the digits from `at` on are more than half of the digit before them, or exactly
  /// half with it odd — or with digits dropped beyond, which make it more.
  let rounds_up = pure (self, at: i64) -> bool => {
    if at < 0 || at >= self.digits.len() { return false }
    if self.digits[at] == 5 && at + 1 == self.digits.len() {
      if self.truncated { return true }
      return at > 0 && self.digits[at - 1] % 2 == 1
    }
    self.digits[at] >= 5
  }

  /// Trailing zeros dropped — they change nothing — and the point reset when none are left.
  let drop_trailing_zeros = (self: mut) -> void => {
    var n = self.digits.len()
    while n > 0 && self.digits[n - 1] == 0 { n -= 1 }
    if n < self.digits.len() { self.digits = self.digits.slice(0, n) }
    if n == 0 { self.point = 0 }
  }
}
