module std.prelude
//! Combinators over `[]t`.

// A third receiver head for `map` and `filter`, alongside the `Maybe` and `Result` ones —
// receiver-keyed overloading is what makes the three able to share a name, and dispatch on
// the receiver is what picks between them at a call.
//
// Neither is `noalloc`: a comprehension builds a new array.

/// A new array holding `f` applied to each element, in order.
///
/// Allocates the result, so this is not `noalloc`. The comprehension `[f(x) for x in xs]`
/// is the same thing written inline.
///
/// # Complexity
///
/// |            | Best | Average | Worst |
/// | ---------- | ---- | ------- | ----- |
/// | **Time**   | O(n) | O(n)    | O(n)  |
/// | **Memory** | O(n) | O(n)    | O(n)  |
///
/// Every cell is O(n) because there is nothing to vary: `f` is called once per element
/// and the result holds one element per call. The input is not modified.
///
/// # Examples
///
/// ```
/// let doubled = [1, 2, 3].map((n) => n * 2)   // [2, 4, 6]
/// ```
pub let map<t,u> = pure (self: []t, f: (t) -> u) -> []u => [x in self | f(x)]

/// A new array of the elements satisfying `predicate`, in order.
///
/// Allocates the result. An array where nothing matches is empty, never `None` — absence
/// of matches is not an error.
///
/// # Complexity
///
/// |            | Best | Average | Worst |
/// | ---------- | ---- | ------- | ----- |
/// | **Time**   | O(n) | O(n)    | O(n)  |
/// | **Memory** | O(1) | O(k)    | O(n)  |
///
/// `predicate` is called once per element whatever it answers, so time does not vary.
/// Memory is the k elements kept: nothing matching is the best case, everything matching
/// the worst. The comprehension allocates n up front — it cannot know k without running
/// `predicate`, and running it twice would make the number of calls a detail of the
/// compiler — and hands the unused tail back once the count is known, so the result holds
/// O(k) and the O(n) is a transient rather than something the array keeps.
///
/// # Examples
///
/// ```
/// let evens = [1, 2, 3, 4].filter((n) => n %% 2 == 0)   // [2, 4]
/// ```
pub let filter<t> = pure (self: []t, predicate: (t) -> bool) -> []t => [x in self | predicate(x) | x]

/// Sorts `self` in place, ascending by `t`'s `Ord`. Introsort: quicksort with a
/// median-of-three pivot and Hoare partitioning, insertion sort on ranges under 16, and
/// heapsort on any range whose recursion depth passes 2·log2(n) — so the worst case is
/// O(n log n) rather than quicksort's O(n²), and no input, sorted or adversarial, defeats
/// it. No allocation. **Not stable**: equal elements may change their relative order.
///
/// ```
/// var xs: []i64 = [5, 3, 9, 1]
/// xs.quick_sort()      // [1, 3, 5, 9]
/// ```
pub let quick_sort<t> where t: Ord = (self: mut []t) -> void => {
  let n = self.len()
  var budget = 0
  var m = n
  for m > 1 { m = m / 2; budget += 2 }
  quick_sort_range(self, 0, n, budget)
}

/// `quick_sort`'s general-purpose name — see [quick_sort]. `heap_sort` is the same order
/// with a guarantee in place of a constant factor.
pub let sort<t> where t: Ord = (self: mut []t) -> void => self.quick_sort()

/// A sorted **copy** of `self`, ascending by `t`'s `Ord`; `self` is untouched. **Stable**:
/// elements that compare equal keep their order, so sorting records by one key leaves
/// ties in their original order, and sorting by a second key afterwards sorts by both.
/// Merge sort over a scratch buffer of the same length, so it allocates twice and
/// `noalloc` refuses it; `sort` is the in-place, unstable alternative.
///
/// ```
/// let by_age = people.sorted()     // people is unchanged
/// ```
pub let sorted<t> where t: Ord = pure (self: []t) -> []t => {
  // Bottom-up, and all in one function: a helper taking a `mut []t` is an impure call,
  // which `pure` refuses even on a buffer this function owns. Mutating a local is fine.
  var src = [...self]
  let n = src.len()
  if n < 2 { return src }

  // Runs of 16 by insertion sort — stable, and the fewest compares on a short range.
  var run = 0
  for run < n {
    let stop = min(run + 16, n)
    for i in (run + 1)..<stop {
      let v = src[i]
      var j = i
      for j > run && src[j - 1].compare(v) == Greater {
        src[j] = src[j - 1]
        j -= 1
      }
      src[j] = v
    }
    run = stop
  }

  // Merge runs of `width` from src into dst, then swap the buffers' roles.
  var dst = [...self]
  var width = 16
  for width < n {
    var start = 0
    for start < n {
      let mid = min(start + width, n)
      let end = min(start + 2 * width, n)
      var i = start
      var j = mid
      var k = start
      for i < mid && j < end {
        // The left element wins a tie: that is the whole of stability.
        if src[j].compare(src[i]) == Less {
          dst[k] = src[j]
          j += 1
        } else {
          dst[k] = src[i]
          i += 1
        }
        k += 1
      }
      for i < mid { dst[k] = src[i]; i += 1; k += 1 }
      for j < end { dst[k] = src[j]; j += 1; k += 1 }
      start = end
    }
    (src, dst) = (dst, src)
    width *= 2
  }
  src
}

/// Sorts `self` in place, ascending by `t`'s `Ord`. Heapsort: O(n log n) in every case,
/// no allocation, **not stable** — equal elements may change their relative order.
/// `quick_sort` is two to three times faster on typical input and falls back to this.
pub let heap_sort<t> where t: Ord = (self: mut []t) -> void => heap_sort_range(self, 0, self.len())

/// Sorts `self[start..<end]`. `budget` is the partition depth left before the range is
/// handed to heapsort. The smaller side recurses and the larger side loops, so the stack
/// is O(log n) whatever the partitions do.
let quick_sort_range<t> where t: Ord = (self: mut []t, start: i64, end: i64, budget: i64) -> void => {
  var lo = start
  var hi = end
  var left = budget
  for hi - lo > 16 {
    if left == 0 {
      heap_sort_range(self, lo, hi)
      return
    }
    left -= 1
    let p = partition(self, lo, hi)
    if p + 1 - lo < hi - (p + 1) {
      quick_sort_range(self, lo, p + 1, left)
      lo = p + 1
    } else {
      quick_sort_range(self, p + 1, hi, left)
      hi = p + 1
    }
  }
  insertion_sort_range(self, lo, hi)
}

/// Hoare partition of `self[start..<end]` around the median of its first, middle and
/// last elements. Answers `p` such that every element of `self[start..<=p]` is at most
/// the pivot and every element of `self[p+1..<end]` is at least it, with both sides
/// non-empty — the pivot is moved to `start` first, which is what guarantees that. Equal
/// keys are split between the sides rather than piled on one, so a run of duplicates
/// does not degrade the sort.
let partition<t> where t: Ord = (self: mut []t, start: i64, end: i64) -> i64 => {
  let mid = start + (end - start) / 2
  let last = end - 1
  if self[mid].compare(self[start]) == Less { (self[start], self[mid]) = (self[mid], self[start]) }
  if self[last].compare(self[start]) == Less { (self[start], self[last]) = (self[last], self[start]) }
  if self[last].compare(self[mid]) == Less { (self[mid], self[last]) = (self[last], self[mid]) }
  (self[start], self[mid]) = (self[mid], self[start])
  let pivot = self[start]
  var i = start
  var j = end
  for {
    i += 1
    for self[i].compare(pivot) == Less { i += 1 }
    j -= 1
    for self[j].compare(pivot) == Greater { j -= 1 }
    if i >= j { break }
    (self[i], self[j]) = (self[j], self[i])
  }
  j
}

/// Insertion sort of `self[start..<end]`: fewest compares on a short or nearly sorted
/// range, which is what quicksort leaves behind.
let insertion_sort_range<t> where t: Ord = (self: mut []t, start: i64, end: i64) -> void => {
  for i in (start + 1)..<end {
    let v = self[i]
    var j = i
    for j > start && self[j - 1].compare(v) == Greater {
      self[j] = self[j - 1]
      j -= 1
    }
    self[j] = v
  }
}

/// Heapsort of `self[start..<end]`, indices relative to `start`.
let heap_sort_range<t> where t: Ord = (self: mut []t, start: i64, end: i64) -> void => {
  let n = end - start
  for i in (n / 2 - 1)..>=0 {
    sift_down(self, start, n, i)
  }
  for i in (n - 1)..>0 {
    (self[start], self[start + i]) = (self[start + i], self[start])
    sift_down(self, start, i, 0)
  }
}

/// Restores the max-heap property below `i` in the `n`-element heap at `self[base..]`.
let sift_down<t> where t: Ord = (self: mut []t, base: i64, n: i64, i: i64) -> void => {
  var largest = i
  let l = 2 * i + 1
  let r = 2 * i + 2
  if l < n && self[base + l].compare(self[base + largest]) == Greater { largest = l }
  if r < n && self[base + r].compare(self[base + largest]) == Greater { largest = r }
  if largest != i {
    (self[base + i], self[base + largest]) = (self[base + largest], self[base + i])
    sift_down(self, base, n, largest)
  }
}
