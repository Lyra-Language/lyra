module std.prelude
//! Combinators over `[]t`.

// A third receiver head for `map` and `filter`, alongside the `Maybe` and `Result` ones —
// receiver-keyed overloading is what makes the three able to share a name, and dispatch on
// the receiver is what picks between them at a call.
//
// Neither is `noalloc`: a comprehension builds a new array.

/// A new array holding `f` applied to each element, in order.
///
/// Allocates the result, so this is not `noalloc`. The comprehension `[f(x) for x in xs]`
/// is the same thing written inline.
///
/// # Complexity
///
/// |            | Best | Average | Worst |
/// | ---------- | ---- | ------- | ----- |
/// | **Time**   | O(n) | O(n)    | O(n)  |
/// | **Memory** | O(n) | O(n)    | O(n)  |
///
/// Every cell is O(n) because there is nothing to vary: `f` is called once per element
/// and the result holds one element per call. The input is not modified.
///
/// # Examples
///
/// ```
/// let doubled = [1, 2, 3].map((n) => n * 2)   // [2, 4, 6]
/// ```
pub let map<t,u> = pure (self: []t, f: (t) -> u) -> []u => [x in self | f(x)]

/// A new array of the elements satisfying `predicate`, in order.
///
/// Allocates the result. An array where nothing matches is empty, never `None` — absence
/// of matches is not an error.
///
/// # Complexity
///
/// |            | Best | Average | Worst |
/// | ---------- | ---- | ------- | ----- |
/// | **Time**   | O(n) | O(n)    | O(n)  |
/// | **Memory** | O(1) | O(k)    | O(n)  |
///
/// `predicate` is called once per element whatever it answers, so time does not vary.
/// Memory is the k elements kept: nothing matching is the best case, everything matching
/// the worst. The comprehension allocates n up front — it cannot know k without running
/// `predicate`, and running it twice would make the number of calls a detail of the
/// compiler — and hands the unused tail back once the count is known, so the result holds
/// O(k) and the O(n) is a transient rather than something the array keeps.
///
/// # Examples
///
/// ```
/// let evens = [1, 2, 3, 4].filter((n) => n %% 2 == 0)   // [2, 4]
/// ```
pub let filter<t> = pure (self: []t, predicate: (t) -> bool) -> []t => [x in self | predicate(x) | x]

/// Sorts `self` in place, ascending by `t`'s `Ord`. Heapsort: O(n log n) in every case,
/// no allocation, **not stable** — equal elements may change their relative order.
pub let heap_sort<t> where t: Ord = (self: mut []t) -> void => {
  let n = self.len()

  // Build the heap: sift down every internal node, last first.
  for i in (n / 2 - 1)..>=0 {
    sift_down(self, n, i)
  }

  // Move the root (the largest) to the end, then restore the heap over what remains.
  for i in (n - 1)..>0 {
    let temp = self[0]
    self[0] = self[i]
    self[i] = temp
    sift_down(self, i, 0)
  }
}

/// Restores the max-heap property below `i` in `self[0..<n]`.
let sift_down<t> where t: Ord = (self: mut []t, n: i64, i: i64) -> void => {
  var largest = i
  let l = 2 * i + 1
  let r = 2 * i + 2

  if l < n && self[l].compare(self[largest]) == Greater { largest = l }
  if r < n && self[r].compare(self[largest]) == Greater { largest = r }

  if largest != i {
    let temp = self[i]
    self[i] = self[largest]
    self[largest] = temp
    sift_down(self, n, largest)
  }
}
