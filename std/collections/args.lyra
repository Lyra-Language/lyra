module std.collections
//! The program's arguments, parsed: `ProgramArgs` over the prelude's `program_args`, by
//! `parse_args` for a whole line, `parse_strict` for a whole line whose every flag is
//! declared, or `parse_command` for the flags before a command.

/// The program's arguments, sorted into the three kinds a command line carries.
///
/// A key has three states on a command line — absent, present, present with a value —
/// and a map from name to `Maybe<string>` answers `get` with a `Maybe<Maybe<string>>`,
/// which no caller ever wants to read. This keeps the kinds apart instead, so each
/// question has the answer its type deserves: `has` answers a bool, `value` one `Maybe`.
///
/// ```
/// import std.collections.{ ProgramArgs, parse_args, has, value }
///
/// let args = parse_args(["-o"])
/// if args.has("-v") { println("verbose") }
/// let out = args.value("-o").unwrap_or("a.out")
/// for path in args.positional { println(path) }
/// ```
pub struct ProgramArgs {
  /// What the shell ran — `program_args()[0]`.
  program: string,
  /// Flags that take no value, in order: `-v`. A flag that was declared as valued but
  /// came last with nothing after it lands here too, so `has` says it was written
  /// and `value` says it had nothing.
  switches: []string,
  /// Flags that take the argument after them: `-o out.bin` maps `-o` to `out.bin`.
  options: HashMap<string, string>,
  /// Everything else, in order: `input.txt`. From `parse_command`, the command and every
  /// argument after it, untouched.
  positional: []string,
}

/// Parses the program's arguments. `valued` names the flags that take a value — the
/// parser cannot tell `-o out.bin` from `-v input.txt` by looking, so the program says.
///
/// Every argument starting with `-` is a flag: one named in `valued` takes the next
/// argument as its value, whatever it looks like; any other is a switch. Everything
/// else is positional, as is everything after a `--`, and a bare `-` (standard input).
/// There is no `--flag=value` form.
///
/// A flag written twice keeps the last value; a switch written twice is listed twice.
pub let parse_args = (valued: []string) -> ProgramArgs => {
  let args = program_args()
  var parsed = ProgramArgs {
    program: args[0],
    switches: [],
    options: HashMap.new::<string, string>(),
    positional: [],
  }
  var i = 1
  var only_operands = false
  while i < args.len() {
    let arg = args[i]
    // **`--` ends the flags**, and everything after it is an operand however it begins —
    // POSIX's tenth utility guideline, and the only way to name a file called `-x` or to
    // pass a negative number. Without it `-2208988800` was read as a switch and vanished
    // from `positional`, which is how this came to be written (09/22). The `--` itself is
    // not an operand.
    if only_operands {
      parsed.positional.push(arg)
      i += 1
      continue
    }
    if arg == "--" {
      only_operands = true
      i += 1
      continue
    }
    // A bare `-` is **standard input**, by the convention every Unix tool keeps, so it is
    // an operand and not a flag — `cat -`, `lyrafmt -`. Reading it as a switch is what a
    // leading-dash test does on its own, and it makes the one spelling for "the input is
    // a pipe" unsayable.
    if !arg.starts_with("-") || arg == "-" {
      parsed.positional.push(arg)
      i += 1
    } else if valued.holds(arg) && i + 1 < args.len() {
      parsed.options.insert(arg, args[i + 1])
      i += 2
    } else {
      parsed.switches.push(arg)
      i += 1
    }
  }
  parsed
}

/// Parses the flags in front of a command, and stops there: the first operand and every
/// argument after it land in `positional` untouched, however they begin — `tool -v ls -la`
/// is `-v` and then `ls -la`, a subcommand's own flags included. A `--` stops it too, and
/// is not kept, so `tool -- -x` runs a command named `-x`.
///
/// `args[0]` is the name the rest belong to, so the program passes `program_args()` and a
/// subcommand passes the `positional` it was given — `positional[0]` is its own name — to
/// parse its flags in turn, those too in front of its operands.
///
/// Every flag must be declared: `switches` take no value, `valued` the argument after them
/// whatever it looks like. An undeclared flag, or a valued one with nothing after it, is an
/// `Err` naming it, since the program cannot know where its own flags end and the command
/// begins without knowing them all.
///
/// ```
/// import std.collections.{ parse_command }
///
/// let main = () -> u8 => {
///   let args = match parse_command(program_args(), ["-v"], ["-C"]) {
///     Ok(a) => a,
///     Err(why) => {
///       println(why)
///       return 2
///     },
///   }
///   if args.positional.len() == 0 {
///     println("usage: tool [-v] [-C DIR] COMMAND ...")
///     return 2
///   }
///   println("running ${args.positional[0]} with ${args.positional.len() - 1} arguments")
///   0
/// }
/// ```
pub let parse_command = pure (
  args: []string,
  switches: []string,
  valued: []string
) -> Result<ProgramArgs, string> => parse_declared(args, switches, valued, true)

/// Parses a whole line whose every flag is declared: flags anywhere among the operands —
/// `sheliak game.bin --frames 60 --ppm out.ppm` — in any order, and everything else an
/// operand, kept in order. Strict as `parse_command` is: `switches` take no value, `valued`
/// the argument after them whatever it looks like, and an undeclared flag, or a valued one
/// with nothing after it, is an `Err` naming it — where `parse_args` would take a misspelt
/// flag for a switch and say nothing. `--` ends the flags, every argument after it an
/// operand, and a bare `-` (standard input) is one.
///
/// `args[0]` is the program, so a program passes `program_args()`.
///
/// ```
/// import std.collections.{ parse_strict }
///
/// let main = () -> u8 => {
///   let args = match parse_strict(program_args(), ["--save"], ["--frames", "--ppm"]) {
///     Ok(a) => a,
///     Err(why) => {
///       println("tool: ${why}")
///       return 2
///     },
///   }
///   let frames = args.value("--frames").unwrap_or("60")
///   for rom in args.positional { println("${rom} for ${frames} frames") }
///   0
/// }
/// ```
pub let parse_strict = pure (
  args: []string,
  switches: []string,
  valued: []string
) -> Result<ProgramArgs, string> => parse_declared(args, switches, valued, false)

impl ProgramArgs {
  /// Whether `flag` was written, as a switch or with a value.
  pub let has = pure noalloc (self, flag: string) -> bool =>
    self.switches.holds(flag) || self.options.contains_key(flag)

  /// The value written after `flag`, or `None` if it had none or was not written.
  pub let value = pure noalloc (self, flag: string) -> Maybe<string> =>
    self.options.get(flag)
}

impl []string {
  // Whether `s` is an element of `xs`. Linear, and the lists here are a handful long.
  let holds = pure noalloc (self, s: string) -> bool => {
    for x in self { if x == s { return true } }
    false
  }
}

// The declared flags of `args` (past `args[0]`): `parse_command`'s when `stop` — the first
// operand ends them, it and all after it `positional` untouched — and `parse_strict`'s when
// not, every operand kept and the flags read to the end. `--` ends them either way, unkept.
let parse_declared = pure (
  args: []string,
  switches: []string,
  valued: []string,
  stop: bool
) -> Result<ProgramArgs, string> => {
  var parsed = ProgramArgs {
    program: if args.len() > 0 { args[0] } else { "" },
    switches: [],
    options: HashMap.new::<string, string>(),
    positional: [],
  }
  var i = 1
  while i < args.len() {
    let arg = args[i]
    if arg == "--" {
      i += 1
      break
    }
    // An operand; a bare `-` is one, as `parse_args` reads it. For `parse_command` the
    // first is the command, and ends the flags.
    if !arg.starts_with("-") || arg == "-" {
      if stop { break }
      parsed.positional.push(arg)
      i += 1
    } else if valued.holds(arg) {
      if i + 1 >= args.len() { return Err("${arg} needs a value") }
      parsed.options.insert(arg, args[i + 1])
      i += 2
    } else if switches.holds(arg) {
      parsed.switches.push(arg)
      i += 1
    } else {
      return Err("unknown option ${arg}")
    }
  }
  for rest in args.slice(i, args.len()) { parsed.positional.push(rest) }
  Ok(parsed)
}
