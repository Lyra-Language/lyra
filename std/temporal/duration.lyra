module std.temporal
//! Dates, times and durations, after the web's **Temporal** API.
//!
//! Temporal's central idea is the one this module keeps: **a wall-clock value and an exact
//! instant are different types.** A `PlainDate` is a calendar date with no time zone —
//! "18 September", the way a person writes it on a calendar — and arithmetic on it is
//! calendar arithmetic, so adding a month to 31 January lands on the last day of February
//! rather than wherever 30 days happens to reach. That is the right default for a calendar
//! and the wrong one for a timestamp, which is why the two never convert implicitly.
//!
//! The mapping from Temporal, stated once so each declaration need not:
//!
//!   - **Constructors are bare functions**, because Lyra has no associated functions
//!     (`lyra-E035`): Temporal's `new Temporal.PlainDate(2026, 9, 18)` is
//!     `plain_date(2026, 9, 18)`, and `Temporal.Now.plainDateISO()` is `today()`.
//!   - **Properties are methods** in snake_case: `date.dayOfWeek` is `d.day_of_week()`.
//!   - **An option bag is a defaulted parameter**, and Temporal's default is kept.
//!   - **Temporal throws `RangeError`; Lyra answers `None`** where the input can be bad
//!     (a date that does not exist, a string that does not parse), and traps where it can
//!     only be a program bug (arithmetic past the representable range).
//!   - **ISO 8601 only.** Temporal's other calendars need CLDR data, and nothing here has
//!     asked for them.
//!
//! Built slice by slice against `examples/calendar`, which is what decides what exists: a
//! function arrives when the calendar needs it, shaped the way Temporal shapes it.
//!
//! ```
//! import std.temporal.{ today, months }
//!
//! let next = today().add(months(1))   // 31 Jan → 28 or 29 Feb
//! ```

/// An amount of time, field by field — Temporal's `Duration`.
///
/// **Ten fields, not a count of nanoseconds**, because "one month" is not a number of
/// seconds: it is 28, 29, 30 or 31 days depending on where it is added. A duration stays a
/// bag of calendar and clock units until it meets a date, and the date decides what each
/// one means. That is also why `{ days: 1 }` and `{ hours: 24 }` are different durations —
/// across a daylight-saving change they are different lengths of time.
///
/// Temporal refuses a duration whose fields disagree in sign. Lyra has no field privacy, so
/// nothing can stop one being written as a struct literal; `add` applies the fields in
/// Temporal's order (years and months, then weeks and days), and a mixed-sign duration
/// means whatever that order computes. Build one from the functions below and the question
/// never arises.
pub struct Duration {
  years: i64,
  months: i64,
  weeks: i64,
  days: i64,
  hours: i64,
  minutes: i64,
  seconds: i64,
  milliseconds: i64,
  microseconds: i64,
  nanoseconds: i64,
}

/// The empty duration — every field zero. The base for a record update when a duration
/// needs more than one unit: `let d = duration()`, then `Duration { d | days: 1, hours: 2 }`.
///
/// Bound first because a record update's base must be a name: `Duration { duration() | … }`
/// does not parse (todo.md).
pub let duration = pure () -> Duration => Duration {
  years: 0, months: 0, weeks: 0, days: 0, hours: 0, minutes: 0, seconds: 0,
  milliseconds: 0, microseconds: 0, nanoseconds: 0,
}

/// `n` years.
pub let years = pure (n: i64) -> Duration => {
  let none = duration()
  Duration { none | years: n }
}

/// `n` months. Added to a date, it keeps the day of the month where that day exists and
/// clamps it to the month's last day where it does not.
pub let months = pure (n: i64) -> Duration => {
  let none = duration()
  Duration { none | months: n }
}

/// `n` weeks — exactly `7 * n` days, whatever the month.
pub let weeks = pure (n: i64) -> Duration => {
  let none = duration()
  Duration { none | weeks: n }
}

/// `n` days.
pub let days = pure (n: i64) -> Duration => {
  let none = duration()
  Duration { none | days: n }
}

/// `n` hours.
pub let hours = pure (n: i64) -> Duration => {
  let none = duration()
  Duration { none | hours: n }
}

/// `n` minutes.
pub let minutes = pure (n: i64) -> Duration => {
  let none = duration()
  Duration { none | minutes: n }
}

/// `n` seconds.
pub let seconds = pure (n: i64) -> Duration => {
  let none = duration()
  Duration { none | seconds: n }
}

/// The duration an ISO 8601 string names — `PT30M`, `P1DT2H`, `-P1W`, `PT1.5S` — or `None`.
///
/// Temporal's `Duration.from(string)`. The fields are kept **as written, not balanced**:
/// `PT90M` is ninety minutes, not an hour and a half, which is Temporal's rule and matters
/// because the two are different durations once a date is involved.
///
/// What is refused, and why:
///
///   - units out of order (`P1D1Y`) or repeated (`P1D2D`), which ISO 8601 forbids;
///   - a `P` with nothing after it, and a `T` with no clock unit after it;
///   - a fraction on anything but seconds. ISO 8601 and Temporal allow `PT1.5H`; nothing
///     here has written one, so it is refused rather than half-supported.
pub let parse_duration = pure (text: string) -> Maybe<Duration> => {
  let runes = text.to_runes()
  var i = 0
  var sign = 1
  if i < runes.len() && (runes[i] == '+' || runes[i] == '-') {
    if runes[i] == '-' { sign = 0 - 1 }
    i += 1
  }
  if i >= runes.len() || runes[i] != 'P' { return None }
  i += 1
  var out = duration()
  var any = false
  // The date units, in order: each must come after the last one seen.
  var rank = 0
  for i < runes.len() && runes[i] != 'T' {
    let Some((n, next)) = number_at(runes, i) else { return None }
    if next >= runes.len() { return None }
    let unit = runes[next]
    let r = date_rank(unit)
    if r <= rank { return None }
    rank = r
    if unit == 'Y' { out = Duration { out | years: sign * n } }
    else if unit == 'M' { out = Duration { out | months: sign * n } }
    else if unit == 'W' { out = Duration { out | weeks: sign * n } }
    else { out = Duration { out | days: sign * n } }
    any = true
    i = next + 1
  }
  if i < runes.len() {
    // After a `T`: the clock units, in order, and at least one of them.
    i += 1
    if i >= runes.len() { return None }
    var clock_rank = 0
    for i < runes.len() {
      let Some((n, next)) = number_at(runes, i) else { return None }
      if next >= runes.len() { return None }
      if runes[next] == '.' {
        // A fraction, which only seconds may carry.
        let Some((f, after)) = number_at(runes, next + 1) else { return None }
        if after >= runes.len() || runes[after] != 'S' || clock_rank >= 3 { return None }
        let written = after - (next + 1)
        if written > 9 { return None }
        var ns = f
        for _ in 0..<(9 - written) { ns = ns * 10 }
        out = Duration { out |
          seconds: sign * n,
          milliseconds: sign * (ns / 1000000),
          microseconds: sign * (ns / 1000 % 1000),
          nanoseconds: sign * (ns % 1000),
        }
        clock_rank = 3
        any = true
        i = after + 1
        continue
      }
      let unit = runes[next]
      let r = clock_rank_of(unit)
      if r <= clock_rank { return None }
      clock_rank = r
      if unit == 'H' { out = Duration { out | hours: sign * n } }
      else if unit == 'M' { out = Duration { out | minutes: sign * n } }
      else { out = Duration { out | seconds: sign * n } }
      any = true
      i = next + 1
    }
    if clock_rank == 0 { return None }
  }
  if any { Some(out) } else { None }
}

/// The same duration pointing the other way: every field negated.
///
/// Temporal's `negated()`, and what `subtract` is made of — subtracting a duration is
/// adding its negation, so the two can never disagree.
pub let negated = pure (self: Duration) -> Duration => Duration {
  years: 0 - self.years, months: 0 - self.months, weeks: 0 - self.weeks,
  days: 0 - self.days, hours: 0 - self.hours, minutes: 0 - self.minutes,
  seconds: 0 - self.seconds, milliseconds: 0 - self.milliseconds,
  microseconds: 0 - self.microseconds, nanoseconds: 0 - self.nanoseconds,
}

/// The clock fields as one count of nanoseconds, in `i128`: each field is an `i64`, and
/// their total need not fit in one. Shared by `PlainDate.add`, which counts it in whole
/// days, and `PlainDateTime.add`, which carries it into the time.
let clock_nanoseconds = pure (d: Duration) -> i128 =>
  i128(d.hours) * i128(3600000000000) + i128(d.minutes) * i128(60000000000) +
  i128(d.seconds) * i128(1000000000) + i128(d.milliseconds) * i128(1000000) +
  i128(d.microseconds) * i128(1000) + i128(d.nanoseconds)

/// The decimal number at `runes[from..]` and the index just past it, or `None` when there
/// is no digit there.
let number_at = pure (runes: []rune, from: i64) -> Maybe<(i64, i64)> => {
  var i = from
  for i < runes.len() && runes[i].is_ascii_digit() { i += 1 }
  if i == from { return None }
  let Some(n) = digits(runes, from, i) else { return None }
  Some((n, i))
}

/// A date unit's place in `P…` order, or 0 for a letter that is not one.
let date_rank = pure (unit: rune) -> i64 => match unit {
  'Y' => 1, 'M' => 2, 'W' => 3, 'D' => 4, _ => 0 - 1,
}

/// A clock unit's place in `T…` order, or -1 for a letter that is not one.
let clock_rank_of = pure (unit: rune) -> i64 => match unit {
  'H' => 1, 'M' => 2, 'S' => 3, _ => 0 - 1,
}
