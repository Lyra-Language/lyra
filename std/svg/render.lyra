module std.svg

struct Canvas {
  width: u32,
  height: u32,
  rgba: []u8,
}

let main = () -> void => {
  render_svg(
    `<svg xmlns="http://www.w3.org/2000/svg" width="10" height="10">
      <rect x="2" y="2" width="6" height="6" fill="green" stroke="black" stroke-width="2"/>
    </svg>`
  )
}

let render_svg = (source: string) => {
  match parse_svg(source) {
    Ok svg_tree => {
      print_svg_element(svg_tree)
      // build_render_tree(svg_tree)
    },
    Err err_str => print(err_str),
  }
}

