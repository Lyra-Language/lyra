module std.svg

import std.xml.{ parse_xml, Element }
import std.io.{ read_file }

pub let parse_svg_file = (path: string) -> Result<SvgElement, string> => {
  if let Some(content) = read_file(path) {
    return parse_svg(content)
  } else {
    return Err("The file at ${path} could not be read.")
  }
}

/// An SVG document's tree. Err where it is not XML, or its root is not an `<svg>`.
pub let parse_svg = pure (source: string) -> Result<SvgElement, string> => {
  let root = parse_xml(source)?
  if root.name != "svg" {
    return Err("The root element is <${root.name}>, not <svg>.")
  }
  Ok(build_svg_element(root))
}

/// An element and everything inside it. One this parser does not know yet is kept as
/// `Other`, so the rest of the document still reads.
let build_svg_element = pure (xml: Element) -> SvgElement => {
  match xml.name {
    "svg" => make_svg(xml),
    "title" => make_title(xml),
    "rect" => make_rect(xml),
    "circle" => make_circle(xml),
    "path" => make_path(xml),
    _ => Other(xml.name),
  }
}

let make_svg = pure (xml: Element) -> SvgElement => {
  Svg {
    id: xml.attribute("id"),
    x: parse_length_percent(xml.attribute("x")),
    y: parse_length_percent(xml.attribute("y")),
    width: parse_length_percent(xml.attribute("width")),
    height: parse_length_percent(xml.attribute("height")),
    baseProfile: xml.attribute("baseProfile"),
    version: parse_num(xml.attribute("version")),
    viewBox: parse_viewbox(xml.attribute("viewBox")),
    preserveAspectRatio: parse_preserve_aspect_ratio(xml.attribute("preserveAspectRatio")),
    children: [child in xml.children | build_svg_element(child)],
  }
}

let make_title = pure (xml: Element) -> SvgElement => Title { text: Some(xml.text) }

let make_rect = pure (xml: Element) -> SvgElement => {
  Rect {
    id: xml.attribute("id"),
    x: parse_length_percent(xml.attribute("x")),
    y: parse_length_percent(xml.attribute("y")),
    width: parse_length_percent(xml.attribute("width")),
    height: parse_length_percent(xml.attribute("height")),
    stroke: parse_color(xml.attribute("stroke")),
    fill: parse_color(xml.attribute("fill")),
    rx: parse_length_percent(xml.attribute("rx")),
    ry: parse_length_percent(xml.attribute("ry")),
    pathLength: parse_num(xml.attribute("pathLength")),
  }
}

let make_circle = pure (xml: Element) -> SvgElement => {
  Circle {
    id: xml.attribute("id"),
    cx: parse_length_percent(xml.attribute("cx")),
    cy: parse_length_percent(xml.attribute("cy")),
    r: parse_length_percent(xml.attribute("r")),
    pathLength: parse_num(xml.attribute("pathLength")),
    fill: parse_color(xml.attribute("fill")),
    stroke: parse_color(xml.attribute("stroke")),
  }
}

let make_path = pure (xml: Element) -> SvgElement => {
  let d: Maybe<PathData> = match xml.attribute("d") {
    Some(text) => Some(parse_path_data(text)),
    None => None,
  }
  Path {
    id: xml.attribute("id"),
    d: d,
    stroke: parse_color(xml.attribute("stroke")),
    fill: parse_color(xml.attribute("fill")),
    pathLength: parse_num(xml.attribute("pathLength")),
  }
}

/// Path data (`d`): its segments up to the first error. SVG draws a path as far as it is
/// right, so an error ends the path rather than refusing it — `M 0 0 L 10` is the moveto
/// alone. Data that does not start with a moveto (`M` or `m`) is no path at all.
let parse_path_data = pure (d: string) -> PathData => {
  let b = d.encode_utf8()
  var out: []PathSegment = []
  var i = skip_list_space(b, 0)
  let first = rune_at(b, i)
  if first != 'M' && first != 'm' { return PathData(out) }
  while i < b.len() {
    let Some((segments, end)) = command_at(b, i) else { break }
    for s in segments { out.push(s) }
    i = skip_list_space(b, end)
  }
  PathData(out)
}

/// The segments of the command at `i`, and the offset after its arguments. None where `i`
/// holds no command, or one without a whole argument set. A lowercase command is relative.
let command_at = pure (b: []u8, i: i64) -> Maybe<([]PathSegment, i64)> => {
  let c = rune_at(b, i)
  let relative = c >= 'a'
  let args = skip_list_space(b, i + 1)
  match c {
    'M' | 'm' => moveto_at(b, args, relative),
    'L' | 'l' => lineto_at(b, args, relative),
    'H' | 'h' => horizontal_lineto_at(b, args, relative),
    'V' | 'v' => vertical_lineto_at(b, args, relative),
    'C' | 'c' => curveto_at(b, args, relative),
    'S' | 's' => smooth_curveto_at(b, args, relative),
    'Q' | 'q' => quadratic_curveto_at(b, args, relative),
    'T' | 't' => smooth_quadratic_curveto_at(b, args, relative),
    'A' | 'a' => arc_at(b, args, relative),
    // Takes no numbers; one straight after it is no command, and ends the path.
    'Z' | 'z' => Some(([ClosePath], args)),
    _ => None,
  }
}

/// `M`: a move, then any further pairs as linetos (see `MoveToAbs`).
let moveto_at = pure (
  b: []u8,
  from: i64,
  relative: bool
) -> Maybe<([]PathSegment, i64)> => {
  let (pairs, end) = coordinate_pair_sequence_at(b, from)
  if pairs.len() == 0 { return None }
  let segment = if relative { MoveToRel pairs } else { MoveToAbs pairs }
  Some(([segment], end))
}

let lineto_at = pure (
  b: []u8,
  from: i64,
  relative: bool
) -> Maybe<([]PathSegment, i64)> => {
  let (pairs, end) = coordinate_pair_sequence_at(b, from)
  if pairs.len() == 0 { return None }
  let segment = if relative { LineToRel pairs } else { LineToAbs pairs }
  Some(([segment], end))
}

/// `H`: a segment per number, so `H 1 2` is two.
let horizontal_lineto_at = pure (
  b: []u8,
  from: i64,
  relative: bool
) -> Maybe<([]PathSegment, i64)> => {
  let (values, end) = number_sequence_at(b, from)
  if values.len() == 0 { return None }
  let segments = [
    v in values | if relative { LineToHorizRel { dx: v } } else { LineToHorizAbs { x: v } }
  ]
  Some((segments, end))
}

/// `V`: a segment per number, as `H`.
let vertical_lineto_at = pure (
  b: []u8,
  from: i64,
  relative: bool
) -> Maybe<([]PathSegment, i64)> => {
  let (values, end) = number_sequence_at(b, from)
  if values.len() == 0 { return None }
  let segments = [
    v in values | if relative { LineToVertRel { dy: v } } else { LineToVertAbs { y: v } }
  ]
  Some((segments, end))
}

/// `C`: sets of six numbers, `x1 y1 x2 y2 x y`.
let curveto_at = pure (
  b: []u8,
  from: i64,
  relative: bool
) -> Maybe<([]PathSegment, i64)> => {
  let (groups, end) = number_groups_at(b, from, 6)
  if groups.len() == 0 { return None }
  let segment = if relative {
    CubicBezierRel {
      triplets: [
        g in groups | CubicBezierTripletRel {
          dx1: g[0],
          dy1: g[1],
          dx2: g[2],
          dy2: g[3],
          dx: g[4],
          dy: g[5]
        }
      ]
    }
  } else {
    CubicBezierAbs {
      triplets: [
        g in groups | CubicBezierTripletAbs {
          x1: g[0],
          y1: g[1],
          x2: g[2],
          y2: g[3],
          x: g[4],
          y: g[5]
        }
      ]
    }
  }
  Some(([segment], end))
}

/// `S`: sets of four numbers, `x2 y2 x y` — the first control point is drawing's to work out.
let smooth_curveto_at = pure (
  b: []u8,
  from: i64,
  relative: bool
) -> Maybe<([]PathSegment, i64)> => {
  let (groups, end) = number_groups_at(b, from, 4)
  if groups.len() == 0 { return None }
  let segment = if relative {
    SmoothCubicBezierRel {
      pairs: [g in groups | SmoothCubicBezierPairRel {
        dx2: g[0],
        dy2: g[1],
        dx: g[2],
        dy: g[3]
      }]
    }
  } else {
    SmoothCubicBezierAbs {
      pairs: [g in groups | SmoothCubicBezierPairAbs {
        x2: g[0],
        y2: g[1],
        x: g[2],
        y: g[3]
      }]
    }
  }
  Some(([segment], end))
}

/// `Q`: sets of four numbers, `x1 y1 x y`.
let quadratic_curveto_at = pure (
  b: []u8,
  from: i64,
  relative: bool
) -> Maybe<([]PathSegment, i64)> => {
  let (groups, end) = number_groups_at(b, from, 4)
  if groups.len() == 0 { return None }
  let segment = if relative {
    QuadBezierRel {
      triplets: [g in groups | QuadBezierTripletRel {
        dx1: g[0],
        dy1: g[1],
        dx: g[2],
        dy: g[3]
      }]
    }
  } else {
    QuadBezierAbs {
      triplets: [g in groups | QuadBezierTripletAbs {
        x1: g[0],
        y1: g[1],
        x: g[2],
        y: g[3]
      }]
    }
  }
  Some(([segment], end))
}

/// `T`: end points only — the control point is drawing's to work out.
let smooth_quadratic_curveto_at = pure (
  b: []u8,
  from: i64,
  relative: bool
) -> Maybe<([]PathSegment, i64)> => {
  let (pairs, end) = coordinate_pair_sequence_at(b, from)
  if pairs.len() == 0 { return None }
  let segment = if relative {
    SmoothQuadBezierRel { points: pairs }
  } else {
    SmoothQuadBezierAbs { points: pairs }
  }
  Some(([segment], end))
}

/// `A`: a segment per arc, as `H` makes one per number.
let arc_at = pure (b: []u8, from: i64, relative: bool) -> Maybe<([]PathSegment, i64)> => {
  let (arcs, end) = arc_sequence_at(b, from)
  if arcs.len() == 0 { return None }
  let segments = [
    a in arcs | if relative {
      EllipticalArcCurveRel {
        rx: a.rx,
        ry: a.ry,
        angle: a.angle,
        largeArcFlag: a.large_arc,
        sweepFlag: a.sweep,
        dx: a.x,
        dy: a.y
      }
    } else {
      EllipticalArcCurveAbs {
        rx: a.rx,
        ry: a.ry,
        angle: a.angle,
        largeArcFlag: a.large_arc,
        sweepFlag: a.sweep,
        x: a.x,
        y: a.y
      }
    }
  ]
  Some((segments, end))
}

/// The numbers starting at `from`, apart by `comma-wsp`, and the offset after the last.
/// It stops where no number follows, leaving a trailing comma unread, as
/// `coordinate_pair_sequence_at` does.
let number_sequence_at = pure (b: []u8, from: i64) -> ([]f64, i64) => {
  var values: []f64 = []
  var i = from
  loop {
    let Some((n, end)) = number_at(b, i) else { break }
    values.push(n)
    i = end
    let next = skip_comma_list_space(b, end)
    if number_at(b, next).is_none() { break }
    i = next
  }
  (values, i)
}

/// Sets of `n` numbers starting at `from` — `C` takes sixes, `S` and `Q` fours — and the
/// offset after the last whole set. It stops where no number follows, and at a set cut
/// short, before its first number, as `coordinate_pair_sequence_at` does for pairs.
let number_groups_at = pure (b: []u8, from: i64, n: i64) -> ([][]f64, i64) => {
  var groups: [][]f64 = []
  var i = from
  loop {
    let Some((group, end)) = numbers_at(b, i, n) else { break }
    groups.push(group)
    i = end
    let next = skip_comma_list_space(b, end)
    if number_at(b, next).is_none() { break }
    i = next
  }
  (groups, i)
}

/// `n` numbers starting at `from`, apart by `comma-wsp`, and the offset after the last.
/// None where fewer than `n` are there.
let numbers_at = pure (b: []u8, from: i64, n: i64) -> Maybe<([]f64, i64)> => {
  var values: []f64 = []
  var i = from
  for k in 0..<n {
    if k > 0 { i = skip_comma_list_space(b, i) }
    let Some((v, end)) = number_at(b, i) else { return None }
    values.push(v)
    i = end
  }
  Some((values, i))
}

/// An arc's arguments, before they are told absolute from relative.
struct Arc { rx: f64, ry: f64, angle: f64, large_arc: bool, sweep: bool, x: f64, y: f64 }

/// The arcs' argument sets starting at `from` (`rx ry angle large-arc sweep x y`), and the
/// offset after the last whole one, stopping as `number_groups_at` does.
let arc_sequence_at = pure (b: []u8, from: i64) -> ([]Arc, i64) => {
  var arcs: []Arc = []
  var i = from
  loop {
    let Some((arc, end)) = arc_args_at(b, i) else { break }
    arcs.push(arc)
    i = end
    let next = skip_comma_list_space(b, end)
    if number_at(b, next).is_none() { break }
    i = next
  }
  (arcs, i)
}

/// One arc's arguments. A flag is the one character `0` or `1`, so it needs nothing after
/// it: `a 5 5 0 106 6` is large-arc 1, sweep 0, then 6 6.
let arc_args_at = pure (b: []u8, from: i64) -> Maybe<(Arc, i64)> => {
  let Some((radii, after_radii)) = numbers_at(b, from, 3) else { return None }
  let Some((large_arc, after_large)) = flag_at(
    b,
    skip_comma_list_space(b, after_radii)
  ) else {
    return None
  }
  let Some((sweep, after_sweep)) = flag_at(
    b,
    skip_comma_list_space(b, after_large)
  ) else {
    return None
  }
  let Some((point, end)) = numbers_at(b, skip_comma_list_space(b, after_sweep), 2) else {
    return None
  }
  let arc = Arc {
    rx: radii[0],
    ry: radii[1],
    angle: radii[2],
    large_arc: large_arc,
    sweep: sweep,
    x: point[0],
    y: point[1]
  }
  Some((arc, end))
}

let flag_at = pure (b: []u8, i: i64) -> Maybe<(bool, i64)> => {
  if byte_at(b, i) == DIGIT_0 { return Some((false, i + 1)) }
  if byte_at(b, i) == DIGIT_1 { return Some((true, i + 1)) }
  None
}

/// The coordinate pairs starting at `from`, and the offset after the last whole one. It
/// stops where no number follows, and at a pair cut short (`1 2 3` is one pair, ending
/// before the 3) — what is left at the offset then ends the path.
let coordinate_pair_sequence_at = pure (
  b: []u8,
  from: i64
) -> ([]CoordinatePair, i64) => {
  var pairs: []CoordinatePair = []
  var i = from
  loop {
    let Some((x, y, end)) = coordinate_pair_at(b, i) else { break }
    pairs.push(CoordinatePair(x, y))
    i = end
    let next = skip_comma_list_space(b, end)
    if number_at(b, next).is_none() { break }
    i = next
  }
  (pairs, i)
}

let coordinate_pair_at = pure (b: []u8, from: i64) -> Maybe<(f64, f64, i64)> => {
  let Some((x, x_end)) = number_at(b, from) else { return None }
  let Some((y, y_end)) = number_at(b, skip_comma_list_space(b, x_end)) else {
    return None
  }
  Some((x, y, y_end))
}

let parse_num = pure (maybe_num: Maybe<string>) -> Maybe<CssNumber> => {
  if let Some num_str = maybe_num {
    if let Some num = parse_f64(num_str) {
      return Some(CssNumber(num))
    }
  }
  None
}

/// The `viewBox` attribute: four numbers, `min-x min-y width height`. None where it is
/// absent, is not four numbers, or has a negative width or height — an invalid `viewBox`
/// is ignored, as if not written. A zero width or height is kept: it disables rendering
/// of the element, which is the renderer's to act on.
let parse_viewbox = pure (list: Maybe<string>) -> Maybe<ViewBox> => {
  let Some(nums) = parse_list_of_nums(list) else { return None }
  match base(nums) {
    [min_x, min_y, width, height] =>
      if width < 0 || height < 0 {
        None
      } else {
        Some(ViewBox { min_x: min_x, min_y: min_y, width: width, height: height })
      },
    _ => None,
  }
}

/// An SVG list of numbers (`viewBox`, `points`): numbers apart by whitespace, a comma or both,
/// and by nothing where the next one's start says so (`1-2` is 1 and -2; `1.5.5` is 1.5 and
/// .5). None where the attribute is absent, or anything in it is not such a list.
let parse_list_of_nums = pure (list: Maybe<string>) -> Maybe<ListOfNumbers> => {
  let Some(text) = list else { return None }
  let b = text.encode_utf8()
  var out: []f64 = []
  var i = skip_list_space(b, 0)
  while i < b.len() {
    let Some((n, end)) = number_at(b, i) else { return None }
    out.push(n)
    i = skip_list_space(b, end)
    if byte_at(b, i) == COMMA {
      // A comma must have a number after it: `1,` and `1,,2` are not lists.
      i = skip_list_space(b, i + 1)
      if i >= b.len() { return None }
    }
  }
  Some(ListOfNumbers(out))
}

// for now just accepts any string. Later will match against known color names, hex notation, rgba, etc.
let parse_color = pure (color_str: Maybe<string>) -> Maybe<CssColor> => {
  return Some(CssColor(color_str?))
}

/// The number starting at `from` and the offset after it: a sign, digits with a point among
/// or before them, and an exponent only where digits follow its `e` (so `1em` stops at the 1).
let number_at = pure (b: []u8, from: i64) -> Maybe<(f64, i64)> => {
  var i = from
  if byte_at(b, i) == PLUS || byte_at(b, i) == MINUS { i += 1 }
  let whole = skip_digits(b, i)
  var end = whole
  var digits = whole > i
  if byte_at(b, end) == POINT {
    let fraction = skip_digits(b, end + 1)
    digits = digits || fraction > end + 1
    end = fraction
  }
  if !digits { return None }
  if byte_at(b, end) == LOWER_E || byte_at(b, end) == UPPER_E {
    var e = end + 1
    if byte_at(b, e) == PLUS || byte_at(b, e) == MINUS { e += 1 }
    let power = skip_digits(b, e)
    if power > e { end = power }
  }
  let Some(n) = parse_f64(b.slice(from, end).decode_utf8()) else { return None }
  Some((n, end))
}

let skip_digits = pure (b: []u8, from: i64) -> i64 => {
  var i = from
  while byte_at(b, i) >= DIGIT_0 && byte_at(b, i) <= DIGIT_9 { i += 1 }
  i
}

/// Past SVG's whitespace: space, tab, carriage return and line feed.
let skip_list_space = pure (b: []u8, from: i64) -> i64 => {
  var i = from
  while is_list_space(byte_at(b, i)) { i += 1 }
  i
}

/// Past SVG's `comma-wsp`: whitespace with at most one comma among it, so `1,,2` stops
/// at the second comma.
let skip_comma_list_space = pure (b: []u8, from: i64) -> i64 => {
  var i = skip_list_space(b, from)
  if byte_at(b, i) == COMMA { i = skip_list_space(b, i + 1) }
  i
}

let is_list_space = pure (c: i64) -> bool => c == 32 || c == 9 || c == 10 || c == 13

/// The byte at `i` as a rune, or NUL past either end — a command letter to match on.
let rune_at = pure (b: []u8, i: i64) -> rune =>
  if i >= 0 && i < b.len() { rune(b[i]) } else { '\0' }

/// The byte at `i`, or -1 past either end.
let byte_at = pure (b: []u8, i: i64) -> i64 =>
  if i >= 0 && i < b.len() { i64(b[i]) } else { -1 }

const PLUS: i64 = 43
const COMMA: i64 = 44
const MINUS: i64 = 45
const POINT: i64 = 46
const DIGIT_0: i64 = 48
const DIGIT_1: i64 = 49
const DIGIT_9: i64 = 57
const UPPER_E: i64 = 69
const LOWER_E: i64 = 101

let parse_length_percent = pure (length_percent: Maybe<string>) -> Maybe<CssLengthPercentage> => {
  if var Some length_percent_str = length_percent {
    length_percent_str = length_percent_str.trim()

    if let Some length_num = parse_f64(length_percent_str) {
      return Some(CssLPLength(Num(CssNumber(length_num))))
    }

    if let Some length_num = length_percent_str.strip_suffix("%") {
      if let Some length_num = parse_f64(length_num) {
        return Some(CssLPPercentage(CssPercentage(length_num)))
      }
      return None
    }

    if let Some length_num = length_percent_str.strip_suffix("px") {
      if let Some length_num = parse_f64(length_num) {
        return Some(CssLPLength(Px(length_num)))
      }
      return None
    }

    if let Some length_num = length_percent_str.strip_suffix("cm") {
      if let Some length_num = parse_f64(length_num) {
        return Some(CssLPLength(Cm(length_num)))
      }
      return None
    }

    if let Some length_num = length_percent_str.strip_suffix("mm") {
      if let Some length_num = parse_f64(length_num) {
        return Some(CssLPLength(Mm(length_num)))
      }
      return None
    }

    if let Some length_num = length_percent_str.strip_suffix("in") {
      if let Some length_num = parse_f64(length_num) {
        return Some(CssLPLength(In(length_num)))
      }
      return None
    }

    if let Some length_num = length_percent_str.strip_suffix("pt") {
      if let Some length_num = parse_f64(length_num) {
        return Some(CssLPLength(Pt(length_num)))
      }
      return None
    }

    if let Some length_num = length_percent_str.strip_suffix("rem") {
      if let Some length_num = parse_f64(length_num) {
        return Some(CssLPLength(Rem(length_num)))
      }
      return None
    }

    if let Some length_num = length_percent_str.strip_suffix("em") {
      if let Some length_num = parse_f64(length_num) {
        return Some(CssLPLength(Em(length_num)))
      }
      return None
    }

    if let Some length_num = length_percent_str.strip_suffix("ex") {
      if let Some length_num = parse_f64(length_num) {
        return Some(CssLPLength(Ex(length_num)))
      }
      return None
    }

    if let Some length_num = length_percent_str.strip_suffix("pc") {
      if let Some length_num = parse_f64(length_num) {
        return Some(CssLPLength(Pc(length_num)))
      }
      return None
    }

    return None
  }
  None
}

/// `preserveAspectRatio`: `[defer] <align> [meet | slice]`, apart by any whitespace.
/// (None, None) where it is absent or invalid — an invalid value counts as unwritten, so
/// both mean the default, `xMidYMid meet`. `defer` matters only on `<image>` and is
/// dropped.
let parse_preserve_aspect_ratio = pure (aspect_ratio: Maybe<string>) -> PreserveAspectRatio => {
  let unset = PreserveAspectRatio(None, None)
  let Some(text) = aspect_ratio else { return unset }
  var words = text.split_when((r) => r.is_ascii_space())
  if words.len() > 0 && words[0] == "defer" { words = words.slice(1, words.len()) }
  match words {
    [align_str] => {
      let Some(align) = parse_aspect_ratio_align(align_str) else { return unset }
      PreserveAspectRatio(Some(align), None)
    },
    [align_str, meet_or_slice_str] => {
      let Some(align) = parse_aspect_ratio_align(align_str) else { return unset }
      let Some(meet_or_slice) = parse_meet_or_slice(meet_or_slice_str) else { return unset }
      PreserveAspectRatio(Some(align), Some(meet_or_slice))
    },
    _ => unset,
  }
}

let parse_aspect_ratio_align = pure (align_str: string) -> Maybe<AspectRatioAlign> =>
  match align_str {
    "none" => Some(AlignNone),
    "xMinYMin" => Some(XMinYMin),
    "xMidYMin" => Some(XMidYMin),
    "xMaxYMin" => Some(XMaxYMin),
    "xMinYMid" => Some(XMinYMid),
    "xMidYMid" => Some(XMidYMid),
    "xMaxYMid" => Some(XMaxYMid),
    "xMinYMax" => Some(XMinYMax),
    "xMidYMax" => Some(XMidYMax),
    "xMaxYMax" => Some(XMaxYMax),
    _ => None,
  }

let parse_meet_or_slice = pure (meet_or_slice_str: string) -> Maybe<MeetOrSlice> =>
  match meet_or_slice_str {
    "meet" => Some(Meet),
    "slice" => Some(Slice),
    _ => None,
  }

pub data SvgElement =
  Svg {
    id: Maybe<string>,
    x: Maybe<CssLengthPercentage> = None,
    y: Maybe<CssLengthPercentage> = None,
    width: Maybe<CssLengthPercentage> = None,
    height: Maybe<CssLengthPercentage> = None,
    baseProfile: Maybe<string>,
    version: Maybe<CssNumber>,
    viewBox: Maybe<ViewBox>,
    preserveAspectRatio: PreserveAspectRatio
    children: []SvgElement = [],
  }
  | Title { text: Maybe<string> }
  | Rect {
    id: Maybe<string>,
    x: Maybe<CssLengthPercentage> = None,
    y: Maybe<CssLengthPercentage> = None,
    width: Maybe<CssLengthPercentage> = None,
    height: Maybe<CssLengthPercentage> = None,
    stroke: Maybe<CssColor> = None,
    fill: Maybe<CssColor> = None,
    rx: Maybe<CssLengthPercentage> = None,
    ry: Maybe<CssLengthPercentage> = None,
    pathLength: Maybe<CssNumber>,
  }
  | Circle {
    id: Maybe<string>,
    cx: Maybe<CssLengthPercentage> = None,
    cy: Maybe<CssLengthPercentage> = None,
    r: Maybe<CssLengthPercentage> = None,
    stroke: Maybe<CssColor> = None,
    fill: Maybe<CssColor> = None,
    pathLength: Maybe<CssNumber>,
  }
  | Path {
    id: Maybe<string>,
    d: Maybe<PathData> = None,
    stroke: Maybe<CssColor> = None,
    fill: Maybe<CssColor> = None,
    pathLength: Maybe<CssNumber>,
  }
  | Other string

/// A `viewBox`: the rectangle of user space an element's viewport shows.
pub struct ViewBox {
  min_x: f64,
  min_y: f64,
  width: f64,
  height: f64,
}

pub tuple PreserveAspectRatio (Maybe<AspectRatioAlign>, Maybe<MeetOrSlice>)
pub data AspectRatioAlign = AlignNone | XMinYMin | XMidYMin | XMaxYMin | XMinYMid | XMidYMid | XMaxYMid | XMinYMax | XMidYMax | XMaxYMax
pub data MeetOrSlice = Meet | Slice

pub type PathData = []PathSegment
pub data PathSegment =
  // A moveto's pairs after the first are linetos, drawn as `L` (or `l`) would draw them.
  MoveToAbs []CoordinatePair
  | MoveToRel []CoordinatePair
  | LineToAbs []CoordinatePair
  | LineToRel []CoordinatePair
  | LineToHorizAbs { x: f64 }
  | LineToHorizRel { dx: f64 }
  | LineToVertAbs { y: f64 }
  | LineToVertRel { dy: f64 }
  | CubicBezierAbs { triplets: []CubicBezierTripletAbs }
  | CubicBezierRel { triplets: []CubicBezierTripletRel }
  | SmoothCubicBezierAbs { pairs: []SmoothCubicBezierPairAbs }
  | SmoothCubicBezierRel { pairs: []SmoothCubicBezierPairRel }
  | QuadBezierAbs { triplets: []QuadBezierTripletAbs }
  | QuadBezierRel { triplets: []QuadBezierTripletRel }
  | SmoothQuadBezierAbs { points: []CoordinatePair }
  | SmoothQuadBezierRel { points: []CoordinatePair }
  | EllipticalArcCurveAbs {
    rx: f64,
    ry: f64,
    angle: f64,
    largeArcFlag: bool,
    sweepFlag: bool,
    x: f64,
    y: f64
  }
  | EllipticalArcCurveRel {
    rx: f64,
    ry: f64,
    angle: f64,
    largeArcFlag: bool,
    sweepFlag: bool,
    dx: f64,
    dy: f64
  }
  | ClosePath

pub tuple CoordinatePair(f64, f64)

pub struct CubicBezierTripletAbs { x1: f64, y1: f64, x2: f64, y2: f64, x: f64, y: f64 }
pub struct CubicBezierTripletRel {
  dx1: f64,
  dy1: f64,
  dx2: f64,
  dy2: f64,
  dx: f64,
  dy: f64
}
pub struct QuadBezierTripletAbs { x1: f64, y1: f64, x: f64, y: f64 }
pub struct QuadBezierTripletRel { dx1: f64, dy1: f64, dx: f64, dy: f64 }
/// A smooth curve's (`S`, and `T`'s points) first control point is the reflection of the
/// previous segment's last, which drawing works out; the data gives only the rest.
pub struct SmoothCubicBezierPairAbs { x2: f64, y2: f64, x: f64, y: f64 }
pub struct SmoothCubicBezierPairRel { dx2: f64, dy2: f64, dx: f64, dy: f64 }

pub data CssLengthPercentage = CssLPLength CssLength | CssLPPercentage CssPercentage
pub data CssLength = Num CssNumber | Px f64 | Cm f64 | Mm f64 | In f64 | Pt f64 | Em f64 | Rem f64 | Ex f64 | Pc f64
pub type CssPercentage = f64
pub type CssNumber = f64
pub type ListOfNumbers = []f64
pub type CssColor = string
