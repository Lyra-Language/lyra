module std.genesis.text
//! Text a Genesis game writes in tiles: a font's glyphs in video memory, written into a plane's
//! cells — a score's label, a name — and a **text box** typing a line of dialogue out a letter
//! at a time, in the window plane, which does not scroll.
//!
//! ```
//! import std.genesis.text
//! import std.genesis.text.{ Font, TextBox }
//!
//! let FONT = Font { tile: assets.LETTERS_TILE, count: 59 }   // the glyphs from ' ' to 'Z'
//! text.write(vdp.WINDOW, 1, 1, FONT, "SCORE")
//!
//! var talk = TextBox { x: 1, y: 22, width: 38, height: 5, font: FONT }
//! vdp.window_rows_below(6)            // the window over the bottom six rows
//! talk.open()
//! loop {
//!   talk.update(HELLO)                // a letter every `frames` frames
//!   if pad.pressed(buttons, before, pad.A) { talk.advance(HELLO) }   // all of it, then shut
//!   …
//! }
//! ```
//!
//! **A font is a run of tiles in video memory**, the first showing the character `first` (a
//! space, unless the font says otherwise) and each after it the next: printable ASCII from the
//! space to `Z` is 59 tiles; a font of digits alone is ten from `'0'`. A character the font has
//! no glyph for is its capital where the font has only capitals, else the space, else nothing.
//! A glyph's colour 0 is transparent, as any tile's: a box reads over the game where its space
//! glyph is painted solid, a background colour of its own.
//!
//! **The box is given its words at every call**, never keeping them: they are the game's
//! `const` tables', which a game picks from by index and passes until it closes the box —
//! `std.genesis.talk` does so for a conversation of lines, speakers and choices.
//! The box wraps at the word that would pass its right edge, starts a line at a newline, and
//! stops at its last row: a long speech is several boxes, one after another.
//!
//! **The window plane shows the box**: `vdp.window_rows(n)` over the top `n` rows,
//! `vdp.window_rows_below(n)` over the bottom ones, in place of plane A. Its cells are the
//! screen's, from the top-left: a box over the bottom six rows of 28 starts at row 22. A box
//! writes only its own cells, and [TextBox.close] blanks them.

import std.genesis.vdp

/// A font: `count` glyphs in video memory from tile `tile`, the first showing character
/// `first`, drawn in palette `palette`.
pub struct Font {
  tile: u16,
  count: u16,
  first: u16 = 32,
  palette: u16 = 0,
}

impl Font {
  /// The name-table word showing character `code`: its glyph (or its capital's, or the
  /// space's), in the font's palette, in front of the sprites when `front`; 0, the blank tile,
  /// for one the font cannot show.
  pub let word_of = pure (self, code: u32, front: bool = true) -> u16 => {
    let glyph = self.glyph_of(code)
    if glyph < 0 { return 0 }
    let bit: u16 = if front { 0x8000 } else { 0 }
    bit | ((self.palette & 3) << 13) | (self.tile + u16(glyph))
  }

  /// The glyph showing character `code`, counted from the font's first; its capital's where
  /// the font has only capitals, the space's where it has neither, -1 for none.
  pub let glyph_of = pure (self, code: u32) -> i16 => {
    let first = u32(self.first)
    let count = u32(self.count)
    if code >= first && code < first + count { return i16(code - first) }
    if code >= 97 && code <= 122 && code - 32 >= first && code - 32 < first + count {
      return i16(code - 32 - first)
    }
    if 32 >= first && 32 < first + count { i16(32 - first) } else { -1 }
  }
}

/// `words` written into `plane`'s cells (`vdp.WINDOW`, `PLANE_A` or `PLANE_B`) from cell
/// (`x`, `y`), a newline starting the next row at `x`, in front of the sprites when `front`.
/// Answers how many letters it wrote.
pub let write = (
  plane: u16,
  x: u16,
  y: u16,
  font: Font,
  words: string,
  front: bool = true
) -> u16 => {
  var column = x
  var row = y
  var written: u16 = 0
  for c in words {
    let code = u32(c)
    if code == 10 {
      column = x
      row += 1
      continue
    }
    vdp.write_cell(plane, column, row, font.word_of(code, front))
    column += 1
    written += 1
  }
  written
}

/// Cells `width` × `height` of `plane` from (`x`, `y`) blanked: the blank tile, 0.
pub let clear = (plane: u16, x: u16, y: u16, width: u16, height: u16) -> void => {
  for row in 0..<height {
    for column in 0..<width { vdp.write_cell(plane, x + column, y + row, 0) }
  }
}

/// A box of dialogue: cells `width` × `height` of `plane` from (`x`, `y`), filled with the
/// font's space, its words typed inside a cell's margin — and `indent` cells more on the left,
/// room for a portrait, and `top` rows more above, room for a speaker's name — a letter every
/// `frames` frames, `spacing` blank rows between its lines.
///
/// **A frame** is nine tiles, a 3×3 block from tile `frame` (0: none, the box filled with the
/// font's space), `frame_stride` tiles from one of its rows to the next in video memory (its tile
/// set's width): the corners drawn once, the edges and the middle repeated to the box's size — a
/// 9-patch in cells. A letter takes its cell whole, so the middle tile should be the colour the
/// font's glyphs are drawn on. The frame is drawn in the font's palette. The rest is its own: where it has got
/// to.
pub struct TextBox {
  plane: u16 = vdp.WINDOW,
  x: u16,
  y: u16,
  width: u16,
  height: u16,
  font: Font,
  frames: u16 = 2,
  indent: u16 = 0,
  top: u16 = 0,
  spacing: u16 = 0,
  frame: u16 = 0,
  frame_stride: u16 = 3,
  typed: u16 = 0,
  tick: u16 = 0,
  column: u16 = 0,
  row: u16 = 0,
  shown: bool = false,
  done: bool = false,
}

/// What a box's words hold where it has got to: no letter left.
const NO_LETTER: u32 = 0xFFFFFFFF

impl TextBox {
  /// The box drawn, empty, to type a line from its start.
  pub let open = (self: mut) -> void => {
    // The words worked out once: a call a cell cost most of a frame on the 68000.
    let space = self.font.word_of(32)
    let base = 0x8000 | ((self.font.palette & 3) << 13) | self.frame
    for row in 0..<self.height {
      let down: u16 = if row == 0 { 0 } else if row + 1 >= self.height { 2 } else { 1 }
      for column in 0..<self.width {
        let across: u16 = if column == 0 { 0 } else if column + 1 >= self.width { 2 } else { 1 }
        let word = if self.frame == 0 { space } else { base + down * self.frame_stride + across }
        vdp.write_cell(self.plane, self.x + column, self.y + row, word)
      }
    }
    self.typed = 0
    self.tick = 0
    self.column = 0
    self.row = 0
    self.shown = true
    self.done = false
  }

  /// A frame of typing `words`: the next letter once every `frames` frames, until all are in.
  /// Call it every frame the box is open, with the same words.
  pub let update = (self: mut, words: string) -> void => {
    if !self.shown || self.done { return }
    self.tick += 1
    if self.tick < self.frames.max(1) { return }
    self.tick = 0
    self.type_letter(words)
  }

  /// The rest of `words` typed at once.
  pub let finish = (self: mut, words: string) -> void => {
    while self.shown && !self.done { self.type_letter(words) }
  }

  /// What a press to go on does: the rest typed while it is typing, else the box shut.
  pub let advance = (self: mut, words: string) -> void => {
    if !self.shown { return }
    if self.done { self.close() } else { self.finish(words) }
  }

  /// The box's cells blanked, and the box shut.
  pub let close = (self: mut) -> void => {
    clear(self.plane, self.x, self.y, self.width, self.height)
    self.shown = false
    self.done = false
  }

  /// Whether the box is showing, and whether it is still typing.
  pub let is_open = pure (self) -> bool => self.shown

  pub let typing = pure (self) -> bool => self.shown && !self.done

  /// The cells across its words have, inside its margin and indent, and the rows down.
  pub let inner_width = pure (self) -> u16 =>
    (self.width.max(3) - 2).max(self.indent + 1) - self.indent

  pub let inner_height = pure (self) -> u16 =>
    (self.height.max(3) - 2).max(self.top + 1) - self.top

  /// The lines of words it holds, `spacing` rows between them, and the row line `line` is on.
  pub let lines = pure (self) -> u16 =>
    (self.inner_height() + self.spacing) / (1 + self.spacing)

  pub let line_row = pure (self, line: u16) -> u16 =>
    self.y + 1 + self.top + line * (1 + self.spacing)

  /// What its cell (`column`, `row`) from its top-left shows before a letter is typed there:
  /// the frame's piece for it — a corner, an edge or the middle — or the font's space; in front
  /// of the sprites when `front`.
  pub let cell_word = pure (self, column: u16, row: u16, front: bool = true) -> u16 => {
    if self.frame == 0 { return self.font.word_of(32, front) }
    let across: u16 = if column == 0 { 0 } else if column + 1 >= self.width { 2 } else { 1 }
    let down: u16 = if row == 0 { 0 } else if row + 1 >= self.height { 2 } else { 1 }
    let bit: u16 = if front { 0x8000 } else { 0 }
    bit | ((self.font.palette & 3) << 13) | (self.frame + down * self.frame_stride + across)
  }

  /// The next letter of `words` into the box: wrapped at a word that would pass the right
  /// edge, a newline starting a row, and the box done at its end or its last row.
  let type_letter = (self: mut, words: string) -> void => {
    let inner_width = self.inner_width()
    let lines = self.lines()
    // The letter typed next, and the length of the word after it.
    var k: u16 = 0
    var letter = NO_LETTER
    var word_after: u16 = 0
    for c in words {
      if letter != NO_LETTER {
        let code = u32(c)
        if code == 32 || code == 10 { break }
        word_after += 1
      } else if k == self.typed {
        letter = u32(c)
      }
      k += 1
    }
    self.typed += 1
    if letter == NO_LETTER {
      self.done = true
      return
    }
    let wraps = letter == 10 || self.column >= inner_width ||
      (letter == 32 && self.column + 1 + word_after > inner_width)
    if wraps {
      self.column = 0
      self.row += 1
      if self.row >= lines {
        self.done = true
        return
      }
      if letter == 10 || letter == 32 { return }
    }
    vdp.write_cell(
      self.plane,
      self.x + 1 + self.indent + self.column,
      self.line_row(self.row),
      self.font.word_of(letter)
    )
    self.column += 1
  }
}
