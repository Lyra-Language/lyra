module std.genesis.raster
//! Raster effects: colours changed partway down the picture, by the VDP's horizontal
//! interrupt — a palette swapped below a waterline, the sky's colour stepped a few lines at a
//! time into a gradient. A game gives a table of [Raster]s, each a line and the colour to set
//! there, and [start]s them as a scene starts; this module's own `@interrupt(hblank)`
//! handler sets each as the VDP reaches its line, and every vertical blank the colours go
//! back to the ones the game set (`vdp.color_of`), so each frame starts from the top.
//!
//! ```
//! import std.genesis.raster
//! import std.genesis.raster.{ Raster }
//!
//! // The backdrop darker from line 112, and darker again from 168.
//! const SKY: [2]Raster = #[
//!   Raster { line: 112, color: 0, word: 0x0400 },
//!   Raster { line: 168, color: 0, word: 0x0200 },
//! ]
//!
//! raster.start(SKY, 0, 2, 56)
//! ```
//!
//! **A split** is a change of a plane's vertical scroll rather than a colour: a [Raster] whose
//! `color` is [SPLIT_A] or [SPLIT_B] shows that plane, from its line down, scrolled to what
//! [scroll_split] last gave — a ground held still under a sky that follows the camera, or
//! moving at its own speed. Its `word` is unused. The plane's scroll above it is
//! `vdp.set_scroll`'s, sent in the vertical blank while a split is on
//! (`vdp.send_scroll_each_frame`), and both parts change on the same frame. Not with the
//! plane's columns apart (`vdp.use_columns`): a split sets the whole plane's scroll.
//!
//! ```
//! const GROUND: [1]Raster = #[Raster { line: 160, color: raster.SPLIT_B, word: 0 }]
//!
//! raster.start(GROUND, 0, 1, 159)
//! // Each frame, with the camera: plane B above line 160 follows it, below it holds still.
//! raster.scroll_split(vdp.PLANE_B, 0)
//! vdp.set_scroll(vdp.PLANE_B, 0, camera_y)
//! ```
//!
//! **A change kept to the world** — a waterline — has [WORLD] in its `color`: its `line` is a
//! line of the world (the map), shown at `line - y` where the game's camera is `y` down it,
//! which the game gives each frame with [scroll_world]. One above the screen colours it from
//! the top; one below it waits. The interrupt still comes every `every` lines: a change between
//! two is made by the one before it, which waits for its line (at most `every` lines, a line
//! about 488 of the 68000's cycles), so a scene with changes kept to the world takes a small
//! `every` — Vega's 8. With such changes the frame's first interrupt comes at its top line
//! (`vdp.hblank_from_top`), so one from line 3 down is made in time; one on line 1 or 2 comes
//! at line 3, the frame's first interrupt having its start to see to.
//!
//! ```
//! // The backdrop dark blue from the water's surface, line 300 of the world, down.
//! const WATER: [1]Raster = #[Raster { line: 300, color: raster.WORLD | 0, word: 0x0400 }]
//!
//! raster.start(WATER, 0, 1, 8)
//! // Each frame, with the camera.
//! raster.scroll_world(camera_y)
//! ```
//!
//! **The colours fade with the screen**: `std.genesis.palette`'s fades tell the VDP how far
//! along they are (`vdp.set_fade`), and each change is shown through it (`vdp.faded`).
//!
//! **The vertical blank interrupt must show the sprites** (`sprites.show`, which sends the
//! colours back first), as every game Vega writes does. **The handler is this module's**: a
//! program importing it has no `@interrupt(hblank)` of its own. It asks the VDP which line it
//! is on (`vdp.line_now`) rather than counting interrupts, so one taken late — held off by a
//! run of writes from the game's loop — still sets every colour due, a few lines down.

import std.genesis.vdp

/// One colour change: from `line` of the picture (1–223; line 0 shows the colour as set) down,
/// CRAM colour `color` (palette × 16 + index, 0–63) is `word`, as `vdp.rgb` makes it — or, with
/// `color` [SPLIT_A] or [SPLIT_B], that plane's vertical scroll is [scroll_split]'s. With
/// [WORLD] added to a colour's, `line` is the world's ([scroll_world]).
pub struct Raster {
  line: u16,
  color: u16,
  word: u16,
}

/// A [Raster]'s `color` naming a split of plane A or of plane B rather than a colour.
pub const SPLIT_A: u16 = 0x100
pub const SPLIT_B: u16 = 0x101

/// The vertical scroll `plane` (`vdp.PLANE_A` or `vdp.PLANE_B`) shows from its split's line
/// down: its pixel row `y` at the split's line less the line — as `vdp.set_scroll`'s `y` is at
/// the screen's top. **Before the plane's `vdp.set_scroll`**, which takes it up with its own,
/// so the parts move on the same frame. Each frame the camera moves.
pub let scroll_split = (plane: u16, y: i16) -> void => vdp.set_split_scroll(plane, y)

/// Added to a colour change's `color`: its `line` is a line of the world, not the screen.
pub const WORLD: u16 = 0x200

/// Where the game's camera is, `y` lines down the world: the changes kept to it ([WORLD])
/// placed on the screen for the next frame, which the vertical blank takes up. Each frame
/// the camera moves, beside the planes' scroll. Nothing without such changes.
pub let scroll_world = (y: i16) -> void => {
  if worlds == 0 { return }
  // Into the plan neither shown nor asked for, and asked for once whole: a vertical blank
  // taking one up mid-build takes the last whole one. With two plans, asking for none while
  // building one, the blank came mid-build every frame and none was ever shown.
  let shown = u16(vdp.raster_plan())
  let asked = u16(vdp.next_raster_plan())
  var plan: u16 = 0
  while plan == shown || plan == asked { plan += 1 }
  build_plan(plan, y)
  vdp.ask_raster_plan(u8(plan))
  unsafe { asked_since_at().write_volatile(true) }
}

/// The most changes one [start] takes.
pub const MAX_RASTERS: u16 = 64

/// The most colours changes kept to the world can give the screen's top at once: each above
/// it, the last of each colour.
pub const MAX_TOPS: u16 = 16

/// The changes `table[first]` to `table[first + count - 1]` — in order down the picture — made
/// each frame from now on, the VDP interrupting every `every` lines (each change's line a
/// multiple of it; fewer interrupts cost the 68000 less). A `count` of 0 stops them. As a
/// scene starts.
pub let start<const N: i64> = (
  table: ref [N]Raster,
  first: u16,
  count: u16,
  every: u16
) -> void => {
  vdp.disable_hblank_interrupt()
  let taken = if count > MAX_RASTERS { MAX_RASTERS } else { count }
  var splits = false
  statics = 0
  worlds = 0
  for k: u16 in 0..<taken {
    changes[k] = table[i64(first + k)]
    let color = changes[k].color
    if color >= SPLIT_A && color < WORLD { splits = true }
    if color >= WORLD {
      world_at[worlds] = u8(k)
      worlds += 1
    } else {
      static_at[statics] = u8(k)
      statics += 1
    }
  }
  step = if every < 1 { 1 } else if every > 224 { 224 } else { every }
  // The first plan, the camera at the world's top, shown from the next frame.
  build_plan(0, 0)
  vdp.show_raster_plan(0)
  last_line = 0xFFFF
  begin_frame(0)
  wrapped = true
  vdp.send_colors_each_frame(taken > 0)
  // A plane scrolled with the camera and the changes kept to the world go out together, in
  // the vertical blank: written at once mid-picture, the plane led the waterline by a frame.
  vdp.send_scroll_each_frame(splits || worlds > 0)
  vdp.hblank_from_top(worlds > 0)
  if taken > 0 { vdp.enable_hblank_interrupt(u8(step - 1)) }
}

/// No more changes: the colours stay as the game set them.
pub let stop = () -> void => {
  vdp.disable_hblank_interrupt()
  statics = 0
  worlds = 0
  build_plan(0, 0)
  vdp.show_raster_plan(0)
  vdp.hblank_from_top(false)
  vdp.send_colors_each_frame(false)
  vdp.send_scroll_each_frame(false)
}

/// What the VDP runs on its horizontal interrupt: the change made ready, if its line is
/// next, written in the gap before that line — then any others of that line, and the one
/// after them made ready. A line no later than the last seen is a new frame's: from the
/// first change again.
///
/// **The gap is narrow.** A 40-cell line's pixel x goes out at `H` 6 + (x + 13) / 2, so its
/// last pixels go after the counter has moved to the next line (at `H` 165): between line
/// L - 1's last pixel and line L's first, the counter reads L from `H` 173 to `H` 11 — about
/// a hundred of the 68000's cycles, fewer than taking the interrupt costs. So the VDP raises
/// it a line early (on the line before each multiple of [start]'s `every`, which is why a
/// change's line is a multiple), the handler points the port at the colour, waits for the
/// counter to reach the line and writes the one word, which the VDP takes in the gap. **The
/// wait is one read a pass** of the H/V counter: a pass of a few more instructions came round
/// too late and the colour began some pixels into the line, and so did a frame's first
/// change while bookkeeping came before the write. Checked in Sheliak, whose beam is
/// BlastEm's, pixel for pixel, on several frames (`genesis_raster_test.go`). **Not always
/// exact**: the interrupt waits for the instruction under way, and for a write the game's
/// loop holds it around, so now and then a colour starts a few pixels into its line — in
/// the hero's sky, one change in several hundred, 12 pixels. The vertical blank's handler
/// does not hold it: the runtime lets it in there (a row of music held it off for lines).
@interrupt(hblank)
let on_line = () -> void => {
  let line = vdp.line_now()
  let fresh = line <= last_line
  // A line no later than the last seen is a new frame's: its first change was made ready as
  // the last frame's last was made, from the plan the vertical blank would take up — so the
  // common way here is a read and three compares, as before plans. One asked for since is
  // made ready now, late: bookkeeping ahead of the write had a frame's first colour pixels
  // into its line, and a split's a line late.
  if fresh {
    // With changes kept to the world the frame's first interrupt comes at its top line
    // (`vdp.hblank_from_top`); the next, taken at that one with the count of 0, at line 1,
    // and from there every `step` lines as set now.
    if worlds > 0 { vdp.set_hblank_lines(u8(step - 1)) }
    if unsafe { asked_since_at().read_volatile() } { take_first(cur_of(vdp.raster_plan())) }
    wrapped = count == 0
  }
  last_line = line
  // Made by a later interrupt, unless that would be too late: the next comes `step` on.
  if wrapped || ready_line > line + step { return }
  let words = data()
  let beam = counter()
  // The address command as one long, both its words; then the word, read through where
  // [make_ready] pointed — a split's as this frame shows it, which the vertical blank set.
  // Nothing here may test which kind the change is: a test cost the colours the gap.
  unsafe { control_long().write_volatile(ready_command) }
  let word = unsafe { ready_from.read_volatile() }
  // To the change's line: one cheap read a pass, as a pass of anything more missed the gap.
  let until = ready_until
  while unsafe { beam.read_volatile() } < until {}
  unsafe { words.write_volatile(word) }
  wrapped = false
  // The next, made ready with this one: on the next line, a call to work it out came too late
  // for its gap — the second of two consecutive lines was a line late (11/23).
  // From the line just made, not the one the interrupt came on: an interrupt held off while
  // this one waited is taken late, after it, too late for a change on the next line.
  let made = ready_line
  if second_line <= made + step {
    // Pointed and read here, written by [the_rest] at its line: that it is already running
    // when the one after comes due lets a third on consecutive lines be on its line too —
    // called after the second's write, its way in had the third pixels into its line.
    unsafe { control_long().write_volatile(second_command) }
    the_rest(second_line, next + 2, unsafe { second_from.read_volatile() }, second_until)
  } else {
    the_rest(made, next + 1, 0, NO_WAIT)
  }
}

/// After the change made ready: the second's `word`, its port already pointed, written when
/// the H/V counter reaches `until` (none with [NO_WAIT]); then the others within a step of the
/// last made (`made`), each waiting for its own line, then the next made ready — or, the
/// frame's last made, the next frame's first. A function of its own: in the handler, its
/// registers were saved on the way in, and the first colour of a frame came pixels into its
/// line.
@noinline
let the_rest = (made: u16, from: u16, word: u16, until: u16) -> void => {
  let port = control_long()
  let words = data()
  let beam = counter()
  if until != NO_WAIT {
    unsafe {
      while beam.read_volatile() < until {}
      words.write_volatile(word)
    }
  }
  let base = cur * MAX_RASTERS
  var k = from
  var last = made
  while k < count {
    let at_k = i64(base + k)
    let made_by = plan_made[at_k]
    if made_by > last + step { break }
    last = made_by
    // Everything worked out as the plan was built — the line, the wait, the command — and
    // the word read before the wait, which ends at the line: a fade worked out after it had
    // the colour come pixels into the line, and each change worked out here took more than a
    // line, so a third change on consecutive lines came a line late.
    let command = plan_command[at_k]
    unsafe { port.write_volatile(command) }
    let until = plan_until[at_k]
    let word = if command < COLOR_COMMAND { unsafe { vdp.split_word_at(plan_color[at_k] & 1)^ } } else {
      vdp.faded(plan_word[at_k])
    }
    unsafe {
      while beam.read_volatile() < until {}
      words.write_volatile(word)
    }
    k += 1
  }
  if k < count { make_ready(k) } else {
    // The next frame's first change, from the plan the vertical blank will take up.
    begin_frame(cur_of(vdp.next_raster_plan()))
    wrapped = true
  }
}

// ── Beneath ──────────────────────────────────────────────────────────────────────────

/// Plan `plan` the one changes are made from, and its first change made ready.
let begin_frame = (plan: u16) -> void => {
  unsafe { asked_since_at().write_volatile(false) }
  cur = plan
  count = plan_count[i64(cur)]
  ready_line = NO_LINE
  if count > 0 { make_ready(0) }
}

/// Plan `plan` the one changes are made from, its first two changes made ready as
/// [build_plan] worked them out — copied, no more, as the frame's first interrupt does this
/// ahead of a change on its line 1: working them out there took three and a half lines.
let take_first = (plan: u16) -> void => {
  unsafe { asked_since_at().write_volatile(false) }
  let p = i64(plan)
  cur = plan
  count = plan_count[p]
  next = 0
  ready_line = first_line[p]
  ready_until = first_until[p]
  ready_command = first_command[p]
  ready_from = first_from[p]
  second_line = after_line[p]
  second_until = after_until[p]
  second_command = after_command[p]
  second_from = after_from[p]
}

/// Plan `plan`'s first two changes worked out as [make_ready] would — faded as the screen is
/// now — for [take_first].
let prepare_first = (plan: u16) -> void => {
  let p = i64(plan)
  first_line[p] = NO_LINE
  after_line[p] = NO_LINE
  let n = plan_count[p]
  for k: u16 in 0..<n.min(2) {
    let at_k = i64(plan * MAX_RASTERS + k)
    let at = plan_line[at_k]
    let color = plan_color[at_k]
    let split = color >= SPLIT_A
    let line = if split { at - 1 } else { at }
    let until = if split { (at - 2) << 8 } else { at << 8 }
    let command = if split {
      (u32(0x4000 | ((color & 1) * 2)) << 16) | 0x0010
    } else { u32(0xC000 | ((color & 63) * 2)) << 16 }
    if k == 0 {
      first_line[p] = line
      first_until[p] = until
      first_command[p] = command
      first_word[p] = vdp.faded(plan_word[at_k])
      first_from[p] = if split { vdp.split_word_at(color & 1) } else { unsafe { &first_word[p] } }
    } else {
      after_line[p] = line
      after_until[p] = until
      after_command[p] = command
      after_word[p] = vdp.faded(plan_word[at_k])
      after_from[p] = if split { vdp.split_word_at(color & 1) } else { unsafe { &after_word[p] } }
    }
  }
}

/// A plan as `vdp` names it, as [cur] holds it.
let cur_of = pure (plan: u8) -> u16 => u16(plan).min(PLANS - 1)

/// Entry `k` of the plan made ready for the interrupt: the line it is made by, the H/V
/// counter its write waits for, its address command (CRAM's colour, or VSRAM's plane for a
/// split) and where its word is read from — a split's as it is written.
let make_ready = (k: u16) -> void => {
  next = k
  let at_k = i64(cur * MAX_RASTERS + k)
  let at = plan_line[at_k]
  let color = plan_color[at_k]
  if color >= SPLIT_A {
    ready_line = at - 1
    ready_until = (at - 2) << 8
    ready_command = (u32(0x4000 | ((color & 1) * 2)) << 16) | 0x0010
    ready_from = vdp.split_word_at(color & 1)
  } else {
    ready_line = at
    ready_until = at << 8
    ready_command = u32(0xC000 | ((color & 63) * 2)) << 16
    ready_word = vdp.faded(plan_word[at_k])
    ready_from = unsafe { &ready_word }
  }
  // And the one after it, written straight after it where the next interrupt is too late.
  second_line = NO_LINE
  if k + 1 < count {
    let at2 = plan_line[at_k + 1]
    let color2 = plan_color[at_k + 1]
    if color2 >= SPLIT_A {
      second_line = at2 - 1
      second_until = (at2 - 2) << 8
      second_command = (u32(0x4000 | ((color2 & 1) * 2)) << 16) | 0x0010
      second_from = vdp.split_word_at(color2 & 1)
    } else {
      second_line = at2
      second_until = at2 << 8
      second_command = u32(0xC000 | ((color2 & 63) * 2)) << 16
      second_word = vdp.faded(plan_word[at_k + 1])
      second_from = unsafe { &second_word }
    }
  }
}

/// Plan `plan` (0 or 1) for the camera `y` down the world: the changes the screen shows, in
/// the order the interrupt makes them — those on the screen and those kept to the world
/// merged by the line each is made on, a split ahead of a colour made on the same — and the
/// colours changes kept to the world above the screen give its top, for the vertical blank
/// (`vdp.raster_top`).
let build_plan = (plan: u16, y: i16) -> void => {
  let base = plan * MAX_RASTERS
  var n: u16 = 0
  var s: u16 = 0
  var w: u16 = 0
  var tops: u16 = 0
  var top_at: [16]u16 = #[0; 16]
  var top_word: [16]u16 = #[0; 16]
  while s < statics || w < worlds {
    // The world's next on the screen, or above it (the top's), or past its foot (no more).
    var world_line: i32 = 0x7FFF
    if w < worlds {
      world_line = i32(changes[i64(world_at[i64(w)])].line) - i32(y)
      if world_line < 1 {
        let change = changes[i64(world_at[i64(w)])]
        let color = change.color & 63
        var t: u16 = 0
        while t < tops && top_at[i64(t)] != color { t += 1 }
        if t < MAX_TOPS {
          top_at[i64(t)] = color
          top_word[i64(t)] = change.word
          if t == tops { tops += 1 }
        }
        w += 1
        continue
      }
      if world_line >= i32(vdp.SCREEN_HEIGHT) {
        w = worlds
        world_line = 0x7FFF
      }
    }
    let static_key = if s < statics {
      made_on(changes[i64(static_at[i64(s)])], changes[i64(static_at[i64(s)])].line)
    } else { 0x7FFF }
    let world_key = if world_line < 0x7FFF { u16(world_line) * 2 + 1 } else { 0x7FFF }
    if static_key == 0x7FFF && world_key == 0x7FFF { break }
    if static_key <= world_key {
      let change = changes[i64(static_at[i64(s)])]
      plan_line[i64(base + n)] = change.line
      plan_color[i64(base + n)] = change.color & 0x1FF
      plan_word[i64(base + n)] = change.word
      worked_out(base + n)
      s += 1
    } else {
      let change = changes[i64(world_at[i64(w)])]
      plan_line[i64(base + n)] = u16(world_line)
      plan_color[i64(base + n)] = change.color & 0x1FF
      plan_word[i64(base + n)] = change.word
      worked_out(base + n)
      w += 1
    }
    n += 1
  }
  plan_count[i64(plan)] = n
  prepare_first(plan)
  vdp.set_raster_top(u8(plan), top_at, top_word, tops)
}

/// Plan entry `at_k`'s line it is made by, the H/V counter its write waits for and its
/// address command, from its line and colour: what [the_rest] reads.
let worked_out = (at_k: u16) -> void => {
  let i = i64(at_k)
  let at = plan_line[i]
  let color = plan_color[i]
  if color >= SPLIT_A {
    plan_made[i] = at - 1
    plan_until[i] = (at - 2) << 8
    plan_command[i] = (u32(0x4000 | ((color & 1) * 2)) << 16) | 0x0010
  } else {
    plan_made[i] = at
    plan_until[i] = at << 8
    plan_command[i] = u32(0xC000 | ((color & 63) * 2)) << 16
  }
}

/// A colour's address command and above (CRAM's); a split's, VSRAM's, is below.
const COLOR_COMMAND: u32 = 0xC0000000

/// A change's order on the screen at line `at`: twice the line it is made by, a split's one
/// less, so it goes ahead of a colour made on the same line.
let made_on = pure (change: Raster, at: u16) -> u16 =>
  if (change.color & 0x1FF) >= SPLIT_A { (at - 1) * 2 } else { at * 2 + 1 }

let control = pure () -> ^mut u16 => unsafe { pointer_at(0xC00004) }

/// The control port written a long at a time: an address command's two words in one.
let control_long = pure () -> ^mut u32 => unsafe { pointer_at(0xC00004) }

/// The VDP's H/V counter: the line in its high byte, the place along it in its low.
let counter = pure () -> ^u16 => unsafe { pointer_at(0xC00008) }

let data = pure () -> ^mut u16 => unsafe { pointer_at(0xC00000) }

/// The changes [start] took; which of them are on the screen and which kept to the world,
/// each in order down it, and how many of each.
var changes: [64]Raster = #[Raster { line: 0, color: 0, word: 0 }; 64]
var static_at: [64]u8 = #[0; 64]
var world_at: [64]u8 = #[0; 64]
var statics: u16 = 0
var worlds: u16 = 0

/// How many lines apart the interrupt comes ([start]'s `every`).
var step: u16 = 1

/// Three plans, a frame's changes in the order they are made: each change's line on the
/// screen, its colour (or split) and word, [MAX_RASTERS] a plan — read by the interrupt with
/// no change copied, as making a change ready at a frame's first interrupt must be quick; how
/// many each holds; the one this frame shows (`vdp.raster_plan`, as the vertical blank took
/// it up) and how many it holds. Three, so one is built while one is shown and another asked
/// for.
const PLANS: u16 = 3
var plan_line: [192]u16 = #[0; 192]
var plan_color: [192]u16 = #[0; 192]
var plan_word: [192]u16 = #[0; 192]
var plan_made: [192]u16 = #[0; 192]
var plan_until: [192]u16 = #[0; 192]
var plan_command: [192]u32 = #[0; 192]
var plan_count: [3]u16 = #[0; 3]
var cur: u16 = 0
var count: u16 = 0

/// No line: nothing made ready.
const NO_LINE: u16 = 0xFFFF

/// No wait: [the_rest] has no second change to write.
const NO_WAIT: u16 = 0xFFFF

/// The change made ready: its place in the plan, the line it is made by, the H/V counter its
/// write waits for, its address command (both words: CRAM's colour, or VSRAM's plane for a
/// split), its word (a colour's; a split's is the VDP module's) and where the word is read
/// from; and whether the frame's changes are all made.
var next: u16 = 0
var ready_line: u16 = NO_LINE
var ready_until: u16 = 0
var ready_command: u32 = 0
var ready_from: ^u16 = nullptr
var ready_word: u16 = 0

/// Each plan's first two changes worked out as [build_plan] made it ([prepare_first]).
var first_line: [3]u16 = #[NO_LINE; 3]
var first_until: [3]u16 = #[0; 3]
var first_command: [3]u32 = #[0; 3]
var first_from: [3]^u16 = #[nullptr; 3]
var first_word: [3]u16 = #[0; 3]
var after_line: [3]u16 = #[NO_LINE; 3]
var after_until: [3]u16 = #[0; 3]
var after_command: [3]u32 = #[0; 3]
var after_from: [3]^u16 = #[nullptr; 3]
var after_word: [3]u16 = #[0; 3]

/// The change after it, made ready with it the same way ([NO_LINE] none).
var second_line: u16 = NO_LINE
var second_until: u16 = 0
var second_command: u32 = 0
var second_from: ^u16 = nullptr
var second_word: u16 = 0
var wrapped: bool = true

/// Whether a plan was asked for ([scroll_world]) since the next frame's first change was made
/// ready.
var asked_since: bool = false
let asked_since_at = () -> ^mut bool => unsafe { &mut asked_since }

/// The line the last interrupt came on.
var last_line: u16 = 0xFFFF
