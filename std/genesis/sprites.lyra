module std.genesis.sprites
//! Hardware sprites: a list a game fills each frame, shown with one call during the
//! vertical blank.
//!
//! ```
//! import std.genesis.sprites.{ Sprite }
//! import std.genesis.sprites
//!
//! sprites.clear()
//! sprites.add(Sprite { x: 100, y: 80, width: 2, height: 2, tile: 1 })
//! vdp.wait_vblank()
//! sprites.show()
//! ```
//!
//! **A sprite is a rectangle of 1–4 × 1–4 tiles** at a screen position, its tiles
//! consecutive in VRAM and read down each column first, in one palette, mirrored either
//! way or not. Eighty are shown at once, twenty on one line. A bigger picture is several
//! sprites side by side — what Vega's sprite editor calls pieces.
//!
//! The list lives in RAM, so building it costs nothing on screen; [show] writes it to the
//! VDP's sprite table, and belongs in the vertical blank.
//!
//! **A sprite may be streamed** ([Stream], [streamed]): its frames stay in the cartridge and
//! video memory holds only the ones shown — a slot a copy on screen at once, each a frame's
//! tiles — sent by DMA in the vertical blank as the frame shown changes. A big sprite with many
//! frames (and the angles and sizes pre-rendered for it) costs a frame's tiles, not all of
//! them; what it costs instead is the vertical blank's time: a frame's bytes each time it
//! changes. [show] sends what [streamed] queued, before the table.

import std.genesis.vdp

/// Sprites the VDP shows at once in 40-cell mode.
pub const MAX: u16 = 80

/// One hardware sprite.
pub struct Sprite {
  /// The top-left corner on the screen, in pixels; off the screen is allowed.
  x: i16,
  y: i16,
  /// Size in tiles, 1–4 each way.
  width: u16 = 1,
  height: u16 = 1,
  /// The first tile, in VRAM (tile n is at byte n × 32).
  tile: u16,
  /// Palette 0–3.
  palette: u16 = 0,
  flip_x: bool = false,
  flip_y: bool = false,
  /// In front of the planes' high-priority tiles too.
  front: bool = false,
}

/// Start a new list: nothing is shown until [add]ed. It starts a frame for the streamed
/// sprites too: a slot drawn in the last list may take another frame now.
pub let clear = () -> void => {
  count = 0
  lists = if lists == 0xFFFE { 0 } else { lists + 1 }
}

/// A streamed sprite: `slots` slots in video memory from tile `tile`, each `size` tiles — its
/// largest frame's — and its slots' place in the runtime's table, from `first_slot` (all the
/// game's streamed sprites' together at most [MAX_SLOTS]). Vega writes one a streamed sprite.
pub struct Stream {
  tile: u16,
  size: u16,
  slots: u16,
  first_slot: u16,
}

/// The slots every streamed sprite may have together, and the frames one vertical blank may be
/// sent ([streamed] queueing them).
pub const MAX_SLOTS: u16 = 32
pub const MAX_SENDS: u16 = 32

/// What [streamed] answers when every slot is drawn already this frame: the sprite is not drawn.
pub const NO_TILE: u16 = 0xFFFF

/// The video memory tile streamed sprite `stream` shows `count` tiles from tile `from` of its
/// art `tiles` at (one frame, or a pre-rendered angle's) — a slot already holding them, else
/// one not drawn this frame (since [clear]), whose tiles [show] sends; [NO_TILE] when every
/// slot is drawn already, or a vertical blank's sends are queued.
pub let streamed<const N: i64> = (
  stream: Stream,
  tiles: ref [N]u32,
  from: u16,
  count: u16
) -> u16 => {
  for k: u16 in 0..<stream.slots {
    let at = stream.first_slot + k
    if slot_from[at] == from {
      slot_list[at] = lists
      return stream.tile + k * stream.size
    }
  }
  if sends >= MAX_SENDS { return NO_TILE }
  for k: u16 in 0..<stream.slots {
    let at = stream.first_slot + k
    if slot_list[at] != lists {
      slot_from[at] = from
      slot_list[at] = lists
      let tile = stream.tile + k * stream.size
      send_source[sends] = u32(unsafe { (&tiles[0]).address() }) + u32(from) * 32
      send_tile[sends] = tile
      send_words[sends] = count * 16
      sends += 1
      return tile
    }
  }
  NO_TILE
}

/// Streamed sprite `stream`'s slots made empty — what a scene's art shown over them leaves —
/// so each frame is sent again when next drawn. Vega's `show_maps` calls it for a scene's
/// streamed sprites, `load` for the rest.
pub let restream = (stream: Stream) -> void => {
  for k: u16 in 0..<stream.slots { slot_from[stream.first_slot + k] = NO_TILE }
}

/// `s` added to the list, drawn in front of those added after it. Past [MAX], ignored.
pub let add = (s: Sprite) -> void => {
  if count >= MAX { return }
  let at = count * 4
  table[at] = u16((s.y + 128) & 0x3FF)
  table[at + 1] = (((s.width - 1) & 3) << 10) | (((s.height - 1) & 3) << 8)
  table[at + 2] = flag(s.front, 15) | ((s.palette & 3) << 13) | flag(s.flip_y, 12) |
    flag(s.flip_x, 11) | (s.tile & 0x7FF)
  table[at + 3] = u16((s.x + 128) & 0x1FF)
  count += 1
}

/// The list written to the VDP's sprite table, each entry linked to the next. Call in
/// the vertical blank ([vdp.wait_vblank]), after the list is complete.
pub let show = () -> void => {
  // The streamed sprites' frames first, so the table's tiles are there when it is.
  for i: u16 in 0..<sends {
    vdp.dma_to_vram(send_source[i], send_tile[i] * 32, send_words[i])
  }
  sends = 0
  vdp.set_vram_address(vdp.SPRITE_TABLE)
  if count == 0 {
    // One sprite, off the top of the screen and linking nowhere: the table's end.
    for _: u16 in 0..<4 { vdp.write_word(0) }
    return
  }
  for i: u16 in 0..<count {
    let at = i * 4
    let link = if i + 1 < count { i + 1 } else { 0 }
    vdp.write_word(table[at])
    vdp.write_word(table[at + 1] | link)
    vdp.write_word(table[at + 2])
    vdp.write_word(table[at + 3])
  }
}

/// The list: four words a sprite, in the order the VDP's table holds them, links left 0.
var table: [320]u16 = #[0; 320]

/// Sprites in the list.
var count: u16 = 0

/// Lists started ([clear]), going round below [NO_TILE]: which frame a slot was last drawn in.
var lists: u16 = 0

/// Each slot's first tile of the art it holds ([NO_TILE] for none), and the list it was last
/// drawn in.
var slot_from: [32]u16 = #[0xFFFF; 32]
var slot_list: [32]u16 = #[0xFFFF; 32]

/// The frames [show] sends: from where, to which tile, how many words.
var send_source: [32]u32 = #[0; 32]
var send_tile: [32]u16 = #[0; 32]
var send_words: [32]u16 = #[0; 32]
var sends: u16 = 0

let flag = pure (on: bool, bit: u16) -> u16 => if on { 1 << bit } else { 0 }
