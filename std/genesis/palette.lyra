module std.genesis.palette
//! The 64 colours as a game changes them while it plays: runs of a palette's colours
//! rotating — water flowing, lava glowing, lights chasing — and the whole screen faded to a
//! colour and back.
//!
//! ```
//! import std.genesis.palette
//! import std.genesis.palette.{ Cycle }
//!
//! const WATER: [1]Cycle = #[Cycle { palette: 1, first: 9, count: 3, frames: 8 }]
//!
//! loop {
//!   palette.step_cycles(WATER)        // once a frame
//!   vdp.wait_vblank()
//!   sprites.show()                    // sends the colours changed, first
//! }
//! palette.fade_to(vdp.rgb(0, 0, 0), 30)   // half a second to black, waiting
//! palette.fade_back(30)                    // and back
//!
//! palette.start_fade_to(vdp.rgb(0, 0, 0), 30)   // or a step a frame, the game going on
//! loop { if palette.step_fade() { break } … }   // once a frame; true once it is over
//! ```
//!
//! **What they change reaches CRAM in the vertical blank**, queued (`vdp.queue_color`) and sent
//! by `sprites.show` before anything else — or by `vdp.send_colors` in a game that does not call
//! it: written while the picture is drawn, a colour changes partway down the screen, and a step
//! of a fade tore across it in the hero's game, whose interrupt's music had used up the blank.
//!
//! **Both work from the colours as shown** — `vdp`'s copy of what it last wrote to CRAM
//! (`vdp.color_of`) — so they need nothing loaded through them: a palette `vdp.load_palette`
//! wrote turns and fades. A cycle turns its colours one place a step, as the hardware's
//! colours are its only state, so a colour set by the game in a run turns with it.

import std.genesis.vdp
import std.genesis.sprites

/// A run of palette `palette`'s colours turning: `count` from `first`, a step every `frames`
/// frames moving each one place on — the last to the first — or back. Vega writes a
/// project's as `PALETTE_CYCLES`.
pub struct Cycle {
  palette: u16,
  first: u16,
  count: u16,
  frames: u16,
  backward: bool = false,
}

/// Each of `cycles` a step on where its frames have passed since the last: once a frame —
/// Vega's scenes call it from `scroll_maps`. The colours go to CRAM at the next vertical blank,
/// with `sprites.show` (or `vdp.send_colors` in a game that does not call it).
pub let step_cycles<const N: i64> = (cycles: ref [N]Cycle) -> void => {
  ticks = ticks.wrapping_add(1)
  for c in cycles {
    if c.count < 2 || c.frames == 0 || ticks % c.frames != 0 { continue }
    turn(c)
  }
}

/// Every colour from what it shows to `color` (a CRAM word, `vdp.rgb`'s) over `frames` frames,
/// a step each vertical blank, returning once it is there: the screen to black, to white, or a
/// flash of a colour. What it showed is kept for [fade_back].
pub let fade_to = (color: u16, frames: u16) -> void => {
  start_fade_to(color, frames)
  waited()
}

/// Every colour back from what it shows to what it showed before the last [fade_to] (or
/// [start_fade_to]), over `frames` frames, returning once it is there.
pub let fade_back = (frames: u16) -> void => {
  start_fade_back(frames)
  waited()
}

/// A fade that does not wait: [fade_to]'s begun, each step taken by [step_fade] once a frame
/// — what a cutscene fades by while the game goes on.
pub let start_fade_to = (color: u16, frames: u16) -> void => {
  for i: u16 in 0..<64 {
    before[i] = vdp.color_of(i / 16, i % 16)
    fade_target[i] = color
  }
  faded_to = color
  begin(true, frames)
}

/// [fade_back]'s begun, each step taken by [step_fade].
pub let start_fade_back = (frames: u16) -> void => {
  for i: u16 in 0..<64 { fade_target[i] = before[i] }
  begin(false, frames)
}

/// A step of the fade begun ([start_fade_to], [start_fade_back]): its colours queued for the
/// next vertical blank, as [step_cycles]'s are. Whether it is over — at once where none was
/// begun.
pub let step_fade = () -> bool => {
  if fade_step >= fade_steps { return true }
  fade_step += 1
  for i: u16 in 0..<64 {
    vdp.queue_color(
      i / 16,
      i % 16,
      mixed(fade_from[i], fade_target[i], fade_step, fade_steps)
    )
  }
  let levels = i16(fade_step) * 7 / i16(fade_steps)
  vdp.set_fade(faded_to, if fading_out { levels } else { 7 - levels })
  fade_step >= fade_steps
}

// ── Beneath ──────────────────────────────────────────────────────────────────────────

/// Frames counted by [step_cycles], whose steps fall where a cycle's frames divide it.
var ticks: u16 = 0

/// The colours before the last [fade_to], and the colour it faded to.
var before: [64]u16 = #[0; 64]
var faded_to: u16 = 0

/// The fade under way: each colour from what it showed to its target, `fade_steps` steps, of
/// which `fade_step` are taken; out to [faded_to] or back from it.
var fade_from: [64]u16 = #[0; 64]
var fade_target: [64]u16 = #[0; 64]
var fade_step: u16 = 0
var fade_steps: u16 = 0
var fading_out: bool = false

/// Cycle `c`'s colours one place on (or back).
let turn = (c: Cycle) -> void => {
  let last = c.first + c.count - 1
  if c.backward {
    let first = vdp.color_of(c.palette, c.first)
    for k: u16 in c.first..<last {
      vdp.queue_color(c.palette, k, vdp.color_of(c.palette, k + 1))
    }
    vdp.queue_color(c.palette, last, first)
  } else {
    let end = vdp.color_of(c.palette, last)
    var k = last
    while k > c.first {
      vdp.queue_color(c.palette, k, vdp.color_of(c.palette, k - 1))
      k -= 1
    }
    vdp.queue_color(c.palette, c.first, end)
  }
}

/// A fade begun from what every colour shows now, over `frames` frames — `out` to [faded_to],
/// else back from it — towards [fade_target]. The VDP is told how far along it is at each step
/// (`vdp.set_fade`), so colours set partway down the picture (`std.genesis.raster`) fade too.
let begin = (out: bool, frames: u16) -> void => {
  for i: u16 in 0..<64 { fade_from[i] = vdp.color_of(i / 16, i % 16) }
  fade_steps = frames.max(1)
  fade_step = 0
  fading_out = out
}

/// The fade begun stepped a vertical blank at a time, returning once it is over and shown.
let waited = () -> void => {
  loop {
    let over = step_fade()
    next_blank()
    if over { break }
  }
}

/// Wait for the next vertical blank to send the colours queued: the one the game's interrupt
/// shows the sprites in (`sprites.show` sends them first), or, with no interrupt, the next one
/// begun, sending them here. Polled with the interrupt on, the blank could pass inside the
/// handler unseen, and the colours would be written while the picture is drawn.
let next_blank = () -> void => {
  if vdp.vblank_interrupt_on() {
    let seen = sprites.shown()
    while sprites.shown() == seen {}
  } else {
    vdp.wait_vblank()
    vdp.send_colors()
  }
}

/// CRAM word `a` taken `k` of `steps` of the way to `b` as the Genesis fades: every channel a
/// level nearer at the same moments — seven, evenly over the steps, the most a channel's
/// eight levels need — so the whole screen changes together, a channel already there waiting.
/// Each channel stepped by its own share changed one now and another the frame after, and the
/// fade looked jumpy (11/13).
let mixed = pure (a: u16, b: u16, k: u16, steps: u16) -> u16 =>
  vdp.toward(a, b, i16(k) * 7 / i16(steps))
