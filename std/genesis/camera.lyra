module std.genesis.camera
//! A camera on a world bigger than the screen: where the view is, moved to follow the
//! player, and a tile map kept in a plane as it scrolls.
//!
//! ```
//! import std.genesis.camera
//! import std.genesis.camera.{ Camera }
//!
//! var view = Camera { world_width: 640, world_height: 512 }
//! view.show_map(vdp.PLANE_B, LEVEL, LEVEL_WIDTH)   // once, before display_on
//! loop {
//!   // … move the player, in the world's pixels
//!   view.follow(x, y, PLAYER_WIDTH, PLAYER_HEIGHT)
//!   let (sx, sy) = view.on_screen(x, y)   // … and draw its sprites there
//!   vdp.wait_vblank()
//!   view.scroll_map(vdp.PLANE_B, LEVEL, LEVEL_WIDTH)
//! }
//! ```
//!
//! **The camera moves only when it must**: what it follows is free inside the camera's
//! [Zone], a rectangle of the screen, and the view moves when it crosses the zone's edge —
//! just enough to keep it there — and never past the world's edges, where the player may
//! walk on to the world's end. The zone is the game's to choose, and to change as it
//! goes: the middle third each way unless it says otherwise ([THIRDS]), a box of any size
//! in the middle ([centred_zone]; `centred_zone(0, 0)` keeps the player centred), or any
//! rectangle — a platformer's, say, low on the screen and wide:
//!
//! ```
//! view.zone = Zone { left: 120, top: 120, right: 200, bottom: 190 }
//! ```
//!
//! **A map larger than a plane scrolls without redrawing it.** The VDP's plane (64×32
//! cells) wraps, and map cell (x, y) is kept at the plane's cell (x mod 64, y mod 32): the
//! scroll registers then show the view wherever it is, and [scroll_map] streams in only the
//! columns and rows that came into view since the last [follow]. A map's cells are its
//! name-table words, row by row (`vdp.write_plane`'s, and Vega's `assets` tables), or
//! blocks of them (`std.genesis.blocks`), expanded here as they stream. The plane holds
//! eight columns either side of the view as well, so a ripple ([Band]) moving a line by up
//! to [MAX_RIPPLE] pixels shows the map, not what a column held before — and a row above
//! and below it.
//!
//! **Streamed by DMA, a frame ahead**: the columns and rows are worked out where
//! [scroll_map] is called and staged in RAM (`vdp.stage`), and `sprites.show` sends them in
//! the next vertical blank — a column by the VDP's auto-increment down the plane, a row as
//! one run. They are that far ahead of the view, the margins' worth, so arriving a frame late
//! shows nothing; a move further than the margins in one frame (64 pixels across, 8 down) is
//! sent at once.
//!
//! **A plane's lines may scroll apart** — the VDP's line scroll: [Band]s, strips of its map
//! each at a speed of its own, drifting, ramping from one speed to another down the strip
//! (a floor in perspective) or rippling, written each frame by [scroll_bands]. Bands moving
//! apart from the plane show other columns than its own scroll does, so they need a map that
//! repeats across the plane — 8, 16, 32 or 64 cells wide — shown by [show_repeating] and
//! kept by [scroll_repeating]; a ripple alone needs nothing.

import std.genesis.vdp
import std.genesis.blocks

/// The part of the screen what a camera follows may move in without the view moving, in
/// screen pixels: `left` ≤ x and x + its width ≤ `right`, and the same down.
pub struct Zone {
  left: i16,
  top: i16,
  right: i16,
  bottom: i16,
}

/// The middle third of the screen each way — a camera's zone unless the game sets another.
pub const THIRDS: Zone = Zone { left: 106, top: 74, right: 214, bottom: 150 }

/// A zone `width` × `height` in the middle of the screen. One smaller than what the camera
/// follows keeps that centred: `centred_zone(0, 0)` pans with every step.
pub let centred_zone = pure (width: i16, height: i16) -> Zone => Zone {
  left: (vdp.SCREEN_WIDTH - width) / 2,
  top: (vdp.SCREEN_HEIGHT - height) / 2,
  right: (vdp.SCREEN_WIDTH + width) / 2,
  bottom: (vdp.SCREEN_HEIGHT + height) / 2,
}

/// A strip of a plane's map scrolling apart from the rest — `height` lines from line `top`
/// of the map, in its pixels — for [scroll_bands]. Its speeds are 256ths of the camera's
/// (256 with it, 0 fixed), as `parallaxed`'s: `speed` at its top line, `ramp_to` at its
/// last, the lines between stepped evenly (the same for none). `drift` moves it on its own,
/// in 256ths of a pixel a frame to the right (below 0, the left) — clouds. A ripple moves each line by up to `wave` pixels
/// (at most [MAX_RIPPLE] on a map that does not repeat), a sine whose phase moves on
/// `wave_step` a line and `wave_speed` a frame, both in 65536ths of a turn.
pub struct Band {
  top: i16,
  height: i16,
  speed: i16 = 256,
  ramp_to: i16 = 256,
  drift: i16 = 0,
  wave: i16 = 0,
  wave_step: u16 = 0,
  wave_speed: u16 = 0,
}

/// How far a ripple may move a line of a map that does not repeat: the columns the plane
/// holds past each side of the view.
pub const MAX_RIPPLE: i16 = 64

/// Where the view is in a world, and where it was.
pub struct Camera {
  /// The view's top-left in the world, in pixels.
  x: i16 = 0,
  y: i16 = 0,
  /// The world's size in pixels: the view never leaves it.
  world_width: i16,
  world_height: i16,
  /// Where on the screen what it follows may move without the view moving.
  zone: Zone = THIRDS,
  /// Where the view was before the last [follow]: [scroll_map] writes what came into view
  /// since.
  last_x: i16 = 0,
  last_y: i16 = 0,
}

impl Camera {

  /// Move the view to keep the rectangle `x`, `y`, `width` × `height` (in the world's
  /// pixels) inside the camera's zone on the screen: it moves only when the rectangle crosses
  /// the zone's edge, and then just enough — never past the world's edges. Call once a
  /// frame, after moving what it follows.
  pub let follow = (self: mut, x: i16, y: i16, width: i16, height: i16) -> void => {
    self.last_x = self.x
    self.last_y = self.y
    let z = self.zone
    self.x = along(self.x, x, width, z.left, z.right, vdp.SCREEN_WIDTH, self.world_width)
    self.y = along(
      self.y,
      y,
      height,
      z.top,
      z.bottom,
      vdp.SCREEN_HEIGHT,
      self.world_height
    )
  }

  /// The view a step of `speed` pixels towards top-left (`x`, `y`) along the straight line — the
  /// longer way at `speed`, the shorter its share, so both arrive together — the target
  /// held inside the world, as [follow] holds the view — whether it is there now: a
  /// cutscene's camera, which pans rather than follows. Once a frame in place of [follow],
  /// which it stands for in [scroll_map]'s `last_x` and `last_y`.
  pub let pan_to = (self: mut, x: i16, y: i16, speed: i16) -> bool => {
    self.last_x = self.x
    self.last_y = self.y
    let tx = x.clamp(0, (self.world_width - vdp.SCREEN_WIDTH).max(0))
    let ty = y.clamp(0, (self.world_height - vdp.SCREEN_HEIGHT).max(0))
    // Along the straight line: the longer way at `speed`, the shorter its share, rounded up
    // so it never falls behind, both arriving together.
    let dx = i32((tx - self.x).abs())
    let dy = i32((ty - self.y).abs())
    let fast = i32(speed.max(1))
    let (bx, by) = if dx >= dy {
      (fast, if dx == 0 { 0 } else { (fast * dy + dx - 1) / dx })
    } else { ((fast * dx + dy - 1) / dy, fast) }
    self.x = toward(self.x, tx, i16(bx))
    self.y = toward(self.y, ty, i16(by))
    self.x == tx && self.y == ty
  }

  /// The view's top-left with the rectangle `x`, `y`, `width` × `height` in its middle, held
  /// inside the world as [follow] holds the view: where [pan_to] takes a cutscene's camera back
  /// to what it follows.
  pub let centred_on = pure (
    self,
    x: i16,
    y: i16,
    width: i16,
    height: i16
  ) -> (i16, i16) => (
    (x + width / 2 - vdp.SCREEN_WIDTH / 2).clamp(
      0,
      (self.world_width - vdp.SCREEN_WIDTH).max(0)
    ),
    (y + height / 2 - vdp.SCREEN_HEIGHT / 2).clamp(
      0,
      (self.world_height - vdp.SCREEN_HEIGHT).max(0)
    )
  )

  /// Where world position (`x`, `y`) is on the screen, for a sprite.
  pub let on_screen = pure (self, x: i16, y: i16) -> (i16, i16) =>
    (x - self.x, y - self.y)

  /// A map into `plane` around the view, and the plane scrolled to it: every cell the plane
  /// holds. Once, before `vdp.display_on()` — and after a jump too far for [scroll_map].
  /// `cells` is the map row by row, `width` cells a row.
  pub let show_map<const N: i64> = (
    self,
    plane: u16,
    cells: ref [N]u16,
    width: u16
  ) -> void => {
    // From the margin's first column, before the view's left: wrapping below 0 is a column
    // past the map's edge, blank, at the plane column it would have.
    let left = cell_of(self.x).wrapping_sub(MARGIN)
    // From the row above the view: the margin, which a row past the map's top leaves blank.
    let top = cell_of(self.y).wrapping_sub(ROW_MARGIN)
    let shift = left % vdp.PLANE_WIDTH
    // What was staged for the plane would land on these, a frame late.
    vdp.drop_staged(plane)
    // Its rows are runs of writes the vertical blank interrupt must not land in.
    let held = vdp.hold_vblank()
    for row: u16 in 0..<vdp.PLANE_HEIGHT {
      let my = top.wrapping_add(row)
      vdp.set_vram_address(plane + (my % vdp.PLANE_HEIGHT) * vdp.PLANE_WIDTH * 2)
      // The plane's columns from 0 hold the map's from `left + 64 - shift` to the right edge
      // of what it holds, then from `left`: two runs of the row.
      write_run(cells, width, left.wrapping_add(vdp.PLANE_WIDTH - shift), my, shift)
      write_run(cells, width, left, my, vdp.PLANE_WIDTH - shift)
    }
    vdp.release_vblank(held)
    vdp.set_scroll(plane, self.x, self.y)
  }

  /// The view as a plane scrolling at `fx`/256, `fy`/256 of its speed sees the world (256
  /// with it, 0 fixed to the screen): for a parallax plane, whose columns come into view at
  /// its own pace, so `last_x` and `last_y` are scaled as well.
  pub let parallaxed = pure (self, fx: i16, fy: i16) -> Camera => Camera {
    self |
    x: i16((i32(self.x) * i32(fx)) >> 8),
    y: i16((i32(self.y) * i32(fy)) >> 8),
    last_x: i16((i32(self.last_x) * i32(fx)) >> 8),
    last_y: i16((i32(self.last_y) * i32(fy)) >> 8),
  }

  /// Keep a map in `plane` as the view moves: the columns and rows that came into view since
  /// the last [follow] staged for the next vertical blank (sent at once past the margins),
  /// and the plane scrolled to the view. Once a frame, in the vertical blank, with the map
  /// [show_map] wrote.
  pub let scroll_map<const N: i64> = (
    self,
    plane: u16,
    cells: ref [N]u16,
    width: u16
  ) -> void => {
    let old_left = cell_of(self.last_x)
    let old_top = cell_of(self.last_y)
    let left = cell_of(self.x)
    let top = cell_of(self.y)
    // A jump a view wide or more: nothing in the plane is kept, so draw it all.
    if distance(old_left, left) >= VIEW_COLUMNS || distance(old_top, top) >= VIEW_ROWS {
      self.show_map(plane, cells, width)
      return
    }
    let held_top = top.wrapping_sub(ROW_MARGIN)
    let held = vdp.hold_vblank()
    // The columns held run from MARGIN before the view's left to MARGIN past its right, the
    // rows from ROW_MARGIN above its top to ROW_MARGIN below its foot.
    if left > old_left {
      for k: u16 in 0..<left - old_left {
        stage_column(plane, cells, width, old_left + VIEW_COLUMNS + MARGIN + k, held_top)
      }
    } else if left < old_left {
      for k: u16 in 0..<old_left - left {
        stage_column(
          plane,
          cells,
          width,
          left.wrapping_sub(MARGIN).wrapping_add(k),
          held_top
        )
      }
    }
    if top > old_top {
      for my: u16 in old_top + VIEW_ROWS + ROW_MARGIN..<top + VIEW_ROWS + ROW_MARGIN {
        stage_row(plane, cells, width, my, left)
      }
    } else if top < old_top {
      for k: u16 in 0..<old_top - top {
        stage_row(plane, cells, width, top.wrapping_sub(ROW_MARGIN).wrapping_add(k), left)
      }
    }
    // Further than the margins: needed in this picture, not the next.
    if distance(old_left, left) > MARGIN || distance(old_top, top) > ROW_MARGIN {
      vdp.send_staged()
    }
    vdp.release_vblank(held)
    vdp.set_scroll(plane, self.x, self.y)
  }

  /// A map repeating across `plane` — `width` cells wide, 8, 16, 32 or 64, so the plane's 64
  /// columns hold it whole each time — and the plane scrolled to the view: what bands moving
  /// apart from it need ([Band]). Its rows as [show_map] writes them. Once, before
  /// `vdp.display_on()`.
  pub let show_repeating<const N: i64> = (
    self,
    plane: u16,
    cells: ref [N]u16,
    width: u16
  ) -> void => {
    let top = cell_of(self.y).wrapping_sub(ROW_MARGIN)
    vdp.drop_staged(plane)
    let held = vdp.hold_vblank()
    for row: u16 in 0..<vdp.PLANE_HEIGHT {
      write_whole_row(plane, cells, width, top.wrapping_add(row))
    }
    vdp.release_vblank(held)
    vdp.set_scroll(plane, self.x, self.y)
  }

  /// Keep a repeating map ([show_repeating]) in `plane` as the view moves: the rows that came
  /// into view, every column of each, staged as [scroll_map]'s are, and the plane scrolled to
  /// the view. Once a frame, in the vertical blank.
  pub let scroll_repeating<const N: i64> = (
    self,
    plane: u16,
    cells: ref [N]u16,
    width: u16
  ) -> void => {
    let old_top = cell_of(self.last_y)
    let top = cell_of(self.y)
    if distance(old_top, top) >= VIEW_ROWS {
      self.show_repeating(plane, cells, width)
      return
    }
    let held = vdp.hold_vblank()
    if top > old_top {
      for my: u16 in old_top + VIEW_ROWS + ROW_MARGIN..<top + VIEW_ROWS + ROW_MARGIN {
        stage_whole_row(plane, cells, width, my)
      }
    } else if top < old_top {
      for k: u16 in 0..<old_top - top {
        stage_whole_row(plane, cells, width, top.wrapping_sub(ROW_MARGIN).wrapping_add(k))
      }
    }
    if distance(old_top, top) > ROW_MARGIN { vdp.send_staged() }
    vdp.release_vblank(held)
    vdp.set_scroll(plane, self.x, self.y)
  }

  /// Each of `plane`'s lines scrolled as `bands` say, the view's x the camera's (this one,
  /// not a plane's `parallaxed` view): a line no band holds at `speed` 256ths of it, as the
  /// plane's own scroll. `plane_y` is where the plane is scrolled down to (its view's y), so
  /// line l shows the map's line `plane_y + l`; `bands` are in order down the map, apart;
  /// `ticks` counts frames, for drift and ripples. Once a frame, in the vertical blank,
  /// after the plane's [scroll_map] or [scroll_repeating], with `vdp.use_bands` saying the
  /// plane's lines are the game's.
  pub let scroll_bands<const N: i64> = (
    self,
    plane: u16,
    plane_y: i16,
    speed: i16,
    bands: ref [N]Band,
    ticks: u32
  ) -> void => {
    let plain = vdp.line_word((i32(self.x) * i32(speed)) >> 8)
    vdp.begin_lines(plane)
    var line: i16 = 0
    var k: i64 = 0
    while line < vdp.SCREEN_HEIGHT {
      let y = plane_y + line
      while k < N && bands[k].top + bands[k].height <= y { k += 1 }
      if k >= N || bands[k].top > y {
        // Lines no band holds, to the next band's top or the screen's foot.
        let until = if k < N {
          (bands[k].top - plane_y).min(vdp.SCREEN_HEIGHT)
        } else { vdp.SCREEN_HEIGHT }
        while line < until {
          vdp.write_line(plain)
          line += 1
        }
      } else {
        let until = (bands[k].top + bands[k].height - plane_y).min(vdp.SCREEN_HEIGHT)
        write_band(bands[k], i32(self.x), y - bands[k].top, until - line, ticks)
        line = until
        k += 1
      }
    }
    vdp.end_lines()
  }
}

// ── Beneath ──────────────────────────────────────────────────────────────────────────

/// The cells the screen shows at once, a part-cell at each edge included.
const VIEW_COLUMNS: u16 = 41
const VIEW_ROWS: u16 = 29

/// The columns a plane holds past each side of the view, for a ripple: [MAX_RIPPLE]'s cells.
/// The view's 41 and twice this fit the plane's 64.
const MARGIN: u16 = 8

/// The rows a plane holds above and below the view, so a row staged a frame ahead is there
/// before it shows: the view's 29 and twice this fit the plane's 32.
const ROW_MARGIN: u16 = 1

/// The rows held, and the columns: what a staged column and row are long.
const HELD_ROWS: u16 = 31
const HELD_COLUMNS: u16 = 57

/// A quarter turn of a sine, from 0 to its top (127), in 64 steps: [sine] makes the rest.
const QUARTER_SINE: [65]i8 = #[
  0,
  3,
  6,
  9,
  12,
  16,
  19,
  22,
  25,
  28,
  31,
  34,
  37,
  40,
  43,
  46,
  49,
  51,
  54,
  57,
  60,
  63,
  65,
  68,
  71,
  73,
  76,
  78,
  81,
  83,
  85,
  88,
  90,
  92,
  94,
  96,
  98,
  100,
  102,
  104,
  106,
  107,
  109,
  111,
  112,
  113,
  115,
  116,
  117,
  118,
  120,
  121,
  122,
  122,
  123,
  124,
  125,
  125,
  126,
  126,
  126,
  127,
  127,
  127,
  127,
]

/// `lines` of `band`'s words, from its line `from` — the view's x `x`, the frame `ticks`.
let write_band = (band: Band, x: i32, from: i16, lines: i16, ticks: u32) -> void => {
  // Where its top line is, in 256ths of a pixel: the camera's share, less the drift so far —
  // a band drifting right shows the map from further left.
  let drifted = i32(ticks).wrapping_mul(i32(band.drift))
  var at = x * i32(band.speed) - drifted
  // How much further each line down is, for a ramp.
  let step = if band.ramp_to != band.speed && band.height > 1 {
    (x * i32(band.ramp_to - band.speed)) / i32(band.height - 1)
  } else { 0 }
  at += step * i32(from)
  if band.wave == 0 {
    if step == 0 {
      let word = vdp.line_word(at >> 8)
      for _: i16 in 0..<lines { vdp.write_line(word) }
      return
    }
    for _: i16 in 0..<lines {
      vdp.write_line(vdp.line_word(at >> 8))
      at += step
    }
    return
  }
  var phase = u16(ticks).wrapping_mul(band.wave_speed).wrapping_add(
    u16(from).wrapping_mul(band.wave_step)
  )
  for _: i16 in 0..<lines {
    let ripple = (i32(sine(phase >> 8)) * i32(band.wave)) >> 7
    vdp.write_line(vdp.line_word((at >> 8) + ripple))
    at += step
    phase = phase.wrapping_add(band.wave_step)
  }
}

/// One axis of [follow]: the view's start `at` moved so `from`..`from + size` stays
/// between `low` and `high` on the screen, then kept inside `world`. Something bigger than
/// the zone is centred on it — pushed from one edge to the other, the view would shake.
/// `at` moved `by` towards `to`, never past it.
let toward = pure (at: i16, to: i16, by: i16) -> i16 =>
  if at < to { (at + by).min(to) } else { (at - by).max(to) }

let along = pure (
  at: i16,
  from: i16,
  size: i16,
  low: i16,
  high: i16,
  screen: i16,
  world: i16
) -> i16 => {
  var moved = at
  if size > high - low {
    moved = from + size / 2 - (low + high) / 2
  } else if from < at + low {
    moved = from - low
  } else if from + size > at + high {
    moved = from + size - high
  }
  moved.clamp(0, (world - screen).max(0))
}

/// The cell a (never negative) world position is in.
let cell_of = pure (x: i16) -> u16 => u16(x) >> 3

let distance = pure (a: u16, b: u16) -> u16 => if a > b { a - b } else { b - a }

/// Map column `mx` staged for the plane, the rows held from `top` (the margin above the view,
/// wrapping below 0 to a row past the map, blank) down: one run by the VDP's step down the plane, two where it wraps round the plane's foot.
/// `count` cells of map row `my` from column `mx` (each a column further, wrapping) written to
/// the VDP's data port, where its address is — blank past the map's edges. Walked along the
/// row, not asked a cell at a time ([blocks.cell_at]): a plain map's row is one run of the
/// table; of a block map, the row's block numbers are read one after another, and each block's
/// cells on the row copied as a run — each through a pointer, the table checked once a row and
/// once a block rather than once a cell. A wrap of the hero's field redrew both planes, 4,096
/// cells, a call each, and stood still for 25 frames (11/18).
let write_run<const N: i64> = (
  cells: ref [N]u16,
  width: u16,
  mx: u16,
  my: u16,
  count: u16
) -> void => {
  let columns = blocks.columns(width)
  var x = mx
  var left = count
  if my < blocks.rows(cells, width) {
    // Past the map's left (a column below 0 wraps high): blank, up to its first column.
    while left > 0 && x >= columns {
      vdp.write_word(0)
      x = x.wrapping_add(1)
      left -= 1
    }
    let first: ^u16 = unsafe { &cells[0] }
    if (width & blocks.BLOCKS) == 0 {
      let take = left.min(columns - x.min(columns))
      let at = u32(my) * u32(columns) + u32(x)
      if take > 0 && at + u32(take) <= u32(N) {
        unsafe {
          var p = first.offset(i64(at))
          for _: u16 in 0..<take {
            vdp.write_word(p^)
            p = p.offset(1)
          }
        }
        x += take
        left -= take
      }
    } else {
      let shift = cells[0]
      let side: u16 = u16(1) << shift
      let mask: u16 = side - 1
      let across = (columns + mask) >> shift
      let row_blocks = u32(cells[3]) + u32(my >> shift) * u32(cells[2])
      let inner = 4 + (u32(my & mask) << shift)
      if x < columns && row_blocks + u32(across) <= u32(N) {
        unsafe {
          var number = first.offset(i64(row_blocks + u32(x >> shift)))
          var within = x & mask
          while left > 0 && x < columns {
            let take = (side - within).min(left).min(columns - x)
            let at = inner + (u32(number^) << (2 * shift)) + u32(within)
            number = number.offset(1)
            if at + u32(take) > u32(N) { break }
            var p = first.offset(i64(at))
            for _: u16 in 0..<take {
              vdp.write_word(p^)
              p = p.offset(1)
            }
            x += take
            left -= take
            within = 0
          }
        }
      }
    }
  }
  // Past the map's right, its foot, or a table shorter than it says: blank.
  for _: u16 in 0..<left { vdp.write_word(0) }
}

let stage_column<const N: i64> = (
  plane: u16,
  cells: ref [N]u16,
  width: u16,
  mx: u16,
  top: u16
) -> void => {
  let column = mx % vdp.PLANE_WIDTH
  var my = top
  var left = HELD_ROWS
  while left > 0 {
    let row = my % vdp.PLANE_HEIGHT
    let run = left.min(vdp.PLANE_HEIGHT - row)
    let at = staged(
      plane + (row * vdp.PLANE_WIDTH + column) * 2,
      vdp.PLANE_WIDTH * 2,
      run
    )
    staged_down(cells, width, mx, my, run, at)
    my = my.wrapping_add(run)
    left -= run
  }
}

/// Map row `my` staged for the plane, the columns held from the margin before `left` to the
/// one past the view: one run, two where it wraps round the plane's edge.
let stage_row<const N: i64> = (
  plane: u16,
  cells: ref [N]u16,
  width: u16,
  my: u16,
  left: u16
) -> void => {
  let row_start = plane + (my % vdp.PLANE_HEIGHT) * vdp.PLANE_WIDTH * 2
  var mx = left.wrapping_sub(MARGIN)
  var remaining = HELD_COLUMNS
  while remaining > 0 {
    let column = mx % vdp.PLANE_WIDTH
    let run = remaining.min(vdp.PLANE_WIDTH - column)
    let at = staged(row_start + column * 2, 2, run)
    staged_across(cells, width, mx, my, run, at)
    mx = mx.wrapping_add(run)
    remaining -= run
  }
}

/// `count` cells of map row `my` from column `mx` (each a column further, wrapping) staged from
/// `at` — blank past the map's edges — walked along the row as [write_run] walks it, not asked
/// a cell at a time: a camera panning four pixels a frame staged a column every other frame
/// and a row with it, a `cell_at` call a cell, and the hero's tour fell to 20 frames a second
/// while it panned (11/19).
let staged_across<const N: i64> = (
  cells: ref [N]u16,
  width: u16,
  mx: u16,
  my: u16,
  count: u16,
  at: u16
) -> void => {
  var q = vdp.staged_from(at)
  let columns = blocks.columns(width)
  var x = mx
  var k: u16 = 0
  if my < blocks.rows(cells, width) {
    while k < count && x >= columns {
      unsafe {
        q^ = 0
        q = q.offset(1)
      }
      x = x.wrapping_add(1)
      k += 1
    }
    let first: ^u16 = unsafe { &cells[0] }
    if (width & blocks.BLOCKS) == 0 {
      let take = (count - k).min(columns - x.min(columns))
      let from = u32(my) * u32(columns) + u32(x)
      if take > 0 && from + u32(take) <= u32(N) {
        unsafe {
          var p = first.offset(i64(from))
          for _: u16 in 0..<take {
            q^ = p^
            q = q.offset(1)
            p = p.offset(1)
            k += 1
          }
        }
        x += take
      }
    } else {
      let shift = cells[0]
      let side: u16 = u16(1) << shift
      let mask: u16 = side - 1
      let across = (columns + mask) >> shift
      let row_blocks = u32(cells[3]) + u32(my >> shift) * u32(cells[2])
      let inner = 4 + (u32(my & mask) << shift)
      if x < columns && row_blocks + u32(across) <= u32(N) {
        unsafe {
          var number = first.offset(i64(row_blocks + u32(x >> shift)))
          var within = x & mask
          while k < count && x < columns {
            let take = (side - within).min(count - k).min(columns - x)
            let from = inner + (u32(number^) << (2 * shift)) + u32(within)
            number = number.offset(1)
            if from + u32(take) > u32(N) { break }
            var p = first.offset(i64(from))
            for _: u16 in 0..<take {
              q^ = p^
              q = q.offset(1)
              p = p.offset(1)
              k += 1
            }
            x += take
            within = 0
          }
        }
      }
    }
  }
  while k < count {
    unsafe {
      q^ = 0
      q = q.offset(1)
    }
    k += 1
  }
}

/// `count` cells of map column `mx` from row `my` (each a row further, wrapping) staged from
/// `at` — blank past the map's edges: a plain map's column a pointer stepping a row's width
/// down the table; a block map's, each block's number read once and its cells in the column
/// stepped down a block's side — not a `cell_at` call a cell ([staged_across] says why).
let staged_down<const N: i64> = (
  cells: ref [N]u16,
  width: u16,
  mx: u16,
  my: u16,
  count: u16,
  at: u16
) -> void => {
  var q = vdp.staged_from(at)
  let columns = blocks.columns(width)
  let rows = blocks.rows(cells, width)
  var y = my
  var k: u16 = 0
  if mx < columns {
    // Above the map's top (a row below 0 wraps high), or past its foot: blank, up to its first row.
    while k < count && y >= rows {
      unsafe {
        q^ = 0
        q = q.offset(1)
      }
      y = y.wrapping_add(1)
      k += 1
    }
    let first: ^u16 = unsafe { &cells[0] }
    if (width & blocks.BLOCKS) == 0 {
      let take = (count - k).min(rows - y.min(rows))
      let from = u32(y) * u32(columns) + u32(mx)
      if take > 0 && from + u32(take - 1) * u32(columns) < u32(N) {
        unsafe {
          var p = first.offset(i64(from))
          for _: u16 in 0..<take {
            q^ = p^
            q = q.offset(1)
            p = p.offset(i64(columns))
            k += 1
          }
        }
        y += take
      }
    } else {
      // The column's block numbers a table row apart, found once and stepped down: each
      // block's number read, and its cells in the column a block's side apart. The table is
      // checked once for the numbers and once a block for its cells.
      let shift = cells[0]
      let side: u16 = u16(1) << shift
      let mask: u16 = side - 1
      let across = u32(cells[2])
      let numbers = u32(cells[3])
      let held = (numbers - 4) >> (2 * shift)
      let first_number = numbers + u32(y >> shift) * across + u32(mx >> shift)
      let last_number = numbers + u32((rows - 1) >> shift) * across + u32(mx >> shift)
      if y < rows && last_number < u32(N) {
        let inner = 4 + u32(mx & mask)
        var within = y & mask
        unsafe {
          var number = first.offset(i64(first_number))
          while k < count && y < rows {
            let n = u32(number^)
            if n >= held { break }
            let take = (side - within).min(count - k).min(rows - y)
            var p = first.offset(i64(inner + (n << (2 * shift)) + (u32(within) << shift)))
            for _: u16 in 0..<take {
              q^ = p^
              q = q.offset(1)
              p = p.offset(i64(side))
            }
            k += take
            y += take
            within = 0
            number = number.offset(i64(across))
          }
        }
      }
    }
  }
  while k < count {
    unsafe {
      q^ = 0
      q = q.offset(1)
    }
    k += 1
  }
}

/// Map row `my` of a repeating map staged for the plane: all its 64 columns, map column `c`
/// mod `width` in column c.
let stage_whole_row<const N: i64> = (
  plane: u16,
  cells: ref [N]u16,
  width: u16,
  my: u16
) -> void => {
  let at = staged(
    plane + (my % vdp.PLANE_HEIGHT) * vdp.PLANE_WIDTH * 2,
    2,
    vdp.PLANE_WIDTH
  )
  let w = blocks.columns(width)
  for c: u16 in 0..<vdp.PLANE_WIDTH {
    vdp.put_staged(at + c, blocks.cell_at(cells, width, c % w, my))
  }
}

/// Room for `words` staged words to `address`, `step` bytes apart: sending what is staged
/// already when it is full, which has the room again.
let staged = (address: u16, step: u16, words: u16) -> u16 => {
  let at = vdp.stage(address, step, words)
  if at != vdp.NO_ROOM { return at }
  vdp.send_staged()
  vdp.stage(address, step, words)
}

/// Map row `my` of a repeating map into the plane: all its 64 columns, map column `c` mod
/// `width` in column c.
let write_whole_row<const N: i64> = (
  plane: u16,
  cells: ref [N]u16,
  width: u16,
  my: u16
) -> void => {
  vdp.set_vram_address(plane + (my % vdp.PLANE_HEIGHT) * vdp.PLANE_WIDTH * 2)
  let w = blocks.columns(width)
  for c: u16 in 0..<vdp.PLANE_WIDTH {
    vdp.write_word(blocks.cell_at(cells, width, c % w, my))
  }
}

/// The sine of `step` 256ths of a turn, at most 127 either way: a quarter turn's table
/// mirrored and turned over.
let sine = pure (step: u16) -> i8 => {
  let k = i64(step & 63)
  let quarter = step >> 6
  let rising = if quarter == 0 || quarter == 2 { QUARTER_SINE[k] } else { QUARTER_SINE[64 - k] }
  if quarter < 2 { rising } else { -rising }
}
