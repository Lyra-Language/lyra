module std.genesis.camera
//! A camera on a world bigger than the screen: where the view is, moved to follow the
//! player, and a tile map kept in a plane as it scrolls.
//!
//! ```
//! import std.genesis.camera
//! import std.genesis.camera.{ Camera }
//!
//! var view = Camera { world_width: 640, world_height: 512 }
//! view.show_map(vdp.PLANE_B, LEVEL, LEVEL_WIDTH)   // once, before display_on
//! loop {
//!   // … move the player, in the world's pixels
//!   view.follow(x, y, PLAYER_WIDTH, PLAYER_HEIGHT)
//!   let (sx, sy) = view.on_screen(x, y)   // … and draw its sprites there
//!   vdp.wait_vblank()
//!   view.scroll_map(vdp.PLANE_B, LEVEL, LEVEL_WIDTH)
//! }
//! ```
//!
//! **The camera moves only when it must**: what it follows is free inside the camera's
//! [Zone], a rectangle of the screen, and the view moves when it crosses the zone's edge —
//! just enough to keep it there — and never past the world's edges, where the player may
//! walk on to the world's end. The zone is the game's to choose, and to change as it
//! goes: the middle third each way unless it says otherwise ([THIRDS]), a box of any size
//! in the middle ([centred_zone]; `centred_zone(0, 0)` keeps the player centred), or any
//! rectangle — a platformer's, say, low on the screen and wide:
//!
//! ```
//! view.zone = Zone { left: 120, top: 120, right: 200, bottom: 190 }
//! ```
//!
//! **A map larger than a plane scrolls without redrawing it.** The VDP's plane (64×32
//! cells) wraps, and map cell (x, y) is kept at the plane's cell (x mod 64, y mod 32): the
//! scroll registers then show the view wherever it is, and [scroll_map] writes only the
//! columns and rows that came into view since the last [follow] — a column and a row a
//! frame at most at walking speed, done in the vertical blank. A map's cells are its
//! name-table words, row by row (`vdp.write_plane`'s, and Vega's `assets` tables). The
//! plane holds eight columns either side of the view as well, so a ripple ([Band]) moving
//! a line by up to [MAX_RIPPLE] pixels shows the map, not what a column held before.
//!
//! **A plane's lines may scroll apart** — the VDP's line scroll: [Band]s, strips of its map
//! each at a speed of its own, drifting, ramping from one speed to another down the strip
//! (a floor in perspective) or rippling, written each frame by [scroll_bands]. Bands moving
//! apart from the plane show other columns than its own scroll does, so they need a map that
//! repeats across the plane — 8, 16, 32 or 64 cells wide — shown by [show_repeating] and
//! kept by [scroll_repeating]; a ripple alone needs nothing.

import std.genesis.vdp

/// The part of the screen what a camera follows may move in without the view moving, in
/// screen pixels: `left` ≤ x and x + its width ≤ `right`, and the same down.
pub struct Zone {
  left: i16,
  top: i16,
  right: i16,
  bottom: i16,
}

/// The middle third of the screen each way — a camera's zone unless the game sets another.
pub const THIRDS: Zone = Zone { left: 106, top: 74, right: 214, bottom: 150 }

/// A zone `width` × `height` in the middle of the screen. One smaller than what the camera
/// follows keeps that centred: `centred_zone(0, 0)` pans with every step.
pub let centred_zone = pure (width: i16, height: i16) -> Zone => Zone {
  left: (vdp.SCREEN_WIDTH - width) / 2,
  top: (vdp.SCREEN_HEIGHT - height) / 2,
  right: (vdp.SCREEN_WIDTH + width) / 2,
  bottom: (vdp.SCREEN_HEIGHT + height) / 2,
}

/// A strip of a plane's map scrolling apart from the rest — `height` lines from line `top`
/// of the map, in its pixels — for [scroll_bands]. Its speeds are 256ths of the camera's
/// (256 with it, 0 fixed), as `parallaxed`'s: `speed` at its top line, `ramp_to` at its
/// last, the lines between stepped evenly (the same for none). `drift` moves it on its own,
/// in 256ths of a pixel a frame to the right (below 0, the left) — clouds. A ripple moves each line by up to `wave` pixels
/// (at most [MAX_RIPPLE] on a map that does not repeat), a sine whose phase moves on
/// `wave_step` a line and `wave_speed` a frame, both in 65536ths of a turn.
pub struct Band {
  top: i16,
  height: i16,
  speed: i16 = 256,
  ramp_to: i16 = 256,
  drift: i16 = 0,
  wave: i16 = 0,
  wave_step: u16 = 0,
  wave_speed: u16 = 0,
}

/// How far a ripple may move a line of a map that does not repeat: the columns the plane
/// holds past each side of the view.
pub const MAX_RIPPLE: i16 = 64

/// Where the view is in a world, and where it was.
pub struct Camera {
  /// The view's top-left in the world, in pixels.
  x: i16 = 0,
  y: i16 = 0,
  /// The world's size in pixels: the view never leaves it.
  world_width: i16,
  world_height: i16,
  /// Where on the screen what it follows may move without the view moving.
  zone: Zone = THIRDS,
  /// Where the view was before the last [follow]: [scroll_map] writes what came into view
  /// since.
  last_x: i16 = 0,
  last_y: i16 = 0,
}

impl Camera {

  /// Move the view to keep the rectangle `x`, `y`, `width` × `height` (in the world's
  /// pixels) inside the camera's zone on the screen: it moves only when the rectangle crosses
  /// the zone's edge, and then just enough — never past the world's edges. Call once a
  /// frame, after moving what it follows.
  pub let follow = (self: mut, x: i16, y: i16, width: i16, height: i16) -> void => {
    self.last_x = self.x
    self.last_y = self.y
    let z = self.zone
    self.x = along(self.x, x, width, z.left, z.right, vdp.SCREEN_WIDTH, self.world_width)
    self.y = along(
      self.y,
      y,
      height,
      z.top,
      z.bottom,
      vdp.SCREEN_HEIGHT,
      self.world_height
    )
  }

  /// Where world position (`x`, `y`) is on the screen, for a sprite.
  pub let on_screen = pure (self, x: i16, y: i16) -> (i16, i16) =>
    (x - self.x, y - self.y)

  /// A map into `plane` around the view, and the plane scrolled to it: every cell the plane
  /// holds. Once, before `vdp.display_on()` — and after a jump too far for [scroll_map].
  /// `cells` is the map row by row, `width` cells a row.
  pub let show_map<const N: i64> = (
    self,
    plane: u16,
    cells: ref [N]u16,
    width: u16
  ) -> void => {
    // From the margin's first column, before the view's left: wrapping below 0 is a column
    // past the map's edge, blank, at the plane column it would have.
    let left = cell_of(self.x).wrapping_sub(MARGIN)
    let top = cell_of(self.y)
    let shift = left % vdp.PLANE_WIDTH
    // Its rows are runs of writes the vertical blank interrupt must not land in.
    let held = vdp.hold_vblank()
    for row: u16 in 0..<vdp.PLANE_HEIGHT {
      let my = top + row
      vdp.set_vram_address(plane + (my % vdp.PLANE_HEIGHT) * vdp.PLANE_WIDTH * 2)
      for column: u16 in 0..<vdp.PLANE_WIDTH {
        // The map column this plane column holds while the view's left is at `left`.
        let mx = left.wrapping_add((column + vdp.PLANE_WIDTH - shift) % vdp.PLANE_WIDTH)
        vdp.write_word(cell(cells, width, mx, my))
      }
    }
    vdp.release_vblank(held)
    vdp.set_scroll(plane, self.x, self.y)
  }

  /// The view as a plane scrolling at `fx`/256, `fy`/256 of its speed sees the world (256
  /// with it, 0 fixed to the screen): for a parallax plane, whose columns come into view at
  /// its own pace, so `last_x` and `last_y` are scaled as well.
  pub let parallaxed = pure (self, fx: i16, fy: i16) -> Camera => Camera {
    self |
    x: i16((i32(self.x) * i32(fx)) >> 8),
    y: i16((i32(self.y) * i32(fy)) >> 8),
    last_x: i16((i32(self.last_x) * i32(fx)) >> 8),
    last_y: i16((i32(self.last_y) * i32(fy)) >> 8),
  }

  /// Keep a map in `plane` as the view moves: the columns and rows that came into view since
  /// the last [follow] written, and the plane scrolled to the view. Once a frame, in the
  /// vertical blank, with the map [show_map] wrote.
  pub let scroll_map<const N: i64> = (
    self,
    plane: u16,
    cells: ref [N]u16,
    width: u16
  ) -> void => {
    let old_left = cell_of(self.last_x)
    let old_top = cell_of(self.last_y)
    let left = cell_of(self.x)
    let top = cell_of(self.y)
    // A jump a view wide or more: nothing in the plane is kept, so draw it all.
    if distance(old_left, left) >= VIEW_COLUMNS || distance(old_top, top) >= VIEW_ROWS {
      self.show_map(plane, cells, width)
      return
    }
    let held = vdp.hold_vblank()
    // The columns held run from MARGIN before the view's left to MARGIN past its right.
    if left > old_left {
      for k: u16 in 0..<left - old_left {
        write_column(plane, cells, width, old_left + VIEW_COLUMNS + MARGIN + k, top)
      }
    } else if left < old_left {
      for k: u16 in 0..<old_left - left {
        write_column(plane, cells, width, left.wrapping_sub(MARGIN).wrapping_add(k), top)
      }
    }
    if top > old_top {
      for my: u16 in old_top + VIEW_ROWS..<top + VIEW_ROWS {
        write_row(plane, cells, width, my, left)
      }
    } else if top < old_top {
      for my: u16 in top..<old_top { write_row(plane, cells, width, my, left) }
    }
    vdp.release_vblank(held)
    vdp.set_scroll(plane, self.x, self.y)
  }

  /// A map repeating across `plane` — `width` cells wide, 8, 16, 32 or 64, so the plane's 64
  /// columns hold it whole each time — and the plane scrolled to the view: what bands moving
  /// apart from it need ([Band]). Its rows as [show_map] writes them. Once, before
  /// `vdp.display_on()`.
  pub let show_repeating<const N: i64> = (
    self,
    plane: u16,
    cells: ref [N]u16,
    width: u16
  ) -> void => {
    let top = cell_of(self.y)
    let held = vdp.hold_vblank()
    for row: u16 in 0..<vdp.PLANE_HEIGHT {
      write_whole_row(plane, cells, width, top + row)
    }
    vdp.release_vblank(held)
    vdp.set_scroll(plane, self.x, self.y)
  }

  /// Keep a repeating map ([show_repeating]) in `plane` as the view moves: the rows that came
  /// into view, every column of each, and the plane scrolled to the view. Once a frame, in the
  /// vertical blank.
  pub let scroll_repeating<const N: i64> = (
    self,
    plane: u16,
    cells: ref [N]u16,
    width: u16
  ) -> void => {
    let old_top = cell_of(self.last_y)
    let top = cell_of(self.y)
    let held = vdp.hold_vblank()
    if distance(old_top, top) >= VIEW_ROWS {
      for row: u16 in 0..<vdp.PLANE_HEIGHT {
        write_whole_row(plane, cells, width, top + row)
      }
    } else if top > old_top {
      for my: u16 in old_top + VIEW_ROWS..<top + VIEW_ROWS {
        write_whole_row(plane, cells, width, my)
      }
    } else if top < old_top {
      for my: u16 in top..<old_top { write_whole_row(plane, cells, width, my) }
    }
    vdp.release_vblank(held)
    vdp.set_scroll(plane, self.x, self.y)
  }

  /// Each of `plane`'s lines scrolled as `bands` say, the view's x the camera's (this one,
  /// not a plane's `parallaxed` view): a line no band holds at `speed` 256ths of it, as the
  /// plane's own scroll. `plane_y` is where the plane is scrolled down to (its view's y), so
  /// line l shows the map's line `plane_y + l`; `bands` are in order down the map, apart;
  /// `ticks` counts frames, for drift and ripples. Once a frame, in the vertical blank,
  /// after the plane's [scroll_map] or [scroll_repeating], with `vdp.use_bands` saying the
  /// plane's lines are the game's.
  pub let scroll_bands<const N: i64> = (
    self,
    plane: u16,
    plane_y: i16,
    speed: i16,
    bands: ref [N]Band,
    ticks: u32
  ) -> void => {
    let plain = vdp.line_word((i32(self.x) * i32(speed)) >> 8)
    let held = vdp.hold_vblank()
    vdp.begin_lines(plane)
    var line: i16 = 0
    var k: i64 = 0
    while line < vdp.SCREEN_HEIGHT {
      let y = plane_y + line
      while k < N && bands[k].top + bands[k].height <= y { k += 1 }
      if k >= N || bands[k].top > y {
        // Lines no band holds, to the next band's top or the screen's foot.
        let until = if k < N {
          (bands[k].top - plane_y).min(vdp.SCREEN_HEIGHT)
        } else { vdp.SCREEN_HEIGHT }
        while line < until {
          vdp.write_word(plain)
          line += 1
        }
      } else {
        let until = (bands[k].top + bands[k].height - plane_y).min(vdp.SCREEN_HEIGHT)
        write_band(bands[k], i32(self.x), y - bands[k].top, until - line, ticks)
        line = until
        k += 1
      }
    }
    vdp.end_lines()
    vdp.release_vblank(held)
  }
}

// ── Beneath ──────────────────────────────────────────────────────────────────────────

/// The cells the screen shows at once, a part-cell at each edge included.
const VIEW_COLUMNS: u16 = 41
const VIEW_ROWS: u16 = 29

/// The columns a plane holds past each side of the view, for a ripple: [MAX_RIPPLE]'s cells.
/// The view's 41 and twice this fit the plane's 64.
const MARGIN: u16 = 8

/// A quarter turn of a sine, from 0 to its top (127), in 64 steps: [sine] makes the rest.
const QUARTER_SINE: [65]i8 = #[
  0,
  3,
  6,
  9,
  12,
  16,
  19,
  22,
  25,
  28,
  31,
  34,
  37,
  40,
  43,
  46,
  49,
  51,
  54,
  57,
  60,
  63,
  65,
  68,
  71,
  73,
  76,
  78,
  81,
  83,
  85,
  88,
  90,
  92,
  94,
  96,
  98,
  100,
  102,
  104,
  106,
  107,
  109,
  111,
  112,
  113,
  115,
  116,
  117,
  118,
  120,
  121,
  122,
  122,
  123,
  124,
  125,
  125,
  126,
  126,
  126,
  127,
  127,
  127,
  127,
]

/// `lines` of `band`'s words, from its line `from` — the view's x `x`, the frame `ticks`.
let write_band = (band: Band, x: i32, from: i16, lines: i16, ticks: u32) -> void => {
  // Where its top line is, in 256ths of a pixel: the camera's share, less the drift so far —
  // a band drifting right shows the map from further left.
  let drifted = i32(ticks).wrapping_mul(i32(band.drift))
  var at = x * i32(band.speed) - drifted
  // How much further each line down is, for a ramp.
  let step = if band.ramp_to != band.speed && band.height > 1 {
    (x * i32(band.ramp_to - band.speed)) / i32(band.height - 1)
  } else { 0 }
  at += step * i32(from)
  if band.wave == 0 {
    if step == 0 {
      let word = vdp.line_word(at >> 8)
      for _: i16 in 0..<lines { vdp.write_word(word) }
      return
    }
    for _: i16 in 0..<lines {
      vdp.write_word(vdp.line_word(at >> 8))
      at += step
    }
    return
  }
  var phase = u16(ticks).wrapping_mul(band.wave_speed).wrapping_add(
    u16(from).wrapping_mul(band.wave_step)
  )
  for _: i16 in 0..<lines {
    let ripple = (i32(sine(phase >> 8)) * i32(band.wave)) >> 7
    vdp.write_word(vdp.line_word((at >> 8) + ripple))
    at += step
    phase = phase.wrapping_add(band.wave_step)
  }
}

/// One axis of [follow]: the view's start `at` moved so `from`..`from + size` stays
/// between `low` and `high` on the screen, then kept inside `world`. Something bigger than
/// the zone is centred on it — pushed from one edge to the other, the view would shake.
let along = pure (
  at: i16,
  from: i16,
  size: i16,
  low: i16,
  high: i16,
  screen: i16,
  world: i16
) -> i16 => {
  var moved = at
  if size > high - low {
    moved = from + size / 2 - (low + high) / 2
  } else if from < at + low {
    moved = from - low
  } else if from + size > at + high {
    moved = from + size - high
  }
  moved.clamp(0, (world - screen).max(0))
}

/// The cell a (never negative) world position is in.
let cell_of = pure (x: i16) -> u16 => u16(x) >> 3

let distance = pure (a: u16, b: u16) -> u16 => if a > b { a - b } else { b - a }

/// Map cell (`mx`, `my`); 0, the blank tile, past the map's edge.
let cell<const N: i64> = pure (
  cells: ref [N]u16,
  width: u16,
  mx: u16,
  my: u16
) -> u16 => {
  if mx >= width { return 0 }
  let at = u32(my) * u32(width) + u32(mx)
  if at < u32(cells.len()) { cells[at] } else { 0 }
}

/// Map column `mx` into the plane, the view's rows from `top`.
let write_column<const N: i64> = (
  plane: u16,
  cells: ref [N]u16,
  width: u16,
  mx: u16,
  top: u16
) -> void => {
  let column = mx % vdp.PLANE_WIDTH
  for row: u16 in 0..<VIEW_ROWS {
    let my = top + row
    vdp.set_vram_address(plane + ((my % vdp.PLANE_HEIGHT) * vdp.PLANE_WIDTH + column) * 2)
    vdp.write_word(cell(cells, width, mx, my))
  }
}

/// Map row `my` of a repeating map into the plane: all its 64 columns, map column `c` mod
/// `width` in column c.
let write_whole_row<const N: i64> = (
  plane: u16,
  cells: ref [N]u16,
  width: u16,
  my: u16
) -> void => {
  vdp.set_vram_address(plane + (my % vdp.PLANE_HEIGHT) * vdp.PLANE_WIDTH * 2)
  for c: u16 in 0..<vdp.PLANE_WIDTH { vdp.write_word(cell(cells, width, c % width, my)) }
}

/// Map row `my` into the plane, the columns held from the margin before `left` to the one
/// past the view — an address set where the row wraps round the plane's edge.
let write_row<const N: i64> = (
  plane: u16,
  cells: ref [N]u16,
  width: u16,
  my: u16,
  left: u16
) -> void => {
  let row_start = plane + (my % vdp.PLANE_HEIGHT) * vdp.PLANE_WIDTH * 2
  let first = left.wrapping_sub(MARGIN)
  for c: u16 in 0..<VIEW_COLUMNS + 2 * MARGIN {
    let mx = first.wrapping_add(c)
    if c == 0 || mx % vdp.PLANE_WIDTH == 0 {
      vdp.set_vram_address(row_start + (mx % vdp.PLANE_WIDTH) * 2)
    }
    vdp.write_word(cell(cells, width, mx, my))
  }
}

/// The sine of `step` 256ths of a turn, at most 127 either way: a quarter turn's table
/// mirrored and turned over.
let sine = pure (step: u16) -> i8 => {
  let k = i64(step & 63)
  let quarter = step >> 6
  let rising = if quarter == 0 || quarter == 2 { QUARTER_SINE[k] } else { QUARTER_SINE[64 - k] }
  if quarter < 2 { rising } else { -rising }
}
