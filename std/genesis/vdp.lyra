module std.genesis.vdp
//! The Genesis's video chip, the VDP: its registers, its memories — VRAM for tiles and
//! tables, CRAM for the 64 colours, VSRAM for vertical scroll — and the vertical blank a
//! game draws in.
//!
//! ```
//! import std.genesis.vdp
//!
//! let main = () -> void => {
//!   vdp.init()
//!   vdp.set_color(0, 0, vdp.rgb(0, 0, 7))   // palette 0, colour 0: blue
//!   vdp.display_on()
//!   loop {
//!     vdp.wait_vblank()
//!     // … move things, then show them
//!   }
//! }
//! ```
//!
//! **Everything goes through the VDP's two ports.** A register is set with one word to
//! the control port (`8rvv`); a memory is written by giving the control port an address
//! (two words that also say which memory), then writing words to the data port, which
//! moves along by two bytes after each. The writes are volatile (`write_volatile`): two
//! writes in a row to one port are two commands, and the optimizer must not merge them.
//!
//! **The layout** is the one SGDK uses, set by [init]: 40-cell mode (320×224), 64×32-cell
//! planes, and the tables at the top of VRAM — tiles fill everything below `WINDOW` (1408
//! of them). Tile 0 is blank and is what an empty plane shows.
//!
//! Data comes from `const` tables, which live in ROM and are passed by reference — `ref`
//! — so loading one copies nothing onto the stack: `vdp.load_tiles(1, HERO)`. A table of
//! any length is accepted (`<const N: i64>`), each length compiled on its own.

/// The screen in 40-cell mode, which [init] sets, in pixels.
pub const SCREEN_WIDTH: i16 = 320
pub const SCREEN_HEIGHT: i16 = 224

/// Where [init] puts the VDP's tables in VRAM. Tiles go below `WINDOW`.
pub const WINDOW: u16 = 0xB000
pub const PLANE_A: u16 = 0xC000
pub const PLANE_B: u16 = 0xE000
pub const SPRITE_TABLE: u16 = 0xF000
pub const HSCROLL: u16 = 0xFC00

/// Show the window plane over the top `rows` cell rows of the screen, in place of plane A —
/// a strip that does not scroll, where a game keeps its score while plane A scrolls with
/// the camera; 0 for none. Its cells are written like a plane's, at [WINDOW]
/// (`write_cell(vdp.WINDOW, x, y, word)`), a row [PLANE_WIDTH] cells wide in 40-cell mode.
pub let window_rows = (rows: u8) -> void => set_register(18, rows & 0x1F)

/// A plane, as [init] sizes them, in cells.
pub const PLANE_WIDTH: u16 = 64
pub const PLANE_HEIGHT: u16 = 32

/// The VDP set up for a game: mode 5, 40 cells, the tables above, the display off, and
/// every memory cleared — VRAM (so every tile and table starts empty), CRAM (every colour
/// black) and VSRAM (no vertical scroll). Call once, first.
pub let init = () -> void => {
  for r: u8 in 0..<19 { set_register(r, INIT_REGISTERS[r]) }
  set_address(VRAM_WRITE, 0)
  for _: u16 in 0..<32768 { write_word(0) }
  set_address(CRAM_WRITE, 0)
  for _: u16 in 0..<64 { write_word(0) }
  set_address(VSRAM_WRITE, 0)
  for _: u16 in 0..<40 { write_word(0) }
  mode = INIT_REGISTERS[1]
}

/// Show the planes and sprites (off after [init], so a game can load before anything is
/// seen).
pub let display_on = () -> void => {
  mode = mode | 0x40
  set_register(1, mode)
}

/// Blank the screen to the backdrop colour.
pub let display_off = () -> void => {
  mode = mode & 0xBF
  set_register(1, mode)
}

/// Have the VDP interrupt at the start of every vertical blank, running the program's
/// `@interrupt(vblank)` function — the place for work that must happen once a frame
/// whatever the main loop is doing (a music driver's tick, a frame counter):
///
/// ```
/// @interrupt(vblank)
/// let each_frame = () -> void => { frames += 1 }
/// ```
///
/// A module-level `var` the handler writes is shared safely with the main loop: the
/// compiler makes every access to it volatile, so a loop waiting on it sees each change.
/// One written only in a function the handler calls is not seen that way — read it with
/// `read_volatile`, or write it in the handler itself.
pub let enable_vblank_interrupt = () -> void => {
  mode = mode | 0x20
  set_register(1, mode)
}

/// Stop the vertical blank interrupt.
pub let disable_vblank_interrupt = () -> void => {
  mode = mode & 0xDF
  set_register(1, mode)
}

/// Have the VDP interrupt every `lines` lines of the picture (and again at its top),
/// running the program's `@interrupt(hblank)` function — for effects that change the
/// picture partway down it (a colour, a scroll).
pub let enable_hblank_interrupt = (lines: u8) -> void => {
  set_register(10, lines)
  set_register(0, 0x14)
}

/// Stop the horizontal interrupt.
pub let disable_hblank_interrupt = () -> void => set_register(0, 0x04)

/// Wait for the next vertical blank to begin — the time between frames when a game
/// changes what is shown, once a frame (60 times a second on an NTSC console).
pub let wait_vblank = () -> void => {
  // Out of any blank still under way, then into the next: status bit 3 is set during it.
  while (status() & 8) != 0 {}
  while (status() & 8) == 0 {}
}

/// A colour as CRAM holds it, from three levels of 0–7.
pub let rgb = pure (r: u16, g: u16, b: u16) -> u16 =>
  ((b & 7) << 9) | ((g & 7) << 5) | ((r & 7) << 1)

/// Colour `index` (0–15) of palette `palette` (0–3). Colour 0 of each palette is
/// transparent in a sprite or a plane's tile.
pub let set_color = (palette: u16, index: u16, color: u16) -> void => {
  let held = hold_vblank()
  set_address(CRAM_WRITE, ((palette & 3) * 16 + (index & 15)) * 2)
  write_word(color)
  release_vblank(held)
}

/// All sixteen colours of palette `palette` from a table.
pub let load_palette = (palette: u16, colors: ref [16]u16) -> void => {
  let held = hold_vblank()
  set_address(CRAM_WRITE, (palette & 3) * 32)
  for c in colors { write_word(c) }
  release_vblank(held)
}

/// The colour behind everything: colour `index` of palette `palette`.
pub let set_backdrop = (palette: u16, index: u16) -> void =>
  set_register(7, u8(((palette & 3) << 4) | (index & 15)))

/// Tiles into VRAM from tile `first` on, from a table of their rows — eight `u32` words a
/// tile, two pixels a byte, the left one in the high nibble (what Vega exports).
pub let load_tiles<const N: i64> = (first: u16, tiles: ref [N]u32) -> void => {
  let held = hold_vblank()
  set_address(VRAM_WRITE, first * 32)
  for row in tiles { write_long(row) }
  release_vblank(held)
}

/// A table of words into VRAM at byte `address`.
pub let write_vram<const N: i64> = (address: u16, words: ref [N]u16) -> void => {
  let held = hold_vblank()
  set_address(VRAM_WRITE, address)
  for w in words { write_word(w) }
  release_vblank(held)
}

/// A tile map into a plane (`PLANE_A` or `PLANE_B`): every one of the plane's cells, from
/// the map's cell (`left`, `top`) on. `cells` is the map row by row, `width` cells a row,
/// as name-table words — `priority << 15 | palette << 13 | flip_y << 12 | flip_x << 11 |
/// tile` — and a plane cell past the map's edge gets 0, the blank tile. A whole plane is
/// 2,048 words: write it before `display_on`, or between levels, rather than every frame.
pub let write_plane<const N: i64> = (
  plane: u16,
  cells: ref [N]u16,
  width: u16,
  left: u16 = 0,
  top: u16 = 0
) -> void => {
  let held = hold_vblank()
  let cell_count = u32(cells.len())
  // Where the map's row `top + row` starts, kept by adding a row's width each time.
  var start = u32(top) * u32(width)
  for row: u16 in 0..<PLANE_HEIGHT {
    set_address(VRAM_WRITE, plane + row * PLANE_WIDTH * 2)
    for column: u16 in 0..<PLANE_WIDTH {
      let x = left + column
      let at = start + u32(x)
      if x < width && at < cell_count { write_word(cells[at]) } else { write_word(0) }
    }
    start += u32(width)
  }
  release_vblank(held)
}

/// One cell of a plane (`PLANE_A` or `PLANE_B`) set to a name-table word — a score's digit,
/// a door opened in a level — `priority << 15 | palette << 13 | flip_y << 12 |
/// flip_x << 11 | tile`. `x` and `y` are the plane's cells, wrapping at its edges.
pub let write_cell = (plane: u16, x: u16, y: u16, word: u16) -> void => {
  let held = hold_vblank()
  set_address(
    VRAM_WRITE,
    plane + ((y % PLANE_HEIGHT) * PLANE_WIDTH + x % PLANE_WIDTH) * 2
  )
  write_word(word)
  release_vblank(held)
}

/// Scroll `plane` (`PLANE_A` or `PLANE_B`) so its pixel (`x`, `y`) is at the screen's
/// top-left — the whole screen at once, as [init] sets the VDP up. A plane wraps at its
/// edges, so any position will do.
pub let set_scroll = (plane: u16, x: i16, y: i16) -> void => {
  let which: u16 = if plane == PLANE_A { 0 } else { 2 }
  let held = hold_vblank()
  // Horizontal scroll moves the plane right, so the view at x is a scroll of -x.
  set_address(VRAM_WRITE, HSCROLL + which)
  write_word(u16((1024 - (i32(x) & 1023)) & 1023))
  set_address(VSRAM_WRITE, which)
  write_word(u16(i32(y) & 1023))
  release_vblank(held)
}

/// The vertical blank interrupt held off, answering whether it was on — around a run of
/// writes from the game's loop: an address, then its data. The interrupt's own writes (the
/// sprite list) move the VDP's address, and a run they land in goes on at theirs: a map
/// drawn with the interrupt on lost the rest of a row, black on the screen (10/06). One
/// that falls due while held is taken as soon as it is let go ([release_vblank]). Every
/// writer here holds it; a game holds it around its own [set_vram_address] and
/// [write_word]s.
pub let hold_vblank = () -> bool => {
  let on = (mode & 0x20) != 0
  if on { disable_vblank_interrupt() }
  on
}

/// The vertical blank interrupt let go after [hold_vblank]: on again if it was on.
pub let release_vblank = (held: bool) -> void => {
  if held { enable_vblank_interrupt() }
}

/// Point the data port at byte `address` of VRAM, for [write_word]s to follow — how the
/// sprite table and the planes are written. From the game's loop, hold the vertical blank
/// interrupt around it and the writes ([hold_vblank]).
pub let set_vram_address = (address: u16) -> void => set_address(VRAM_WRITE, address)

/// A word to the data port: to where the last address was set, which then moves on two
/// bytes.
pub let write_word = (word: u16) -> void => unsafe { data_port().write_volatile(word) }

/// Register `r` (0–23) set to `value` — for what the functions above do not cover.
pub let set_register = (r: u8, value: u8) -> void =>
  unsafe { control_port().write_volatile(0x8000 | (u16(r & 31) << 8) | u16(value)) }

// ── Beneath ──────────────────────────────────────────────────────────────────────────

/// Registers 0–18 as `init` sets them: mode 5 with no interrupts; register 1 display
/// off; the tables' addresses; the backdrop palette 0 colour 0; 40 cells; auto-increment
/// 2; 64×32 planes; no window.
const INIT_REGISTERS: [19]u8 = #[
  0x04, 0x04, 0x30, 0x2C, 0x07, 0x78, 0x00, 0x00, 0x00, 0x00,
  0xFF, 0x00, 0x81, 0x3F, 0x00, 0x02, 0x01, 0x00, 0x00,
]

/// Register 1 as last set, so turning the display on or off keeps the rest.
var mode: u8 = 0x04

/// The first word of an address command for each memory; the second carries the
/// address's top two bits and the rest of the code.
const VRAM_WRITE: u16 = 0x4000
const CRAM_WRITE: u16 = 0xC000
const VSRAM_WRITE: u16 = 0x4010

/// Point the data port at `address` in the memory `code` names (VSRAM's code has a bit
/// in the second word, which is why it is 4010).
let set_address = (code: u16, address: u16) -> void => {
  let port = control_port()
  unsafe {
    port.write_volatile((code & 0xC000) | (address & 0x3FFF))
    port.write_volatile((code & 0x00F0) | (address >> 14))
  }
}

/// A long to the data port: two words, high first, as the 68000 writes it.
let write_long = (long: u32) -> void => unsafe { data_long_port().write_volatile(long) }

/// The status word: bit 3 is set during a vertical blank.
let status = () -> u16 => unsafe { control_port().read_volatile() }

let control_port = pure () -> ^mut u16 => unsafe { pointer_at(0xC00004) }

let data_port = pure () -> ^mut u16 => unsafe { pointer_at(0xC00000) }

let data_long_port = pure () -> ^mut u32 => unsafe { pointer_at(0xC00000) }
