module std.genesis.vdp
//! The Genesis's video chip, the VDP: its registers, its memories — VRAM for tiles and
//! tables, CRAM for the 64 colours, VSRAM for vertical scroll — and the vertical blank a
//! game draws in.
//!
//! ```
//! import std.genesis.vdp
//!
//! let main = () -> void => {
//!   vdp.init()
//!   vdp.set_color(0, 0, vdp.rgb(0, 0, 7))   // palette 0, colour 0: blue
//!   vdp.display_on()
//!   loop {
//!     vdp.wait_vblank()
//!     // … move things, then show them
//!   }
//! }
//! ```
//!
//! **Everything goes through the VDP's two ports.** A register is set with one word to
//! the control port (`8rvv`); a memory is written by giving the control port an address
//! (two words that also say which memory), then writing words to the data port, which
//! moves along by two bytes after each. The writes are volatile (`write_volatile`): two
//! writes in a row to one port are two commands, and the optimizer must not merge them.
//!
//! **The layout** is the one SGDK uses, set by [init]: 40-cell mode (320×224), 64×32-cell
//! planes, and the tables at the top of VRAM — tiles fill everything below `WINDOW` (1408
//! of them). Tile 0 is blank and is what an empty plane shows.
//!
//! Data comes from `const` tables, which live in ROM and are passed by reference — `ref`
//! — so loading one copies nothing onto the stack: `vdp.load_tiles(1, HERO)`. A table of
//! any length is accepted (`<const N: i64>`), each length compiled on its own.

import std.genesis.blocks

/// The screen in 40-cell mode, which [init] sets, in pixels.
pub const SCREEN_WIDTH: i16 = 320
pub const SCREEN_HEIGHT: i16 = 224

/// Frames a second on an NTSC console — the game's updates, a frame each, its speeds pixels
/// a frame, as `std.game.screen`'s are an update. A time in milliseconds is
/// `ms * UPDATES_PER_SECOND / 1000` frames. (A PAL console's 50 is not built.)
pub const UPDATES_PER_SECOND: i16 = 60

/// Where [init] puts the VDP's tables in VRAM. Tiles go below `WINDOW`.
pub const WINDOW: u16 = 0xB000
pub const PLANE_A: u16 = 0xC000
pub const PLANE_B: u16 = 0xE000
pub const SPRITE_TABLE: u16 = 0xF000
pub const HSCROLL: u16 = 0xFC00

/// Show the window plane over the top `rows` cell rows of the screen, in place of plane A —
/// a strip that does not scroll, where a game keeps its score while plane A scrolls with
/// the camera; 0 for none. Its cells are written like a plane's, at [WINDOW]
/// (`write_cell(vdp.WINDOW, x, y, word)`), a row [PLANE_WIDTH] cells wide in 40-cell mode.
pub let window_rows = (rows: u8) -> void => set_register(18, rows & 0x1F)

/// Show the window plane over the bottom `rows` cell rows of the screen instead — where a
/// text box (`std.genesis.text`) sits; 0 for none. Its cells are still counted from the
/// screen's top, so the bottom row is row 27.
pub let window_rows_below = (rows: u8) -> void =>
  set_register(18, if rows == 0 { 0 } else { 0x80 | ((28 - rows.min(28)) & 0x1F) })

/// A plane, as [init] sizes them, in cells.
pub const PLANE_WIDTH: u16 = 64
pub const PLANE_HEIGHT: u16 = 32

/// The VDP set up for a game: mode 5, 40 cells, the tables above, the display off, and
/// every memory cleared — VRAM (so every tile and table starts empty), CRAM (every colour
/// black) and VSRAM (no vertical scroll). Call once, first.
pub let init = () -> void => {
  for r: u8 in 0..<19 { set_register(r, INIT_REGISTERS[r]) }
  set_address(VRAM_WRITE, 0)
  for _: u16 in 0..<32768 { write_word(0) }
  set_address(CRAM_WRITE, 0)
  for _: u16 in 0..<64 { write_word(0) }
  set_address(VSRAM_WRITE, 0)
  for _: u16 in 0..<40 { write_word(0) }
  mode = INIT_REGISTERS[1]
  line_mode = 0
  banded = 0
  lines_changed = false
  for i: u16 in 0..<64 { shown[i] = 0 }
}

/// Show the planes and sprites (off after [init], so a game can load before anything is
/// seen).
pub let display_on = () -> void => {
  mode = mode | 0x40
  set_register(1, mode)
}

/// Blank the screen to the backdrop colour.
pub let display_off = () -> void => {
  mode = mode & 0xBF
  set_register(1, mode)
}

/// Have the VDP interrupt at the start of every vertical blank, running the program's
/// `@interrupt(vblank)` function — the place for work that must happen once a frame
/// whatever the main loop is doing (a music driver's tick, a frame counter):
///
/// ```
/// @interrupt(vblank)
/// let each_frame = () -> void => { frames += 1 }
/// ```
///
/// A module-level `var` the handler writes is shared safely with the main loop: the
/// compiler makes every access to it volatile, so a loop waiting on it sees each change.
/// One written only in a function the handler calls is not seen that way — read it with
/// `read_volatile`, or write it in the handler itself.
pub let enable_vblank_interrupt = () -> void => {
  mode = mode | 0x20
  set_register(1, mode)
}

/// Stop the vertical blank interrupt.
pub let disable_vblank_interrupt = () -> void => {
  mode = mode & 0xDF
  set_register(1, mode)
}

/// Have the VDP interrupt every `lines` lines of the picture (and again at its top),
/// running the program's `@interrupt(hblank)` function — for effects that change the
/// picture partway down it (a colour, a scroll).
pub let enable_hblank_interrupt = (lines: u8) -> void => {
  set_register(10, lines)
  hblank_on = true
  set_register(0, 0x14)
}

/// Stop the horizontal interrupt.
pub let disable_hblank_interrupt = () -> void => {
  hblank_on = false
  set_register(0, 0x04)
}

/// The line of the picture the VDP is drawing (0–223), or past it in the vertical blank: the
/// high byte of its H/V counter. What an `@interrupt(hblank)` handler asks where it is.
pub let line_now = () -> u16 => unsafe { hv_counter().read_volatile() >> 8 }

/// CRAM's colour `at` (0–63, palette × 16 + index) set to `color` at once, holding nothing
/// and keeping no copy — for an `@interrupt(hblank)` handler changing a colour partway down
/// the picture (`std.genesis.raster`), which nothing else may interrupt. [send_colors_each_frame]
/// puts the colours back for the next frame's top.
pub let write_color_now = (at: u16, color: u16) -> void => {
  set_address(CRAM_WRITE, (at & 63) * 2)
  write_word(color)
}

/// Whether [send_colors] sends all 64 colours every vertical blank, queued or not: on while
/// colours change partway down the picture, so each frame's top starts from [color_of]'s.
pub let send_colors_each_frame = (on: bool) -> void => { colors_each_frame = on }

/// Wait for the next vertical blank to begin — the time between frames when a game
/// changes what is shown, once a frame (60 times a second on an NTSC console).
pub let wait_vblank = () -> void => {
  // Out of any blank still under way, then into the next: status bit 3 is set during it.
  while (status() & 8) != 0 {}
  while (status() & 8) == 0 {}
}

/// A colour as CRAM holds it, from three levels of 0–7.
pub let rgb = pure (r: u16, g: u16, b: u16) -> u16 =>
  ((b & 7) << 9) | ((g & 7) << 5) | ((r & 7) << 1)

/// Colour `index` (0–15) of palette `palette` (0–3). Colour 0 of each palette is
/// transparent in a sprite or a plane's tile.
pub let set_color = (palette: u16, index: u16, color: u16) -> void => {
  let at = (palette & 3) * 16 + (index & 15)
  shown[at] = color
  let held = hold_vblank()
  set_address(CRAM_WRITE, at * 2)
  write_word(color)
  release_vblank(held)
}

/// All sixteen colours of palette `palette` from a table.
pub let load_palette = (palette: u16, colors: ref [16]u16) -> void => {
  let first = (palette & 3) * 16
  let held = hold_vblank()
  set_address(CRAM_WRITE, first * 2)
  for i: u16 in 0..<16 {
    shown[first + i] = colors[i]
    write_word(colors[i])
  }
  release_vblank(held)
}

/// Colour `index` of palette `palette` set to `color` at the next [send_colors] — in the
/// vertical blank, where `sprites.show` sends them: written while the picture is drawn, a
/// colour changes partway down it (and leaves a dot on a real console). What
/// `std.genesis.palette`'s cycles and fades change colours by. [color_of] answers it at once.
pub let queue_color = (palette: u16, index: u16, color: u16) -> void => {
  shown[(palette & 3) * 16 + (index & 15)] = color
  colors_queued = true
}

/// The colours [queue_color] changed, all 64 to CRAM; nothing when none did. In the vertical
/// blank: `sprites.show` calls it first; a game that does not call that, after [wait_vblank].
pub let send_colors = () -> void => {
  if !colors_queued && !colors_each_frame { return }
  colors_queued = false
  // Written, not sent by DMA: a DMA holds the Z80's bus, and its sample played flatter for
  // it (11/16), for two lines of the 68000's saved.
  let held = hold_vblank()
  set_address(CRAM_WRITE, 0)
  for i: u16 in 0..<64 { write_word(shown[i]) }
  release_vblank(held)
}

/// How far the screen has faded toward `color`: `levels` (0–7) of each channel's levels nearer
/// it, 0 none — what `std.genesis.palette`'s fades set as they step, so [faded] takes a colour
/// written partway down the picture (`std.genesis.raster`) the same way.
pub let set_fade = (color: u16, levels: i16) -> void => {
  fade_color = color
  fade_levels = levels.clamp(0, 7)
}

/// CRAM word `color` as the screen's fade ([set_fade]) shows it now.
pub let faded = (color: u16) -> u16 =>
  if fade_levels == 0 { color } else { toward(color, fade_color, fade_levels) }

/// CRAM word `a` with every channel `levels` levels nearer `b`'s, none past it: a step of a fade.
pub let toward = pure (a: u16, b: u16, levels: i16) -> u16 =>
  channel_toward(
    a,
    b,
    1,
    levels
  ) | channel_toward(a, b, 5, levels) | channel_toward(a, b, 9, levels)

/// Whether the vertical blank interrupt is on ([enable_vblank_interrupt]): a game whose
/// handler calls `sprites.show`, which sends what is queued.
pub let vblank_interrupt_on = () -> bool => (mode & 0x20) != 0

/// Colour `index` of palette `palette` as [set_color], [load_palette] or [queue_color] last
/// made it (CRAM is not read back): what `std.genesis.palette` turns and fades from.
pub let color_of = (palette: u16, index: u16) -> u16 =>
  shown[(palette & 3) * 16 + (index & 15)]

/// The colour behind everything: colour `index` of palette `palette`.
pub let set_backdrop = (palette: u16, index: u16) -> void =>
  set_register(7, u8(((palette & 3) << 4) | (index & 15)))

/// Tiles into VRAM from tile `first` on, from a table of their rows — eight `u32` words a
/// tile, two pixels a byte, the left one in the high nibble (what Vega exports).
pub let load_tiles<const N: i64> = (first: u16, tiles: ref [N]u32) -> void => {
  let held = hold_vblank()
  set_address(VRAM_WRITE, first * 32)
  for row in tiles { write_long(row) }
  release_vblank(held)
}

/// Animated tiles as they are `tick` frames in: `runs` holds, for each, a tile (from `first`),
/// how many steps, then each step's tile and frames. A tile is written only as its step
/// changes, from `tiles` (as [load_tiles] takes them). In the vertical blank.
pub let step_tiles<const N: i64, const M: i64> = (
  first: u16,
  tiles: ref [N]u32,
  runs: ref [M]u16,
  tick: u16
) -> void => {
  let held = hold_vblank()
  var i: i64 = 0
  while i + 1 < M {
    let count = i64(runs[i + 1])
    var total: u16 = 0
    for k in 0..<count { total += runs[i + 3 + k * 2] }
    if total > 0 {
      var left = tick % total
      for k in 0..<count {
        let length = runs[i + 3 + k * 2]
        if left == 0 {
          set_address(VRAM_WRITE, (first + runs[i]) * 32)
          let from = i64(runs[i + 2 + k * 2]) * 8
          for w in 0..<8 { write_long(tiles[from + w]) }
          break
        }
        if left < length { break }
        left -= length
      }
    }
    i += 2 + count * 2
  }
  release_vblank(held)
}

/// A table of words into VRAM at byte `address`.
pub let write_vram<const N: i64> = (address: u16, words: ref [N]u16) -> void => {
  let held = hold_vblank()
  set_address(VRAM_WRITE, address)
  for w in words { write_word(w) }
  release_vblank(held)
}

/// A tile map into a plane (`PLANE_A` or `PLANE_B`): every one of the plane's cells, from
/// the map's cell (`left`, `top`) on. `cells` is the map row by row, `width` cells a row,
/// as name-table words — or blocks (`std.genesis.blocks`) — `priority << 15 | palette << 13 | flip_y << 12 | flip_x << 11 |
/// tile` — and a plane cell past the map's edge gets 0, the blank tile. A whole plane is
/// 2,048 words: write it before `display_on`, or between levels, rather than every frame.
pub let write_plane<const N: i64> = (
  plane: u16,
  cells: ref [N]u16,
  width: u16,
  left: u16 = 0,
  top: u16 = 0
) -> void => {
  let held = hold_vblank()
  for row: u16 in 0..<PLANE_HEIGHT {
    set_address(VRAM_WRITE, plane + row * PLANE_WIDTH * 2)
    for column: u16 in 0..<PLANE_WIDTH {
      write_word(blocks.cell_at(cells, width, left + column, top + row))
    }
  }
  release_vblank(held)
}

/// One cell of a plane (`PLANE_A` or `PLANE_B`) set to a name-table word — a score's digit,
/// a door opened in a level — `priority << 15 | palette << 13 | flip_y << 12 |
/// flip_x << 11 | tile`. `x` and `y` are the plane's cells, wrapping at its edges.
pub let write_cell = (plane: u16, x: u16, y: u16, word: u16) -> void => {
  let held = hold_vblank()
  set_address(
    VRAM_WRITE,
    plane + ((y % PLANE_HEIGHT) * PLANE_WIDTH + x % PLANE_WIDTH) * 2
  )
  write_word(word)
  release_vblank(held)
}

/// Scroll `plane` (`PLANE_A` or `PLANE_B`) so its pixel (`x`, `y`) is at the screen's
/// top-left — the whole screen at once. A plane wraps at its edges, so any position will
/// do. With line scrolling on ([use_bands]) every line of the plane is given `x`, unless the
/// plane's lines are its bands', when only `y` is set — and both go to the VDP with the
/// lines, in the next vertical blank ([send_lines]).
pub let set_scroll = (plane: u16, x: i16, y: i16) -> void => {
  let which: u16 = if plane == PLANE_A { 0 } else { 2 }
  let bit: u8 = if plane == PLANE_A { 1 } else { 2 }
  let word = line_word(i32(x))
  let down = u16(i32(y) & 1023)
  if line_mode != 0 {
    if (banded & bit) == 0 {
      begin_lines(plane)
      for _: i16 in 0..<SCREEN_HEIGHT { write_line(word) }
      end_lines()
    }
    lines_down[which / 2] = down
    lines_changed = true
    return
  }
  let held = hold_vblank()
  set_address(VRAM_WRITE, HSCROLL + which)
  write_word(word)
  set_address(VSRAM_WRITE, which)
  write_word(down)
  release_vblank(held)
}

/// Shadow and highlight on or off — register 12's mode. On, a pixel of the planes is drawn at
/// half its brightness (the shadow) unless either plane's cell there is high priority; a
/// sprite takes the shade under it unless it is high priority itself; and two colours of
/// palette 3 are not drawn at all but change what is under them — [HIGHLIGHT_INDEX] a step
/// brighter (a shadow back to normal, normal to the highlight, halfway to white), and
/// [SHADOW_INDEX] into the shadow: lights, glows and shadows that follow a sprite. Any other
/// colour 14 is drawn at normal, shaded or not. Once, as a scene starts.
pub let shadow_highlight = (on: bool) -> void => {
  set_register(12, if on { INIT_REGISTERS[12] | 0x08 } else { INIT_REGISTERS[12] })
}

/// The palette whose colours [HIGHLIGHT_INDEX] and [SHADOW_INDEX] are operators in shadow and
/// highlight ([shadow_highlight]), and those colours.
pub const OPERATOR_PALETTE: u16 = 3
pub const HIGHLIGHT_INDEX: u16 = 14
pub const SHADOW_INDEX: u16 = 15

/// Scroll each line of the screen on its own — the VDP's line scroll — and say which
/// planes' lines a game writes itself ([begin_lines]; `std.genesis.camera`'s
/// `scroll_bands`), the rest kept whole by [set_scroll]. Both false turns it off, the
/// planes scrolled whole again by the next [set_scroll]. Once, as a scene starts.
pub let use_bands = (plane_a: bool, plane_b: bool) -> void => {
  banded = (if plane_a { 1 } else { 0 }) | (if plane_b { 2 } else { 0 })
  line_mode = if banded != 0 { 3 } else { 0 }
  set_register(11, line_mode)
}

/// `plane`'s lines of the horizontal scroll from line 0, a [write_line] each: [line_word]s
/// for the screen's lines in turn, then [end_lines]. **Into a copy in RAM**, which
/// [send_lines] sends by DMA in the next vertical blank — written to the VDP from the game's
/// loop, a screen of lines held the interrupts for most of the picture's top, and a raster
/// effect's colours came lines late (11/16). So nothing here touches the VDP, or needs
/// holding.
pub let begin_lines = (plane: u16) -> void => {
  // The table holds plane A's word then plane B's for each line.
  line_at = if plane == PLANE_A { 0 } else { 1 }
}

/// The next line's word, after [begin_lines].
pub let write_line = (word: u16) -> void => {
  if line_at < 2 * 224 { lines[line_at] = word }
  line_at += 2
}

/// The lines [begin_lines] began written, to go out in the next vertical blank.
pub let end_lines = () -> void => { lines_changed = true }

/// The line scroll and the planes' vertical scroll, as [write_line] and [set_scroll] left
/// them, sent if changed: by DMA, in the vertical blank — `sprites.show` calls it.
pub let send_lines = () -> void => {
  if !lines_changed || line_mode == 0 { return }
  lines_changed = false
  let from = u32(unsafe { (&lines).address() })
  dma_to_vram(from, HSCROLL, 2 * 224)
  let held = hold_vblank()
  set_address(VSRAM_WRITE, 0)
  write_word(lines_down[0])
  write_word(lines_down[1])
  release_vblank(held)
}

/// Room for `words` words to go to byte `address` of VRAM in the next vertical blank, by DMA
/// — the address moving on `step` bytes a word: 2 for a run of a plane's row, `PLANE_WIDTH *
/// 2` down a column — answering where in the staged words they go ([put_staged]), or
/// [NO_ROOM]. **What `std.genesis.camera` streams into a plane goes this way**: worked out
/// in the frame, sent by [send_staged] (`sprites.show` calls it) in a few DMAs, rather than
/// written a word and an address at a time inside the blank. A run is sent as it is when
/// sent, so hold the vertical blank ([hold_vblank]) from staging it to its last word.
pub let stage = (address: u16, step: u16, words: u16) -> u16 => {
  if runs >= MAX_STAGED_RUNS || staged_count + words > MAX_STAGED_WORDS { return NO_ROOM }
  let at = staged_count
  run_address[runs] = address
  run_step[runs] = step
  run_from[runs] = at
  run_words[runs] = words
  runs += 1
  staged_count += words
  at
}

/// What [stage] answers when its runs or words are full: write directly instead.
pub const NO_ROOM: u16 = 0xFFFF

/// Staged word `at` ([stage]'s answer and on) set to `word`.
pub let put_staged = (at: u16, word: u16) -> void => { staged[at] = word }

/// The staged runs into `plane`'s 4 KB forgotten — what a plane redrawn whole makes stale.
pub let drop_staged = (plane: u16) -> void => {
  var kept: u16 = 0
  for r: u16 in 0..<runs {
    if run_address[r] >= plane && run_address[r] < plane + PLANE_WIDTH * PLANE_HEIGHT * 2 {
      continue
    }
    run_address[kept] = run_address[r]
    run_step[kept] = run_step[r]
    run_from[kept] = run_from[r]
    run_words[kept] = run_words[r]
    kept += 1
  }
  runs = kept
  if runs == 0 { staged_count = 0 }
}

/// The runs [stage] made, sent by DMA in the order staged, and the room emptied: in the
/// vertical blank — `sprites.show` calls it.
pub let send_staged = () -> void => {
  if runs == 0 { return }
  let base = u32(unsafe { (&staged).address() })
  for r: u16 in 0..<runs {
    dma_to_vram(base + u32(run_from[r]) * 2, run_address[r], run_words[r], run_step[r])
  }
  runs = 0
  staged_count = 0
}

/// The horizontal scroll word showing the plane from its pixel `x` at the screen's left:
/// the VDP moves a plane right by its scroll, so the view at x is a scroll of -x.
pub let line_word = pure (x: i32) -> u16 => u16((1024 - (x & 1023)) & 1023)

/// `words` words from byte `source` of the 68000's memory (even; the cartridge's ROM, or RAM)
/// to byte `address` of VRAM, by the VDP's DMA: the 68000 waits while the VDP copies, at many
/// times the speed of writing them — what streaming a sprite's frames needs ([sprites.streamed]).
/// The address moves on `step` bytes a word: 2 for a run, a plane's row (`PLANE_WIDTH * 2`)
/// for a column of it ([stage]).
/// In the vertical blank, where the VDP copies fastest and nothing shown tears. A source
/// crossing a 128 KB boundary, which the VDP's source address cannot, is sent in two parts
/// ([dma_run]). With the Z80's driver running ([guard_dma]), its bus is held for the copy: the
/// Z80 reads the cartridge too.
pub let dma_to_vram = (source: u32, address: u16, words: u16, step: u16 = 2) -> void => {
  if words == 0 { return }
  let held = hold_vblank()
  if dma_guarded { unsafe {
    z80_bus().write_volatile(0x0100)
    while (z80_bus().read_volatile() & 0x0100) != 0 {}
  } }
  set_register(1, mode | 0x10)
  if step != 2 { set_register(15, u8(step)) }
  var from = source
  var at = address
  var left = words
  while left > 0 {
    let run = dma_run(from, left)
    set_register(19, u8(run & 0xFF))
    set_register(20, u8(run >> 8))
    set_register(21, u8((from >> 1) & 0xFF))
    set_register(22, u8((from >> 9) & 0xFF))
    set_register(23, u8((from >> 17) & 0x7F))
    // The address with the DMA bit (CD5) set: the copy starts with the second word.
    let port = control_port()
    unsafe {
      port.write_volatile(0x4000 | (at & 0x3FFF))
      port.write_volatile(0x0080 | (at >> 14))
    }
    from += u32(run) * 2
    at = at.wrapping_add(run.wrapping_mul(step))
    left -= run
  }
  if step != 2 { set_register(15, 2) }
  set_register(1, mode)
  if dma_guarded { unsafe { z80_bus().write_volatile(0) } }
  release_vblank(held)
}

/// How many of `words` words from byte `source` one DMA can copy: up to the next 128 KB
/// boundary of the source, which the VDP's source counter does not cross.
pub let dma_run = pure (source: u32, words: u16) -> u16 => {
  let room = 0x10000 - ((source >> 1) & 0xFFFF)
  if u32(words) > room { u16(room) } else { words }
}

/// Whether [dma_to_vram] holds the Z80's bus while it copies: `std.genesis.sound.init` says
/// so once its driver runs. Off before — a Z80 still in reset answers no bus request.
pub let guard_dma = (on: bool) -> void => { dma_guarded = on }

/// The VDP's interrupts held off — the vertical blank's, and the horizontal one's
/// ([enable_hblank_interrupt]) — answering which were on, around a run of writes from the
/// game's loop: an address, then its data. An interrupt's own writes (the sprite list, a
/// raster's colour) move the VDP's address, and a run they land in goes on at theirs: a map
/// drawn with the interrupt on lost the rest of a row, black on the screen (10/06). One
/// that falls due while held is taken as soon as it is let go ([release_vblank]). Every
/// writer here holds it; a game holds it around its own [set_vram_address] and
/// [write_word]s.
pub let hold_vblank = () -> u8 => {
  let vblank = (mode & 0x20) != 0
  let hblank = hblank_on
  if vblank { disable_vblank_interrupt() }
  if hblank { set_register(0, 0x04) }
  (if vblank { 1 } else { 0 }) | (if hblank { 2 } else { 0 })
}

/// The interrupts let go after [hold_vblank]: each on again if it was on.
pub let release_vblank = (held: u8) -> void => {
  if (held & 2) != 0 { set_register(0, 0x14) }
  if (held & 1) != 0 { enable_vblank_interrupt() }
}

/// Point the data port at byte `address` of VRAM, for [write_word]s to follow — how the
/// sprite table and the planes are written. From the game's loop, hold the vertical blank
/// interrupt around it and the writes ([hold_vblank]).
pub let set_vram_address = (address: u16) -> void => set_address(VRAM_WRITE, address)

/// A word to the data port: to where the last address was set, which then moves on two
/// bytes.
pub let write_word = (word: u16) -> void => unsafe { data_port().write_volatile(word) }

/// Register `r` (0–23) set to `value` — for what the functions above do not cover.
pub let set_register = (r: u8, value: u8) -> void =>
  unsafe { control_port().write_volatile(0x8000 | (u16(r & 31) << 8) | u16(value)) }

// ── Beneath ──────────────────────────────────────────────────────────────────────────

/// Registers 0–18 as `init` sets them: mode 5 with no interrupts; register 1 display
/// off; the tables' addresses; the backdrop palette 0 colour 0; 40 cells; auto-increment
/// 2; 64×32 planes; no window.
const INIT_REGISTERS: [19]u8 = #[
  0x04, 0x04, 0x30, 0x2C, 0x07, 0x78, 0x00, 0x00, 0x00, 0x00,
  0xFF, 0x00, 0x81, 0x3F, 0x00, 0x02, 0x01, 0x00, 0x00,
]

/// Register 1 as last set, so turning the display on or off keeps the rest.
var mode: u8 = 0x04

/// Register 11's scroll modes as [use_bands] set them (3, a line each; 0, the whole screen),
/// and the planes whose lines the game writes: bit 0 plane A's, bit 1 plane B's.
var line_mode: u8 = 0
var banded: u8 = 0

/// The horizontal scroll table in line mode as the VDP holds it — a line's plane A word, then
/// its plane B word — and each plane's vertical scroll, kept here for [send_lines]; where
/// [write_line] writes next; whether they changed since last sent.
var lines: [448]u16 = #[0; 448]
var lines_down: [2]u16 = #[0; 2]
var line_at: u16 = 0
var lines_changed: bool = false

/// The words [stage] keeps for the next vertical blank, and its runs: each a VRAM address, the
/// step between its words, where its words start here and how many. Room for a frame of two
/// planes scrolling a column and a row each, many times over.
const MAX_STAGED_WORDS: u16 = 1024
const MAX_STAGED_RUNS: u16 = 32
var staged: [1024]u16 = #[0; 1024]
var staged_count: u16 = 0
var run_address: [32]u16 = #[0; 32]
var run_step: [32]u16 = #[0; 32]
var run_from: [32]u16 = #[0; 32]
var run_words: [32]u16 = #[0; 32]
var runs: u16 = 0

/// The 64 colours as last written ([color_of]).
var shown: [64]u16 = #[0; 64]

/// Whether [queue_color] has changed a colour [send_colors] has not sent.
var colors_queued: bool = false

/// The screen's fade ([set_fade]): toward this colour, so many levels.
var fade_color: u16 = 0
var fade_levels: i16 = 0

/// Whether the horizontal interrupt is on ([enable_hblank_interrupt]).
var hblank_on: bool = false

/// Whether [send_colors] sends every colour each vertical blank ([send_colors_each_frame]).
var colors_each_frame: bool = false

/// Whether [dma_to_vram] takes the Z80's bus ([guard_dma]).
var dma_guarded: bool = false

/// The first word of an address command for each memory; the second carries the
/// address's top two bits and the rest of the code.
const VRAM_WRITE: u16 = 0x4000
const CRAM_WRITE: u16 = 0xC000
const VSRAM_WRITE: u16 = 0x4010

/// Point the data port at `address` in the memory `code` names (VSRAM's code has a bit
/// in the second word, which is why it is 4010).
let set_address = (code: u16, address: u16) -> void => {
  let port = control_port()
  unsafe {
    port.write_volatile((code & 0xC000) | (address & 0x3FFF))
    port.write_volatile((code & 0x00F0) | (address >> 14))
  }
}

/// A long to the data port: two words, high first, as the 68000 writes it.
let write_long = (long: u32) -> void => unsafe { data_long_port().write_volatile(long) }

/// The status word: bit 3 is set during a vertical blank.
let status = () -> u16 => unsafe { control_port().read_volatile() }

let control_port = pure () -> ^mut u16 => unsafe { pointer_at(0xC00004) }

let data_port = pure () -> ^mut u16 => unsafe { pointer_at(0xC00000) }

/// One channel of [toward]: the three bits at `shift`, `levels` levels nearer `b`'s, no further.
let channel_toward = pure (a: u16, b: u16, shift: u16, levels: i16) -> u16 => {
  let x = i16((a >> shift) & 7)
  let y = i16((b >> shift) & 7)
  let v = if y > x { (x + levels).min(y) } else { (x - levels).max(y) }
  u16(v) << shift
}

/// The H/V counter: the line in its high byte, the place along it in its low.
let hv_counter = pure () -> ^u16 => unsafe { pointer_at(0xC00008) }

let data_long_port = pure () -> ^mut u32 => unsafe { pointer_at(0xC00000) }

/// The Z80's bus request: 0x0100 written asks for its bus, read back clear once granted.
let z80_bus = pure () -> ^mut u16 => unsafe { pointer_at(0xA11100) }
