module std.genesis.collision
//! Collision shapes — boxes and ellipses on a sprite or a tile — and whether two overlap,
//! or one overlaps a tile map's solid tiles.
//!
//! ```
//! import std.genesis.collision
//! import std.genesis.collision.{ Shape }
//!
//! const FEET: Shape = Shape { x: 3, y: 18, width: 10, height: 6 }
//! const ROCK: Shape = Shape { ellipse: true, x: 1, y: 1, width: 6, height: 6 }
//!
//! if FEET.overlaps(x, y, ROCK, rock_x, rock_y) { … }
//! ```
//!
//! **A shape is placed by where its owner is**: its `x` and `y` are from the owner's
//! top-left, so `a.overlaps(ax, ay, b, bx, by)` asks about `a` on something at (ax, ay)
//! and `b` on something at (bx, by). Shapes that only touch do not overlap, so a player
//! slides along a wall rather than sticking to it, and **a shape with no area meets
//! nothing** — what an entity that collides by no shape is given (`Shape { x: 0, y: 0,
//! width: 0, height: 0 }`).
//!
//! **No arithmetic the 68000 emulates**: positions are `i16`, and the tests are 32-bit
//! multiplications of differences no wider than a shape — exact for shapes up to 128
//! pixels a side (Vega refuses larger). Two ellipses are tested as one ellipse whose radii
//! are their sums: exact for circles, close for ellipses.
//!
//! A map's tiles may carry shapes too ([hits_map]): the tiles a shape covers are found
//! from its name-table words (Vega's `assets.hits_<map>` passes the tables). **So may the
//! map itself** ([hits_any]): colliders drawn on it in its own pixels, wherever they are —
//! what Tiled's object layers of rectangles make. Two boxes are compared at any size; only
//! an ellipse is held to 128 pixels a side.
//!
//! **Colliders and layers**: a [Collider] is a shape on some collision layers — bits of a
//! `u16`, which the game names — looking for others. Meeting is **one-sided**:
//! `a.meets(ax, ay, b, bx, by)` asks whether `a` looks for one of `b`'s layers and their
//! shapes overlap, whatever `b` looks for; the game decides what a meeting does — stop a
//! move, pick a star up. A map's tiles are colliders that look for nothing, so a collider
//! [hits_map] only on the tiles of layers it looks for: a boat's hull can stop at a wall
//! and not at water.
//!
//! **A one-way collider is solid from above only** (`one_way`): a platform stood on and
//! jumped up through. Overlap does not say which way something came, so it counts only in
//! a move — [hits_map_moving], [hits_any_moving], which `std.genesis.entity`'s moves ask —
//! and there only when the move came down onto it from clear above it; [hits_map] and
//! [hits_any] count it as they count any other.

/// A box, or the ellipse filling it, from its owner's top-left, in pixels.
pub struct Shape {
  ellipse: bool = false,
  x: i16,
  y: i16,
  width: i16,
  height: i16,
}

/// A shape on collision layers `layers`, looking for those in `mask` — one bit a layer;
/// `one_way`, met in a move only coming down onto it ([hits_map_moving]).
pub struct Collider {
  shape: Shape,
  layers: u16,
  mask: u16,
  one_way: bool = false,
}

/// Whether this collider on something at (`ax`, `ay`) meets `b` on something at (`bx`,
/// `by`): it looks for one of `b`'s layers, and their shapes overlap. One-sided — `b` need
/// not look for this one's. The layers are tested first, so most pairs cost an `and`.
pub let meets = pure (
  self: Collider,
  ax: i16,
  ay: i16,
  b: Collider,
  bx: i16,
  by: i16
) -> bool => (self.mask & b.layers) != 0 && self.shape.overlaps(ax, ay, b.shape, bx, by)

/// Whether this shape on something at (`ax`, `ay`) overlaps `b` on something at (`bx`, `by`).
/// Touching is not overlapping, and a shape with no area overlaps nothing.
pub let overlaps = pure (
  self: Shape,
  ax: i16,
  ay: i16,
  b: Shape,
  bx: i16,
  by: i16
) -> bool => {
  if self.width <= 0 || self.height <= 0 || b.width <= 0 || b.height <= 0 { return false }
  let a_left = i32(ax) + i32(self.x)
  let a_top = i32(ay) + i32(self.y)
  let b_left = i32(bx) + i32(b.x)
  let b_top = i32(by) + i32(b.y)
  let a_right = a_left + i32(self.width)
  let a_bottom = a_top + i32(self.height)
  let b_right = b_left + i32(b.width)
  let b_bottom = b_top + i32(b.height)
  // The rectangles first: no pair overlaps unless they do, and past here every
  // difference below is no wider than a shape.
  if a_left >= b_right || b_left >= a_right || a_top >= b_bottom || b_top >= a_bottom {
    return false
  }
  if !self.ellipse && !b.ellipse { return true }
  // Doubled coordinates: an ellipse's centre and radius are whole numbers then.
  if self.ellipse && b.ellipse {
    // As one ellipse with the summed radii, about the difference of the centres — in
    // single units, so the products stay inside 32 bits.
    let dx = ((a_left * 2 + i32(self.width)) - (b_left * 2 + i32(b.width))) / 2
    let dy = ((a_top * 2 + i32(self.height)) - (b_top * 2 + i32(b.height))) / 2
    let rx = (i32(self.width) + i32(b.width)) / 2
    let ry = (i32(self.height) + i32(b.height)) / 2
    return inside(dx, dy, rx, ry)
  }
  if self.ellipse {
    return box_meets_ellipse(
      b_left,
      b_top,
      b_right,
      b_bottom,
      a_left,
      a_top,
      self.width,
      self.height
    )
  }
  box_meets_ellipse(a_left, a_top, a_right, a_bottom, b_left, b_top, b.width, b.height)
}

/// The shape mirrored left to right on an owner `width` wide — a sprite drawn mirrored.
pub let mirrored = pure (self: Shape, width: i16) -> Shape =>
  Shape { self | x: width - self.x - self.width }

/// The shape flipped top to bottom on an owner `height` tall.
pub let flipped = pure (self: Shape, height: i16) -> Shape =>
  Shape { self | y: height - self.y - self.height }

/// The collider with its shape mirrored left to right on an owner `width` wide.
pub let mirrored = pure (self: Collider, width: i16) -> Collider =>
  Collider { self | shape: self.shape.mirrored(width) }

/// The collider with its shape flipped top to bottom on an owner `height` tall.
pub let flipped = pure (self: Collider, height: i16) -> Collider =>
  Collider { self | shape: self.shape.flipped(height) }

/// Whether the shape on something at (`x`, `y`) overlaps a shape of any of a tile map's cells.
/// `cells` is the map's name-table words, row by row, `width` cells a row, the map's
/// top-left at the world's (0, 0); its tile set's tiles start at video memory's tile
/// `first_tile`. Tile `t`'s shapes are `shapes[starts[t]]` up to `shapes[starts[t + 1]]`,
/// from the tile's top-left, mirrored and flipped as a cell shows its tile. A shape past
/// the map's edge meets nothing there.
pub let hits_map<const N: i64, const M: i64, const K: i64> = pure (
  self: Shape,
  x: i16,
  y: i16,
  cells: ref [N]u16,
  width: u16,
  first_tile: u16,
  starts: ref [M]u16,
  shapes: ref [K]Shape
) -> bool => {
  let left = i32(x) + i32(self.x)
  let top = i32(y) + i32(self.y)
  let rows = i32(cells.len()) / i32(width)
  let tiles = i32(starts.len()) - 1
  // The cells the shape's rectangle covers, inside the map.
  let first_column = (left >> 3).max(0)
  let last_column = ((left + i32(self.width) - 1) >> 3).min(i32(width) - 1)
  let first_row = (top >> 3).max(0)
  let last_row = ((top + i32(self.height) - 1) >> 3).min(rows - 1)
  var row = first_row
  for row <= last_row {
    var column = first_column
    for column <= last_column {
      let word = cells[row * i32(width) + column]
      let tile = i32(word & 0x7FF) - i32(first_tile)
      if tile >= 0 && tile < tiles {
        for k: u16 in starts[tile]..<starts[tile + 1] {
          var shape = shapes[k]
          if (word & 0x0800) != 0 { shape = shape.mirrored(8) }
          if (word & 0x1000) != 0 { shape = shape.flipped(8) }
          if self.overlaps(x, y, shape, i16(column * 8), i16(row * 8)) { return true }
        }
      }
      column += 1
    }
    row += 1
  }
  false
}

/// Whether this collider on something at (`x`, `y`) meets one of `others` it looks for —
/// colliders placed in the world itself, at its origin: a map's own shapes, in the map's
/// pixels. One-sided, as [meets] is.
pub let hits_any<const P: i64> = pure (
  self: Collider,
  x: i16,
  y: i16,
  others: ref [P]Collider
) -> bool => self.any_stops(x, y, y, false, others)

/// [hits_any] for something moved to (`x`, `y`) from (`x`, `from_y`): a one-way collider
/// counts only when the move came down onto it — overlapping it at `y`, clear of it at
/// `from_y` above.
pub let hits_any_moving<const P: i64> = pure (
  self: Collider,
  x: i16,
  y: i16,
  from_y: i16,
  others: ref [P]Collider
) -> bool => self.any_stops(x, y, from_y, true, others)

/// Whether this collider on something at (`x`, `y`) meets a tile of a map: as the shape
/// form above, but each tile's shapes are colliders, and only those on a layer this one
/// looks for count.
pub let hits_map<const N: i64, const M: i64, const K: i64> = pure (
  self: Collider,
  x: i16,
  y: i16,
  cells: ref [N]u16,
  width: u16,
  first_tile: u16,
  starts: ref [M]u16,
  shapes: ref [K]Collider
) -> bool => self.map_stops(x, y, y, false, cells, width, first_tile, starts, shapes)

/// [hits_map] for something moved to (`x`, `y`) from (`x`, `from_y`): a one-way tile
/// collider counts only when the move came down onto it, as in [hits_any_moving].
pub let hits_map_moving<const N: i64, const M: i64, const K: i64> = pure (
  self: Collider,
  x: i16,
  y: i16,
  from_y: i16,
  cells: ref [N]u16,
  width: u16,
  first_tile: u16,
  starts: ref [M]u16,
  shapes: ref [K]Collider
) -> bool => self.map_stops(x, y, from_y, true, cells, width, first_tile, starts, shapes)

// ── Beneath ──────────────────────────────────────────────────────────────────────────

/// Whether this collider, at (`x`, `y`) — moved there from (`x`, `from_y`) when `moving` —
/// is stopped by `other` placed at (`ox`, `oy`): it looks for one of `other`'s layers,
/// their shapes overlap, and, `other` being one-way, a move came down onto it from clear
/// above. Not moving, a one-way collider is met as any other is.
let stopped_by = pure (
  self: Collider,
  x: i16,
  y: i16,
  from_y: i16,
  moving: bool,
  other: Collider,
  ox: i16,
  oy: i16
) -> bool => {
  if (self.mask & other.layers) == 0 || !self.shape.overlaps(x, y, other.shape, ox, oy) {
    return false
  }
  !other.one_way || !moving || (from_y < y && !self.shape.overlaps(
    x,
    from_y,
    other.shape,
    ox,
    oy
  ))
}

/// [hits_any] and [hits_any_moving].
let any_stops<const P: i64> = pure (
  self: Collider,
  x: i16,
  y: i16,
  from_y: i16,
  moving: bool,
  others: ref [P]Collider
) -> bool => {
  for k in 0..<others.len() {
    if self.stopped_by(x, y, from_y, moving, others[k], 0, 0) { return true }
  }
  false
}

/// [hits_map] and [hits_map_moving].
let map_stops<const N: i64, const M: i64, const K: i64> = pure (
  self: Collider,
  x: i16,
  y: i16,
  from_y: i16,
  moving: bool,
  cells: ref [N]u16,
  width: u16,
  first_tile: u16,
  starts: ref [M]u16,
  shapes: ref [K]Collider
) -> bool => {
  let left = i32(x) + i32(self.shape.x)
  let top = i32(y) + i32(self.shape.y)
  let rows = i32(cells.len()) / i32(width)
  let tiles = i32(starts.len()) - 1
  let first_column = (left >> 3).max(0)
  let last_column = ((left + i32(self.shape.width) - 1) >> 3).min(i32(width) - 1)
  let first_row = (top >> 3).max(0)
  let last_row = ((top + i32(self.shape.height) - 1) >> 3).min(rows - 1)
  var row = first_row
  for row <= last_row {
    var column = first_column
    for column <= last_column {
      let word = cells[row * i32(width) + column]
      let tile = i32(word & 0x7FF) - i32(first_tile)
      if tile >= 0 && tile < tiles {
        for k: u16 in starts[tile]..<starts[tile + 1] {
          var other = shapes[k]
          if (self.mask & other.layers) == 0 { continue }
          if (word & 0x0800) != 0 { other = other.mirrored(8) }
          if (word & 0x1000) != 0 { other = other.flipped(8) }
          if self.stopped_by(x, y, from_y, moving, other, i16(column * 8), i16(row * 8)) {
            return true
          }
        }
      }
      column += 1
    }
    row += 1
  }
  false
}

/// Whether (`dx`, `dy`) from an ellipse's centre is inside it, its radii `rx` and `ry`.
let inside = pure (dx: i32, dy: i32, rx: i32, ry: i32) -> bool =>
  dx * dx * ry * ry + dy * dy * rx * rx < rx * rx * ry * ry

/// Whether the box `left`..`right`, `top`..`bottom` overlaps the ellipse filling
/// `width` × `height` from (`ex`, `ey`): the box's point nearest the ellipse's centre is
/// inside it. In doubled coordinates.
let box_meets_ellipse = pure (
  left: i32,
  top: i32,
  right: i32,
  bottom: i32,
  ex: i32,
  ey: i32,
  width: i16,
  height: i16
) -> bool => {
  let cx = ex * 2 + i32(width)
  let cy = ey * 2 + i32(height)
  let nearest_x = cx.clamp(left * 2, right * 2)
  let nearest_y = cy.clamp(top * 2, bottom * 2)
  inside(nearest_x - cx, nearest_y - cy, i32(width), i32(height))
}
