module std.genesis.entity
//! The things a game is made of — a hero, a star, an enemy — as kinds and the entities of
//! them: where each is, how fast it is going, what it shows, and what it collides by.
//!
//! ```
//! import std.genesis.entity.{ Entity }
//!
//! var hero = assets.HERO.spawn(160, 208)        // Vega's entity editor makes the kind
//! loop {
//!   hero.push(dx, dy)                            // the pad: -1, 0 or 1 a direction
//!   hero.move_in_field()                         // assets: through the map, stopped by walls
//!   hero.play(assets.HERO_WALK, view, facing_left) // assets: shown, into the sprite list
//!   if hero.meets(star) { … }
//! }
//! ```
//!
//! **A kind is data, an entity is its instance.** An [EntityKind] — usually a constant
//! Vega writes (`assets.HERO`) — holds a sprite's size, the animation it starts with, its
//! [Collider]s and its motion; an [Entity] is one of it in the game, the kind copied in, so
//! every method needs nothing else. What needs the game's own tables — drawing a sprite, a
//! map's cells — is the game's assets', which pass them here ([move_in]).
//!
//! **Entities are passed by reference** (`ref`, `mut`): an entity carries its kind, colliders
//! and all, about a hundred bytes, and copying it into every `x()` and `meets` halved the
//! hero's frame rate on the 68000 (10/02).
//!
//! **Fixed point, 8.8**: a place is an `i32` and a speed an `i16`, both in 256ths of a
//! pixel, so an entity moves by fractions of a pixel without the 68000 dividing.
//!
//! **A kind's colliders may change by frame** (`EntityKind.frame_shapes`): the game's assets
//! give an entity its frame's shapes as they draw it, for what it meets. A map stops it by
//! the shapes of the frame it starts on, whatever it shows ([use_steady_shapes]): art that
//! lifts its feet on a stride should not let it sink to the floor, nor one reaching out wedge
//! it in a wall.
//!
//! **Meeting is one-sided**, as `std.genesis.collision` says: `a.meets(b)` asks whether a
//! collider of `a` looks for a layer one of `b`'s is on, whatever `b` looks for.
//!
//! **A path is followed, not steered** ([give_path], [follow_path]): Vega bakes the curve
//! drawn in its scene editor into points [PATH_STEP] pixels apart, so a frame along it is a
//! shift and a multiply at the kind's top speed.

import std.genesis.collision.{ Shape, Collider }

/// An animation of a sprite: where its steps are in the game's step table, how many, how
/// long they take in all (frames, 1/60 s), and whether it goes round. The game's assets
/// play one (Vega's `assets.lyra`: `animation.play(x, y, tick)`); here it is only carried.
pub struct Animation {
  /// Which sprite (its place in the project), and its steps.
  sprite: u16,
  first: u16,
  count: u16,
  total: u16,
  /// Back to the start after the end; else the last step holds.
  looping: bool,
}

/// The most colliders a kind has: a kind is copied into each of its entities, so its
/// colliders are a fixed array, the unused ones empty.
pub const MAX_COLLIDERS: i64 = 4

/// A collider of no shape, on no layer and looking for none: what fills a kind's unused
/// collider places. A shape with no area meets nothing.
pub const NO_COLLIDER: Collider = Collider {
  shape: Shape { x: 0, y: 0, width: 0, height: 0 },
  layers: 0,
  mask: 0
}

/// What a kind's `frame_shapes` is when its colliders keep their shapes.
pub const NO_FRAME_SHAPES: u16 = 0xFFFF

/// A kind of thing in the game: its sprite's size, what it shows when spawned, what it
/// collides by, and how it moves — its top speed, the speed it gains a frame while pushed,
/// loses a frame while not, and gains downwards a frame from gravity, all in 256ths of a
/// pixel.
pub struct EntityKind {
  width: i16,
  height: i16,
  animation: Animation,
  /// The first `collider_count` of `colliders` are its own.
  colliders: [4]Collider,
  collider_count: u16,
  max_speed: i16,
  acceleration: i16,
  friction: i16,
  gravity: i16,
  /// How fast a [jump] leaves the floor, upwards, in 256ths of a pixel a frame; 0, it does
  /// not jump. Vega works it out from the entity's jump height and gravity.
  jump_speed: i16 = 0,
  /// Where its rows start in the game's table of shapes by frame (`assets.FRAME_SHAPES`): a
  /// row a frame of its sprite, a shape a collider. [NO_FRAME_SHAPES] when its colliders
  /// keep their shapes.
  frame_shapes: u16 = NO_FRAME_SHAPES,
  /// The row of the frame it starts on: the shapes a map stops it by ([use_steady_shapes]).
  steady_shapes: u16 = NO_FRAME_SHAPES,
  /// The box its colliders reach, on any frame, from its top-left — written by Vega — so
  /// [meets] passes over a pair whose boxes are apart without placing a collider. A kind
  /// written by hand has none ([NO_REACH]), and every pair of its is placed.
  reach: Shape = NO_REACH,
}

/// No reach: a kind's colliders may be anywhere, so [meets] places each pair.
pub const NO_REACH: Shape = Shape { x: 0, y: 0, width: 0, height: -1 }

/// An entity: one of a kind in the game, where it is and how fast it is going (256ths of a
/// pixel), what it shows, and which way it faces.
pub struct Entity {
  kind: EntityKind,
  /// Its top-left in the world: `x()` and `y()` are whole pixels.
  fx: i32,
  fy: i32,
  /// Its speed a frame — the game may set it (a jump, a knock back).
  vx: i16,
  vy: i16,
  /// What it shows and how many frames in.
  animation: Animation,
  tick: u16,
  /// Whether it faces the other way, which mirrors its colliders too.
  mirrored: bool,
  /// Which way its colliders face against a map: `mirrored`'s once turning would not put
  /// one into a tile it looks for. A collider off the sprite's middle moves when it turns,
  /// and turning beside a wall pushed it in — every move from there met the wall, and the
  /// entity was stuck (10/02, the hero beside a rock).
  hit_mirrored: bool,
  /// Drawn this frame: the game's assets set it as they draw it (`play`, `draw`), and a
  /// scene's `draw` skips it and clears it, so an entity played is not drawn twice.
  drawn: bool = false,
  /// How it is drawn turned (degrees clockwise) and grown (percent): the nearest of the
  /// angles and sizes its sprite declares, each pre-rendered when the game is built
  /// (`std.genesis.art`'s [choose_variant]). Drawing only: its colliders stay as drawn
  /// upright, at its own size.
  angle: i16 = 0,
  size: i16 = 100,
  /// The row of the game's shapes by frame it shows ([show_frame_shapes]).
  shown_row: u16 = NO_FRAME_SHAPES,
  /// Standing on something: its last move in a map was a fall stopped — by a tile, a map's
  /// own collider, or the map's bottom edge ([move_in]). What [jump] asks.
  on_floor: bool = false,
  /// Where its last move started, its top-left in whole pixels: what [blocked_by] backs it
  /// off a solid towards.
  was_x: i16 = 0,
  was_y: i16 = 0,
  /// Crushed: after its scene's `block`, still inside a solid or the map's collision — a
  /// solid's push ([blocked_by]) shoved it into a wall or another solid. The game decides
  /// what that means (hurt it, stop the solid); `block` sets it each time it runs.
  squeezed: bool = false,
  /// In play: an entity of a pool not in use is not ([waiting], [despawn]), and meets
  /// nothing, is drawn nowhere and follows no path. One spawned is.
  alive: bool = true,
  /// Its path ([give_path]) and whether it starts when first shown; where it is with it
  /// ([PATH_WAITING], [PATH_FOLLOWING], [PATH_DONE]); how far along it is, in 256ths of a
  /// pixel, from where it started it (`path_x`, `path_y`), and whether it is on its way back.
  /// `path_laps` counts the ends it has reached.
  path: Path = NO_PATH,
  path_when_seen: bool = false,
  path_state: u8 = PATH_NONE,
  path_at: i32 = 0,
  path_back: bool = false,
  path_x: i32 = 0,
  path_y: i32 = 0,
  path_laps: u16 = 0,
  /// Frames it has yet to stand still at a pause of its path.
  path_wait: u16 = 0,
  /// Started and not yet followed: a pause at its first point is still to come.
  path_fresh: bool = false,
}

/// The fastest an entity falls, in 256ths of a pixel a frame: 8 pixels, a tile, so a fall
/// never steps over a tile it should land on.
pub const MAX_FALL: i16 = 2048

impl Entity {
  /// Its top-left in the world, in whole pixels.
  pub let x = pure (self: ref) -> i16 => i16(self.fx >> 8)
  pub let y = pure (self: ref) -> i16 => i16(self.fy >> 8)

  /// Put it with its top-left at (`x`, `y`), its speed kept — and its last move starting
  /// there, as [spawn] has it, so a solid does not back it off towards where it was.
  pub let place = (self: mut, x: i16, y: i16) -> void => {
    self.fx = i32(x) << 8
    self.fy = i32(y) << 8
    self.was_x = x
    self.was_y = y
  }

  /// A frame's push, `dx` and `dy` each -1, 0 or 1 (the pad's directions): a pushed axis gains
  /// the kind's acceleration towards its top speed, one not pushed loses its friction until
  /// it stands. With gravity the vertical axis is gravity's, falling at most [MAX_FALL], and
  /// `dy` is not used — a jump sets `vy`. Once a frame, before moving.
  ///
  /// **Pushed both ways at once, it goes no faster**: each axis's top speed and acceleration
  /// are the kind's over √2, so the diagonal is the top speed, not 1.4 times it.
  pub let push = (self: mut, dx: i16, dy: i16) -> void => {
    let diagonal = dx != 0 && dy != 0 && self.kind.gravity <= 0
    let top = if diagonal { over_root_two(self.kind.max_speed) } else { self.kind.max_speed }
    let rate = if diagonal {
      over_root_two(self.kind.acceleration)
    } else {
      self.kind.acceleration
    }
    self.vx = accelerate(self.vx, dx, rate, self.kind.friction, top)
    self.vy = if self.kind.gravity > 0 {
      (self.vy + self.kind.gravity).min(MAX_FALL)
    } else {
      accelerate(self.vy, dy, rate, self.kind.friction, top)
    }
  }

  /// Moved by its speed, a frame's worth, through anything — so on no floor.
  pub let move = (self: mut) -> void => {
    self.was_x = self.x()
    self.was_y = self.y()
    self.fx += i32(self.vx)
    self.fy += i32(self.vy)
    self.on_floor = false
  }

  /// Moved by its speed, a frame's worth, through anything but out of a world `width` by
  /// `height` pixels: at its edges it stops, as at a wall, and stands on the bottom one —
  /// what a level whose map has no collision moves by, so nothing leaves the map.
  pub let move_kept_in = (self: mut, width: u16, height: u16) -> void => {
    let across = i32(width) - i32(self.kind.width)
    let down = i32(height) - i32(self.kind.height)
    let right = if across > 0 { across << 8 } else { 0 }
    let bottom = if down > 0 { down << 8 } else { 0 }
    self.move()
    if self.fx < 0 {
      self.fx = 0
      self.vx = 0
    } else if self.fx > right {
      self.fx = right
      self.vx = 0
    }
    if self.fy < 0 {
      self.fy = 0
      self.vy = 0
    } else if self.fy > bottom {
      self.on_floor = self.vy > 0
      self.fy = bottom
      self.vy = 0
    }
  }

  /// Leave the floor at the kind's `jump_speed`, if it is on one ([on_floor]) and jumps at
  /// all; whether it did. Before its frame's `push` and move, which take it up from there.
  pub let jump = (self: mut) -> bool => {
    if !self.on_floor || self.kind.jump_speed <= 0 { return false }
    self.vy = -self.kind.jump_speed
    self.on_floor = false
    true
  }

  /// Moved by its speed in a map, kept inside it: each axis on its own, and one whose move
  /// would meet a tile its colliders look for, or leave the map, stops — so it slides along
  /// a wall rather than sticking to it. Not `kept_in`, the map's edges stop nothing: it
  /// leaves where the map's collision leaves a gap — down a hole, out of a door — and the
  /// game decides what that means. Its colliders turn as it has once they fit. The map
  /// is `std.genesis.collision.hits_map`'s: `cells` row by row, `width` a row, its tile
  /// set's tiles from `first_tile`, their colliders `shapes[starts[t]]` up to `starts[t + 1]`.
  pub let move_in<const N: i64, const M: i64, const K: i64> = (
    self: mut,
    cells: ref [N]u16,
    width: u16,
    first_tile: u16,
    starts: ref [M]u16,
    shapes: ref [K]Collider,
    kept_in: bool = true
  ) -> void =>
    self.move_in_with(
      cells,
      width,
      first_tile,
      starts,
      shapes,
      NO_BANDS,
      NO_MAP_SHAPES,
      kept_in
    )

  /// [move_in], stopped too by the map's own colliders — shapes drawn on the map itself, in
  /// its pixels, where its tiles carry none — gathered by 64-pixel band, `bands` saying where
  /// each band's start in `map_shapes` (`collision.hits_banded`; `#[0, n]` for one band of
  /// all `n`).
  ///
  /// **A one-way collider** (a tile's or the map's) stops only the vertical move, and only
  /// coming down onto it from clear above: an entity stands on it, and jumps up through it or
  /// walks across it — and having come up into it, falls back through.
  pub let move_in_with<const N: i64, const M: i64, const K: i64, const B: i64, const P: i64> = (
    self: mut,
    cells: ref [N]u16,
    width: u16,
    first_tile: u16,
    starts: ref [M]u16,
    shapes: ref [K]Collider,
    bands: ref [B]u16,
    map_shapes: ref [P]Collider,
    kept_in: bool = true
  ) -> void => {
    self.was_x = self.x()
    self.was_y = self.y()
    let rows = i32(cells.len()) / i32(width)
    // Where it may go, in 256ths of a pixel: the map, its edges' walls — or, not kept in,
    // as far as its place stays a pixel an i16 holds.
    let low = if kept_in { 0 } else { -OPEN_REACH }
    let right = if kept_in { (i32(width) * 8 - i32(self.kind.width)) << 8 } else { OPEN_REACH }
    let bottom = if kept_in { (rows * 8 - i32(self.kind.height)) << 8 } else { OPEN_REACH }
    // Turned: its colliders turn too, unless that would put one into a wall here.
    if self.hit_mirrored != self.mirrored && !self.kind.hits_tiles(
      self.x(),
      self.y(),
      self.y(),
      self.mirrored,
      cells,
      width,
      first_tile,
      starts,
      shapes,
      bands,
      map_shapes
    ) {
      self.hit_mirrored = self.mirrored
    }
    // An axis not moving is not tested: a still entity's tests are most of a frame's
    // collision, and an enemy walking a platform never moves up or down (10/05).
    if self.vx != 0 { self.move_across(
      cells,
      width,
      first_tile,
      starts,
      shapes,
      bands,
      map_shapes,
      low,
      right
    ) }
    // On a floor only if this frame's fall is stopped.
    self.on_floor = false
    if self.vy != 0 { self.move_up_or_down(
      cells,
      width,
      first_tile,
      starts,
      shapes,
      bands,
      map_shapes,
      low,
      bottom
    ) }
  }

  /// Show `animation`, facing the other way when `mirrored`: from its start when it is not
  /// what it shows now, else going on. Nothing is drawn: the game's assets' `play` sets this
  /// and draws the entity (`hero.play(assets.HERO_WALK, view)`), which needs their tables.
  pub let set_animation = (
    self: mut,
    animation: Animation,
    mirrored: bool = false
  ) -> void => {
    if animation.first != self.animation.first || animation.sprite != self.animation.sprite {
      self.animation = animation
      self.tick = 0
    }
    self.mirrored = mirrored
  }

  /// Its colliders' shapes those of `frame` of its sprite, from the game's table: what the
  /// game's assets do as they draw an entity whose kind has `frame_shapes`, so what it meets
  /// is what is shown.
  pub let show_frame_shapes<const F: i64> = (
    self: mut,
    table: ref [F]Shape,
    frame: u16
  ) -> void => {
    let row = self.kind.frame_shapes + frame * self.kind.collider_count
    if row != self.shown_row {
      self.use_shapes(table, row)
      self.shown_row = row
    }
  }

  /// Before a move in a map: its colliders' shapes the steady ones, of the frame it starts on,
  /// until [use_shown_shapes]. A map stops it by these, since a shape fitted to the art moves
  /// as the art does: feet lifted on a stride let it sink to the floor, the next frame's lower
  /// ones were then inside it, and it stayed sunk (11/02, the platformer's yellow_guy).
  pub let use_steady_shapes<const F: i64> = (self: mut, table: ref [F]Shape) -> void => {
    if self.shown_row != NO_FRAME_SHAPES {
      self.use_shapes(table, self.kind.steady_shapes)
    }
  }

  /// After a move in a map: its colliders' shapes those of the frame it shows again.
  pub let use_shown_shapes<const F: i64> = (self: mut, table: ref [F]Shape) -> void => {
    if self.shown_row != NO_FRAME_SHAPES { self.use_shapes(table, self.shown_row) }
  }

  /// Whether it meets `other`: one of its colliders looks for a layer one of `other`'s is on,
  /// and their shapes overlap — each mirrored as its entity faces.
  pub let meets = pure (self: ref, other: ref Entity) -> bool =>
    self.meets_at(self.x(), self.y(), other)

  /// [meets], were its top-left at (`ax`, `ay`).
  ///
  /// Never inlined: a game asks it of many pairs in its busiest loop (the hero, of each
  /// star), and inlined there it shared `main`'s registers — every value of it spilled to
  /// the stack and back, a quarter of the hero's frame (11/11).
  @noinline
  pub let meets_at = pure (self: ref, ax: i16, ay: i16, other: ref Entity) -> bool => {
    if !self.alive || !other.alive { return false }
    let bx = other.x()
    let by = other.y()
    // The two kinds' reaches first, where both have one: the hero against a star across the
    // field is told apart here, a few compares rather than every pair of colliders placed.
    if self.kind.reach.height >= 0 && other.kind.reach.height >= 0 {
      let ar = if self.mirrored { self.kind.reach.mirrored(self.kind.width) } else { self.kind.reach }
      let br = if other.mirrored { other.kind.reach.mirrored(other.kind.width) } else { other.kind.reach }
      let a_left = i32(ax) + i32(ar.x)
      let a_top = i32(ay) + i32(ar.y)
      let b_left = i32(bx) + i32(br.x)
      let b_top = i32(by) + i32(br.y)
      if b_left >= a_left + i32(ar.width) || b_left + i32(br.width) <= a_left || b_top >= a_top + i32(ar.height) || b_top + i32(br.height) <= a_top {
        return false
      }
    }
    for i: u16 in 0..<self.kind.collider_count {
      // The layers first, read where they are: most pairs a game asks about — the hero
      // against each star — are not looking for each other, and copying and mirroring both
      // colliders before asking was a quarter of the hero's frame (11/11).
      let mask = self.kind.colliders[i].mask
      if mask == 0 { continue }
      var placed_a = false
      var ap = self.kind.colliders[i]
      var left: i32 = 0
      var top: i32 = 0
      var right: i32 = 0
      var bottom: i32 = 0
      for j: u16 in 0..<other.kind.collider_count {
        if (mask & other.kind.colliders[j].layers) == 0 { continue }
        if !placed_a {
          if self.mirrored { ap = ap.mirrored(self.kind.width) }
          left = i32(ax) + i32(ap.shape.x)
          top = i32(ay) + i32(ap.shape.y)
          right = left + i32(ap.shape.width)
          bottom = top + i32(ap.shape.height)
          placed_a = true
        }
        let bc = other.kind.colliders[j]
        let bp = if other.mirrored { bc.mirrored(other.kind.width) } else { bc }
        let b_left = i32(bx) + i32(bp.shape.x)
        let b_top = i32(by) + i32(bp.shape.y)
        if b_left >= right || b_left + i32(bp.shape.width) <= left || b_top >= bottom || b_top + i32(bp.shape.height) <= top {
          continue
        }
        if ap.meets(ax, ay, bp, bx, by) { return true }
      }
    }
    false
  }

  /// Stopped by `solid` as by a wall: an entity its move took into one — meeting it, on a
  /// layer its colliders look for — backed off it along the way it came, to a whole pixel,
  /// that axis's speed dropped; one coming down onto it stands on it ([on_floor]), and so
  /// does one resting on it. Once a frame after the entity moves, for each solid it may
  /// meet: a scene's `block` does it for every character and solid Vega placed.
  ///
  /// **A solid that moved** this frame (its own move, from `was_x`/`was_y`) carries an
  /// entity that started the frame resting on top of it, by as far as it went; and one it
  /// moved into is pushed out ahead of it, backed off towards where it started taken along
  /// by the solid's move. A push answers only to this solid: it may push the entity into
  /// the map, or another solid — squeezed, as the game decides.
  pub let blocked_by = (self: mut, solid: ref Entity) -> void => {
    if !self.alive || !solid.alive { return }
    // Where it started, taken along by the solid's move: clear of the solid there.
    let dx = solid.x() - solid.was_x
    let dy = solid.y() - solid.was_y
    let wx = self.was_x + dx
    let wy = self.was_y + dy
    // Riding it: resting on it where it started — carried, keeping its fraction of a pixel.
    let moved = dx != 0 || dy != 0
    if moved && !self.meets_at(wx, wy, solid) && self.meets_at(wx, wy + 1, solid) {
      self.fx += i32(dx) << 8
      self.fy += i32(dy) << 8
    }
    let px = self.x()
    let py = self.y()
    if self.meets_at(px, py, solid) {
      if !self.meets_at(wx, py, solid) {
        self.fx = i32(back_off(self, px, wx, true, solid)) << 8
        self.vx = 0
      } else if !self.meets_at(px, wy, solid) {
        if py > wy { self.on_floor = true }
        self.fy = i32(back_off(self, py, wy, false, solid)) << 8
        self.vy = 0
      } else if !self.meets_at(wx, wy, solid) {
        self.fx = i32(wx) << 8
        self.fy = i32(wy) << 8
        self.vx = 0
        self.vy = 0
      }
    }
    // Resting on it: what it stood on is a pixel down.
    if self.vy >= 0 && !self.on_floor && self.meets_at(self.x(), self.y() + 1, solid) {
      self.on_floor = true
    }
  }

  /// Whether it is inside a map's collision where it stands: a tile, on a layer its
  /// colliders look for, meeting it as it faces — a one-way collider not counted, as it stops
  /// nothing not coming down onto it. The map as [move_in] takes it. A move never ends in
  /// one; a solid's push ([blocked_by]) can, which a scene's `block` asks this about.
  pub let in_map<const N: i64, const M: i64, const K: i64> = pure (
    self: ref,
    cells: ref [N]u16,
    width: u16,
    first_tile: u16,
    starts: ref [M]u16,
    shapes: ref [K]Collider
  ) -> bool =>
    self.in_map_with(cells, width, first_tile, starts, shapes, NO_BANDS, NO_MAP_SHAPES)

  /// [in_map], the map's own colliders counted too, as [move_in_with] takes them.
  pub let in_map_with<const N: i64, const M: i64, const K: i64, const B: i64, const P: i64> = pure (
    self: ref,
    cells: ref [N]u16,
    width: u16,
    first_tile: u16,
    starts: ref [M]u16,
    shapes: ref [K]Collider,
    bands: ref [B]u16,
    map_shapes: ref [P]Collider
  ) -> bool =>
    self.kind.hits_tiles(
      self.x(),
      self.y(),
      self.y(),
      self.hit_mirrored,
      cells,
      width,
      first_tile,
      starts,
      shapes,
      bands,
      map_shapes
    )

  // ── Beneath ──────────────────────────────────────────────────────────────────────────

  /// Its colliders' shapes `table`'s row `row`.
  let use_shapes<const F: i64> = (self: mut, table: ref [F]Shape, row: u16) -> void => {
    for i: u16 in 0..<self.kind.collider_count {
      self.kind.colliders[i].shape = table[row + i]
    }
  }

  /// [move_in_with]'s move across, up to `right` (in 256ths of a pixel).
  let move_across<const N: i64, const M: i64, const K: i64, const B: i64, const P: i64> = (
    self: mut,
    cells: ref [N]u16,
    width: u16,
    first_tile: u16,
    starts: ref [M]u16,
    shapes: ref [K]Collider,
    bands: ref [B]u16,
    map_shapes: ref [P]Collider,
    low: i32,
    right: i32
  ) -> void => {
    let wanted_x = self.fx + i32(self.vx)
    let nx = wanted_x.clamp(low, right)
    if self.kind.hits_tiles(
      i16(nx >> 8),
      self.y(),
      self.y(),
      self.hit_mirrored,
      cells,
      width,
      first_tile,
      starts,
      shapes,
      bands,
      map_shapes
    ) {
      self.vx = 0
    } else {
      // At the map's edge it stops, as at a wall.
      if nx != wanted_x { self.vx = 0 }
      self.fx = nx
    }
  }

  /// [move_in_with]'s move up or down, to at most `bottom` (in 256ths of a pixel).
  let move_up_or_down<const N: i64, const M: i64, const K: i64, const B: i64, const P: i64> = (
    self: mut,
    cells: ref [N]u16,
    width: u16,
    first_tile: u16,
    starts: ref [M]u16,
    shapes: ref [K]Collider,
    bands: ref [B]u16,
    map_shapes: ref [P]Collider,
    low: i32,
    bottom: i32
  ) -> void => {
    let wanted_y = self.fy + i32(self.vy)
    let ny = wanted_y.clamp(low, bottom)
    if self.kind.hits_tiles(
      self.x(),
      i16(ny >> 8),
      self.y(),
      self.hit_mirrored,
      cells,
      width,
      first_tile,
      starts,
      shapes,
      bands,
      map_shapes
    ) {
      if self.vy > 0 { self.on_floor = true }
      self.vy = 0
    } else {
      if ny != wanted_y {
        if self.vy > 0 { self.on_floor = true }
        self.vy = 0
      }
      self.fy = ny
    }
  }
}

// ── Pools ──────────────────────────────────────────────────────────────────────────────

// **A pool is an array of entities of a kind, in play or waiting** — bullets, explosions,
// a wave of enemies: made of `waiting` ones (`#[BULLET.waiting(); 6]`), one brought into
// play by `spawn_at` and taken out by `despawn`, none ever made or freed while the game
// runs. What is not `alive` meets nothing, is drawn nowhere and follows no path, so a
// game's loops over a pool need not ask.
impl EntityKind {
  /// An entity of this kind waiting to be brought into play: what a pool is made of.
  pub let waiting = pure (self) -> Entity => Entity { self.spawn(0, 0) | alive: false }
}

impl Entity {
  /// Out of play, off any path: drawn nowhere and meeting nothing until spawned again.
  pub let despawn = (self: mut) -> void => {
    self.stop_path()
    self.alive = false
    self.vx = 0
    self.vy = 0
  }
}

/// A waiting entity of the pool brought into play with its top-left at (`x`, `y`), as
/// [EntityKind.spawn] makes one — still, upright, showing what its kind starts with, from
/// that animation's start — and which it is; -1 when all are in play.
pub let spawn_at<const N: i64> = (self: mut [N]Entity, x: i16, y: i16) -> i16 => {
  for i: u16 in 0..<u16(N) {
    if !self[i].alive {
      self[i] = Entity { self[i].kind.spawn(x, y) | mirrored: false }
      return i16(i)
    }
  }
  -1
}

/// How many of the pool are in play.
pub let in_play<const N: i64> = pure (self: ref [N]Entity) -> u16 => {
  var n: u16 = 0
  for i: u16 in 0..<u16(N) {
    if self[i].alive { n += 1 }
  }
  n
}

/// Every one of the pool in play moved by its speed ([Entity.move]), through anything.
pub let move_all<const N: i64> = (self: mut [N]Entity) -> void => {
  for i: u16 in 0..<u16(N) {
    if self[i].alive { self[i].move() }
  }
}

// ── Paths ──────────────────────────────────────────────────────────────────────────────

/// How far apart a path's points are, in pixels: Vega lays them out evenly along the curve
/// drawn in its scene editor, so following one is a shift and a multiply a frame — never a
/// root, which the CPU has no instruction for.
pub const PATH_STEP: i16 = 4

/// What an entity does at the end of its path ([Path.end]): stays there…
pub const PATH_STOP: u8 = 0
/// …goes round again (Vega closes such a path, its last point its first)…
pub const PATH_LOOP: u8 = 1
/// …goes back along it to the start, and out again…
pub const PATH_BACK_AND_FORTH: u8 = 2
/// …or carries on the way it was going, at its speed: out of the screen, as a shooter's
/// enemies leave.
pub const PATH_LEAVE: u8 = 3

/// Where an entity is with its path ([Entity.path_state]): it has none…
pub const PATH_NONE: u8 = 0
/// …it has one and waits to start it ([start_path])…
pub const PATH_WAITING: u8 = 1
/// …it is following it…
pub const PATH_FOLLOWING: u8 = 2
/// …or it reached the end of one that stops or leaves ([path_finished]).
pub const PATH_DONE: u8 = 3

/// A path an entity follows: `count` points from `first` in the game's table of every path's
/// points (Vega's `PATH_POINTS`), [PATH_STEP] pixels apart, and what it does at the end.
pub struct Path {
  first: u16,
  count: u16,
  end: u8,
  /// How fast an entity goes along it, in 256ths of a pixel a frame; 0 for the
  /// entity's kind's top speed.
  speed: i16 = 0,
  /// Its pauses: `wait_count` from `wait_first` in the game's table of every path's (Vega's
  /// `PATH_WAITS`), in the order they come along it.
  wait_first: u16 = 0,
  wait_count: u16 = 0,
}

/// A pause on a path: how far along it, in 256ths of a pixel — a point it goes through — and
/// for how many frames an entity there stands still.
pub struct PathWait {
  at: i32,
  frames: u16,
}

/// No path: what an entity has until it is given one.
pub const NO_PATH: Path = Path { first: 0, count: 0, end: PATH_STOP }

/// A point of a path, from where it starts, in 256ths of a pixel: wherever an entity is when
/// it starts the path is its first point.
pub struct PathPoint {
  x: i32,
  y: i32,
}

impl Entity {
  /// The entity given `path`, to start where it stands when the game says ([start_path]) —
  /// or, `when_seen`, when the camera first shows it, which the game's assets ask
  /// (`follow_path_in`). A path of fewer than two points is none.
  pub let give_path = (self: mut, path: Path, when_seen: bool = false) -> void => {
    self.path = path
    self.path_when_seen = when_seen
    self.path_state = if path.count >= 2 { PATH_WAITING } else { PATH_NONE }
    self.path_laps = 0
  }

  /// Its path started from where it stands, from its first point — again, if it was on it.
  pub let start_path = (self: mut) -> void => {
    if self.path.count < 2 { return }
    self.path_state = PATH_FOLLOWING
    self.path_x = self.fx
    self.path_y = self.fy
    self.path_at = 0
    self.path_back = false
    self.path_wait = 0
    self.path_fresh = true
  }

  /// A frame along its path — at the path's speed, else its kind's top speed — through
  /// anything: once a frame, in place of a move, `waits` the game's table of every path's
  /// pauses (Vega's `PATH_WAITS`). Reaching a pause it stops on its point and stands there
  /// as long as it says. Its speed is set to the step, for what asks it (which way it faces,
  /// [blocked_by]). One that left its path's end carries on as it went; one waiting to
  /// start, done or with none stays still.
  pub let follow_path<const K: i64, const W: i64> = (
    self: mut,
    points: ref [K]PathPoint,
    waits: ref [W]PathWait
  ) -> void => {
    // Most of a scene's entities are still — waiting to be seen, done or on none — and the
    // step below is a large function to call: a still one asks only this.
    if !self.alive { return }
    if self.path_state == PATH_FOLLOWING || (self.path_state == PATH_DONE && self.path.end == PATH_LEAVE) {
      self.step_path(points, waits)
    }
  }

  /// [follow_path]'s step, for an entity on the move. Never inlined: a scene follows each of
  /// its entities' paths, and a loop of them unrolled with this in every copy made the hero's
  /// `main` longer than a 68000's branch reaches.
  @noinline
  let step_path<const K: i64, const W: i64> = (
    self: mut,
    points: ref [K]PathPoint,
    waits: ref [W]PathWait
  ) -> void => {
    if self.path_state == PATH_DONE && self.path.end == PATH_LEAVE {
      // A pause at its end first: standing, still facing the way it will go.
      if self.path_wait > 0 {
        self.path_wait -= 1
        return
      }
      self.move()
      return
    }
    if self.path_state != PATH_FOLLOWING { return }
    // A pause at its first point, as it starts; and standing still through one.
    if self.path_fresh {
      self.path_fresh = false
      let first = self.pause_between(waits, -1, 0)
      if first >= 0 { self.path_wait = waits[self.path.wait_first + u16(first)].frames }
    }
    if self.path_wait > 0 {
      self.path_wait -= 1
      self.was_x = self.x()
      self.was_y = self.y()
      self.vx = 0
      self.vy = 0
      return
    }
    let span = i32(self.path.count - 1) << PATH_SHIFT
    let speed = i32(if self.path.speed > 0 { self.path.speed } else { self.kind.max_speed })
    // On by its speed — or to the first pause on the way, there to stand.
    let from = self.path_at
    var to = if self.path_back { from - speed } else { from + speed }
    let pause = self.pause_between(waits, from, to)
    if pause >= 0 {
      let w = waits[self.path.wait_first + u16(pause)]
      to = w.at
      self.path_wait = w.frames
    }
    self.path_at = to
    if self.path_back {
      if self.path_at <= 0 {
        self.path_at = (-self.path_at).min(span)
        self.path_back = false
        self.path_laps = self.path_laps.wrapping_add(1)
      }
    } else {
      if self.path_at >= span {
        self.path_laps = self.path_laps.wrapping_add(1)
        if self.path.end == PATH_LOOP {
          self.path_at = (self.path_at - span).min(span)
        } else if self.path.end == PATH_BACK_AND_FORTH {
          self.path_at = (span * 2 - self.path_at).max(0)
          self.path_back = true
        } else {
          self.path_at = span
          self.path_state = PATH_DONE
        }
      }
    }
    // Between the two points it is past, as far along as it is.
    let k = u16(self.path_at >> PATH_SHIFT)
    let p = points[self.path.first + k]
    var nx = self.path_x + p.x
    var ny = self.path_y + p.y
    if k + 1 < self.path.count {
      let q = points[self.path.first + k + 1]
      let part = self.path_at & (PATH_STEP_FIXED - 1)
      // A step is at most 1024 each way and `part` under 1024, so neither product can pass
      // 32 bits: wrapping is exact, and spares a checked multiply, which the 68000 makes
      // through a 64-bit one in software — most of a moving entity's frame (11/11).
      nx += (q.x - p.x).wrapping_mul(part) >> PATH_SHIFT
      ny += (q.y - p.y).wrapping_mul(part) >> PATH_SHIFT
    }
    self.was_x = self.x()
    self.was_y = self.y()
    self.vx = i16(nx - self.fx)
    self.vy = i16(ny - self.fy)
    self.fx = nx
    self.fy = ny
    self.on_floor = false
    // Leaving: on the way its last whole step went, at its speed.
    if self.path_state == PATH_DONE && self.path.end == PATH_LEAVE {
      let last = self.path.first + self.path.count - 1
      let whole = if self.path.count >= 3 { last - 1 } else { last }
      let a = points[whole - 1]
      let b = points[whole]
      self.vx = i16(((b.x - a.x) * speed) >> PATH_SHIFT)
      self.vy = i16(((b.y - a.y) * speed) >> PATH_SHIFT)
    }
  }

  /// Which of its path's pauses it meets going from `from` to `to`, either way — the first
  /// it comes to, past `from` and as far as `to` — or -1.
  let pause_between<const W: i64> = pure (
    self: ref,
    waits: ref [W]PathWait,
    from: i32,
    to: i32
  ) -> i32 => {
    var found: i32 = -1
    var best: i32 = 0
    for i: u16 in 0..<self.path.wait_count {
      let at = waits[self.path.wait_first + i].at
      let met = if to >= from { at > from && at <= to } else { at < from && at >= to }
      let nearer = found < 0 || (if to >= from { at < best } else { at > best })
      if met && nearer {
        found = i32(i)
        best = at
      }
    }
    found
  }

  /// Off its path, staying where it is: [follow_path] moves it no more. What a game does
  /// before putting it somewhere else — one shot down, say — or the path takes it back.
  pub let stop_path = (self: mut) -> void => {
    self.path = NO_PATH
    self.path_state = PATH_NONE
    self.path_wait = 0
  }

  /// Whether it reached the end of a path that stops or leaves there.
  pub let path_finished = pure (self: ref) -> bool => self.path_state == PATH_DONE
}

/// [PATH_STEP] in 256ths of a pixel, and the shift that divides by it.
const PATH_STEP_FIXED: i32 = 1024
const PATH_SHIFT: i32 = 10

/// Whether a sprite `width` × `height` with its top-left at (`x`, `y`) on the screen shows
/// there — one well off it would wrap round onto it. The screen is the Genesis's 320×224
/// (`vdp.SCREEN_WIDTH`, `vdp.SCREEN_HEIGHT`), written out so this module runs on the host.
pub let visible = pure (x: i16, y: i16, width: i16, height: i16) -> bool =>
  x > -width && x < 320 && y > -height && y < 224

impl EntityKind {
  /// An entity of this kind with its top-left at (`x`, `y`) in the world, still, showing
  /// what the kind starts with.
  pub let spawn = pure (self, x: i16, y: i16) -> Entity => Entity {
    kind: self,
    fx: i32(x) << 8,
    fy: i32(y) << 8,
    was_x: x,
    was_y: y,
    vx: 0,
    vy: 0,
    animation: self.animation,
    tick: 0,
    mirrored: false,
    hit_mirrored: false,
  }

  /// Whether an entity of this kind moved to (`x`, `y`) from (`x`, `from_y`), mirrored or
  /// not, is stopped by a tile of the map, or one of the map's own colliders, on a layer one
  /// of its colliders looks for (`collision.hits_map_moving`: a one-way collider only from
  /// above). A move across, or no move, passes `from_y` = `y`, which no one-way collider
  /// stops.
  let hits_tiles<const N: i64, const M: i64, const K: i64, const B: i64, const P: i64> = pure (
    self: ref,
    x: i16,
    y: i16,
    from_y: i16,
    mirrored: bool,
    cells: ref [N]u16,
    width: u16,
    first_tile: u16,
    starts: ref [M]u16,
    shapes: ref [K]Collider,
    bands: ref [B]u16,
    map_shapes: ref [P]Collider
  ) -> bool => {
    // Tiles that carry no shapes — a map whose collision is its own — are not walked.
    let tiled = starts[starts.len() - 1] != 0
    for i: u16 in 0..<self.collider_count {
      let c = self.colliders[i]
      let placed = if mirrored { c.mirrored(self.width) } else { c }
      if tiled && placed.hits_map_moving(
        x,
        y,
        from_y,
        cells,
        width,
        first_tile,
        starts,
        shapes
      ) {
        return true
      }
      if placed.hits_banded_moving(x, y, from_y, bands, map_shapes) { return true }
    }
    false
  }
}

/// How far past a map's edges an entity not kept in may go, in 256ths of a pixel: 30,000
/// pixels, so its whole-pixel place still fits an `i16`.
const OPEN_REACH: i32 = 30000 << 8

/// A map with no colliders of its own: one band of none, and a collider that meets nothing.
const NO_BANDS: [2]u16 = #[0, 0]
const NO_MAP_SHAPES: [1]Collider = #[NO_COLLIDER]

/// `v` over √2, to a 256th: 181/256 (0.707) as shifts — ½ + ⅛ + 1/16 + 1/64 + 1/256 — so
/// the 68000 does no multiply. For a speed or a rate, never negative.
let over_root_two = pure (v: i16) -> i16 =>
  (v >> 1) + (v >> 3) + (v >> 4) + (v >> 6) + (v >> 8)

/// One axis's speed after a frame: pushed `d` (-1, 0 or 1) it gains `rate`, up to `top` either
/// way; not pushed, it loses `friction` until it is 0.
let accelerate = pure (v: i16, d: i16, rate: i16, friction: i16, top: i16) -> i16 => {
  if d > 0 { return (v + rate).min(top) }
  if d < 0 { return (v - rate).max(-top) }
  if v > 0 { (v - friction).max(0) } else { (v + friction).min(0) }
}

/// Where `entity`, at `at` along one axis (`across`, else up or down) and meeting `solid`,
/// clears it stepping towards `was`, a pixel at a time, where it did not meet it.
let back_off = pure (
  entity: ref Entity,
  at: i16,
  was: i16,
  across: bool,
  solid: ref Entity
) -> i16 => {
  let step: i16 = if was < at { -1 } else { 1 }
  var p = at + step
  while p != was {
    let clear = if across {
      !entity.meets_at(p, entity.y(), solid)
    } else {
      !entity.meets_at(entity.x(), p, solid)
    }
    if clear { return p }
    p += step
  }
  was
}
