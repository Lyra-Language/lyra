module std.maybe

pub let map<t,u> = pure noalloc (m: Maybe<t>, f: (t) -> u) -> Maybe<u> => match m {
  Some v => Some(f(v)),
  None => None,
}

pub let flat_map<t,u> = pure noalloc (m: Maybe<t>, f: (t) -> Maybe<u>) -> Maybe<u> => match m {
  Some v => f(v),
  None => None,
}

pub let filter<t> = pure noalloc (m: Maybe<t>, predicate: (t) -> bool) -> Maybe<t> => match m {
  Some v => if predicate(v) { Some v } else { None },
  None => None,
}
