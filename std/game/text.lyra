module std.game.text
//! Text a modern game draws: a string as sprites, each letter a glyph of a font in the sprite
//! art (`screen.load_sprites`) — a score, a name, a message.
//!
//! ```
//! import std.game.text
//! import std.game.text.{ Font }
//!
//! let FONT = Font { sheet_y: 64.0, glyph_width: 12.0, glyph_height: 16.0, columns: 16, count: 96 }
//! text.add(FONT, 8.0, 8.0, "SCORE ${score}", true)   // at the screen's own pixels
//! ```
//!
//! **A font is a grid of glyphs in the sprite art**: `columns` a row from (`sheet_x`,
//! `sheet_y`), every glyph the same size, the first showing the character `first` (a space,
//! unless the font says otherwise) and each after it the next — so the printable ASCII is 96
//! glyphs in six rows of sixteen, and a font of digits alone is ten glyphs from `'0'`. A
//! character the font has no glyph for takes its place but draws nothing, or its capital where
//! the font has only capitals; a newline starts a line below the first.
//!
//! **Text at the screen's own pixels** (`unscaled`) is drawn sharp over art the screen scales
//! up (`screen.set_art_scale`), its place counted in `screen.full_width()` × `full_height()`,
//! from a font drawn at the screen's resolution: the HUD of a 1080p game whose world is pixel
//! art at 5. Unscaled or not, letters are sprites: drawn in front of what is added after them,
//! and `front` (the default) in front of the planes' front cells too.
//!
//! **A text box** ([TextBox]) types a line of dialogue out a letter at a time, as
//! `std.genesis.text`'s does — the same fields and calls, so a game's talk ports between the
//! two: a box `width` × `height` glyphs from (`x`, `y`), the font's space glyph filling it, its
//! words inside a glyph's margin, wrapped at the word that would pass its right edge and cut at
//! its last line. Like the Genesis's it is given its words at every call. Unlike it, it is
//! drawn every frame ([TextBox.draw]), as everything here is.
//!
//! ```
//! var talk = TextBox { x: 8.0, y: 160.0, width: 30, height: 5, font: FONT }
//! talk.open()
//! talk.update(HELLO)                                    // each update
//! if pad.pressed(buttons, before, pad.A) { talk.advance(HELLO) }
//! talk.draw()                                           // each frame, with the sprites
//! ```

import std.game.screen
import std.game.sprites
import std.game.sprites.{ Sprite }

/// A font in the sprite art: a grid of glyphs alike in size, in order from `first`.
pub struct Font {
  /// Its first glyph's top-left in the sprite art.
  sheet_x: f32 = 0.0,
  sheet_y: f32 = 0.0,
  /// A glyph's size, in the art's pixels.
  glyph_width: f32,
  glyph_height: f32,
  /// Glyphs a row of the grid, and in all.
  columns: i64,
  count: i64,
  /// Pixels between one glyph and the next in the art, across and down: a gutter round each.
  gap: f32 = 0.0,
  /// The character the first glyph shows: a space unless said otherwise.
  first: i64 = 32,
  /// Pixels between one letter and the next, and one line and the next.
  spacing: f32 = 0.0,
  line_spacing: f32 = 0.0,
}

/// `words` in `font` with its first letter's top-left at (`x`, `y`), added to the sprite list:
/// at the screen's own pixels when `unscaled`, its colours multiplied by `tint` (`0xRRGGBB`)
/// and `alpha`. Answers how wide it was drawn — its widest line.
pub let add = (
  font: Font,
  x: f32,
  y: f32,
  words: string,
  unscaled: bool = false,
  tint: u32 = 0xFFFFFF,
  alpha: f32 = 1.0,
  front: bool = true
) -> f32 => {
  var across: f32 = 0.0
  var down: f32 = 0.0
  for c in words {
    let code = i64(c)
    if code == 10 {
      across = 0.0
      down += font.glyph_height + font.line_spacing
      continue
    }
    let glyph = font.glyph_of(code)
    if glyph >= 0 {
      sprites.add(Sprite {
        x: x + across,
        y: y + down,
        width: font.glyph_width,
        height: font.glyph_height,
        sheet_x: font.sheet_x + f32(glyph % font.columns) * (font.glyph_width + font.gap),
        sheet_y: font.sheet_y + f32(glyph / font.columns) * (font.glyph_height + font.gap),
        front: front,
        alpha: alpha,
        tint: tint,
        unscaled: unscaled,
      })
    }
    across += font.glyph_width + font.spacing
  }
  width(font, words)
}

/// `words` in `font` kept to a place on the screen as its size changes — a HUD's: `across`
/// and `down` in halves, 0 against the left (or top) edge, 1 the middle, 2 against the right
/// (or bottom) — then moved by (`x`, `y`), right and down. The screen is `full_width()` ×
/// `full_height()` when `unscaled`, else `width()` × `height()`, the art's. As [add]
/// otherwise; whole pixels, so a line in the middle stays sharp.
pub let add_at = (
  font: Font,
  words: string,
  across: i64,
  down: i64,
  x: f32,
  y: f32,
  unscaled: bool = false,
  tint: u32 = 0xFFFFFF,
  alpha: f32 = 1.0
) -> f32 => {
  let wide = f32(if unscaled { screen.full_width() } else { screen.width() })
  let high = f32(if unscaled { screen.full_height() } else { screen.height() })
  let left = f32(((wide - width(font, words)) * f32(across) / 2.0).floor()) + x
  let top = f32(((high - height(font, words)) * f32(down) / 2.0).floor()) + y
  add(font, left, top, words, unscaled, tint, alpha)
}

/// How wide `words` is in `font`, its widest line: what [add] would draw, to place it — right
/// against the screen's edge, or in the middle.
pub let width = pure (font: Font, words: string) -> f32 => {
  var widest: i64 = 0
  var letters: i64 = 0
  for c in words {
    if i64(c) == 10 {
      letters = 0
    } else {
      letters += 1
      widest = widest.max(letters)
    }
  }
  if widest == 0 { 0.0 } else {
    f32(widest) * font.glyph_width + f32(widest - 1) * font.spacing
  }
}

/// How high `words` is in `font`: its lines, and the spacing between them.
pub let height = pure (font: Font, words: string) -> f32 => {
  var lines: i64 = 1
  for c in words {
    if i64(c) == 10 { lines += 1 }
  }
  f32(lines) * font.glyph_height + f32(lines - 1) * font.line_spacing
}

impl Font {
  /// The glyph showing character `code`, or its capital where only that is in the font; -1
  /// for none.
  pub let glyph_of = pure (self, code: i64) -> i64 => {
    let at = code - self.first
    if at >= 0 && at < self.count { return at }
    let capital = code - 32 - self.first
    if code >= 97 && code <= 122 && capital >= 0 && capital < self.count { capital } else { -1 }
  }
}

/// A box of dialogue: `width` × `height` glyphs of `font` from (`x`, `y`) — in the screen's
/// own pixels when `unscaled` — filled with its space glyph, its words typed inside a glyph's
/// margin, a letter every `frames` updates. The rest is its own: where it has got to.
pub struct TextBox {
  x: f32,
  y: f32,
  width: i64,
  height: i64,
  font: Font,
  frames: i64 = 2,
  unscaled: bool = false,
  typed: i64 = 0,
  tick: i64 = 0,
  column: i64 = 0,
  row: i64 = 0,
  shown: bool = false,
  done: bool = false,
  /// Each letter typed: its column and row inside the margin, and its character.
  letters: [](i64, i64, i64) = [],
}

impl TextBox {
  /// The box shown, empty, to type a line from its start.
  pub let open = (self: mut) -> void => {
    self.typed = 0
    self.tick = 0
    self.column = 0
    self.row = 0
    self.letters = []
    self.shown = true
    self.done = false
  }

  /// An update of typing `words`: the next letter once every `frames` updates, until all are
  /// in. Call it every update the box is open, with the same words.
  pub let update = (self: mut, words: string) -> void => {
    if !self.shown || self.done { return }
    self.tick += 1
    if self.tick < self.frames.max(1) { return }
    self.tick = 0
    self.type_letter(words)
  }

  /// The rest of `words` typed at once.
  pub let finish = (self: mut, words: string) -> void => {
    while self.shown && !self.done { self.type_letter(words) }
  }

  /// What a press to go on does: the rest typed while it is typing, else the box shut.
  pub let advance = (self: mut, words: string) -> void => {
    if !self.shown { return }
    if self.done { self.close() } else { self.finish(words) }
  }

  /// The box shut: drawn no more.
  pub let close = (self: mut) -> void => {
    self.shown = false
    self.done = false
    self.letters = []
  }

  /// Whether the box is showing, and whether it is still typing.
  pub let is_open = pure (self) -> bool => self.shown

  pub let typing = pure (self) -> bool => self.shown && !self.done

  /// The box and the letters typed so far added to the sprite list — each frame it is open.
  pub let draw = (self) -> void => {
    if !self.shown { return }
    let step_x = self.font.glyph_width + self.font.spacing
    let step_y = self.font.glyph_height + self.font.line_spacing
    // The letters first: a sprite added earlier is drawn in front.
    for (column, row, code) in self.letters {
      let glyph = self.font.glyph_of(code)
      if glyph >= 0 {
        self.glyph_at(
          glyph,
          self.x + f32(column + 1) * step_x,
          self.y + f32(row + 1) * step_y
        )
      }
    }
    let space = self.font.glyph_of(32)
    if space >= 0 {
      for row in 0..<self.height {
        for column in 0..<self.width {
          self.glyph_at(space, self.x + f32(column) * step_x, self.y + f32(row) * step_y)
        }
      }
    }
  }

  /// Glyph `glyph` of the font added at (`x`, `y`).
  let glyph_at = (self, glyph: i64, x: f32, y: f32) -> void => {
    let f = self.font
    sprites.add(Sprite {
      x: x,
      y: y,
      width: f.glyph_width,
      height: f.glyph_height,
      sheet_x: f.sheet_x + f32(glyph % f.columns) * (f.glyph_width + f.gap),
      sheet_y: f.sheet_y + f32(glyph / f.columns) * (f.glyph_height + f.gap),
      front: true,
      unscaled: self.unscaled,
    })
  }

  /// The next letter of `words` into the box, as `std.genesis.text`'s box places it: wrapped
  /// at a word that would pass the right edge, a newline starting a line, and the box done at
  /// its end or its last line.
  let type_letter = (self: mut, words: string) -> void => {
    let inner_width = self.width.max(3) - 2
    let inner_height = self.height.max(3) - 2
    var k = 0
    var letter = -1
    var word_after = 0
    for c in words {
      if letter >= 0 {
        let code = i64(c)
        if code == 32 || code == 10 { break }
        word_after += 1
      } else if k == self.typed {
        letter = i64(c)
      }
      k += 1
    }
    self.typed += 1
    if letter < 0 {
      self.done = true
      return
    }
    let wraps = letter == 10 || self.column >= inner_width ||
      (letter == 32 && self.column + 1 + word_after > inner_width)
    if wraps {
      self.column = 0
      self.row += 1
      if self.row >= inner_height {
        self.done = true
        return
      }
      if letter == 10 || letter == 32 { return }
    }
    self.letters.push((self.column, self.row, letter))
    self.column += 1
  }
}
