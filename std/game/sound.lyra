module std.game.sound
//! Sound effects in a modern game: the Genesis's chips — its PSG (`std.chips.sn76489`) and
//! its FM chip (`std.chips.ym2612`) — run in the game and heard through SDL, so an effect or
//! an FM instrument made in Vega is the sound it is on a Genesis, in a game for any platform
//! SDL3 runs on.
//!
//! ```
//! import std.game.sound
//!
//! assets.JUMP.play()           // an effect, by the name Vega gave it
//! // each update (60 a second):
//! assets.update_sounds()       // Vega's: sound.update(its steps, its FM patches)
//! ```
//!
//! **The playing is `std.chips.effects`'s**, as `std.genesis.sound`'s is: each update the
//! bytes and register writes it says are written to the chips, which are run for a
//! sixtieth of a second and heard at [RATE] ([Synth]). Paced by updates, not the display: a frame's sound is made
//! with its update, and the device's queue is kept a few frames deep.
//!
//! **Heard without anyone at it**: played with `--frames N --wav FILE` (as `std.game.screen`
//! plays headless), nothing is sent to a device; the sound of the first N updates is
//! written to `FILE` as a 16-bit mono WAV — how Vega's checks listen to a game, as Sheliak's
//! `--wav` lets them listen to a ROM.

import bindings.sdl3.{ init, INIT_AUDIO, AudioStream, open_audio }
import std.io.{ write_bytes }
import std.chips.effects.{ Effect, EffectStep, Player, new_player }
import std.chips.music.{ Tune, MusicData, MusicPlayer, Dac, new_music, held_by, dac_byte }
import std.chips.sn76489.{ Psg, new_psg }
import std.chips.ym2612.{ Ym2612, FmPatch, new_ym2612 }
import std.chips.resample.{ Resampler, new_resampler }

/// The rate a game's sound is heard at, in samples a second.
pub const RATE: i64 = 48000

/// The PSG's clock, as the Sega consoles feed it (their Z80's): what pitches an effect's
/// periods, so a period is the same note here.
pub const PSG_CLOCK: i64 = 3579545

impl Effect {
  /// Start the effect from its first step, in place of any its channel was playing. It is
  /// heard from the next [update].
  pub let play = (self) -> void => player.start(self)
}

/// Whether an effect is still playing.
pub let playing = () -> bool => player.playing()

impl Tune {
  /// Play the song from its start, in place of any song playing; heard from the next
  /// [update_music], under the effects.
  pub let play = (self) -> void => music.play_song(self)
}

/// Stop the song playing.
pub let stop_music = () -> void => music.stop()

/// The update's step of each effect playing, made sound: once an update. `steps` is the
/// game's table of them, and `patches` its FM instruments' (Vega's `assets.lyra` passes its
/// own).
pub let update<const N: i64, const P: i64> = (
  steps: ref [N]EffectStep,
  patches: ref [P]FmPatch
) -> void => {
  if !started { start() }
  var out: [8]u8 = #[0; 8]
  let n = player.frame(steps, out)
  var fm: [128]u8 = #[0; 128]
  let writes = player.fm_frame(steps, patches, fm)
  heard(synth.frame(out, n, fm, writes))
}

/// [update], and the song playing's tick under the effects — a channel an effect is
/// playing on the effect's (`std.chips.music`). `tables` is the game's music, and `samples`
/// its sampled instruments' bytes, which the DAC plays from.
pub let update_music<const N: i64, const P: i64, const S: i64, d> where d: MusicData = (
  steps: ref [N]EffectStep,
  patches: ref [P]FmPatch,
  tables: ref d,
  samples: ref [S]u8
) -> void => {
  if !started { start() }
  let before = held_by(player)
  var out: [8]u8 = #[0; 8]
  let n = player.frame(steps, out)
  var fm: [128]u8 = #[0; 128]
  let writes = player.fm_frame(steps, patches, fm)
  for i in 0..<n { synth.write_psg(out[i]) }
  for i in 0..<writes { synth.write_fm(fm[i * 3], fm[i * 3 + 1], fm[i * 3 + 2]) }
  var psg: [16]u8 = #[0; 16]
  var music_fm: [768]u8 = #[0; 768]
  let (bytes, music_writes) = music.frame(tables, before | held_by(player), psg, music_fm)
  for i in 0..<bytes { synth.write_psg(psg[i]) }
  for i in 0..<music_writes { synth.write_fm(
    music_fm[i * 3],
    music_fm[i * 3 + 1],
    music_fm[i * 3 + 2]
  ) }
  let dac = music.dac
  if synth.new_sample(dac) {
    let from = i64(dac.sample.first).min(samples.len())
    let to = (from + i64(dac.sample.length)).min(samples.len())
    synth.play_sample(dac, [k in from..<to | samples[k]])
  }
  synth.follow(dac)
  heard(synth.run(RATE / 60))
}

/// An update's samples to the device, or kept for the WAV.
let heard = (samples: []f32) -> void => {
  updates += 1
  if wav_path != "" {
    for s in samples { recorded.push(s) }
    if updates == wav_frames && !write_bytes(wav_path, wav(recorded, RATE)) {
      println("could not write ${wav_path}")
    }
    return
  }
  if let Some(s) = stream {
    // A queue grown past a few frames means the updates outran the device: drop the
    // frame's sound rather than fall further behind.
    if s.queued_frames() < QUEUE_LIMIT { let _ = s.put_audio(samples) }
  }
}

/// The NTSC Genesis's master clock, on which the chips are run together: the PSG ticks
/// every 240 of its clocks (its 3.58 MHz over 16), the YM2612 cycles every 42 (its 7.67 MHz
/// over 6) and makes a sample every 24 cycles.
pub const MASTER_CLOCK: i64 = 53693175

/// The PSG and the YM2612 heard: both chips run on one clock from what is written to them,
/// each resampled by area to [RATE], mixed at Furnace's balance ([FM_SCALE], [PSG_SCALE]) — and
/// the DC taken out: mono, -1 to 1. `std.game.sound` plays through one; an editor may
/// preview through its own ([run] for as long as it likes, [write_fm] a note at a time).
///
/// **The YM2612 is run only once written to**: until then its time passes as silence, so a
/// game of PSG effects alone pays nothing for it.
pub struct Synth {
  psg: Psg,
  ym: Ym2612,
  psg_out: Resampler,
  fm_out: Resampler,
  /// Master clocks: how far output has been asked for, and how far each chip has run.
  now: f64 = 0.0,
  psg_clock: i64 = 0,
  ym_clock: i64 = 0,
  ym_used: bool = false,
  /// The YM2612's sample being summed, a cycle at a time.
  sum_l: i64 = 0,
  sum_r: i64 = 0,
  /// Each chip's resampled output not yet mixed with the other's.
  psg_heard: []f64 = [],
  fm_heard: []f64 = [],
  /// The DC blocker's last input and output.
  dc_in: f64 = 0.0,
  dc_out: f64 = 0.0,
  /// The sample the DAC plays ([play_sample]): its bytes, where in them, from where it
  /// loops (-1 not), the note it was started for; its rate (bytes a second) and level, and
  /// master clocks owed towards its next byte.
  dac_bytes: []u8 = [],
  dac_at: i64 = 0,
  dac_loop: i64 = -1,
  dac_note: u16 = 0,
  dac_rate: i64 = 0,
  dac_level: i16 = 15,
  dac_period: i64 = 0,
  dac_playing: bool = false,
}

/// Silent chips, heard at [RATE].
pub let new_synth = pure () -> Synth => Synth {
  psg: new_psg(),
  ym: new_ym2612(),
  psg_out: new_resampler(f64(PSG_TICK), f64(MASTER_CLOCK) / f64(RATE)),
  fm_out: new_resampler(f64(YM_CYCLE * 24), f64(MASTER_CLOCK) / f64(RATE)),
}

impl Synth {
  /// The first `n` of `bytes` written to the PSG and the first `writes` of `fm` to the
  /// YM2612 (three bytes each: bank, register, value), then a sixtieth of a second of
  /// their sound.
  pub let frame = (
    self: mut,
    bytes: [8]u8,
    n: i64,
    fm: [128]u8 = #[0; 128],
    writes: i64 = 0
  ) -> []f32 => {
    for i in 0..<n.min(8) { self.psg.write(bytes[i]) }
    for i in 0..<writes.min(42) { self.write_fm(fm[i * 3], fm[i * 3 + 1], fm[i * 3 + 2]) }
    self.run(RATE / 60)
  }

  /// A byte written to the PSG.
  pub let write_psg = (self: mut, value: u8) -> void => self.psg.write(value)

  /// `value` written to register `reg` of the YM2612's bank `bank` (0 or 1) — as a driver
  /// writes one: the address, then the data, then a wait while the chip is busy, which takes
  /// its time.
  pub let write_fm = (self: mut, bank: u8, reg: u8, value: u8) -> void => {
    // Its time until now was silence, a sample at a time: it runs on from there.
    self.ym_used = true
    self.ym.write((bank & 1) * 2, reg)
    for _ in 0..<2 { self.ym_cycle() }
    self.ym.write((bank & 1) * 2 + 1, value)
    // The busy flag rises a cycle or two after the data — waiting only while it is up, from
    // the first cycle, waited for nothing, and the next address dropped a value still held
    // for its operator's slot. Then it holds 32 cycles, which every slot comes round in.
    var waited = 0
    while waited < BUSY_RISES || (self.ym.busy && waited < 64) {
      self.ym_cycle()
      waited += 1
    }
  }

  /// Whether `dac` (`std.chips.music`'s [Dac]) has a note this synth has not started: then
  /// its sample's bytes go to [play_sample].
  pub let new_sample = pure (self: ref, dac: Dac) -> bool => dac.note != self.dac_note

  /// `bytes`, `dac`'s sample, played on the DAC from its first, as [follow] says.
  pub let play_sample = (self: mut, dac: Dac, bytes: []u8) -> void => {
    self.dac_note = dac.note
    self.dac_bytes = bytes
    self.dac_at = 0
    self.dac_loop = if dac.sample.loop_at >= 0 && i64(dac.sample.loop_at) < bytes.len() { i64(dac.sample.loop_at) } else { -1 }
    self.dac_period = 0
    self.follow(dac)
  }

  /// The DAC's sample at `dac`'s rate and level, or stopped where it is not playing — as
  /// Furnace plays one: a byte each time the rate's share of a chip sample comes round, and
  /// the last held when it ends.
  pub let follow = (self: mut, dac: Dac) -> void => {
    self.dac_rate = i64(dac.rate)
    self.dac_level = dac.level
    self.dac_playing = dac.playing && self.dac_at < self.dac_bytes.len()
    // The DAC's time until now was silence, as an FM write's is.
    if self.dac_playing { self.ym_used = true }
  }

  /// The next `samples` samples of both chips' sound — fewer by one now and then, as the
  /// resampling falls.
  pub let run = (self: mut, samples: i64) -> []f32 => {
    self.now += f64(samples) * f64(MASTER_CLOCK) / f64(RATE)
    let target = self.now.floor()
    while self.psg_clock + PSG_TICK <= target {
      self.psg.tick()
      var level: i64 = 0
      for channel in 0..<4 { level += self.psg.channel_level(channel) }
      let v = f64(level) / PSG_SCALE
      self.psg_out.push(v, v, self.psg_heard)
      self.psg_clock += PSG_TICK
    }
    while self.ym_clock + YM_CYCLE <= target {
      if self.ym_used {
        self.ym_cycle()
      } else {
        // Silence a whole sample at a time.
        self.fm_out.push(0.0, 0.0, self.fm_heard)
        self.ym_clock += YM_CYCLE * 24
      }
    }
    let pairs = self.psg_heard.len().min(self.fm_heard.len()) / 2
    var out: []f32 = []
    for k in 0..<pairs {
      let x = self.psg_heard[2 * k] + (self.fm_heard[2 * k] + self.fm_heard[2 * k + 1]) / 2.0
      let y = x - self.dc_in + 0.9987 * self.dc_out
      self.dc_in = x
      self.dc_out = y
      out.push(f32(y.clamp(-1.0, 1.0)))
    }
    self.psg_heard = self.psg_heard.slice(2 * pairs, self.psg_heard.len())
    self.fm_heard = self.fm_heard.slice(2 * pairs, self.fm_heard.len())
    out
  }

  /// One YM2612 cycle, its output summed into the sample under way, which is resampled when
  /// its 24 cycles are done.
  let ym_cycle = (self: mut) -> void => {
    self.ym.clock()
    self.sum_l += self.ym.out_l
    self.sum_r += self.ym.out_r
    if self.ym.cycle == 0 {
      if self.dac_playing { self.dac_step() }
      self.fm_out.push(
        f64(self.sum_l) / FM_SCALE,
        f64(self.sum_r) / FM_SCALE,
        self.fm_heard
      )
      self.sum_l = 0
      self.sum_r = 0
    }
    self.ym_clock += YM_CYCLE
  }
}

/// `samples` (mono, -1 to 1, at `rate`) as a 16-bit WAV file's bytes.
pub let wav = pure (samples: []f32, rate: i64) -> []u8 => {
  let data = samples.len() * 2
  var out: []u8 = [
    ..."RIFF".encode_utf8(), ...le32(36 + data), ...("WAVE".encode_utf8()),
    ...("fmt ".encode_utf8()), ...le32(16), ...le16(1), ...le16(1), ...le32(rate),
    ...le32(rate * 2), ...le16(2), ...le16(16),
    ...("data".encode_utf8()), ...le32(data),
  ]
  for s in samples {
    let v = i64((f64(s) * 32767.0).round()) & 0xFFFF
    out.push(u8(v & 0xFF))
    out.push(u8(v >> 8))
  }
  out
}

impl Synth {
  /// A chip sample's worth of the DAC's: its rate's share of a byte, and the next byte
  /// written (register `2A`) when a whole one has come round — at most one a chip sample.
  let dac_step = (self: mut) -> void => {
    self.dac_period += self.dac_rate * YM_CYCLE * 24
    if self.dac_period < MASTER_CLOCK { return }
    while self.dac_period >= MASTER_CLOCK { self.dac_period -= MASTER_CLOCK }
    self.ym.set_dac(dac_byte(self.dac_bytes[self.dac_at], self.dac_level))
    self.dac_at += 1
    if self.dac_at >= self.dac_bytes.len() {
      if self.dac_loop >= 0 {
        self.dac_at = self.dac_loop
      } else {
        self.dac_playing = false
      }
    }
  }
}

// ── Beneath ──────────────────────────────────────────────────────────────────────────

/// Master clocks a PSG tick, and a YM2612 cycle.
const PSG_TICK: i64 = 240
const YM_CYCLE: i64 = 42

/// What the chips' outputs are divided by to be heard: the PSG's summed levels, and the
/// YM2612's a sample (24 cycles of both outputs). Set against Furnace's mix of the two
/// (10/15): a full channel of either well under 1, and a song of all ten clear of clipping —
/// FM at 1536 and the PSG at 65536 clipped, the FM 1.4 times as loud as Furnace's.
const PSG_SCALE: f64 = 100000.0
const FM_SCALE: f64 = 2200.0

/// YM2612 cycles after a data write by which its busy flag is up.
const BUSY_RISES: i64 = 3

/// The most samples kept queued for the device: six frames.
const QUEUE_LIMIT: i64 = 4800

var player: Player = new_player()
var music: MusicPlayer = new_music()
var synth: Synth = new_synth()
var stream: Maybe<AudioStream> = None
var started = false
var updates: i64 = 0
/// Played with `--wav`: where, after how many updates, and what has been heard.
var wav_path: string = ""
var wav_frames: i64 = 0
var recorded: []f32 = []

/// The first update: `--frames N --wav FILE` read, or the device opened — none (a headless
/// machine) is silence, not a failure.
let start = () -> void => {
  started = true
  let args = program_args()
  var i = 1
  while i + 1 < args.len() {
    if args[i] == "--wav" { wav_path = args[i + 1] }
    if args[i] == "--frames" { wav_frames = args[i + 1].parse_i64().unwrap_or(0) }
    i += 1
  }
  if wav_path != "" { return }
  if init(INIT_AUDIO) { stream = open_audio(i32(RATE), 1) }
}

let le16 = pure (v: i64) -> []u8 => [u8(v & 0xFF), u8((v >> 8) & 0xFF)]

let le32 = pure (v: i64) -> []u8 => [...le16(v & 0xFFFF), ...le16((v >> 16) & 0xFFFF)]
