module std.game.palette
//! `std.genesis.palette`'s fades for every modern platform: the whole screen faded to a
//! colour and back, waiting for it, as a Genesis game fades its 64 colours.
//!
//! ```
//! import std.game.palette
//!
//! palette.fade_to(0x000000, 30)   // half a second to black, the frame shown each update
//! palette.fade_back(30)           // and back
//!
//! palette.start_fade_to(0x000000, 30)   // or a step an update, the game going on:
//! let over = palette.step_fade()        // once an update; true once it is over
//! ```
//!
//! A modern game's art is coloured when it is built, so its colours are not the game's to
//! turn: the fade is the colour drawn over the frame (`screen.set_fade`), which looks the same.
//!
//! **Colour cycles** turn a run of a palette's colours a step every so many updates, as
//! `std.genesis.palette`'s do — water flowing, a star twinkling — by colours of the art
//! replaced (`std.game.raster.set_cycled`): the art has no palette, so the cycles' colours
//! come with them.
//!
//! ```
//! palette.step_cycles(PALETTE_CYCLES, CYCLE_COLORS)   // once an update
//! ```

import std.game.screen
import std.game.raster

/// A run of palette `palette`'s colours turning: `count` of them, from `first` in the table
/// of the cycles' colours [step_cycles] is given, a step every `frames` updates moving each
/// one place on — the last to the first — or back. Vega writes a project's as
/// `PALETTE_CYCLES`, their colours as `CYCLE_COLORS`.
pub struct Cycle {
  palette: i64,
  first: i64,
  count: i64,
  frames: i64,
  backward: bool = false,
}

/// Each of `cycles` a step on where its frames have passed since the last: once an update —
/// Vega's scenes call it from `scroll_maps`. `colors` is the cycles' colours (`0xRRGGBB`), as
/// the art was drawn in them; from the next frame each shows the one its steps have turned to
/// its place. A cycle has stepped as many times as its frames go into the updates so far, as
/// a Genesis game's has in its frames.
pub let step_cycles<const N: i64, const M: i64> = (
  cycles: ref [N]Cycle,
  colors: ref [M]u32
) -> void => {
  cycle_ticks += 1
  var replaced: [](i64, u32, u32) = []
  for c in cycles {
    if c.count < 2 || c.frames < 1 || c.first < 0 || c.first + c.count > M { continue }
    let steps = (cycle_ticks / c.frames) % c.count
    if steps == 0 { continue }
    for k in 0..<c.count {
      // Turned on, a place shows the colour `steps` before it; turned back, the one after.
      let shown = if c.backward { (k + steps) % c.count } else { (k - steps + c.count) % c.count }
      let from = colors[c.first + k] & 0xFFFFFF
      let to = colors[c.first + shown] & 0xFFFFFF
      if from != to { replaced.push((c.palette, from, to)) }
    }
  }
  raster.set_cycled(replaced)
}

/// The whole screen from how it shows to `color` (`0xRRGGBB`) over `updates` updates, the
/// frame shown each, returning once it is there: to black, to white, or a flash of a colour.
pub let fade_to = (color: u32, updates: i64) -> void => {
  fade_color = color
  fade(1.0, updates)
}

/// The screen back from the last [fade_to]'s colour over `updates` updates, returning once it
/// is clear.
pub let fade_back = (updates: i64) -> void => fade(0.0, updates)

/// A fade that does not wait: [fade_to]'s begun, each step taken by [step_fade] once an update
/// — what a cutscene fades by while the game goes on.
pub let start_fade_to = (color: u32, updates: i64) -> void => {
  fade_color = color
  begin(1.0, updates)
}

/// [fade_back]'s begun, each step taken by [step_fade].
pub let start_fade_back = (updates: i64) -> void => begin(0.0, updates)

/// A step of the fade begun ([start_fade_to], [start_fade_back]), drawn with the next frame.
/// Whether it is over — at once where none was begun.
pub let step_fade = () -> bool => {
  if fade_step >= fade_steps { return true }
  fade_step += 1
  screen.set_fade(
    fade_color,
    fade_from + (fade_goal - fade_from) * f32(fade_step) / f32(fade_steps)
  )
  fade_step >= fade_steps
}

// ── Beneath ──────────────────────────────────────────────────────────────────────────

/// The colour the last [fade_to] faded to.
var fade_color: u32 = 0

/// The fade under way ([start_fade_to], [start_fade_back]): from how far the frame was faded
/// to `fade_goal`, `fade_steps` steps, of which `fade_step` are taken.
var fade_from: f32 = 0.0
var fade_goal: f32 = 0.0
var fade_step: i64 = 0
var fade_steps: i64 = 0

/// A fade begun from how far the frame is faded now to `to`, over `updates` updates.
let begin = (to: f32, updates: i64) -> void => {
  fade_from = screen.faded()
  fade_goal = to
  fade_steps = updates.max(1)
  fade_step = 0
}

/// The fade from where it is to `to` over `updates` updates, shown as it goes.
let fade = (to: f32, updates: i64) -> void => {
  let from = screen.faded()
  let steps = updates.max(1)
  var k = 0
  while k < steps && screen.running() {
    for _ in 0..<screen.updates_due() {
      if k < steps { k += 1 }
    }
    screen.set_fade(fade_color, from + (to - from) * f32(k) / f32(steps))
    screen.show()
  }
  screen.set_fade(fade_color, to)
}

/// Updates [step_cycles] has counted.
var cycle_ticks: i64 = 0
