module std.game.entity
//! The things a game is made of — a hero, a star, an enemy — as kinds and the entities of
//! them: `std.genesis.entity`'s, in `f32` pixels, for every modern platform.
//!
//! ```
//! import std.game.entity.{ Entity }
//!
//! var hero = assets.HERO.spawn(160.0, 208.0)    // Vega's entity editor makes the kind
//! loop {
//!   hero.push(dx, dy)                            // the pad: -1, 0 or 1 a direction
//!   hero.move_in_field()                         // assets: through the map, stopped by walls
//!   hero.play(assets.HERO_WALK, view, facing_left) // assets: shown, into the sprite list
//!   if hero.meets(star) { … }
//! }
//! ```
//!
//! **A kind is data, an entity is its instance.** An [EntityKind] — usually a constant
//! Vega writes (`assets.HERO`) — holds a sprite's size, the animation it starts with, its
//! [Collider]s and its motion; an [Entity] is one of it in the game, the kind copied in.
//! What needs the game's own tables — drawing a sprite, a map's cells — is the game's
//! assets', which pass them here ([move_in]).
//!
//! **Speeds are pixels an update**, 60 updates a second (`std.game.screen`): the kind's top
//! speed, acceleration, friction and gravity, and an entity's `vx` and `vy`. A place is any
//! `f32`, so an entity moves by fractions of a pixel; it is drawn at whole ones.
//!
//! **A kind's colliders may change by frame** (`EntityKind.frame_shapes`), as in
//! `std.genesis.entity`.
//!
//! **Meeting is one-sided**, as `std.game.collision` says: `a.meets(b)` asks whether a
//! collider of `a` looks for a layer one of `b`'s is on, whatever `b` looks for.
//!
//! **An entity turns and grows about its middle** (`angle` in degrees, `scale`), as a modern
//! sprite does: its colliders grow with it, but keep their shapes as it turns — a box turned is
//! no box, and a game of this kind seldom wants one. Grown against a map, its colliders follow
//! once that would not put one into a wall, as turning to face the other way does.
//!
//! **Drawn smoothly between updates**: shown at a place on the screen ([shown_at], which
//! Vega's `draw` calls), an entity marks its sprites as coming from where it was shown the
//! update before, and `std.game.screen` draws them sliding between the two. Put somewhere
//! ([place]), it does not slide there.

import std.game.collision.{ Shape, Collider, TILE }
import std.game.sprites

/// An animation of a sprite: where its steps are in the game's step table, how many, how
/// long they take in all (updates, 1/60 s), and whether it goes round. The game's assets
/// play one (Vega's `assets.lyra`); here it is only carried.
pub struct Animation {
  /// Which sprite (its place in the project), and its steps.
  sprite: i64,
  first: i64,
  count: i64,
  total: i64,
  /// Back to the start after the end; else the last step holds.
  looping: bool,
}

/// The most colliders a kind has: a kind is copied into each of its entities, so its
/// colliders are a fixed array, the unused ones empty.
pub const MAX_COLLIDERS: i64 = 4

/// A collider of no shape, on no layer and looking for none: what fills a kind's unused
/// collider places.
pub const NO_COLLIDER: Collider = Collider {
  shape: Shape { x: 0.0, y: 0.0, width: 0.0, height: 0.0 },
  layers: 0,
  mask: 0
}

/// What a kind's `frame_shapes` is when its colliders keep their shapes.
pub const NO_FRAME_SHAPES: i64 = -1

/// A kind of thing in the game: its sprite's size, what it shows when spawned, what it
/// collides by, and how it moves — its top speed, the speed it gains an update while
/// pushed, loses an update while not, and gains downwards an update from gravity, in pixels.
pub struct EntityKind {
  width: f32,
  height: f32,
  animation: Animation,
  /// The first `collider_count` of `colliders` are its own.
  colliders: [4]Collider,
  collider_count: i64,
  max_speed: f32,
  acceleration: f32,
  friction: f32,
  gravity: f32,
  /// How fast a [jump] leaves the floor, upwards, in pixels an update; 0, it does not jump.
  /// Vega works it out from the entity's jump height and gravity.
  jump_speed: f32 = 0.0,
  /// Where its rows start in the game's table of shapes by frame (`assets.FRAME_SHAPES`): a
  /// row a frame of its sprite, a shape a collider. [NO_FRAME_SHAPES] when its colliders
  /// keep their shapes.
  frame_shapes: i64 = NO_FRAME_SHAPES,
  /// The row of the frame it starts on: the shapes a map stops it by ([use_steady_shapes]).
  steady_shapes: i64 = NO_FRAME_SHAPES,
}

/// An entity: one of a kind in the game, where it is and how fast it is going, what it
/// shows, and which way it faces.
pub struct Entity {
  kind: EntityKind,
  /// How fast it scrolls with the view: 1.0 with it, 0.0 fixed to the screen.
  parallax_x: f32 = 1.0,
  parallax_y: f32 = 1.0,
  /// Its top-left in the world, in pixels.
  fx: f32,
  fy: f32,
  /// Its speed an update — the game may set it (a jump, a knock back).
  vx: f32,
  vy: f32,
  /// What it shows and how many updates in.
  animation: Animation,
  tick: i64,
  /// Whether it faces the other way, which mirrors its colliders too.
  mirrored: bool,
  /// Which way its colliders face against a map: `mirrored`'s once turning would not put
  /// one into a tile it looks for — turning beside a wall must not push it in.
  hit_mirrored: bool,
  /// Turned clockwise about its middle, in degrees: its picture only, as its colliders keep
  /// their shapes.
  angle: f32 = 0.0,
  /// Drawn this many times its size about its middle, and its colliders with it.
  scale: f32 = 1.0,
  /// How big its colliders are against a map: `scale`'s once growing would not put one into
  /// a tile it looks for, as [hit_mirrored] follows turning.
  hit_scale: f32 = 1.0,
  /// Drawn this frame: the game's assets set it as they draw it (`play`, `draw`), and a
  /// scene's `draw` skips it and clears it, so an entity played is not drawn twice.
  drawn: bool = false,
  /// The row of the game's shapes by frame it shows ([show_frame_shapes]).
  shown_row: i64 = NO_FRAME_SHAPES,
  /// Where on the screen it was last shown ([shown_at]), and in which update
  /// (`sprites.updates`; -1, none to slide from).
  shown_x: f32 = 0.0,
  shown_y: f32 = 0.0,
  shown_in: i64 = -1,
  /// How far it was from where it was shown last, the update before — what its sprites
  /// slide from — when `trailing`.
  trail_x: f32 = 0.0,
  trail_y: f32 = 0.0,
  trailing: bool = false,
  /// Standing on something: its last move in a map was a fall stopped — by a tile, a map's
  /// own collider, or the map's bottom edge ([move_in]). What [jump] asks.
  on_floor: bool = false,
  /// Where its last move started, its top-left in the world: what [blocked_by] backs it off
  /// a solid towards.
  was_x: f32 = 0.0,
  was_y: f32 = 0.0,
  /// Crushed: after its scene's `block`, still inside a solid or the map's collision — a
  /// solid's push ([blocked_by]) shoved it into a wall or another solid. The game decides
  /// what that means (hurt it, stop the solid); `block` sets it each time it runs.
  squeezed: bool = false,
}

/// The fastest an entity falls, in pixels an update: a tile, so a fall never steps over a
/// tile it should land on.
pub const MAX_FALL: f32 = 8.0

impl Entity {
  /// Its top-left in the world, in pixels.
  pub let x = pure (self: ref) -> f32 => self.fx
  pub let y = pure (self: ref) -> f32 => self.fy

  /// Put it with its top-left at (`x`, `y`), its speed kept — drawn there at once, not
  /// sliding from where it was.
  pub let place = (self: mut, x: f32, y: f32) -> void => {
    self.fx = x
    self.fy = y
    self.shown_in = -1
  }

  /// Shown this update at (`sx`, `sy`) on the screen, its sprites added from `first`
  /// (`sprites.listed()` before they were): they slide from where it was shown the update
  /// before — once an update, as it is drawn, whether or not it is on the screen.
  pub let shown_at = (self: mut, sx: f32, sy: f32, first: i64) -> void => {
    let now = sprites.updates()
    self.trailing = self.shown_in == now - 1
    self.trail_x = self.shown_x - sx
    self.trail_y = self.shown_y - sy
    self.shown_x = sx
    self.shown_y = sy
    self.shown_in = now
    self.trail_sprites(first)
  }

  /// Sprites added from `first` that go with it — a glow drawn beside it — sliding as it
  /// does this update ([shown_at] first).
  pub let trail_sprites = (self: ref, first: i64) -> void => {
    if self.trailing { sprites.came_from(first, self.trail_x, self.trail_y) }
  }

  /// An update's push, `dx` and `dy` each from -1 to 1 (the pad's directions, or a stick's
  /// lean): a pushed axis gains the kind's acceleration towards its top speed (times the
  /// push), one not pushed loses its friction until it stands. With gravity the vertical
  /// axis is gravity's, falling at most [MAX_FALL], and `dy` is not used — a jump sets `vy`.
  /// Once an update, before moving.
  ///
  /// **Pushed both ways at once, it goes no faster**: each axis's top speed and acceleration
  /// are the kind's over √2, so the diagonal is the top speed, not 1.4 times it.
  pub let push = (self: mut, dx: f32, dy: f32) -> void => {
    let diagonal = nonzero(dx) && nonzero(dy) && self.kind.gravity <= 0.0
    let scale: f32 = if diagonal { 0.70710678 } else { 1.0 }
    let top = self.kind.max_speed * scale
    let rate = self.kind.acceleration * scale
    self.vx = accelerate(self.vx, dx, rate, self.kind.friction, top)
    self.vy = if self.kind.gravity > 0.0 {
      (self.vy + self.kind.gravity).min(MAX_FALL)
    } else {
      accelerate(self.vy, dy, rate, self.kind.friction, top)
    }
  }

  /// Moved by its speed, an update's worth, through anything — so on no floor.
  pub let move = (self: mut) -> void => {
    self.was_x = self.fx
    self.was_y = self.fy
    self.fx += self.vx
    self.fy += self.vy
    self.on_floor = false
  }

  /// Moved by its speed, an update's worth, through anything but out of a world `width` by
  /// `height` pixels: at its edges it stops, as at a wall, and stands on the bottom one —
  /// what a level whose map has no collision moves by, so nothing leaves the map.
  pub let move_kept_in = (self: mut, width: f32, height: f32) -> void => {
    let right = (width - self.kind.width).max(0.0)
    let bottom = (height - self.kind.height).max(0.0)
    self.move()
    if self.fx < 0.0 || self.fx > right {
      self.fx = self.fx.clamp(0.0, right)
      self.vx = 0.0
    }
    if self.fy < 0.0 || self.fy > bottom {
      self.on_floor = self.vy > 0.0
      self.fy = self.fy.clamp(0.0, bottom)
      self.vy = 0.0
    }
  }

  /// Leave the floor at the kind's `jump_speed`, if it is on one ([on_floor]) and jumps at
  /// all; whether it did. Before its update's `push` and move, which take it up from there.
  pub let jump = (self: mut) -> bool => {
    if !self.on_floor || self.kind.jump_speed <= 0.0 { return false }
    self.vy = -self.kind.jump_speed
    self.on_floor = false
    true
  }

  /// Moved by its speed in a map, kept inside it: each axis on its own, and one whose move
  /// would meet a tile its colliders look for, or leave the map, stops — so it slides along
  /// a wall rather than sticking to it. Not `kept_in`, the map's edges stop nothing: it
  /// leaves where the map's collision leaves a gap, and the game decides what that means.
  /// Its colliders turn as it has once they fit. The map is `std.game.collision`'s
  /// `hits_map`'s: `cells` row by row, `width` a row, its tile set's tiles from
  /// `first_tile`, their colliders `shapes[starts[t]]` up to `starts[t + 1]`, its tiles
  /// `tile_size` pixels square.
  pub let move_in<const N: i64, const M: i64, const K: i64> = (
    self: mut,
    cells: ref [N]u32,
    width: i64,
    first_tile: u32,
    starts: ref [M]u32,
    shapes: ref [K]Collider,
    kept_in: bool = true,
    tile_size: f32 = TILE
  ) -> void =>
    self.move_in_with(
      cells,
      width,
      first_tile,
      starts,
      shapes,
      NO_BANDS,
      NO_MAP_SHAPES,
      kept_in,
      tile_size
    )

  /// [move_in], stopped too by the map's own colliders — shapes drawn on the map itself, in
  /// its pixels — gathered by band, `bands` saying where each band starts in `map_shapes`
  /// (`collision.hits_banded`; `#[0, n]` for one band of all `n`).
  ///
  /// **A one-way collider** (a tile's or the map's) stops only the vertical move, and only
  /// coming down onto it from clear above: an entity stands on it, and jumps up through it or
  /// walks across it.
  pub let move_in_with<const N: i64, const M: i64, const K: i64, const B: i64, const P: i64> = (
    self: mut,
    cells: ref [N]u32,
    width: i64,
    first_tile: u32,
    starts: ref [M]u32,
    shapes: ref [K]Collider,
    bands: ref [B]u32,
    map_shapes: ref [P]Collider,
    kept_in: bool = true,
    tile_size: f32 = TILE
  ) -> void => {
    self.was_x = self.fx
    self.was_y = self.fy
    let rows = if width > 0 { cells.len() / width } else { 0 }
    let open = !kept_in
    let right = f32(width) * tile_size - self.kind.width
    let bottom = f32(rows) * tile_size - self.kind.height
    // Turned: its colliders turn too, unless that would put one into a wall here.
    if self.hit_mirrored != self.mirrored && !self.kind.hits_tiles(
      self.fx,
      self.fy,
      self.fy,
      self.mirrored,
      self.hit_scale,
      cells,
      width,
      first_tile,
      starts,
      shapes,
      bands,
      map_shapes,
      tile_size
    ) {
      self.hit_mirrored = self.mirrored
    }
    // Grown: its colliders grow too, the same way.
    if (self.hit_scale < self.scale || self.hit_scale > self.scale) && !self.kind.hits_tiles(
      self.fx,
      self.fy,
      self.fy,
      self.hit_mirrored,
      self.scale,
      cells,
      width,
      first_tile,
      starts,
      shapes,
      bands,
      map_shapes,
      tile_size
    ) {
      self.hit_scale = self.scale
    }
    // An axis not moving is not tested.
    if nonzero(self.vx) {
      let wanted = self.fx + self.vx
      let edged = !open && (wanted < 0.0 || wanted > right)
      let nx = if edged { wanted.clamp(0.0, right) } else { wanted }
      if self.kind.hits_tiles(
        nx,
        self.fy,
        self.fy,
        self.hit_mirrored,
        self.hit_scale,
        cells,
        width,
        first_tile,
        starts,
        shapes,
        bands,
        map_shapes,
        tile_size
      ) {
        self.vx = 0.0
      } else {
        // At the map's edge it stops, as at a wall.
        if edged { self.vx = 0.0 }
        self.fx = nx
      }
    }
    // On a floor only if this update's fall is stopped.
    self.on_floor = false
    if nonzero(self.vy) {
      let wanted = self.fy + self.vy
      let edged = !open && (wanted < 0.0 || wanted > bottom)
      let ny = if edged { wanted.clamp(0.0, bottom) } else { wanted }
      if self.kind.hits_tiles(
        self.fx,
        ny,
        self.fy,
        self.hit_mirrored,
        self.hit_scale,
        cells,
        width,
        first_tile,
        starts,
        shapes,
        bands,
        map_shapes,
        tile_size
      ) {
        if self.vy > 0.0 { self.on_floor = true }
        self.vy = 0.0
      } else {
        if edged {
          if self.vy > 0.0 { self.on_floor = true }
          self.vy = 0.0
        }
        self.fy = ny
      }
    }
  }

  /// Show `animation`, facing the other way when `mirrored`: from its start when it is not
  /// what it shows now, else going on. Nothing is drawn: the game's assets' `play` sets this
  /// and draws the entity, which needs their tables.
  pub let set_animation = (
    self: mut,
    animation: Animation,
    mirrored: bool = false
  ) -> void => {
    if animation.first != self.animation.first || animation.sprite != self.animation.sprite {
      self.animation = animation
      self.tick = 0
    }
    self.mirrored = mirrored
  }

  /// Its colliders' shapes those of `frame` of its sprite, from the game's table: what the
  /// game's assets do as they draw an entity whose kind has `frame_shapes`, so what it meets
  /// is what is shown.
  pub let show_frame_shapes<const F: i64> = (
    self: mut,
    table: ref [F]Shape,
    frame: i64
  ) -> void => {
    let row = self.kind.frame_shapes + frame * self.kind.collider_count
    if row != self.shown_row {
      self.use_shapes(table, row)
      self.shown_row = row
    }
  }

  /// Before a move in a map: its colliders' shapes the steady ones, of the frame it starts on,
  /// until [use_shown_shapes]. A map stops it by these, since a shape fitted to the art moves
  /// as the art does: feet lifted on a stride let it sink to the floor, the next frame's lower
  /// ones were then inside it, and it stayed sunk (11/02, the platformer's yellow_guy).
  pub let use_steady_shapes<const F: i64> = (self: mut, table: ref [F]Shape) -> void => {
    if self.shown_row != NO_FRAME_SHAPES {
      self.use_shapes(table, self.kind.steady_shapes)
    }
  }

  /// After a move in a map: its colliders' shapes those of the frame it shows again.
  pub let use_shown_shapes<const F: i64> = (self: mut, table: ref [F]Shape) -> void => {
    if self.shown_row != NO_FRAME_SHAPES { self.use_shapes(table, self.shown_row) }
  }

  /// Whether it meets `other`: one of its colliders looks for a layer one of `other`'s is on,
  /// and their shapes overlap — each mirrored as its entity faces, and grown as it is.
  pub let meets = pure (self: ref, other: ref Entity) -> bool =>
    self.meets_at(self.fx, self.fy, other)

  /// [meets], were its top-left at (`x`, `y`).
  pub let meets_at = pure (self: ref, x: f32, y: f32, other: ref Entity) -> bool => {
    for i in 0..<self.kind.collider_count {
      let a = self.kind.placed(self.kind.colliders[i], self.mirrored, self.scale)
      for j in 0..<other.kind.collider_count {
        let b = other.kind.placed(other.kind.colliders[j], other.mirrored, other.scale)
        if a.meets(x, y, b, other.fx, other.fy) { return true }
      }
    }
    false
  }

  /// Stopped by `solid` as by a wall: an entity its move took into one — meeting it, on a
  /// layer its colliders look for — backed off it along the way it came, that axis's speed
  /// dropped; one coming down onto it stands on it ([on_floor]), and so does one resting on
  /// it. Once an update after the entity moves, for each solid it may meet: a scene's
  /// `block` does it for every character and solid Vega placed.
  ///
  /// **A solid that moved** this update (its own move, from `was_x`/`was_y`) carries an
  /// entity that started the update resting on top of it, by as far as it went; and one it
  /// moved into is pushed out ahead of it, backed off towards where it started taken along
  /// by the solid's move. A push answers only to this solid: it may push the entity into
  /// the map, or another solid — squeezed, as the game decides.
  pub let blocked_by = (self: mut, solid: ref Entity) -> void => {
    // Where it started, taken along by the solid's move: clear of the solid there.
    let dx = solid.fx - solid.was_x
    let dy = solid.fy - solid.was_y
    let wx = self.was_x + dx
    let wy = self.was_y + dy
    // Riding it: resting on it where it started — carried.
    let moved = dx < 0.0 || dx > 0.0 || dy < 0.0 || dy > 0.0
    if moved && !self.meets_at(wx, wy, solid) && self.meets_at(wx, wy + 1.0, solid) {
      self.fx += dx
      self.fy += dy
    }
    if self.meets(solid) {
      if !self.meets_at(wx, self.fy, solid) {
        self.fx = back_off(self, self.fx, wx, true, solid)
        self.vx = 0.0
      } else if !self.meets_at(self.fx, wy, solid) {
        if self.fy > wy { self.on_floor = true }
        self.fy = back_off(self, self.fy, wy, false, solid)
        self.vy = 0.0
      } else if !self.meets_at(wx, wy, solid) {
        self.fx = wx
        self.fy = wy
        self.vx = 0.0
        self.vy = 0.0
      }
    }
    // Resting on it: what it stood on is a pixel down.
    if self.vy >= 0.0 && !self.on_floor && self.meets_at(self.fx, self.fy + 1.0, solid) {
      self.on_floor = true
    }
  }

  /// Whether it is inside a map's collision where it stands: a tile, on a layer its
  /// colliders look for, meeting it as it faces — a one-way collider not counted, as it stops
  /// nothing not coming down onto it. The map as [move_in] takes it. A move never ends in
  /// one; a solid's push ([blocked_by]) can, which a scene's `block` asks this about.
  pub let in_map<const N: i64, const M: i64, const K: i64> = pure (
    self: ref,
    cells: ref [N]u32,
    width: i64,
    first_tile: u32,
    starts: ref [M]u32,
    shapes: ref [K]Collider,
    tile_size: f32 = TILE
  ) -> bool =>
    self.in_map_with(cells, width, first_tile, starts, shapes, NO_BANDS, NO_MAP_SHAPES, tile_size)

  /// [in_map], the map's own colliders counted too, as [move_in_with] takes them.
  pub let in_map_with<const N: i64, const M: i64, const K: i64, const B: i64, const P: i64> = pure (
    self: ref,
    cells: ref [N]u32,
    width: i64,
    first_tile: u32,
    starts: ref [M]u32,
    shapes: ref [K]Collider,
    bands: ref [B]u32,
    map_shapes: ref [P]Collider,
    tile_size: f32 = TILE
  ) -> bool =>
    self.kind.hits_tiles(
      self.fx,
      self.fy,
      self.fy,
      self.hit_mirrored,
      self.hit_scale,
      cells,
      width,
      first_tile,
      starts,
      shapes,
      bands,
      map_shapes,
      tile_size
    )

  /// Its colliders' shapes `table`'s row `row`.
  let use_shapes<const F: i64> = (self: mut, table: ref [F]Shape, row: i64) -> void => {
    for i in 0..<self.kind.collider_count {
      self.kind.colliders[i].shape = table[row + i]
    }
  }
}

impl EntityKind {
  /// An entity of this kind with its top-left at (`x`, `y`) in the world, still, showing
  /// what the kind starts with.
  pub let spawn = pure (self, x: f32, y: f32) -> Entity => Entity {
    kind: self,
    fx: x,
    fy: y,
    was_x: x,
    was_y: y,
    vx: 0.0,
    vy: 0.0,
    animation: self.animation,
    tick: 0,
    mirrored: false,
    hit_mirrored: false,
  }

  /// Whether an entity of this kind moved to (`x`, `y`) from (`x`, `from_y`), mirrored or
  /// not and grown `scale` times, is stopped by a tile of the map, or one of the map's own colliders, on a layer one
  /// of its colliders looks for (a one-way collider only from above). A move across, or no
  /// move, passes `from_y` = `y`, which no one-way collider stops.
  let hits_tiles<const N: i64, const M: i64, const K: i64, const B: i64, const P: i64> = pure (
    self: ref,
    x: f32,
    y: f32,
    from_y: f32,
    mirrored: bool,
    scale: f32,
    cells: ref [N]u32,
    width: i64,
    first_tile: u32,
    starts: ref [M]u32,
    shapes: ref [K]Collider,
    bands: ref [B]u32,
    map_shapes: ref [P]Collider,
    tile_size: f32 = TILE
  ) -> bool => {
    // Tiles that carry no shapes — a map whose collision is its own — are not walked.
    let tiled = starts[starts.len() - 1] != 0
    for i in 0..<self.collider_count {
      let held = self.placed(self.colliders[i], mirrored, scale)
      if tiled && held.hits_map_moving(
        x,
        y,
        from_y,
        cells,
        width,
        first_tile,
        starts,
        shapes,
        tile_size
      ) {
        return true
      }
      if held.hits_banded_moving(x, y, from_y, bands, map_shapes) { return true }
    }
    false
  }
}

impl EntityKind {
  /// One of its colliders as an entity of the kind has it: mirrored as it faces, grown as it is.
  let placed = pure (self: ref, c: Collider, mirrored: bool, scale: f32) -> Collider => {
    let facing = if mirrored { c.mirrored(self.width) } else { c }
    if scale >= 1.0 && scale <= 1.0 { facing } else { facing.scaled(
      scale,
      self.width,
      self.height
    ) }
  }
}

// ── Beneath ──────────────────────────────────────────────────────────────────────────

/// Where `entity`, at `at` along one axis (`across`, else up or down) and meeting `solid`,
/// clears it stepping towards `was`, a pixel at a time, where it did not meet it.
let back_off = pure (
  entity: ref Entity,
  at: f32,
  was: f32,
  across: bool,
  solid: ref Entity
) -> f32 => {
  let step: f32 = if was < at { -1.0 } else { 1.0 }
  var p = at
  while (p - was) * step < -1.0 {
    p += step
    let clear = if across {
      !entity.meets_at(p, entity.fy, solid)
    } else {
      !entity.meets_at(entity.fx, p, solid)
    }
    if clear { return p }
  }
  was
}

/// A map with no colliders of its own: one band of none, and a collider that meets nothing.
const NO_BANDS: [2]u32 = #[0, 0]
const NO_MAP_SHAPES: [1]Collider = #[NO_COLLIDER]

/// One axis's speed after an update. Pushed `d` (towards -1 or 1), it heads for `d` times
/// `top`: gaining `rate` while it is slower that way or going the other, and losing
/// `friction` while it is faster (a lighter lean than before). Not pushed, it loses
/// `friction` until it stands.
let accelerate = pure (v: f32, d: f32, rate: f32, friction: f32, top: f32) -> f32 => {
  if !nonzero(d) { return toward(v, 0.0, friction) }
  let target = top * d.clamp(-1.0, 1.0)
  let behind = if target > 0.0 { v < target } else { v > target }
  toward(v, target, if behind { rate } else { friction })
}

/// Whether `v` is anything but zero — a speed, or a push.
let nonzero = pure (v: f32) -> bool => v < 0.0 || v > 0.0

/// `v` moved `step` towards `target`, never past it.
let toward = pure (v: f32, target: f32, step: f32) -> f32 =>
  if v < target { (v + step).min(target) } else { (v - step).max(target) }
