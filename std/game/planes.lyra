module std.game.planes
//! The tile planes a game's maps are shown through — `std.genesis.vdp`'s planes A and B and
//! its window, for every modern platform: a map written into a plane once, scrolled as the
//! view moves, and a strip at the top that does not scroll for a score.
//!
//! ```
//! import std.game.planes
//!
//! planes.write_plane(planes.PLANE_B, FIELD_CELLS, FIELD_WIDTH)
//! planes.set_scroll(planes.PLANE_B, view.x, view.y)
//! planes.window_rows(2)
//! planes.write_cell(planes.WINDOW, 1, 0, planes.FRONT | DIGITS_TILE)
//! ```
//!
//! **A cell is a `u32`**: a tile of the tile art (`std.game.screen`'s `load_tiles`) in its
//! low bits ([TILE_MASK]), the palette it is shown in ([palette]), mirrored ([FLIP_X]),
//! flipped ([FLIP_Y]), and in front of the sprites or behind them ([FRONT]) — the
//! Genesis's name-table word, widened. Tile 0 is the blank one: a cell that shows nothing
//! holds 0.
//!
//! **Drawn in the Genesis's order** by `screen.show`: plane B, then A, then the sprites —
//! each once for its cells behind and once more for those in [FRONT] — so a tree's canopy
//! covers the hero walking under it. The [WINDOW] takes plane A's place in its rows, and
//! never scrolls.
//!
//! **A plane scrolled during an update remembers where it was scrolled before** ([set_scroll]),
//! and the screen draws it between the two, as it does the sprites (`std.game.sprites`): a
//! map written anew ([write_plane]) is a jump, and slides from nowhere.
//!
//! This module only keeps the planes; `std.game.screen` draws them, so a game's camera and
//! collision can name these without the window.

import std.game.sprites

/// The planes, as the Genesis names them: A in front of B.
pub const PLANE_A: i64 = 0
pub const PLANE_B: i64 = 1
/// The strip over the top [window_rows] rows that does not scroll, in front of plane B and
/// in plane A's place.
pub const WINDOW: i64 = 2

/// The first plane past the Genesis's: `FIRST_LAYER + n`, up to [MAX_LAYERS] of them, each
/// drawn between plane B and plane A, in that order, as a scene's layers are.
pub const FIRST_LAYER: i64 = 3
pub const MAX_LAYERS: i64 = 16

/// How a plane's cells are laid out.
pub const SQUARE: i64 = 0
pub const ISOMETRIC: i64 = 1
pub const STAGGERED: i64 = 2
pub const HEXAGONAL: i64 = 3

/// A plane's layout where it is not the tile art's square grid: a cell's box in pixels, the
/// stagger, and how many tiles a cell shows — a block `block_width` × `block_height` from the
/// tile it names, `set_columns` tiles a row of its tile set, standing on the box's bottom-left.
pub struct Layout {
  grid: i64 = SQUARE,
  cell_width: i64 = 0,
  cell_height: i64 = 0,
  stagger_x: bool = false,
  stagger_odd: bool = true,
  hex_side: i64 = 0,
  block_width: i64 = 1,
  block_height: i64 = 1,
  set_columns: i64 = 1,
  /// Rows of the map, which an isometric grid is shifted by.
  rows: i64 = 0,
}

/// A cell's tile, its palette (0–15, [palette]), and its flags.
pub const TILE_MASK: u32 = 0x000FFFFF
pub const PALETTE_MASK: u32 = 0x0F000000
pub const PALETTE_SHIFT: u32 = 24
pub const FRONT: u32 = 0x20000000
pub const FLIP_Y: u32 = 0x40000000
pub const FLIP_X: u32 = 0x80000000

/// What a plane holds: its cells row by row, `width` a row, and where its top-left is
/// scrolled to — the world position at the screen's top-left.
pub struct Plane {
  cells: []u32,
  width: i64,
  x: f32 = 0.0,
  y: f32 = 0.0,
  /// Where it was scrolled to before the update numbered `scrolled_in` (`sprites.updates`)
  /// scrolled it, which it is drawn sliding from.
  was_x: f32 = 0.0,
  was_y: f32 = 0.0,
  scrolled_in: i64 = -1,
  /// `None` for the tile art's square grid.
  layout: Maybe<Layout> = None,
}

/// A cell's bits for palette `p`: `FRONT | planes.palette(2) | tile`.
pub let palette = pure (p: u32) -> u32 => (p << PALETTE_SHIFT) & PALETTE_MASK

/// The window's width in cells: wide enough for any screen a game opens, up to 1024 pixels.
pub const WINDOW_COLUMNS: i64 = 128

/// Show a map in `plane`, replacing what it held: `cells` row by row, `width` cells a row,
/// the map's top-left at the world's (0, 0). The plane keeps a copy, so the table may be a
/// `const`.
pub let write_plane<const N: i64> = (
  plane: i64,
  cells: ref [N]u32,
  width: i64
) -> void => {
  if plane < 0 || plane >= all.len() || width <= 0 { return }
  all[plane] = Plane {
    all[plane] | cells: [c in cells | c],
    width: width,
    scrolled_in: -1,
    layout: None
  }
  sprites.snap()
}

/// One cell of `plane`, at column `x` and row `y`. A cell past a map's edge is not kept;
/// the [WINDOW] grows downwards to hold any row written.
pub let write_cell = (plane: i64, x: i64, y: i64, word: u32) -> void => {
  if plane < 0 || plane >= all.len() || x < 0 || y < 0 { return }
  if plane == WINDOW {
    while all[WINDOW].cells.len() < (y + 1) * WINDOW_COLUMNS { all[WINDOW].cells.push(0) }
  }
  let p = all[plane]
  if x < p.width && y * p.width + x < p.cells.len() { all[plane].cells[y * p.width + x] = word }
}

/// Scroll `plane` so world position (`x`, `y`) is at the screen's top-left. The window does
/// not scroll.
pub let set_scroll = (plane: i64, x: f32, y: f32) -> void => {
  if plane == PLANE_A || plane == PLANE_B || (plane >= FIRST_LAYER && plane < all.len()) {
    let now = sprites.updates()
    if all[plane].scrolled_in != now {
      // The first scroll this update: where it was is where the last update left it — or,
      // after a jump, here.
      let fresh = all[plane].scrolled_in < 0 || sprites.snapped()
      all[plane].was_x = if fresh { x } else { all[plane].x }
      all[plane].was_y = if fresh { y } else { all[plane].y }
      all[plane].scrolled_in = now
    }
    all[plane].x = x
    all[plane].y = y
  }
}

/// `plane` laid out as `layout` says, once its map is written.
pub let set_layout = (plane: i64, layout: Layout) -> void => {
  if plane >= 0 && plane < all.len() { all[plane].layout = Some(layout) }
}

/// Tiles that step through others as the game runs, replacing any before: `table` is runs of
/// a tile, how many steps, then each step's tile and milliseconds.
pub let animate_tiles<const N: i64> = (table: ref [N]i64) -> void => {
  runs = []
  shown = []
  var i = 0
  while i + 1 < N {
    let count = table[i + 1]
    runs.push(TileRun { tile: table[i], at: i + 2, count: count })
    if table[i] >= shown.len() { shown = [...shown, ...[k in shown.len()..<=table[i] | 0]] }
    i += 2 + count * 2
  }
  run_table = [v in table | v]
}

/// The animated tiles as they are `ms` milliseconds in — for `std.game.screen`, each frame.
pub let step_tiles = (ms: i64) -> void => {
  for r in runs {
    var total = 0
    for k in 0..<r.count { total += run_table[r.at + k * 2 + 1] }
    if total <= 0 { continue }
    var left = ms % total
    for k in 0..<r.count {
      let length = run_table[r.at + k * 2 + 1]
      if left < length {
        shown[r.tile] = run_table[r.at + k * 2]
        break
      }
      left -= length
    }
  }
}

/// The tile shown for `tile` now, an animated one's current step.
pub let shown_tile = (tile: i64) -> i64 =>
  if tile < shown.len() && shown[tile] != 0 { shown[tile] } else { tile }

/// How many rows of cells the [WINDOW] covers at the top of the screen: 0, the default,
/// shows none.
pub let window_rows = (rows: i64) -> void => { shown_rows = rows.max(0) }

/// Empty `plane`: it shows nothing until written again.
pub let clear = (plane: i64) -> void => {
  if plane >= 0 && plane < all.len() { all[plane] = empty(all[plane].width) }
}

/// How many planes there are, the layers included.
pub let plane_count = () -> i64 => all.len()

/// What `plane` holds now — for `std.game.screen`, which draws it.
pub let plane = (index: i64) -> Plane => all[index]

impl Layout {
  /// The top-left of cell (`x`, `y`)'s box, in the map's pixels.
  pub let box_of = pure (self, x: i64, y: i64) -> (i64, i64) => {
    let (cw, ch) = (self.cell_width, self.cell_height)
    if self.grid == ISOMETRIC { return ((x - y + self.rows - 1) * cw / 2, (x + y) * ch / 2) }
    if self.grid == SQUARE { return (x * cw, y * ch) }
    let side = if self.grid == HEXAGONAL { self.hex_side } else { 0 }
    if self.stagger_x {
      let shifted = (x % 2 != 0) == self.stagger_odd
      (x * (cw + side) / 2, y * ch + (if shifted { ch / 2 } else { 0 }))
    } else {
      let shifted = (y % 2 != 0) == self.stagger_odd
      (x * cw + (if shifted { cw / 2 } else { 0 }), y * (ch + side) / 2)
    }
  }
}

impl Plane {
  /// Where it is scrolled to `t` of the way from the update before to this one (0 to 1):
  /// between where it was and where it is when this update scrolled it, else where it is.
  pub let scrolled_at = (self: ref, t: f32) -> (f32, f32) =>
    if self.scrolled_in == sprites.updates() {
      (self.was_x + (self.x - self.was_x) * t, self.was_y + (self.y - self.was_y) * t)
    } else {
      (self.x, self.y)
    }
}

/// How many rows the window covers — for `std.game.screen`.
pub let rows_in_window = () -> i64 => shown_rows

// ── Beneath ──────────────────────────────────────────────────────────────────────────

/// A plane holding nothing, `width` cells a row. Above the planes: their initializer calls it.
let empty = pure (width: i64) -> Plane => Plane { cells: [], width: width }

/// A tile's animation, its steps at `at` in [run_table].
struct TileRun {
  tile: i64,
  at: i64,
  count: i64,
}

var all: []Plane = [empty(0), empty(0), empty(WINDOW_COLUMNS), ...[k in 0..<MAX_LAYERS | empty(0)]]
var runs: []TileRun = []
var run_table: []i64 = []
var shown: []i64 = []
var shown_rows: i64 = 0
