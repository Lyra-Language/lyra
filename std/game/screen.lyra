module std.game.screen
//! The screen a modern game draws on — what `std.genesis.vdp` is to a Genesis game, for
//! every platform SDL3 runs on: a window showing a small screen scaled up by whole numbers,
//! the art the planes and sprites are drawn from, a steady 60 updates a second, and each
//! frame composed from `std.game.planes` and `std.game.sprites`.
//!
//! ```
//! import std.game.screen
//!
//! let main = () -> u8 => {
//!   if !screen.open("Hero", 384, 216) { return 1 }
//!   assets.load()                          // Vega's: the art, into the screen
//!   while screen.running() {
//!     for _ in 0..<screen.updates_due() { update() }
//!     draw()                               // planes and sprites
//!     screen.show()
//!   }
//!   screen.close()
//! }
//! ```
//!
//! **Updates are 60 a second, whatever the display's rate** ([updates_due]): a game's
//! speeds are pixels an update, as a Genesis game's are pixels a frame, so it plays at the
//! same pace on a 60 Hz screen and a 144 Hz one.
//!
//! **How the screen fills the window** is the game's choice ([set_fit]): by whole numbers, the
//! default, with borders where the window's shape or size leaves them; or as large as fits; or
//! stretched to fill it; or filling it with the edges cut off; or **filling it by showing more**
//! (`Expand`): the size [open] was given is the least the game shows, and the screen grows
//! along whichever side the window is longer, so [width] and [height] change with the window.
//!
//! **How the art is scaled is the game's choice too** ([set_look]): `Pixelated`, the default,
//! nearest-neighbour — pixel art stays sharp; or `Smooth`, filtered — for art drawn at a high
//! resolution, which is drawn at the display's real pixels (the window is high density). A
//! tile set's art is laid out with a pixel's border round each tile, copied from its edge, so a
//! smooth tile never takes colour from its neighbour in the art.
//!
//! **Drawn between updates** ([blend]): a sprite that says where it was the update before
//! (`sprites.came_from` — Vega's entities do) and a plane scrolled this update are drawn that
//! far from there to here, so a 120 Hz display shows motion in steps of half an update rather
//! than an update and a repeat. The game is unchanged: it updates 60 times a second, and what
//! it moves through or meets is where the update put it. Played with `--frames`, it is drawn
//! where it is, so a frame is the same on every machine.
//!
//! **The frame is composed in the Genesis's order** ([show]): the backdrop; plane B's cells,
//! then plane A's (the window in its rows), then the sprites; then the planes' cells in
//! front, and the sprites in front. Pixel art stays sharp: the screen is scaled by whole
//! numbers into the window, nearest-neighbour, unless the game says otherwise.
//!
//! **Played without anyone at it**, as Sheliak plays a ROM: `--frames N` stops after N
//! frames, one update each, at scale 1; `--ppm FILE` writes the last as a binary PPM, at the
//! screen's size whatever the window's; `--hold up,right` holds pad 1's buttons, and `--touch
//! up,right` puts fingers on the screen's pad's. With `SDL_VIDEODRIVER=dummy` and
//! `SDL_RENDER_DRIVER=software` no window appears — how Vega's checks play a game.
//!
//! **On a phone** (`std.game` asks SDL which platform it is): the whole screen, at its real
//! pixels — a 384 × 216 screen ×5 on a phone held sideways, not ×1 as its points would make it
//! — landscape whichever way it is held, and a pad on the screen for the fingers
//! (`std.game.pad`'s [touch_layout], drawn in the screen's real pixels over the game).
//! Leaving the app pauses the game; coming back, it goes on where it was, with no time to
//! catch up. A relative `--ppm` is written in the app's own folder.

import bindings.sdl3
import bindings.sdl3.{
  init,
  quit,
  last_error,
  INIT_VIDEO,
  INIT_GAMEPAD,
  Window,
  create_window,
  destroy_window,
  WINDOW_RESIZABLE,
  WINDOW_FULLSCREEN,
  WINDOW_HIGH_PIXEL_DENSITY,
  usable_display_size,
  HINT_ORIENTATIONS,
  set_hint,
  pref_path,
  base_path,
  PRESENT_DISABLED,
  BLEND_NONE,
  Renderer,
  destroy_renderer,
  PRESENT_INTEGER_SCALE,
  PRESENT_LETTERBOX,
  PRESENT_STRETCH,
  PRESENT_OVERSCAN,
  SCALE_NEAREST,
  SCALE_LINEAR,
  set_default_scale_mode,
  set_texture_scale_mode,
  Color,
  rgb,
  Rect,
  Texture,
  create_texture,
  destroy_texture,
  draw_texture_flipped,
  draw_texture_rotated,
  set_texture_alpha,
  set_texture_color,
  set_texture_blend,
  BLEND_ALPHA,
  BLEND_ADD,
  FLIP_NONE,
  FLIP_HORIZONTAL,
  FLIP_VERTICAL,
  poll_event,
  KEY_ESCAPE,
  ticks_ns,
}
import std.io.{ write_bytes, read_bytes }
import std.png.{ read_png }
import std.game.pad
import std.game.planes
import std.game.planes.{
  Layout,
  Plane,
  TILE_MASK,
  PALETTE_MASK,
  PALETTE_SHIFT,
  FRONT,
  FLIP_X,
  FLIP_Y
}
import std.game.sprites
import std.game.sprites.{ Sprite }

/// Updates a second, whatever the display's rate: a game's speeds are pixels an update, and
/// a time in milliseconds is `ms * UPDATES_PER_SECOND / 1000` updates.
pub const UPDATES_PER_SECOND: i64 = 60

/// One update, in milliseconds: 1000 / [UPDATES_PER_SECOND]. For showing a time or timing
/// what is not the game's own; a game moves by updates, never by a measured time.
pub const UPDATE_MS: f32 = 16.666666

/// One update, in nanoseconds: 1000000000 / [UPDATES_PER_SECOND].
pub const STEP_NS: i64 = 16666667

/// At most this many updates a frame: after a stall the game resumes slowed, rather than
/// running a second of updates at once.
pub const MAX_STEPS: i64 = 5

/// Open a window showing a screen `width` × `height` pixels, scaled up — or print why not and
/// answer `false`. The arguments the game was run with may ask it to play itself (`--frames`,
/// `--ppm`, `--hold`).
pub let open = (title: string, width: i64, height: i64) -> bool => {
  if !read_arguments() { return false }
  // A phone's window is its whole screen, in its real pixels, on its side.
  let platform = sdl3.platform()
  phone = platform == "iOS" || platform == "Android"
  if phone {
    set_hint(HINT_ORIENTATIONS, "LandscapeLeft LandscapeRight")
    pad.use_touch_screen()
    if ppm_path != "" && !ppm_path.starts_with("/") {
      if let Some(folder) = pref_path("Lyra", title) { ppm_path = folder ++ ppm_path }
    }
  }
  if !init(INIT_VIDEO | INIT_GAMEPAD) {
    println("SDL could not start: ${last_error()}")
    return false
  }
  let (opened_w, opened_h) = if limit > 0 {
    (width, height)
  } else { window_size(width, height) }
  let flags = if phone { WINDOW_FULLSCREEN | WINDOW_HIGH_PIXEL_DENSITY } else { WINDOW_RESIZABLE | WINDOW_HIGH_PIXEL_DENSITY }
  let Some(w) = create_window(
    title,
    i32(opened_w),
    i32(opened_h),
    flags
  ) else {
    println("could not open a window: ${last_error()}")
    quit()
    return false
  }
  let Some(r) = w.create_renderer() else {
    println("could not make a renderer: ${last_error()}")
    destroy_window(w)
    quit()
    return false
  }
  r.set_logical_presentation(i32(width), i32(height), presentation(fitting))
  r.set_vsync(limit <= 0)
  set_default_scale_mode(r, scale_mode(looking))
  window = Some(w)
  renderer = Some(r)
  design_width = width
  design_height = height
  screen_width = width
  screen_height = height
  refit()
  last_ns = i64(ticks_ns())
  owed_ns = 0
  true
}

/// The screen's size in the art's pixels — what a game's world and camera count in: what
/// [open] was given, over the art scale ([set_art_scale]), the last pixel's part counted —
/// or, filling the window by showing more (`Expand`), that grown to the window's shape, which
/// can change from one frame to the next.
pub let width = () -> i64 => (screen_width + art_scale - 1) / art_scale
pub let height = () -> i64 => (screen_height + art_scale - 1) / art_scale

/// Draw the planes and sprites `scale` times their art's size (1 to 16): a screen opened at
/// 1920 × 1080 with the art at 5 shows what a 384 × 216 one shows, at the screen's full
/// resolution — so a sprite turned or grown, or drawn smooth, is drawn in the screen's own
/// pixels. [width] and [height] are then in the art's pixels, as the game moves in them.
/// Once after [open], or whenever the game likes.
pub let set_art_scale = (scale: i64) -> void => { art_scale = scale.clamp(1, 16) }

/// Whether the game goes on: the events since the last frame handled — gamepads come and
/// go, the window closed or Escape ends it — and, played with `--frames`, frames still to
/// show.
pub let running = () -> bool => {
  while let Some(event) = poll_event() {
    match event {
      Quit | Terminating => { quitting = true },
      KeyDown(key) => {
        if key == KEY_ESCAPE { quitting = true }
        pad.track(event)
      },
      // Away, the game waits; back, it goes on where it was — the time away not owed.
      WillEnterBackground => { paused = true },
      DidEnterForeground => {
        paused = false
        last_ns = i64(ticks_ns())
        owed_ns = 0
      },
      _ => pad.track(event),
    }
  }
  if let Some(r) = renderer {
    let (w, h) = r.output_size()
    pad.set_touch_area(f32(w), f32(h))
  }
  refit()
  !quitting && (limit <= 0 || frame < limit)
}

/// How many updates this frame should run: on average 60 a second, whatever the display
/// refreshes at — on a 120 Hz screen 1, 0, 1, 0… Played with `--frames`, always 1, so a
/// frame is the same on every machine.
pub let updates_due = () -> i64 => {
  if paused { return 0 }
  if limit > 0 { return 1 }
  let now = i64(ticks_ns())
  let (steps, owed) = accrue(owed_ns, now - last_ns)
  last_ns = now
  owed_ns = owed
  steps
}

/// How far the clock is from the last update run to the next, 0 to 1: where [show] draws what
/// moves, between where the update before had it and where the last one put it. Played with
/// `--frames`, or paused, 1 — drawn where it is.
pub let blend = () -> f32 =>
  if limit > 0 || paused { 1.0 } else { (f32(owed_ns) / f32(STEP_NS)).clamp(0.0, 1.0) }

/// The updates to run and the time still owed, given what was owed and the time just
/// elapsed — [updates_due]'s arithmetic, pure so it can be tested.
pub let accrue = pure (owed: i64, elapsed: i64) -> (i64, i64) => {
  let total = owed + elapsed.max(0)
  let steps = total / STEP_NS
  if steps > MAX_STEPS { (MAX_STEPS, 0) } else { (steps, total % STEP_NS) }
}

/// How the screen fills a window of another shape or size ([set_fit]).
pub data Fit =
  /// Scaled by a whole number, the largest that fits, with borders round it: every pixel the
  /// same size and square. The default.
  | Whole
  /// As large as fits, its shape kept: borders on two sides at most, pixels not all alike.
  | Letterbox
  /// Stretched to fill the window, its shape lost: no borders, pixels no longer square.
  | Stretch
  /// Filling the window, its shape kept: no borders, its edges cut off where they spill over.
  | Crop
  /// Filling the window by showing more: the size [open] was given is the least shown, and
  /// the screen grows along whichever side the window is longer — [width] and [height] are
  /// then the window's shape, at that scale. A game whose camera follows it (`std.game.camera`'s
  /// `resize_view`) sees more of its world in a wider window.
  | Expand

/// Fill the window as `fit` says — once after [open], or whenever the game likes.
pub let set_fit = (fit: Fit) -> void => {
  fitting = fit
  screen_width = design_width
  screen_height = design_height
  if let Some(r) = renderer { r.set_logical_presentation(
    i32(screen_width),
    i32(screen_height),
    presentation(fit)
  ) }
  refit()
}

/// How the art is scaled ([set_look]).
pub data Look =
  /// Nearest-neighbour: every pixel of the art a sharp square, however large. The default.
  | Pixelated
  /// Filtered: art drawn at a high resolution scaled smoothly — down to a small window, up
  /// to a large one.
  | Smooth

/// Scale the art as `look` says: the art loaded already and all loaded after. Once after
/// [open], or whenever the game likes.
pub let set_look = (look: Look) -> void => {
  looking = look
  let mode = scale_mode(look)
  if let Some(r) = renderer { set_default_scale_mode(r, mode) }
  for art in tile_art {
    if let Some(t) = art { set_texture_scale_mode(t, mode) }
  }
  if let Some(t) = sprite_art { set_texture_scale_mode(t, mode) }
}

/// The colour behind everything, where no cell or sprite is.
pub let set_backdrop = (r: u8, g: u8, b: u8) -> void => { backdrop = rgb(r, g, b) }

/// The art the planes' cells show in `palette` (0–15): `columns` tiles a row, `tile_size`
/// pixels square each (every palette's alike), `pixels` the whole picture row by row, `0xAARRGGBB` (alpha 0 is transparent). Tile
/// `t` is the `t`-th, left to right, top to bottom; tile 0 should be blank. A cell in palette
/// `p` shows tile `t` of palette `p`'s art — the Genesis's tile and palette, apart — so each
/// palette a game's cells use has its art, every one laid out alike. Replaces any loaded
/// for that palette before.
pub let load_tiles<const N: i64> = (
  columns: i64,
  pixels: ref [N]u32,
  palette: i64 = 0,
  tile_size: i64 = 8
) -> bool => {
  if palette < 0 || palette >= PALETTES || tile_size <= 0 || columns <= 0 { return false }
  let wide = columns * tile_size
  if pixels.len() % wide != 0 { return false }
  let Some(t) = tile_picture([p in pixels | p], wide, columns, tile_size) else {
    return false
  }
  use_tiles(t, columns, palette, tile_size)
  true
}

/// [load_tiles], the art a PNG file the program ships ([load_sprites_file] says where): as many
/// columns as its width holds. False, having said why, when it cannot be read.
pub let load_tiles_file = (
  name: string,
  palette: i64 = 0,
  tile_size: i64 = 8
) -> bool => {
  if palette < 0 || palette >= PALETTES || tile_size <= 0 { return false }
  let Some((pixels, wide)) = picture_file_pixels(name) else { return false }
  let columns = wide / tile_size
  if columns <= 0 { return false }
  // A width not whole tiles: each row cut to the tiles it holds.
  let used = columns * tile_size
  let rows = pixels.len() / wide
  let kept = [i in 0..<(rows * used) | pixels[(i / used) * wide + i % used]]
  let Some(t) = tile_picture(kept, used, columns, tile_size) else { return false }
  use_tiles(t, columns, palette, tile_size)
  true
}

/// The art the sprites show: a picture `width` pixels wide, `pixels` row by row,
/// `0xAARRGGBB`. A [Sprite] names a rectangle of it. Replaces any loaded before.
pub let load_sprites<const N: i64> = (width: i64, pixels: ref [N]u32) -> bool => {
  let Some(t) = picture(width, pixels) else { return false }
  use_sprites(t)
  true
}

/// [load_sprites], the art a PNG file the program ships: `name` is its path from the folder the
/// program runs from (`SDL_GetBasePath`; `lyra.toml`'s `resources` puts a folder there). Read when
/// the game runs, so a game's art takes no room in its source. False, having said why, when it
/// cannot be read.
pub let load_sprites_file = (name: string) -> bool => {
  let Some((t, _)) = picture_file(name) else { return false }
  use_sprites(t)
  true
}

/// Draw the frame — the planes and sprites as they are now — and show it. Played with
/// `--ppm`, the last frame is written there first.
pub let show = () -> void => {
  let Some(r) = renderer else { return }
  if paused { return }
  r.set_draw_color(backdrop)
  r.clear()
  let t = blend()
  // Played headless by frames, the frames' own time, so a frame is the same every run.
  planes.step_tiles(if limit > 0 { frame * 1000 / 60 } else { i64(ticks_ns()) / 1000000 })
  // The art drawn its scale's times larger: SDL's scale under the screen's presentation.
  r.set_scale(f32(art_scale), f32(art_scale))
  draw_planes(r, false, t)
  draw_sprites(r, false, t)
  draw_planes(r, true, t)
  draw_sprites(r, true, t)
  r.set_scale(1.0, 1.0)
  frame += 1
  if limit > 0 && frame == limit && ppm_path != "" && !write_ppm(r, ppm_path) {
    println("could not write ${ppm_path}")
    failed = true
  }
  if pad.touch_pad_shown() { draw_touch_pad(r) }
  r.present()
}

/// Close the window and release everything: the game's last call. Answers the program's
/// exit status: 0, or 1 when `--ppm` could not be written.
pub let close = () -> u8 => {
  for art in tile_art {
    if let Some(t) = art { destroy_texture(t) }
  }
  if let Some(t) = sprite_art { destroy_texture(t) }
  tile_art = [None; PALETTES]
  sprite_art = None
  pad.release()
  if let Some(r) = renderer { destroy_renderer(r) }
  if let Some(w) = window { destroy_window(w) }
  renderer = None
  window = None
  quit()
  if failed { 1 } else { 0 }
}

// ── Beneath ──────────────────────────────────────────────────────────────────────────

/// The window opens at this many times the screen, at most — less where the display's room
/// is smaller ([window_size]); resizing it keeps whole-number scaling.
const WINDOW_SCALE: i64 = 3

/// The share of the display's room for windows a window may open at.
const DISPLAY_SHARE: f32 = 0.9

/// A tile's border in its art, each side ([tile_picture]).
const GUTTER: i64 = 1

/// The size the window opens at for a screen `width` × `height`: [WINDOW_SCALE] times it, or
/// the largest whole number of times that fits the display's room — or, for a screen larger
/// than that room, the screen scaled down to fit it.
let window_size = (width: i64, height: i64) -> (i64, i64) => {
  let Some((dw, dh)) = usable_display_size() else {
    return (width * WINDOW_SCALE, height * WINDOW_SCALE)
  }
  let room = (f32(dw) * DISPLAY_SHARE / f32(width)).min(f32(dh) * DISPLAY_SHARE / f32(height))
  let scale = if room >= 1.0 { f32(room.floor().min(WINDOW_SCALE).max(1)) } else { room }
  ((f32(width) * scale).floor().max(1), (f32(height) * scale).floor().max(1))
}

/// SDL's scale mode for `look`.
let scale_mode = pure (look: Look) -> i32 => match look {
  Pixelated => SCALE_NEAREST,
  Smooth => SCALE_LINEAR,
}

/// The screen's size made the window's shape again when it fills the window by showing more
/// (`Expand`): the size [open] was given grown along the window's longer side. Each frame, in
/// [running]; nothing changes in a window of the screen's own shape, or played headless.
let refit = () -> void => {
  if fitting != Expand { return }
  let Some(r) = renderer else { return }
  let (ow, oh) = r.output_size()
  let (w, h) = expanded(design_width, design_height, i64(ow), i64(oh))
  if w == screen_width && h == screen_height { return }
  screen_width = w
  screen_height = h
  r.set_logical_presentation(i32(w), i32(h), presentation(fitting))
}

/// A screen of at least `width` × `height` grown along one side to the shape of a window
/// `out_w` × `out_h` — its arithmetic, pure so it can be tested.
pub let expanded = pure (
  width: i64,
  height: i64,
  out_w: i64,
  out_h: i64
) -> (i64, i64) => {
  if out_w <= 0 || out_h <= 0 { return (width, height) }
  if out_w * height > out_h * width {
    ((height * out_w + out_h / 2) / out_h, height)
  } else {
    (width, (width * out_h + out_w / 2) / out_w)
  }
}

/// The palettes a cell may name.
const PALETTES: i64 = 16

var window: Maybe<Window> = None
var renderer: Maybe<Renderer> = None
var screen_width: i64 = 0
/// A tile's side, in pixels, as [load_tiles] was given it.
var tile_side: i64 = 8
var fitting: Fit = Whole
/// The art's pixels' size on the screen ([set_art_scale]).
var art_scale: i64 = 1
var looking: Look = Pixelated
/// The size [open] was given: the least shown when filling the window by showing more.
var design_width: i64 = 0
var design_height: i64 = 0
var screen_height: i64 = 0
var backdrop: Color = rgb(0, 0, 0)
var tile_art: []Maybe<Texture> = [None; PALETTES]
var tile_columns: i64 = 1
var sprite_art: Maybe<Texture> = None
var quitting = false
var failed = false
/// A phone's screen (full, real pixels, a pad for the fingers), and the app away from it.
var phone = false
var paused = false
/// Frames shown, and — played with `--frames` — how many to show.
var frame: i64 = 0
var limit: i64 = 0
var ppm_path: string = ""
/// The clock: when it was last read, and the time not yet spent on updates.
var last_ns: i64 = 0
var owed_ns: i64 = 0

/// `--frames N`, `--ppm FILE` and `--hold BUTTONS`, from the program's arguments — or
/// `false`, having said what is wrong.
let read_arguments = () -> bool => {
  let args = program_args()
  var i = 1
  while i + 1 < args.len() {
    let value = args[i + 1]
    if args[i] == "--frames" {
      let Some(n) = value.parse_i64() else {
        println("--frames takes a number of frames, not ${value}")
        return false
      }
      limit = n.max(1)
    } else if args[i] == "--ppm" {
      ppm_path = value
    } else if args[i] == "--touch" {
      match pad.buttons_named(value) {
        Ok(buttons) => pad.touch(buttons),
        Err(name) => {
          println("--touch takes up, down, left, right, a, b, c and start, not ${name}")
          return false
        },
      }
    } else if args[i] == "--hold" {
      match pad.buttons_named(value) {
        Ok(buttons) => pad.hold(buttons),
        Err(name) => {
          println("--hold takes up, down, left, right, a, b, c, x, y, z, start and mode, not ${name}")
          return false
        },
      }
    } else {
      i += 1
      continue
    }
    i += 2
  }
  true
}

/// A texture of `pixels`, `width` wide.
let picture<const N: i64> = (width: i64, pixels: ref [N]u32) -> Maybe<Texture> => {
  let Some(r) = renderer else { return None }
  if width <= 0 || pixels.len() % width != 0 { return None }
  create_texture(r, width, pixels.len() / width, [p in pixels | p])
}

/// The PNG file `name` as a texture, and its width; or `None`, having said why.
let picture_file = (name: string) -> Maybe<(Texture, i64)> => {
  let Some(r) = renderer else { return None }
  let Some((pixels, wide)) = picture_file_pixels(name) else { return None }
  match create_texture(r, wide, pixels.len() / wide, pixels) {
    Some(t) => Some((t, wide)),
    None => None,
  }
}

/// A tile set's art, `width` pixels wide in `columns` tiles `side` pixels square, as a
/// texture with a pixel's border round each tile copied from the tile's edge ([GUTTER]): a
/// smooth look samples past a tile's edge, which would otherwise take its neighbour's colour.
let tile_picture = (
  pixels: []u32,
  width: i64,
  columns: i64,
  side: i64
) -> Maybe<Texture> => {
  let Some(r) = renderer else { return None }
  let rows = pixels.len() / width / side
  if rows <= 0 { return None }
  let cell = side + 2 * GUTTER
  let out_w = columns * cell
  let out_h = rows * cell
  let laid = [i in 0..<(out_w * out_h) | gutter_pixel(
    pixels,
    width,
    side,
    cell,
    i % out_w,
    i / out_w
  )]
  create_texture(r, out_w, out_h, laid)
}

/// The pixel at (`x`, `y`) of a tile set's art laid out with gutters: its tile's pixel
/// nearest, the border taking the edge's.
let gutter_pixel = pure (
  pixels: ref []u32,
  width: i64,
  side: i64,
  cell: i64,
  x: i64,
  y: i64
) -> u32 => {
  let tx = (x % cell - GUTTER).clamp(0, side - 1)
  let ty = (y % cell - GUTTER).clamp(0, side - 1)
  pixels[((y / cell) * side + ty) * width + (x / cell) * side + tx]
}

/// Where tile `tile`'s pixels start in its art, laid out with gutters ([tile_picture]).
let tile_at = (tile: i64) -> (i64, i64) => {
  let cell = tile_side + 2 * GUTTER
  ((tile % tile_columns) * cell + GUTTER, (tile / tile_columns) * cell + GUTTER)
}

/// The PNG file `name`'s pixels, `0xAARRGGBB`, and its width; or `None`, having said why.
let picture_file_pixels = (name: string) -> Maybe<([]u32, i64)> => {
  let path = "${base_path().unwrap_or("")}${name}"
  let Some(bytes) = read_bytes(path) else {
    println("cannot read ${path}")
    return None
  }
  match read_png(bytes) {
    Err(e) => {
      println("${path}: ${e}")
      None
    },
    Ok(png) => {
      let rgba = png.rgba
      Some(([i in 0..<png.width * png.height | argb_at(rgba, i * 4)], png.width))
    },
  }
}

/// The `0xAARRGGBB` of the RGBA pixel at byte `at`.
let argb_at = pure (rgba: ref []u8, at: i64) -> u32 =>
  u32(rgba[at + 3]) << 24 | u32(rgba[at]) << 16 | u32(rgba[at + 1]) << 8 | u32(rgba[at + 2])

/// `t` the art of `palette`, in place of any before.
let use_tiles = (t: own Texture, columns: i64, palette: i64, tile_size: i64) -> void => {
  tile_side = tile_size
  if let Some(old) = tile_art[palette] { destroy_texture(old) }
  tile_art[palette] = Some(t)
  tile_columns = columns
}

/// `t` the sprite art, in place of any before.
let use_sprites = (t: own Texture) -> void => {
  if let Some(old) = sprite_art { destroy_texture(old) }
  sprite_art = Some(t)
}

/// Plane B, then plane A below the window's rows and the window in them — the cells in
/// front, or those behind; each scrolled `t` of the way from the update before ([blend]).
let draw_planes = (r: Renderer, front: bool, t: f32) -> void => {
  let window_bottom = planes.rows_in_window() * tile_side
  let bottom = height()
  draw_plane(r, scrolled(planes.plane(planes.PLANE_B), t), front, 0, bottom)
  for k in planes.FIRST_LAYER..<planes.plane_count() {
    draw_plane(r, scrolled(planes.plane(k), t), front, 0, bottom)
  }
  draw_plane(
    r,
    scrolled(planes.plane(planes.PLANE_A), t),
    front,
    window_bottom,
    bottom
  )
  if window_bottom > 0 {
    let w = planes.plane(planes.WINDOW)
    draw_plane(r, Plane { w | x: 0.0, y: 0.0 }, front, 0, window_bottom)
  }
}

/// `p` where it shows `t` of the way from the update before.
let scrolled = (p: Plane, t: f32) -> Plane => {
  let (x, y) = p.scrolled_at(t)
  Plane { p | x: x, y: y }
}

/// A plane's cells that show between screen rows `top` and `bottom`, those in front or
/// those behind.
let draw_plane = (r: Renderer, p: Plane, front: bool, top: i64, bottom: i64) -> void => {
  if p.width <= 0 || top >= bottom { return }
  if let Some(layout) = p.layout {
    draw_laid_out(r, p, layout, front)
    return
  }
  let rows = p.cells.len() / p.width
  let sx = p.x.floor()
  let sy = p.y.floor()
  let first_column = (sx / tile_side).max(0)
  let last_column = ((sx + width() - 1) / tile_side).min(p.width - 1)
  let first_row = ((sy + top) / tile_side).max(0)
  let last_row = ((sy + bottom - 1) / tile_side).min(rows - 1)
  for row in first_row..<=last_row {
    for column in first_column..<=last_column {
      let word = p.cells[row * p.width + column]
      let tile = planes.shown_tile(i64(word & TILE_MASK))
      if tile == 0 || ((word & FRONT) != 0) != front { continue }
      let Some(art) = tile_art[i64((word & PALETTE_MASK) >> PALETTE_SHIFT)] else { continue }
      // The part of the cell between `top` and `bottom` on the screen.
      let y = row * tile_side - sy
      let from = y.max(top)
      let to = (y + tile_side).min(bottom)
      if from >= to { continue }
      let flip_y = (word & FLIP_Y) != 0
      let cut = if flip_y { y + tile_side - to } else { from - y }
      let (ax, ay) = tile_at(tile)
      let source = Rect {
        x: f32(ax),
        y: f32(ay + cut),
        w: f32(tile_side),
        h: f32(to - from),
      }
      let place = Rect {
        x: f32(column * tile_side - sx),
        y: f32(from),
        w: f32(tile_side),
        h: f32(to - from)
      }
      draw_texture_flipped(r, art, source, place, flips((word & FLIP_X) != 0, flip_y))
    }
  }
}

/// A plane of another layout: its cells in row order, later ones over earlier, each its
/// block of tiles standing on its box's bottom-left.
let draw_laid_out = (r: Renderer, p: Plane, layout: Layout, front: bool) -> void => {
  let rows = p.cells.len() / p.width
  let sx = p.x.floor()
  let sy = p.y.floor()
  for row in 0..<rows {
    for column in 0..<p.width {
      let word = p.cells[row * p.width + column]
      let first = i64(word & TILE_MASK)
      if first == 0 || ((word & FRONT) != 0) != front { continue }
      let (bx, by) = layout.box_of(column, row)
      let left = bx - sx
      let base = by + layout.cell_height - layout.block_height * tile_side - sy
      if left >= width() || base >= height() { continue }
      if left + layout.block_width * tile_side <= 0 || base + layout.block_height * tile_side <= 0 { continue }
      let Some(art) = tile_art[i64((word & PALETTE_MASK) >> PALETTE_SHIFT)] else { continue }
      let flip_x = (word & FLIP_X) != 0
      let flip_y = (word & FLIP_Y) != 0
      for ty in 0..<layout.block_height {
        for tx in 0..<layout.block_width {
          let across = if flip_x { layout.block_width - 1 - tx } else { tx }
          let down = if flip_y { layout.block_height - 1 - ty } else { ty }
          let tile = planes.shown_tile(first + across + down * layout.set_columns)
          let (ax, ay) = tile_at(tile)
          let source = Rect {
            x: f32(ax),
            y: f32(ay),
            w: f32(tile_side),
            h: f32(tile_side),
          }
          let place = Rect {
            x: f32(left + tx * tile_side),
            y: f32(base + ty * tile_side),
            w: f32(tile_side),
            h: f32(tile_side),
          }
          draw_texture_flipped(r, art, source, place, flips(flip_x, flip_y))
        }
      }
    }
  }
}

/// The sprites in front, or those behind — the earliest added on top, each `t` of the way
/// from where it was the update before ([blend]). One drawn as it is keeps to whole
/// pixels; one faded, tinted, turned, grown or added as light sets the sprite art's state
/// for its draw ([draw_changed]).
let draw_sprites = (r: Renderer, front: bool, t: f32) -> void => {
  let Some(art) = sprite_art else { return }
  let list = sprites.added()
  var i = list.len() - 1
  while i >= 0 {
    let (x, y) = list[i].at(t)
    let s = Sprite { list[i] | x: x, y: y }
    if s.front == front && s.alpha > 0.0 && s.scale > 0.0 {
      let source = Rect { x: s.sheet_x, y: s.sheet_y, w: s.width, h: s.height }
      if s.as_drawn() {
        let place = Rect {
          x: f32(s.x.floor()),
          y: f32(s.y.floor()),
          w: s.width,
          h: s.height
        }
        draw_texture_flipped(r, art, source, place, flips(s.flip_x, s.flip_y))
      } else {
        draw_changed(r, art, s, source)
      }
    }
    i -= 1
  }
}

/// A sprite faded, tinted, turned, grown or added as light: the sprite art's alpha, colour
/// and blending set for it — they are the texture's, not the draw's — and put back after.
/// Grown about its middle, its box at the whole pixel a sprite as drawn is at: a place
/// between pixels is one each renderer rounds its own way, and a turned star moving along
/// a path was a pixel apart on the Mac and in the iOS Simulator (11/10).
let draw_changed = (r: Renderer, art: Texture, s: Sprite, source: Rect) -> void => {
  let w = s.width * s.scale
  let h = s.height * s.scale
  let place = Rect {
    x: f32(s.x.floor()) + (s.width - w) / 2.0,
    y: f32(s.y.floor()) + (s.height - h) / 2.0,
    w: w,
    h: h
  }
  set_texture_alpha(art, u8((s.alpha.min(1.0) * 255.0).round()))
  set_texture_color(
    art,
    rgb(u8((s.tint >> 16) & 0xFF), u8((s.tint >> 8) & 0xFF), u8(s.tint & 0xFF))
  )
  set_texture_blend(art, if s.additive { BLEND_ADD } else { BLEND_ALPHA })
  draw_texture_rotated(r, art, source, place, f64(s.angle), flips(s.flip_x, s.flip_y))
  set_texture_alpha(art, 255)
  set_texture_color(art, rgb(255, 255, 255))
  set_texture_blend(art, BLEND_ALPHA)
}

impl Sprite {
  /// Whether the sprite is drawn as its art is: opaque as drawn, untinted, unturned, its own
  /// size, painted.
  let as_drawn = pure (self) -> bool =>
    self.alpha >= 1.0 &&
    self.tint == 0xFFFFFF &&
    !self.additive &&
    self.angle >= 0.0 && self.angle <= 0.0 &&
    self.scale >= 1.0 && self.scale <= 1.0
}

let flips = pure (x: bool, y: bool) -> i32 =>
  (if x { FLIP_HORIZONTAL } else { FLIP_NONE }) | (if y { FLIP_VERTICAL } else { FLIP_NONE })

/// The frame drawn so far, as a binary PPM at `path`: the screen's own pixels, red, green, blue
/// each — read back from the window, which may show it larger (a phone's, ×5), a pixel of the
/// screen taken from the middle of the square it was scaled to.
let write_ppm = (r: Renderer, path: string) -> bool => {
  let Some(frame_pixels) = r.read_pixels() else { return false }
  let scale = (frame_pixels.width / screen_width).min(frame_pixels.height / screen_height)
  let (
    w,
    h
  ) = if scale >= 1 { (
    screen_width,
    screen_height
  ) } else { (frame_pixels.width, frame_pixels.height) }
  let step = scale.max(1)
  let left = (frame_pixels.width - w * step) / 2
  let top = (frame_pixels.height - h * step) / 2
  var bytes: []u8 = []
  for c in "P6\n${w} ${h}\n255\n" { bytes.push(u8(i64(c))) }
  for y in 0..<h {
    for x in 0..<w {
      let p = frame_pixels.argb[(top + y * step + step / 2) * frame_pixels.width + left + x * step + step / 2]
      bytes.push(u8((p >> 16) & 0xFF))
      bytes.push(u8((p >> 8) & 0xFF))
      bytes.push(u8(p & 0xFF))
    }
  }
  write_bytes(path, bytes)
}

/// The screen's pad (`std.game.pad`'s [touch_layout]) over the frame, in the window's real
/// pixels rather than the screen's — so it can lie beside a game the window shows smaller,
/// as a phone's does: see-through squares, those held brighter, each with its letter.
let draw_touch_pad = (r: Renderer) -> void => {
  let (w, h) = r.output_size()
  r.set_logical_presentation(0, 0, PRESENT_DISABLED)
  r.set_draw_blend(BLEND_ALPHA)
  let layout = pad.touch_layout(f32(w), f32(h))
  let held = pad.read(1)
  for b in layout {
    if b.label == "" { continue }
    let lit = b.buttons != 0 && (held & b.buttons) == b.buttons
    r.set_draw_color(Color { r: 255, g: 255, b: 255, a: if lit { 110 } else { 45 } })
    r.fill_rect(Rect { x: b.x, y: b.y, w: b.width, h: b.height })
    r.set_draw_color(Color { r: 255, g: 255, b: 255, a: 150 })
    r.draw_rect(Rect { x: b.x, y: b.y, w: b.width, h: b.height })
    // The letter, SDL's 8-pixel font grown to a third of the button.
    let size = (b.height / 3.0).max(8.0)
    let grow = size / 8.0
    r.set_scale(grow, grow)
    let across = f32(b.label.len()) * 8.0
    r.debug_text(
      (b.x + b.width / 2.0) / grow - across / 2.0,
      (b.y + b.height / 2.0) / grow - 4.0,
      b.label
    )
    r.set_scale(1.0, 1.0)
  }
  r.set_draw_blend(BLEND_NONE)
  r.set_logical_presentation(i32(screen_width), i32(screen_height), presentation(fitting))
}

/// SDL's logical presentation for `fit`.
let presentation = pure (fit: Fit) -> i32 => match fit {
  Whole => PRESENT_INTEGER_SCALE,
  Letterbox => PRESENT_LETTERBOX,
  Stretch => PRESENT_STRETCH,
  Crop => PRESENT_OVERSCAN,
  Expand => PRESENT_LETTERBOX,
}
