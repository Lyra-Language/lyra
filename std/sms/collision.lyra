module std.sms.collision
//! Collision shapes on the Z80: `std.genesis.collision`'s, answer for answer, in 16 bits.
//!
//! ```
//! import std.sms.collision.{ Shape, Collider }
//!
//! const FEET: Shape = Shape { x: 3, y: 18, width: 10, height: 6 }
//! const ROCK: Shape = Shape { ellipse: true, x: 1, y: 1, width: 6, height: 6 }
//!
//! if FEET.overlaps(x, y, ROCK, rock_x, rock_y) { … }
//! ```
//!
//! **What it costs is what it was written against**: a place and a size are `i16`, so a world is
//! under 32 KB of pixels a side; a collider is read where it is, with no copy of it for each
//! test; and squares come from a table, so a circle, the usual ellipse, takes no
//! multiply at all. An ellipse held to 128 pixels a side, as Vega holds them, gets the table.
//!
//! **A map's cell is the Master System's word**: tile in the low nine bits, flipped across at
//! bit 9 and down at bit 10. Everything else about meeting, layers, bands and one-way colliders is
//! as `std.genesis.collision` says, and a test holds the two to the same answers.

/// A box, or the ellipse filling it, from its owner's top-left, in pixels.
pub struct Shape {
  ellipse: bool = false,
  x: i16,
  y: i16,
  width: i16,
  height: i16,
}

/// A shape on collision layers `layers`, looking for those in `mask`, one bit a layer;
/// `one_way`, met in a move only coming down onto it ([hits_map_moving]).
pub struct Collider {
  shape: Shape,
  layers: u16,
  mask: u16,
  one_way: bool = false,
}

/// The width of a band of a map's own colliders, as a shift: 64 pixels.
pub const BAND_SHIFT: i16 = 6

impl Collider {
  /// Whether this collider on something at (`ax`, `ay`) meets `b` on something at (`bx`,
  /// `by`): it looks for one of `b`'s layers, and their shapes overlap. One-sided.
  pub let meets = pure (
    self: ref,
    ax: i16,
    ay: i16,
    b: Collider,
    bx: i16,
    by: i16
  ) -> bool => (self.mask & b.layers) != 0 && self.shape.overlaps(ax, ay, b.shape, bx, by)

  /// The collider with its shape mirrored left to right on an owner `width` wide.
  pub let mirrored = pure (self, width: i16) -> Collider =>
    Collider { self | shape: self.shape.mirrored(width) }

  /// The collider with its shape flipped top to bottom on an owner `height` tall.
  pub let flipped = pure (self, height: i16) -> Collider =>
    Collider { self | shape: self.shape.flipped(height) }

  /// Whether this collider on something at (`x`, `y`) meets one of `others` it looks for:
  /// colliders placed in the world itself, at its origin.
  pub let hits_any<const P: i64> = pure (
    self: ref,
    x: i16,
    y: i16,
    others: ref [P]Collider
  ) -> bool => self.any_stops(x, y, y, false, others, 0, u16(others.len()))

  /// [hits_any] for something moved to (`x`, `y`) from (`x`, `from_y`): a one-way collider
  /// counts only when the move came down onto it.
  pub let hits_any_moving<const P: i64> = pure (
    self: ref,
    x: i16,
    y: i16,
    from_y: i16,
    others: ref [P]Collider
  ) -> bool => self.any_stops(x, y, from_y, true, others, 0, u16(others.len()))

  /// [hits_any] over colliders gathered by band: band `b`'s are `others[bands[b]]` up to
  /// `others[bands[b + 1]]`, every collider reaching into its 64 columns.
  pub let hits_banded<const B: i64, const P: i64> = pure (
    self: ref,
    x: i16,
    y: i16,
    bands: ref [B]u16,
    others: ref [P]Collider
  ) -> bool => self.banded_stops(x, y, y, false, bands, others)

  /// [hits_banded] for something moved to (`x`, `y`) from (`x`, `from_y`).
  pub let hits_banded_moving<const B: i64, const P: i64> = pure (
    self: ref,
    x: i16,
    y: i16,
    from_y: i16,
    bands: ref [B]u16,
    others: ref [P]Collider
  ) -> bool => self.banded_stops(x, y, from_y, true, bands, others)

  /// Whether this collider on something at (`x`, `y`) meets a shape it looks for on a tile
  /// of the map `cells`, `width` cells a row of name-table words, whose tile `first_tile`
  /// is the first of the tile set `starts` and `shapes` describe.
  pub let hits_map<const N: i64, const M: i64, const K: i64> = pure (
    self: ref,
    x: i16,
    y: i16,
    cells: ref [N]u16,
    width: u16,
    first_tile: u16,
    starts: ref [M]u16,
    shapes: ref [K]Collider
  ) -> bool => self.map_stops(x, y, y, false, cells, width, first_tile, starts, shapes)

  /// [hits_map] for something moved to (`x`, `y`) from (`x`, `from_y`).
  pub let hits_map_moving<const N: i64, const M: i64, const K: i64> = pure (
    self: ref,
    x: i16,
    y: i16,
    from_y: i16,
    cells: ref [N]u16,
    width: u16,
    first_tile: u16,
    starts: ref [M]u16,
    shapes: ref [K]Collider
  ) -> bool =>
    self.map_stops(x, y, from_y, true, cells, width, first_tile, starts, shapes)

  // ── Beneath ────────────────────────────────────────────────────────────────

  let banded_stops<const B: i64, const P: i64> = pure (
    self: ref,
    x: i16,
    y: i16,
    from_y: i16,
    moving: bool,
    bands: ref [B]u16,
    others: ref [P]Collider
  ) -> bool => {
    let last = i16(bands.len()) - 2
    let left = x + self.shape.x
    var band = (left >> BAND_SHIFT).clamp(0, last)
    let final = ((left + self.shape.width - 1) >> BAND_SHIFT).clamp(0, last)
    while band <= final {
      if self.any_stops(x, y, from_y, moving, others, bands[band], bands[band + 1]) {
        return true
      }
      band += 1
    }
    false
  }

  let any_stops<const P: i64> = pure (
    self: ref,
    x: i16,
    y: i16,
    from_y: i16,
    moving: bool,
    others: ref [P]Collider,
    first: u16,
    end: u16
  ) -> bool => {
    if self.shape.width <= 0 || self.shape.height <= 0 { return false }
    let left = x + self.shape.x
    let top = y + self.shape.y
    let right = left + self.shape.width
    let bottom = top + self.shape.height
    var k = first
    while k < end {
      if (self.mask & others[k].layers) != 0 && self.stopped_at(
        left,
        top,
        right,
        bottom,
        from_y - y,
        moving,
        others[k].shape.x,
        others[k].shape.y,
        others[k].shape.width,
        others[k].shape.height,
        others[k].shape.ellipse,
        others[k].one_way
      ) {
        return true
      }
      k += 1
    }
    false
  }

  let map_stops<const N: i64, const M: i64, const K: i64> = pure (
    self: ref,
    x: i16,
    y: i16,
    from_y: i16,
    moving: bool,
    cells: ref [N]u16,
    width: u16,
    first_tile: u16,
    starts: ref [M]u16,
    shapes: ref [K]Collider
  ) -> bool => {
    // Tiles that carry no shapes at all, a map whose collision is its own, meet nothing.
    if starts[starts.len() - 1] == 0 { return false }
    if self.shape.width <= 0 || self.shape.height <= 0 { return false }
    let left = x + self.shape.x
    let top = y + self.shape.y
    let right = left + self.shape.width
    let bottom = top + self.shape.height
    let tiles = i16(starts.len()) - 1
    let first_column = (left >> 3).max(0)
    let last_column = ((right - 1) >> 3).min(i16(width) - 1)
    let last_row = (bottom - 1) >> 3
    var row = (top >> 3).max(0)
    var start = u16(row) * width
    while row <= last_row && i64(start) < cells.len() {
      var column = first_column
      while column <= last_column {
        let word = cells[start + u16(column)]
        let tile = i16(word & 0x1FF) - i16(first_tile)
        if tile >= 0 && tile < tiles {
          let pixel_x = column << 3
          let pixel_y = row << 3
          var k = starts[tile]
          let end = starts[tile + 1]
          while k < end {
            if (self.mask & shapes[k].layers) != 0 {
              let sx = shapes[k].shape.x
              let sy = shapes[k].shape.y
              let sw = shapes[k].shape.width
              let sh = shapes[k].shape.height
              // Flipped as the cell says: a shape's place within its 8×8 tile.
              let at_x = if (word & 0x200) != 0 { 8 - sx - sw } else { sx }
              let at_y = if (word & 0x400) != 0 { 8 - sy - sh } else { sy }
              if self.stopped_at(
                left,
                top,
                right,
                bottom,
                from_y - y,
                moving,
                pixel_x + at_x,
                pixel_y + at_y,
                sw,
                sh,
                shapes[k].shape.ellipse,
                shapes[k].one_way
              ) {
                return true
              }
            }
            k += 1
          }
        }
        column += 1
      }
      start += width
      row += 1
    }
    false
  }

  /// Whether this collider's rectangle, as given, is stopped by a shape at that place: it
  /// overlaps, and is not a one-way collider this move did not come down onto. `back` is how
  /// far the move came, `from_y - y`.
  let stopped_at = pure (
    self: ref,
    left: i16,
    top: i16,
    right: i16,
    bottom: i16,
    back: i16,
    moving: bool,
    ox: i16,
    oy: i16,
    ow: i16,
    oh: i16,
    oellipse: bool,
    one_way: bool
  ) -> bool => {
    if ow <= 0 || oh <= 0 { return false }
    let o_right = ox + ow
    let o_bottom = oy + oh
    if ox >= right || o_right <= left || oy >= bottom || o_bottom <= top { return false }
    if (self.shape.ellipse || oellipse) && !self.rounds_meet(
      left,
      top,
      ox,
      oy,
      ow,
      oh,
      oellipse
    ) {
      return false
    }
    if !one_way || !moving { return true }
    // Coming down onto it: above and clear of it where the move began.
    if back >= 0 { return false }
    let was_top = top + back
    let clear = ox >= right ||
      o_right <= left ||
      oy >= was_top + self.shape.height ||
      o_bottom <= was_top
    clear || ((self.shape.ellipse || oellipse) && !self.rounds_meet(
      left,
      was_top,
      ox,
      oy,
      ow,
      oh,
      oellipse
    ))
  }

  /// [rounds_meet] for the collider's shape at (`left`, `top`).
  let rounds_meet = pure (
    self: ref,
    left: i16,
    top: i16,
    ox: i16,
    oy: i16,
    ow: i16,
    oh: i16,
    oellipse: bool
  ) -> bool =>
    ellipses_meet(
      left,
      top,
      self.shape.width,
      self.shape.height,
      self.shape.ellipse,
      ox,
      oy,
      ow,
      oh,
      oellipse
    )
}

impl Shape {
  /// Whether this shape on something at (`ax`, `ay`) overlaps `b` on something at (`bx`, `by`).
  /// Shapes that only touch do not, and a shape with no area meets nothing.
  pub let overlaps = pure (
    self,
    ax: i16,
    ay: i16,
    b: Shape,
    bx: i16,
    by: i16
  ) -> bool => {
    if self.width <= 0 || self.height <= 0 || b.width <= 0 || b.height <= 0 { return false }
    let a_left = ax + self.x
    let a_top = ay + self.y
    let b_left = bx + b.x
    let b_top = by + b.y
    if a_left >= b_left + b.width || b_left >= a_left + self.width || a_top >= b_top + b.height || b_top >= a_top + self.height {
      return false
    }
    if !self.ellipse && !b.ellipse { return true }
    ellipses_meet(
      a_left,
      a_top,
      self.width,
      self.height,
      self.ellipse,
      b_left,
      b_top,
      b.width,
      b.height,
      b.ellipse
    )
  }

  /// The shape mirrored left to right on an owner `width` wide.
  pub let mirrored = pure (self, width: i16) -> Shape =>
    Shape { self | x: width - self.x - self.width }

  /// The shape flipped top to bottom on an owner `height` tall.
  pub let flipped = pure (self, height: i16) -> Shape =>
    Shape { self | y: height - self.y - self.height }
}

// ── Beneath ──────────────────────────────────────────────────────────────────

/// Two rectangles already known to overlap, one or both of them round. Coordinates are doubled so
/// a centre and a radius are whole, and taken from the first's corner, so they stay small.
let ellipses_meet = pure (
  a_left: i16,
  a_top: i16,
  a_width: i16,
  a_height: i16,
  a_ellipse: bool,
  b_left: i16,
  b_top: i16,
  b_width: i16,
  b_height: i16,
  b_ellipse: bool
) -> bool => {
  let bx = b_left - a_left
  let by = b_top - a_top
  if a_ellipse && b_ellipse {
    // As one ellipse with the summed radii, about the difference of the centres.
    let dx = (a_width - (bx * 2 + b_width)) / 2
    let dy = (a_height - (by * 2 + b_height)) / 2
    return inside(dx, dy, (a_width + b_width) / 2, (a_height + b_height) / 2)
  }
  if a_ellipse {
    let nearest_x = a_width.clamp(bx * 2, (bx + b_width) * 2)
    let nearest_y = a_height.clamp(by * 2, (by + b_height) * 2)
    return inside(nearest_x - a_width, nearest_y - a_height, a_width, a_height)
  }
  let cx = bx * 2 + b_width
  let cy = by * 2 + b_height
  let nearest_x = cx.clamp(0, a_width * 2)
  let nearest_y = cy.clamp(0, a_height * 2)
  inside(nearest_x - cx, nearest_y - cy, b_width, b_height)
}

/// `dx²·ry² + dy²·rx² < rx²·ry²`: whether a point is inside an ellipse about the origin. Past a
/// radius it is not, whatever the other axis says, which leaves numbers the table holds.
let inside = pure (dx: i16, dy: i16, rx: i16, ry: i16) -> bool => {
  let ax = dx.abs()
  let ay = dy.abs()
  if ax >= rx || ay >= ry { return false }
  if rx > LARGEST_SQUARE || ry > LARGEST_SQUARE {
    let (wx, wy, wrx, wry) = (i32(ax), i32(ay), i32(rx), i32(ry))
    return wx * wx * wry * wry + wy * wy * wrx * wrx < wrx * wrx * wry * wry
  }
  // A circle: the radius² on both sides of every term cancels.
  if rx == ry { return SQUARES[ax] + SQUARES[ay] < SQUARES[rx] }
  let rx2 = u32(SQUARES[rx])
  let ry2 = u32(SQUARES[ry])
  u32(SQUARES[ax])
    .wrapping_mul(ry2)
    .wrapping_add(u32(SQUARES[ay]).wrapping_mul(rx2)) < rx2.wrapping_mul(ry2)
}

const LARGEST_SQUARE: i16 = 128

/// n² for n up to [LARGEST_SQUARE].
const SQUARES: [129]u16 = #[
  0, 1, 4, 9, 16, 25, 36, 49, 64, 81, 100, 121,
  144, 169, 196, 225, 256, 289, 324, 361, 400, 441, 484, 529,
  576, 625, 676, 729, 784, 841, 900, 961, 1024, 1089, 1156, 1225,
  1296, 1369, 1444, 1521, 1600, 1681, 1764, 1849, 1936, 2025, 2116, 2209,
  2304, 2401, 2500, 2601, 2704, 2809, 2916, 3025, 3136, 3249, 3364, 3481,
  3600, 3721, 3844, 3969, 4096, 4225, 4356, 4489, 4624, 4761, 4900, 5041,
  5184, 5329, 5476, 5625, 5776, 5929, 6084, 6241, 6400, 6561, 6724, 6889,
  7056, 7225, 7396, 7569, 7744, 7921, 8100, 8281, 8464, 8649, 8836, 9025,
  9216, 9409, 9604, 9801, 10000, 10201, 10404, 10609, 10816, 11025, 11236, 11449,
  11664, 11881, 12100, 12321, 12544, 12769, 12996, 13225, 13456, 13689, 13924, 14161,
  14400, 14641, 14884, 15129, 15376, 15625, 15876, 16129, 16384,
]
