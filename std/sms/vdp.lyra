module std.sms.vdp
//! The Master System's video chip (and the Game Gear's), in its mode 4: a 32×28 name table at
//! 3800 of tiles from pattern memory, up to 64 sprites, two palettes of sixteen.
//!
//! ```
//! import std.sms.vdp
//!
//! vdp.init()
//! vdp.load_palette(16, SPRITE_COLORS)
//! vdp.load_tiles(1, HERO)
//! vdp.set_sprite(0, x, y, 1)
//! vdp.end_sprites(1)
//! vdp.show()
//! ```
//!
//! **Sprites are shown from the list here**, in RAM: `set_sprite` changes it, and `send_sprites`
//! copies it to the chip, which must be in the vertical blank: call it just after `wait_vblank`.
//! It writes as fast as the Z80 can, too fast for the chip with the display showing. The other
//! writes here are slow enough at any time (at least 26 T-states apart).

/// The ports. Status is read from the control port; reading it also clears the frame flag.
const DATA_PORT: u8 = 0xBE
const CONTROL_PORT: u8 = 0xBF

/// A control word's top bits: what the address after them is for.
const WRITE_VRAM: u8 = 0x40
const WRITE_REGISTER: u8 = 0x80
const WRITE_CRAM: u8 = 0xC0

/// Where the tables are, as `init` sets them.
const NAME_TABLE: u16 = 0x3800
const SPRITE_TABLE: u16 = 0x3F00

/// A sprite's y that ends the list, for the chip.
const END_OF_LIST: u8 = 0xD0

/// Register 1's bits.
const DISPLAY_OFF: u8 = 0x80
const DISPLAY_ON: u8 = 0xC0
const INTERRUPT_ON: u8 = 0x20
const TALL: u8 = 0x02
/// Register 0's: the leftmost column blank, which hides the seam of scrolling.
const MODE_4: u8 = 0x04
const HIDE_LEFT_COLUMN: u8 = 0x20

/// The hardware's sprite count.
pub const SPRITES: u8 = 64

/// Frames a second on an NTSC Master System and on a Game Gear — the game's updates, a
/// frame each, as `std.genesis.vdp`'s. A time in milliseconds is
/// `ms * UPDATES_PER_SECOND / 1000` frames. (A PAL Master System's 50 is not built.)
pub const UPDATES_PER_SECOND: i16 = 60

/// The screen, in pixels. A Game Gear shows the window of it from (48, 24), 160×144.
pub const SCREEN_WIDTH: i16 = 256
pub const SCREEN_HEIGHT: i16 = 192

/// The one plane, as `std.genesis.vdp` names its two so a game's calls read the same: a map
/// into either is a map into this one.
pub const PLANE_A: u16 = NAME_TABLE
pub const PLANE_B: u16 = NAME_TABLE
pub const PLANE_WIDTH: u16 = 32
pub const PLANE_HEIGHT: u16 = 28

/// Register 1's bits but the display's.
var mode: u8 = 0

/// The list: every sprite's y, then its x and tile in pairs, as the chip's table has them, and
/// how many are shown.
var sprite_ys: [65]u8 = #[END_OF_LIST; 65]
var sprite_pairs: [128]u8 = #[0; 128]
var sprite_count: u8 = 0

/// Mode 4, the display off, the tables where this module has them and every memory cleared.
pub let init = () -> void => {
  set_register(0, 0x04)
  set_register(1, DISPLAY_OFF)
  set_register(2, 0xFF)
  set_register(3, 0xFF)
  set_register(4, 0xFF)
  set_register(5, 0xFF)
  set_register(6, 0xFB)
  set_register(7, 0)
  set_register(8, 0)
  set_register(9, 0)
  set_register(10, 0xFF)
  vram_address(0)
  var left: u16 = 0x4000
  while left > 0 {
    data(0)
    left -= 1
  }
  end_sprites(0)
  send_sprites()
}

/// The display on, showing what has been loaded.
pub let show = () -> void => { set_register(1, DISPLAY_ON | mode) }

/// `show`, as `std.genesis.vdp` calls it.
pub let display_on = () -> void => show()

/// The display off: video memory may be written as fast as the Z80 can.
pub let display_off = () -> void => { set_register(1, DISPLAY_OFF | mode) }

/// Sprites are 8×16: each names an even tile and shows it and the next.
pub let tall_sprites = () -> void => { mode = mode | TALL }

/// The plane scrolled so that (`x`, `y`) of it is the screen's top-left. Call in the vertical
/// blank. `plane` is for calls that read as the Genesis's; there is one.
pub let set_scroll = (_plane: u16, x: i16, y: i16) -> void => {
  set_register(0, MODE_4 | HIDE_LEFT_COLUMN)
  // The chip's horizontal scroll moves the picture right, and wraps at 256.
  set_register(8, u8((0 - x) & 0xFF))
  // Its 28 rows wrap, and a world is nearly always within two of them: no divide for that.
  var row = u16(y)
  while row >= 224 { row -= 224 }
  set_register(9, u8(row))
}

/// For calls that read as the Genesis's. A game here that waits on [wait_vblank] needs neither;
/// one that takes [enable_vblank_interrupt] must leave video memory to its handler alone, as
/// an interrupt inside a write's two control bytes spoils the address.
pub let hold_vblank = pure () -> bool => false
pub let release_vblank = pure (_held: bool) -> void => {}

/// Colours from slot `first` on (16 is the sprites' palette), one byte each: `--BBGGRR`.
pub let load_palette<const N: i64> = (first: u8, colors: ref [N]u8) -> void => {
  control(first)
  control(WRITE_CRAM)
  for color in colors { data(color) }
}

/// The colour an empty screen shows: colour 0 of the background's palette. Call in the vertical
/// blank, or a line of the old colour may show.
pub let set_backdrop = (color: u8) -> void => {
  control(0)
  control(WRITE_CRAM)
  data(color)
}

/// Tiles from pattern `first` on, 32 bytes each, as fast as the Z80 writes: with the display off.
pub let load_tiles<const N: i64> = (first: u16, tiles: ref [N]u8) -> void => unsafe {
  vram_address(first * 32)
  var at: u16 = 0
  var left = u16(tiles.len())
  while left > 0 {
    let chunk = left.min(255)
    port_write_bytes(DATA_PORT, &tiles[at], u8(chunk))
    at += chunk
    left -= chunk
  }
}

/// A map's name-table words into the plane, from its cell (`left`, `top`) on — the whole plane's
/// worth, so with the display off or a little at a time. `plane` is for calls that read as the
/// Genesis's.
pub let write_plane<const N: i64> = (
  _plane: u16,
  cells: ref [N]u16,
  width: u16,
  left: u16 = 0,
  top: u16 = 0
) -> void => {
  var start = top * width
  var row: u16 = 0
  while row < PLANE_HEIGHT {
    vram_address(NAME_TABLE + row * PLANE_WIDTH * 2)
    var column: u16 = 0
    while column < PLANE_WIDTH {
      let x = left + column
      let at = start + x
      if x < width && i64(at) < cells.len() { write_word(cells[at]) } else { write_word(0) }
      column += 1
    }
    start += width
    row += 1
  }
}

/// One cell of the plane set to a name-table word: `flip_y << 10 | flip_x << 9 | tile`, and
/// `priority << 12 | palette << 11`. `x` and `y` wrap at its edges.
pub let write_cell = (_plane: u16, x: u16, y: u16, word: u16) -> void => {
  vram_address(NAME_TABLE + ((y % PLANE_HEIGHT) * PLANE_WIDTH + x % PLANE_WIDTH) * 2)
  write_word(word)
}

/// Where the next [write_word] goes in video memory.
pub let set_vram_address = (address: u16) -> void => vram_address(address)

/// A word into video memory, low byte first.
pub let write_word = (word: u16) -> void => {
  data(u8(word & 0xFF))
  data(u8(word >> 8))
}

/// The name table's cell at (`x`, `y`) shows tile `tile`.
pub let set_cell = (x: u8, y: u8, tile: u8) -> void => {
  vram_address(NAME_TABLE + u16(y) * 64 + u16(x) * 2)
  data(tile)
  data(0)
}

/// Sprite `index` at (`x`, `y`) on the screen, showing `tile`.
pub let set_sprite = (index: u8, x: u8, y: u8, tile: u8) -> void => {
  // The chip draws a sprite a line below its y.
  sprite_ys[index] = y.wrapping_sub(1)
  let at = index * 2
  sprite_pairs[at] = x
  sprite_pairs[at + 1] = tile
}

/// Sprites from `index` on are not shown.
pub let end_sprites = (index: u8) -> void => {
  sprite_count = index
  sprite_ys[index] = END_OF_LIST
}

/// The chip interrupts at each vertical blank, and an `@interrupt(vblank)` function runs. The
/// display goes on with it, as both are in one register.
pub let interrupt_each_frame = () -> void => { set_register(
  1,
  DISPLAY_ON | INTERRUPT_ON | mode
) }

/// `interrupt_each_frame`, as `std.genesis.vdp` calls it.
pub let enable_vblank_interrupt = () -> void => interrupt_each_frame()

/// Wait for the next vertical blank, by the status port's frame flag.
pub let wait_vblank = () -> void => unsafe {
  let _ = port_read(CONTROL_PORT)
  while port_read(CONTROL_PORT) & 0x80 == 0 {}
}

/// The list to the chip's table, as much of it as is shown. Call in the vertical blank.
pub let send_sprites = () -> void => unsafe {
  vram_address(SPRITE_TABLE)
  // With every sprite shown there is no end to write; the 65th y is past the table's 64.
  let ys = if sprite_count == SPRITES { SPRITES } else { sprite_count + 1 }
  port_write_bytes(DATA_PORT, &sprite_ys[0], ys)
  if sprite_count > 0 {
    vram_address(SPRITE_TABLE + 128)
    port_write_bytes(DATA_PORT, &sprite_pairs[0], sprite_count * 2)
  } else {}
}

let set_register = (register: u8, value: u8) -> void => {
  control(value)
  control(WRITE_REGISTER | register)
}

let vram_address = (address: u16) -> void => {
  control(u8(address & 0xFF))
  control(WRITE_VRAM | u8(address >> 8))
}

let control = (value: u8) -> void => unsafe { port_write(CONTROL_PORT, value) }
let data = (value: u8) -> void => unsafe { port_write(DATA_PORT, value) }
