module std.tui

//! Building terminal user interfaces: input events, screen and cursor control, colour.
//!
//! Three builtins do what the language cannot otherwise reach — `set_raw_mode`,
//! `read_key`, `terminal_size` — and everything here is ordinary Lyra on top of them.
//! That split is the standard library's usual one: the syscall is primitive, the
//! interpretation is not.
//!
//! Output needed no builtin at all, because `\e` reaches stdout as byte 27, so every
//! escape sequence in `screen.lyra`, `style.lyra` and `mouse.lyra` is just a string.
//! **Mouse input needed none either**, which is the surprising part: a terminal reports
//! clicks as escape sequences on stdin, so enabling it is a `print` and receiving it is
//! `read_key`.
//!
//! # Examples
//!
//! ```
//! set_raw_mode(true);
//! alt_screen_enter();
//! mouse_enable();
//! var events = event_reader();
//! var running = true;
//! for running {
//!   match events.next_event() {
//!     Some(Keyboard(Char c)) => { running = i64(c) != 113 },
//!     Some(Keyboard(Up)) => println("up"),
//!     Some(Mouse(m)) => println("click at ${m.col},${m.row}"),
//!     Some(_) => { },
//!     None => { running = false }
//!   }
//! }
//! mouse_disable();
//! alt_screen_leave();
//! set_raw_mode(false);
//! ```

// The input stream and its decoder.
//
// Terminal input is **one stream**: keys and mouse reports arrive interleaved on the same
// file descriptor, told apart only by their bytes. So there is one reader and one state
// machine, and `next_event` rather than a `next_key` that would have to lie about what it
// can return.

/// Something that happened at the terminal.
pub data Event =
  /// A keypress.
  Keyboard Key
  /// A mouse button, wheel notch or drag — only ever produced after `mouse_enable`.
  | Mouse MouseEvent

/// A terminal input reader.
///
/// It exists to hold one code point of lookahead, which the Escape ambiguity forces:
/// recognizing `\e[A` means reading past the `\e`, and when what follows turns out *not*
/// to be a sequence, that key has already been consumed and has to go somewhere. Without
/// this it would simply be dropped.
pub struct EventReader {
  /// A code point read while looking for an escape sequence and found not to be part of
  /// one. The next read takes it instead of going to the terminal.
  pending: Maybe<rune>
}

/// A fresh reader with nothing buffered.
pub let event_reader = pure () -> EventReader => EventReader { pending: None }

/// The next event, or `None` once input has ended.
///
/// # Panics
///
/// Never traps. `None` is the end of input, exactly as it is for `read_key`.
///
/// **A lone Escape is reported immediately** as of 08/17. `\e` begins every arrow,
/// navigation key and mouse report, so on reading one this must look at what follows to
/// know what it has — and with only a blocking read that meant waiting for the user's
/// *next* keypress, so Escape arrived one key late. `wait_for_key_ms` resolves it: if
/// nothing follows the `\e` within `escape_timeout_ms`, it was the Escape key.
///
/// The lookahead buffer is still needed and still does its job — a key that follows an
/// Escape too quickly to be a timeout is read, found not to be a sequence introducer, and
/// handed back on the next call rather than dropped.
pub let next_event = (self: mut EventReader) -> Maybe<Event> => {
  let first = match self.pending {
    Some(r) => { self.pending = None; Some(r) },
    None => read_key()
  }
  match first {
    None => None,
    Some(c) => if c == '\e' { self.decode_escape() } else { Some(Keyboard(classify(c))) }
  }
}

/// Decode what follows an `\e`, having already consumed it.
///
/// A sequence is `\e` then `[` or `O` then its body; anything else means the Escape was a
/// keypress of its own and the code point just read belongs to the *next* event, so it is
/// buffered rather than dropped.
let decode_escape = (self: mut EventReader) -> Maybe<Event> => {
  // Nothing following the `\e` within the window means it *was* the Escape key. This is
  // the one thing three builtins could not settle: without a timed read the only way to
  // find out is to block, which reports the Escape a keypress late.
  if !wait_for_key_ms(escape_timeout_ms) {
    Some(Keyboard(Escape))
  } else {
  match read_key() {
    // Input ended right after the Escape, so it was the last key pressed.
    None => Some(Keyboard(Escape)),
    Some(b) => {
      // `[` is the usual introducer; `O` is the "application cursor keys" mode some
      // terminals switch into, where an arrow is `\eOA` rather than `\e[A`. Both are
      // common enough that handling only one loses arrows on real terminals.
      if b == '[' || b == 'O' { decode_body() }
      else { self.pending = Some(b); Some(Keyboard(Escape)) }
    }
  }
  }
}

/// How long to wait for the code point after an `\e` before concluding that the Escape
/// was a keypress of its own.
///
/// 25ms is the conventional figure and the tradeoff is symmetric: too short and a
/// sequence arriving over a slow link is read as Escape-then-garbage; too long and the
/// Escape key feels sluggish. A local terminal delivers a whole sequence in well under a
/// millisecond, so this is generous by a wide margin.
const escape_timeout_ms = 25

/// Whether an event is ready to be read, waiting up to `timeout_ms` for one.
///
/// This is what lets a program do something *other* than wait for input — redraw on a
/// resize, animate, poll a clock — instead of blocking in `next_event` until a key
/// arrives.
///
/// It consults the lookahead buffer first, which a bare `wait_for_key_ms` cannot: a code
/// point already read and held here is an event that is ready even though the terminal
/// has nothing new to offer.
///
/// **True does not promise a key.** At end of input this answers true and the
/// `next_event` that follows answers `None` — which is the whole reason the underlying
/// builtin is a bool rather than a timed read returning `Maybe`: the two outcomes stay
/// distinguishable instead of collapsing into one `None`.
pub let event_available = (self: EventReader, timeout_ms: i64) -> bool =>
  match self.pending {
    Some(_) => true,
    None => wait_for_key_ms(timeout_ms)
  }

/// Decode a sequence body — the part after `\e[`.
///
/// Three shapes: a single final letter (`A`..`D` for the arrows, `H`/`F` for Home/End), a
/// decimal number terminated by `~` (`5~` for PageUp), or — after a `<` — an SGR mouse
/// report, which `mouse.lyra` takes over.
let decode_body = () -> Maybe<Event> => {
  match read_key() {
    None => Some(Keyboard(Escape)),
    Some(f) => {
      if f == '<' { decode_mouse() }
      else if is_digit(f) { decode_numeric(digit_value(f)) }
      else { Some(Keyboard(final_key(f))) }
    }
  }
}

/// Read a decimal number and the non-digit that ends it, as `(value, terminator)` with
/// the terminator's code point as an `i64`.
///
/// `None` means input ended mid-number, which is a truncated sequence rather than a key.
/// The terminator comes back as a **rune** because that is what the callers compare it
/// against: it is the `;`/`M`/`m` that says which field this was and, for a mouse report,
/// whether the button went down or up.
let read_number = () -> Maybe<(i64, rune)> => {
  var value = 0
  // Never observed: `ended` is what says there was no terminator, so this is only the
  // slot's initial contents. NUL because it is the code point no terminal sends.
  var term = '\x00'
  var done = false
  var ended = false
  for !done {
    match read_key() {
      None => { done = true; ended = true },
      Some(d) => {
        if is_digit(d) { value = value * 10 + digit_value(d) }
        else { term = d; done = true }
      }
    }
  }
  if ended { None } else { Some((value, term)) }
}
