module std.io
//! Files, over libc — the part of I/O that needs no builtin.
//!
//! `read_line` and the terminal builtins are the compiler's because a syscall is
//! primitive. A file is not: `open`, `read` and `close` are three `extern`s, and
//! everything else here is the arithmetic over them.
//!
//! **A directory is the exception, and it is worth saying why it is not a fourth
//! `extern`.** `readdir` answers a pointer to a `struct dirent`, and the name inside it
//! sits at an offset that differs by platform — 21 on macOS, 19 on Linux — while the
//! symbol itself differs too (x86_64 macOS resolves a bare `readdir` to the legacy
//! 32-bit-inode entry point, which links and reads the wrong field). Lyra source cannot
//! ask which platform it is being compiled for, so neither number can be written here at
//! all, and there is no struct-free directory call in libc to write instead. The crossing
//! is therefore the compiler's — the `dir_names` builtin, which answers exactly what libc
//! reported — and `read_dir` below is the arithmetic over it, the same split
//! `program_arg`/`program_args` has. Written the way `std.ffi` is
//! written — `unsafe` appears in this file so it need not appear at a call site — but not
//! *over* `std.ffi`, which costs nothing here: the two crossings are one builtin and one
//! address-of each.
//!
//! **The reason given for that until 09/22 was wrong**, and is corrected rather than
//! deleted because it was load-bearing for a decision. It said importing `std.ffi` would
//! bring its `get` into every program that also uses `std.collections`, whose `HashMap`
//! exports one too. A module's imports are its own: `std.env` imports `std.ffi`, and a
//! program importing `std.env` alongside `std.collections.{ get }` compiles — measured.
//! What is true is narrower: a *program* importing both names bare must rename one
//! (`import std.collections.{ get as … }`), which the clash error now says.
//!
//! ```
//! import std.io.{ read_file, write_file, append_file, read_stdin }
//!
//! match read_file("notes.txt") {
//!   Some(text) => print(text),
//!   None => println("cannot read notes.txt"),
//! }
//! ```

import std.path

/// The whole of the file at `path` as one string, or `None` if it cannot be opened —
/// missing, unreadable, a directory.
///
/// The bytes are read as UTF-8 without validation, as `read_line` reads libc's; a file
/// in another encoding decodes to a string whose length disagrees with its bytes.
///
/// `None` rather than an error value, because the one question a caller asks first is
/// "did it open", and the reason is what `errno` holds — reachable through an `extern`
/// when a program needs it, and not something this answers yet.
pub let read_file = (path: string) -> Maybe<string> => {
  let fd = unsafe { open(path.cstring_ptr(), O_RDONLY) }
  if fd < 0 { return None }
  let text = read_all(fd)
  unsafe { close(fd) }
  Some(text)
}

/// The whole of standard input as one string, read to end-of-file.
///
/// The counterpart of `read_file` for a program that takes its input from a pipe, so
/// the two sources hand the rest of the program one shape; `read_line` is the
/// line-at-a-time alternative for a program that answers as it reads. Newlines are kept
/// as they arrived. Blocks until the writer closes the pipe, or until Ctrl-D on a
/// terminal.
///
/// ```
/// let text = match args.value("-f") { Some(path) => read_file(path)?, None => read_stdin() }
/// ```
pub let read_stdin = () -> string => read_all(STDIN)

// Reads `fd` to end-of-file, a chunk at a time, and joins the chunks once — so a large
// input costs one copy rather than one per chunk. The reader for both sources above.
let read_all = (fd: i32) -> string => {
  var chunks: []string = []
  var buf: []u8 = [0; CHUNK]
  for {
    let n = unsafe { read(fd, &mut buf[0], u64(CHUNK)) }
    if n <= 0 { break }
    chunks.push(buf.slice(0, n).decode_utf8())
  }
  chunks.join("")
}

/// The names in the directory at `path`, sorted, without `.` and `..` — or `None` if the
/// directory cannot be opened (missing, unreadable, or a file rather than a directory).
///
/// Names only, not paths: joining them to `path` is the caller's, since a caller walking a
/// tree usually wants its own separator handling. Dotfiles are kept, because the file
/// system reports them and dropping them silently is a policy rather than a fact.
///
/// **Sorted, which the file system does not promise.** `readdir` answers in whatever order
/// the directory's on-disk structure gives, so two machines listing the same directory can
/// disagree — and a program that walks a tree to format, check or report is then not
/// reproducible. Sorting once here costs a comparison per entry against a `readdir` syscall
/// per entry, and buys an answer that is the same everywhere.
///
/// `None` rather than an empty array for a directory that cannot be read, on `read_file`'s
/// rule: an empty directory is a real answer (`Some([])`) and a missing one is not.
///
/// ```
/// let Some(names) = read_dir("src") else { return println("cannot list src") }
/// for name in names { println(name) }
/// ```
pub let read_dir = (path: string) -> Maybe<[]string> => {
  let Some(names) = dir_names(path) else { return None }
  Some([n in names | n != "." && n != ".." | n].sorted())
}

/// Whether `path` names a symbolic link — **the link itself, not what it points at**,
/// which is the one question `read_dir` cannot answer: `opendir` follows a link, so a
/// symlink to a directory reads exactly like the directory.
///
/// That distinction is what a walker needs. This repo's own `build/std` points back at
/// `std/`, so a walk that follows links formats every prelude file twice under two names;
/// a link into one of its own ancestors does not terminate at all. `false` for a path that
/// does not exist, which a caller about to read it will find out anyway.
///
/// Over `readlink` into a one-byte buffer: it answers the number of bytes it copied for a
/// link (every link has a non-empty target) and -1 for anything else, so the truncation is
/// the point rather than a limitation — nothing here wants the target.
///
/// ```
/// if !is_symlink(entry) { walk(entry) }
/// ```
pub let is_symlink = (path: string) -> bool => {
  var probe: []u8 = [0; 1]
  unsafe { readlink(path.cstring_ptr(), &mut probe[0], 1) } >= 0
}

/// Whether `path` can be executed — the question `copy_file` asks to decide what mode to
/// give a copy, and the only part of a file's mode this module can read.
///
/// **It is `access`, so it answers about *this process***: the real user's permission,
/// not the file's bits. For a file this program can read those coincide in every case
/// that matters here — a build copying files it owns — and where they do not, the honest
/// summary is that the copy will be executable exactly when the original was for you.
///
/// Reading the mode itself would mean `stat`, whose `st_mode` sits at an offset that
/// differs by platform *and* architecture, which `std.io` cannot write (see this module's
/// header on `dirent`). `access` answers this one question with no struct at all — the
/// same trade `is_symlink` makes with `readlink`, and the reason both are Lyra here
/// rather than builtins. `false` for a path that does not exist.
///
/// ```
/// if is_executable(script) { println("${script} runs") }
/// ```
pub let is_executable = (path: string) -> bool =>
  unsafe { access(path.cstring_ptr(), X_OK) } == 0

/// The file at `path` overwritten with `contents`, answering whether all of it landed.
///
/// The file is created if it does not exist (mode 0644, before the process umask) and
/// truncated if it does. `false` means the path could not be opened for writing or the
/// write was cut short — a full disk, a broken pipe — and in the second case the file is
/// left holding however much got through, which is what any writer that does not write
/// to a temporary and rename can promise.
///
/// Short writes are retried and an interior NUL is written like any other byte.
///
/// ```
/// if !write_file("notes.txt", "one\ntwo\n") { println("could not write notes.txt") }
/// ```
pub let write_file = (path: string, contents: string) -> bool => {
  let fd = unsafe { creat(path.cstring_ptr(), FILE_MODE) }
  if fd < 0 { return false }
  let landed = write_all(fd, contents)
  unsafe { close(fd) }
  landed
}

/// `contents` added to the end of the file at `path`, answering whether all of it landed.
///
/// The file is created if it does not exist — mode 0666 before the process umask, which is
/// what `fopen` gives, so usually `rw-r--r--` like `write_file`'s. `false` means as it does
/// there: the path could not be opened, or the write was cut short and the file holds
/// however much got through.
///
/// **Every write lands at the end**, even with another process appending to the same file,
/// since the descriptor is opened for appending rather than positioned at the end once.
///
/// ```
/// if !append_file("log.txt", "started\n") { println("could not write log.txt") }
/// ```
pub let append_file = (path: string, contents: string) -> bool => {
  let file = unsafe { fopen(path.cstring_ptr(), APPEND_MODE.cstring_ptr()) }
  if file == nullptr { return false }
  let landed = write_all(unsafe { fileno(file) }, contents)
  unsafe { fclose(file) }
  landed
}

// Writes all of `contents` to `fd`, answering whether every byte was taken. The writer for
// both `write_file` and `append_file`.
//
// **Every write loops.** `write` is permitted to take fewer bytes than it was offered, and
// a single call that assumed otherwise would truncate a large file at whatever boundary the
// kernel chose — silently, and only for files past some size.
//
// The bytes are the string's UTF-8, copied once into a buffer this can take the address of.
// The copy is what makes an interior NUL ordinary: a string may hold one, and the no-copy
// path to a string's bytes (`cstring_ptr`) is the one that refuses them.
let write_all = (fd: i32, contents: string) -> bool =>
  write_all_bytes(fd, contents.encode_utf8())

// The loop itself, over bytes — `write_all` for text and `write_bytes` for everything else
// share it, so there is one place a short write is retried.
let write_all_bytes = (fd: i32, bytes: []u8) -> bool => {
  var written = 0
  let total = bytes.len()
  for written < total {
    let n = unsafe { write(fd, &bytes[written], u64(total - written)) }
    if n <= 0 { break }
    written += n
  }
  written == total
}

/// Bytes per `read`. Big enough that a small file is one call, small enough not to matter.
const CHUNK = 65536

/// `O_RDONLY` is 0 on every platform Lyra targets.
const O_RDONLY: i32 = 0

/// `rw-r--r--`, the mode a new file is created with, before the process umask narrows it.
/// Written in octal's value because Lyra has no octal literal: 0644 is 6*64 + 4*8 + 4.
const FILE_MODE: u32 = 420

/// `access`'s "may I execute this" question. `X_OK` is 1 on every platform Lyra targets,
/// as are `R_OK` (4) and `W_OK` (2) beside it — the one POSIX access constant trio that
/// never varies.
const X_OK: i32 = 1

/// `rwxr-xr-x`: `FILE_MODE` with the three execute bits set, for a copy of an executable.
/// Octal 0755 as a value, on the rule FILE_MODE above states: 7*64 + 5*8 + 5.
const EXEC_MODE: u32 = 493

/// `fopen`'s mode for appending. A mode *string* is the one spelling of append that is the
/// same on every target; the `O_APPEND` flag behind it is not (see the externs below).
const APPEND_MODE = "a"

/// Standard input's descriptor.
const STDIN: i32 = 0

// File descriptors rather than `FILE *`: a raw pointer cannot be tested for null, an
// integer can be compared with -1. `open` is variadic in C (the mode, read only under
// `O_CREAT`), and is declared so, since the ABI for a variadic call differs.
// **`creat` rather than `open` with flags, and that is a portability rule rather than a
// shortcut.** `O_RDONLY` is 0 everywhere, which is why the read side needs no more; every
// other flag differs between the targets — measured 09/08, macOS against Linux:
// `O_CREAT` 512 vs 64, `O_TRUNC` 1024 vs 512, `O_APPEND` 8 vs 1024. A constant written
// here would not merely be wrong on the other platform, it would name a *different flag*
// that opens successfully and does something else. `creat(path, mode)` is defined as
// `open(path, O_WRONLY|O_CREAT|O_TRUNC, mode)` and carries no number to get wrong.
//
// **Appending goes through `fopen(path, "a")`**, which is `open` with `O_WRONLY|O_CREAT|
// O_APPEND` behind a mode string that is the same everywhere. The `FILE *` is used only to
// reach its descriptor (`fileno`) and to close it; nothing is written through stdio, so
// there is no buffer to flush. `FILE` stays opaque, carried as `^u8` and tested against
// `nullptr`.
//
// `mode_t` is 16 bits on macOS and 32 on Linux, so the parameter is written as the wider
// one: the value fits either, and aarch64 passes both in the same register with the
// callee reading the width it declared.
/// The whole of the file at `path` as bytes, or `None` if it cannot be opened.
///
/// **What `read_file` is for text, this is for everything else.** The bytes are the same
/// either way — a `string` here carries what it never decoded — but a program hashing a
/// file, or reading a header, is not holding text, and a value whose `len` counts runes
/// would be answering a question it was not asked. The type is the documentation.
pub let read_bytes = (path: string) -> Maybe<[]u8> => {
  let fd = unsafe { open(path.cstring_ptr(), O_RDONLY) }
  if fd < 0 { return None }
  var out: []u8 = []
  var buf: []u8 = [0; CHUNK]
  var failed = false
  for {
    let n = unsafe { read(fd, &mut buf[0], u64(CHUNK)) }
    if n == 0 { break }
    if n < 0 {
      failed = true
      break
    }
    for i in 0..<n { out.push(buf[i]) }
  }
  unsafe { close(fd) }
  if failed { None } else { Some(out) }
}

/// The file at `path` overwritten with `bytes`, answering whether all of them landed —
/// `write_file` for data that is not text, as `read_bytes` is `read_file`'s.
///
/// Created or truncated with `write_file`'s mode, and `false` on the same two failures:
/// the path could not be opened, or the write was cut short.
///
/// ```
/// if !write_bytes("tone.wav", wav) { println("could not write tone.wav") }
/// ```
pub let write_bytes = (path: string, bytes: []u8) -> bool => {
  let fd = unsafe { creat(path.cstring_ptr(), FILE_MODE) }
  if fd < 0 { return false }
  let landed = write_all_bytes(fd, bytes)
  unsafe { close(fd) }
  landed
}

/// Copies the file at `from` to `to`, byte for byte, answering whether it arrived.
///
/// **Bytes, never a string**, and that is the whole point of this function existing beside
/// `read_file` and `write_file`. Those two do copy a file's bytes intact — measured — but
/// they hand the program a `string` in between, and a `string` holding a PNG is a lie in
/// two directions: its `len` counts runes, so it disagrees with the file's size, and every
/// operation a string offers means nothing on it. A program copying an asset wants the
/// file moved, not decoded, and this is that sentence in the library rather than a comment
/// at each call site.
///
/// The destination is created or truncated with `write_file`'s mode, and then made
/// executable when the source was (`is_executable`) — so a copied script still runs,
/// which it did not before 09/22.
///
/// **The executable bit is the only part of the mode that is carried**, and that is a
/// limit worth stating rather than a rounding error. Copying the whole mode means reading
/// it, which means `stat`, whose `st_mode` offset differs by platform and architecture and
/// so cannot be written in this module at all (the module header's `dirent` note). A
/// group-writable or read-only source therefore arrives at 0644, and a caller who needs
/// the rest wants a `stat` builtin, not a wider guess here.
///
/// A failed `chmod` fails the copy. The bytes are on disk either way, but a copy that
/// silently answers `true` having dropped the bit is the bug this just fixed.
///
/// A partial `write` is retried, as `write_all` retries one: a short write is a fact about
/// the descriptor, not an error.
pub let copy_file = (from: string, to: string) -> bool => {
  let src = unsafe { open(from.cstring_ptr(), O_RDONLY) }
  if src < 0 { return false }
  let dst = unsafe { creat(to.cstring_ptr(), FILE_MODE) }
  if dst < 0 {
    unsafe { close(src) }
    return false
  }
  var buf: []u8 = [0; CHUNK]
  var moved = true
  for {
    let n = unsafe { read(src, &mut buf[0], u64(CHUNK)) }
    if n == 0 { break }
    if n < 0 {
      moved = false
      break
    }
    var written = 0
    for written < n {
      let put = unsafe { write(dst, &buf[written], u64(n - written)) }
      if put <= 0 { break }
      written += put
    }
    if written != n {
      moved = false
      break
    }
  }
  unsafe { close(src) }
  unsafe { close(dst) }
  // Asked of the source *after* the copy for no reason but order of reading; it is the
  // source's bit either way, and `creat` above already fixed the destination's.
  if moved && is_executable(from) {
    return unsafe { chmod(to.cstring_ptr(), EXEC_MODE) } == 0
  }
  moved
}

/// Creates the directory at `path` and every missing directory above it, answering
/// whether it exists afterwards.
///
/// **Already there counts as success**, which is what a caller means by "make sure this
/// exists": a build that writes into `build/docs` twice should not fail the second time.
/// That also stands in for the `errno` this module does not read — `mkdir` reports
/// "exists" and "refused" alike with -1, so what settles it is asking again whether the
/// directory can be read, the same test `read_dir` is for.
///
/// The parents are made first and one at a time, since `mkdir` makes one directory and
/// fails when its parent is missing.
///
/// ```
/// if !create_dir_all("build/docs/guide") { println("cannot make the output directory") }
/// ```
pub let create_dir_all = (path: string) -> bool => {
  if path.len() == 0 { return false }
  if read_dir(path).is_some() { return true }
  match path.parent() {
    Some(up) => if !create_dir_all(up) { return false },
    None => {},
  }
  // 0o755: readable and enterable by everyone, writable by the owner — what a build
  // directory is, and what the shell's own `mkdir` uses under the default umask.
  if unsafe { mkdir(path.cstring_ptr(), 0o755) } == 0 { return true }
  // -1 may mean "it appeared between the two calls" as easily as "refused", and the
  // question was only ever whether it is there now.
  read_dir(path).is_some()
}

unsafe extern open: (path: ^u8, flags: i32, ...) -> i32
unsafe extern creat: (path: ^u8, mode: u32) -> i32
unsafe extern mkdir: (path: ^u8, mode: u32) -> i32
unsafe extern read: (fd: i32, buf: ^mut u8, count: u64) -> i64
unsafe extern write: (fd: i32, buf: ^u8, count: u64) -> i64
unsafe extern close: (fd: i32) -> i32
unsafe extern fopen: (path: ^u8, mode: ^u8) -> ^u8
unsafe extern fileno: (file: ^u8) -> i32
unsafe extern fclose: (file: ^u8) -> i32
// `readlink` carries no platform-dependent number and no struct — which is exactly why the
// symlink test is here in Lyra while the directory *read* is a builtin: `ssize_t` is `i64`
// and `size_t` is `u64` under the LP64 assumption `read` and `write` above already make.
unsafe extern readlink: (path: ^u8, buf: ^mut u8, size: u64) -> i64
// `access` and `chmod` are struct-free for the same reason, which is what keeps the
// executable bit out of the compiler: `stat` would answer the *whole* mode and cost a
// platform-dependent field offset, the `dirent` problem again.
unsafe extern access: (path: ^u8, mode: i32) -> i32
unsafe extern chmod: (path: ^u8, mode: u32) -> i32
