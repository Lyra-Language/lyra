module std.prelude

// The prelude: implicitly imported into every file, so everything declared here is
// reachable unqualified and without an `import`.
//
// It is an ordinary module — the compiler resolves it through the same search roots as
// any other, and it compiles standalone (it does not import itself). Nothing here is
// special-cased in the compiler, which is what lets it be read, tested and replaced.
//
// Four constraints worth knowing before adding to it:
//
//   - **Exports need `pub`.** A declaration without it is private to this module, and
//     a reference from elsewhere is lyra-E028.
//
//   - **`Maybe` and `Result` are shape-validated** by the `@builtin(…)` attribute that
//     gives them their compiler-known identity: `Maybe` takes one generic parameter with
//     `Some` (one payload) and `None` (none); `Result` takes two with `Ok` (one) and
//     `Err` (one). The names are free — the marker confers the identity, not the
//     spelling — but the arities are not. **The argument is not optional:** a bare
//     `@builtin` collects as no marker at all, and the type then gets its identity only
//     from the fallback that reads the literal name `Maybe`/`Result`, which is precisely
//     the coupling to spelling the marker exists to remove.
//
//   - **Write free functions, not trait impls** — and name the receiver `self`, which is
//     what makes `m.unwrap_or(0)` work as well as `unwrap_or(m, 0)` (UFCS, 08/03). The
//     method spelling costs nothing: it is rewritten to the call form before anything
//     downstream sees it.
//
//     A trait impl is the thing to avoid here. It type-checks, and a *generic* one — which
//     every combinator below would be — then fails in the backend, because an impl method's
//     body is not specialized per instantiation ("match on Maybe<t> not implemented yet").
//     A non-generic impl method does lower; this file has no use for one. The note that
//     used to sit here said no method lowered at all, which stopped being true on 07/30.
//
//   - **A name may be declared twice, if the two take different receivers** — receiver-keyed
//     overloading (08/03). Both declarations must take a `self` parameter and their receiver
//     types must have different *heads*: `Maybe<t>` beside `Result<t,e>` is fine, a second
//     `Maybe<…>` is refused where it is written. That is what lets `unwrap_or` below mean
//     both types rather than one of them getting a name the other did not need. Everything
//     else about a redeclaration is unchanged — two functions without receivers are the
//     error they always were.
//
// A name declared here can be shadowed by user code: that warns (lyra-W012) and the
// user's declaration wins, so adding a name here cannot break a program that never
// mentioned it. The shadow is confined to the module that declared it — another module
// still gets the version below — and since 08/01 that holds for a **type** or **trait**
// too, which used to be replaced program-wide.
//
// Note what a shadow still means for the module that makes one: the markers below claim
// the canonical kinds, so a user's own same-named `Maybe` is an ordinary type, and `?` on
// it reports "`?` operand must be a Result or Maybe, got Maybe". That no longer reaches a
// module which never mentioned `Maybe` — which is what made it indefensible — but the
// message is still poor for the module that did. See todo.md.

@builtin(Maybe)
pub data Maybe<t> = None | Some t

pub let unwrap_or<t> = pure noalloc (self: Maybe<t>, fallback: t) -> t => match self {
  Some v => v,
  None => fallback,
}

pub let unwrap_or_else<t> = pure noalloc (self: Maybe<t>, f: () -> t) -> t => match self {
  Some v => v,
  None => f(),
}

pub let expect<t> = pure noalloc (self: Maybe<t>, msg: string) -> t => match self {
  Some v => v,
  None => panic(msg),
}

pub let unwrap<t> = pure noalloc (self: Maybe<t>) -> t => expect(self, "unwrap on a None")

pub let is_some<t> = pure noalloc (self: Maybe<t>) -> bool => match self {
  Some _ => true,
  None => false,
}

pub let is_none<t> = pure noalloc (self: Maybe<t>) -> bool => match self {
  Some _ => false,
  None => true,
}

pub let ok_or<t,e> = pure noalloc (self: Maybe<t>, err: e) -> Result<t,e> => match self {
  Some v => Ok v,
  None => Err err,
}

pub let ok_or_else<t,e> = pure noalloc (self: Maybe<t>, f: () -> e) -> Result<t,e> => match self {
  Some v => Ok v,
  None => Err(f()),
}

pub let map<t,u> = pure noalloc (self: Maybe<t>, f: (t) -> u) -> Maybe<u> => match self {
  Some v => Some(f(v)),
  None => None,
}

pub let flat_map<t,u> = pure noalloc (self: Maybe<t>, f: (t) -> Maybe<u>) -> Maybe<u> => match self {
  Some v => f(v),
  None => None,
}

// `filter` has no `Result` counterpart, and deliberately: rejecting an `Ok` would have to
// invent the `e` to fail with, which only the caller can supply — that is `ok_or`'s job,
// not this one's. A name declared once here is an ordinary prelude name, not a set.
pub let filter<t> = pure noalloc (self: Maybe<t>, predicate: (t) -> bool) -> Maybe<t> => match self {
  Some v => if predicate(v) { Some v } else { None },
  None => None,
}

@builtin(Result)
pub data Result<t, e> = Ok(t) | Err(e)

pub let is_ok<t,e> = pure noalloc (self: Result<t, e>) -> bool => match self {
  Ok _ => true,
  Err _ => false,
}

pub let is_err<t,e> = pure noalloc (self: Result<t, e>) -> bool => match self {
  Ok _ => false,
  Err _ => true,
}

pub let unwrap_or<t,e> = pure noalloc (self: Result<t,e>, fallback: t) -> t => match self {
  Ok v => v,
  Err _ => fallback,
}

pub let unwrap_or_else<t,e> = pure noalloc (self: Result<t,e>, f: () -> t) -> t => match self {
  Ok v => v,
  Err _ => f(),
}

pub let expect<t,e> = pure noalloc (self: Result<t,e>, msg: string) -> t => match self {
  Ok v => v,
  Err _ => panic(msg),
}

pub let unwrap<t,e> = pure noalloc (self: Result<t,e>) -> t => expect(self, "unwrap on an Err")

pub let ok<t,e> = pure noalloc (self: Result<t,e>) -> Maybe<t> => match self {
  Ok v => Some v,
  Err _ => None,
}

pub let err<t,e> = pure noalloc (self: Result<t,e>) -> Maybe<e> => match self {
  Ok _ => None,
  Err err => Some err,
}

pub let map<t,u,e> = pure noalloc (self: Result<t,e>, f: (t) -> u) -> Result<u,e> => match self {
  Ok v => Ok(f(v)),
  Err err => Err err,
}

pub let flat_map<t,u,e> = pure noalloc (self: Result<t,e>, f: (t) -> Result<u,e>) -> Result<u,e> => match self {
  Ok v => f(v),
  Err err => Err err,
}

pub let filter<t,e> = pure noalloc (self: Result<t,e>, predicate: (t) -> bool) -> Maybe<t> => match self {
  Ok v => if predicate(v) { Some v } else { None },
  Err _ => None,
}

pub let map<t,u> = pure (self: []t, f: (t) -> u) -> []u => [x in self | f(x)]

pub let filter<t> = pure (self: []t, predicate: (t) -> bool) -> []t => [x in self | predicate(x) | x]

// Parse a base-10 `i64`, with an optional leading `+`/`-`. `None` for anything
// that is not exactly a number: an empty string, a lone sign, a stray character,
// surrounding whitespace, or a value outside the i64 range. Strict on purpose —
// the caller asked whether this *is* a number, and "1abc" is not one.
//
// Named for its width rather than being a bare `parse`, because a function's
// return type cannot be chosen by the context it is called in (todo.md, Pit of
// Success #5 — the same gap that blocks `checked_*` and the narrowing
// conversions). Until that exists, `parse` would have exactly one meaning anyway,
// and this name says which.
//
// **It accumulates negatively**, which is the one thing here that looks wrong and
// is not. The i64 range is asymmetric — there is no `+9223372036854775808` to
// mirror the minimum — so a magnitude-then-negate parser cannot represent its own
// most negative input, and would have to reject `-9223372036854775808`, a
// perfectly good i64. Building the value on the negative side covers the whole
// range with one code path. (Go's strconv does the same, for the same reason.)
//
// The range guard runs *before* each digit is folded in rather than checking the
// result afterwards, because there is no result to check: arithmetic traps on
// overflow in this language, so `acc * 10 - d` on a too-long input would abort the
// program instead of returning the `None` this function exists to return. The
// limit is the last value that can still be multiplied by ten, and the final digit
// is bounded separately — by 8 for a negative number and 7 for a positive one,
// which is exactly the asymmetry described above, applied one digit at a time.
pub let parse_i64 = pure noalloc (self: string) -> Maybe<i64> => {
  var acc = 0;
  var digits = 0;
  var negative = false;
  var at_start = true;
  var bad = false;
  for c in self {
    let code = i64(c);
    if at_start && (code == 43 || code == 45) {
      negative = code == 45;
    } else if code < 48 || code > 57 {
      bad = true;
    } else {
      let d = code - 48;
      let last_digit = if negative { 8 } else { 7 };
      if acc < -922337203685477580 || (acc == -922337203685477580 && d > last_digit) {
        bad = true;
      } else {
        acc = acc * 10 - d;
        digits = digits + 1;
      }
    }
    at_start = false;
  }
  if bad || digits == 0 {
    None
  } else if negative {
    Some acc
  } else {
    Some(-acc)
  }
}

// ---------------------------------------------------------------------------
// Randomness
//
// The generator lives here, in Lyra, and only the *seed* is a compiler builtin
// (`random_seed()`, one word of OS entropy). A PRNG is arithmetic, and arithmetic
// is expressible; asking the operating system for entropy is not. Same division
// of labour as `read_line` (primitive, so a builtin) beside `parse_i64`.
//
// **That split is also what makes `det` usable with randomness, and it falls out
// of effect inference rather than being declared.** `next_u64` and `below` only
// mutate their own receiver, so they carry `EffectMut` — which `det` permits — and
// a program holding a seeded `Rng` is fully reproducible. `rng_from_entropy` and
// `random_below` reach `random_seed`, so inference gives *them* `EffectRand`, and
// `det` refuses them. Nobody had to enumerate which randomness is deterministic:
// drawing from a seed you were given is, and asking for a seed you were not is
// not.
// ---------------------------------------------------------------------------

pub struct Rng { state: u64 }

// xorshift64*, which is chosen for being *legible* rather than for being the best
// generator known: three shift/xor steps and a multiply, all of it visible in five
// lines, with no tables and no magic beyond the constants. It passes the usual
// smoke tests for non-cryptographic use and is entirely adequate for a game, a
// shuffle or a sampled test.
//
// It is **not suitable for anything security-sensitive** — the state is recoverable
// from a couple of outputs. That is a property of the algorithm, not of the seed:
// seeding from `random_seed()` does not make it a CSPRNG, and a real one belongs
// behind its own name so the choice is visible at the call site.
//
// The state must never be zero: xorshift maps 0 to 0, so a zero-seeded generator
// emits zero forever. `rng_seeded` is what guarantees that, not this function.
pub let next_u64 = det noalloc (self: mut Rng) -> u64 => {
  var x = self.state;
  x = x ~ (x >> 12);
  x = x ~ (x << 25);
  x = x ~ (x >> 27);
  self.state = x;
  x.wrapping_mul(2685821657736338717)
}

// A generator from an explicit seed — reproducible, and `det`-legal, so a
// simulation or a test can fix its randomness and get the same run every time.
//
// Seed 0 is redirected rather than rejected: zero is a perfectly natural thing to
// write, it is the one value xorshift cannot survive (the state is a fixed point,
// so every draw would be 0), and a `panic` on it would be a trap for the one caller
// who wanted the simplest possible seed. The substitute is xorshift64's usual
// default seed.
pub let rng_seeded = pure noalloc (seed: u64) -> Rng =>
  if seed == 0 { Rng { state: 88172645463325252 } } else { Rng { state: seed } }

// A generator seeded from the operating system — a different sequence each run.
// This is the one that carries `EffectRand`, because it is where a seed nobody
// supplied enters the program.
pub let rng_from_entropy = () -> Rng => rng_seeded(random_seed())

// A uniform draw from `0..<bound`, **without modulo bias**.
//
// The naive `next_u64() %% bound` is not uniform: 2^64 values do not divide evenly
// into `bound` buckets, so the low residues get one extra value each. The bias is
// tiny for a small bound and total for a large one, which is the worst shape for a
// bug — it never shows up in the case you test.
//
// So the top partial bucket is rejected and redrawn. `m - k` is the largest value
// that still lands in a whole bucket, computed as `m - ((m %% bound) + 1) %% bound`
// — the `+ 1` cannot overflow, since `m %% bound < bound <= m`, and the subtraction
// cannot either. Note `~u64(0)` for the u64 maximum: it is not writable as a
// literal (`IntegerLiteralExpr.Value` is an i64), which is the open >64-bit-literal
// gap, and complementing zero is the spelling that does not need it.
//
// The loop is expected to run once. It redraws with probability at most
// `bound / 2^64`, which for any bound a program actually passes is far below the
// chance of the machine failing mid-draw.
pub let below = det noalloc (self: mut Rng, bound: i64) -> i64 => {
  if bound <= 0 { panic("Rng.below: bound must be positive") }
  let b = u64(bound);
  let m = ~u64(0);
  let cutoff = m - ((m %% b) + 1) %% b;
  var x = self.next_u64();
  for x > cutoff { x = self.next_u64(); }
  i64(x %% b)
}

// A uniform draw from `lo..<=hi`, inclusive at both ends — the form a range of
// choices is usually described in ("a number between 0 and 100"). Inclusive
// because that is what the words mean; `below` is there when a half-open count is
// what is wanted.
pub let between = det noalloc (self: mut Rng, lo: i64, hi: i64) -> i64 => {
  if hi < lo { panic("Rng.between: the high bound is below the low one") }
  lo + self.below(hi - lo + 1)
}

// The ambient one-liner: a single uniform draw from `0..<bound`, seeded from the
// OS. Carries `EffectRand` (it reaches `random_seed`), so it is refused in `pure`
// and `det` code — reach for `rng_seeded` there and thread the generator.
//
// Each call seeds a *fresh* generator, which is why there is no hidden global
// state anywhere in this file. It costs one entropy call per draw, which is the
// right trade for a convenience function drawn a handful of times; a loop drawing
// many values should hold an `Rng` and call `below`, which is also the version that
// can be made reproducible.
pub let random_below = (bound: i64) -> i64 => {
  var rng = rng_from_entropy();
  rng.below(bound)
}

// The ambient counterpart of `between` — inclusive at both ends.
pub let random_between = (lo: i64, hi: i64) -> i64 => {
  var rng = rng_from_entropy();
  rng.between(lo, hi)
}

// The result of a three-way comparison (`a <=> b`). A sum type rather than the
// -1/0/1 integer Ruby and Perl return: an integer invites `if (a <=> b) == -1`,
// which is strictly worse than `a < b` and would leave the operator with no reason
// to exist. Named variants make the one thing `<=>` is *for* — handling all three
// outcomes in one place — the natural way to write it:
//
//   match guess <=> secret {
//     Less    => println("Too low!"),
//     Greater => println("Too high!"),
//     Equal   => println("You got it!"),
//   }
//
// and exhaustiveness then insists every case is covered, which is the property the
// `if`/`else if`/`else` chain it replaces cannot offer.
pub data Ordering = Less | Equal | Greater
