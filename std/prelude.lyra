module std.prelude

// The prelude: implicitly imported into every file, so everything declared here is
// reachable unqualified and without an `import`.
//
// It is an ordinary module — the compiler resolves it through the same search roots as
// any other, and it compiles standalone (it does not import itself). Nothing here is
// special-cased in the compiler, which is what lets it be read, tested and replaced.
//
// Four constraints worth knowing before adding to it:
//
//   - **Exports need `pub`.** A declaration without it is private to this module, and
//     a reference from elsewhere is lyra-E028.
//
//   - **`Maybe` and `Result` are shape-validated** by the `@builtin(…)` attribute that
//     gives them their compiler-known identity: `Maybe` takes one generic parameter with
//     `Some` (one payload) and `None` (none); `Result` takes two with `Ok` (one) and
//     `Err` (one). The names are free — the marker confers the identity, not the
//     spelling — but the arities are not. **The argument is not optional:** a bare
//     `@builtin` collects as no marker at all, and the type then gets its identity only
//     from the fallback that reads the literal name `Maybe`/`Result`, which is precisely
//     the coupling to spelling the marker exists to remove.
//
//   - **Write free functions, not trait impls** — and name the receiver `self`, which is
//     what makes `m.unwrap_or(0)` work as well as `unwrap_or(m, 0)` (UFCS, 08/03). The
//     method spelling costs nothing: it is rewritten to the call form before anything
//     downstream sees it.
//
//     A trait impl is the thing to avoid here. It type-checks, and a *generic* one — which
//     every combinator below would be — then fails in the backend, because an impl method's
//     body is not specialized per instantiation ("match on Maybe<t> not implemented yet").
//     A non-generic impl method does lower; this file has no use for one. The note that
//     used to sit here said no method lowered at all, which stopped being true on 07/30.
//
//   - **A name may be declared twice, if the two take different receivers** — receiver-keyed
//     overloading (08/03). Both declarations must take a `self` parameter and their receiver
//     types must have different *heads*: `Maybe<t>` beside `Result<t,e>` is fine, a second
//     `Maybe<…>` is refused where it is written. That is what lets `unwrap_or` below mean
//     both types rather than one of them getting a name the other did not need. Everything
//     else about a redeclaration is unchanged — two functions without receivers are the
//     error they always were.
//
// A name declared here can be shadowed by user code: that warns (lyra-W012) and the
// user's declaration wins, so adding a name here cannot break a program that never
// mentioned it. The shadow is confined to the module that declared it — another module
// still gets the version below — and since 08/01 that holds for a **type** or **trait**
// too, which used to be replaced program-wide.
//
// Note what a shadow still means for the module that makes one: the markers below claim
// the canonical kinds, so a user's own same-named `Maybe` is an ordinary type, and `?` on
// it reports "`?` operand must be a Result or Maybe, got Maybe". That no longer reaches a
// module which never mentioned `Maybe` — which is what made it indefensible — but the
// message is still poor for the module that did. See todo.md.

@builtin(Maybe)
pub data Maybe<t> = None | Some t

pub let unwrap_or<t> = pure noalloc (self: Maybe<t>, fallback: t) -> t => match self {
  Some v => v,
  None => fallback,
}

pub let unwrap_or_else<t> = pure noalloc (self: Maybe<t>, f: () -> t) -> t => match self {
  Some v => v,
  None => f(),
}

pub let expect<t> = pure noalloc (self: Maybe<t>, msg: string) -> t => match self {
  Some v => v,
  None => panic(msg),
}

pub let unwrap<t> = pure noalloc (self: Maybe<t>) -> t => expect(self, "unwrap on a None")

pub let is_some<t> = pure noalloc (self: Maybe<t>) -> bool => match self {
  Some _ => true,
  None => false,
}

pub let is_none<t> = pure noalloc (self: Maybe<t>) -> bool => match self {
  Some _ => false,
  None => true,
}

pub let ok_or<t,e> = pure noalloc (self: Maybe<t>, err: e) -> Result<t,e> => match self {
  Some v => Ok v,
  None => Err err,
}

pub let ok_or_else<t,e> = pure noalloc (self: Maybe<t>, f: () -> e) -> Result<t,e> => match self {
  Some v => Ok v,
  None => Err(f()),
}

pub let map<t,u> = pure noalloc (self: Maybe<t>, f: (t) -> u) -> Maybe<u> => match self {
  Some v => Some(f(v)),
  None => None,
}

pub let flat_map<t,u> = pure noalloc (self: Maybe<t>, f: (t) -> Maybe<u>) -> Maybe<u> => match self {
  Some v => f(v),
  None => None,
}

// `filter` has no `Result` counterpart, and deliberately: rejecting an `Ok` would have to
// invent the `e` to fail with, which only the caller can supply — that is `ok_or`'s job,
// not this one's. A name declared once here is an ordinary prelude name, not a set.
pub let filter<t> = pure noalloc (self: Maybe<t>, predicate: (t) -> bool) -> Maybe<t> => match self {
  Some v => if predicate(v) { Some v } else { None },
  None => None,
}

@builtin(Result)
pub data Result<t, e> = Ok(t) | Err(e)

pub let is_ok<t,e> = pure noalloc (self: Result<t, e>) -> bool => match self {
  Ok _ => true,
  Err _ => false,
}

pub let is_err<t,e> = pure noalloc (self: Result<t, e>) -> bool => match self {
  Ok _ => false,
  Err _ => true,
}

pub let unwrap_or<t,e> = pure noalloc (self: Result<t,e>, fallback: t) -> t => match self {
  Ok v => v,
  Err _ => fallback,
}

pub let unwrap_or_else<t,e> = pure noalloc (self: Result<t,e>, f: () -> t) -> t => match self {
  Ok v => v,
  Err _ => f(),
}

pub let expect<t,e> = pure noalloc (self: Result<t,e>, msg: string) -> t => match self {
  Ok v => v,
  Err _ => panic(msg),
}

pub let unwrap<t,e> = pure noalloc (self: Result<t,e>) -> t => expect(self, "unwrap on an Err")

pub let ok<t,e> = pure noalloc (self: Result<t,e>) -> Maybe<t> => match self {
  Ok v => Some v,
  Err _ => None,
}

pub let err<t,e> = pure noalloc (self: Result<t,e>) -> Maybe<e> => match self {
  Ok _ => None,
  Err err => Some err,
}

pub let map<t,u,e> = pure noalloc (self: Result<t,e>, f: (t) -> u) -> Result<u,e> => match self {
  Ok v => Ok(f(v)),
  Err err => Err err,
}

pub let flat_map<t,u,e> = pure noalloc (self: Result<t,e>, f: (t) -> Result<u,e>) -> Result<u,e> => match self {
  Ok v => f(v),
  Err err => Err err,
}

pub let filter<t,e> = pure noalloc (self: Result<t,e>, predicate: (t) -> bool) -> Maybe<t> => match self {
  Ok v => if predicate(v) { Some v } else { None },
  Err _ => None,
}

pub let map<t,u> = pure (self: []t, f: (t) -> u) -> []u => [x in self | f(x)]

pub let filter<t> = pure (self: []t, predicate: (t) -> bool) -> []t => [x in self | predicate(x) | x]
