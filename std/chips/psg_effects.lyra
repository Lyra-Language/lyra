module std.chips.psg_effects
//! Sound effects on an SN76489 — a jump, a coin, a hit: a step a frame, each a period and a
//! volume, what `std.genesis.sound` and `std.game.sound` play and Vega makes. A [Player]
//! says which bytes the chip is sent each frame; the runtime sends them, to the console's
//! port or to `std.chips.sn76489` running in the game, so an effect is the same sound on
//! both.
//!
//! ```
//! import std.chips.psg_effects.{ Effect, EffectStep, new_player, MAX_BYTES }
//!
//! const STEPS: [3]EffectStep = #[
//!   EffectStep { period: 254, volume: 15 },
//!   EffectStep { period: 254, volume: 10 },
//!   EffectStep { period: 254, volume: 5 },
//! ]
//! var player = new_player()
//! player.start(Effect { first: 0, count: 3 })
//! var out: [8]u8 = #[0; MAX_BYTES]
//! let n = player.frame(STEPS, out)          // once a frame; send out[0..n] to the PSG
//! ```
//!
//! **Two effects at once**: a tone effect on tone channel 0, and a noise effect on the noise
//! channel, pitched by tone channel 2's period (that channel kept silent). An effect started
//! in a channel already playing one takes its place. After an effect's last step its
//! channel is silenced.
//!
//! **No heap, no host**: the steps are the game's table, read where they are, and the bytes
//! go into a buffer the caller gives — so the 68000 runs this as it is.

import std.chips.sn76489.{ period_bytes, attenuation_byte, noise_byte }

/// One frame of an effect: the tone's (or the noise's pitch's) period, 10 bits, and how
/// loud, 0 silent to 15 — the chip's attenuation the other way up.
pub struct EffectStep {
  period: u16,
  volume: u8,
}

/// An effect: `count` steps of a game's table from `first`, on the noise channel or a tone
/// one; noise is white or periodic.
pub struct Effect {
  first: u16,
  count: u16,
  noise: bool = false,
  white: bool = true,
}

/// The most bytes a frame sends the chip, and so the length of [Player.frame]'s buffer
/// (written `[8]u8`: a named constant cannot size an array type yet): a tone's period and
/// volume (3), and noise's setting, its pitch's channel silenced, its period and volume (5).
pub const MAX_BYTES: i64 = 8

/// What is playing: an effect a channel.
pub struct Player {
  tone: Slot,
  noise: Slot,
}

/// An effect under way: the next step to play, the step after its last, and — noise —
/// whether the chip has been set for it yet.
pub struct Slot {
  next: u16 = 0,
  end: u16 = 0,
  playing: bool = false,
  white: bool = true,
  fresh: bool = false,
}

impl Slot {
  /// The step due on the channel, or -1 where it is playing none.
  let step_due = pure (self: ref) -> i64 =>
    if self.playing && self.next < self.end { i64(self.next) } else { -1 }
}

/// A player with nothing playing.
pub let new_player = pure () -> Player => Player { tone: Slot {}, noise: Slot {} }

/// The tone channel effects play on, and the one whose period pitches the noise.
const TONE: u8 = 0
const NOISE_PITCH: u8 = 2
const NOISE: u8 = 3

impl Player {
  /// Start `effect` from its first step, in place of any its channel was playing.
  pub let start = (self: mut, effect: Effect) -> void => {
    let slot = Slot {
      next: effect.first,
      end: effect.first + effect.count,
      playing: true,
      white: effect.white,
      fresh: true,
    }
    if effect.noise { self.noise = slot } else { self.tone = slot }
  }

  /// Whether an effect is still playing on either channel.
  pub let playing = pure (self: ref) -> bool => self.tone.playing || self.noise.playing

  /// The steps due this frame, as indices into the game's table: the tone channel's and
  /// the noise's, -1 where none is playing a step.
  pub let due = pure (self: ref) -> (i64, i64) =>
    (self.tone.step_due(), self.noise.step_due())

  /// This frame's bytes for the chip, into `out`, and how many: each channel playing an
  /// effect its next step, and one past its last step silenced. Steps past the end of
  /// `steps` are silence.
  pub let frame<const N: i64> = (
    self: mut,
    steps: ref [N]EffectStep,
    out: mut [8]u8
  ) -> i64 => {
    let (t, nz) = self.due()
    let tone = if t >= 0 && t < steps.len() { Some(steps[t]) } else { None }
    let noise = if nz >= 0 && nz < steps.len() { Some(steps[nz]) } else { None }
    self.frame_with(tone, noise, out)
  }

  /// [frame], given the steps due ([due]) rather than the table — for a caller whose steps
  /// are not a fixed table (an editor's). `None` for a channel ends its effect.
  pub let frame_with = (
    self: mut,
    tone: Maybe<EffectStep>,
    noise: Maybe<EffectStep>,
    out: mut [8]u8
  ) -> i64 => {
    var n: i64 = 0
    if self.tone.playing {
      if let Some(step) = tone {
        let p = period_bytes(TONE, step.period)
        out[0] = p[0]
        out[1] = p[1]
        out[2] = attenuation_byte(TONE, 15 - (step.volume & 15))
        n = 3
        self.tone.next += 1
      } else {
        out[0] = attenuation_byte(TONE, 15)
        n = 1
        self.tone.playing = false
      }
    }
    if self.noise.playing {
      if self.noise.fresh {
        out[n] = noise_byte(self.noise.white)
        out[n + 1] = attenuation_byte(NOISE_PITCH, 15)
        n += 2
        self.noise.fresh = false
      }
      if let Some(step) = noise {
        let p = period_bytes(NOISE_PITCH, step.period)
        out[n] = p[0]
        out[n + 1] = p[1]
        out[n + 2] = attenuation_byte(NOISE, 15 - (step.volume & 15))
        n += 3
        self.noise.next += 1
      } else {
        out[n] = attenuation_byte(NOISE, 15)
        n += 1
        self.noise.playing = false
      }
    }
    n
  }
}
