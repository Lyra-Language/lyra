module std.math
//! Complex numbers.

// **The element type is generic, and only the float instantiations are numerically
// sound.** `where t: Arithmetic` admits every integer width too, and complex *division*
// over integers truncates — `Complex<i64> { 1, 2 } / Complex<i64> { 3, 4 }` is `0 + 0i`
// where the exact answer is `0.44 + 0.08i`. That is inherent to integer division rather
// than to the formula, and it is silently wrong rather than trapping, which is the one
// failure mode this language is otherwise built to refuse. Constraining the parameter to
// the floats is the fix, and there is no trait naming them yet.

/// A complex number, `re + im·i`.
///
/// Generic over the element type, which needs the four arithmetic operators. In practice
/// that means `Complex<f64>`: see the note above on why the integer instantiations
/// divide badly.
///
/// # Examples
///
/// ```
/// let a = Complex { re: 1.0, im: 2.0 }
/// let b = Complex { re: 3.0, im: 4.0 }
/// let product = a * b
/// ```
pub struct Complex<t> {
  /// The real part.
  re: t,
  /// The imaginary part — the coefficient of `i`, not the term.
  im: t,
}

/// Componentwise addition.
impl Add for Complex<t> where t: Arithmetic {
  (_+_) = (self, other) => Complex { re: self.re + other.re, im: self.im + other.im }
}

/// Componentwise subtraction.
impl Sub for Complex<t> where t: Arithmetic {
  (_-_) = (self, other) => Complex { re: self.re - other.re, im: self.im - other.im }
}

/// The complex product: `(a + bi)(c + di) = (ac - bd) + (ad + bc)i`.
impl Mul for Complex<t> where t: Arithmetic {
  (_*_) = (self, other) => Complex {
    re: self.re * other.re - self.im * other.im,
    im: self.re * other.im + self.im * other.re
  }
}

/// Division by the conjugate, `(a + bi)/(c + di) = ((ac + bd) + (bc - ad)i)/(c² + d²)`.
///
/// The naive formula rather than Smith's method, which trades two divisions for scaling
/// that avoids overflow when the operands are large. At the magnitudes this type is
/// written for the difference does not arise.
///
/// # Panics
///
/// Traps for an integer `t` when the divisor is zero, since `c² + d²` is then zero and
/// integer division by zero traps. For a float `t` the quotient is an infinity or a NaN,
/// which is IEEE 754's answer rather than a trap.
impl Div for Complex<t> where t: Arithmetic {
  (_/_) = (self, other) => {
    let common_denominator = other.re * other.re + other.im * other.im
    Complex {
      re: (self.re * other.re + self.im * other.im) / common_denominator,
      im: (self.im * other.re - self.re * other.im) / common_denominator,
    }
  }
}

// The `where` clause says what the four impls above already require, and it is **enforced**
// as of 08/14: `typeImplementsTrait` verifies a matched impl's own bounds, so
// `Complex<string>` is refused at the bound rather than accepted and failed in the backend.
// It was written before that landed, on the grounds that it stated the intent; the intent
// is now the rule.

/// `Complex<t>` supports all four arithmetic operators.
impl Arithmetic for Complex<t> where t: Arithmetic

/// Rendered as `re + imi`, or `re - imi` when the imaginary part is negative — `1 + 2i`
/// and `1 - 2i` rather than `1 + -2i`.
///
/// The sign comes from `Signed`, whose two methods both take a receiver. A `Zero` trait
/// would be the conventional way to ask this and does not work here: `zero: () -> Self` has
/// no receiver to dispatch on, and picking an impl from the expected type is
/// return-type-directed dispatch, which Lyra does not have.
impl Show for Complex<t> where t: Show + Signed {
  show = (self) => if self.im.is_negative() {
    "${self.re} - ${self.im.abs()}i"
  } else {
    "${self.re} + ${self.im}i"
  }
}
