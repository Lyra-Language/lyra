module ui.backend
//! The two seams between the interface and a machine: [Platform], the windows and what the
//! user does in them, and [Renderer], which turns a display list into pixels. `ui.sdl3` is the
//! first implementation of both; everything above them is pure Lyra and calls no library.
//!
//! ```
//! import ui.backend.{ Platform, Renderer, CloseRequested, MAIN_WINDOW }
//! import ui.sdl3
//!
//! let main = () -> u8 => {
//!   let Some(window) = sdl3.open("Hello", 640.0, 480.0) else { return 1 }
//!   var platform = window.platform
//!   var renderer = window.renderer
//!   loop {
//!     for (_, event) in platform.next_events(-1) {
//!       if event == CloseRequested { sdl3.close(platform, renderer); return 0 }
//!     }
//!     renderer.draw(MAIN_WINDOW, BACKGROUND, view(platform.window_size(MAIN_WINDOW)))
//!   }
//! }
//! ```
//!
//! **Both traits are small on purpose.** A new backend — a GPU renderer, the web, a phone's
//! native layer — implements these and nothing else, so each method is one a backend cannot
//! do without. Positions in [InputEvent], sizes and the display list are all **logical
//! units**: the platform divides its own coordinates by [Platform.scale] before it reports
//! them, and the renderer multiplies by it before it draws.
//!
//! **Several windows** (`ui/VEGA.md` §8): a platform opens with one, [MAIN_WINDOW], and opens
//! and closes others as it is asked ([Platform.open_window]). Each call about one window names
//! it by its [WindowId], and each input says which window it happened in. One renderer draws
//! every window ([Renderer.draw]), and a texture it holds is drawn in any of them.

import ui.draw.{ Point, Size, Rect, Color, Image, TextureId, DrawOp }

/// A window of a platform's, by the number the platform gave it: [MAIN_WINDOW] the one it
/// opened with, any other one [Platform.open_window] answered.
pub type WindowId = i64

/// The window a platform opened with.
pub const MAIN_WINDOW: WindowId = WindowId(0)

/// The windows, and the input they receive.
pub trait Platform {
  /// What happened since the last call, oldest first, each with the window it happened in (or
  /// is about; [MAIN_WINDOW] for what is about none — a menu chosen, the system's look) —
  /// waiting up to `wait_ms` milliseconds for something when nothing has (`0` never waits, a
  /// negative wait as long as it takes). An interface with nothing animating waits, and costs
  /// nothing while the user is away.
  next_events: (mut Self, i64) -> [](WindowId, InputEvent)
  /// The window's size, in logical units.
  window_size: (Self, WindowId) -> Size
  /// Pixels a logical unit in the window: its display's density times the scale the user
  /// chose for it.
  scale: (Self, WindowId) -> f32
  /// Ask for typed text in the window, with the field it goes into — where an input method's
  /// window and a phone's keyboard keep clear of — or stop asking, with `None`.
  set_text_input: (mut Self, WindowId, Maybe<Rect>) -> void
  /// The modifier keys held now — what a pointer event, which carries none, was made with.
  held: (Self) -> Modifiers
  /// Wake [Platform.next_events]'s wait once when any of these file descriptors has data to
  /// read (or closes): asked each pass, after what was ready has been read; none stops it. A
  /// platform that never waits ignores it.
  wake_for: (mut Self, []i32) -> void
  /// The text on the clipboard; `""` when there is none.
  clipboard: (Self) -> string
  set_clipboard: (mut Self, string) -> void
  /// The pointer's shape while it is over the windows.
  set_cursor: (mut Self, Cursor) -> void
  /// Milliseconds since some fixed moment: what timers and frame times are measured in.
  now_ms: (Self) -> i64
  /// Whether the system is set to a light or a dark look.
  appearance: (Self) -> Appearance
  /// Whether it is one of Apple's systems, whose shortcuts are spelled with their symbols
  /// (`⇧⌘T`, not `Ctrl+Shift+T`) and whose primary modifier is Command.
  apple: (Self) -> bool
  /// Open a web address (or `mailto:`, `file://`) in the program the system chooses for it;
  /// whether it was taken.
  open_url: (mut Self, string) -> bool
  /// The window's interface as assistive technology should hear it, each time it changes
  /// (`ui.access` builds it); a platform with none ignores it.
  update_access: (mut Self, WindowId, AccessTree) -> void
  /// The least and greatest size the user may make the window, in logical units — a size of
  /// nothing for no limit; the window resized into them if it is outside. A side whose least
  /// and greatest are one size does not resize, and a window held so both ways not at all.
  set_size_limits: (mut Self, WindowId, Size, Size) -> void
  /// Resize the window to this, in logical units, as the program asks (not the user).
  set_window_size: (mut Self, WindowId, Size) -> void
  /// Where the window's top-left corner is on the screens, in the system's own coordinates;
  /// `None` where the system does not say (Wayland never tells a window where it is).
  window_position: (Self, WindowId) -> Maybe<Point>
  /// Whether the window shows what is behind it where a frame is translucent (`true`), or is
  /// opaque; whether it can — on macOS at any time, elsewhere only a window opened see-through
  /// (`ui.sdl3.open`'s `see_through`), which stays so, an opaque frame hiding what is behind.
  set_see_through: (mut Self, WindowId, bool) -> bool
  /// What is behind a see-through window blurred by this many points (0 for none); false where
  /// the system has no such blur (macOS has: a backdrop layer under the window's content;
  /// Linux's desktops are asked nothing yet).
  set_backdrop_blur: (mut Self, WindowId, f32) -> bool
  /// Move the window's top-left corner there, if a display shows that place — one saved
  /// while another screen was plugged in may be on none, and is ignored. The system may
  /// refuse (Wayland's does).
  set_window_position: (mut Self, WindowId, Point) -> void
  /// A point of the window — logical units from its top left — in the system's coordinates of
  /// the screens, where [Platform.window_position] answers; `None` where the system does not
  /// say where the window is.
  to_screen: (Self, WindowId, Point) -> Maybe<Point>
  /// A point of the screens, in the system's coordinates, in the window's logical units from
  /// its top left; `None` where the system does not say where the window is.
  from_screen: (Self, WindowId, Point) -> Maybe<Point>
  /// The window's title bar.
  set_title: (mut Self, WindowId, string) -> void
  /// Call `hook` with a window each time the system asks for a frame of it while it is
  /// resized by dragging and the program's own loop is held (macOS) — never from inside the
  /// hook's own frame. `ui.app`'s `follow_resizes` hands it a redraw; a platform whose loop is
  /// never held may ignore it.
  on_live_resize: (mut Self, (WindowId) -> void) -> void
  /// The program's menus in the system's own menu bar — the Mac's — or nothing: installed
  /// (again, when their shape — labels, entries, shortcuts — has changed since), else their
  /// items greyed and checked as these say. A chosen item comes back as [MenuChosen] with its
  /// tag. Whether there is such a bar: a platform without one ignores them. The bar is the
  /// program's, whichever window is in front.
  set_menus: (mut Self, []NativeMenu) -> bool
  /// The window minimized, maximized or fullscreen, as it is now.
  window_state: (Self, WindowId) -> WindowState
  /// Ask the system to minimize the window, maximize it or put it back — which it may do
  /// later, or not at all; [WindowStateChanged] says when it has.
  change_window: (mut Self, WindowId, WindowChange) -> void
  /// Take the system's title bar and frame away from the window (`false`), or give them back:
  /// for a program drawing its own. A platform whose title bar stays the system's (a Mac's,
  /// for now) ignores it.
  set_decorated: (mut Self, WindowId, bool) -> void
  /// Where a window without the system's frame is moved from — the program's title bar —
  /// and, inside that, what keeps a press (its controls), in logical units; and the margin
  /// round its edges it is resized from. Ignored where the window keeps the system's frame.
  set_window_areas: (mut Self, WindowId, []Rect, []Rect, f32) -> void
  /// Show the system's open or save dialog over the window, its answer to come as
  /// [FileAnswered] under this tag — later, the dialog being the user's while it is open.
  choose_file: (mut Self, WindowId, i32, FileDialog) -> void
  /// Open another window as `spec` says, its number for the calls about it and the input in
  /// it — `None` if it could not be opened (a platform of one window). It is drawn by the
  /// same renderer as the others.
  open_window: (mut Self, NewWindow) -> Maybe<WindowId>
  /// Close a window [Platform.open_window] opened, once its renderer has let it go
  /// ([Renderer.window_closed]); the main window is closed with the platform.
  close_window: (mut Self, WindowId) -> void
}

/// A window to open beside the others ([Platform.open_window]): its title, its size in logical
/// units, and where its top-left corner goes on the screens, in the system's coordinates — the
/// system's choice for `None`, or where no display shows that place, or where the system places
/// every window itself (Wayland).
pub struct NewWindow {
  title: string = "",
  size: Size = Size { w: 800.0, h: 600.0 },
  place: Maybe<Point> = None,
}

/// A file dialog to show: what it offers (each a name and its extensions without dots, joined
/// by `;` — `("Fonts", "ttf;otf")` — or `*` for every file), where it starts (the system's
/// choice for `None`), and whether it chooses where to save, a path that may not exist yet.
pub struct FileDialog {
  filters: [](string, string) = [],
  start: Maybe<string> = None,
  save: bool = false,
}

/// The window as the system has it: minimized, maximized, fullscreen.
pub struct WindowState {
  minimized: bool = false,
  maximized: bool = false,
  fullscreen: bool = false,
}

/// What a program may ask of the window: to minimize it, maximize it, or restore it from either.
pub data WindowChange = ToMinimized | ToMaximized | ToRestored

/// A menu as a platform's own menu bar takes it: its title and entries, each item by a tag
/// standing for its event — `ui.app` keeps the events, since a platform is not generic in
/// them. The first menu is the application menu, its title the application's name.
pub struct NativeMenu {
  label: string,
  entries: []NativeEntry,
}

/// What a native menu holds: an item, a submenu (its title and entries), or a rule.
pub data NativeEntry = NativeItem(NativeItemSpec) | NativeSubmenu(
  string,
  []NativeEntry
) | NativeSeparator

/// A native menu's item: its label, its tag (what [MenuChosen] answers), its shortcut, and
/// whether it can be chosen and is checked.
pub struct NativeItemSpec {
  label: string,
  tag: i32,
  shortcut: Maybe<Chord> = None,
  enabled: bool = true,
  checked: bool = false,
}

/// A key and the modifiers held with it — `primary` the shortcut modifier, Command on a Mac
/// and Control elsewhere, as [Modifiers] has it: a menu item's shortcut.
pub struct Chord {
  key: Key,
  mods: Modifiers = Modifiers {},
}

/// The interface for assistive technology: its nodes, the root's id and the focused node's.
pub struct AccessTree {
  nodes: []AccessNode = [],
  root: u64 = 0,
  focus: u64 = 0,
}

/// One node of an [AccessTree]: its id (`key` hashed — `key` the element's identity), what it
/// is, its label and value, where it is (logical units, from the window's top left), whether it
/// is ticked, its number and range (value, least, greatest, step), the actions it offers
/// (`ACCESS_*`s, or-ed), and its children's ids.
pub struct AccessNode {
  key: string,
  id: u64,
  role: AccessRole,
  label: string = "",
  value: string = "",
  /// More about it than its label — its tooltip.
  description: string = "",
  bounds: Rect = Rect {},
  toggled: Maybe<bool> = None,
  numeric: Maybe<(f64, f64, f64, f64)> = None,
  actions: i32 = 0,
  children: []u64 = [],
}

/// Actions an [AccessNode] offers, or-ed: to take the focus, be pressed, have its value set,
/// and be stepped up or down. (AccessKit's bridge, `bindings.accesskit`, numbers them alike.)
pub const ACCESS_FOCUS: i32 = 1
pub const ACCESS_CLICK: i32 = 2
pub const ACCESS_SET_VALUE: i32 = 4
pub const ACCESS_INCREMENT: i32 = 8
pub const ACCESS_DECREMENT: i32 = 16

/// What a node is to assistive technology.
pub data AccessRole =
  AxWindow
  | AxGroup
  | AxLabel
  | AxImage
  | AxButton
  | AxCheckbox
  | AxSlider
  | AxTextInput
  | AxScroll
  | AxComboBox
  | AxListBox
  | AxOption
  | AxTabList
  | AxTab
  | AxRadio
  | AxRadioGroup
  | AxProgress
  | AxTable
  | AxRow
  | AxContainer

/// What assistive technology asks of an element.
pub data AccessRequest =
  AxFocus
  | AxClick
  | AxSetValue(string)
  | AxSetNumber(f64)
  | AxIncrement
  | AxDecrement

/// The system's look: light or dark.
pub data Appearance = LightMode | DarkMode

/// **A platform with its own text fields** — a phone, whose keyboard, autocorrect, dictation
/// and selection handles belong to the system's field and not to one drawn here — places one
/// over a text field rather than letting `ui.interact` draw and edit it: by the field's
/// identity, at its rectangle, showing the value and caret the program's state has; and takes
/// it away when the field leaves the tree. The edits come back as [FieldEdited]. Declared now
/// so the seam is in place; no platform implements it yet, and a desktop never will.
pub trait NativeFields {
  /// Show a system text field identified as the first argument, over this rectangle, holding
  /// this value with the caret before this rune — or move or update the one already shown.
  place_field: (mut Self, string, Rect, string, i64) -> void
  /// Take away the field identified as this.
  remove_field: (mut Self, string) -> void
}

/// Pixels, from a display list — in any of a platform's windows.
pub trait Renderer {
  /// Keep `image` as a texture to draw from, named by the answer — `None` if the backend
  /// cannot hold it.
  upload: (mut Self, Image) -> Maybe<TextureId>
  /// Write `image` into texture `id` with its top-left corner at the texel `at` — a glyph
  /// added to an atlas. `false`, changing nothing, if it does not fit.
  update: (mut Self, TextureId, Point, Image) -> bool
  /// Draw a frame of the window: cleared to the colour, then the display list in order, then
  /// shown. A window the renderer has not drawn before it takes on here.
  draw: (mut Self, WindowId, Color, []DrawOp) -> void
  /// Let texture `id` go — a picture no view draws now ([GlyphAtlas]'s pictures); its id may
  /// name another later. Nothing by default, for a renderer that keeps what it is given.
  release: (mut Self, TextureId) -> void = (self, id) => {}
  /// Let a window go that is about to close ([Platform.close_window]): whatever the renderer
  /// made to draw into it. Nothing by default, for a renderer of one window.
  window_closed: (mut Self, WindowId) -> void = (self, window) => {}
}

/// Something the user did, or the window had done to it, in logical units.
pub data InputEvent =
  /// The user asked to close the window — its close button, or the system's shortcut.
  CloseRequested
  /// The user asked to quit the program — on a Mac, its menu's Quit or ⌘Q.
  | QuitRequested
  /// The window changed size, to this.
  | Resized(Size)
  /// The window moved, its top-left corner now there on the screens, in the system's
  /// coordinates ([Platform.window_position]).
  | WindowPlaced(Point)
  /// The window moved to a display with another scale, or its display's changed: lay out
  /// and draw again at [Platform.scale].
  | ScaleChanged
  | PointerMoved(Point)
  /// A button pressed, and the clicks in a row it makes — 1, 2 for a double click, 3 for a
  /// triple — counted by the platform at the system's double-click speed.
  | PointerDown(PointerButton, Point, i64)
  | PointerUp(PointerButton, Point)
  /// Scrolled by this far, in lines: across (positive to the right) and down (positive
  /// toward the user, so content moves up).
  | Scrolled(f32, f32)
  | KeyPressed(Key, Modifiers)
  | KeyReleased(Key, Modifiers)
  /// Text typed while text was asked for ([Platform.set_text_input]): a key's character or
  /// what an input method composed. Its key's [KeyPressed] arrives as well, and a text field
  /// takes the text from here, not from the key.
  | TextTyped(string)
  /// An input method's text being composed — not yet typed — with its caret and the length
  /// of the part selected, in runes (`-1` for none). An empty text ends the composition;
  /// what it makes arrives as [TextTyped].
  | TextComposing(string, i64, i64)
  /// The window gained the keyboard's focus, or lost it to another window or app.
  | WindowFocused
  | WindowUnfocused
  /// The system switched between its light and dark look, to this.
  | AppearanceChanged(Appearance)
  /// Assistive technology asked something of the element identified as this — VoiceOver
  /// pressing a button, setting a slider — as the keyboard or the pointer would have.
  | AccessAction(string, AccessRequest)
  /// A system text field ([NativeFields]) identified as the first string was edited: its value
  /// is now the second, with the caret before this rune. Never sent by a desktop platform.
  | FieldEdited(string, string, i64)
  /// The item of the system's own menu bar tagged this was chosen ([Platform.set_menus]).
  | MenuChosen(i32)
  /// The window was minimized, maximized, made fullscreen or put back, to this.
  | WindowStateChanged(WindowState)
  /// The file dialog asked for under this tag ([Platform.choose_file]) answered: the path
  /// chosen, or `None` — closed without a choice, or not shown at all.
  | FileAnswered(i32, Maybe<string>)
  /// Files dropped on the window, by path, all of one drop together — on a Mac also a file
  /// opened from Finder, which the system hands over as a drop.
  | FilesDropped([]string)

/// A mouse button, or a touch (which is [Primary]).
pub data PointerButton = Primary | Secondary | Middle | OtherButton(u8)

/// A key, as an interface tells keys apart: the ones that edit and move, named as the web's
/// `KeyboardEvent.key` names them, and the rest by the character they type (the space bar is
/// `Character(' ')`). A key with neither is `Unnamed`, carrying the platform's code.
///
/// The names are the web's rather than the shortest (`ArrowLeft`, not `Left`) because a
/// constructor's name is matched program-wide: a program's own `data Dir = Left | Right`
/// would otherwise take them.
pub data Key =
  Enter
  | Escape
  | Tab
  | Backspace
  | Delete
  | ArrowLeft
  | ArrowRight
  | ArrowUp
  | ArrowDown
  | Home
  | End
  | PageUp
  | PageDown
  | Insert
  /// F1 to F24, by number.
  | FunctionKey(i64)
  | Character(rune)
  | Unnamed(u32)

/// The modifier keys held with a key. `primary` is the one shortcuts use — Command on a
/// Mac, Control elsewhere — so `primary` and `Character('c')` is Copy everywhere.
pub struct Modifiers {
  shift: bool = false,
  control: bool = false,
  alt: bool = false,
  command: bool = false,
  primary: bool = false,
}

/// The pointer's shape — the last two the arrows across and up and down an edge that resizes.
pub data Cursor = Arrow | IBeam | Hand | Crosshair | Move | NotAllowed | Busy | ResizeAcross | ResizeDown
