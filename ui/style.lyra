module ui.style
//! How an interface looks: [Style] (what an element asks for), [Theme] (a palette, spacing,
//! a font and the defaults each element starts from), [Sheet]s of rules, and the cascade
//! that settles them into each element's [Computed] style.
//!
//! ```
//! import ui.style.{ Style, Sheet, Rule, light_theme }
//!
//! let SETTINGS = Sheet { rules: [
//!   Rule { selector: "Text.title", style: Style { font_size: Some(20.0) } },
//!   Rule { selector: ".card", style: Style { background: Some(WHITE), radius: Some(8.0) } },
//!   Rule { selector: "Toggle::knob", style: Style { background: Some(BLUE) } },
//! ] }
//! ```
//!
//! **A selector** is an element's tag (`Text`), a class (`.title`), both (`Text.title`), or a
//! component's part (`Toggle::knob` — an element marked as part `knob` inside a component
//! tagged `Toggle` — or `Toggle.big::knob`, inside one of class `big`, which is the more
//! specific). Classes are space-separated on an element (`"card wide"`).
//!
//! **The cascade is five layers**, each beating every one below it whatever its rules'
//! specificity; within a layer, the more specific rule wins, then the later:
//!
//! 1. the theme's `elements` sheet — the defaults every element starts from;
//! 2. the global sheets ([Themed](ui.layout) nodes'), outermost first;
//! 3. the scoped sheet of the component the element is in — which matches its own elements
//!    only, never the tree around it nor a component inside it;
//! 4. part rules (`Toggle::knob`), from the theme, the global sheets and the sheet of the
//!    component around the one the part is in — how the outside styles a component's insides,
//!    as CSS's `::part` does;
//! 5. the element's own inline `style`.
//!
//! **Inherited**: `color`, `font` (and `font_size` and `line_height`) and `opacity` — an element that does not
//! set them takes its parent's, and an opacity multiplies into its parent's, so a half-
//! transparent card's text is half-transparent too. Everything else starts unset.

import ui.draw.{ Color, Size, BoxShadow, Gradient, rgb, rgba }
import ui.backend.{ Appearance }
import ui.text.{ FontSpec }

/// Space inside an element's edge, on each side, in logical units.
pub struct Insets {
  top: f32 = 0.0,
  right: f32 = 0.0,
  bottom: f32 = 0.0,
  left: f32 = 0.0,
}

/// The same space on every side.
pub let insets = pure (all: f32) -> Insets =>
  Insets { top: all, right: all, bottom: all, left: all }

/// `x` on the left and right, `y` on the top and bottom.
pub let insets_xy = pure (x: f32, y: f32) -> Insets =>
  Insets { top: y, right: x, bottom: y, left: x }

impl Insets {
  /// The left and right together.
  pub let horizontal = pure (self) -> f32 => self.left + self.right

  /// The top and bottom together.
  pub let vertical = pure (self) -> f32 => self.top + self.bottom

  /// Both insets, side by side.
  pub let plus = pure (self, other: Insets) -> Insets => Insets {
    top: self.top + other.top,
    right: self.right + other.right,
    bottom: self.bottom + other.bottom,
    left: self.left + other.left,
  }
}

/// What an element asks to look like; a field unset leaves it to the layers below (or, for
/// an inherited one, to its parent).
pub struct Style {
  /// Text colour. Inherited.
  color: Maybe<Color> = None,
  /// The fill behind the element, to its rounded edge.
  background: Maybe<Color> = None,
  border_color: Maybe<Color> = None,
  /// The border's width, inside the element's edge; drawn when it and `border_color` are set.
  border_width: Maybe<f32> = None,
  /// Every corner's radius.
  radius: Maybe<f32> = None,
  /// Space between the element's edge and what is inside it.
  padding: Maybe<Insets> = None,
  /// Space between a Row's or Column's children; a flex container's or grid's `row_gap` and
  /// `column_gap` where those are unset.
  gap: Maybe<f32> = None,
  /// The font. Inherited.
  font: Maybe<FontSpec> = None,
  /// The font's size alone, its family kept. Inherited (as part of the font).
  font_size: Maybe<f32> = None,
  /// Lines this many font sizes apart (CSS's unitless `line-height`). Inherited (as part of
  /// the font).
  line_height: Maybe<f32> = None,
  /// 0–1, multiplied into the parent's: inherited that way.
  opacity: Maybe<f32> = None,
  /// The element's width and height, and the least and greatest each may be — within what
  /// its parent allows, which wins (lengths include padding: CSS's `box-sizing: border-box`).
  width: Maybe<f32> = None,
  height: Maybe<f32> = None,
  min_width: Maybe<f32> = None,
  max_width: Maybe<f32> = None,
  min_height: Maybe<f32> = None,
  max_height: Maybe<f32> = None,
  /// Space between a flex container's or a grid's rows, and between its columns (each
  /// `gap` where unset). For a flex row, `column_gap` is between its items and `row_gap`
  /// between its lines.
  row_gap: Maybe<f32> = None,
  column_gap: Maybe<f32> = None,
  /// A flex container's: its main axis and direction, whether its items wrap onto more lines,
  /// how free space is shared along a line (`justify-content`) and across lines
  /// (`align-content`), and how items sit across their line (`align-items`).
  flex_direction: Maybe<FlexDirection> = None,
  flex_wrap: Maybe<LineWrap> = None,
  justify_content: Maybe<Justify> = None,
  align_content: Maybe<Justify> = None,
  align_items: Maybe<ItemAlign> = None,
  /// A grid's: how items sit in their cells along a row (`justify-items`; `align_items` is
  /// across), its column and row tracks, the size of a track the template does not give, and
  /// how items without a place are placed.
  justify_items: Maybe<ItemAlign> = None,
  grid_columns: Maybe<[]Track> = None,
  grid_rows: Maybe<[]Track> = None,
  grid_auto_columns: Maybe<Track> = None,
  grid_auto_rows: Maybe<Track> = None,
  grid_flow: Maybe<GridFlow> = None,
  /// An item's, in a flex container: its share of free space, how much it gives up when
  /// there is too little, its size before either, and where it goes in its container's order
  /// (lower first, ties in the tree's order).
  grow: Maybe<f32> = None,
  shrink: Maybe<f32> = None,
  basis: Maybe<Basis> = None,
  order: Maybe<i64> = None,
  /// An item's own `align-items` (and, in a grid, `justify-items`).
  align_self: Maybe<ItemAlign> = None,
  justify_self: Maybe<ItemAlign> = None,
  /// An item's place in a grid: its first column or row line and how many tracks it spans.
  grid_column: Maybe<GridSpan> = None,
  grid_row: Maybe<GridSpan> = None,
  /// Shadows the element casts, the first on top — CSS's `box-shadow`.
  box_shadow: Maybe<[]BoxShadow> = None,
  /// A gradient over the background colour — CSS's `background-image: linear-gradient(…)`.
  background_gradient: Maybe<Gradient> = None,
  /// The element and everything in it blurred by this radius (`filter: blur()`), and what is
  /// behind it blurred (`backdrop-filter: blur()`) — drawn by `ui.gpu`; SDL's 2D renderer
  /// draws them unblurred.
  filter_blur: Maybe<f32> = None,
  backdrop_blur: Maybe<f32> = None,
  /// What happens to content that does not fit, across and down — CSS's `overflow-x` and
  /// `overflow-y` (lui's `overflow` sets both).
  overflow_x: Maybe<Overflow> = None,
  overflow_y: Maybe<Overflow> = None,
  /// How a change of a property's value is shown — over time rather than at once: CSS's
  /// `transition`, one entry a property (`"all"` for every one that animates), the last
  /// entry naming a property its own.
  transition: Maybe<[]Transition> = None,
}

/// One property's transition, as CSS's: the property by its CSS name (`"opacity"`,
/// `"background-color"`, `"filter"`, … or `"all"`), how long the change takes and how long it
/// waits to start, in milliseconds, and how its progress follows time.
pub struct Transition {
  property: string,
  duration: f32 = 0.0,
  timing: Timing = TimingEase,
  delay: f32 = 0.0,
}

/// How a transition's progress follows time — CSS's timing functions: `ease` (the default),
/// `linear`, `ease-in`, `ease-out`, `ease-in-out`, `cubic-bezier(x1, y1, x2, y2)`, and
/// `steps(n)` in `n` jumps, the first at the start when the flag is set (`jump-start`; else
/// `jump-end`, CSS's default).
pub data Timing =
  | TimingEase
  | TimingLinear
  | TimingEaseIn
  | TimingEaseOut
  | TimingEaseInOut
  | TimingBezier(f32, f32, f32, f32)
  | TimingSteps(i64, bool)

/// CSS's `overflow`: content past the element's edge drawn (`OverflowVisible`), cut off and
/// scrolled only by the program (`OverflowHidden`) or never (`OverflowClip`), or cut off and
/// scrolled by the user with a scrollbar always shown (`OverflowScroll`) or shown only when
/// the content does not fit (`OverflowAuto`).
pub data Overflow = OverflowVisible | OverflowHidden | OverflowClip | OverflowScroll | OverflowAuto

/// A flex container's main axis, and which way along it its items go (CSS's
/// `flex-direction`).
pub data FlexDirection = FlexRow | FlexRowReverse | FlexColumn | FlexColumnReverse

/// Whether a flex container's items wrap onto more lines, and which way the lines stack
/// (`flex-wrap`).
pub data LineWrap = NoWrap | Wrap | WrapReverse

/// How free space along an axis is shared: CSS's `justify-content` and `align-content`
/// values. `JustifyStretch` is `align-content`'s alone — lines grown to fill.
pub data Justify =
  JustifyStart
  | JustifyEnd
  | JustifyCenter
  | JustifyBetween
  | JustifyAround
  | JustifyEvenly
  | JustifyStretch

/// Where an item sits across its line or within its grid cell (`align-items`,
/// `justify-items` and their `-self`s). `AlignBaseline` lines a flex row's items up by their
/// first lines of text, and is `AlignStart` for an item with none.
pub data ItemAlign = AlignStart | AlignEnd | AlignCenter | AlignStretch | AlignBaseline

/// A flex item's size before it grows or shrinks (`flex-basis`): its content's (or its
/// `width`/`height`), a length, or a fraction of its container's main size.
pub data Basis = BasisAuto | BasisLength(f32) | BasisFraction(f32)

/// One bound of a grid track's size: a length, a share of the free space (`fr`), or what the
/// content needs — `auto`, its min-content or its max-content size.
pub data TrackSize = TrackPx(f32) | TrackFr(f32) | TrackAuto | TrackMinContent | TrackMaxContent

/// A grid track sized between two bounds — CSS's `minmax(min, max)`; one size is both.
pub struct Track {
  min: TrackSize,
  max: TrackSize,
}

/// A track `length` units wide (or tall).
pub let px = pure (length: f32) -> Track =>
  Track { min: TrackPx(length), max: TrackPx(length) }

/// A track taking `share` of the free space — at least its content's `auto` minimum, as
/// CSS's `1fr` is `minmax(auto, 1fr)`.
pub let fr = pure (share: f32) -> Track => Track { min: TrackAuto, max: TrackFr(share) }

/// A track as large as its content, and stretched into what space is left.
pub let auto_track = pure () -> Track => Track { min: TrackAuto, max: TrackAuto }

/// A track as narrow as its content can be, or as wide as it would be on one line.
pub let min_content = pure () -> Track =>
  Track { min: TrackMinContent, max: TrackMinContent }
pub let max_content = pure () -> Track =>
  Track { min: TrackMaxContent, max: TrackMaxContent }

/// A track at least `min` and at most `max` (`max` below `min` is `min`).
pub let minmax = pure (min: TrackSize, max: TrackSize) -> Track =>
  Track { min: min, max: max }

/// `tracks` `count` times over: CSS's `repeat(count, …)`.
pub let repeat_tracks = pure (count: i64, tracks: []Track) -> []Track => {
  var out: []Track = []
  for _ in 0..<count { for t in tracks { out.push(t) } }
  out
}

/// An item's place along a grid's columns or rows: the line it starts at (1 the first, as
/// in CSS; 0 for auto-placement) and how many tracks it spans.
pub struct GridSpan {
  start: i64 = 0,
  span: i64 = 1,
}

/// How a grid places items without a place (`grid-auto-flow`): along the rows or down the
/// columns, filling earlier holes when `Dense`.
pub data GridFlow = FlowRow | FlowColumn | FlowRowDense | FlowColumnDense

impl Style {
  /// This style laid over `base`: each field this one sets, else `base`'s.
  pub let over = pure (self, base: Style) -> Style => Style {
    color: self.color.or(base.color),
    background: self.background.or(base.background),
    border_color: self.border_color.or(base.border_color),
    border_width: self.border_width.or(base.border_width),
    radius: self.radius.or(base.radius),
    padding: self.padding.or(base.padding),
    gap: self.gap.or(base.gap),
    font: self.font.or(base.font),
    font_size: self.font_size.or(base.font_size),
    line_height: self.line_height.or(base.line_height),
    opacity: self.opacity.or(base.opacity),
    width: self.width.or(base.width),
    height: self.height.or(base.height),
    min_width: self.min_width.or(base.min_width),
    max_width: self.max_width.or(base.max_width),
    min_height: self.min_height.or(base.min_height),
    max_height: self.max_height.or(base.max_height),
    row_gap: self.row_gap.or(base.row_gap),
    column_gap: self.column_gap.or(base.column_gap),
    flex_direction: self.flex_direction.or(base.flex_direction),
    flex_wrap: self.flex_wrap.or(base.flex_wrap),
    justify_content: self.justify_content.or(base.justify_content),
    align_content: self.align_content.or(base.align_content),
    align_items: self.align_items.or(base.align_items),
    justify_items: self.justify_items.or(base.justify_items),
    grid_columns: self.grid_columns.or(base.grid_columns),
    grid_rows: self.grid_rows.or(base.grid_rows),
    grid_auto_columns: self.grid_auto_columns.or(base.grid_auto_columns),
    grid_auto_rows: self.grid_auto_rows.or(base.grid_auto_rows),
    grid_flow: self.grid_flow.or(base.grid_flow),
    grow: self.grow.or(base.grow),
    shrink: self.shrink.or(base.shrink),
    basis: self.basis.or(base.basis),
    order: self.order.or(base.order),
    align_self: self.align_self.or(base.align_self),
    justify_self: self.justify_self.or(base.justify_self),
    grid_column: self.grid_column.or(base.grid_column),
    grid_row: self.grid_row.or(base.grid_row),
    box_shadow: self.box_shadow.or(base.box_shadow),
    background_gradient: self.background_gradient.or(base.background_gradient),
    filter_blur: self.filter_blur.or(base.filter_blur),
    backdrop_blur: self.backdrop_blur.or(base.backdrop_blur),
    overflow_x: self.overflow_x.or(base.overflow_x),
    overflow_y: self.overflow_y.or(base.overflow_y),
    transition: self.transition.or(base.transition),
  }
}

/// `style` for every element `selector` matches: `Text`, `.title`, `Text.title` or
/// `Toggle::knob` — or several of them, comma-separated (`Button.primary, .card`), each
/// keeping its own specificity, as if each were a rule of its own in the same place — while
/// the viewport matches `media` (any of them; none for always), CSS's `@media`.
pub struct Rule {
  selector: string,
  style: Style,
  media: []Media = [],
}

/// A condition on the viewport, CSS's media query without its media type: every bound it
/// gives must hold (`and`), at least and at most so wide and so tall in logical units, in
/// that orientation and colour scheme — the whole of it reversed by `not`. A rule's `media` is
/// a list of these, any of which may hold (CSS's comma).
pub struct Media {
  min_width: Maybe<f32> = None,
  max_width: Maybe<f32> = None,
  min_height: Maybe<f32> = None,
  max_height: Maybe<f32> = None,
  orientation: Maybe<Orientation> = None,
  scheme: Maybe<Appearance> = None,
  not: bool = false,
}

/// Taller than wide (`Portrait`, a square too, as CSS has it) or wider.
pub data Orientation = Portrait | Landscape

/// What a media query is asked of: the window's size in logical units, and the system's
/// look.
pub struct Viewport {
  size: Size = Size {},
  appearance: Appearance = LightMode,
}

impl Media {
  /// Whether `viewport` meets this condition.
  pub let matches = pure (self, viewport: Viewport) -> bool => {
    let w = viewport.size.w
    let h = viewport.size.h
    let held = within(w, self.min_width, self.max_width) &&
      within(h, self.min_height, self.max_height) &&
      (match self.orientation {
        Some(Portrait) => h >= w,
        Some(Landscape) => w > h,
        None => true,
      }) && (match self.scheme {
        Some(look) => look == viewport.appearance,
        None => true,
      })
    held != self.not
  }
}

/// Whether `viewport` meets any of `media`; an empty list always.
pub let media_matches = pure (media: []Media, viewport: Viewport) -> bool =>
  media.len() == 0 || media.any((m) => m.matches(viewport))

/// Whether `value` is at least `least` and at most `most`, each when given.
let within = pure (value: f32, least: Maybe<f32>, most: Maybe<f32>) -> bool =>
  value >= (least ?? -1.0) && value <= (most ?? 1.0e30)

/// A media query asked of the viewport, and what it answered — what a layout depended on.
pub struct MediaAnswer {
  media: []Media,
  matched: bool,
}

/// Rules, in order.
pub struct Sheet {
  rules: []Rule = [],
}

impl Sheet {
  /// The rules in force at `viewport`, in order — a media rule kept where it is written, with
  /// its specificity, as CSS keeps it — and what each media query answered.
  pub let at = pure (self, viewport: Viewport) -> (Sheet, []MediaAnswer) => {
    var kept: []Rule = []
    var answers: []MediaAnswer = []
    for rule in self.rules {
      if rule.media.len() == 0 {
        kept.push(rule)
        continue
      }
      let matched = media_matches(rule.media, viewport)
      if !answers.any((a) => a.media == rule.media) {
        answers.push(MediaAnswer { media: rule.media, matched: matched })
      }
      if matched { kept.push(rule) }
    }
    let filtered = Sheet { rules: kept }
    return (filtered, answers)
  }
}

/// The colours a theme's styles are written in. `focus` is the ring drawn round the element
/// the keyboard is at.
pub struct Palette {
  background: Color,
  surface: Color,
  text: Color,
  muted: Color,
  accent: Color,
  border: Color,
  focus: Color,
}

/// A theme's steps of space, smallest to largest, in logical units.
pub struct Spacing {
  xs: f32 = 4.0,
  s: f32 = 8.0,
  m: f32 = 12.0,
  l: f32 = 16.0,
  xl: f32 = 24.0,
}

/// A look for a whole tree: its palette, spacing, corner radius and font, and the defaults
/// each kind of element starts from (`elements`, the cascade's lowest layer).
pub struct Theme {
  colors: Palette,
  space: Spacing = Spacing {},
  radius: f32 = 6.0,
  font: FontSpec = FontSpec {},
  elements: Sheet = Sheet {},
}

/// A light theme: dark text on near-white, a blue accent, lines 1.3 sizes apart.
pub let light_theme = pure () -> Theme => theme_of(Palette {
  background: rgb(0xF2F2F5),
  surface: rgb(0xFFFFFF),
  text: rgb(0x1C1C1E),
  muted: rgb(0x6E6E73),
  accent: rgb(0x0A84FF),
  border: rgb(0xC7C7CC),
  focus: rgba(0x0A84FF80),
})

/// A dark theme: light text on near-black, the same accent, lines 1.3 sizes apart.
pub let dark_theme = pure () -> Theme => theme_of(Palette {
  background: rgb(0x1C1C1E),
  surface: rgb(0x2C2C2E),
  text: rgb(0xF2F2F7),
  muted: rgb(0x98989F),
  accent: rgb(0x0A84FF),
  border: rgb(0x48484A),
  focus: rgba(0x409CFF99),
})

/// A theme in `colors`, its controls styled by [control_rules] and its lines 1.3 sizes apart.
pub let theme_of = pure (colors: Palette) -> Theme => Theme {
  colors: colors,
  font: FontSpec { line_height: 1.3 },
  elements: Sheet { rules: control_rules(colors) },
}

/// How the controls look by default, in `c`'s colours: a theme's `elements` rules, which any
/// sheet above them overrides. A control's state is a pseudo-class (`Button:hover`,
/// `Button:active`, `TextInput:focus`) and its insides are parts (`Checkbox::box`,
/// `Slider::thumb`).
pub let control_rules = pure (c: Palette) -> []Rule => [
  Rule {
    selector: "Button",
    style: Style {
      background: Some(c.accent),
      color: Some(rgb(0xFFFFFF)),
      radius: Some(6.0),
      padding: Some(insets_xy(14.0, 6.0)),
    },
  },
  Rule { selector: "Button:hover", style: Style { background: Some(shade(c.accent, 0.88)) } },
  Rule { selector: "Button:active", style: Style { background: Some(shade(c.accent, 0.75)) } },
  Rule {
    selector: "Checkbox::box",
    style: Style {
      background: Some(c.surface),
      border_color: Some(c.border),
      border_width: Some(CHECK_BORDER),
      radius: Some(CHECK_RADIUS),
    },
  },
  // Ticked, the box keeps its border and holds the accent a gap inside it: padded by the
  // border and the gap, the fill's corners as much less round as it is inset.
  Rule {
    selector: "Checkbox::checked",
    style: Style {
      background: Some(c.surface),
      border_color: Some(c.border),
      border_width: Some(CHECK_BORDER),
      radius: Some(CHECK_RADIUS),
      padding: Some(insets(CHECK_BORDER + CHECK_GAP)),
    },
  },
  Rule {
    selector: "Checkbox::fill",
    style: Style {
      background: Some(c.accent),
      radius: Some((CHECK_RADIUS - CHECK_BORDER - CHECK_GAP).max(0.0)),
    },
  },
  Rule {
    selector: "Slider::track",
    style: Style { background: Some(c.border), radius: Some(2.0) },
  },
  Rule { selector: "Slider::fill", style: Style { background: Some(c.accent), radius: Some(2.0) } },
  Rule {
    selector: "Slider::thumb",
    style: Style {
      background: Some(rgb(0xFFFFFF)),
      border_color: Some(c.border),
      border_width: Some(1.0),
      radius: Some(10.0),
    },
  },
  Rule {
    selector: "TextInput",
    style: Style {
      background: Some(c.surface),
      border_color: Some(c.border),
      border_width: Some(1.0),
      radius: Some(6.0),
      padding: Some(insets_xy(8.0, 6.0)),
    },
  },
  Rule { selector: "TextInput:focus", style: Style { border_color: Some(c.accent) } },
  Rule { selector: "TextInput::placeholder", style: Style { color: Some(c.muted) } },
  Rule { selector: "TextInput::selection", style: Style { background: Some(faded(c.accent, 0.3)) } },
  Rule { selector: "TextInput::caret", style: Style { background: Some(c.text) } },
]

/// A scroller's bars, drawn over its content's edge: a faint track and a thumb the text's
/// colour at a third, darker while the pointer is over it or holds it. A layer beneath the
/// theme's elements, applied only as a scroller styles its bars (`Cascade.compute`'s `under`)
/// — every rule in the theme is matched against every element.
pub let scrollbar_rules = pure (c: Palette) -> []Rule => [
  Rule {
    selector: "ScrollTrack",
    style: Style { background: Some(faded(c.text, 0.06)), radius: Some(5.0) },
  },
  Rule {
    selector: "ScrollThumb",
    style: Style { background: Some(faded(c.text, 0.32)), radius: Some(4.0) },
  },
  Rule { selector: "ScrollThumb:hover", style: Style { background: Some(faded(c.text, 0.5)) } },
  Rule { selector: "ScrollThumb:active", style: Style { background: Some(faded(c.text, 0.6)) } },
]

/// A checkbox's border, the corner radius of its box, and the gap between a ticked box's
/// border and its fill.
pub const CHECK_BORDER: f32 = 1.5
pub const CHECK_RADIUS: f32 = 5.0
pub const CHECK_GAP: f32 = 2.0

/// `color` darker by `factor` (`1.0` unchanged), its alpha kept.
pub let shade = pure (color: Color, factor: f32) -> Color => Color {
  color |
  r: u8((f32(color.r) * factor).round()),
  g: u8((f32(color.g) * factor).round()),
  b: u8((f32(color.b) * factor).round()),
}

/// An element's style once the cascade has run: every property settled.
pub struct Computed {
  color: Color,
  background: Maybe<Color> = None,
  border_color: Maybe<Color> = None,
  border_width: f32 = 0.0,
  radius: f32 = 0.0,
  padding: Insets = Insets {},
  gap: f32 = 0.0,
  font: FontSpec = FontSpec {},
  /// The opacity drawn with — the element's own times every one around it — and its own.
  opacity: f32 = 1.0,
  own_opacity: f32 = 1.0,
  /// The sizes asked for; `None` for auto.
  width: Maybe<f32> = None,
  height: Maybe<f32> = None,
  min_width: Maybe<f32> = None,
  max_width: Maybe<f32> = None,
  min_height: Maybe<f32> = None,
  max_height: Maybe<f32> = None,
  row_gap: f32 = 0.0,
  column_gap: f32 = 0.0,
  flex_direction: FlexDirection = FlexRow,
  flex_wrap: LineWrap = NoWrap,
  justify_content: Justify = JustifyStart,
  /// CSS's `normal` for a flex container's lines: stretched.
  align_content: Justify = JustifyStretch,
  align_items: ItemAlign = AlignStretch,
  justify_items: ItemAlign = AlignStretch,
  grid_columns: []Track = [],
  grid_rows: []Track = [],
  grid_auto_columns: Track = Track { min: TrackAuto, max: TrackAuto },
  grid_auto_rows: Track = Track { min: TrackAuto, max: TrackAuto },
  grid_flow: GridFlow = FlowRow,
  grow: f32 = 0.0,
  shrink: f32 = 1.0,
  basis: Basis = BasisAuto,
  order: i64 = 0,
  /// `None` for the container's `align_items` (or `justify_items`).
  align_self: Maybe<ItemAlign> = None,
  justify_self: Maybe<ItemAlign> = None,
  grid_column: GridSpan = GridSpan {},
  grid_row: GridSpan = GridSpan {},
  box_shadow: []BoxShadow = [],
  background_gradient: Maybe<Gradient> = None,
  filter_blur: f32 = 0.0,
  backdrop_blur: f32 = 0.0,
  overflow_x: Overflow = OverflowVisible,
  overflow_y: Overflow = OverflowVisible,
  transition: []Transition = [],
}

/// Where an element stands in the cascade: the theme in force, the global rules (outermost
/// sheet first), the component it is in and that component's rules, the rules of the
/// component around that one (for its parts), and what its parent passes down.
pub struct Cascade {
  theme: Theme,
  globals: []Rule = [],
  component: string = "",
  /// The component's own classes, for a `Component.class::part` rule.
  component_classes: string = "",
  scoped: []Rule = [],
  outer_scoped: []Rule = [],
  inherited: Computed,
}

/// The cascade at the root of a tree drawn in `theme`.
pub let cascade_root = pure (theme: Theme) -> Cascade =>
  Cascade {
    theme: theme,
    inherited: Computed { color: theme.colors.text, font: theme.font }
  }

impl Cascade {
  /// The style for an element of `tag`, with `classes` (space-separated), marked as `part`
  /// (`""` for none) and asking for `inline`: the five layers, lowest first, over `under`.
  pub let style_of = pure (
    self,
    tag: string,
    classes: string,
    part: string,
    inline: Style,
    under: []Rule = []
  ) -> Style => {
    var out = applied(under, tag, classes, Style {})
    out = applied(self.theme.elements.rules, tag, classes, out)
    out = applied(self.globals, tag, classes, out)
    out = applied(self.scoped, tag, classes, out)
    if part.len() > 0 && self.component.len() > 0 {
      // `Component::part`, then the more specific `Component.class::part`, each in order.
      var parts: []Rule = []
      var ranked: [](i64, i64) = []
      for rules in [self.theme.elements.rules, self.globals, self.outer_scoped] {
        for rule in rules {
          for one in rule.selector.split(",") {
            let rank = part_specificity(
              one.trim(),
              self.component,
              self.component_classes,
              part,
              classes
            )
            if rank > 0 { ranked.push((rank, parts.len())) }
          }
          parts.push(rule)
        }
      }
      for (_, k) in by_rank(ranked) { out = parts[k].style.over(out) }
    }
    inline.over(out)
  }

  /// [style_of] settled against what the parent passes down.
  pub let compute = pure (
    self,
    tag: string,
    classes: string,
    part: string,
    inline: Style,
    under: []Rule = []
  ) -> Computed => {
    let s = self.style_of(tag, classes, part, inline, under)
    let base_font = s.font ?? self.inherited.font
    Computed {
      color: s.color ?? self.inherited.color,
      background: s.background,
      border_color: s.border_color,
      border_width: s.border_width ?? 0.0,
      radius: s.radius ?? 0.0,
      padding: s.padding ?? Insets {},
      gap: s.gap ?? 0.0,
      font: FontSpec {
        base_font |
        size: s.font_size ?? base_font.size,
        line_height: s.line_height ?? base_font.line_height,
      },
      opacity: self.inherited.opacity * (s.opacity ?? 1.0),
      own_opacity: s.opacity ?? 1.0,
      width: s.width,
      height: s.height,
      min_width: s.min_width,
      max_width: s.max_width,
      min_height: s.min_height,
      max_height: s.max_height,
      row_gap: s.row_gap ?? s.gap ?? 0.0,
      column_gap: s.column_gap ?? s.gap ?? 0.0,
      flex_direction: s.flex_direction ?? FlexRow,
      flex_wrap: s.flex_wrap ?? NoWrap,
      justify_content: s.justify_content ?? JustifyStart,
      align_content: s.align_content ?? JustifyStretch,
      align_items: s.align_items ?? AlignStretch,
      justify_items: s.justify_items ?? AlignStretch,
      grid_columns: s.grid_columns ?? [],
      grid_rows: s.grid_rows ?? [],
      grid_auto_columns: s.grid_auto_columns ?? auto_track(),
      grid_auto_rows: s.grid_auto_rows ?? auto_track(),
      grid_flow: s.grid_flow ?? FlowRow,
      grow: s.grow ?? 0.0,
      shrink: s.shrink ?? 1.0,
      basis: s.basis ?? BasisAuto,
      order: s.order ?? 0,
      align_self: s.align_self,
      justify_self: s.justify_self,
      grid_column: s.grid_column ?? GridSpan {},
      grid_row: s.grid_row ?? GridSpan {},
      box_shadow: s.box_shadow ?? [],
      background_gradient: s.background_gradient,
      filter_blur: (s.filter_blur ?? 0.0).max(0.0),
      backdrop_blur: (s.backdrop_blur ?? 0.0).max(0.0),
      overflow_x: s.overflow_x ?? OverflowVisible,
      overflow_y: s.overflow_y ?? OverflowVisible,
      transition: s.transition ?? [],
    }
  }

  /// The cascade for a subtree drawn in `theme`, with `sheet` as its innermost global sheet:
  /// its text takes the theme's colour and font again.
  pub let themed = pure (self, theme: Theme, sheet: Sheet) -> Cascade => Cascade {
    self |
    theme: theme,
    globals: [...self.globals, ...sheet.rules],
    inherited: Computed { self.inherited | color: theme.colors.text, font: theme.font },
  }

  /// The cascade inside a component tagged `name`, with `classes`, whose scoped sheet is
  /// `sheet`.
  pub let in_component = pure (
    self,
    name: string,
    classes: string,
    sheet: Sheet
  ) -> Cascade => Cascade {
    self |
    component: name,
    component_classes: classes,
    scoped: sheet.rules,
    outer_scoped: self.scoped,
  }

  /// The cascade for the children of an element computed as `computed`.
  pub let inside = pure (self, computed: Computed) -> Cascade =>
    Cascade { self | inherited: computed }
}

/// `base` with the rules of one layer matching an element of `tag` and `classes` laid over it,
/// least specific first and, among equals, in order — a selector list a rule for each of its
/// selectors. A part selector is no rule of a layer's.
let applied = pure (
  rules: []Rule,
  tag: string,
  classes: string,
  base: Style
) -> Style => {
  var ranked: [](i64, i64) = []
  for k, rule in rules {
    for one in rule.selector.split(",") {
      let rank = specificity(one.trim(), tag, classes)
      if rank > 0 { ranked.push((rank, k)) }
    }
  }
  var out = base
  for (_, k) in by_rank(ranked) { out = rules[k].style.over(out) }
  out
}

/// `ranked` (a specificity and a rule's index) in order of specificity, ties in order.
let by_rank = pure (ranked: [](i64, i64)) -> [](i64, i64) => {
  var out = [...ranked]
  for i in 1..<out.len() {
    var j = i
    while j > 0 && out[j - 1].0 > out[j].0 {
      let held = out[j]
      out[j] = out[j - 1]
      out[j - 1] = held
      j -= 1
    }
  }
  out
}

/// How specific a part rule's `selector` is for part `part` of a component tagged `component`
/// with `classes` (its classes and states), the part itself in the states `own`: 1 for
/// `Component::part`, and 10 more for each class or pseudo-class it asks of the component
/// (`Component.big:hover::part`) or of the part (`Component::part:focus`), every one of which
/// must hold; 0 when it does not match.
pub let part_specificity = pure (
  selector: string,
  component: string,
  classes: string,
  part: string,
  own: string = ""
) -> i64 => {
  let halves = selector.split("::")
  if halves.len() != 2 { return 0 }
  let (name, of_part) = compound(halves[1])
  if name != part || !of_part.all((a) => a.starts_with(":")) { return 0 }
  let (tag, of_component) = compound(halves[0])
  if tag != component || !holds(
    of_component,
    classes
  ) || !holds(of_part, own) { return 0 }
  1 + 10 * (of_component.len() + of_part.len())
}

/// How specific `selector` is for an element of `tag` with `classes` — its classes, and its
/// states as pseudo-classes (`:hover`; [PSEUDO_CLASSES]): 1 for its tag and 10 for each class
/// or pseudo-class it asks for (`Button.primary:hover` is 21), every one of which the element
/// must have; 0 when it does not match (a part selector never does).
pub let specificity = pure (selector: string, tag: string, classes: string) -> i64 => {
  if selector.contains("::") || selector.len() == 0 { return 0 }
  let (want, asks) = compound(selector)
  if want.len() > 0 && want != tag { return 0 }
  if !holds(asks, classes) { return 0 }
  (if want.len() > 0 { 1 } else { 0 }) + 10 * asks.len()
}

/// The states an element can be in, as CSS's pseudo-classes: the pointer over it or inside it,
/// pressed on it or inside it (`active`), the focus on it, on it from the keyboard
/// (`focus-visible`) or inside it (`focus-within`), a checkbox ticked, a text field read-only
/// or not, and a control disabled or not.
pub const PSEUDO_CLASSES: []string = [
  "hover",
  "active",
  "focus",
  "focus-visible",
  "focus-within",
  "checked",
  "read-only",
  "read-write",
  "disabled",
  "enabled",
]

/// A compound selector's tag (`""` for any) and what else it asks for: each class as its name,
/// each pseudo-class as `:name`.
pub let compound = pure (text: string) -> (string, []string) => {
  var tag = ""
  var asks: []string = []
  var piece = ""
  var mark = ' '
  for c in text {
    if c == '.' || c == ':' {
      if mark == ' ' { tag = piece } else { asks.push(asked(mark, piece)) }
      piece = ""
      mark = c
    } else {
      piece = "${piece}${c}"
    }
  }
  if mark == ' ' { tag = piece } else { asks.push(asked(mark, piece)) }
  (tag, asks)
}

/// One thing a compound selector asks for, as [compound] lists it.
let asked = pure (mark: rune, name: string) -> string =>
  if mark == ':' { ":${name}" } else { name }

/// Whether every one of `asks` — each named, none empty — is among `have` (space-separated).
let holds = pure (asks: []string, have: string) -> bool => {
  let mine = have.split(" ")
  asks.all((a) => a.len() > 0 && a != ":" && mine.any((c) => c == a))
}

/// `color` at `opacity` times its own alpha.
pub let faded = pure (color: Color, opacity: f32) -> Color =>
  if opacity >= 1.0 { color } else {
    Color { color | a: u8((f32(color.a) * opacity.clamp(0.0, 1.0)).round()) }
  }
