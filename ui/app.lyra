module ui.app
//! A program's loop: its state, a `view` of it, an `update` for each event the view's
//! controls raise, the work `update` asks for, the things it subscribes to — and the
//! framework between them.
//!
//! ```
//! import ui.app.{ App, Command, After, Subscription, Every, run }
//!
//! data Msg = Increment | Tick
//!
//! let view = pure (count: i64) -> Node<Msg> => column([
//!   text("${count}"),
//!   button("More", Increment),
//! ])
//! let update = pure (count: i64, msg: Msg) -> (i64, []Command<Msg>) => match msg {
//!   Increment => (count + 1, [After(1000, Tick)]),
//!   Tick => (count, []),
//! }
//! let subscriptions = pure (count: i64) -> []Subscription<Msg> => []
//!
//! let app = App { view: view, update: update, subscriptions: subscriptions, background: BG }
//! let last = run(app, 0, platform, renderer, fonts)
//! ```
//!
//! **Each pass** ([Host.step]): the events already due — timers, the results of commands,
//! subscriptions — each through `update`; **if anything happened since the last frame** (an
//! input, an event, or the first pass), the view of the state laid out with the framework's
//! state (`ui.interact`'s `Ui`) — each element unchanged since last frame given back from the
//! layout cache — painted and drawn; then the platform's input, **waited for** when there is
//! none, with no timeout unless a timer, an `Every` or an `EveryFrame` is due — so an idle
//! interface draws nothing and costs nothing while the user is away — each input routed to the
//! events it raises, `update` applied to each in turn, and the view laid out again before the
//! next input, so a key pressed after a click acts on what the click made.
//!
//! **`update` is pure**: it answers the next state and the [Command]s it wants carried out — a
//! file written or read, a timer, the clipboard, a web address opened, the program ended —
//! each naming the event its result comes back as. The host performs them after `update`
//! returns, and their results are events of the next pass. They are carried out where the host
//! runs, one after another; a slow read holds the loop (todo.md).
//!
//! **`subscriptions` says what the state wants to hear of** ([Subscription]): every frame, every so many
//! milliseconds, the window's size, the system's look. It is asked again after every update,
//! so a subscription is on exactly while the state says so — and the loop waits for input only
//! while no `EveryFrame` is on, and no longer than the next timer.
//!
//! **A program's own `main` can hold the loop** — `while host.step(platform, renderer, fonts)
//! {}` — which is what `lyrac run --live` needs: it swaps changed code in only at a loop of
//! `main`'s, and calls `view` and `update` through the function values in [App], which reach
//! the newest code. The host keeps the window, the framework's state and the program's state
//! across a swap; under `--live` (`LYRA_LIVE_PID` naming this process) it never waits longer than a tenth of a
//! second, so an idle window still reaches the swap, and lays the view out again each pass.
//! A change to the state's shape is a restart, which lyrac says.

import ui.backend.{
  Platform,
  Renderer,
  CloseRequested,
  Resized,
  AppearanceChanged,
  Appearance,
  KeyPressed,
  WindowFocused,
  WindowUnfocused,
  Key,
  Modifiers,
  Chord,
  MenuChosen,
  NativeMenu,
  NativeEntry,
  NativeItem,
  NativeItemSpec,
  NativeSubmenu,
  NativeSeparator,
  WindowState,
  WindowStateChanged,
  ToMinimized,
  ToMaximized,
  ToRestored,
}
import ui.draw.{ Point, Size, Rect, Color }
import ui.text.{ Fonts, FontSpec, FontMetrics, GlyphAtlas, glyph_atlas }
import ui.style.{ Viewport, Style, Overflow, OverflowAuto, light_theme }
import ui.layout.{
  Node,
  Laid,
  LayoutCache,
  layout_cache,
  paint,
  tight,
  Painted,
  WindowControl,
  MinimizeButton,
  MaximizeButton,
  CloseButton,
  focusable,
  Menu,
  MenuEntry,
  MenuItemEntry,
  Submenu,
  MenuSeparator,
  menu_shortcuts,
  entries_shortcuts,
}
import ui.interact.{ Ui, ui_new }
import ui.access.{ access_tree }
import std.io.{ read_file, write_file, readable }
import std.collections.{ HashMap, hashmap_new }
import std.env.{ lookup, process_id }

/// A program: its view of its state `s`; the next state, and the work to carry out, for each
/// event `e` its view raises; what its state subscribes to; the colour the window is cleared to
/// behind the view.
pub struct App<s, e> {
  view: (s) -> Node<e>,
  update: (s, e) -> (s, []Command<e>),
  subscriptions: (s) -> []Subscription<e>,
  background: Color,
  /// The least and greatest size the user may make the window, in logical units; a size of
  /// nothing (the default) for no limit, and a side of nothing for none that way.
  min_size: Size = Size {},
  max_size: Size = Size {},
  /// Whether the user may resize the window across and down: a side that may not is held to
  /// the size the window opened at, and a window that may neither does not resize at all.
  resize_x: bool = true,
  resize_y: bool = true,
  /// What the window does with a view that does not fit it — CSS's `overflow` on the page:
  /// scrolled, with bars while it does not fit, by default. Set on the view's root unless its
  /// own style says otherwise.
  window_overflow: Overflow = OverflowAuto,
  /// The window as the program's code describes it now — lui's `window_spec` — which the
  /// host follows under `lyrac run --live`: a reload swaps this function's body, and a change
  /// to the title, size, limits, resizing or overflow is made to the open window. `None` for
  /// a window that never changes after it opens.
  window: Maybe<() -> WindowSpec> = None,
  /// The keys the program takes whatever has the focus — a terminal's new tab, the menus'
  /// accelerators — matched before any element hears a key ([Shortcut]): a function of the
  /// state answering them ([Shortcuts]), or none. (An array of at most one: a generic struct's
  /// `None` default is not settled yet, todo.md.)
  shortcuts: []Shortcuts<s, e> = [],
  /// The program's menus, a function of the state ([Menus]), or none: **on a Mac in the
  /// system's own menu bar** — the first as the application menu, its title the app's name,
  /// macOS's Window menu after the last — kept as the state says each pass (greyed, checked;
  /// installed again when their shape changes), a choice raising its item's event and a
  /// shortcut the bar holds left to it. Elsewhere nothing is installed — the program draws
  /// `menu_bar` or a `menu_button` where it wants them — and their shortcuts are taken as
  /// `shortcuts`' are. (An array of at most one, as `shortcuts` is.)
  menus: []Menus<s, e> = [],
  /// The window's title bar: the system's (`SystemTitleBar`), or the program's own
  /// (`DrawnTitleBar`) — the window without the system's frame, moved from what the view marks
  /// [Node.window_drag] and resized from its edges, its buttons `window_buttons`. A Mac keeps
  /// the system's title bar either way, for now (`ui/WINDOW.md`).
  title_bar: TitleBar = SystemTitleBar,
}

/// Whose a window's title bar is ([App.title_bar]).
pub data TitleBar = SystemTitleBar | DrawnTitleBar

/// How far in from a window without the system's frame its edges resize it.
const RESIZE_MARGIN: f32 = 5.0

/// What a state's menus are ([App.menus]): `Menus { of: (state) => [...] }`.
pub struct Menus<s, e> {
  of: (s) -> []Menu<e>,
}

/// What a state's shortcuts are ([App.shortcuts]): `Shortcuts { of: (state) => [...] }`.
pub struct Shortcuts<s, e> {
  of: (s) -> []Shortcut<e>,
}

/// A key the program takes whatever has the focus, held with `mods`, and the event it stands
/// for. **Write the shortcut modifier as `primary`** — Command on a Mac, Control elsewhere —
/// and `control` or `command` alone for the one that is not: `Modifiers { primary: true }` and
/// `Character('t')` is ⌘T on a Mac and Ctrl+T elsewhere, `Modifiers { control: true }` is Ctrl
/// on a Mac. Shift and Alt are matched as they are; a character key is its unshifted one.
pub struct Shortcut<e> {
  key: Key,
  mods: Modifiers,
  event: e,
}

/// Whether a key held with `got` is the shortcut written with `want` ([Shortcut]).
pub let chord_matches = pure (want: Modifiers, got: Modifiers) -> bool => {
  // The modifier besides the primary one: in `want` whichever of the two is written, in
  // `got` the one held that is not primary (both held, with primary, is the other held too).
  let other_wanted = want.control || want.command
  let other_held = if got.primary { got.control && got.command } else { got.control || got.command }
  want.shift == got.shift && want.alt == got.alt && want.primary == got.primary &&
    other_wanted == other_held
}

/// A window as markup describes it — lui's `<window>`, generated as `window_spec`: its title, the
/// size it opens at, the least and greatest size the user may make it (nothing for no limit),
/// which ways it resizes, and what it does with a view that does not fit.
pub struct WindowSpec {
  title: string = "",
  size: Size = Size { w: 800.0, h: 600.0 },
  min_size: Size = Size {},
  max_size: Size = Size {},
  resize_x: bool = true,
  resize_y: bool = true,
  overflow: Overflow = OverflowAuto,
}

/// `view`, `update` and `subscriptions` as an `App` in `window`: its limits, resizing and
/// overflow, cleared to the light theme's background.
pub let app_in<s, e> = pure (
  window: WindowSpec,
  view: (s) -> Node<e>,
  update: (s, e) -> (s, []Command<e>),
  subscriptions: (s) -> []Subscription<e>
) -> App<s, e> => App {
  view: view,
  update: update,
  subscriptions: subscriptions,
  background: light_theme().colors.background,
  min_size: window.min_size,
  max_size: window.max_size,
  resize_x: window.resize_x,
  resize_y: window.resize_y,
  window_overflow: window.overflow,
}

/// Work `update` asks the host to carry out, each naming the event its result comes back as.
pub data Command<e> =
  /// Write the text to the file at the path; whether it was written.
  WriteFile(string, string, (bool) -> e)
  /// Read the file at the path; its text, or `None`.
  | ReadFile(string, (Maybe<string>) -> e)
  /// The event, this many milliseconds from now.
  | After(i64, e)
  /// Put the text on the clipboard.
  | CopyText(string)
  /// The clipboard's text.
  | PasteText((string) -> e)
  /// Open a web address (or `mailto:`, `file://`) as the system does.
  | OpenUrl(string)
  /// End the program, as closing its window does.
  | QuitApp
  /// The font's measurements at its size on this display ([Fonts.metrics]) — a grid's cell.
  | MeasureFont(FontSpec, (FontMetrics) -> e)
  /// The focus to the element keyed so ([Node.keyed]), once it is laid out — a new tab's
  /// terminal.
  | FocusKeyed(string)
  /// The scroller keyed so scrolled this far down, once it is laid out: past its end is its
  /// end (`UNBOUNDED` for it), where one that follows its end follows it again.
  | ScrollTo(string, f32)
  /// Minimize the window, maximize it, or put it back from either — asked of the system,
  /// which says when it has ([Subscription.OnWindowState]).
  | WindowMinimize
  | WindowMaximize
  | WindowRestore

/// What a state wants to hear of while it holds.
pub data Subscription<e> =
  /// Every frame drawn, with the milliseconds since the last — an animation's clock. The loop
  /// does not wait for input while one is on.
  EveryFrame((f32) -> e)
  /// The event, every so many milliseconds.
  | Every(i64, e)
  /// The window's new size, each time it changes.
  | OnResize((Size) -> e)
  /// The system's look, each time it switches between light and dark.
  | OnAppearance((Appearance) -> e)
  /// The window's keyboard focus, each time it is gained (`true`) or lost.
  | OnFocus((bool) -> e)
  /// The window minimized, maximized, made fullscreen or put back, each time it is.
  | OnWindowState((WindowState) -> e)
  /// The event each pass that file descriptor has data to read — or has closed, which a read
  /// says — so a terminal reads its programs' output as it comes, and an idle one sleeps:
  /// the platform's wait wakes for it (`Platform.wake_for`). Level-triggered, as `poll` is:
  /// the event comes again until the data is read.
  | Readable(i32, e)

/// A program with no work to ask for and nothing to subscribe to: `update` answers the next
/// state alone, Elm's sandbox.
pub let sandbox<s, e> = pure (
  view: (s) -> Node<e>,
  update: pure (s, e) -> s,
  background: Color
) -> App<s, e> => App {
  view: view,
  update: (state: s, event: e) -> (s, []Command<e>) => (update(state, event), []),
  subscriptions: (_: s) -> []Subscription<e> => [],
  background: background,
}

/// Run `app` from `state` until the user closes the window or `update` asks to quit, drawing
/// through `renderer`, its input from `platform` and its text in `fonts`; answer the last
/// state.
pub let run<s, e, p, r> where p: Platform, r: Renderer = (
  app: App<s, e>,
  state: s,
  platform: mut p,
  renderer: mut r,
  fonts: mut Fonts
) -> s => {
  var window = running(app, state, platform, renderer, fonts)
  follow_resizes(window)
  while step_running(window) {}
  // The caller's platform, renderer and fonts as the loop left them.
  platform = window.platform
  renderer = window.renderer
  fonts = window.fonts
  window.host.state
}

/// A program running in a window: its host and what it draws with, in one `shared` box —
/// the loop steps it, and the platform's live-resize hook ([follow_resizes]) redraws the same
/// one while the system holds the loop in a resize.
pub struct Running<s, e, p, r> {
  host: Host<s, e>,
  platform: p,
  renderer: r,
  fonts: Fonts,
}

/// `app` at `state`, ready to run in `platform`'s window, drawn by `renderer` in `fonts`.
pub let running<s, e, p, r> where p: Platform, r: Renderer = (
  app: App<s, e>,
  state: s,
  platform: p,
  renderer: r,
  fonts: Fonts
) -> shared Running<s, e, p, r> => Running {
  host: host_of(app, state, platform),
  platform: platform,
  renderer: renderer,
  fonts: fonts,
}

/// One pass of `window`'s loop (`Host.step`); whether the program goes on. A program whose
/// loop is `main`'s own — as `lyrac run --live` needs — calls this.
pub let step_running<s, e, p, r> where p: Platform, r: Renderer = (
  window: shared Running<s, e, p, r>
) -> bool =>
  window.host.step(window.platform, window.renderer, window.fonts)

/// Have `window`'s platform redraw it, at its new size, each time the system asks for a
/// frame while the window is resized by dragging — on macOS AppKit holds the main thread, and
/// so the loop, until the drag ends. Drawn only at a size not yet shown: the system asks
/// sixty times a second however long the resize lasts, moved or not.
pub let follow_resizes<s, e, p, r> where p: Platform, r: Renderer = (
  window: shared Running<s, e, p, r>
) -> void => {
  let hook = () -> void => {
    let size = window.platform.window_size()
    if size == window.host.drawn_at { return }
    window.host.redraw(window.platform, window.renderer, window.fonts)
  }
  window.platform.on_live_resize(hook)
}

/// What a running program's loop holds between passes: the program, its state, the
/// framework's state and glyphs, the events waiting to be delivered and the timers waiting to
/// be due, when each `Every` period last fired, when the last frame was drawn, whether the
/// program is still running, and the tree it last showed.
pub struct Host<s, e> {
  app: App<s, e>,
  state: s,
  ui: Ui,
  atlas: GlyphAtlas,
  waiting: []e = [],
  /// Fonts asked to be measured ([MeasureFont]), answered at the next pass, where the fonts are.
  measures: []Measure<e> = [],
  timers: []Timer<e> = [],
  fired: [](i64, i64) = [],
  /// What the items of the menus last handed to the platform raise, by tag; whether the
  /// platform took them into a bar of its own; and the shortcuts that bar holds.
  menu_events: []e = [],
  native_menus: bool = false,
  native_chords: []Chord = [],
  /// Whether the system's frame has been taken away, for a drawn title bar.
  undecorated: bool = false,
  last_frame: i64 = -1,
  running: bool = true,
  live: bool = false,
  /// The window as `App.window` last described it, to tell a reload's change from none.
  window_seen: Maybe<WindowSpec> = None,
  /// Each element's last layout, for the next pass to give back what has not changed.
  cache: LayoutCache<e>,
  /// Whether something has happened since the last frame was drawn, so the next pass draws.
  dirty: bool = true,
  /// How many frames have been drawn, and how many times the view has been laid out — for a
  /// test that an idle program does neither.
  frames: i64 = 0,
  layouts: i64 = 0,
  /// The tree as last laid out, after the last input of the last pass — none before the
  /// first. (An array of at most one: a generic struct's `None` default is not settled yet,
  /// todo.md.)
  shown: []Laid<e> = [],
  /// The window's size at the last frame drawn.
  drawn_at: Size = Size {},
  /// Each painted element with an `on_size`, by identity, at the size it was last laid out
  /// at — to tell a new size from the same.
  painted_sizes: HashMap<string, Size>,
}

/// `view` as the window's root: filling it, and overflowing it as `overflow` says on each
/// axis its own style leaves unset.
pub let in_window<e> = pure (view: Node<e>, overflow: Overflow) -> Node<e> => Node {
  view |
  style: Style {
    view.style |
    overflow_x: view.style.overflow_x.or(Some(overflow)),
    overflow_y: view.style.overflow_y.or(Some(overflow)),
  },
}

/// The boxes in the window of what in `laid` (at `origin`) moves the window — marked
/// [Node.window_drag] — into `drags`, and of what takes a press there — a control, a window
/// button — into `keeps`.
let press_areas<e> = (
  laid: Laid<e>,
  origin: Point,
  drags: mut []Rect,
  keeps: mut []Rect
) -> void => {
  let box = Rect { x: origin.x, y: origin.y, w: laid.size.w, h: laid.size.h }
  if laid.drags_window { drags.push(box) }
  let takes = focusable(laid.kind) || match laid.kind {
    WindowControl(_) => true,
    _ => false,
  }
  if takes {
    keeps.push(box)
    return
  }
  for child in laid.children {
    press_areas(
      child.laid,
      Point { x: origin.x + child.at.x, y: origin.y + child.at.y },
      drags,
      keeps
    )
  }
}

/// `entries` as a platform's own menu bar takes them, each item tagged by its place in
/// `events`, where its event is put; each shortcut put in `chords`.
let native_entries<e> = (
  entries: []MenuEntry<e>,
  events: mut []e,
  chords: mut []Chord
) -> []NativeEntry => {
  var out: []NativeEntry = []
  for entry in entries {
    match entry {
      MenuItemEntry(item) => {
        if let Some(c) = item.shortcut { chords.push(c) }
        out.push(NativeItem(NativeItemSpec {
          label: item.label,
          tag: i32(events.len()),
          shortcut: item.shortcut,
          enabled: item.enabled,
          checked: item.checked,
        }))
        events.push(item.on_select)
      },
      Submenu(label, inner) =>
        out.push(NativeSubmenu(label, native_entries(inner, events, chords))),
      MenuSeparator => out.push(NativeSeparator),
    }
  }
  out
}

/// The window as a sheet's media rules ask of it: its size and the system's look — and whether
/// it is Apple's, which a menu's shortcuts are spelled by.
let viewport_of<p> where p: Platform = (platform: p) -> Viewport =>
  Viewport {
    size: platform.window_size(),
    appearance: platform.appearance(),
    apple: platform.apple(),
    maximized: platform.window_state().maximized,
  }

/// The sooner of a wait (`-1` for none) and `delay` milliseconds, never below none at all.
let sooner = pure (wait: i64, delay: i64) -> i64 => {
  let d = delay.max(0)
  if wait < 0 { d } else { wait.min(d) }
}

/// A font to measure, and the event its measurements come back as.
pub struct Measure<e> {
  font: FontSpec,
  done: (FontMetrics) -> e,
}

/// An event due at a moment of the platform's clock.
pub struct Timer<e> {
  at: i64,
  event: e,
}

/// A host for `app` at `state`, on `platform`'s clock.
pub let host_of<s, e, p> where p: Platform = (
  app: App<s, e>,
  state: s,
  platform: p
) -> Host<s, e> =>
  Host {
    app: app,
    state: state,
    ui: ui_new(),
    atlas: glyph_atlas(),
    cache: layout_cache::<e>(),
    painted_sizes: hashmap_new::<string, Size>(),
    last_frame: platform.now_ms(),
    live: lookup("LYRA_LIVE_PID") == Some("${process_id()}"),
  }

/// The longest a pass waits for input under `lyrac run --live`, and how long a frame lasts
/// while an animation runs, in milliseconds.
pub const LIVE_WAIT_MS: i64 = 100
pub const FRAME_MS: i64 = 16

/// How many times a layout is done again for painted elements' new sizes before it is shown
/// as it is.
pub const SIZE_ROUNDS: i64 = 3

impl Host<s, e> {
  /// One pass of the loop: what is due, delivered; the view drawn; input waited for and
  /// routed. Whether the program goes on.
  pub let step<p, r> where p: Platform, r: Renderer = (
    self: mut,
    platform: mut p,
    renderer: mut r,
    fonts: mut Fonts
  ) -> bool => {
    let now = platform.now_ms()
    self.measure(platform, fonts)
    self.read_ready(now, platform)
    self.deliver_due(now, platform)
    let subs = (self.app.subscriptions)(self.state)
    let elapsed = f32(now - self.last_frame)
    self.last_frame = now
    for sub in subs {
      if let EveryFrame(make) = sub { self.dispatch(make(elapsed), now, platform) }
    }
    self.deliver_due(now, platform)
    if !self.running { return false }
    // Drawn only when something may have changed — an input, an event, the first pass — or
    // every pass under `--live`, where the code itself may have.
    if self.shown.len() == 0 { self.limit_size(platform, platform.window_size()) }
    if self.live { self.follow_window(platform) }
    self.sync_menus(platform)
    // A transition moving draws every frame too, until it arrives.
    if self.dirty || self.live || self.shown.len() == 0 || self.ui.animating() { self.redraw(
      platform,
      renderer,
      fonts
    ) }
    // From the layout just drawn, before the wait the next press comes in.
    self.sync_title_bar(platform)
    var laid = self.shown[0]
    // The descriptors the state reads, which wake the wait when they have data.
    platform.wake_for(self.watched())
    for input in platform.next_events(self.wait_ms(now)) {
      self.dirty = true
      let at = platform.now_ms()
      match input {
        CloseRequested => {
          self.running = false
          return false
        },
        Resized(size) => self.heard(at, platform, (sub) => match sub {
          OnResize(make) => Some(make(size)),
          _ => None,
        }),
        AppearanceChanged(look) => self.heard(at, platform, (sub) => match sub {
          OnAppearance(make) => Some(make(look)),
          _ => None,
        }),
        WindowFocused => self.heard(at, platform, (sub) => match sub {
          OnFocus(make) => Some(make(true)),
          _ => None,
        }),
        WindowUnfocused => self.heard(at, platform, (sub) => match sub {
          OnFocus(make) => Some(make(false)),
          _ => None,
        }),
        WindowStateChanged(state) => self.heard(at, platform, (sub) => match sub {
          OnWindowState(make) => Some(make(state)),
          _ => None,
        }),
        MenuChosen(tag) => {
          if tag >= 0 && i64(tag) < self.menu_events.len() { self.dispatch(
            self.menu_events[tag],
            at,
            platform
          ) }
        },
        _ => {},
      }
      // A key the system's own menu bar holds is the bar's: AppKit chooses its item, and SDL
      // hears the key as well.
      let barred = match input {
        KeyPressed(key, mods) => self.native_menus && self.native_chords.any((c) => c.key == key && chord_matches(c.mods, mods)),
        _ => false,
      }
      // A shortcut is the program's before any element hears the key.
      let taken = match input {
        KeyPressed(key, mods) => if barred { None } else { self.shortcut_for(key, mods) },
        _ => None,
      }
      let events = if barred { [] } else {
        match taken {
          Some(event) => [event],
          None => self.ui.handle(laid, input, platform),
        }
      }
      for event in events { self.dispatch(event, at, platform) }
      // The window's own buttons, the framework's to carry out: close as the system's does.
      for button in self.ui.take_window_buttons() {
        match button {
          MinimizeButton => platform.change_window(ToMinimized),
          MaximizeButton => platform.change_window(if platform.window_state().maximized { ToRestored } else { ToMaximized }),
          CloseButton => {
            self.running = false
            return false
          },
        }
      }
      self.deliver_due(at, platform)
      if !self.running { return false }
      laid = self.lay_out_view(platform, fonts)
      self.shown = [laid]
    }
    self.running
  }

  /// The view laid out at the window's size now and drawn — what a pass does when something
  /// may have changed, and what a program's live-resize watch calls while the system holds
  /// its loop (`bindings.sdl3`'s `add_event_watch`, `examples/ui/layouts.lyra`), so the
  /// contents follow the window's edge as it is dragged.
  pub let redraw<p, r> where p: Platform, r: Renderer = (
    self: mut,
    platform: mut p,
    renderer: mut r,
    fonts: mut Fonts
  ) -> void => {
    let fresh = self.lay_out_view(platform, fonts)
    self.ui.place_text_input(fresh, platform)
    let ops = paint(fresh, Point {}, platform.scale(), fonts, self.atlas, renderer)
    renderer.draw(self.app.background, ops)
    platform.update_access(access_tree(fresh, self.ui.state.focus))
    self.frames += 1
    self.shown = [fresh]
    self.drawn_at = platform.window_size()
    self.dirty = false
  }

  /// The view of the state laid out at the window's size, with the framework's state — and
  /// laid out again after the events of painted elements whose size it changed, so a frame
  /// never shows what a painter drew for its last size (at most [SIZE_ROUNDS] times, so a
  /// size that changes with every event cannot hold the loop).
  let lay_out_view<p> where p: Platform = (
    self: mut,
    platform: mut p,
    fonts: mut Fonts
  ) -> Laid<e> => {
    var rounds = 0
    loop {
      self.ui.state.viewport = viewport_of(platform)
      self.ui.now = platform.now_ms()
      let laid = self.ui.frame_within(
        in_window((self.app.view)(self.state), self.app.window_overflow),
        tight(platform.window_size()),
        fonts,
        self.cache
      )
      self.layouts += 1
      var sizes = hashmap_new::<string, Size>()
      var events: []e = []
      sized_events(laid, self.painted_sizes, sizes, events)
      self.painted_sizes = sizes
      if events.len() == 0 || rounds >= SIZE_ROUNDS { return laid }
      let now = platform.now_ms()
      for event in events { self.dispatch(event, now, platform) }
      rounds += 1
    }
  }

  /// `App`'s least and greatest size handed to the platform — the first pass's — with a side
  /// that may not resize held at both to the size the window has, within them.
  let limit_size<p> where p: Platform = (self, platform: mut p, size: Size) -> void => {
    let held = size.held(self.app.min_size, self.app.max_size)
    let least = Size {
      w: if self.app.resize_x { self.app.min_size.w } else { held.w },
      h: if self.app.resize_y { self.app.min_size.h } else { held.h },
    }
    let most = Size {
      w: if self.app.resize_x { self.app.max_size.w } else { held.w },
      h: if self.app.resize_y { self.app.max_size.h } else { held.h },
    }
    platform.set_size_limits(least, most)
  }

  /// Under `--live`, the window as the program's newest code describes it (`App.window`): a
  /// change since the last pass — a reload — made to the open window. The limits are lifted
  /// first, so a new size is not held to the old ones, and set again at the new size.
  let follow_window<p> where p: Platform = (self: mut, platform: mut p) -> void => {
    let Some(describe) = self.app.window else { return }
    let spec = describe()
    let Some(was) = self.window_seen else {
      self.window_seen = Some(spec)
      return
    }
    if spec == was { return }
    self.window_seen = Some(spec)
    if spec.title != was.title { platform.set_title(spec.title) }
    self.app = App {
      self.app |
      min_size: spec.min_size,
      max_size: spec.max_size,
      resize_x: spec.resize_x,
      resize_y: spec.resize_y,
      window_overflow: spec.overflow,
    }
    var size = platform.window_size()
    if spec.size != was.size {
      platform.set_size_limits(Size {}, Size {})
      size = spec.size.held(spec.min_size, spec.max_size)
      platform.set_window_size(size)
    }
    self.limit_size(platform, size)
    self.dirty = true
  }

  /// How long the pass may wait for input from `now`: not at all while events wait, a frame
  /// while a frame subscription is on or a transition moves, until the next timer or `Every`, else for good — never
  /// past a tenth of a second under `--live`.
  let wait_ms = (self: mut, now: i64) -> i64 => {
    if self.waiting.len() > 0 || self.measures.len() > 0 { return 0 }
    for fd in self.watched() {
      if readable(fd) { return 0 }
    }
    var wait: i64 = if self.ui.animating() { FRAME_MS } else { -1 }
    for timer in self.timers { wait = sooner(wait, timer.at - now) }
    for sub in (self.app.subscriptions)(self.state) {
      match sub {
        EveryFrame(_) => { wait = sooner(wait, FRAME_MS) },
        Every(period, _) => { wait = sooner(wait, self.last_fired(period, now) + period - now) },
        _ => {},
      }
    }
    if !self.live { return wait }
    if wait < 0 { LIVE_WAIT_MS } else { wait.min(LIVE_WAIT_MS) }
  }

  /// The events due by `now`, each through `update`: the results waiting, the timers whose
  /// moment has come, and each `Every` whose period has passed — until none is left (at most
  /// a thousand, so an update that answers every event with another cannot hold the loop).
  let deliver_due<p> where p: Platform = (
    self: mut,
    now: i64,
    platform: mut p
  ) -> void => {
    var rounds = 0
    loop {
      var due: []e = self.waiting
      self.waiting = []
      var later: []Timer<e> = []
      for timer in self.timers {
        if timer.at <= now { due.push(timer.event) } else { later.push(timer) }
      }
      self.timers = later
      for sub in (self.app.subscriptions)(self.state) {
        if let Every(period, event) = sub {
          if now - self.last_fired(period, now) >= period {
            due.push(event)
            self.fire(period, now)
          }
        }
      }
      if due.len() == 0 { return }
      for event in due { self.dispatch(event, now, platform) }
      rounds += 1
      if rounds >= 1000 || !self.running { return }
    }
  }

  /// `event` through `update`, and the commands it answers carried out.
  let dispatch<p> where p: Platform = (
    self: mut,
    event: e,
    now: i64,
    platform: mut p
  ) -> void => {
    self.dirty = true
    let (next, commands) = (self.app.update)(self.state, event)
    self.state = next
    for command in commands {
      match command {
        WriteFile(path, text, done) => self.waiting.push(done(write_file(path, text))),
        ReadFile(path, done) => self.waiting.push(done(read_file(path))),
        After(ms, later) => self.timers.push(Timer { at: now + ms, event: later }),
        CopyText(text) => platform.set_clipboard(text),
        PasteText(done) => self.waiting.push(done(platform.clipboard())),
        OpenUrl(url) => {
          let _ = platform.open_url(url)
        },
        QuitApp => { self.running = false },
        WindowMinimize => platform.change_window(ToMinimized),
        WindowMaximize => platform.change_window(ToMaximized),
        WindowRestore => platform.change_window(ToRestored),
        MeasureFont(font, done) => self.measures.push(Measure { font: font, done: done }),
        FocusKeyed(key) => self.ui.focus_keyed(key),
        ScrollTo(key, y) => self.ui.scroll_keyed(key, y),
      }
    }
  }

  /// The event of the program's shortcut for `key` held with `mods`, if it has one: one of
  /// [App.shortcuts], else an enabled item's of a menu the window draws (`menu_shortcuts`), so
  /// a menu's shortcut is written once, on its item.
  let shortcut_for = (self, key: Key, mods: Modifiers) -> Maybe<e> => {
    for list in self.app.shortcuts {
      for s in (list.of)(self.state) {
        if s.key == key && chord_matches(s.mods, mods) { return Some(s.event) }
      }
    }
    if !self.native_menus {
      for list in self.app.menus {
        for m in (list.of)(self.state) {
          for (chord, event) in entries_shortcuts(m.entries) {
            if chord.key == key && chord_matches(chord.mods, mods) { return Some(event) }
          }
        }
      }
    }
    for laid in self.shown {
      for (chord, event) in menu_shortcuts(laid) {
        if chord.key == key && chord_matches(chord.mods, mods) { return Some(event) }
      }
    }
    None
  }

  /// A drawn title bar ([App.title_bar]): the system's frame taken away once, and each pass the
  /// platform told what of the window as last laid out moves it — what the view marks
  /// [Node.window_drag] — and, inside that, what keeps a press: its controls and the window's
  /// buttons.
  let sync_title_bar<p> where p: Platform = (self: mut, platform: mut p) -> void => {
    if self.app.title_bar != DrawnTitleBar { return }
    if !self.undecorated {
      platform.set_decorated(false)
      self.undecorated = true
    }
    var drags: []Rect = []
    var keeps: []Rect = []
    for laid in self.shown { press_areas(laid, Point {}, drags, keeps) }
    platform.set_window_areas(drags, keeps, RESIZE_MARGIN)
  }

  /// The program's menus ([App.menus]) as the state has them now, handed to the platform for
  /// its own menu bar: each item a tag, its event kept here by it, and the shortcuts a bar
  /// that took them holds. Nothing when the program has none, so SDL's own bar stays.
  let sync_menus<p> where p: Platform = (self: mut, platform: mut p) -> void => {
    if self.app.menus.len() == 0 { return }
    var events: []e = []
    var chords: []Chord = []
    var natives: []NativeMenu = []
    for list in self.app.menus {
      for m in (list.of)(self.state) {
        natives.push(NativeMenu {
          label: m.label,
          entries: native_entries(m.entries, events, chords)
        })
      }
    }
    self.menu_events = events
    self.native_chords = chords
    self.native_menus = platform.set_menus(natives)
  }

  /// The descriptors the state's `Readable` subscriptions read.
  let watched = (self) -> []i32 => {
    var fds: []i32 = []
    for sub in (self.app.subscriptions)(self.state) {
      if let Readable(fd, _) = sub { fds.push(fd) }
    }
    fds
  }

  /// Each `Readable` subscription whose descriptor has data now, through `update`.
  let read_ready<p> where p: Platform = (
    self: mut,
    now: i64,
    platform: mut p
  ) -> void => {
    for sub in (self.app.subscriptions)(self.state) {
      if let Readable(fd, event) = sub {
        if readable(fd) { self.dispatch(event, now, platform) }
      }
    }
  }

  /// The fonts asked to be measured, measured: their events waiting for the next delivery.
  let measure<p> where p: Platform = (
    self: mut,
    platform: p,
    fonts: mut Fonts
  ) -> void => {
    for asked in self.measures {
      self.waiting.push((asked.done)(fonts.metrics(asked.font, platform.scale())))
    }
    self.measures = []
  }

  /// The event each subscription `pick` answers for, through `update`.
  let heard<p> where p: Platform = (
    self: mut,
    now: i64,
    platform: mut p,
    pick: (Subscription<e>) -> Maybe<e>
  ) -> void => {
    for sub in (self.app.subscriptions)(self.state) {
      if let Some(event) = pick(sub) { self.dispatch(event, now, platform) }
    }
  }

  /// When an `Every` of `period` last fired; `now` for one that has not, so its first is a
  /// period after it was first seen.
  let last_fired = (self: mut, period: i64, now: i64) -> i64 => {
    for (p, at) in self.fired {
      if p == period { return at }
    }
    self.fired.push((period, now))
    now
  }

  /// `period`'s `Every` fired at `now`.
  let fire = (self: mut, period: i64, now: i64) -> void => {
    self.fired = [...[f in self.fired | f.0 != period | f], (period, now)]
  }
}

/// Below `laid`: each painted element with an `on_size`, its size put in `sizes`, and its
/// event in `events` where `seen` had it at another size or not at all.
let sized_events<e> = (
  laid: Laid<e>,
  seen: HashMap<string, Size>,
  sizes: mut HashMap<string, Size>,
  events: mut []e
) -> void => {
  if let Painted(painter) = laid.kind {
    if let Some(sized) = painter.on_size {
      sizes.insert(laid.id, laid.size)
      if seen.get(laid.id) != Some(laid.size) { events.push(sized(laid.size)) }
    }
  }
  for child in laid.children { sized_events(child.laid, seen, sizes, events) }
}
