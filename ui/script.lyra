module ui.script
//! Input written down: a [ScriptPlatform] that plays a list of inputs to a program with no
//! window and no user, and [parse_script], which reads that list from a line of text — how a
//! test drives an interface, and how an example shows it working without anyone at the keys.
//!
//! ```
//! let Ok(inputs) = parse_script("Tab 'Ada' Tab Space Shift+Tab Primary+a click:40,120") else { … }
//! var platform = script_platform(inputs, Size { w: 400.0, h: 300.0 })
//! let final = run(app, state, platform, renderer, fonts)
//! ```
//!
//! **A script** is tokens a space apart:
//!
//! - `'text'` — text typed, as an input method would hand it over (a [TextTyped]); a quote
//!   inside is written `\'`.
//! - a key, held with any of `Shift+`, `Alt+`, `Ctrl+`, `Cmd+` and `Primary+` (Command on a
//!   Mac, Control elsewhere — the shortcut modifier): `Tab`, `Enter`, `Space`, `Escape`,
//!   `Backspace`, `Delete`, `Left`, `Right`, `Up`, `Down`, `Home`, `End`, `PageUp`,
//!   `PageDown`, `Insert`, `F1` to `F24`, or one character (`a`, `/`), which is its key.
//! - `compose:'text'` — an input method's composition in progress, its caret at its end
//!   (`compose:''` ends it).
//! - `focus`, `blur` — the window gained the keyboard's focus, or lost it.
//! - `maximize`, `minimize`, `restore` — the system did that to the window
//!   ([WindowStateChanged]).
//! - `menu:N` — the item tagged `N` of the platform's own menu bar chosen ([MenuChosen]), as
//!   on a Mac; a script platform has such a bar where its `native_menus` says.
//! - a pointer input with modifiers, `Shift+click:X,Y` — held for its inputs alone
//!   ([Platform.held]); only [parse_steps] reads it.
//! - `move:X,Y`, `down:X,Y`, `up:X,Y` and `click:X,Y` (a move, a press and a release) — the
//!   pointer, in logical units; `double:X,Y` and `triple:X,Y` are two and three clicks in a
//!   row, the last press counting 2 or 3; `scroll:N` scrolls down `N` lines (up for a negative `N`), `scroll:X,Y` across and down.
//! - `resize:W,H` — the window resized; `drag:W,H` — dragged to that size while the platform
//!   holds the loop (its live-resize hook called, no input); `dark`, `light` — the system's
//!   look changed.
//! - `wait:N` — `N` milliseconds pass on the platform's clock, as far as the program waits
//!   (a timer due sooner fires first). Only [parse_steps] reads it; a script of inputs alone
//!   is [parse_script]'s.
//!
//! Every input is one pass of a program's loop: the platform answers one at a time, then
//! [CloseRequested] once they are spent. Its clock stands still but for `wait:`, so a timer's
//! firing is exact.

import ui.backend.{
  Platform,
  InputEvent,
  CloseRequested,
  PointerMoved,
  PointerDown,
  PointerUp,
  Scrolled,
  KeyPressed,
  TextTyped,
  TextComposing,
  WindowFocused,
  WindowUnfocused,
  Primary,
  Key,
  Modifiers,
  Enter,
  Escape,
  Tab,
  Backspace,
  Delete,
  ArrowLeft,
  ArrowRight,
  ArrowUp,
  ArrowDown,
  Home,
  End,
  PageUp,
  PageDown,
  Insert,
  FunctionKey,
  Character,
  Cursor,
  Arrow,
  Resized,
  Appearance,
  LightMode,
  DarkMode,
  AppearanceChanged,
  AccessTree,
  NativeMenu,
  MenuChosen,
  WindowState,
  ToMinimized,
  ToMaximized,
  ToRestored,
  WindowStateChanged,
}
import ui.draw.{ Point, Size, Rect }

/// A platform with no window: its inputs come from a list of [Step]s, its clock moves only
/// when a step says time passes, its size and scale are fixed until a step resizes it, and its
/// clipboard, text-input field, pointer shape, look, the addresses it was asked to open and the
/// accessibility tree it was last given are values a test can read.
pub struct ScriptPlatform {
  steps: []Step,
  next: i64 = 0,
  size: Size,
  units: f32 = 1.0,
  clip: string = "",
  typing: Maybe<Rect> = None,
  shape: Cursor = Arrow,
  look: Appearance = LightMode,
  /// Whether it plays one of Apple's systems, as far as shortcuts are spelled; and whether
  /// it has a menu bar of its own, as a Mac does, and the menus it was last given for it
  /// ([Platform.set_menus]).
  apple_keys: bool = false,
  native_menus: bool = false,
  menus: []NativeMenu = [],
  /// The window's state; whether it has the system's frame; the areas a drawn title bar was
  /// last given ([Platform.set_window_areas]); and the system's answers to changes asked of
  /// it, said at the next pass.
  window: WindowState = WindowState {},
  decorated: bool = true,
  drag_areas: []Rect = [],
  keep_areas: []Rect = [],
  resize_margin: f32 = 0.0,
  answers: []InputEvent = [],
  opened: []string = [],
  access: AccessTree = AccessTree {},
  /// The least and greatest size the window may be (nothing for no limit), which a step's
  /// resize is held to, as a window's would be.
  least: Size = Size {},
  most: Size = Size {},
  /// The window's title, as the program last set it.
  title: string = "",
  /// The live-resize hook, and how many times a drag step called it.
  hook: Maybe<() -> void> = None,
  dragged: i64 = 0,
  /// The clock, in milliseconds, and how much of the current wait has passed.
  clock: i64 = 0,
  waited: i64 = 0,
  /// The modifier keys held, as the last `Holding` step said.
  holding: Modifiers = Modifiers {},
}

/// One step of a script: an input, time passing, the window dragged to a size — the
/// platform's live-resize hook called from inside its wait, as macOS does, with no input — or
/// the modifier keys held from now on ([Platform.held]), for the pointer.
pub data Step = Played(InputEvent) | Waited(i64) | Dragged(Size) | Holding(Modifiers)

/// A platform playing `inputs`, its window `size` large, with no time passing.
pub let script_platform = pure (inputs: []InputEvent, size: Size) -> ScriptPlatform =>
  ScriptPlatform { steps: [i in inputs | Played(i)], size: size }

/// A platform playing `steps`, its window `size` large.
pub let timed_platform = pure (steps: []Step, size: Size) -> ScriptPlatform =>
  ScriptPlatform { steps: steps, size: size }

impl Platform for ScriptPlatform {
  next_events = (self, wait_ms) => {
    // A change asked of the window, done as a system would, said first.
    if self.answers.len() > 0 {
      let said = self.answers
      self.answers = []
      return said
    }
    if self.next >= self.steps.len() { return [CloseRequested] }
    match self.steps[self.next] {
      // Time passes as far as the program waits — no further than the step says.
      Waited(ms) => {
        let left = ms - self.waited
        let by = if wait_ms < 0 { left } else { wait_ms.min(left) }
        self.clock += by
        self.waited += by
        if self.waited >= ms {
          self.next += 1
          self.waited = 0
        }
        []
      },
      Holding(mods) => {
        self.next += 1
        self.holding = mods
        []
      },
      Dragged(size) => {
        self.next += 1
        self.size = size.held(self.least, self.most)
        if let Some(redraw) = self.hook {
          self.dragged += 1
          redraw()
        }
        []
      },
      Played(input) => {
        self.next += 1
        match input {
          WindowStateChanged(state) => { self.window = state },
          Resized(size) => {
            self.size = size.held(self.least, self.most)
            return [Resized(self.size)]
          },
          AppearanceChanged(look) => { self.look = look },
          _ => {},
        }
        [input]
      },
    }
  }
  window_size = pure (self) => self.size
  held = pure (self) => self.holding
  // It never waits: each pass plays the next step.
  wake_for = (self, fds) => {}
  scale = pure (self) => self.units
  set_text_input = (self, field) => { self.typing = field }
  clipboard = pure (self) => self.clip
  set_clipboard = (self, text) => { self.clip = text }
  set_cursor = (self, cursor) => { self.shape = cursor }
  now_ms = pure (self) => self.clock
  appearance = pure (self) => self.look
  apple = pure (self) => self.apple_keys
  open_url = (self, url) => {
    self.opened.push(url)
    true
  }
  update_access = (self, tree) => { self.access = tree }
  on_live_resize = (self, hook) => { self.hook = Some(hook) }
  set_size_limits = (self, least, most) => {
    self.least = least
    self.most = most
    self.size = self.size.held(least, most)
  }
  set_window_size = (self, size) => {
    self.size = size.held(self.least, self.most)
  }
  set_title = (self, title) => { self.title = title }
  set_menus = (self, menus) => {
    self.menus = menus
    self.native_menus
  }
  window_state = pure (self) => self.window
  change_window = (self, change) => {
    self.window = match change {
      ToMinimized => WindowState { self.window | minimized: true },
      ToMaximized => WindowState { minimized: false, maximized: true },
      ToRestored => WindowState {},
    }
    self.answers.push(WindowStateChanged(self.window))
  }
  set_decorated = (self, on) => { self.decorated = on }
  set_window_areas = (self, drags, keeps, margin) => {
    self.drag_areas = drags
    self.keep_areas = keeps
    self.resize_margin = margin
  }
}

/// The inputs `script` writes down, or what is wrong with it — a script of inputs alone,
/// which [parse_steps] reads too; time passing (`wait:N`) and a drag (`drag:W,H`) are refused
/// here.
pub let parse_script = pure (script: string) -> Result<[]InputEvent, string> => {
  var inputs: []InputEvent = []
  for step in parse_steps(script)? {
    match step {
      Played(input) => inputs.push(input),
      Waited(_) =>
        return Err("wait: is a step, not an input; read the script with parse_steps"),
      Dragged(_) =>
        return Err("drag: is a step, not an input; read the script with parse_steps"),
      Holding(_) =>
        return Err("a modifier on the pointer is a step, not an input; read the script with parse_steps"),
    }
  }
  Ok(inputs)
}

/// The steps `script` writes down, or what is wrong with it.
pub let parse_steps = pure (script: string) -> Result<[]Step, string> => {
  var inputs: []Step = []
  for token in tokens(script) {
    if token.starts_with("'") {
      inputs.push(Played(TextTyped(token.slice(1, token.len() - 1).replace("\\'", "'"))))
      continue
    }
    if let Some((verb, place)) = pointer_token(token) {
      let Some(at) = point(place) else { return Err("not a point: ${token}") }
      match verb {
        "move" => inputs.push(Played(PointerMoved(at))),
        "down" => inputs.push(Played(PointerDown(Primary, at, 1))),
        "up" => inputs.push(Played(PointerUp(Primary, at))),
        "click" | "double" | "triple" => {
          inputs.push(Played(PointerMoved(at)))
          let times = if verb == "triple" { 3 } else if verb == "double" { 2 } else { 1 }
          for n in 1..<=times {
            inputs.push(Played(PointerDown(Primary, at, n)))
            inputs.push(Played(PointerUp(Primary, at)))
          }
        },
        _ => return Err("not a pointer input: ${token}"),
      }
      continue
    }
    if let Some(lines) = token.strip_prefix("scroll:") {
      // `scroll:N` down, or `scroll:X,Y` across and down.
      if let Some(at) = point(lines) {
        inputs.push(Played(Scrolled(at.x, at.y)))
        continue
      }
      let Some(n) = lines.parse_i64() else { return Err("not a number of lines: ${token}") }
      inputs.push(Played(Scrolled(0.0, f32(n))))
      continue
    }
    if let Some(ms) = token.strip_prefix("wait:") {
      let Some(n) = ms.parse_i64() else { return Err("not a number of milliseconds: ${token}") }
      inputs.push(Waited(n))
      continue
    }
    if let Some(quoted) = token.strip_prefix("compose:") {
      if !quoted.starts_with("'") || !quoted.ends_with("'") || quoted.len() < 2 {
        return Err("not quoted text: ${token}")
      }
      let text = quoted.slice(1, quoted.len() - 1).replace("\\'", "'")
      var runes = 0
      for _ in text { runes += 1 }
      inputs.push(Played(TextComposing(text, runes, -1)))
      continue
    }
    if token == "focus" || token == "blur" {
      inputs.push(Played(if token == "focus" { WindowFocused } else { WindowUnfocused }))
      continue
    }
    if let Some(place) = token.strip_prefix("drag:") {
      let Some(at) = point(place) else { return Err("not a size: ${token}") }
      inputs.push(Dragged(Size { w: at.x, h: at.y }))
      continue
    }
    if let Some(place) = token.strip_prefix("resize:") {
      let Some(at) = point(place) else { return Err("not a size: ${token}") }
      inputs.push(Played(Resized(Size { w: at.x, h: at.y })))
      continue
    }
    if token == "dark" || token == "light" {
      inputs.push(Played(AppearanceChanged(if token == "dark" { DarkMode } else { LightMode })))
      continue
    }
    if token == "maximize" || token == "minimize" || token == "restore" {
      let state = if token == "maximize" { WindowState { maximized: true } } else if token == "minimize" {
        WindowState { minimized: true }
      } else {
        WindowState {}
      }
      inputs.push(Played(WindowStateChanged(state)))
      continue
    }
    if let Some(tag) = token.strip_prefix("menu:") {
      let Some(n) = tag.parse_i64() else { return Err("not a menu item's tag: ${token}") }
      inputs.push(Played(MenuChosen(i32(n))))
      continue
    }
    let parts = token.split("+")
    // Modifiers on the pointer — `Shift+click:10,20` — are held for its inputs alone.
    if parts.len() > 1 {
      if let Some((verb, place)) = pointer_token(parts[parts.len() - 1]) {
        let Some(held) = modifiers_named(parts.slice(0, parts.len() - 1)) else {
          return Err("not a modifier in ${token}")
        }
        inputs.push(Holding(held))
        for step in parse_steps("${verb}:${place}")? { inputs.push(step) }
        inputs.push(Holding(Modifiers {}))
        continue
      }
    }
    var mods = Modifiers {}
    for i in 0..<(parts.len() - 1) {
      match parts[i] {
        "Shift" => { mods = Modifiers { mods | shift: true } },
        "Alt" => { mods = Modifiers { mods | alt: true } },
        "Ctrl" => { mods = Modifiers { mods | control: true } },
        "Cmd" => { mods = Modifiers { mods | command: true } },
        "Primary" => { mods = Modifiers { mods | primary: true } },
        _ => return Err("not a modifier: ${parts[i]} in ${token}"),
      }
    }
    let Some(key) = key_named(parts[parts.len() - 1]) else { return Err("not a key: ${token}") }
    inputs.push(Played(KeyPressed(key, mods)))
  }
  Ok(inputs)
}

/// `script` cut into tokens at spaces, a quoted run of text being one token however many
/// spaces it holds.
let tokens = pure (script: string) -> []string => {
  var out: []string = []
  var current: []rune = []
  var quoted = false
  var escaped = false
  for c in script {
    if quoted {
      current.push(c)
      if escaped {
        escaped = false
      } else if c == '\\' {
        escaped = true
      } else if c == '\'' {
        quoted = false
      }
      continue
    }
    if c == ' ' {
      if current.len() > 0 { out.push(current.join()) }
      current = []
      continue
    }
    if c == '\'' && current.len() == 0 { quoted = true }
    current.push(c)
  }
  if current.len() > 0 { out.push(current.join()) }
  out
}

/// A pointer token's verb and place: `click:40,120` is `("click", "40,120")`.
let pointer_token = pure (token: string) -> Maybe<(string, string)> => {
  for verb in ["move", "down", "up", "click", "double", "triple"] {
    if let Some(place) = token.strip_prefix("${verb}:") { return Some((verb, place)) }
  }
  None
}

/// `X,Y` as a point.
let point = pure (place: string) -> Maybe<Point> => {
  let parts = place.split(",")
  if parts.len() != 2 { return None }
  let Some(x) = parts[0].parse_i64() else { return None }
  let Some(y) = parts[1].parse_i64() else { return None }
  Some(Point { x: f32(x), y: f32(y) })
}

/// The key a script names.
/// The modifiers `names` name (`Shift`, `Alt`, `Ctrl`, `Cmd`, `Primary`), or `None` if one is
/// none of them.
let modifiers_named = pure (names: []string) -> Maybe<Modifiers> => {
  var mods = Modifiers {}
  for name in names {
    match name {
      "Shift" => { mods = Modifiers { mods | shift: true } },
      "Alt" => { mods = Modifiers { mods | alt: true } },
      "Ctrl" => { mods = Modifiers { mods | control: true } },
      "Cmd" => { mods = Modifiers { mods | command: true } },
      "Primary" => { mods = Modifiers { mods | primary: true } },
      _ => return None,
    }
  }
  Some(mods)
}

/// `F1` to `F24` as their key.
let function_key = pure (name: string) -> Maybe<Key> => {
  let Some(digits) = name.strip_prefix("F") else { return None }
  let Some(n) = digits.parse_i64() else { return None }
  if n >= 1 && n <= 24 { Some(FunctionKey(n)) } else { None }
}

let key_named = pure (name: string) -> Maybe<Key> => match name {
  "Tab" => Some(Tab),
  "Enter" => Some(Enter),
  "Space" => Some(Character(' ')),
  "Escape" => Some(Escape),
  "Backspace" => Some(Backspace),
  "Delete" => Some(Delete),
  "Left" => Some(ArrowLeft),
  "Right" => Some(ArrowRight),
  "Up" => Some(ArrowUp),
  "Down" => Some(ArrowDown),
  "Home" => Some(Home),
  "End" => Some(End),
  "PageUp" => Some(PageUp),
  "PageDown" => Some(PageDown),
  "Insert" => Some(Insert),
  _ => if name.len() == 1 { Some(Character(name[0])) } else { function_key(name) },
}
