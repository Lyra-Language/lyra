module ui.motion
//! Transitions, as CSS's: when a property an element's style lists in `transition` changes
//! value — a class, a state (`:hover`, `:active`, `:focus`, …), the program's state, an `@media`
//! rule — the element shows the change over time rather than at once, from the value it shows
//! now to the new one. This module holds the values: timing curves, how each property blends,
//! and an element's [Motion] — its target and what is moving towards it. `ui.interact` runs
//! them over a laid-out tree each frame; `ui.app`'s host draws while anything moves.
//!
//! **Paint and layout.** A property that only changes what is drawn (opacity, colours, radius,
//! shadows, a gradient, blur) is blended into the laid-out tree after layout, so the layout
//! cache gives the element back as before. One that changes sizes (padding, gaps, widths and
//! heights, border width) is handed to the next layout ([with_layout], keyed by
//! [layout_key]), which lays that element out again each frame it moves.
//!
//! **What does not blend switches at the midpoint**, as CSS's discrete animation does: two
//! gradients of different kinds or stop counts, shadows inset on one side only, a size that is
//! `auto` on one side.

import ui.style.{
  Computed,
  Transition,
  Timing,
  TimingEase,
  TimingLinear,
  TimingEaseIn,
  TimingEaseOut,
  TimingEaseInOut,
  TimingBezier,
  TimingSteps,
  Insets,
}
import ui.draw.{ Color, BoxShadow, Gradient, ColorStop, LinearGradient, RadialGradient }

/// Every property that transitions, by its CSS name: first those that only change what is
/// drawn, then those that change sizes.
pub const PAINTED: []string = [
  "opacity",
  "color",
  "background-color",
  "border-color",
  "border-radius",
  "box-shadow",
  "background-image",
  "filter",
  "backdrop-filter",
]
pub const SIZED: []string = [
  "padding",
  "gap",
  "row-gap",
  "column-gap",
  "width",
  "height",
  "min-width",
  "max-width",
  "min-height",
  "max-height",
  "border-width",
]

/// The names a `transition` may give besides those: every property, and `background` for
/// its colour and its image.
pub const SHORTHANDS: []string = ["all", "background"]

/// Whether `name` is a property a transition may name.
pub let transitions = pure (name: string) -> bool =>
  PAINTED.any((p) => p == name) ||
  SIZED.any((p) => p == name) ||
  SHORTHANDS.any((p) => p == name)

/// An element's transitions: the target its style asks for now, and what is moving towards it.
pub struct Motion {
  target: Computed,
  moving: []Moving = [],
}

/// One property moving from what was shown to its target: started at `start` (the clock's
/// milliseconds), waiting `delay`, taking `duration`, paced by `timing`.
pub struct Moving {
  property: string,
  from: Computed,
  to: Computed,
  start: i64,
  duration: f32,
  delay: f32,
  timing: Timing,
}

/// `motion` moved on to `target` at `now`: each property whose target changed starts moving
/// from what is shown now — mid-flight too, as CSS retargets — if a transition names it, and
/// jumps if none does; what has arrived stops. Also whether a property that changes sizes
/// started, which the layout just made must take in.
pub let advance = pure (
  motion: Maybe<Motion>,
  target: Computed,
  now: i64
) -> (Motion, bool) => {
  // First seen: nothing moves — a transition is a change, and there was none.
  let fresh = Motion { target: target }
  let was = match motion {
    Some(m) => m,
    None => return (fresh, false),
  }
  let shown = shown_at(was, now)
  var moving: []Moving = []
  var sized = false
  for property in [...PAINTED, ...SIZED] {
    if !differs(was.target, target, property) {
      for m in was.moving { if m.property == property && !arrived(
        m,
        now
      ) { moving.push(m) } }
      continue
    }
    let Some(spec) = transition_for(target.transition, property) else { continue }
    if spec.duration + spec.delay <= 0.0 { continue }
    moving.push(Moving {
      property: property,
      from: shown,
      to: target,
      start: now,
      duration: spec.duration,
      delay: spec.delay,
      timing: spec.timing,
    })
    if SIZED.any((p) => p == property) { sized = true }
  }
  let next = Motion { target: target, moving: moving }
  (next, sized)
}

/// What `motion` shows at `now`: its target, each moving property at its place.
pub let shown_at = pure (motion: Motion, now: i64) -> Computed => {
  var out = motion.target
  for m in motion.moving { out = blended(out, m.from, m.to, m.property, eased(m, now)) }
  out
}

/// Whether anything in `motion` is still moving at `now`.
pub let in_motion = pure (motion: Motion, now: i64) -> bool =>
  motion.moving.any((m) => !arrived(m, now))

/// Whether `motion` moves a property that changes sizes.
pub let moves_sizes = pure (motion: Motion) -> bool =>
  motion.moving.any((m) => SIZED.any((p) => p == m.property))

/// `style` with the properties that change sizes taken from `shown` — what a layout lays an
/// element out with while they move.
pub let with_layout = pure (style: Computed, shown: Computed) -> Computed =>
  Computed {
    style |
    padding: shown.padding,
    gap: shown.gap,
    row_gap: shown.row_gap,
    column_gap: shown.column_gap,
    width: shown.width,
    height: shown.height,
    min_width: shown.min_width,
    max_width: shown.max_width,
    min_height: shown.min_height,
    max_height: shown.max_height,
    border_width: shown.border_width,
  }

/// The properties that change sizes, as text: the layout cache's key for a moving element.
pub let layout_key = pure (s: Computed) -> string => {
  let p = s.padding
  "${p.top},${p.right},${p.bottom},${p.left};${s.gap},${s.row_gap},${s.column_gap};${s.width ?? -1.0},${s.height ?? -1.0},${s.min_width ?? -1.0},${s.max_width ?? -1.0},${s.min_height ?? -1.0},${s.max_height ?? -1.0};${s.border_width}"
}

/// The transition `transitions` gives `property`: the last entry naming it, `all` or a
/// shorthand covering it.
pub let transition_for = pure (
  transitions: []Transition,
  property: string
) -> Maybe<Transition> => {
  var found: Maybe<Transition> = None
  for t in transitions { if covers(t.property, property) { found = Some(t) } }
  found
}

/// Whether a transition naming `named` moves `property`.
let covers = pure (named: string, property: string) -> bool =>
  named == property || named == "all" ||
  named == "background" && (property == "background-color" || property == "background-image")

/// Whether `m` has arrived by `now`.
let arrived = pure (m: Moving, now: i64) -> bool =>
  f32(now - m.start) >= m.delay + m.duration

/// How far along `m` is at `now`, 0 to 1, after its timing: 0 while it waits.
let eased = pure (m: Moving, now: i64) -> f32 => {
  let elapsed = f32(now - m.start) - m.delay
  if elapsed <= 0.0 { return 0.0 }
  if m.duration <= 0.0 || elapsed >= m.duration { return 1.0 }
  progress(m.timing, elapsed / m.duration)
}

/// `timing` at `x` (0 to 1), as CSS defines each: a cubic Bézier from (0, 0) to (1, 1), or
/// steps.
pub let progress = pure (timing: Timing, x: f32) -> f32 => {
  let at = x.clamp(0.0, 1.0)
  match timing {
    TimingLinear => at,
    TimingEase => bezier(0.25, 0.1, 0.25, 1.0, at),
    TimingEaseIn => bezier(0.42, 0.0, 1.0, 1.0, at),
    TimingEaseOut => bezier(0.0, 0.0, 0.58, 1.0, at),
    TimingEaseInOut => bezier(0.42, 0.0, 0.58, 1.0, at),
    TimingBezier(x1, y1, x2, y2) => bezier(x1, y1, x2, y2, at),
    TimingSteps(n, from_start) => {
      let count = f32(n.max(1))
      let step = f32((at * count).floor()) + (if from_start { 1.0 } else { 0.0 })
      if at >= 1.0 { 1.0 } else { (step / count).min(1.0) }
    },
  }
}

/// The curve through (0, 0), (`x1`, `y1`), (`x2`, `y2`) and (1, 1) at `x`: its parameter found
/// by Newton's method, by halving where that stalls.
let bezier = pure (x1: f32, y1: f32, x2: f32, y2: f32, x: f32) -> f32 => {
  if x <= 0.0 { return 0.0 }
  if x >= 1.0 { return 1.0 }
  var t = x
  for _ in 0..<8 {
    let off = along(x1, x2, t) - x
    if off.abs() < 0.00001 { return along(y1, y2, t) }
    let slope = slope_at(x1, x2, t)
    if slope.abs() < 0.000001 { break }
    t -= off / slope
  }
  var low: f32 = 0.0
  var high: f32 = 1.0
  t = x
  for _ in 0..<40 {
    let at = along(x1, x2, t)
    if (at - x).abs() < 0.00001 { break }
    if at < x { low = t } else { high = t }
    t = (low + high) / 2.0
  }
  along(y1, y2, t)
}

/// One coordinate of a cubic Bézier from 0 to 1 through `a` and `b` at `t`, and its slope.
let along = pure (a: f32, b: f32, t: f32) -> f32 => {
  let u = 1.0 - t
  3.0 * u * u * t * a + 3.0 * u * t * t * b + t * t * t
}

let slope_at = pure (a: f32, b: f32, t: f32) -> f32 => {
  let u = 1.0 - t
  3.0 * u * u * a + 6.0 * u * t * (b - a) + 3.0 * t * t * (1.0 - b)
}

/// Whether `a` and `b` differ in `property`.
pub let differs = pure (a: Computed, b: Computed, property: string) -> bool =>
  match property {
    "opacity" => apart(a.own_opacity, b.own_opacity),
    "color" => a.color != b.color,
    "background-color" => a.background != b.background,
    "border-color" => a.border_color != b.border_color,
    "border-radius" => apart(a.radius, b.radius),
    "box-shadow" => a.box_shadow != b.box_shadow,
    "background-image" => a.background_gradient != b.background_gradient,
    "filter" => apart(a.filter_blur, b.filter_blur),
    "backdrop-filter" => apart(a.backdrop_blur, b.backdrop_blur),
    "padding" => a.padding != b.padding,
    "gap" => apart(a.gap, b.gap),
    "row-gap" => apart(a.row_gap, b.row_gap),
    "column-gap" => apart(a.column_gap, b.column_gap),
    "width" => a.width != b.width,
    "height" => a.height != b.height,
    "min-width" => a.min_width != b.min_width,
    "max-width" => a.max_width != b.max_width,
    "min-height" => a.min_height != b.min_height,
    "max-height" => a.max_height != b.max_height,
    "border-width" => apart(a.border_width, b.border_width),
    _ => false,
  }

/// Whether two lengths differ by more than rounding.
let apart = pure (a: f32, b: f32) -> bool => (a - b).abs() > 0.0001

/// `into` with `property` at `p` of the way from `from`'s value to `to`'s.
pub let blended = pure (
  into: Computed,
  from: Computed,
  to: Computed,
  property: string,
  p: f32
) -> Computed =>
  match property {
    "opacity" =>
      Computed { into | own_opacity: mix(from.own_opacity, to.own_opacity, p) },
    "color" => Computed { into | color: mix_color(from.color, to.color, p) },
    "background-color" =>
      Computed { into | background: mix_fill(from.background, to.background, p) },
    "border-color" =>
      Computed { into | border_color: mix_fill(from.border_color, to.border_color, p) },
    "border-radius" => Computed { into | radius: mix(from.radius, to.radius, p) },
    "box-shadow" =>
      Computed { into | box_shadow: mix_shadows(from.box_shadow, to.box_shadow, p) },
    "background-image" => Computed {
      into |
      background_gradient: mix_gradient(from.background_gradient, to.background_gradient, p),
    },
    "filter" => Computed { into | filter_blur: mix(from.filter_blur, to.filter_blur, p) },
    "backdrop-filter" =>
      Computed { into | backdrop_blur: mix(from.backdrop_blur, to.backdrop_blur, p) },
    "padding" => Computed { into | padding: mix_insets(from.padding, to.padding, p) },
    "gap" => Computed { into | gap: mix(from.gap, to.gap, p) },
    "row-gap" => Computed { into | row_gap: mix(from.row_gap, to.row_gap, p) },
    "column-gap" =>
      Computed { into | column_gap: mix(from.column_gap, to.column_gap, p) },
    "width" => Computed { into | width: mix_size(from.width, to.width, p) },
    "height" => Computed { into | height: mix_size(from.height, to.height, p) },
    "min-width" =>
      Computed { into | min_width: mix_size(from.min_width, to.min_width, p) },
    "max-width" =>
      Computed { into | max_width: mix_size(from.max_width, to.max_width, p) },
    "min-height" =>
      Computed { into | min_height: mix_size(from.min_height, to.min_height, p) },
    "max-height" =>
      Computed { into | max_height: mix_size(from.max_height, to.max_height, p) },
    "border-width" =>
      Computed { into | border_width: mix(from.border_width, to.border_width, p) },
    _ => into,
  }

/// `p` of the way from `a` to `b`.
pub let mix = pure (a: f32, b: f32, p: f32) -> f32 => a + (b - a) * p

/// `p` of the way from colour `a` to `b`, premultiplied — so a colour fading in from
/// transparent keeps its hue rather than passing through black, as CSS blends them.
pub let mix_color = pure (a: Color, b: Color, p: f32) -> Color => {
  let from = f32(a.a) / 255.0
  let to = f32(b.a) / 255.0
  let alpha = mix(from, to, p)
  if alpha <= 0.0 { return Color { r: 0, g: 0, b: 0, a: 0 } }
  Color {
    r: channel(a.r, from, b.r, to, p, alpha),
    g: channel(a.g, from, b.g, to, p, alpha),
    b: channel(a.b, from, b.b, to, p, alpha),
    a: u8((alpha * 255.0).clamp(0.0, 255.0).round()),
  }
}

/// One channel of [mix_color]: premultiplied, blended, and divided out again.
let channel = pure (a: u8, from: f32, b: u8, to: f32, p: f32, alpha: f32) -> u8 =>
  u8((mix(f32(a) * from, f32(b) * to, p) / alpha).clamp(0.0, 255.0).round())

/// A fill that may be none: none is the other colour, transparent.
let mix_fill = pure (a: Maybe<Color>, b: Maybe<Color>, p: f32) -> Maybe<Color> =>
  match (a, b) {
    (Some(x), Some(y)) => Some(mix_color(x, y, p)),
    (Some(x), None) => Some(mix_color(x, Color { x | a: 0 }, p)),
    (None, Some(y)) => Some(mix_color(Color { y | a: 0 }, y, p)),
    (None, None) => None,
  }

/// A size that may be `auto`, which does not blend.
let mix_size = pure (a: Maybe<f32>, b: Maybe<f32>, p: f32) -> Maybe<f32> => match (a, b) {
  (Some(x), Some(y)) => Some(mix(x, y, p)),
  _ => if p < 0.5 { a } else { b },
}

let mix_insets = pure (a: Insets, b: Insets, p: f32) -> Insets =>
  Insets {
    top: mix(a.top, b.top, p),
    right: mix(a.right, b.right, p),
    bottom: mix(a.bottom, b.bottom, p),
    left: mix(a.left, b.left, p),
  }

/// Two lists of shadows, pair by pair, the shorter made up with transparent ones of no size —
/// CSS's rule; shadows inset on one side only do not blend.
let mix_shadows = pure (a: []BoxShadow, b: []BoxShadow, p: f32) -> []BoxShadow => {
  var out: []BoxShadow = []
  for i in 0..<a.len().max(b.len()) {
    let x = if i < a.len() { a[i] } else { none_like(b[i]) }
    let y = if i < b.len() { b[i] } else { none_like(a[i]) }
    if x.inset != y.inset { return if p < 0.5 { a } else { b } }
    out.push(BoxShadow {
      x: mix(x.x, y.x, p),
      y: mix(x.y, y.y, p),
      blur: mix(x.blur, y.blur, p),
      spread: mix(x.spread, y.spread, p),
      color: mix_color(x.color, y.color, p),
      inset: x.inset,
    })
  }
  out
}

/// A shadow of no size and no colour, inset as `s` is.
let none_like = pure (s: BoxShadow) -> BoxShadow =>
  BoxShadow { color: Color { s.color | a: 0 }, inset: s.inset }

/// Two gradients of one kind and as many stops, stop by stop and angle by angle.
let mix_gradient = pure (
  a: Maybe<Gradient>,
  b: Maybe<Gradient>,
  p: f32
) -> Maybe<Gradient> => {
  let (Some(x), Some(y)) = (a, b) else { return if p < 0.5 { a } else { b } }
  if x.stops.len() != y.stops.len() { return if p < 0.5 { a } else { b } }
  let kind = match (x.kind, y.kind) {
    (LinearGradient(from), LinearGradient(to)) => LinearGradient(mix(from, to, p)),
    (RadialGradient(c), RadialGradient(d)) => if c == d { RadialGradient(c) } else {
      return if p < 0.5 { a } else { b }
    },
    _ => return if p < 0.5 { a } else { b },
  }
  var stops: []ColorStop = []
  for i, s in x.stops {
    let t = y.stops[i]
    let at = match (s.at, t.at) {
      (Some(u), Some(v)) => Some(mix(u, v, p)),
      _ => if p < 0.5 { s.at } else { t.at },
    }
    stops.push(ColorStop { color: mix_color(s.color, t.color, p), at: at })
  }
  Some(Gradient { kind: kind, stops: stops })
}
