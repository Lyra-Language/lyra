module ui.text
//! Text: fonts, a paragraph shaped and broken into lines ([TextBlock]), and the glyph atlas
//! a renderer draws the lines from ([GlyphAtlas]) — what becomes a display list's [Glyphs].
//!
//! ```
//! import ui.text.{ fonts_new, glyph_atlas, FontSpec }
//!
//! var fonts = fonts_new()
//! fonts.add_system_font()
//! var atlas = glyph_atlas()
//! let block = fonts.lay_out("Hello, world", FontSpec { size: 16.0 }, 200.0)
//! let ops = atlas.glyphs(fonts, renderer, block, Point { x: 20.0, y: 20.0 }, scale, BLACK)
//! ```
//!
//! **Shaping is HarfBuzz's, rasterizing FreeType's** (`bindings.harfbuzz`,
//! `bindings.freetype`), both reading the same font file; nothing else here calls a library.
//!
//! **A paragraph is shaped once and broken afterwards.** Its break opportunities — a simple
//! reading of Unicode's line breaking (UAX #14): after a run of spaces, after a hyphen inside
//! a word, either side of an ideograph, and a mandatory break at a newline — are byte offsets
//! of its UTF-8, matched against each glyph's cluster. Lines are filled greedily; spaces at
//! a line's end hang past its width, as a browser's do. **A paragraph is shaped a run at a
//! time**, each run a stretch of characters the same face has — a spec's families in turn, then
//! [Fonts.fallbacks] — so a character the first family lacks is drawn from the next that has
//! it; a combining mark stays with its base. Left to right, and runs are not cut by script yet.
//!
//! **A family is faces by weight and style** ([Fonts.add]), and a [FontSpec] is drawn in the
//! one CSS's font matching picks; what the family lacks is made — a variable font's instance at
//! a weight, a bold emboldened, an italic slanted — once, when first asked for. [Fonts.metrics]
//! answers a face's measurements for a grid's cell: its ascent, descent, advance, underline and
//! strikeout, from its own tables.
//!
//! **Positions are logical units** and a glyph is rasterized at the pixel size the display
//! needs (the size times the scale), its origin rounded to a whole pixel so its edges stay
//! where the hinting put them.

import bindings.harfbuzz.{
  HbFont,
  open_hb_font,
  close_hb_font,
  shape,
  font_extents,
  ShapedGlyph,
  VariationAxis,
  Variation,
  variation_axes,
  set_variations,
  font_metric,
  advance_of,
  has_glyph,
  nominal_glyph,
  METRIC_UNDERLINE_OFFSET,
  METRIC_UNDERLINE_SIZE,
  METRIC_STRIKEOUT_OFFSET,
  METRIC_STRIKEOUT_SIZE,
}
import bindings.freetype.{
  FtFont,
  open_ft_font,
  close_ft_font,
  render_glyph,
  render_color_glyph,
  has_color,
  set_design_coordinates,
  Hinting,
  HintNone,
  HintLight,
  HintFull,
}
import std.collections.{ HashMap, hashmap_new }
import ui.draw.{
  Point,
  Rect,
  Color,
  Image,
  TextureId,
  GlyphQuad,
  DrawOp,
  Glyphs,
  Picture,
  PictureSource
}
import ui.backend.{ Renderer, WindowId, MAIN_WINDOW }

/// Which font, and how large: a `family` added to [Fonts] — or several, comma-separated, as
/// CSS's `font-family` lists them, each tried in turn for a character the ones before lack,
/// then [Fonts.fallbacks]; `""` (or none added) is the first added — at `size`
/// logical units to the em, its lines `line_height` sizes apart — CSS's unitless
/// `line-height`; `0.0` for the font's own spacing — at `weight` (CSS's: 400 regular, 700
/// bold), italic or upright.
pub struct FontSpec {
  family: string = "",
  size: f32 = 14.0,
  line_height: f32 = 0.0,
  weight: i64 = 400,
  italic: bool = false,
}

/// One cell of a grid of characters ([Fonts.cells]) — a terminal's: its column, its text (a
/// character and any combining marks after it), how many columns it takes (2 for a wide
/// character), and whether it is bold or italic.
pub struct Cell {
  col: i64,
  text: string,
  width: i64 = 1,
  bold: bool = false,
  italic: bool = false,
}

/// A font's measurements at a [FontSpec]'s size, for a grid's cell ([Fonts.metrics]), in
/// logical units: how far it reaches above the baseline and below it, the gap it asks for
/// between lines, how far an `M` moves the pen (every glyph, in a monospaced font), and where
/// its underline (down from the baseline) and strikeout (up from it) go, and how thick.
pub struct FontMetrics {
  ascent: f32 = 0.0,
  descent: f32 = 0.0,
  line_gap: f32 = 0.0,
  advance: f32 = 0.0,
  underline_y: f32 = 0.0,
  underline_thickness: f32 = 0.0,
  strike_y: f32 = 0.0,
  strike_thickness: f32 = 0.0,
}

/// The fonts a program draws with, and the paragraphs already laid out in them. **A family is
/// the faces added under its name** ([Fonts.add]); a [FontSpec] is drawn in the one CSS's
/// font matching picks — the italic or upright ones as asked, if there are any, then the
/// nearest weight — and **what the family lacks is made**: a variable font's weight is its
/// instance at that weight, a bold it has no face for is the regular emboldened, an italic
/// the upright slanted. Each such face is opened once, when first asked for.
pub struct Fonts {
  /// The faces text is drawn in, as [TextBlock.face] numbers them: what was added, and what
  /// was made from it.
  faces: []Face = [],
  /// What was added, in order.
  added: []Added = [],
  /// The families tried, after a spec's own, for a character those lack — in order
  /// ([Fonts.add_fallback], [Fonts.add_system_fallbacks]).
  fallbacks: []string = [],
  /// The faces made, by what they were made as (`made_key`).
  made: HashMap<string, i64>,
  /// How glyphs are fitted to the pixel grid — light (vertically only) unless the program says
  /// otherwise: macOS draws its own text unhinted.
  hinting: Hinting = HintLight,
  laid: HashMap<string, TextBlock>,
  /// The paragraphs laid out before `laid` filled: kept one generation more, so a screen's
  /// text is found again however often the cache turns over, and the cache never holds more
  /// than twice [LAID_LIMIT].
  older: HashMap<string, TextBlock>,
}

/// How many paragraphs [Fonts] keeps laid out before it starts a new generation.
pub const LAID_LIMIT: i64 = 2048

/// A paragraph laid out: its lines, top to bottom, and the box they fill — as wide as its
/// widest line, as tall as its lines. `face` is the face its lines are spaced by, its first
/// family's; each glyph says the face it is drawn from.
pub struct TextBlock {
  face: i64 = -1,
  size: f32 = 0.0,
  lines: []TextLine = [],
  width: f32 = 0.0,
  height: f32 = 0.0,
  /// From one line's baseline to the next.
  line_height: f32 = 0.0,
}

/// One line of a [TextBlock]: its glyphs, its width (its trailing spaces left out) and its
/// advance (them included — where a caret after them goes), where its baseline is, down from
/// the block's top, and the byte offset its text starts at.
pub struct TextLine {
  glyphs: []LineGlyph = [],
  width: f32 = 0.0,
  advance: f32 = 0.0,
  baseline: f32 = 0.0,
  start: i64 = 0,
}

/// A glyph placed on a line: its number in its face (`face`, of [Fonts.faces] — a fallback's
/// for a character the block's own face lacks), and where it is drawn — `x` across from the
/// line's start, `y` up from the baseline. `pen` is where the pen was before it (`x` without
/// the glyph's own offset), `advance` how far it moved it, and `cluster` the byte offset, in
/// the block's UTF-8, of the text it draws.
pub struct LineGlyph {
  face: i64 = -1,
  glyph: u32,
  x: f32,
  y: f32,
  pen: f32 = 0.0,
  advance: f32 = 0.0,
  cluster: i64 = 0,
}

/// Where a caret before byte `offset` of a one-line block's text stands, across from its
/// start: before the first glyph drawing text at or after it, else at the line's end.
pub let caret_x = pure (block: TextBlock, offset: i64) -> f32 => {
  if block.lines.len() == 0 { return 0.0 }
  let line = block.lines[0]
  for g in line.glyphs {
    if g.cluster >= offset { return g.pen }
  }
  line.advance
}

/// The byte offset a caret at `x` across a one-line block nearest stands before: a glyph's
/// start when `x` is in its first half, its end in its second. `length` is the text's length
/// in bytes, for a caret past the last glyph.
pub let offset_at_x = pure (block: TextBlock, x: f32, length: i64) -> i64 => {
  if block.lines.len() == 0 { return 0 }
  for g in block.lines[0].glyphs {
    if x < g.pen + g.advance / 2.0 { return g.cluster }
  }
  length
}

/// Fonts with none added.
pub let fonts_new = pure () -> Fonts =>
  Fonts { made: hashmap_new(), laid: hashmap_new(), older: hashmap_new() }

/// A face to load into a family ([Fonts.add]): its file, the face's index in a collection,
/// its weight and whether it is italic — what `ui.app`'s `LoadFonts` adds while a program runs.
pub struct FontFile {
  family: string,
  path: string,
  index: i64 = 0,
  weight: i64 = 400,
  italic: bool = false,
}

/// The font files tried by [Fonts.add_system_font], in order: macOS's, then the common
/// places Linux distributions keep DejaVu Sans.
pub const SYSTEM_FONTS: []string = [
  "/System/Library/Fonts/Helvetica.ttc",
  "/System/Library/Fonts/Supplemental/Arial.ttf",
  "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
  "/usr/share/fonts/TTF/DejaVuSans.ttf",
  "/usr/share/fonts/dejavu/DejaVuSans.ttf",
]

/// The fallback fonts [Fonts.add_system_fallbacks] looks for, a group each — Chinese, Japanese
/// and Korean, then symbols, then emoji in colour (last, so a symbol with a text form keeps it)
/// — where macOS and the Linux distributions keep them. Arial Unicode
/// covers all three of the first in one file; Noto Sans CJK likewise on Linux.
pub const SYSTEM_FALLBACKS: [][]string = [
  [
    "/System/Library/Fonts/Supplemental/Arial Unicode.ttf",
    "/System/Library/Fonts/Hiragino Sans GB.ttc",
    "/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc",
    "/usr/share/fonts/noto-cjk/NotoSansCJK-Regular.ttc",
    "/usr/share/fonts/google-noto-cjk/NotoSansCJK-Regular.ttc",
    "/usr/share/fonts/google-noto-sans-cjk-vf-fonts/NotoSansCJK-VF.ttc",
    "/usr/share/fonts/truetype/droid/DroidSansFallbackFull.ttf",
  ],
  [
    "/System/Library/Fonts/Apple Symbols.ttf",
    "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
    "/usr/share/fonts/TTF/DejaVuSans.ttf",
    "/usr/share/fonts/dejavu/DejaVuSans.ttf",
  ],
  [
    "/System/Library/Fonts/Apple Color Emoji.ttc",
    "/usr/share/fonts/truetype/noto/NotoColorEmoji.ttf",
    "/usr/share/fonts/noto/NotoColorEmoji.ttf",
    "/usr/share/fonts/google-noto-emoji/NotoColorEmoji.ttf",
    "/usr/share/fonts/noto-color-emoji/NotoColorEmoji.ttf",
  ],
]

impl Fonts {
  /// Add face `index` of the font file at `path` to `family`, as its face of `weight` (CSS's:
  /// 400 regular, 700 bold) and italic or not — a variable font with a weight axis is every
  /// weight it reaches, whatever `weight` says; `false` if it cannot be opened.
  pub let add = (
    self: mut,
    family: string,
    path: string,
    index: i64 = 0,
    weight: i64 = 400,
    italic: bool = false
  ) -> bool => {
    let Some(face) = open_face(
      family,
      path,
      index,
      [],
      false,
      false
    ) else { return false }
    let axes = variation_axes(face.hb)
    var heaviness: Maybe<VariationAxis> = None
    for axis in axes {
      if axis.tag == WEIGHT_AXIS { heaviness = Some(axis) }
    }
    self.faces.push(face)
    self.forget_laid()
    self.added.push(Added {
      family: family,
      path: path,
      index: index,
      weight: match heaviness {
        Some(axis) => i64(axis.default.round()),
        None => weight,
      },
      italic: italic,
      axes: axes,
      weights: heaviness,
      face: self.faces.len() - 1,
    })
    true
  }

  /// Try `family` for the characters a spec's own families lack, after those already added.
  pub let add_fallback = (self: mut, family: string) -> void => {
    if !self.fallbacks.contains(family) { self.fallbacks.push(family) }
    self.forget_laid()
  }

  /// Add, as fallbacks, the first there is of each group of [SYSTEM_FALLBACKS] — a font with
  /// Chinese, Japanese and Korean, one of symbols, one of emoji — as `"system fallback 1"` and on; how many
  /// were found.
  pub let add_system_fallbacks = (self: mut) -> i64 => {
    var found = 0
    for group in SYSTEM_FALLBACKS {
      for path in group {
        let family = "system fallback ${found + 1}"
        if self.add(family, path) {
          self.add_fallback(family)
          found += 1
          break
        }
      }
    }
    found
  }

  /// The paragraphs laid out forgotten: a face added since may draw them otherwise.
  let forget_laid = (self: mut) -> void => {
    self.laid = hashmap_new::<string, TextBlock>()
    self.older = hashmap_new::<string, TextBlock>()
  }

  /// Add the first of [SYSTEM_FONTS] there is as `"system"`; `false` if there is none.
  pub let add_system_font = (self: mut) -> bool => {
    for path in SYSTEM_FONTS {
      if self.add("system", path) { return true }
    }
    false
  }

  /// Whether any font has been added.
  pub let has_fonts = pure (self) -> bool => self.faces.len() > 0

  /// `text` set in `font` and broken into lines no wider than `width` (where it can be
  /// broken — a word longer than the line runs past it). Remembered, so laying the same
  /// text out again at the same font and width costs a lookup. With no font added, an empty
  /// block.
  pub let lay_out = (
    self: mut,
    text: string,
    font: FontSpec,
    width: f32
  ) -> TextBlock => {
    let faces = self.faces_for(font)
    if faces.len() == 0 { return TextBlock {} }
    let key = "${[f in faces | "${f}"].join(",")}|${font.size}|${font.line_height}|${width}|${text}"
    if let Some(block) = self.laid.get(key) { return block }
    if let Some(block) = self.older.get(key) {
      self.keep(key, block)
      return block
    }
    let block = break_lines(self.faces, faces, text, font, width)
    self.keep(key, block)
    block
  }

  /// `block` remembered as `key`'s, a new generation begun when this one is full.
  let keep = (self: mut, key: string, block: TextBlock) -> void => {
    if self.laid.len() >= LAID_LIMIT {
      self.older = self.laid
      self.laid = hashmap_new::<string, TextBlock>()
    }
    self.laid.insert(key, block)
  }

  /// Put every font away. The fonts must not be used afterwards.
  pub let close = (self) -> void => {
    for face in self.faces {
      close_hb_font(face.hb)
      close_ft_font(face.ft)
    }
  }

  /// `font`'s measurements at its size ([FontMetrics]) — its first family's — for a display at
  /// `scale` pixels a unit:
  /// its advance a whole number of pixels unless glyphs are drawn unhinted, as a hinted glyph's
  /// pen is. All zero with no font added.
  pub let metrics = (self: mut, font: FontSpec, scale: f32 = 1.0) -> FontMetrics => {
    let index = self.face_for(font)
    if index < 0 { return FontMetrics {} }
    let face = self.faces[index]
    let size = font.size
    var advance = advance_of(face.hb, size, 'M') ?? 0.0
    if self.hinting != HintNone && scale > 0.0 { advance = f32((advance * scale).round()) / scale }
    FontMetrics {
      ascent: face.ascender * size,
      descent: -face.descender * size,
      line_gap: face.line_gap * size,
      advance: advance,
      underline_y: -font_metric(face.hb, size, METRIC_UNDERLINE_OFFSET),
      underline_thickness: font_metric(face.hb, size, METRIC_UNDERLINE_SIZE),
      strike_y: font_metric(face.hb, size, METRIC_STRIKEOUT_OFFSET),
      strike_thickness: font_metric(face.hb, size, METRIC_STRIKEOUT_SIZE),
    }
  }

  /// A row of `cells` in `font`, each `advance` units wide, as one line of a block whose
  /// baseline is its top (so its glyphs are drawn from a baseline): **not shaped** — a cell's
  /// character found by the character maps of the faces `font` draws from (a bold or italic
  /// cell's as that spec would be, made faces and all), its glyph centred on its cell's columns,
  /// so a monospaced font's glyph sits at its cell's left and a fallback's or a wide one's in
  /// the middle. A cell with combining marks is shaped alone, as a cluster, so each mark sits
  /// where its font puts it. Empty cells and spaces draw nothing.
  pub let cells = (
    self: mut,
    cells: []Cell,
    font: FontSpec,
    advance: f32
  ) -> TextBlock => {
    // The faces of each of the four styles, found once for the row.
    var orders: [][]i64 = []
    for style in 0..<4 {
      let bold = style % 2 == 1
      let italic = style >= 2
      orders.push(self.faces_for(FontSpec {
        font |
        weight: if bold { font.weight.max(700) } else { font.weight },
        italic: italic || font.italic,
      }))
    }
    if orders[0].len() == 0 { return TextBlock {} }
    var placed: []LineGlyph = []
    for cell in cells {
      if cell.text.len() == 0 || cell.text == " " { continue }
      let order = orders[(if cell.bold { 1 } else { 0 }) + (if cell.italic { 2 } else { 0 })]
      let left = f32(cell.col) * advance
      let span = f32(cell.width.max(1)) * advance
      var first: rune = ' '
      var count = 0
      for c in cell.text {
        if count == 0 { first = c }
        count += 1
      }
      if count > 1 {
        // A cluster: shaped in the first face that has its base, as a paragraph would be — a
        // colour one first where it asks for an emoji.
        var face = order[0]
        for f in order {
          if has_glyph(self.faces[f].hb, first) {
            face = f
            break
          }
        }
        var asks_emoji = false
        for c in cell.text { if i32(c) == EMOJI_SELECTOR { asks_emoji = true } }
        if asks_emoji {
          if let Some(f) = color_face(self.faces, order, first) { face = f }
        }
        let shaped = shape(self.faces[face].hb, cell.text.encode_utf8(), font.size)
        var width: f32 = 0.0
        for g in shaped { width += g.x_advance }
        var pen = left + (span - width) / 2.0
        for g in shaped {
          placed.push(LineGlyph {
            face: face,
            glyph: g.glyph,
            x: pen + g.x_offset,
            y: g.y_offset,
            pen: pen,
            advance: g.x_advance,
          })
          pen += g.x_advance
        }
        continue
      }
      var found = false
      for f in order {
        if let Some((glyph, width)) = nominal_glyph(self.faces[f].hb, font.size, first) {
          let x = left + (span - width) / 2.0
          placed.push(LineGlyph {
            face: f,
            glyph: glyph,
            x: x,
            y: 0.0,
            pen: x,
            advance: width
          })
          found = true
          break
        }
      }
      // None has it: the first face's missing glyph, as text draws it.
      if !found {
        placed.push(LineGlyph {
          face: order[0],
          glyph: 0,
          x: left,
          y: 0.0,
          pen: left,
          advance: span
        })
      }
    }
    var last = 0
    for cell in cells { last = last.max(cell.col + cell.width.max(1)) }
    TextBlock {
      face: orders[0][0],
      size: font.size,
      lines: [TextLine { glyphs: placed, width: f32(last) * advance, advance: f32(last) * advance }],
      width: f32(last) * advance,
    }
  }

  /// The faces `font` draws from, in the order a character is looked for in them: its families'
  /// (those added, in its list's order), then the fallbacks' — each as CSS's matching picks for
  /// its weight and style. With none of its families added, the first added family's first.
  let faces_for = (self: mut, font: FontSpec) -> []i64 => {
    var faces: []i64 = []
    var families = [f in font.family.split(",") | f.trim()]
    for fallback in self.fallbacks { families.push(fallback) }
    for family in families {
      if [a in self.added | a.family == family | a].len() == 0 { continue }
      let face = self.face_for(FontSpec { font | family: family })
      if face >= 0 && !faces.contains(face) { faces.push(face) }
    }
    if faces.len() == 0 {
      let face = self.face_for(font)
      if face >= 0 { faces.push(face) }
    }
    faces
  }

  /// The face `font`'s first family is drawn in — made and opened the first time it is asked
  /// for, where the family has none as it is — or `-1` with none added (or one that cannot be
  /// opened again).
  let face_for = (self: mut, font: FontSpec) -> i64 => {
    let Some(picked) = self.matching(font) else { return -1 }
    let added = self.added[picked]
    let weight = nearest_weight(added, font.weight)
    // CSS's synthesis: bold where 600 or heavier is asked of a face lighter than that, oblique
    // where italic is asked of an upright one.
    let embolden = font.weight >= BOLD && weight < BOLD
    let oblique = font.italic && !added.italic
    if weight == added.weight && !embolden && !oblique { return added.face }
    let key = "${picked}|${weight}|${embolden}|${oblique}"
    if let Some(made) = self.made.get(key) { return made }
    var coordinates: []f32 = []
    var variations: []Variation = []
    if added.weights.is_some() && weight != added.weight {
      coordinates = [a in added.axes | if a.tag == WEIGHT_AXIS { f32(weight) } else { a.default }]
      variations = [Variation { tag: WEIGHT_AXIS, value: f32(weight) }]
    }
    let Some(face) = open_face(
      added.family,
      added.path,
      added.index,
      coordinates,
      embolden,
      oblique
    ) else { return -1 }
    if variations.len() > 0 { set_variations(face.hb, variations) }
    // Its extents read again: a variable font's instance may reach further.
    let at = font_extents(face.hb, 1000.0)
    self.faces.push(Face {
      face |
      ascender: at.ascender / 1000.0,
      descender: at.descender / 1000.0,
      line_gap: at.line_gap / 1000.0,
    })
    let made = self.faces.len() - 1
    self.made.insert(key, made)
    made
  }

  /// Which added face CSS's font matching picks for `font`: among `font.family`'s (the first
  /// added family's where it has none), the italic ones if it is italic and there are any —
  /// else the upright, and the other way round — then the one nearest its weight as CSS orders
  /// them (`weight_rank`); `None` with none added.
  let matching = pure (self, font: FontSpec) -> Maybe<i64> => {
    if self.added.len() == 0 { return None }
    var family = font.family.split(",")[0].trim()
    if [a in self.added | a.family == family | a].len() == 0 { family = self.added[0].family }
    let styled = [i in 0..<self.added.len() | self.added[i].family == family && self.added[i].italic == font.italic | i]
    let pool = if styled.len() > 0 { styled } else {
      [i in 0..<self.added.len() | self.added[i].family == family | i]
    }
    var best = pool[0]
    var best_rank = weight_rank(
      font.weight,
      nearest_weight(self.added[best], font.weight)
    )
    for i in pool {
      let rank = weight_rank(font.weight, nearest_weight(self.added[i], font.weight))
      if rank.0 < best_rank.0 || (rank.0 == best_rank.0 && rank.1 < best_rank.1) {
        best = i
        best_rank = rank
      }
    }
    Some(best)
  }
}

/// The weight at which CSS synthesizes a bold, and a variable font's weight axis's tag.
const BOLD: i64 = 600
const WEIGHT_AXIS: u32 = 0x77676874

/// The weight `added` comes nearest `wanted` at: its own, or for a variable font `wanted`
/// within the axis's reach.
let nearest_weight = pure (added: Added, wanted: i64) -> i64 => {
  let Some(axis) = added.weights else { return added.weight }
  i64(f32(wanted).clamp(axis.min, axis.max).round())
}

/// How good a face of weight `have` is for `want`, lower better, as CSS Fonts 4's §5.2
/// orders them: for 400 to 500, the weights from `want` up to 500 nearest first, then those
/// below it nearest first, then those above 500; below 400, those at or below it nearest
/// first, then those above; above 500, those at or above it, then those below.
let weight_rank = pure (want: i64, have: i64) -> (i64, i64) => {
  let distance = (want - have).abs()
  if want >= 400 && want <= 500 {
    if have >= want && have <= 500 { (
      0,
      distance
    ) } else if have < want { (1, distance) } else {
      (2, distance)
    }
  } else if want < 400 {
    if have <= want { (0, distance) } else { (1, distance) }
  } else {
    if have >= want { (0, distance) } else { (1, distance) }
  }
}

/// A face as it was added: its family, file and face within it, its weight (a variable font's
/// default) and style, its variation axes (none for a font that does not vary) and its weight
/// axis among them, and the face it is drawn as in [Fonts.faces].
struct Added {
  family: string,
  path: string,
  index: i64,
  weight: i64,
  italic: bool,
  axes: []VariationAxis,
  weights: Maybe<VariationAxis>,
  face: i64,
}

/// Face `index` of the font file at `path` opened for both libraries as one of `family`'s —
/// at these design coordinates (none for its default), and emboldened or slanted as it is
/// rendered — with its extents; `None` if it cannot be opened.
let open_face = (
  family: string,
  path: string,
  index: i64,
  coordinates: []f32,
  embolden: bool,
  oblique: bool
) -> Maybe<Face> => {
  let Some(hb) = open_hb_font(path, u32(index)) else { return None }
  let Some(ft) = open_ft_font(path, index) else {
    close_hb_font(hb)
    return None
  }
  if coordinates.len() > 0 { let _ = set_design_coordinates(ft, coordinates) }
  // Extents scale with the size, so they are kept for one unit to the em, read at a
  // thousand so their 26.6 fixed point keeps its precision.
  let at = font_extents(hb, 1000.0)
  Some(Face {
    family: family,
    hb: hb,
    ft: ft,
    ascender: at.ascender / 1000.0,
    descender: at.descender / 1000.0,
    line_gap: at.line_gap / 1000.0,
    embolden: embolden,
    oblique: oblique,
    color: has_color(ft),
  })
}

/// The glyphs a renderer has been given, packed into pages — a texture each — each glyph
/// rendered once at one pixel size and found again by its face, number and size. **A page is
/// added when a glyph fits in none**, up to `max_pages`; past that the page drawn from least
/// recently is emptied and filled again — never one the frame being painted has drawn from
/// ([GlyphAtlas.next_frame]), whose glyphs that frame's ops still show. A frame that needs
/// more than `max_pages` gets more.
pub struct GlyphAtlas {
  pages: []AtlasPage = [],
  slots: HashMap<string, AtlasSlot>,
  /// Texels on a page's side.
  size: i64 = ATLAS_SIZE,
  max_pages: i64 = ATLAS_PAGES,
  /// The page new glyphs go on until it is full.
  filling: i64 = -1,
  /// The frame being painted, counted by [GlyphAtlas.next_frame].
  frame: i64 = 0,
  /// The pictures a view names ([PictureSource]), by key: the texture each is drawn from, as
  /// of which revision, and the frame that last drew it.
  pictures: HashMap<string, KeptPicture>,
  /// The window the frame being painted is of: **one atlas serves every window** of a program
  /// — a renderer's textures are drawn in any — so a picture is let go only when the last
  /// frame of every window showing it no longer does. The host sets it before it paints.
  window: WindowId = MAIN_WINDOW,
}

/// A picture's texture as the atlas keeps it: its revision, size, the frame last drawing it,
/// and the windows whose last frame drew it.
struct KeptPicture {
  texture: TextureId,
  revision: i64,
  width: i64,
  height: i64,
  frame: i64,
  shown_in: []WindowId = [],
}

/// A page's texture is this many texels on a side.
pub const ATLAS_SIZE: i64 = 1024

/// How many pages an atlas keeps before it empties one for new glyphs.
pub const ATLAS_PAGES: i64 = 4

/// An empty atlas; a page's texture is uploaded the first time a glyph needs it.
pub let glyph_atlas = pure () -> GlyphAtlas =>
  GlyphAtlas { slots: hashmap_new(), pictures: hashmap_new() }

/// An empty atlas of pages `size` texels on a side, emptying one past `max_pages` — small
/// ones, for a test to fill.
pub let glyph_atlas_sized = pure (size: i64, max_pages: i64) -> GlyphAtlas =>
  GlyphAtlas {
    slots: hashmap_new(),
    pictures: hashmap_new(),
    size: size,
    max_pages: max_pages.max(1)
  }

impl GlyphAtlas {
  /// A new frame begins: the pages the last one drew from may be emptied again. `ui.layout`'s
  /// `paint` calls it.
  pub let next_frame = (self: mut) -> void => { self.frame += 1 }

  /// The texture `source` is drawn from, marked drawn this frame: uploaded through `renderer`
  /// the first time its key is drawn, written again only when its revision moves — in place
  /// where its size has not changed, else uploaded anew — and `None` where the renderer cannot
  /// hold it.
  pub let picture<r> where r: Renderer = (
    self: mut,
    source: PictureSource,
    renderer: mut r
  ) -> Maybe<TextureId> => {
    let image = source.image
    if let Some(kept) = self.pictures.get(source.key) {
      let shown_in = if kept.shown_in.contains(self.window) { kept.shown_in } else {
        [...kept.shown_in, self.window]
      }
      if kept.revision == source.revision {
        self.pictures.insert(
          source.key,
          KeptPicture { kept | frame: self.frame, shown_in: shown_in }
        )
        return Some(kept.texture)
      }
      let same_size = kept.width == image.width && kept.height == image.height
      if same_size && renderer.update(kept.texture, Point {}, image) {
        self.pictures.insert(
          source.key,
          KeptPicture {
            kept | revision: source.revision,
            frame: self.frame,
            shown_in: shown_in
          }
        )
        return Some(kept.texture)
      }
      renderer.release(kept.texture)
      let _ = self.pictures.remove(source.key)
    }
    let Some(texture) = renderer.upload(image) else { return None }
    self.pictures.insert(source.key, KeptPicture {
      texture: texture,
      revision: source.revision,
      width: image.width,
      height: image.height,
      frame: self.frame,
      shown_in: [self.window],
    })
    Some(texture)
  }

  /// The pictures this frame of its window did not draw, and its last frame did, let go
  /// through `renderer` where no other window's last frame drew them: a key no view names now.
  /// `ui.layout`'s `paint` calls it as a frame ends.
  pub let release_pictures<r> where r: Renderer = (
    self: mut,
    renderer: mut r
  ) -> void => {
    for (key, kept) in self.pictures.entries() {
      if kept.frame >= self.frame || !kept.shown_in.contains(self.window) { continue }
      self.unshown(key, kept, self.window, renderer)
    }
  }

  /// A window closed: the pictures only it showed let go through `renderer`.
  pub let window_closed<r> where r: Renderer = (
    self: mut,
    window: WindowId,
    renderer: mut r
  ) -> void => {
    for (key, kept) in self.pictures.entries() {
      if kept.shown_in.contains(window) { self.unshown(key, kept, window, renderer) }
    }
  }

  /// The picture `key`, `kept`, no longer shown in `window`: let go where that was the last.
  let unshown<r> where r: Renderer = (
    self: mut,
    key: string,
    kept: KeptPicture,
    window: WindowId,
    renderer: mut r
  ) -> void => {
    let rest = [w in kept.shown_in | w != window | w]
    if rest.len() > 0 {
      self.pictures.insert(key, KeptPicture { kept | shown_in: rest })
      return
    }
    renderer.release(kept.texture)
    let _ = self.pictures.remove(key)
  }

  /// How many pictures the atlas holds a texture for — for a test.
  pub let picture_count = pure (self) -> i64 => self.pictures.len()

  /// How many pages the atlas has, and how many times a page has been emptied for new glyphs.
  pub let page_count = pure (self) -> i64 => self.pages.len()

  pub let evictions = pure (self) -> i64 => {
    var n = 0
    for page in self.pages { n += page.generation }
    n
  }

  /// `block`'s glyphs drawn in `color` with its top-left corner at `origin`, for a display
  /// at `scale` pixels a unit: a [Glyphs] op for each page they are on — and a colour glyph (an
  /// emoji's) a [Picture] of its own, untinted — any glyph not yet in the atlas rendered into it
  /// through `renderer` first. A glyph that cannot be rendered, or
  /// is larger than a page, is left out.
  pub let glyphs<r> where r: Renderer = (
    self: mut,
    fonts: Fonts,
    renderer: mut r,
    block: TextBlock,
    origin: Point,
    scale: f32,
    color: Color
  ) -> []DrawOp => {
    if block.face < 0 || block.lines.len() == 0 { return [] }
    let pixels = i64((block.size * scale).round()).max(1)
    // Each page's quads, by page number, in the order the pages were first needed.
    var order: []i64 = []
    var quads: [][]GlyphQuad = []
    var pictures: []DrawOp = []
    for line in block.lines {
      for g in line.glyphs {
        // Its own face: a fallback's where the block's lacks its character.
        let index = if g.face >= 0 { g.face } else { block.face }
        let found = self.slot_for(
          renderer,
          fonts.faces[index],
          index,
          g.glyph,
          pixels,
          fonts.hinting
        )
        let Some(slot) = found else { continue }
        if slot.texels.is_empty() { continue }
        // The pen rounded to a whole pixel, the bitmap placed from it as FreeType says.
        let pen_x = f32(((origin.x + g.x) * scale).round())
        let pen_y = f32(((origin.y + line.baseline - g.y) * scale).round())
        let quad = GlyphQuad {
          at: Rect {
            x: (pen_x + slot.left) / scale,
            y: (pen_y - slot.top) / scale,
            w: slot.texels.w / scale,
            h: slot.texels.h / scale,
          },
          texels: slot.texels,
        }
        // A colour glyph is a picture of its own colours, only faded by the text's alpha.
        if slot.colored {
          pictures.push(Picture(
            self.pages[slot.page].texture,
            slot.texels,
            quad.at,
            f32(color.a) / 255.0
          ))
          continue
        }
        var at = -1
        for i, page in order {
          if page == slot.page { at = i }
        }
        if at < 0 {
          order.push(slot.page)
          quads.push([quad])
        } else {
          quads[at].push(quad)
        }
      }
    }
    var ops: []DrawOp = []
    for i, page in order { ops.push(Glyphs(self.pages[page].texture, quads[i], color)) }
    [...ops, ...pictures]
  }

  /// Where glyph `glyph` of face number `index` at `pixels` to the em is in the atlas,
  /// rendering it there if it is not yet — or `None` if it cannot be rendered or placed. A
  /// glyph with no ink has an empty slot. Its page is marked drawn from this frame.
  let slot_for<r> where r: Renderer = (
    self: mut,
    renderer: mut r,
    face: Face,
    index: i64,
    glyph: u32,
    pixels: i64,
    hinting: Hinting
  ) -> Maybe<AtlasSlot> => {
    let key = "${index}|${glyph}|${pixels}|${hint_code(hinting)}"
    if let Some(slot) = self.slots.get(key) {
      // A slot on an emptied page is gone, and is rendered again below.
      if slot.texels.is_empty() { return Some(slot) }
      if self.pages[slot.page].generation == slot.generation {
        self.pages[slot.page].drawn = self.frame
        return Some(slot)
      }
    }
    // An emoji font's glyph in its own colours; else, or where it has none, its coverage.
    let colored = if face.color { render_color_glyph(
      face.ft,
      glyph,
      u32(pixels)
    ) } else { None }
    let (image, left, top) = match colored {
      Some(c) => (Image { width: c.width, height: c.rows, argb: c.argb }, c.left, c.top),
      None => {
        let Some(bitmap) = render_glyph(
          face.ft,
          glyph,
          u32(pixels),
          hinting,
          face.embolden,
          face.oblique
        ) else { return None }
        (
          Image {
            width: bitmap.width,
            height: bitmap.rows,
            argb: [c in bitmap.coverage | white_at(c)],
          },
          bitmap.left,
          bitmap.top
        )
      },
    }
    var slot = AtlasSlot { left: f32(left), top: f32(top), colored: colored.is_some() }
    if image.width > 0 && image.height > 0 {
      let Some((page, at)) = self.place(
        renderer,
        image.width,
        image.height
      ) else { return None }
      if !renderer.update(self.pages[page].texture, at, image) { return None }
      slot = AtlasSlot {
        slot |
        texels: Rect { x: at.x, y: at.y, w: f32(image.width), h: f32(image.height) },
        page: page,
        generation: self.pages[page].generation,
      }
      self.pages[page].drawn = self.frame
    }
    self.slots.insert(key, slot)
    Some(slot)
  }

  /// Room for a `width` × `height` bitmap, a texel clear of its neighbours, and the page it is
  /// on: on the page being filled, else a new page, else the page drawn from least recently,
  /// emptied — or `None` when the bitmap is larger than a page, or no page can be had.
  let place<r> where r: Renderer = (
    self: mut,
    renderer: mut r,
    width: i64,
    height: i64
  ) -> Maybe<(i64, Point)> => {
    if width + 1 > self.size || height + 1 > self.size { return None }
    if self.filling >= 0 {
      if let Some(at) = self.pages[self.filling].room(width, height, self.size) {
        return Some((self.filling, at))
      }
    }
    // Emptied rather than added once there are enough — unless every page shows in this
    // frame, whose ops would show what replaced their glyphs.
    var page = -1
    if self.pages.len() >= self.max_pages {
      var oldest = self.frame
      for i, p in self.pages {
        if p.drawn < oldest {
          oldest = p.drawn
          page = i
        }
      }
    }
    if page >= 0 {
      if !self.empty(renderer, page) { return None }
    } else {
      let Some(texture) = renderer.upload(self.blank()) else { return None }
      self.pages.push(AtlasPage { texture: texture })
      page = self.pages.len() - 1
    }
    self.filling = page
    let Some(at) = self.pages[page].room(width, height, self.size) else { return None }
    Some((page, at))
  }

  /// Page `page` emptied: its texture cleared, its shelves begun again, its slots made stale.
  let empty<r> where r: Renderer = (self: mut, renderer: mut r, page: i64) -> bool => {
    if !renderer.update(self.pages[page].texture, Point {}, self.blank()) { return false }
    let was = self.pages[page]
    self.pages[page] = AtlasPage { texture: was.texture, generation: was.generation + 1 }
    true
  }

  /// A page's worth of clear texels.
  let blank = pure (self) -> Image =>
    Image {
      width: self.size,
      height: self.size,
      argb: [0x00FFFFFF; self.size * self.size]
    }
}

/// One texture of an atlas: the shelf being filled — its top, how far across it is, and its
/// tallest glyph — the frame it was last drawn from, and how many times it has been emptied,
/// which the slots on it carry.
struct AtlasPage {
  texture: TextureId,
  shelf_y: i64 = 0,
  shelf_x: i64 = 0,
  shelf_height: i64 = 0,
  drawn: i64 = 0,
  generation: i64 = 0,
}

impl AtlasPage {
  /// Room for a `width` × `height` bitmap on this page of `size` texels a side: along the
  /// shelf being filled, or on a new one below it. `None` when it is full.
  let room = (self: mut, width: i64, height: i64, size: i64) -> Maybe<Point> => {
    if self.shelf_x + width + 1 > size {
      self.shelf_y += self.shelf_height + 1
      self.shelf_x = 0
      self.shelf_height = 0
    }
    if self.shelf_y + height + 1 > size { return None }
    let at = Point { x: f32(self.shelf_x), y: f32(self.shelf_y) }
    self.shelf_x += width + 1
    self.shelf_height = self.shelf_height.max(height)
    Some(at)
  }
}

/// `hinting` as one letter, for an atlas slot's key.
let hint_code = pure (hinting: Hinting) -> string => match hinting {
  HintNone => "n",
  HintLight => "l",
  HintFull => "f",
}

/// White, at `coverage` opacity: a glyph's texel, which [Glyphs] tints with its colour.
let white_at = pure (coverage: u8) -> u32 => (u32(coverage) << 24) | 0x00FFFFFF

// ── Faces ────────────────────────────────────────────────────────────────────

/// A font file opened for both libraries, its vertical metrics for one unit to the em,
/// whether its glyphs are emboldened or slanted as they are rendered (a bold or italic made for
/// a family that lacks it), and whether it has colour glyphs (an emoji font's).
struct Face {
  family: string,
  hb: HbFont,
  ft: FtFont,
  ascender: f32,
  descender: f32,
  line_gap: f32,
  embolden: bool = false,
  oblique: bool = false,
  color: bool = false,
}

/// Where a glyph is in the atlas — its `page`, and its `texels` there (empty for one with no
/// ink) while the page is still at its `generation` — where its bitmap's top-left corner is
/// from the pen (`left` across, `top` up, in pixels), and whether its texels are its own
/// colours rather than coverage to tint.
struct AtlasSlot {
  texels: Rect = Rect {},
  left: f32 = 0.0,
  top: f32 = 0.0,
  page: i64 = 0,
  generation: i64 = 0,
  colored: bool = false,
}

// ── Line breaking ────────────────────────────────────────────────────────────

/// `text` in `face` (number `index`) at `font`'s size, broken into lines no wider than `width`.
/// A `line_height` taller than the font's own splits the extra above and below each line.
let break_lines = (
  faces: []Face,
  order: []i64,
  text: string,
  font: FontSpec,
  width: f32
) -> TextBlock => {
  let face = faces[order[0]]
  let size = font.size
  let natural = (face.ascender - face.descender + face.line_gap) * size
  let line_height = if font.line_height > 0.0 { font.line_height * size } else { natural }
  let ascent = face.ascender * size + (line_height - natural) / 2.0
  var lines: []TextLine = []
  // Each paragraph's bytes start where the last one's newline ended.
  var base = 0
  for paragraph in text.split("\n") {
    let bytes = paragraph.encode_utf8()
    // Shaped a run at a time, each run in the face that has its characters; the glyphs'
    // clusters are offsets into the whole paragraph.
    var shaped: []ShapedGlyph = []
    var drawn_from: []i64 = []
    for run in runs_of(paragraph, faces, order) {
      for g in shape(faces[run.face].hb, bytes.slice(run.start, run.end), size) {
        shaped.push(ShapedGlyph { g | cluster: g.cluster + u32(run.start) })
        drawn_from.push(run.face)
      }
    }
    let breaks = break_opportunities(paragraph, bytes.len())
    for line in fill_lines(shaped, drawn_from, bytes, breaks, width) {
      let baseline = f32(lines.len()) * line_height + ascent
      let moved = [g in line.glyphs | LineGlyph { g | cluster: g.cluster + base }]
      lines.push(TextLine {
        line | glyphs: moved,
        baseline: baseline,
        start: line.start + base
      })
    }
    base += bytes.len() + 1
  }
  var widest: f32 = 0.0
  for line in lines { widest = widest.max(line.width) }
  TextBlock {
    face: order[0],
    size: size,
    lines: lines,
    width: widest,
    height: f32(lines.len()) * line_height,
    line_height: line_height,
  }
}

/// A stretch of a paragraph's UTF-8, from byte `start` up to `end`, shaped in one face.
struct Run {
  start: i64,
  end: i64,
  face: i64,
}

/// `paragraph` cut into runs by the face each character is drawn from: the first of `order`
/// whose font has it (the first of all when none has, which draws its missing glyph). A
/// combining mark, or a space the run's face has, stays in the run before it, so a mark is
/// never shaped apart from its base and a run is not broken at every space.
let runs_of = (paragraph: string, faces: []Face, order: []i64) -> []Run => {
  var runs: []Run = []
  var at = 0
  // The character before, and where it began: an emoji selector after it moves it.
  var before: rune = ' '
  var before_at = 0
  for c in paragraph {
    let length = utf8_length(c)
    // U+FE0F asks for the character before it as an emoji: into a colour face's run, if the
    // run it is in is not one already and a colour face has it.
    if i32(c) == EMOJI_SELECTOR && runs.len() > 0 && !faces[runs[runs.len() - 1].face].color {
      if let Some(f) = color_face(faces, order, before) {
        let last = runs[runs.len() - 1]
        if last.start < before_at {
          runs[runs.len() - 1] = Run { last | end: before_at }
        } else {
          runs = runs.slice(0, runs.len() - 1)
        }
        if runs.len() > 0 && runs[runs.len() - 1].face == f {
          let joined = runs[runs.len() - 1]
          runs[runs.len() - 1] = Run { joined | end: at + length }
        } else {
          runs.push(Run { start: before_at, end: at + length, face: f })
        }
        at += length
        continue
      }
    }
    if !is_mark(c) {
      before = c
      before_at = at
    }
    if runs.len() > 0 {
      let last = runs[runs.len() - 1]
      if (is_mark(c) || c == ' ') && (is_mark(c) || has_glyph(faces[last.face].hb, c)) {
        runs[runs.len() - 1] = Run { last | end: at + length }
        at += length
        continue
      }
    }
    var face = order[0]
    for f in order {
      if has_glyph(faces[f].hb, c) {
        face = f
        break
      }
    }
    if runs.len() > 0 && runs[runs.len() - 1].face == face {
      let last = runs[runs.len() - 1]
      runs[runs.len() - 1] = Run { last | end: at + length }
    } else {
      runs.push(Run { start: at, end: at + length, face: face })
    }
    at += length
  }
  runs
}

/// U+FE0F, the variation selector asking for the character before it as an emoji, in colour.
const EMOJI_SELECTOR: i32 = 0xFE0F

/// The first face of `order` with colour glyphs that has `c`, for a character asked for as an
/// emoji.
let color_face = (faces: []Face, order: []i64, c: rune) -> Maybe<i64> => {
  for f in order {
    if faces[f].color && has_glyph(faces[f].hb, c) { return Some(f) }
  }
  None
}

/// Whether `c` combines with the character before it — the combining marks of the blocks most
/// text uses, the joiners and the variation selectors — so it belongs to that character's run.
let is_mark = pure (c: rune) -> bool => {
  let n = i32(c)
  (n >= 0x0300 && n <= 0x036F) ||
    (n >= 0x0483 && n <= 0x0489) ||
    (n >= 0x0591 && n <= 0x05BD) ||
    (n >= 0x0610 && n <= 0x061A) ||
    (n >= 0x064B && n <= 0x065F) ||
    (n >= 0x0900 && n <= 0x0903) ||
    (n >= 0x093A && n <= 0x094F) ||
    (n >= 0x1AB0 && n <= 0x1AFF) ||
    (n >= 0x1DC0 && n <= 0x1DFF) ||
    (n >= 0x200C && n <= 0x200D) ||
    (n >= 0x20D0 && n <= 0x20FF) ||
    (n >= 0x302A && n <= 0x302F) ||
    (n >= 0x3099 && n <= 0x309A) ||
    (n >= 0xFE00 && n <= 0xFE0F) ||
    (n >= 0xFE20 && n <= 0xFE2F) ||
    (n >= 0xE0100 && n <= 0xE01EF)
}

/// Lines from one paragraph's glyphs, filled greedily: each runs to the last opportunity at
/// which it still fits in `width`, or past it to the first opportunity when even one word
/// does not. An empty paragraph is one empty line.
let fill_lines = pure (
  glyphs: []ShapedGlyph,
  faces: []i64,
  bytes: []u8,
  breaks: []bool,
  width: f32
) -> []TextLine => {
  // Where the pen is before each glyph, and after the last.
  var pens: []f32 = [0.0]
  for g in glyphs { pens.push(pens[pens.len() - 1] + g.x_advance) }
  let count = glyphs.len()
  var lines: []TextLine = []
  var start = 0
  loop {
    var end = count
    if visible_width(glyphs, bytes, pens, start, count) > width {
      // The last opportunity that fits, else the first there is.
      var fits = -1
      var first = -1
      for i in (start + 1)..<count {
        if !breaks_before(glyphs, breaks, i) { continue }
        if first < 0 { first = i }
        if visible_width(
          glyphs,
          bytes,
          pens,
          start,
          i
        ) <= width { fits = i } else { break }
      }
      end = if fits > 0 { fits } else if first > 0 { first } else { count }
    }
    var placed: []LineGlyph = []
    for i in start..<end {
      let g = glyphs[i]
      placed.push(LineGlyph {
        face: faces[i],
        glyph: g.glyph,
        x: pens[i] - pens[start] + g.x_offset,
        y: g.y_offset,
        pen: pens[i] - pens[start],
        advance: g.x_advance,
        cluster: i64(g.cluster),
      })
    }
    lines.push(TextLine {
      glyphs: placed,
      width: visible_width(glyphs, bytes, pens, start, end),
      advance: pens[end] - pens[start],
      start: if start < count { i64(glyphs[start].cluster) } else { bytes.len() },
    })
    if end >= count { return lines }
    start = end
  }
}

/// How wide glyphs `start` up to `end` are, spaces at the end left out: they hang.
let visible_width = pure (
  glyphs: []ShapedGlyph,
  bytes: []u8,
  pens: []f32,
  start: i64,
  end: i64
) -> f32 => {
  var last = end
  while last > start && bytes[i64(glyphs[last - 1].cluster)] == SPACE { last -= 1 }
  pens[last] - pens[start]
}

/// Whether a line may start at glyph `i`: it is its cluster's first glyph, and its cluster
/// starts at an opportunity.
let breaks_before = pure (glyphs: []ShapedGlyph, breaks: []bool, i: i64) -> bool =>
  glyphs[i].cluster != glyphs[i - 1].cluster && breaks[i64(glyphs[i].cluster)]

/// For each byte offset of `text`'s UTF-8 (`length` bytes, and one past the end), whether a
/// line may start there: after a run of spaces, after a hyphen between two letters, and
/// before or after an ideograph.
let break_opportunities = pure (text: string, length: i64) -> []bool => {
  var breaks: []bool = [false; length + 1]
  var at = 0
  var previous: rune = ' '
  var before_previous: rune = ' '
  for c in text {
    if at > 0 {
      let after_spaces = previous == ' ' && c != ' '
      let after_hyphen = previous == '-' && is_letter(before_previous) && is_letter(c)
      breaks[at] = after_spaces ||
        after_hyphen ||
        is_ideograph(previous) ||
        is_ideograph(c)
    }
    before_previous = previous
    previous = c
    at += utf8_length(c)
  }
  breaks
}

/// Whether `c` is a letter for hyphenation's sake: ASCII's, or any past it.
let is_letter = pure (c: rune) -> bool => c.is_ascii_alpha() || i32(c) >= 0xC0

/// Whether `c` is a CJK ideograph, kana or a full-width form — UAX #14's `ID` class, near
/// enough: a line may break either side of one.
let is_ideograph = pure (c: rune) -> bool => {
  let n = i32(c)
  (n >= 0x3040 && n <= 0x30FF) ||
    (n >= 0x3400 && n <= 0x9FFF) ||
    (n >= 0xF900 && n <= 0xFAFF) ||
    (n >= 0xFF00 && n <= 0xFFEF)
}

/// How many bytes `c` takes in UTF-8.
let utf8_length = pure (c: rune) -> i64 => {
  let n = i32(c)
  if n < 0x80 { 1 } else if n < 0x800 { 2 } else if n < 0x10000 { 3 } else { 4 }
}

const SPACE: u8 = 0x20
