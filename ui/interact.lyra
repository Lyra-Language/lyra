import std.collections.{ HashMap, hashmap_new }

/// The framework's state between frames: the [Interaction] the layout reads, where the pointer
/// was last, and the text field the platform was last told text input is for, and where.
pub struct Ui {
  state: Interaction,
  pointer: Point = Point {},
  /// What the press in a text field picked, for a drag to extend: by rune (a click), by word
  /// (a double click) or the whole text (a triple), and the runes it first selected.
  picking: Picking = Picking {},
  typing_into: string = "",
  typing_at: Rect = Rect {},
  /// Each element's transitions (`ui.motion`), by identity; the clock's milliseconds a frame
  /// shows them at (the host sets it from `Platform.now_ms`); and whether a frame just
  /// started moving a property that changes sizes.
  motions: HashMap<string, Motion>,
  now: i64 = 0,
  resized: bool = false,
  /// The element taking input raw that a press on it gave the pointer to, until it is let go;
  /// `""` for none.
  captured: string = "",
  /// The key of the element to focus once it is laid out ([Ui.focus_keyed]); `""` for none.
  focus_wanted: string = "",
  /// The key of a scroller to scroll once it is laid out, and how far down ([Ui.scroll_keyed]).
  scroll_wanted: string = "",
  scroll_wanted_to: f32 = 0.0,
  /// An element to scroll into view once it is laid out — the option under an open select's
  /// keys — `""` for none.
  reveal_wanted: string = "",
  /// The popups open at the last frame: whose focus a popup just opened takes, and which one
  /// just closed gives back.
  popups: []OpenPopup = [],
  /// Whether the deepest open menu's first item takes the focus once it is laid out — a menu
  /// opened from the keyboard.
  menu_first: bool = false,
  /// The tabs selected at the last frame: one selected since is scrolled into view.
  tabs_selected: []string = [],
  /// The window's own buttons pressed and let go on since the host last took them
  /// ([Ui.take_window_buttons]): the framework's to carry out, not the program's.
  window_asked: []WindowButton = [],
}

/// A popup open at a frame, by its identity and its anchor's and content's.
pub struct OpenPopup {
  id: string,
  anchor: string,
  content: string,
}

/// What a press in a text field selected: the clicks it made (1 by rune, 2 by word, 3 all)
/// and the runes `from` to `to` the press itself took.
pub struct Picking {
  clicks: i64 = 1,
  from: i64 = 0,
  to: i64 = 0,
}

/// An element found in a laid-out tree, and where its top-left corner is in the window.
pub struct Found<e> {
  laid: Laid<e>,
  origin: Point,
}

/// No focus, nothing hovered or held, no element's state.
pub let ui_new = pure () -> Ui => Ui { state: interaction_new(), motions: hashmap_new() }

/// How far a scroll moves for a line of a wheel, in units.
pub const SCROLL_LINE: f32 = 40.0

impl Ui {
  /// `view` laid out in a window `size` large, with this state — and the state of every
  /// element no longer in it dropped, and the focus, hover or press on one cleared.
  pub let frame<e> = (
    self: mut,
    view: Node<e>,
    size: Size,
    fonts: mut Fonts
  ) -> Laid<e> => {
    var cache: LayoutCache<e> = layout_cache()
    self.frame_cached(view, size, fonts, cache)
  }

  /// [frame], with each element laid out last frame and unchanged since given back from
  /// `cache` (`ui.layout`'s `layout_cached`).
  pub let frame_cached<e> = (
    self: mut,
    view: Node<e>,
    size: Size,
    fonts: mut Fonts,
    cache: mut LayoutCache<e>
  ) -> Laid<e> => self.frame_within(view, loose(size), fonts, cache)

  /// [frame_cached] within `c` — a window's own size exactly, for the root of a window that
  /// fills it (`ui.app`'s host).
  pub let frame_within<e> = (
    self: mut,
    view: Node<e>,
    c: Constraints,
    fonts: mut Fonts,
    cache: mut LayoutCache<e>
  ) -> Laid<e> => {
    self.state.shown = self.sizes_shown()
    var laid = layout_cached(view, c, fonts, self.state, cache)
    var present: HashMap<string, bool> = hashmap_new()
    note_ids(laid, present)
    // A focus asked for by key, once the element is there.
    if self.focus_wanted.len() > 0 {
      for id in present.keys() {
        if id.ends_with("/:${self.focus_wanted}") {
          self.state.focus = id
          self.state.keyboard_focus = false
          self.focus_wanted = ""
          break
        }
      }
    }
    // A scroll asked for by key: the offset set, and the tree laid out again with it.
    if self.scroll_wanted.len() > 0 {
      for id in present.keys() {
        if !id.ends_with("/:${self.scroll_wanted}") { continue }
        let Some(found) = find(laid, id, Point {}) else { continue }
        let Some(sc) = found.laid.scroller else { continue }
        let end = sc.room().h
        let to = self.scroll_wanted_to.clamp(0.0, end)
        let state = self.widget(id)
        self.state.widgets.insert(
          id,
          WidgetState { state | scroll: Some(to), following: to >= end - 0.5 }
        )
        self.scroll_wanted = ""
        laid = layout_cached(view, c, fonts, self.state, cache)
        break
      }
    }
    for id in self.state.widgets.keys() {
      if !present.contains_key(id) { let _ = self.state.widgets.remove(id) }
    }
    for id in self.motions.keys() {
      if !present.contains_key(id) { let _ = self.motions.remove(id) }
    }
    // Transitions moved on to `now`, blended into what is drawn; a size that just started
    // moving is laid out again at once, so the frame never shows it at its target.
    self.resized = false
    var shown = self.moved(
      laid,
      laid.style.opacity / laid.style.own_opacity.max(0.0001),
      laid.style.color,
      laid.style.color,
      false
    )
    if self.resized {
      self.state.shown = self.sizes_shown()
      laid = layout_cached(view, c, fonts, self.state, cache)
      shown = self.moved(
        laid,
        laid.style.opacity / laid.style.own_opacity.max(0.0001),
        laid.style.color,
        laid.style.color,
        false
      )
    }
    // A tab selected since the last frame — by a press, a key or the program — into view in its
    // strip.
    let chosen_tabs = selected_tabs(laid)
    for id in chosen_tabs {
      if !self.tabs_selected.contains(id) && self.reveal_wanted.len() == 0 { self.reveal_wanted = id }
    }
    self.tabs_selected = chosen_tabs
    // An element asked to be in view, scrolled there — and the tree laid out again with it.
    if self.reveal_wanted.len() > 0 {
      let wanted = self.reveal_wanted
      self.reveal_wanted = ""
      if present.contains_key(wanted) {
        self.reveal(laid, wanted)
        laid = layout_cached(view, c, fonts, self.state, cache)
        shown = self.moved(
          laid,
          laid.style.opacity / laid.style.own_opacity.max(0.0001),
          laid.style.color,
          laid.style.color,
          false
        )
      }
    }
    self.popups_followed(laid)
    self.menus_followed(laid, present)
    // A draft lasts while its field has the focus.
    for id in self.state.drafts.keys() {
      if id != self.state.focus { let _ = self.state.drafts.remove(id) }
    }
    if !present.contains_key(self.state.focus) { self.state.focus = "" }
    if !present.contains_key(self.state.open) { self.state.open = "" }
    // A control disabled since it took the focus or the press gives them up.
    if let Some(found) = find(
      laid,
      self.state.focus,
      Point {}
    ) { if found.laid.disabled { self.state.focus = "" } }
    if let Some(found) = find(
      laid,
      self.state.pressed,
      Point {}
    ) { if found.laid.disabled { self.state.pressed = "" } }
    // A scrollbar's thumb is held by its scroller's identity and an axis.
    if !present.contains_key(element_of(self.state.hover)) { self.state.hover = "" }
    if !present.contains_key(element_of(self.state.pressed)) { self.state.pressed = "" }
    // A field's text scrolled to keep its caret in view is remembered, so it stays put
    // until the caret leaves the view again.
    keep_field_scrolls(laid, self)
    shown
  }

  /// Whether a transition is moving anything at `now` — while one is, the host draws every
  /// frame.
  pub let animating = pure (self) -> bool => {
    for (
      _,
      motion
    ) in self.motions.entries() { if in_motion(motion, self.now) { return true } }
    false
  }

  /// What each element moving a size shows at `now`, for the layout.
  let sizes_shown = pure (self) -> HashMap<string, Computed> => {
    var out: HashMap<string, Computed> = hashmap_new()
    for (id, motion) in self.motions.entries() {
      if moves_sizes(motion) { out.insert(id, shown_at(motion, self.now)) }
    }
    out
  }

  /// `laid` as it shows at `now`: each element with a transition moved on towards the style
  /// the cascade asks for (`ui.motion`'s [advance]) and drawn as far as it has come, with what
  /// it shows passed down — an opacity multiplied into everything inside it, a colour to the
  /// text that inherits it. `product` is the opacity drawn with around it, `ink` the colour
  /// its parent's style asks for and `inked` the one it shows; `changed` whether either is
  /// not what was laid out. A subtree with no transition under an unchanged parent is given
  /// back as it is.
  let moved<e> = (
    self: mut,
    laid: Laid<e>,
    product: f32,
    ink: Color,
    inked: Color,
    changed: bool
  ) -> Laid<e> => {
    if !changed && !laid.moves { return laid }
    var style = laid.style
    var own_color = false
    if laid.style.transition.len() > 0 {
      let (motion, sized) = advance(self.motions.get(laid.id), laid.style, self.now)
      if sized { self.resized = true }
      style = shown_at(motion, self.now)
      own_color = motion.moving.any((m) => m.property == "color")
      self.motions.insert(laid.id, motion)
    } else if self.motions.contains_key(laid.id) { let _ = self.motions.remove(laid.id) }
    style = Computed { style | opacity: product * style.own_opacity }
    if changed && !own_color && laid.style.color == ink { style = Computed { style | color: inked } }
    let below = changed ||
      (style.opacity - laid.style.opacity).abs() > 0.0001 ||
      style.color != laid.style.color
    var children: []Placed<e> = []
    for p in laid.children {
      children.push(Placed { p | laid: self.moved(
        p.laid,
        style.opacity,
        laid.style.color,
        style.color,
        below
      ) })
    }
    Laid { laid | style: style, children: children }
  }

  /// The events `input` raises in `laid` — the frame the user is looking at — and the
  /// framework's state moved on by it. `platform` is the clipboard's.
  pub let handle<e, p> where p: Platform = (
    self: mut,
    laid: Laid<e>,
    input: InputEvent,
    platform: mut p
  ) -> []e => {
    // Open popups hear it before anything: Escape dismisses the innermost (an open select's
    // list being the select's to close), the window losing the focus every one, and a press
    // each it falls outside of — and the press goes on.
    var dismissed: []e = []
    let popups = open_popups(laid)
    if popups.len() > 0 {
      match input {
        KeyPressed(Escape, _) =>
          if self.state.open.len() == 0 && self.state.menus.len() == 0 {
            return [popups[popups.len() - 1].dismissed]
          },
        WindowUnfocused => {
          for p in popups { dismissed.push(p.dismissed) }
        },
        PointerDown(_, at, _) => {
          for p in popups {
            if !p.anchor_box.contains(at) && !p.areas.any((r) => r.contains(at)) {
              dismissed.push(p.dismissed)
            }
          }
        },
        _ => {},
      }
    }
    // An element taking input raw hears it first; what it hands back goes on as before.
    if let Some(events) = self.heard_raw(
      laid,
      input,
      platform
    ) { return [...dismissed, ...events] }
    [...dismissed, ...self.handled(laid, input, platform)]
  }

  /// Which open menu's list `id` is in — its place in `Interaction.menus`, the deepest holding
  /// it — or -1 for none.
  let menu_level = pure (self, id: string) -> i64 => {
    let menus = self.state.menus
    var k = menus.len() - 1
    while k >= 0 {
      if within_id(id, "${menus[k]}/:menu") { return k }
      k -= 1
    }
    -1
  }

  /// The menu the opener identified as `id` opens, opened: after the menus holding it, closing
  /// any deeper, or on its own.
  let open_menu = (self: mut, id: string) -> void => {
    let level = self.menu_level(id)
    self.state.menus = [...self.state.menus.slice(0, level + 1), id]
  }

  /// A menu's item chosen: every menu closed, the focus on the opener of the first.
  let menu_chosen = (self: mut) -> void => {
    if self.state.menus.len() > 0 { self.state.focus = self.state.menus[0] }
    self.state.menus = []
  }

  /// A press on an opener, or while a menu is open: an opener's opens its menu, or closes it
  /// and those from it when it is open — the press taken; any other press outside every open
  /// menu closes them all, and goes on (`None`).
  let menu_press<e> = (self: mut, laid: Laid<e>, at: Point) -> Maybe<[]e> => {
    if let Some(target) = control_at(laid, at) {
      if let Opens(_) = target.laid.kind {
        let id = target.laid.id
        match self.state.menus.index_of(id) {
          Some(place) => { self.state.menus = self.state.menus.slice(0, place) },
          None => self.open_menu(id),
        }
        self.state.focus = id
        self.state.keyboard_focus = false
        self.state.pressed = ""
        return Some([])
      }
    }
    if self.state.menus.len() == 0 { return None }
    var inside = false
    for f in hit(laid, at) {
      if self.menu_level(f.laid.id) >= 0 { inside = true }
    }
    if !inside { self.state.menus = [] }
    None
  }

  /// The pointer moved while a menu is open: over another title of the bar the first open
  /// menu's title is in, that one opens instead; over a submenu's item, its submenu opens; over
  /// another item, the submenus deeper than its menu close.
  let menu_hover<e> = (self: mut, laid: Laid<e>, at: Point) -> void => {
    let menus = self.state.menus
    if menus.len() == 0 { return }
    let Some(target) = control_at(laid, at) else { return }
    let id = target.laid.id
    if let Opens(spec) = target.laid.kind {
      if spec.in_bar {
        if id != menus[0] && bar_title(
          laid,
          menus[0]
        ) && parent_of(id) == parent_of(menus[0]) {
          self.state.menus = [id]
          self.state.focus = id
        }
        return
      }
      if self.menu_level(id) >= 0 && !menus.contains(id) { self.open_menu(id) }
      return
    }
    let level = self.menu_level(id)
    if level >= 0 { self.state.menus = menus.slice(0, level + 1) }
  }

  /// A key while a menu is open: Escape closes the deepest, the focus back on its opener; Down
  /// and Up move the focus along its items, wrapping; Right opens the submenu of the item
  /// focused, or in a menu bar the next title's menu; Left closes a submenu, or in a bar opens
  /// the previous title's; Enter or Space chooses the item focused, or opens its submenu; Tab
  /// (Shift-Tab) closes them all and moves the focus on (back) from the first's title. Keys no
  /// menu takes go on (`None`).
  let menu_key<e> = (self: mut, laid: Laid<e>, key: Key, shift: bool) -> Maybe<[]e> => {
    // What a key the menus take raises: nothing, but an item chosen.
    let taken: []e = []
    let menus = self.state.menus
    let deepest = menus[menus.len() - 1]
    let focused = find(laid, self.state.focus, Point {})
    let opens = match focused {
      Some(f) => match f.laid.kind {
        Opens(_) => true,
        _ => false,
      },
      None => false,
    }
    let on_item = self.menu_level(self.state.focus) == menus.len() - 1
    match key {
      Escape => {
        self.state.menus = menus.slice(0, menus.len() - 1)
        self.state.focus = deepest
        self.state.keyboard_focus = true
        Some(taken)
      },
      // From the title the menus opened from, among the controls outside them.
      Tab => {
        var order: []string = []
        focus_order(laid, order)
        var outside: []string = []
        for id in order {
          if self.menu_level(id) < 0 { outside.push(id) }
        }
        self.state.menus = []
        if let Some(at) = outside.index_of(menus[0]) {
          self.state.focus = outside[(at + if shift { -1 } else { 1 }) %% outside.len()]
          self.state.keyboard_focus = true
        }
        Some(taken)
      },
      ArrowDown => {
        self.step_menu(laid, deepest, 1)
        Some(taken)
      },
      ArrowUp => {
        self.step_menu(laid, deepest, -1)
        Some(taken)
      },
      ArrowRight => {
        if opens && on_item {
          self.open_menu(self.state.focus)
          self.menu_first = true
        } else if bar_title(laid, menus[0]) {
          self.next_title(laid, 1)
        }
        Some(taken)
      },
      ArrowLeft => {
        if menus.len() > 1 {
          self.state.menus = menus.slice(0, menus.len() - 1)
          self.state.focus = deepest
          self.state.keyboard_focus = true
        } else if bar_title(laid, menus[0]) {
          self.next_title(laid, -1)
        }
        Some(taken)
      },
      _ => {
        if key != Enter && key != Character(' ') { return None }
        // On the opener itself, into its menu; on a submenu's item, into the submenu.
        if !on_item || opens {
          if on_item { self.open_menu(self.state.focus) }
          self.menu_first = true
          return Some(taken)
        }
        let Some(f) = focused else { return Some(taken) }
        let events = activated(f.laid)
        self.menu_chosen()
        Some(events)
      },
    }
  }

  /// The pointer at `at` on (or holding) the colour axis `axis`: the colour there, its picker's
  /// hue held, and the colour raised where it changed.
  let axis_moved<e> = (
    self: mut,
    axis: Found<e>,
    spec: AxisSpec<e>,
    at: Point
  ) -> []e => {
    let w = axis.laid.size.w.max(1.0)
    let h = axis.laid.size.h.max(1.0)
    let x = ((at.x - axis.origin.x) / w).clamp(0.0, 1.0)
    let y = ((at.y - axis.origin.y) / h).clamp(0.0, 1.0)
    self.axis_to(axis, spec, x, y)
  }

  /// The colour axis `axis` set to the fractions `x` across and `y` down.
  let axis_to<e> = (
    self: mut,
    axis: Found<e>,
    spec: AxisSpec<e>,
    x: f32,
    y: f32
  ) -> []e => {
    let (color, hue) = axis_color(spec, axis.laid.hue, x, y)
    self.state.hues.insert(picker_of(axis.laid.id), hue)
    if color == spec.color { [] } else { [(spec.on_change)(color)] }
  }

  /// A key for the focused colour axis `axis`: Left and Right move its thumb across a fiftieth,
  /// Up and Down the square's down, Home and End to its ends.
  let axis_key<e> = (self: mut, axis: Found<e>, spec: AxisSpec<e>, key: Key) -> []e => {
    let (x, y) = axis_spot(spec, axis.laid.hue)
    let step: f32 = 1.0 / 50.0
    let (nx, ny) = match key {
      ArrowLeft => (x - step, y),
      ArrowRight => (x + step, y),
      ArrowUp => (x, y - step),
      ArrowDown => (x, y + step),
      Home => (0.0, y),
      End => (1.0, y),
      _ => return [],
    }
    self.axis_to(axis, spec, nx.clamp(0.0, 1.0), ny.clamp(0.0, 1.0))
  }

  /// A key for the focused tab `tab`: Enter or Space selects it; Left and Right the tab before
  /// or after it in its strip, Home and End the first and last — the focus going with them.
  let tab_key<e> = (
    self: mut,
    laid: Laid<e>,
    tab: Found<e>,
    spot: TabSpot<e>,
    key: Key
  ) -> []e => {
    if key == Enter || key == Character(' ') { return if spot.selected { [] } else { [(spot.on_select)(spot.index)] } }
    let tabs = strip_tabs(laid, tab.laid.id)
    let Some(at) = [t in tabs | t.laid.id].index_of(tab.laid.id) else { return [] }
    let to = match key {
      ArrowLeft => at - 1,
      ArrowRight => at + 1,
      Home => 0,
      End => tabs.len() - 1,
      _ => at,
    }
    if to == at || to < 0 || to >= tabs.len() { return [] }
    let Some(next) = tab_spot(tabs[to].laid) else { return [] }
    self.state.focus = tabs[to].laid.id
    self.state.keyboard_focus = true
    if next.selected { [] } else { [(next.on_select)(next.index)] }
  }

  /// The focus `by` items along the menu the opener identified as `opener` opens, wrapping;
  /// from outside it, to its first item (or last, going up). The item scrolls into view.
  let step_menu<e> = (self: mut, laid: Laid<e>, opener: string, by: i64) -> void => {
    let items = menu_items(laid, opener)
    if items.len() == 0 { return }
    let next = match items.index_of(self.state.focus) {
      Some(at) => (at + by) %% items.len(),
      None => if by > 0 { 0 } else { items.len() - 1 },
    }
    self.state.focus = items[next]
    self.state.keyboard_focus = true
    self.reveal_wanted = items[next]
  }

  /// The menu of the title `by` along from the first open menu's, in its bar, wrapping, opened
  /// in its place, the focus to its first item.
  let next_title<e> = (self: mut, laid: Laid<e>, by: i64) -> void => {
    let title = self.state.menus[0]
    let Some(bar) = find(laid, parent_of(title), Point {}) else { return }
    var titles: []string = []
    for child in bar.laid.children {
      if bar_title(child.laid, child.laid.id) { titles.push(child.laid.id) }
    }
    let Some(at) = titles.index_of(title) else { return }
    let next = titles[(at + by) %% titles.len()]
    self.state.menus = [next]
    self.state.focus = next
    self.menu_first = true
  }

  /// The open menus after a layout: those whose openers are gone closed (with those after them),
  /// and the deepest's first item focused if a key opened it.
  let menus_followed<e> = (
    self: mut,
    laid: Laid<e>,
    present: HashMap<string, bool>
  ) -> void => {
    var kept: []string = []
    for opened in self.state.menus {
      if !present.contains_key(opened) { break }
      kept.push(opened)
    }
    self.state.menus = kept
    if !self.menu_first { return }
    self.menu_first = false
    if kept.len() == 0 { return }
    let items = menu_items(laid, kept[kept.len() - 1])
    if items.len() > 0 {
      self.state.focus = items[0]
      self.state.keyboard_focus = true
    }
  }

  /// The focus after popups opened or closed since the last frame: one just opened while the
  /// keyboard had the focus on its anchor takes it, on its first control; one just closed
  /// with the focus inside gives it back to its anchor's.
  let popups_followed<e> = (self: mut, laid: Laid<e>) -> void => {
    let now = open_popups(laid)
    for p in now {
      if self.popups.any((q) => q.id == p.id) { continue }
      if !self.state.keyboard_focus || !within_id(self.state.focus, p.anchor) { continue }
      if let Some(first) = first_control(laid, p.content) { self.state.focus = first }
    }
    for q in self.popups {
      if now.any((p) => p.id == q.id) || !within_id(
        self.state.focus,
        q.content
      ) { continue }
      self.state.focus = first_control(laid, q.anchor) ?? ""
    }
    self.popups = [p in now | OpenPopup {
      id: p.id,
      anchor: p.anchor,
      content: p.content
    }]
  }

  /// The focus to the element keyed `key` ([Node.keyed]) once a layout has it — the frame
  /// after the one that made it, if that is when it appears.
  pub let focus_keyed = (self: mut, key: string) -> void => { self.focus_wanted = key }

  /// The window's own buttons pressed and let go on since the last time, taken: minimize,
  /// maximize or restore, close — for the host to carry out.
  pub let take_window_buttons = (self: mut) -> []WindowButton => {
    let asked = self.window_asked
    self.window_asked = []
    asked
  }

  /// The scroller keyed `key` scrolled `y` units down — past its end is its end, where one that
  /// follows its end (`scroll_follow`) follows it again — once a layout has it.
  pub let scroll_keyed = (self: mut, key: string, y: f32) -> void => {
    self.scroll_wanted = key
    self.scroll_wanted_to = y
  }

  /// `input` as the framework handles it.
  let handled<e, p> where p: Platform = (
    self: mut,
    laid: Laid<e>,
    input: InputEvent,
    platform: mut p
  ) -> []e => match input {
    PointerMoved(at) => {
      platform.set_cursor(self.cursor_at(laid, at))
      self.pointer_moved(laid, at)
    },
    PointerDown(Primary, at, clicks) => self.pointer_down(laid, at, clicks),
    // A middle click on a tab closes it, as browsers have it.
    PointerDown(Middle, at, _) => middle_on_tab(laid, at),
    PointerUp(Primary, at) => self.pointer_up(laid, at),
    Scrolled(across, down) => {
      self.scrolled(laid, across, down)
      []
    },
    KeyPressed(key, mods) => self.key_pressed(laid, key, mods, platform),
    TextTyped(typed) => {
      let Some(field) = self.focused_field(laid) else { return [] }
      self.edit(field, (ed) => ed.insert(typed))
    },
    AccessAction(id, request) => self.access_action(laid, id, request),
    WindowUnfocused => {
      self.state.menus = []
      []
    },
    _ => [],
  }

  /// `input` as an element taking input raw ([RawInput]) hears it — a key or text the focused
  /// one, the pointer the one holding it or else the one under it — and the events it answers;
  /// `None` where there is no such element or it handed the input back. A press it takes holds
  /// the pointer for it and gives it the focus; a move it hears still hovers what is under the
  /// pointer.
  let heard_raw<e, p> where p: Platform = (
    self: mut,
    laid: Laid<e>,
    input: InputEvent,
    platform: mut p
  ) -> Maybe<[]e> => match input {
    KeyPressed(key, mods) =>
      self.raw_key(laid, KeyInput { key: key, mods: mods, pressed: true }),
    KeyReleased(key, mods) =>
      self.raw_key(laid, KeyInput { key: key, mods: mods, pressed: false }),
    TextTyped(text) => self.raw_text(laid, TypedText(text)),
    TextComposing(text, caret, length) =>
      self.raw_text(laid, ComposedText(text, caret, length)),
    PointerDown(button, at, clicks) => {
      self.pointer = at
      let Some(target) = raw_at(laid, at) else { return None }
      let Some(event) = pointed(target, at, PointerPress(button, clicks), platform) else {
        return None
      }
      self.captured = target.laid.id
      self.state.focus = target.laid.id
      self.state.keyboard_focus = false
      self.state.pressed = ""
      Some([event])
    },
    PointerMoved(at) => {
      let Some(target) = self.pointer_holder(laid, at) else { return None }
      let Some(event) = pointed(target, at, PointerMove, platform) else { return None }
      platform.set_cursor(self.cursor_at(laid, at))
      Some([event, ...self.pointer_moved(laid, at)])
    },
    PointerUp(button, at) => {
      let target = self.pointer_holder(laid, at)
      self.captured = ""
      let Some(t) = target else { return None }
      let Some(event) = pointed(
        t,
        at,
        PointerRelease(button),
        platform
      ) else { return None }
      self.pointer = at
      Some([event])
    },
    Scrolled(across, down) => {
      let Some(target) = raw_at(laid, self.pointer) else { return None }
      let Some(event) = pointed(
        target,
        self.pointer,
        PointerWheel(across, down),
        platform
      ) else {
        return None
      }
      Some([event])
    },
    _ => None,
  }

  /// A key for the focused element, if it takes input raw.
  let raw_key<e> = (self, laid: Laid<e>, key: KeyInput) -> Maybe<[]e> => {
    let Some(f) = find(laid, self.state.focus, Point {}) else { return None }
    let Some(raw) = raw_of(f.laid) else { return None }
    match (raw.on_key)(key) {
      Some(event) => Some([event]),
      None => None,
    }
  }

  /// Text for the focused element, if it takes input raw.
  let raw_text<e> = (self, laid: Laid<e>, text: TextInput) -> Maybe<[]e> => {
    let Some(f) = find(laid, self.state.focus, Point {}) else { return None }
    let Some(raw) = raw_of(f.laid) else { return None }
    match (raw.on_text)(text) {
      Some(event) => Some([event]),
      None => None,
    }
  }

  /// The element taking input raw that has the pointer: the one holding it since a press,
  /// else the one under `at`.
  let pointer_holder<e> = (self: mut, laid: Laid<e>, at: Point) -> Maybe<Found<e>> => {
    if self.captured.len() > 0 {
      if let Some(held) = find(laid, self.captured, Point {}) { return Some(held) }
      self.captured = ""
    }
    raw_at(laid, at)
  }

  /// What assistive technology asked of the element identified as `id`, done as the keyboard
  /// would do it — the focus moved, a button pressed, a slider stepped — or a value set
  /// outright: a field's text, a slider's number — sent as a number, or as text that is one
  /// (`parse_f64`, spaces around it allowed; other text is ignored).
  let access_action<e> = (
    self: mut,
    laid: Laid<e>,
    id: string,
    request: AccessRequest
  ) -> []e => {
    let Some(found) = find(laid, id, Point {}) else { return [] }
    if found.laid.disabled { return [] }
    match request {
      AxFocus => {
        if focusable(found.laid.kind) && !found.laid.disabled {
          self.state.focus = id
          self.state.keyboard_focus = true
        }
        []
      },
      AxClick => match found.laid.kind {
        Opens(_) => {
          match self.state.menus.index_of(id) {
            Some(place) => { self.state.menus = self.state.menus.slice(0, place) },
            None => self.open_menu(id),
          }
          []
        },
        Choosing(spec) => {
          if self.state.open == id {
            self.state.open = ""
          } else {
            self.open_select(id, spec)
          }
          []
        },
        _ => if self.state.open.len() > 0 && option_of(self.state.open, id).is_some() {
          self.choose_option(found.laid)
        } else {
          let events = activated(found.laid)
          if self.menu_level(id) >= 0 { self.menu_chosen() }
          events
        },
      },
      AxIncrement => match found.laid.kind {
        Ranged(spec) => step_slider(spec, ArrowRight),
        _ => [],
      },
      AxDecrement => match found.laid.kind {
        Ranged(spec) => step_slider(spec, ArrowLeft),
        _ => [],
      },
      AxSetNumber(n) => match found.laid.kind {
        Ranged(spec) => changed(spec, f32(n)),
        _ => [],
      },
      AxSetValue(text) => match found.laid.kind {
        Editable(spec) => {
          // The caret to the end of the new text, as after typing it.
          let state = self.widget(id)
          let end = text.len()
          self.state.widgets.insert(id, WidgetState { state | caret: end, anchor: end })
          if spec.draft && !spec.read_only { self.state.drafts.insert(id, text) }
          if text == spec.value || spec.read_only { [] } else { [(spec.on_edit)(text)] }
        },
        Ranged(spec) => match text.trim().parse_f64() {
          Some(n) => changed(spec, f32(n)),
          None => [],
        },
        _ => [],
      },
    }
  }

  /// Tell `platform` where text is being typed: near the caret of the focused text field —
  /// where an input method's window goes, and what a phone's keyboard keeps clear of — or
  /// nowhere when no field has the focus. Said only when it changes.
  pub let place_text_input<e, p> where p: Platform = (
    self: mut,
    laid: Laid<e>,
    platform: mut p
  ) -> void => {
    // An element taking input raw says where its caret is.
    if let Some(f) = find(laid, self.state.focus, Point {}) {
      if let Some(raw) = raw_of(f.laid) {
        if let Some(caret) = raw.caret {
          let at = Rect { caret | x: f.origin.x + caret.x, y: f.origin.y + caret.y }
          if self.typing_into != f.laid.id || self.typing_at != at {
            platform.set_text_input(Some(at))
            self.typing_into = f.laid.id
            self.typing_at = at
          }
          return
        }
      }
    }
    if let Some(f) = find(laid, self.state.focus, Point {}) {
      if let Some(look) = f.laid.field {
        let at = Rect {
          x: f.origin.x + f.laid.content_at.x + look.caret,
          y: f.origin.y + f.laid.content_at.y,
          w: 1.0,
          h: look.line_height,
        }
        if self.typing_into != f.laid.id || self.typing_at != at {
          platform.set_text_input(Some(at))
          self.typing_into = f.laid.id
          self.typing_at = at
        }
        return
      }
    }
    if self.typing_into.len() > 0 {
      let nowhere: Maybe<Rect> = None
      platform.set_text_input(nowhere)
      self.typing_into = ""
    }
  }

  /// The pointer's shape at `at`: an I-beam over a text field, or while a selection is being
  /// dragged in one; the pointing hand over a button that can be pressed (a disabled one is no
  /// control under the pointer); else the arrow.
  let cursor_at<e> = pure (self, laid: Laid<e>, at: Point) -> Cursor => {
    let held = find(laid, self.state.pressed, Point {})
    let over = if held.is_some() { held } else { control_at(laid, at) }
    match over {
      Some(f) => if f.laid.field.is_some() { IBeam } else {
        match f.laid.kind {
          Pressable(_) => Hand,
          _ => Arrow,
        }
      },
      None => Arrow,
    }
  }

  /// The pointer moved to `at`: what is under it is hovered; a held slider follows it, and a
  /// held field's selection reaches it.
  let pointer_moved<e> = (self: mut, laid: Laid<e>, at: Point) -> []e => {
    self.pointer = at
    // The deepest element under the pointer; those around it are hovered too (`with_state`).
    let path = hit(laid, at)
    self.state.hover = if path.len() > 0 { path[path.len() - 1].laid.id } else { "" }
    // A thumb under the pointer is hovered itself.
    for i in (path.len() - 1)..>=0 {
      let Some(sc) = path[i].laid.scroller else { continue }
      for bar in sc.bars(path[i].laid.size) {
        if moved_by(bar.thumb, path[i].origin).contains(at) {
          self.state.hover = thumb_id(path[i].laid.id, bar.axis)
        }
      }
      break
    }
    self.menu_hover(laid, at)
    if self.state.pressed.contains("#thumb-") {
      self.drag_thumb(laid, at)
      return []
    }
    if self.state.pressed.len() == 0 { return [] }
    let Some(held) = find(laid, self.state.pressed, Point {}) else { return [] }
    match held.laid.kind {
      Ranged(spec) => slide_to(held, spec, at),
      Tabbed(spot) => tab_dragged(laid, held, spot, at),
      ColorAxis(spec) => self.axis_moved(held, spec, at),
      Editable(_) => {
        // A drag extends what the press picked by the same unit: a rune, a word, or (after a
        // triple click) nothing more than the whole.
        let p = self.picking
        let (anchor, caret) = if p.clicks >= 3 { (p.from, p.to) } else if p.clicks == 2 {
          let (from, to) = self.editing(held).word_around(rune_under_x(held, at))
          if from < p.from { (p.to, from) } else { (p.from, to.max(p.to)) }
        } else {
          (self.widget(held.laid.id).anchor, rune_at_x(held, at))
        }
        let state = self.widget(held.laid.id)
        self.state.widgets.insert(
          held.laid.id,
          WidgetState { state | caret: caret, anchor: anchor }
        )
        []
      },
      _ => [],
    }
  }

  /// The primary button went down at `at`: the control under it is held and takes the
  /// focus (a click elsewhere takes the focus from whatever had it); a slider jumps to the
  /// pointer, and a field's caret goes where it was clicked.
  let pointer_down<e> = (self: mut, laid: Laid<e>, at: Point, clicks: i64) -> []e => {
    self.pointer = at
    if self.bar_press(laid, at) { return [] }
    // One of the window's own buttons, which is no control of the program's: held, as a
    // button is, until let go.
    if let Some(button) = window_control_at(laid, at) {
      self.state.pressed = button.laid.id
      return []
    }
    if let Some(events) = self.menu_press(laid, at) { return events }
    // An open select's list takes a press on one of its options; any other press closes it —
    // on the select itself, only that.
    let open = self.state.open
    if open.len() > 0 {
      self.state.open = ""
      if let Some(on) = control_at(laid, at) {
        if option_of(open, on.laid.id).is_some() {
          self.state.open = open
          self.state.pressed = on.laid.id
          return []
        }
        if on.laid.id == open { return [] }
      }
    }
    let Some(target) = control_at(laid, at) else {
      self.state.focus = ""
      self.state.pressed = ""
      return []
    }
    // A tab's ×: the tab closes, the press and the focus left where they were.
    if let Tabbed(spot) = target.laid.kind {
      if on_tab_close(laid, target, at) { return [(spot.on_close)(spot.index)] }
    }
    self.state.pressed = target.laid.id
    self.state.focus = target.laid.id
    self.state.keyboard_focus = false
    match target.laid.kind {
      Ranged(spec) => slide_to(target, spec, at),
      Tabbed(spot) => tab_pressed(spot),
      ColorAxis(spec) => self.axis_moved(target, spec, at),
      Choosing(spec) => {
        self.open_select(target.laid.id, spec)
        []
      },
      Editable(_) => {
        // A click puts the caret there; a double click selects the word under the pointer
        // (or the run of spaces), a triple the whole text — as every platform's fields do.
        let ed = self.editing(target)
        let (from, to) = if clicks >= 3 { (0, ed.runes.len()) } else if clicks == 2 {
          ed.word_around(rune_under_x(target, at))
        } else {
          let caret = rune_at_x(target, at)
          (caret, caret)
        }
        self.picking = Picking { clicks: clicks.clamp(1, 3), from: from, to: to }
        let state = self.widget(target.laid.id)
        self.state.widgets.insert(
          target.laid.id,
          WidgetState { state | caret: to, anchor: from }
        )
        []
      },
      _ => [],
    }
  }

  /// The primary button came up at `at`: a button or checkbox held and still under the
  /// pointer is pressed.
  let pointer_up<e> = (self: mut, laid: Laid<e>, at: Point) -> []e => {
    self.pointer = at
    let held = self.state.pressed
    self.state.pressed = ""
    if let Some(button) = window_control_at(laid, at) {
      if button.laid.id == held {
        if let WindowControl(b) = button.laid.kind { self.window_asked.push(b) }
      }
      return []
    }
    let Some(target) = control_at(laid, at) else { return [] }
    if target.laid.id != held { return [] }
    if self.state.open.len() > 0 && option_of(self.state.open, held).is_some() {
      return self.choose_option(target.laid)
    }
    let events = activated(target.laid)
    if self.menu_level(held) >= 0 { self.menu_chosen() }
    events
  }

  /// The select identified as `id` opened, the option under the keys its chosen one.
  let open_select<e> = (self: mut, id: string, spec: SelectSpec<e>) -> void => {
    self.state.open = id
    self.state.hover = option_id(id, spec.selected.max(0))
    self.reveal_wanted = self.state.hover
  }

  /// An option of the open list chosen: the list closed, the focus back on its select, and
  /// the select's event — none when it was the chosen option already, as HTML's `change`.
  let choose_option<e> = (self: mut, option: Laid<e>) -> []e => {
    let open = self.state.open
    self.state.open = ""
    self.state.focus = open
    match option.kind {
      Checkable(false, event) => [event],
      _ => [],
    }
  }

  /// A key for the focused select identified as `id`. Closed, Space, Enter or Alt-Down opens
  /// it, and Up, Down, Home and End choose another option outright; open, they move the
  /// option under the keys (the list's `:hover`), and Space or Enter chooses it.
  let select_key<e> = (
    self: mut,
    id: string,
    spec: SelectSpec<e>,
    key: Key,
    mods: Modifiers
  ) -> []e => {
    let last = spec.options.len() - 1
    if last < 0 { return [] }
    let chooses = key == Enter || key == Character(' ')
    let from = if self.state.open == id {
      option_of(id, self.state.hover) ?? spec.selected.max(0)
    } else {
      spec.selected
    }
    if self.state.open != id && (chooses || (mods.alt && key == ArrowDown)) {
      self.open_select(id, spec)
      return []
    }
    if self.state.open == id && chooses {
      self.state.open = ""
      return if from == spec.selected { [] } else { [(spec.on_change)(from)] }
    }
    let stepped = match key {
      ArrowUp => from - 1,
      ArrowDown => from + 1,
      Home => 0,
      End => last,
      _ => from,
    }
    let to = stepped.clamp(0, last)
    if self.state.open == id {
      self.state.hover = option_id(id, to)
      self.reveal_wanted = self.state.hover
      return []
    }
    if to == spec.selected { [] } else { [(spec.on_change)(to)] }
  }

  /// A wheel or trackpad scrolled by `across` and `down` lines: the innermost scroll under the
  /// pointer moves along its axis, never past its content's ends.
  /// A wheel turned (or a trackpad swiped) `across` and `down` lines with the pointer where it
  /// is: each axis scrolls the innermost element under the pointer that the user may scroll
  /// that way and that can still move that way, and passes to the one around it when it
  /// cannot — as a browser does.
  let scrolled<e> = (self: mut, laid: Laid<e>, across: f32, down: f32) -> void => {
    let path = hit(laid, self.pointer)
    // A tab strip, which shows no bar, scrolls across by the wheel either way: a mouse's wheel
    // only turns down.
    for f in path {
      if let TabStrip = f.laid.kind {
        if let Some(sc) = f.laid.scroller {
          let _ = self.scroll_by(f.laid.id, sc, Horizontal, (across + down) * SCROLL_LINE)
          return
        }
      }
    }
    let moves: [](Axis, f32) = [(Horizontal, across), (Vertical, down)]
    for (axis, by) in moves {
      if by.abs() < 0.0001 { continue }
      for i in (path.len() - 1)..>=0 {
        let f = path[i]
        let Some(sc) = f.laid.scroller else { continue }
        let o = if axis == Horizontal { sc.x } else { sc.y }
        if !user_scrolls(o) { continue }
        if self.scroll_by(f.laid.id, sc, axis, by * SCROLL_LINE) { break }
      }
    }
  }

  /// The element identified as `id`, scrolling as `sc` does, moved `by` along `axis` within
  /// its room; whether it moved.
  pub let scroll_by = (
    self: mut,
    id: string,
    sc: Scroller,
    axis: Axis,
    by: f32
  ) -> bool => {
    let spare = sc.room()
    let now = if axis == Horizontal { sc.offset.x } else { sc.offset.y }
    let next = (now + by).clamp(0.0, if axis == Horizontal { spare.w } else { spare.h })
    if (next - now).abs() < 0.001 { return false }
    let state = self.widget(id)
    self.state.widgets.insert(id, if axis == Horizontal {
      WidgetState { state | scroll_x: Some(next) }
    } else {
      // Scrolled to its end, a following scroller follows again; off it, it stays put.
      WidgetState { state | scroll: Some(next), following: next >= spare.h - 0.5 }
    })
    true
  }

  /// A press on a scrollbar of an element under `at`: on its thumb, taken hold of for a drag;
  /// on its track, the content paged towards the press. Whether a scrollbar took it.
  let bar_press<e> = (self: mut, laid: Laid<e>, at: Point) -> bool => {
    let path = hit(laid, at)
    for i in (path.len() - 1)..>=0 {
      let f = path[i]
      let Some(sc) = f.laid.scroller else { continue }
      for bar in sc.bars(f.laid.size) {
        let track = moved_by(bar.track, f.origin)
        if !track.contains(at) { continue }
        let thumb = moved_by(bar.thumb, f.origin)
        let along = if bar.axis == Horizontal { at.x - thumb.x } else { at.y - thumb.y }
        if thumb.contains(at) {
          let state = self.widget(f.laid.id)
          self.state.widgets.insert(f.laid.id, WidgetState { state | grab: along })
          self.state.pressed = thumb_id(f.laid.id, bar.axis)
        } else {
          let page = if bar.axis == Horizontal { sc.port.w } else { sc.port.h }
          let step = (page - SCROLL_LINE).max(SCROLL_LINE)
          let _ = self.scroll_by(
            f.laid.id,
            sc,
            bar.axis,
            if along < 0.0 { -step } else { step }
          )
        }
        return true
      }
    }
    false
  }

  /// A held thumb dragged to `at`: its scroller's offset where the thumb's grabbed point
  /// follows the pointer.
  let drag_thumb<e> = (self: mut, laid: Laid<e>, at: Point) -> void => {
    let held = self.state.pressed
    let axis = if held.ends_with("#thumb-x") { Horizontal } else { Vertical }
    let Some(f) = find(laid, element_of(held), Point {}) else { return }
    let Some(sc) = f.laid.scroller else { return }
    for bar in sc.bars(f.laid.size) {
      if bar.axis != axis { continue }
      let grab = self.widget(f.laid.id).grab
      let spare = sc.room()
      let (pointer, start, travel, space) = if axis == Horizontal {
        (at.x - f.origin.x, bar.track.x, bar.track.w - bar.thumb.w, spare.w)
      } else {
        (at.y - f.origin.y, bar.track.y, bar.track.h - bar.thumb.h, spare.h)
      }
      if travel <= 0.0 { return }
      let wanted = (pointer - grab - start) / travel * space
      let now = if axis == Horizontal { sc.offset.x } else { sc.offset.y }
      let _ = self.scroll_by(f.laid.id, sc, axis, wanted - now)
    }
  }

  /// A scrolling key — the arrows, Page Up and Down, Home and End — for the element the focus
  /// is in, or else the one under the pointer: the innermost the user may scroll; whether one
  /// took it.
  let scroll_key<e> = (self: mut, laid: Laid<e>, key: Key) -> bool => {
    let chain = if self.state.focus.len() > 0 { along_path(
      laid,
      self.state.focus
    ) } else { hit(laid, self.pointer) }
    for i in (chain.len() - 1)..>=0 {
      let f = chain[i]
      let Some(sc) = f.laid.scroller else { continue }
      let spare = sc.room()
      let page = (sc.port.h - SCROLL_LINE).max(SCROLL_LINE)
      let (axis, by): (Axis, f32) = match key {
        ArrowDown => (Vertical, SCROLL_LINE),
        ArrowUp => (Vertical, -SCROLL_LINE),
        ArrowRight => (Horizontal, SCROLL_LINE),
        ArrowLeft => (Horizontal, -SCROLL_LINE),
        PageDown => (Vertical, page),
        PageUp => (Vertical, -page),
        Home => (Vertical, -sc.offset.y),
        End => (Vertical, spare.h - sc.offset.y),
        _ => return false,
      }
      let o = if axis == Horizontal { sc.x } else { sc.y }
      if !user_scrolls(o) { continue }
      if self.scroll_by(f.laid.id, sc, axis, by) { return true }
    }
    false
  }

  /// Every element round the one identified as `id` scrolled so that it is in view.
  let reveal<e> = (self: mut, laid: Laid<e>, id: string) -> void => {
    let chain = along_path(laid, id)
    if chain.len() == 0 { return }
    let target = chain[chain.len() - 1]
    let box = Rect {
      x: target.origin.x,
      y: target.origin.y,
      w: target.laid.size.w,
      h: target.laid.size.h
    }
    for i in 0..<(chain.len() - 1) {
      let f = chain[i]
      let Some(sc) = f.laid.scroller else { continue }
      let port = moved_by(sc.port, f.origin)
      let dy = if box.y < port.y { box.y - port.y } else if box.y + box.h > port.y + port.h {
        (box.y + box.h - (port.y + port.h)).min(box.y - port.y)
      } else { 0.0 }
      let dx = if box.x < port.x { box.x - port.x } else if box.x + box.w > port.x + port.w {
        (box.x + box.w - (port.x + port.w)).min(box.x - port.x)
      } else { 0.0 }
      if dy.abs() > 0.001 && sc.y != OverflowClip { let _ = self.scroll_by(
        f.laid.id,
        sc,
        Vertical,
        dy
      ) }
      if dx.abs() > 0.001 && sc.x != OverflowClip { let _ = self.scroll_by(
        f.laid.id,
        sc,
        Horizontal,
        dx
      ) }
    }
  }

  /// A key went down: Tab moves the focus, and the rest is for the focused control.
  let key_pressed<e, p> where p: Platform = (
    self: mut,
    laid: Laid<e>,
    key: Key,
    mods: Modifiers,
    platform: mut p
  ) -> []e => {
    if self.state.menus.len() > 0 {
      if let Some(events) = self.menu_key(laid, key, mods.shift) { return events }
    }
    // An open select's list: Escape closes it, and Tab closes it and moves on.
    if self.state.open.len() > 0 && (key == Escape || key == Tab) {
      self.state.open = ""
      if key == Escape { return [] }
    }
    if key == Tab {
      self.move_focus(laid, mods.shift)
      self.reveal(laid, self.state.focus)
      return []
    }
    // A scrolling key scrolls unless the focused control takes it (a slider, a field).
    let takes_keys = match find(laid, self.state.focus, Point {}) {
      Some(f) => match f.laid.kind {
        Ranged(_) => true,
        Editable(_) => true,
        Choosing(_) => true,
        Opens(_) => true,
        Tabbed(_) => true,
        ColorAxis(_) => true,
        _ => false,
      },
      None => false,
    }
    if !takes_keys && self.scroll_key(laid, key) { return [] }
    let Some(focused) = find(laid, self.state.focus, Point {}) else { return [] }
    match focused.laid.kind {
      Pressable(_) =>
        if key == Enter || key == Character(' ') { activated(focused.laid) } else { [] },
      Checkable(_, _) =>
        if key == Enter || key == Character(' ') { activated(focused.laid) } else { [] },
      Ranged(spec) => step_slider(spec, key),
      Editable(_) => self.field_key(focused, key, mods, platform),
      Choosing(spec) => self.select_key(focused.laid.id, spec, key, mods),
      Tabbed(spot) => self.tab_key(laid, focused, spot, key),
      ColorAxis(spec) => self.axis_key(focused, spec, key),
      // A focused opener: Enter, Space or Down opens its menu, the focus to its first item.
      Opens(_) => {
        if key == Enter || key == Character(' ') || key == ArrowDown {
          self.open_menu(focused.laid.id)
          self.menu_first = true
        }
        []
      },
      _ => [],
    }
  }

  /// The focus to the next control in the tree's order, or the previous with `backwards`,
  /// wrapping at the ends. A text field it reaches has its text selected.
  let move_focus<e> = (self: mut, laid: Laid<e>, backwards: bool) -> void => {
    var order: []string = []
    focus_order(laid, order)
    if order.len() == 0 { return }
    var at = -1
    for i, id in order {
      if id == self.state.focus { at = i }
    }
    let next = if at < 0 {
      if backwards { order.len() - 1 } else { 0 }
    } else if backwards {
      (at - 1 + order.len()) % order.len()
    } else {
      (at + 1) % order.len()
    }
    self.state.focus = order[next]
    self.state.keyboard_focus = true
    if let Some(found) = find(laid, order[next], Point {}) {
      if let Editable(spec) = found.laid.kind {
        let state = self.widget(found.laid.id)
        let end = spec.value.len()
        self.state.widgets.insert(
          found.laid.id,
          WidgetState { state | caret: end, anchor: 0 }
        )
      }
    }
  }

  /// A key for the focused text field.
  let field_key<e, p> where p: Platform = (
    self: mut,
    field: Found<e>,
    key: Key,
    mods: Modifiers,
    platform: mut p
  ) -> []e => {
    let by_word = mods.alt || (mods.control && !mods.command)
    let shift = mods.shift
    if mods.primary {
      match key {
        Character('a') => return self.edit(field, (ed) => ed.select_all()),
        Character('c') => {
          let ed = self.editing(field)
          if ed.selected().len() > 0 { platform.set_clipboard(ed.selected()) }
          return []
        },
        Character('x') => {
          let ed = self.editing(field)
          if ed.selected().len() == 0 { return [] }
          platform.set_clipboard(ed.selected())
          return self.edit(field, (e2) => e2.insert(""))
        },
        Character('v') => {
          let pasted = platform.clipboard().replace("\n", " ")
          return self.edit(field, (ed) => ed.insert(pasted))
        },
        Character('z') => return self.undo(field),
        _ => {},
      }
    }
    match key {
      ArrowLeft => self.edit(field, (ed) => {
        let to = if mods.command {
          0
        } else if by_word {
          ed.word_before()
        } else if shift {
          ed.caret - 1
        } else {
          ed.left()
        }
        ed.move_to(to, shift)
      }),
      ArrowRight => self.edit(field, (ed) => {
        let to = if mods.command {
          ed.runes.len()
        } else if by_word {
          ed.word_after()
        } else if shift {
          ed.caret + 1
        } else {
          ed.right()
        }
        ed.move_to(to, shift)
      }),
      Home => self.edit(field, (ed) => ed.move_to(0, shift)),
      End => self.edit(field, (ed) => ed.move_to(ed.runes.len(), shift)),
      Backspace => self.edit(field, (ed) => ed.erase_back(by_word)),
      Delete => self.edit(field, (ed) => ed.erase_forward(by_word)),
      _ => [],
    }
  }

  /// `change` applied to the focused field's text, caret and selection: the caret kept, and
  /// if the text changed, the edit remembered for undo and the field's event raised with it.
  let edit<e> = (self: mut, field: Found<e>, change: (Editing) -> Editing) -> []e => {
    let Editable(spec) = field.laid.kind else { return [] }
    let before = self.editing(field)
    let after = change(before)
    let state = self.widget(field.laid.id)
    let result = after.text()
    if result == spec.value {
      self.state.widgets.insert(
        field.laid.id,
        WidgetState { state | caret: after.caret, anchor: after.anchor }
      )
      return []
    }
    // A read-only field moves its caret and selection, and changes nothing.
    if spec.read_only { return [] }
    // What is typed is kept, whatever the program makes of it, while the field has the focus.
    if spec.draft { self.state.drafts.insert(field.laid.id, result) }
    let history = [...state.undo, Edit { value: spec.value, caret: before.caret }]
    self.state.widgets.insert(field.laid.id, WidgetState {
      state |
      caret: after.caret,
      anchor: after.anchor,
      undo: history,
    })
    [(spec.on_edit)(result)]
  }

  /// The focused field's last edit undone: its text as it was, the caret where it was.
  let undo<e> = (self: mut, field: Found<e>) -> []e => {
    let Editable(spec) = field.laid.kind else { return [] }
    let state = self.widget(field.laid.id)
    if state.undo.len() == 0 || spec.read_only { return [] }
    let last = state.undo[state.undo.len() - 1]
    self.state.widgets.insert(field.laid.id, WidgetState {
      state |
      caret: last.caret,
      anchor: last.caret,
      undo: state.undo.slice(0, state.undo.len() - 1),
    })
    [(spec.on_edit)(last.value)]
  }

  /// The focused field, if a field has the focus.
  let focused_field<e> = pure (self, laid: Laid<e>) -> Maybe<Found<e>> => {
    let Some(f) = find(laid, self.state.focus, Point {}) else { return None }
    if f.laid.field.is_some() { Some(f) } else { None }
  }

  /// A field's text, caret and selection as an [Editing], the caret kept inside the text.
  let editing<e> = pure (self, field: Found<e>) -> Editing => {
    let Editable(spec) = field.laid.kind else { return Editing { runes: [] } }
    let state = self.widget(field.laid.id)
    let runes = spec.value.to_runes()
    Editing {
      runes: runes,
      caret: state.caret.clamp(0, runes.len()),
      anchor: state.anchor.clamp(0, runes.len()),
    }
  }

  /// What the framework holds for the element identified as `id`, or nothing yet.
  let widget = pure (self, id: string) -> WidgetState =>
    self.state.widgets.get(id) ?? WidgetState {}
}

/// A text field's text being edited: its runes, the caret and the other end of the selection
/// (`anchor`, the caret itself when nothing is selected), both before rune indices.
pub struct Editing {
  runes: []rune,
  caret: i64 = 0,
  anchor: i64 = 0,
}

impl Editing {
  /// The text.
  pub let text = pure (self) -> string => self.runes.join()

  /// The selected text, `""` for none.
  pub let selected = pure (self) -> string =>
    self.runes.slice(self.caret.min(self.anchor), self.caret.max(self.anchor)).join()

  /// `typed` in place of the selection (or at the caret), the caret after it.
  pub let insert = pure (self, typed: string) -> Editing => {
    let from = self.caret.min(self.anchor)
    let to = self.caret.max(self.anchor)
    let added = typed.to_runes()
    let runes = [
      ...self.runes.slice(0, from),
      ...added,
      ...self.runes.slice(to, self.runes.len())
    ]
    Editing { runes: runes, caret: from + added.len(), anchor: from + added.len() }
  }

  /// Everything selected, the caret at the end.
  pub let select_all = pure (self) -> Editing =>
    Editing { self | caret: self.runes.len(), anchor: 0 }

  /// The caret moved to `to`; the selection extended to it with `extend`, else gone.
  pub let move_to = pure (self, to: i64, extend: bool) -> Editing => {
    let at = to.clamp(0, self.runes.len())
    Editing { self | caret: at, anchor: if extend { self.anchor } else { at } }
  }

  /// Where Left takes the caret: to the selection's start if there is one, else a rune back.
  /// (Shift-Left moves the caret itself a rune, extending the selection.)
  pub let left = pure (self) -> i64 =>
    if self.caret != self.anchor { self.caret.min(self.anchor) } else { (self.caret - 1).max(0) }

  /// Where Right takes the caret: to the selection's end, else a rune on.
  pub let right = pure (self) -> i64 =>
    if self.caret != self.anchor {
      self.caret.max(self.anchor)
    } else {
      (self.caret + 1).min(self.runes.len())
    }

  /// The start of the word before the caret: back over spaces, then over the word.
  pub let word_before = pure (self) -> i64 => {
    var at = self.caret
    while at > 0 && is_space(self.runes[at - 1]) { at -= 1 }
    while at > 0 && !is_space(self.runes[at - 1]) { at -= 1 }
    at
  }

  /// The end of the word after the caret: on over spaces, then over the word.
  pub let word_after = pure (self) -> i64 => {
    var at = self.caret
    while at < self.runes.len() && is_space(self.runes[at]) { at += 1 }
    while at < self.runes.len() && !is_space(self.runes[at]) { at += 1 }
    at
  }

  /// The run of runes of one kind holding the rune at `at` — a word of letters and digits, a
  /// run of punctuation or one of spaces ([rune_kind]) — as the runes `from` to `to`: what a
  /// double click selects, so `34` in `12.34`. Past the end, the last rune's.
  pub let word_around = pure (self, at: i64) -> (i64, i64) => {
    if self.runes.len() == 0 { return (0, 0) }
    let i = at.clamp(0, self.runes.len() - 1)
    let kind = rune_kind(self.runes[i])
    var from = i
    while from > 0 && rune_kind(self.runes[from - 1]) == kind { from -= 1 }
    var to = i + 1
    while to < self.runes.len() && rune_kind(self.runes[to]) == kind { to += 1 }
    (from, to)
  }

  /// Backspace: the selection deleted, else the rune — or with `by_word` the word — before the
  /// caret.
  pub let erase_back = pure (self, by_word: bool) -> Editing => {
    if self.caret != self.anchor { return self.insert("") }
    let from = if by_word { self.word_before() } else { (self.caret - 1).max(0) }
    Editing { self | anchor: from }.insert("")
  }

  /// Delete: the selection deleted, else the rune — or the word — after the caret.
  pub let erase_forward = pure (self, by_word: bool) -> Editing => {
    if self.caret != self.anchor { return self.insert("") }
    let to = if by_word { self.word_after() } else { (self.caret + 1).min(self.runes.len()) }
    Editing { self | anchor: to }.insert("")
  }
}

/// Whether `c` separates words: a space or a tab.
let is_space = pure (c: rune) -> bool => c == ' ' || c == '\t'

/// What a double click takes `c` with: 0 a space or tab, 1 a word's — a letter, a digit, `_`,
/// or any rune past ASCII (`é`, so `café` is one word) — and 2 punctuation and the rest.
let rune_kind = pure (c: rune) -> i64 =>
  if is_space(c) { 0 } else if c.is_ascii_alpha() || c.is_ascii_digit() || c == '_' || i64(c) > 127 {
    1
  } else {
    2
  }

// ── Finding elements ─────────────────────────────────────────────────────────

/// The elements under `at`, outermost first: each one whose box holds it, through children
/// placed at their offsets, but nothing outside an element that clips.
pub let hit<e> = pure (laid: Laid<e>, at: Point) -> []Found<e> => {
  // What floats (an open select's list) is over everything, so it is hit first: the path to
  // it, then what is under the pointer in it.
  let floating = floating_in(laid, Point {})
  for i in (floating.len() - 1)..>=0 {
    let f = floating[i]
    let area = Rect { x: f.origin.x, y: f.origin.y, w: f.laid.size.w, h: f.laid.size.h }
    if area.contains(at) {
      let to = along_path(laid, f.laid.id)
      var path = to.slice(0, to.len() - 1)
      hit_into(f.laid, f.origin, at, path)
      return path
    }
  }
  var path: []Found<e> = []
  hit_into(laid, Point {}, at, path)
  path
}

/// The floating elements in `laid` (its top-left corner at `origin`), each where it is, in
/// the order they are drawn.
let floating_in<e> = pure (laid: Laid<e>, origin: Point) -> []Found<e> => {
  var out: []Found<e> = []
  for child in laid.children {
    let corner = Point { x: origin.x + child.at.x, y: origin.y + child.at.y }
    if child.laid.floats { out.push(Found { laid: child.laid, origin: corner }) }
    out = [...out, ...floating_in(child.laid, corner)]
  }
  out
}

let hit_into<e> = (
  laid: Laid<e>,
  origin: Point,
  at: Point,
  path: mut []Found<e>
) -> void => {
  let inside = Rect {
    x: origin.x,
    y: origin.y,
    w: laid.size.w,
    h: laid.size.h
  }.contains(at)
  if !inside && laid.clips { return }
  if inside { path.push(Found { laid: laid, origin: origin }) }
  // The last child drawn is the one on top, so the deepest path through the latest child wins.
  for i in (laid.children.len() - 1)..>=0 {
    let child = laid.children[i]
    // Floating elements are hit first, by `hit`.
    if child.laid.floats { continue }
    let corner = Point { x: origin.x + child.at.x, y: origin.y + child.at.y }
    let before = path.len()
    hit_into(child.laid, corner, at, path)
    if path.len() > before { return }
  }
}

/// The control the pointer at `at` is over: the deepest on the path to it.
pub let control_at<e> = pure (laid: Laid<e>, at: Point) -> Maybe<Found<e>> => {
  let path = hit(laid, at)
  for i in (path.len() - 1)..>=0 {
    // A disabled control is under the pointer, but takes nothing from it.
    if focusable(path[i].laid.kind) { return if path[i].laid.disabled { None } else { Some(path[i]) } }
  }
  None
}

/// The element identified as `id` in `laid` (whose top-left corner is at `origin`), and
/// where it is.
pub let find<e> = pure (laid: Laid<e>, id: string, origin: Point) -> Maybe<Found<e>> => {
  if id.len() == 0 { return None }
  if laid.id == id { return Some(Found { laid: laid, origin: origin }) }
  // An identity names its ancestors, so only the child it continues is searched.
  if !id.starts_with(laid.id) { return None }
  for child in laid.children {
    let corner = Point { x: origin.x + child.at.x, y: origin.y + child.at.y }
    if let Some(found) = find(child.laid, id, corner) { return Some(found) }
  }
  None
}

/// The elements from `laid`'s root to the one identified as `id`, each where it is.
pub let along_path<e> = pure (laid: Laid<e>, id: string) -> []Found<e> => {
  var out: []Found<e> = []
  var at = Found { laid: laid, origin: Point {} }
  if id.len() == 0 { return out }
  loop {
    out.push(at)
    if at.laid.id == id { return out }
    var next: Maybe<Found<e>> = None
    for child in at.laid.children {
      if id == child.laid.id || id.starts_with("${child.laid.id}/") {
        next = Some(Found {
          laid: child.laid,
          origin: Point { x: at.origin.x + child.at.x, y: at.origin.y + child.at.y }
        })
      }
    }
    let Some(n) = next else { return [] }
    at = n
  }
  out
}

/// A popup open in a laid-out tree: its identity, its anchor's and its content's, the event
/// dismissing it, and where in the window its anchor is and its content — with what floats
/// from that, a submenu's popup — covers. (`pub` only because a private generic struct as
/// another module's type argument does not lay out yet, todo.md.)
pub struct Opened<e> {
  id: string,
  anchor: string,
  content: string,
  dismissed: e,
  anchor_box: Rect,
  areas: []Rect,
}

/// The popups open in `laid`, each before those opened from inside it.
let open_popups<e> = pure (laid: Laid<e>) -> []Opened<e> => {
  var out: []Opened<e> = []
  gather_popups(laid, Point {}, out)
  out
}

/// [open_popups] below `laid`, whose top-left corner is at `origin`: only what floats, or
/// holds what does, is looked in — an open popup's content floats.
let gather_popups<e> = (laid: Laid<e>, origin: Point, out: mut []Opened<e>) -> void => {
  if let PopsUp(true, _, dismissed) = laid.kind {
    if laid.children.len() > 1 {
      let content = laid.children[1]
      var areas: []Rect = []
      covered(
        content.laid,
        Point { x: origin.x + content.at.x, y: origin.y + content.at.y },
        true,
        areas
      )
      out.push(Opened {
        id: laid.id,
        anchor: laid.children[0].laid.id,
        content: content.laid.id,
        dismissed: dismissed,
        anchor_box: Rect { x: origin.x, y: origin.y, w: laid.size.w, h: laid.size.h },
        areas: areas,
      })
    }
  }
  for child in laid.children {
    if child.laid.floats || child.laid.floating {
      gather_popups(
        child.laid,
        Point { x: origin.x + child.at.x, y: origin.y + child.at.y },
        out
      )
    }
  }
}

/// The boxes in the window that `laid` (at `origin`) covers, its own if `own`, and those of
/// everything floating inside it.
let covered<e> = (laid: Laid<e>, origin: Point, own: bool, out: mut []Rect) -> void => {
  if own { out.push(Rect { x: origin.x, y: origin.y, w: laid.size.w, h: laid.size.h }) }
  for child in laid.children {
    if child.laid.floats || child.laid.floating {
      let corner = Point { x: origin.x + child.at.x, y: origin.y + child.at.y }
      covered(child.laid, corner, child.laid.floats, out)
    }
  }
}

/// The first control, in Tab's order, of the element identified as `id` in `laid`.
let first_control<e> = pure (laid: Laid<e>, id: string) -> Maybe<string> => {
  let Some(found) = find(laid, id, Point {}) else { return None }
  var order: []string = []
  focus_order(found.laid, order)
  if order.len() == 0 { None } else { Some(order[0]) }
}

/// A press on the tab `tab` (not its ×): its selection, unless it is selected already.
let tab_pressed<e> = (spot: TabSpot<e>) -> []e =>
  if spot.selected { [] } else { [(spot.on_select)(spot.index)] }

/// Whether `at` is on the × (`TabClose`) of the tab `tab`.
let on_tab_close<e> = pure (laid: Laid<e>, tab: Found<e>, at: Point) -> bool =>
  hit(laid, at).any((f) => f.laid.tag == "TabClose" && within_id(f.laid.id, tab.laid.id))

/// The pointer at `at` while the tab `tab` is held: past the middle of the movable tab after it
/// or before it, the tab moves to that one's place. The program moves it; the press stays on it,
/// its identity its key's.
let tab_dragged<e> = (
  laid: Laid<e>,
  tab: Found<e>,
  spot: TabSpot<e>,
  at: Point
) -> []e => {
  if !spot.movable { return [] }
  let tabs = strip_tabs(laid, tab.laid.id)
  let Some(me) = [t in tabs | t.laid.id].index_of(tab.laid.id) else { return [] }
  if me + 1 < tabs.len() {
    let next = tabs[me + 1]
    if let Some(other) = tab_spot(next.laid) {
      if other.movable && at.x > next.origin.x + next.laid.size.w / 2.0 {
        return [(spot.on_move)(spot.index, other.index)]
      }
    }
  }
  if me > 0 {
    let before = tabs[me - 1]
    if let Some(other) = tab_spot(before.laid) {
      if other.movable && at.x < before.origin.x + before.laid.size.w / 2.0 {
        return [(spot.on_move)(spot.index, other.index)]
      }
    }
  }
  []
}

/// A middle click at `at`: on a closable tab, its closing.
let middle_on_tab<e> = (laid: Laid<e>, at: Point) -> []e => {
  let path = hit(laid, at)
  var i = path.len() - 1
  while i >= 0 {
    if let Some(spot) = tab_spot(path[i].laid) {
      return if spot.closable { [(spot.on_close)(spot.index)] } else { [] }
    }
    i -= 1
  }
  []
}

/// The tabs of the strip holding the tab identified as `id`, in order, each where it is.
let strip_tabs<e> = pure (laid: Laid<e>, id: string) -> []Found<e> => {
  let Some(strip) = find(laid, parent_of(id), Point {}) else { return [] }
  var out: []Found<e> = []
  for child in strip.laid.children {
    if tab_spot(child.laid).is_some() {
      out.push(Found {
        laid: child.laid,
        origin: Point { x: strip.origin.x + child.at.x, y: strip.origin.y + child.at.y }
      })
    }
  }
  out
}

/// The window's own button under `at`, if one is.
let window_control_at<e> = pure (laid: Laid<e>, at: Point) -> Maybe<Found<e>> => {
  for f in hit(laid, at) {
    if let WindowControl(_) = f.laid.kind { return Some(f) }
  }
  None
}

/// What `laid` is as a tab, if it is one.
let tab_spot<e> = pure (laid: Laid<e>) -> Maybe<TabSpot<e>> => match laid.kind {
  Tabbed(spot) => Some(spot),
  _ => None,
}

/// The identities of the tabs selected in `laid`, each strip's.
let selected_tabs<e> = pure (laid: Laid<e>) -> []string => {
  var out: []string = []
  gather_selected(laid, out)
  out
}

let gather_selected<e> = (laid: Laid<e>, out: mut []string) -> void => {
  if let Tabbed(spot) = laid.kind {
    if spot.selected { out.push(laid.id) }
    return
  }
  for child in laid.children { gather_selected(child.laid, out) }
}

/// The identities of the items, in order, of the menu the opener identified as `opener` opens
/// — those that can be chosen — while it is open.
let menu_items<e> = pure (laid: Laid<e>, opener: string) -> []string => {
  let Some(list) = find(laid, "${opener}/:menu", Point {}) else { return [] }
  var out: []string = []
  for child in list.laid.children {
    if focusable(child.laid.kind) && !child.laid.disabled { out.push(child.laid.id) }
  }
  out
}

/// Whether the element identified as `id` in `laid` is a menu bar's title.
let bar_title<e> = pure (laid: Laid<e>, id: string) -> bool =>
  match find(laid, id, Point {}) {
    Some(f) => match f.laid.kind {
      Opens(spec) => spec.in_bar,
      _ => false,
    },
    None => false,
  }

/// The identity of the element holding the one identified as `id`.
let parent_of = pure (id: string) -> string => {
  let parts = id.split("/")
  parts.slice(0, parts.len() - 1).join("/")
}

/// Whether the identity `id` is `root`'s or one inside it.
let within_id = pure (id: string, root: string) -> bool =>
  id.len() > 0 && (id == root || id.starts_with("${root}/"))

/// The identity a scrollbar's thumb is held and hovered by: its scroller's and the axis.
let thumb_id = pure (id: string, axis: Axis) -> string =>
  if axis == Horizontal { "${id}#thumb-x" } else { "${id}#thumb-y" }

/// The element an identity names — a thumb's its scroller.
let element_of = pure (id: string) -> string => id.split("#thumb-")[0]

/// `r` moved by `by`.
let moved_by = pure (r: Rect, by: Point) -> Rect =>
  Rect { r | x: r.x + by.x, y: r.y + by.y }

/// The identities of the controls in `laid`, in the order Tab visits them: the tree's.
pub let focus_order<e> = (laid: Laid<e>, order: mut []string) -> void => {
  if focusable(laid.kind) && !laid.disabled { order.push(laid.id) }
  for child in laid.children { focus_order(child.laid, order) }
}

/// Every identity in `laid`.
let note_ids<e> = (laid: Laid<e>, present: mut HashMap<string, bool>) -> void => {
  present.insert(laid.id, true)
  for child in laid.children { note_ids(child.laid, present) }
}

/// Each text field's scroll in `laid` remembered in `ui`.
let keep_field_scrolls<e> = (laid: Laid<e>, ui: mut Ui) -> void => {
  if let Some(look) = laid.field {
    let state = ui.state.widgets.get(laid.id) ?? WidgetState {}
    if (state.field_scroll - look.scroll).abs() > 0.001 {
      ui.state.widgets.insert(laid.id, WidgetState { state | field_scroll: look.scroll })
    }
  }
  for child in laid.children { keep_field_scrolls(child.laid, ui) }
}

// ── Controls ─────────────────────────────────────────────────────────────────

/// The event a button or checkbox raises when it is pressed.
let activated<e> = pure (laid: Laid<e>) -> []e => match laid.kind {
  Pressable(event) => [event],
  Checkable(_, event) => [event],
  _ => [],
}

/// A slider's value for the pointer at `at`, on its step, and the event for it if it moved.
let slide_to<e> = (found: Found<e>, spec: SliderSpec<e>, at: Point) -> []e => {
  let pad = found.laid.style.padding
  let travel = found.laid.size.w - pad.horizontal() - SLIDER_THUMB
  let from = found.origin.x + pad.left + SLIDER_THUMB / 2.0
  let fraction: f32 = if travel <= 0.0 { 0.0 } else { ((at.x - from) / travel).clamp(
    0.0,
    1.0
  ) }
  changed(spec, spec.min + fraction * (spec.max - spec.min))
}

/// A slider moved from the keyboard: the arrows by a step (a hundredth of its range when it
/// has none), Page Up and Down by ten, Home and End to its ends.
let step_slider<e> = (spec: SliderSpec<e>, key: Key) -> []e => {
  let step = if spec.step > 0.0 { spec.step } else { (spec.max - spec.min) / 100.0 }
  match key {
    ArrowLeft => changed(spec, spec.value - step),
    ArrowDown => changed(spec, spec.value - step),
    ArrowRight => changed(spec, spec.value + step),
    ArrowUp => changed(spec, spec.value + step),
    PageDown => changed(spec, spec.value - step * 10.0),
    PageUp => changed(spec, spec.value + step * 10.0),
    Home => changed(spec, spec.min),
    End => changed(spec, spec.max),
    _ => [],
  }
}

/// `value` within the slider's range and on its step, and the event for it — none if it is
/// the value the slider has.
let changed<e> = (spec: SliderSpec<e>, value: f32) -> []e => {
  var v = value.clamp(spec.min, spec.max)
  if spec.step > 0.0 {
    v = (spec.min + f32(((v - spec.min) / spec.step).round()) * spec.step).clamp(
      spec.min,
      spec.max
    )
  }
  if (v - spec.value).abs() < 0.000001 { [] } else { [(spec.on_change)(v)] }
}

/// The rune index a click at `at` puts a field's caret before.
let rune_at_x<e> = pure (found: Found<e>, at: Point) -> i64 => {
  let Editable(spec) = found.laid.kind else { return 0 }
  let Prose(block) = found.laid.content else { return 0 }
  if spec.value.len() == 0 { return 0 }
  let x = at.x - found.origin.x - found.laid.content_at.x
  let offset = offset_at_x(block, x, spec.value.byte_len())
  // The byte offset back to a rune index: the runes before it.
  var index = 0
  while index < spec.value.len() && byte_at(spec.value, index) < offset { index += 1 }
  index
}

/// The rune under `at` in a text field, by index — not the gap nearest it, which [rune_at_x]
/// answers: a click on the right half of a word's last letter is on that letter, not on the
/// space after it.
let rune_under_x<e> = pure (found: Found<e>, at: Point) -> i64 => {
  let gap = rune_at_x(found, at)
  let Editable(spec) = found.laid.kind else { return 0 }
  let Prose(block) = found.laid.content else { return 0 }
  let x = at.x - found.origin.x - found.laid.content_at.x
  if gap > 0 && x < caret_x(block, byte_at(spec.value, gap)) { gap - 1 } else { gap }
}

/// The deepest element under `at` taking input raw, and where it is.
let raw_at<e> = pure (laid: Laid<e>, at: Point) -> Maybe<Found<e>> => {
  let path = hit(laid, at)
  for i in (path.len() - 1)..>=0 {
    if raw_of(path[i].laid).is_some() { return Some(path[i]) }
  }
  None
}

/// How `laid` takes input raw, if it does: a painter's [RawInput].
let raw_of<e> = pure (laid: Laid<e>) -> Maybe<RawInput<e>> => match laid.kind {
  Painted(painter) => painter.input,
  _ => None,
}

/// What `target`'s raw input answers for the pointer at `at` (in the window) doing `kind`.
let pointed<e, p> where p: Platform = (
  target: Found<e>,
  at: Point,
  kind: PointerKind,
  platform: p
) -> Maybe<e> => {
  let Some(raw) = raw_of(target.laid) else { return None }
  (raw.on_pointer)(PointerInput {
    at: Point { x: at.x - target.origin.x, y: at.y - target.origin.y },
    kind: kind,
    mods: platform.held(),
  })
}
