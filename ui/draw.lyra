module ui.draw
//! What an interface is drawn as: a **display list** — a flat run of [DrawOp]s in logical
//! units — and the geometry and colours the ops are made of.
//!
//! ```
//! import ui.draw.{ DrawOp, Fill, Border, Rect, rgb, radius }
//!
//! let card = pure (at: Rect) -> []DrawOp => [
//!   Fill(at, radius(8.0), rgb(0xFFFFFF)),
//!   Border(at, radius(8.0), 1.0, rgb(0xD0D0D0)),
//! ]
//! ```
//!
//! **The display list is the whole contract with a renderer** (`ui.backend`'s `Renderer`):
//! six ops and the textures they read. A renderer never sees widgets, styles or text — a
//! line of text arrives as [Glyphs], quads cut from a texture — so a new backend is those
//! six ops and nothing more.
//!
//! **Coordinates are logical units**, `x` across and `y` down from the window's top left.
//! The renderer multiplies by the window's scale once, so nothing here knows about pixels or
//! high-density displays.

// ── Geometry ─────────────────────────────────────────────────────────────────

/// A position, in logical units.
pub struct Point {
  x: f32 = 0.0,
  y: f32 = 0.0,
}

/// A width and a height, in logical units.
pub struct Size {
  w: f32 = 0.0,
  h: f32 = 0.0,
}

/// The size held within `least` and `most`, each side a limit only where it is more than
/// nothing — a window's, between `App.min_size` and `App.max_size`.
pub let held = pure (self: Size, least: Size, most: Size) -> Size => Size {
  w: held_side(self.w, least.w, most.w),
  h: held_side(self.h, least.h, most.h),
}

/// An axis-aligned rectangle: its top-left corner and its size. A rectangle with no width or
/// no height is empty, and draws nothing.
pub struct Rect {
  x: f32 = 0.0,
  y: f32 = 0.0,
  w: f32 = 0.0,
  h: f32 = 0.0,
}

/// The radius of each corner of a rounded rectangle, clockwise from the top left. `0.0` is
/// a square corner.
pub struct Radii {
  top_left: f32 = 0.0,
  top_right: f32 = 0.0,
  bottom_right: f32 = 0.0,
  bottom_left: f32 = 0.0,
}

/// Every corner rounded by `r`.
pub let radius = pure (r: f32) -> Radii =>
  Radii { top_left: r, top_right: r, bottom_right: r, bottom_left: r }

// ── Colour ───────────────────────────────────────────────────────────────────

/// A colour: red, green and blue, and `a` its opacity — `255` opaque, `0` invisible.
/// Alpha is not premultiplied.
pub struct Color {
  r: u8,
  g: u8,
  b: u8,
  a: u8 = 255,
}

/// An opaque colour written as CSS writes it, `0xRRGGBB`.
pub let rgb = pure (hex: u32) -> Color =>
  Color { r: u8((hex >> 16) & 0xFF), g: u8((hex >> 8) & 0xFF), b: u8(hex & 0xFF) }

/// A colour and its opacity, `0xRRGGBBAA`.
pub let rgba = pure (hex: u32) -> Color => Color {
  r: u8((hex >> 24) & 0xFF),
  g: u8((hex >> 16) & 0xFF),
  b: u8((hex >> 8) & 0xFF),
  a: u8(hex & 0xFF),
}

// ── Images and textures ──────────────────────────────────────────────────────

/// Pixels a program holds: `width` × `height`, row by row, `0xAARRGGBB` each — what a
/// renderer uploads as a texture, and what [Glyphs] and [Picture] draw from once it has.
///
/// `pixelated` is CSS's `image-rendering: pixelated`: drawn larger, each texel stays a crisp
/// square instead of blending into its neighbours — what pixel art wants, and a photo or a
/// glyph does not. A renderer reads it once, at `upload`.
pub struct Image {
  width: i64,
  height: i64,
  argb: []u32,
  pixelated: bool = false,
}

/// A picture a program names: its pixels, by a `key` that is its own, as of `revision`. The
/// host keeps one texture a key and writes it again only when the revision moves — a program
/// that changes the pixels moves it — so a view can name the same picture every frame for
/// nothing (`ui.layout`'s `picture` and `PaintPicture`, `ui.text`'s [GlyphAtlas]).
pub struct PictureSource {
  key: string,
  image: Image,
  revision: i64 = 0,
}

/// A texture a renderer holds, named by the number its `upload` answered.
pub type TextureId = i64

/// One glyph of a line of text: the rectangle it covers, in logical units, and the part of
/// its texture it shows, in texels.
pub struct GlyphQuad {
  at: Rect,
  texels: Rect,
}

// ── The display list ─────────────────────────────────────────────────────────

/// One thing to draw. A display list is drawn in order, each op over what came before.
pub data DrawOp =
  /// A rectangle filled with a colour, its corners rounded.
  Fill(Rect, Radii, Color)
  /// A rectangle's outline: a band this many units wide inside its edge, following its
  /// rounded corners.
  | Border(Rect, Radii, f32, Color)
  /// A line of text: quads cut from a texture of glyphs, each texel's alpha the glyph's
  /// coverage, drawn in the colour.
  | Glyphs(TextureId, []GlyphQuad, Color)
  /// The `texels` part of a texture (the second rectangle) drawn into `at` (the third),
  /// stretched to fit, at an opacity (0 to 1) — a background image faded as its colour would
  /// be.
  | Picture(TextureId, Rect, Rect, f32)
  /// Draw only inside the rectangle until the matching [PopClip]. Clips nest: each narrows
  /// the one around it.
  | PushClip(Rect, Radii)
  /// Undo the last [PushClip].
  | PopClip
  /// The shadow a rounded rectangle casts — CSS's `box-shadow`: the shape moved by the
  /// shadow's offset, grown by its spread and blurred; drawn outside the shape, or inside it
  /// for an `inset` one.
  | Shadow(Rect, Radii, BoxShadow)
  /// A rounded rectangle filled with a gradient.
  | GradientFill(Rect, Radii, Gradient)
  /// What is already drawn behind the rounded rectangle, blurred by this radius — CSS's
  /// `backdrop-filter: blur()`, for a frosted panel; the panel's own background goes over it.
  | Backdrop(Rect, Radii, f32)
  /// Draw what follows, until the matching [PopLayer], into a layer of its own covering the
  /// rectangle, then put the layer down with the effect: blurred (CSS's `filter: blur()`).
  | PushLayer(Rect, LayerEffect)
  /// Put the last [PushLayer]'s layer down.
  | PopLayer

/// A shadow, as CSS's `box-shadow` has one: moved `x` and `y`, blurred by `blur` (the
/// Gaussian's standard deviation is half of it, as a browser's), grown by `spread`, in
/// `color` — inside the shape for `inset`.
pub struct BoxShadow {
  x: f32 = 0.0,
  y: f32 = 0.0,
  blur: f32 = 0.0,
  spread: f32 = 0.0,
  color: Color,
  inset: bool = false,
}

/// A gradient: its kind and its colour stops, in order.
pub struct Gradient {
  kind: GradientKind,
  stops: []ColorStop,
}

/// Along a line at an angle — CSS's degrees, `0.0` up, `90.0` to the right, `180.0` (its
/// default) down — or out from the middle: to the farthest corner, as a circle or an ellipse
/// of the rectangle's proportions.
pub data GradientKind = LinearGradient(f32) | RadialGradient(bool)

/// A colour at a place along a gradient, `0.0` its start and `1.0` its end; `None` spaced
/// evenly between its neighbours, as CSS does.
pub struct ColorStop {
  color: Color,
  at: Maybe<f32> = None,
}

/// What a layer does as it is put down: its content blurred by `blur` (`0.0` for none).
pub struct LayerEffect {
  blur: f32 = 0.0,
}

impl Gradient {
  /// The stops' places, settled as CSS settles them: the first at 0 and the last at 1 when
  /// not given, each no earlier than the one before, and the unplaced ones spaced evenly.
  pub let places = pure (self) -> []f32 => {
    let n = self.stops.len()
    var spots: []f32 = [s in self.stops | s.at ?? -1.0]
    if n == 0 { return spots }
    if spots[0] < 0.0 { spots[0] = 0.0 }
    if spots[n - 1] < 0.0 { spots[n - 1] = 1.0 }
    for i in 1..<n { if spots[i] >= 0.0 && spots[i] < spots[i - 1] { spots[i] = spots[i - 1] } }
    var i = 1
    while i < n {
      if spots[i] >= 0.0 {
        i += 1
        continue
      }
      var j = i
      while spots[j] < 0.0 { j += 1 }
      let from = spots[i - 1]
      let step = (spots[j] - from) / f32(j - i + 1)
      for k in i..<j { spots[k] = from + step * f32(k - i + 1) }
      i = j
    }
    spots
  }

  /// How far along the gradient `p` is in `box`, 0 at its start and 1 at its end.
  pub let along = pure (self, box: Rect, p: Point) -> f32 => {
    let cx = box.x + box.w / 2.0
    let cy = box.y + box.h / 2.0
    match self.kind {
      LinearGradient(degrees) => {
        let a = degrees * 0.017453292
        let dx = a.sin()
        let dy = -a.cos()
        // CSS's gradient line: long enough that the corners reach its ends.
        let length = (box.w * dx).abs() + (box.h * dy).abs()
        if length <= 0.0 { 0.0 } else { ((p.x - cx) * dx + (p.y - cy) * dy) / length + 0.5 }
      },
      RadialGradient(circle) => {
        let hw = (box.w / 2.0).max(0.0001)
        let hh = (box.h / 2.0).max(0.0001)
        let ux = p.x - cx
        let uy = p.y - cy
        if circle {
          (ux * ux + uy * uy).sqrt() / (hw * hw + hh * hh).sqrt()
        } else {
          // An ellipse of the box's proportions through its corners: radii √2 its halves.
          let ex = ux / (hw * 1.4142135)
          let ey = uy / (hh * 1.4142135)
          (ex * ex + ey * ey).sqrt()
        }
      },
    }
  }

  /// The colour at `t` along the gradient: between the stops either side, mixed with their
  /// alpha premultiplied, as CSS mixes them.
  pub let at = pure (self, t: f32) -> Color => {
    let n = self.stops.len()
    if n == 0 { return Color { r: 0, g: 0, b: 0, a: 0 } }
    let marks = self.places()
    if t <= marks[0] { return self.stops[0].color }
    if t >= marks[n - 1] { return self.stops[n - 1].color }
    var k = 1
    while k < n - 1 && t > marks[k] { k += 1 }
    let span = marks[k] - marks[k - 1]
    let f = if span <= 0.0 { 1.0 } else { (t - marks[k - 1]) / span }
    mixed(self.stops[k - 1].color, self.stops[k].color, f)
  }
}

/// `a` and `b` mixed `f` of the way to `b`, alpha premultiplied.
pub let mixed = pure (a: Color, b: Color, f: f32) -> Color => {
  let aa = f32(a.a) / 255.0
  let ba = f32(b.a) / 255.0
  let alpha = aa + (ba - aa) * f
  let channel = (x: u8, y: u8) -> u8 => {
    if alpha <= 0.0 { return 0 }
    let v = (f32(x) * aa + (f32(y) * ba - f32(x) * aa) * f) / alpha
    u8(v.max(0.0).min(255.0).round())
  }
  Color {
    r: channel(a.r, b.r),
    g: channel(a.g, b.g),
    b: channel(a.b, b.b),
    a: u8((alpha * 255.0).max(0.0).min(255.0).round())
  }
}

// ── Rectangles ───────────────────────────────────────────────────────────────

impl Rect {
  /// The rectangle `by` units smaller on every side — larger for a negative `by`.
  pub let inset = pure (self, by: f32) -> Rect =>
    Rect { x: self.x + by, y: self.y + by, w: self.w - 2.0 * by, h: self.h - 2.0 * by }

  /// The part of both rectangles, which is empty where they do not meet.
  pub let intersect = pure (self, other: Rect) -> Rect => {
    let left = self.x.max(other.x)
    let top = self.y.max(other.y)
    let right = (self.x + self.w).min(other.x + other.w)
    let bottom = (self.y + self.h).min(other.y + other.h)
    Rect { x: left, y: top, w: (right - left).max(0.0), h: (bottom - top).max(0.0) }
  }

  /// Whether the rectangle covers nothing.
  pub let is_empty = pure (self) -> bool => self.w <= 0.0 || self.h <= 0.0

  /// Whether `p` is inside — its top and left edges included, its bottom and right not.
  pub let contains = pure (self, p: Point) -> bool =>
    p.x >= self.x && p.y >= self.y && p.x < self.x + self.w && p.y < self.y + self.h

  /// The same rectangle, `by` times larger, about the origin: logical units to pixels.
  pub let scaled = pure (self, by: f32) -> Rect =>
    Rect { x: self.x * by, y: self.y * by, w: self.w * by, h: self.h * by }
}

impl Radii {
  /// The radii `by` times larger.
  pub let scaled = pure (self, by: f32) -> Radii => Radii {
    top_left: self.top_left * by,
    top_right: self.top_right * by,
    bottom_right: self.bottom_right * by,
    bottom_left: self.bottom_left * by,
  }

  /// The radii a rectangle `w` × `h` can hold: as CSS does, every radius scaled down by one
  /// factor until no two corners on a side need more than that side, and none negative.
  pub let fitted = pure (self, w: f32, h: f32) -> Radii => {
    let tl = self.top_left.max(0.0)
    let tr = self.top_right.max(0.0)
    let br = self.bottom_right.max(0.0)
    let bl = self.bottom_left.max(0.0)
    var factor: f32 = 1.0
    factor = factor.min(side_room(w, tl + tr))
    factor = factor.min(side_room(w, bl + br))
    factor = factor.min(side_room(h, tl + bl))
    factor = factor.min(side_room(h, tr + br))
    Radii {
      top_left: tl * factor,
      top_right: tr * factor,
      bottom_right: br * factor,
      bottom_left: bl * factor,
    }
  }

  /// Each radius `by` smaller, none below zero: the inner edge of a border `by` wide.
  pub let shrunk = pure (self, by: f32) -> Radii => Radii {
    top_left: (self.top_left - by).max(0.0),
    top_right: (self.top_right - by).max(0.0),
    bottom_right: (self.bottom_right - by).max(0.0),
    bottom_left: (self.bottom_left - by).max(0.0),
  }
}

/// How far two corners needing `need` together fit along a side `length` long: `1.0` when
/// they do.
let side_room = pure (length: f32, need: f32) -> f32 =>
  if need <= length || need <= 0.0 { 1.0 } else { length.max(0.0) / need }

let held_side = pure (value: f32, least: f32, most: f32) -> f32 => {
  let floor = value.max(least)
  if most > 0.0 { floor.min(most.max(least)) } else { floor }
}
