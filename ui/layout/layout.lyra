module ui.layout
//! An interface as a tree of [Node]s, laid out by constraints and painted as a display list.
//!
//! ```
//! import ui.layout.{ Node, column, row, text, button, expanded, layout, paint, loose }
//!
//! data Msg = Save
//!
//! let view = pure (volume: i64) -> Node<Msg> => column([
//!   text("Settings").with_class("title"),
//!   row([text("Volume"), expanded(text("${volume}%"))]),
//!   button("Save", Save),
//! ]).with_style(Style { padding: Some(insets(16.0)), gap: Some(8.0) })
//! ```
//!
//! **A node is generic in the program's event type** `e`: a control names the event its use
//! stands for (`button("Save", Save)`, `checkbox(…, ToggleLoud)`, a slider's or a field's
//! `(value) -> e`), and `ui.interact` answers those events — the program decides what they do.
//! A tree that raises none is a `Node<NoEvent>`. **Write the event type on the view** (its
//! return type, or a binding's): a leaf such as `text("…")` raises none, so only the context
//! says which `e` it is — and it reaches through a chain of its builder methods
//! (`text("Title").with_class("title")`), each of which returns its receiver's type.
//!
//! **Layout is Flutter's protocol**: a parent hands each child [Constraints] — a least and a
//! greatest width and height — the child answers the size it chose within them, and the
//! parent places it. One pass down and up, each node visited once, so a tree lays out in
//! linear time. [layout] answers a [Laid] tree: every node's size, its children's offsets
//! from its top-left corner, its settled style and what it draws. [paint] turns that into
//! `ui.draw`'s display list.
//!
//! **Elements**: [flex] and [grid] (CSS's flexbox and grid, configured by style properties;
//! `flex.lyra`, `grid.lyra`), [row] and [column] (with a `gap`, and main- and cross-axis alignment),
//! [expanded] (a share of a row's or column's free space), [stack] and [positioned], [padding],
//! [align], [sized], [scroll], [text], [image], [themed] (a theme and a global sheet for a
//! subtree) and [component] (a scoped sheet); and the controls [button], [checkbox],
//! [slider] and [text_input]. A wrapper hands one child its own constraints, and lays several
//! out as a column does.
//!
//! **Every element can be styled** (`ui.style`): its tag (`Row`, `Text`, a component's own),
//! classes and inline [Style] go through the cascade, and any element may have a background,
//! a border, rounded corners and padding. A row's or column's `gap` is a style too, so a
//! theme can set it. **An element's state is a pseudo-class**, as CSS's: `:hover`, `:active`,
//! `:focus`, `:focus-visible`, `:focus-within`, `:checked`, `:open`, `:disabled` and `:enabled`, so
//! `Button:hover` is a rule like any other.
//!
//! **Identity** is a node's path from the root ([Laid.id]): each step its index among its
//! siblings, or its [Node.keyed] key where it has one — so a keyed item keeps its identity,
//! and the state `ui.interact` holds for it (focus, a field's caret, a scroll's offset), when
//! items are inserted before it.
//!
//! **Every element has a role and a label** ([Role], [Laid.label]) for assistive technology:
//! a control's label is its visible text unless [Node.labelled] says otherwise.
//!
//! **Unbounded** is [UNBOUNDED], a large number rather than an infinity, so arithmetic on it
//! stays finite: a row's children are measured with an unbounded width, a scroll's child with
//! an unbounded height.

import ui.draw.{
  Image,
  PictureSource,
  Point,
  Size,
  Rect,
  Radii,
  Color,
  TextureId,
  DrawOp,
  Fill,
  Border,
  Glyphs,
  GlyphQuad,
  Picture,
  PushClip,
  PopClip,
  Shadow,
  GradientFill,
  Backdrop,
  PushLayer,
  PopLayer,
  BoxShadow,
  Gradient,
  ColorStop,
  LayerEffect,
  radius,
}
import ui.backend.{ Renderer, Key, Modifiers, PointerButton, Chord }
import ui.text.{ Fonts, FontSpec, Cell, TextBlock, GlyphAtlas, caret_x }
import ui.style.{
  Style,
  scrollbar_rules,
  Sheet,
  Theme,
  Insets,
  Computed,
  Cascade,
  cascade_root,
  media_matches,
  light_theme,
  faded,
  Overflow,
  OverflowVisible,
  OverflowClip,
  OverflowScroll,
  OverflowAuto,
  Viewport,
  MediaAnswer,
}
import ui.motion.{ with_layout, layout_key }
import std.collections.{ HashMap, hashmap_new }

// ── The tree ─────────────────────────────────────────────────────────────────

/// One element: what kind it is, how it is named for the cascade (its `tag`, `class`es and
/// the `part` of its component it is), its inline style, its children, the `key` standing for
/// its index in its identity, and the `label` assistive technology reads for it (`""` for its
/// visible text).
pub struct Node<e> {
  kind: Kind<e>,
  tag: string,
  class: string = "",
  part: string = "",
  style: Style = Style {},
  children: []Node<e> = [],
  key: string = "",
  label: string = "",
  /// A control that takes no input: not pressed, not focused, `:disabled` to the cascade.
  disabled: bool = false,
  /// Whether a press on it, where none of its controls takes the press, moves the window — a
  /// title bar the program draws ([Node.window_drag]).
  drags_window: bool = false,
  /// Its tooltip ([Node.tooltip]): none, or the one node shown by the pointer once it rests
  /// on this one.
  tip: []Node<e> = [],
  /// What it is to assistive technology in place of what its kind makes it ([Node.with_role]):
  /// a table's rows, which are radio buttons to the keyboard.
  role: Maybe<Role> = None,
}

/// What an element does with its children, its space and its input. Built by the functions
/// below ([row], [text], [button], …), which name them.
pub data Kind<e> =
  /// A row or column: its children along an axis.
  Flow(Axis, MainAlign, CrossAlign)
  /// A share of a [Flow]'s free space, in proportion to this factor.
  | Grow(f32)
  /// Its children over one another, the first at the bottom.
  | Layers
  /// Placed by its edges in a [Layers].
  | Pin(Edges)
  /// Space around its children.
  | Inset(Insets)
  /// Its children placed in its space at this alignment.
  | Place(Alignment)
  /// A width and a height, each unset to take the children's.
  | Measured(Maybe<f32>, Maybe<f32>)
  /// Its children moved along the axis — by this offset until the user scrolls it — and
  /// clipped to its box.
  | Scrolls(Axis, f32)
  /// A paragraph of text.
  | Words(string)
  /// Part of a texture, at a natural size.
  | Texels(TextureId, Rect, Size)
  /// A picture the program names, kept by the host, at a natural size ([picture]).
  | Pictured(PictureSource, Size)
  /// A subtree in a theme, with a global sheet.
  | Theming(Theme, Sheet)
  /// A component: its tag is its name, and its sheet — made from the theme in force — is
  /// scoped to it.
  | Scope((Theme) -> Sheet)
  /// A button: this event when it is pressed.
  | Pressable(e)
  /// A checkbox, ticked or not: this event when it is toggled.
  | Checkable(bool, e)
  /// A slider.
  | Ranged(SliderSpec<e>)
  /// A select (HTML's `<select>`): one of a list of options, chosen from a list that opens
  /// over everything below it.
  | Choosing(SelectSpec<e>)
  /// A popup ([popup]): its first child the anchor, laid out in its place; its second, while
  /// open, floating from it on that side; and the event a press outside it, Escape or the
  /// window losing the focus raises.
  | PopsUp(bool, FloatSide, e)
  /// A modal dialog ([modal]): its first child what it is over, laid out in its place; its
  /// second, while open, centred in the window over a scrim, the only thing taking input; and
  /// the event Escape raises.
  | Modal(bool, e)
  /// A menu's opener ([menu_bar]'s titles, [menu_button], a submenu's item): its child its
  /// face, and while it is open (`Interaction.menus`) its entries' list floating from it.
  | Opens(MenuSpec<e>)
  /// A shortcut's text, spelled as the platform spells it ([chord_text]).
  | Spelled(Chord)
  /// A tab bar's strip ([tab_bar]): its tabs, then what follows them, along it.
  | TabStrip
  /// A tab of a tab bar.
  | Tabbed(TabSpot<e>)
  /// One of the window's own buttons ([window_buttons]): pressed, the framework minimizes,
  /// maximizes or restores, or closes the window.
  | WindowControl(WindowButton)
  /// A colour picker's square or strip ([color_picker]): pressed or dragged, a colour.
  | ColorAxis(AxisSpec<e>)
  /// A colour on a checkerboard, filling its room ([swatch]'s face).
  | ColorPatch(Color)
  /// A one-line text field.
  | Editable(FieldSpec<e>)
  /// A flex container (CSS's flexbox), laid out by its computed style: direction, wrap,
  /// justify and align, gaps, and each item's grow, shrink, basis, order and self-alignment.
  | Flexbox
  /// A grid (CSS's grid layout), laid out by its computed style: column and row tracks, gaps,
  /// placement and alignment.
  | Gridbox
  /// Drawn by the program: its size the layout's, its insides what the painter answers.
  | Painted(Painter<e>)
  /// Dragged along an axis to change a number ([DragSpec]): a splitter's edge, a table's
  /// column's, a number field's label.
  | Drags(DragSpec<e>)
  /// A radio button ([radio]), chosen or not: this event when it is chosen.
  | Radio(bool, e)
  /// A group of [Radio]s with one stop for Tab — the one chosen, else the first — among which
  /// the arrow keys move the choice ([radio_group], a [table]'s rows).
  | OneOf
  /// A dock ([dock]): its child the tree's groups and splits; while a tab is docked into it
  /// (`Interaction.dock_drop`), where it would land shown over them (`DockPreview`).
  | Docked(DockSpec<e>)
  /// A dock's group of tabs: its path in the dock's tree, and its panels' keys.
  | DockLeaf(string, []string)

/// A number dragged along `axis`: `value` as the press found it, changed by `per_unit` for
/// each unit the pointer goes — right or down more — and held between `min` and `max`;
/// `on_drag` with each new value. With `share`, `per_unit` is for the whole of the room its
/// parent shares out along the axis — the parent's length less the dragged element's own — so
/// the value is a share of that room (a dock's split).
pub struct DragSpec<e> {
  axis: Axis = Horizontal,
  value: f64,
  per_unit: f64 = 1.0,
  min: f64 = -1.0e15,
  max: f64 = 1.0e15,
  share: bool = false,
  on_drag: (f64) -> e,
}

/// An element the program draws ([painted]): `paint` answers what to draw in the size it was
/// laid out at, in its own coordinates — `(0, 0)` its top-left corner — and is asked every
/// time the window is painted, so it draws from the newest state; `on_size` is the event for
/// a new size, raised after the layout that gave it and before that layout is painted.
pub struct Painter<e> {
  paint: (PaintArea) -> []PaintOp,
  on_size: Maybe<(Size) -> e>,
  /// What it is to the keyboard and pointer: nothing, or every key, typed text and pointer
  /// event ([RawInput], [Node.takes_input]).
  input: Maybe<RawInput<e>>,
}

/// An element that takes input raw — a terminal's: focusable, and handed **every key and the
/// text it types while focused, and the pointer while it is over it or holds it** (a press on
/// it holds the pointer until it is let go, wherever it goes), before the framework does
/// anything with them — Tab included. Each function answers the event the input stands for,
/// or `None` to hand it back to the framework, which goes on as it would have. `caret` is
/// where typed text goes, in the element's coordinates — where an input method's window
/// opens — `None` asking for no text.
pub struct RawInput<e> {
  on_key: (KeyInput) -> Maybe<e>,
  on_text: (TextInput) -> Maybe<e>,
  on_pointer: (PointerInput) -> Maybe<e>,
  caret: Maybe<Rect>,
}

/// A key pressed or let go, and the modifiers held with it.
pub struct KeyInput {
  key: Key,
  mods: Modifiers,
  pressed: bool,
}

/// Text: typed (a key's character, or what an input method made), or an input method's
/// composition in progress — its text, its caret and the length of the part selected, in runes
/// (`-1` for none); an empty one ends it.
pub data TextInput = TypedText(string) | ComposedText(string, i64, i64)

/// The pointer, where it is in the element's coordinates, and the modifiers held.
pub struct PointerInput {
  at: Point,
  kind: PointerKind,
  mods: Modifiers,
}

/// What the pointer did: a button pressed (and the clicks in a row it makes) or let go, a
/// move, or a wheel turned — across and down, in lines.
pub data PointerKind =
  PointerPress(PointerButton, i64)
  | PointerRelease(PointerButton)
  | PointerMove
  | PointerWheel(f32, f32)

/// What a painter is asked to fill: its size; the part of it inside every clip around it, in
/// its own coordinates — what a scroller shows of a tall one, which is all that need be
/// drawn; and the device pixels a logical unit, to put a line on a whole pixel.
pub struct PaintArea {
  size: Size,
  visible: Rect,
  scale: f32,
}

/// What a painter draws, in its own coordinates, each over the ones before and clipped to its
/// box.
pub data PaintOp =
  /// An op of the display list as it is, moved to the element's place.
  PaintDraw(DrawOp)
  /// Text shaped and laid out as a `text` element's is, a line at each `\n` and nowhere else,
  /// its first line's baseline at the point.
  | PaintText(Point, string, FontSpec, Color)
  /// A row of a grid of characters — a terminal's line — unshaped ([Fonts.cells]): each cell
  /// at the point's `x` plus its column times the advance (the second value), on the baseline
  /// at its `y`. One op a colour: the cells of a run of one.
  | PaintCells(Point, f32, []Cell, FontSpec, Color)
  /// A wavy line — a curly underline — from the point (its middle, at its left end) across a
  /// width (the first value), an amplitude above and below it, a thickness thick (the last),
  /// a wave every eight amplitudes.
  | PaintWave(Point, f32, f32, f32, Color)
  /// A picture of the program's ([PictureSource], kept by the host as [picture]'s is): its
  /// `texels` (the first rectangle, in the image's pixels) drawn into the second, at an
  /// opacity — a canvas, or a background tiled or stretched.
  | PaintPicture(PictureSource, Rect, Rect, f32)

/// A slider's value between `min` and `max`, moved in steps of `step` (`0.0` for none) from
/// the keyboard, and the event for a new value.
pub struct SliderSpec<e> {
  value: f32,
  min: f32 = 0.0,
  max: f32 = 1.0,
  step: f32 = 0.0,
  on_change: (f32) -> e,
}

/// A select's options, by their text; the one chosen, by index (`-1` for none); and the event
/// for a choice, carrying the index chosen.
pub struct SelectSpec<e> {
  options: []string,
  selected: i64 = -1,
  on_change: (i64) -> e,
  /// The options a rule goes before in the list, by index: groups of them, as a saved theme
  /// after the built-in ones.
  separators: []i64 = [],
  /// Each option's font family, by index (`""`, or none past the end, for the select's own):
  /// a font's name in that font, in the list and on the select when it is the one chosen.
  option_families: []string = [],
}

/// A text field's value — the program's, set from its state each frame — the text shown while
/// it is empty, whether it is read-only (focused, selected and copied, never edited: HTML's
/// `readonly`, CSS's `:read-only`), and the event for an edit, carrying the value as the edit
/// leaves it.
pub struct FieldSpec<e> {
  value: string,
  placeholder: string = "",
  read_only: bool = false,
  on_edit: (string) -> e,
  /// Whether the framework keeps the text as it is typed while the field has the focus
  /// (`Interaction.drafts`), whatever `value` says — a colour picker's, whose value is the
  /// colour as `#rrggbb` and whose user may be halfway through `oklch(`.
  draft: bool = false,
  /// The event for Up (`1`) and Down (`-1`) — ten with Shift — and the draft dropped, so the
  /// field shows the value the step leaves: a number field's ([number_field]).
  on_step: Maybe<(i64) -> e> = None,
}

/// The event type of a tree that raises none: `Node<NoEvent>`. (Not `Node<void>`, which does
/// not compile yet — todo.md.)
pub data NoEvent = NoEvent

/// What an element is, to assistive technology: AccessKit's roles, the ones `ui` has.
pub data Role =
  NoRole
  | GroupRole
  | TextRole
  | ImageRole
  | ButtonRole
  | CheckboxRole
  | SliderRole
  | TextFieldRole
  | ScrollRole
  | ComboBoxRole
  | ListBoxRole
  | OptionRole
  | TabListRole
  | TabRole
  | RadioRole
  | RadioGroupRole
  | ProgressRole
  | TableRole
  | RowRole

/// A row's axis or a column's.
pub data Axis = Horizontal | Vertical

/// Where a row's or column's children sit along it, with what space is left over: packed at
/// the start, middle or end, or the space shared out between them — between only, around
/// each (half at the ends), or evenly (whole at the ends).
pub data MainAlign = MainStart | MainCenter | MainEnd | SpaceBetween | SpaceAround | SpaceEvenly

/// Where a row's or column's children sit across it: at the start, middle or end, or
/// stretched to fill it.
pub data CrossAlign = CrossStart | CrossCenter | CrossEnd | CrossStretch

/// A positioned child's edges in its stack, each from the stack's own, and its size; what is
/// unset is the child's. Both `left` and `right` set fix its width, as `top` and `bottom` do
/// its height.
pub struct Edges {
  left: Maybe<f32> = None,
  top: Maybe<f32> = None,
  right: Maybe<f32> = None,
  bottom: Maybe<f32> = None,
  width: Maybe<f32> = None,
  height: Maybe<f32> = None,
}

/// A point in a box, as fractions of its width and height: `0.0, 0.0` its top-left corner,
/// `0.5, 0.5` its middle.
pub struct Alignment {
  x: f32 = 0.0,
  y: f32 = 0.0,
}

pub const TOP_LEFT: Alignment = Alignment { x: 0.0, y: 0.0 }
pub const CENTER: Alignment = Alignment { x: 0.5, y: 0.5 }
pub const BOTTOM_RIGHT: Alignment = Alignment { x: 1.0, y: 1.0 }

/// Children side by side, left to right.
pub let row<e> = pure (children: []Node<e>) -> Node<e> => {
  let kind: Kind<e> = Flow(Horizontal, MainStart, CrossCenter)
  Node { kind: kind, tag: "Row", children: children }
}

/// Children one under another.
pub let column<e> = pure (children: []Node<e>) -> Node<e> => {
  let kind: Kind<e> = Flow(Vertical, MainStart, CrossStart)
  Node { kind: kind, tag: "Column", children: children }
}

/// `child` taking a share of its row's or column's free space, in proportion to `flex`.
pub let expanded<e> = pure (child: Node<e>, flex: f32 = 1.0) -> Node<e> => {
  let kind: Kind<e> = Grow(flex)
  Node { kind: kind, tag: "Expanded", children: [child] }
}

/// A flex container, after CSS's: its items along a row (or a column, or either reversed, by
/// `flex_direction`), wrapping onto more lines by `flex_wrap`, each line's free space shared
/// by `justify_content` and the items' `grow` and `shrink`, and lines and items placed across
/// by `align_content`, `align_items` and an item's `align_self` — all style properties, so a
/// sheet can set them (`Flex.cards`). A row fills the width it is given; its height is its
/// lines' unless `height` (or a parent) fixes it.
pub let flex<e> = pure (children: []Node<e>) -> Node<e> => {
  let kind: Kind<e> = Flexbox
  Node { kind: kind, tag: "Flex", children: children }
}

/// A grid, after CSS's: its items in the cells of `grid_columns` and `grid_rows` (tracks of
/// [px](ui.style), [fr](ui.style), `auto`, min- and max-content, `minmax` and
/// `repeat_tracks`), placed where their `grid_column` and `grid_row` say or flowed into the
/// next free cell by `grid_flow`, and aligned in their cells by `justify_items`,
/// `align_items` and an item's own `justify_self` and `align_self`.
pub let grid<e> = pure (children: []Node<e>) -> Node<e> => {
  let kind: Kind<e> = Gridbox
  Node { kind: kind, tag: "Grid", children: children }
}

/// Children over one another, the first at the bottom; as large as the largest that is not
/// [positioned].
pub let stack<e> = pure (children: []Node<e>) -> Node<e> => {
  let kind: Kind<e> = Layers
  Node { kind: kind, tag: "Stack", children: children }
}

/// `child` placed in its [stack] by `edges`.
pub let positioned<e> = pure (edges: Edges, child: Node<e>) -> Node<e> => {
  let kind: Kind<e> = Pin(edges)
  Node { kind: kind, tag: "Positioned", children: [child] }
}

/// `child` with `space` around it.
pub let padding<e> = pure (space: Insets, child: Node<e>) -> Node<e> => {
  let kind: Kind<e> = Inset(space)
  Node { kind: kind, tag: "Padding", children: [child] }
}

/// `child` placed at `at` in all the space it is given.
pub let align<e> = pure (at: Alignment, child: Node<e>) -> Node<e> => {
  let kind: Kind<e> = Place(at)
  Node { kind: kind, tag: "Align", children: [child] }
}

/// A box `width` × `height` (each `None` for its children's), its children inside.
pub let sized<e> = pure (
  width: Maybe<f32>,
  height: Maybe<f32>,
  children: []Node<e> = []
) -> Node<e> => {
  let kind: Kind<e> = Measured(width, height)
  Node { kind: kind, tag: "SizedBox", children: children }
}

/// `child` along `axis` with all the room it wants, seen through a window as large as this
/// element is given — moved `offset` units along until the user scrolls it, and clipped to
/// the window.
pub let scroll<e> = pure (axis: Axis, offset: f32, child: Node<e>) -> Node<e> => {
  let kind: Kind<e> = Scrolls(axis, offset)
  Node { kind: kind, tag: "Scroll", children: [child] }
}

/// A paragraph, broken into lines at the width it is given.
pub let text<e> = pure (content: string) -> Node<e> => {
  let kind: Kind<e> = Words(content)
  Node { kind: kind, tag: "Text" }
}

/// The `texels` of a texture, `size` units large where there is room.
pub let image<e> = pure (texture: TextureId, texels: Rect, size: Size) -> Node<e> => {
  let kind: Kind<e> = Texels(texture, texels, size)
  Node { kind: kind, tag: "Image" }
}

/// A picture of the program's own (`Picture`): `image`, `size` units large where there is
/// room, kept by the host as a texture under `key` and written again only when `revision`
/// moves ([PictureSource]) — so a view names it every frame for nothing; drawn at the
/// element's opacity. A key no view names is let go at the next frame.
pub let picture<e> = pure (
  key: string,
  image: Image,
  revision: i64,
  size: Size
) -> Node<e> => {
  let kind: Kind<e> = Pictured(
    PictureSource { key: key, image: image, revision: revision },
    size
  )
  Node { kind: kind, tag: "Picture" }
}

/// An element drawn by `paint` ([Painter]) at the size it is given — its style's `width` and
/// `height`, else all of the room its parent allows (a tall one in a scroller needs a
/// `height`) — and `on_size`'s event each time that size changes.
pub let painted<e> = pure (
  paint: (PaintArea) -> []PaintOp,
  on_size: Maybe<(Size) -> e> = None
) -> Node<e> => {
  let input: Maybe<RawInput<e>> = None
  let kind: Kind<e> = Painted(Painter { paint: paint, on_size: on_size, input: input })
  Node { kind: kind, tag: "Painted" }
}

/// `children` drawn in `theme`, with `sheet` as their innermost global sheet.
pub let themed<e> = pure (theme: Theme, sheet: Sheet, children: []Node<e>) -> Node<e> => {
  let kind: Kind<e> = Theming(theme, sheet)
  Node { kind: kind, tag: "Themed", children: children }
}

/// A component named `name` (its tag, for the cascade), whose `sheet` styles `children` and
/// nothing else.
pub let component<e> = pure (
  name: string,
  sheet: Sheet,
  children: []Node<e>
) -> Node<e> => {
  let kind: Kind<e> = Scope((_: Theme) -> Sheet => sheet)
  Node { kind: kind, tag: name, children: children }
}

/// A component as [component] is, whose sheet is made from the theme it is drawn in — the
/// sheet `lui` writes for a component's `<style>`, whose `$tokens` read the theme.
pub let component_of<e> = pure (
  name: string,
  sheet: (Theme) -> Sheet,
  children: []Node<e>
) -> Node<e> => {
  let kind: Kind<e> = Scope(sheet)
  Node { kind: kind, tag: name, children: children }
}

/// A button showing `label`: `on_click` when it is clicked, or pressed from the keyboard
/// (Space or Enter) while it has the focus.
pub let button<e> = pure (label: string, on_click: e) -> Node<e> =>
  Node { kind: Pressable(on_click), tag: "Button", children: [text::<e>(label)] }

/// A checkbox labelled `label`, ticked when `checked`: its box (the `Checkbox::box` part, or
/// `Checkbox::checked` while ticked) holding, when ticked, a fill (`Checkbox::fill`) inset from
/// its border by the box's padding. `on_toggle` when it is clicked, or pressed from the
/// keyboard. The program flips its own value.
pub let checkbox<e> = pure (label: string, checked: bool, on_toggle: e) -> Node<e> => {
  let fill: []Node<e> = if checked { [sized::<e>(
    None,
    None
  ).with_part("fill")] } else { [] }
  // Fixed at 18 outside, so the part's padding — the gap round a ticked fill — comes out of
  // the 18 rather than adding to it.
  let face = sized::<e>(
    None,
    None,
    fill
  ).with_part(if checked { "checked" } else { "box" })
  let ticked = sized::<e>(Some(18.0), Some(18.0), [face])
  let body = row::<e>([ticked, text::<e>(label)]).with_style(Style { gap: Some(8.0) })
  Node { kind: Checkable(checked, on_toggle), tag: "Checkbox", children: [body] }
}

/// A slider at `spec.value`, as wide as it is given: `spec.on_change` with each new value as
/// it is dragged, clicked, or moved from the keyboard (the arrows by a step, Home and End to
/// the ends).
pub let slider<e> = pure (spec: SliderSpec<e>) -> Node<e> =>
  Node { kind: Ranged(spec), tag: "Slider" }

/// A select (HTML's `<select>`) showing its chosen option and an arrow (the `Select::arrow`
/// part), as wide as its widest option. A click, or Space, Enter or Alt-Down while it has the
/// focus, opens its list (`Select::list`) of options (`Select::option` — `:checked` the chosen
/// one, `:hover` the one under the pointer or the arrow keys), drawn over everything below it;
/// a click on one, or Enter, chooses it, and Escape or a click elsewhere closes the list.
/// Closed, Up and Down choose the option before or after. `spec.on_change` with the index.
pub let select<e> = pure (spec: SelectSpec<e>) -> Node<e> => {
  // Every option's text in one place, only the chosen one seen: the select is as wide as its
  // widest option, as HTML's is, whichever is chosen.
  let texts = stack::<e>([
    i in 0..<spec.options.len() |
      text::<e>(spec.options[i]).with_style(Style {
        opacity: Some(if i == spec.selected { 1.0 } else { 0.0 }),
        font_family: option_family(spec, i),
      })
  ])
  let face = row::<e>([expanded::<e>(texts), select_arrow::<e>()])
    .with_style(Style { gap: Some(10.0) })
    .aligned(MainStart, CrossCenter)
  Node { kind: Choosing(spec), tag: "Select", children: [face] }
}

/// Option `i`'s own family, if `spec` gives it one.
let option_family = pure (spec: SelectSpec<e>, i: i64) -> Maybe<string> =>
  if i < spec.option_families.len() && spec.option_families[i] != "" {
    Some(spec.option_families[i])
  } else { None }

/// A select's arrow: a small triangle pointing down, drawn as bars narrowing to its tip — the
/// display list has no paths, and the system font no arrow worth the name. Each bar is the
/// `Select::arrow` part, so a sheet colours it with `background`.
let select_arrow<e> = pure () -> Node<e> => {
  let widths: []f32 = [10.0, 8.0, 6.0, 4.0, 2.0]
  // Centred down it too: the column takes the row's height, and its bars at its top sat above
  // the text's middle.
  column::<e>([w in widths | sized::<e>(Some(w), Some(1.2)).with_part("arrow")])
    .aligned(MainCenter, CrossCenter)
}

/// A popup: `anchor` in its place, and while `open` — the program's to say — `content`
/// floating from it (`Laid.floats`), taking none of its size: below it (or beside it, a
/// submenu's), flipped above (to its left) where the window leaves no room, moved in from the
/// window's edges, and no larger than the window, scrolling past that ([place_floats]). A press outside the anchor and the content
/// (and what floats from it), Escape, or the window losing the focus raises `on_dismiss`; the
/// program closes it. A press on the anchor raises none, so a button that opens a popup can
/// close it too. Opened from the keyboard, the focus goes into it, and back to the anchor when
/// it closes (`ui.interact`).
pub let popup<e> = pure (
  anchor: Node<e>,
  open: bool,
  content: Node<e>,
  on_dismiss: e,
  side: FloatSide = FloatBelow
) -> Node<e> =>
  Node { kind: PopsUp(open, side, on_dismiss), tag: "Popup", children: [anchor, content] }

/// A modal dialog: `under` in its place, and while `open` — the program's to say — `content`
/// centred in the window (`Dialog`, no larger than the window less the scrim's padding,
/// scrolling past that) over a scrim dimming everything else (`ModalScrim`). While it is open nothing
/// outside it takes input: a press elsewhere goes nowhere, and Tab keeps the focus inside it.
/// It takes the focus when it opens, on its first control, and gives it back to what had it
/// when it closes. Escape raises `on_dismiss`, which the program closes it for; a press outside
/// it and the window losing the focus raise nothing.
pub let modal<e> = pure (
  under: Node<e>,
  open: bool,
  content: Node<e>,
  on_dismiss: e
) -> Node<e> =>
  Node { kind: Modal(open, on_dismiss), tag: "Modal", children: [under, content] }

/// The identity of option `index` in the list of the select identified as `select`.
pub let option_id = pure (select: string, index: i64) -> string =>
  "${select}/:list/:${index}"

/// The option of the select identified as `select` that `id` — an element's — is or is in, by
/// index; `None` outside its list.
pub let option_of = pure (select: string, id: string) -> Maybe<i64> => {
  let Some(rest) = id.strip_prefix("${select}/:list/:") else { return None }
  rest.split("/")[0].parse_i64()
}

/// A one-line text field showing `spec.value`, as wide as it is given: `spec.on_edit` with the
/// value each edit leaves. The caret, the selection and an edit's undo are the framework's.
pub let text_input<e> = pure (spec: FieldSpec<e>) -> Node<e> =>
  Node { kind: Editable(spec), tag: "TextInput", label: spec.placeholder }

/// A read-only text field showing `value`: its text can be selected and copied, but raises no
/// edit, so it asks for none.
pub let read_only_input<e> = pure (value: string) -> Node<e> => {
  // Written, not left to its default, and through an annotation: a `None` in a field of a
  // generic literal is not typed from the field yet (todo.md).
  let no_step: Maybe<(i64) -> e> = None
  text_input(FieldSpec::<e> {
    value: value,
    read_only: true,
    on_edit: (_: string) -> e => panic("a read-only field raised an edit"),
    on_step: no_step,
  })
}

impl Node<e> {
  /// The node with these classes, space-separated (`"card wide"`), added to its own.
  pub let with_class = pure (self, classes: string) -> Node<e> =>
    Node { self | class: if self.class.len() == 0 { classes } else { "${self.class} ${classes}" } }

  /// The node with `style` laid over its inline style.
  pub let with_style = pure (self, style: ref Style) -> Node<e> =>
    Node { self | style: style.over(self.style) }

  /// The node marked as part `name` of the component it is in, for a `Component::name` rule.
  pub let with_part = pure (self, name: string) -> Node<e> => Node { self | part: name }

  /// The node with `key` in its identity in place of its index among its siblings: an item
  /// of a list keeps its state when others are inserted before it.
  pub let keyed = pure (self, key: string) -> Node<e> => Node { self | key: key }

  /// The node read to assistive technology as `label`, rather than its visible text.
  pub let labelled = pure (self, label: string) -> Node<e> => Node { self | label: label }

  /// The node heard by assistive technology as `role`, whatever its kind makes it.
  pub let with_role = pure (self, role: Role) -> Node<e> =>
    Node { self | role: Some(role) }

  /// The node disabled while `off` holds: a control that takes no input, `:disabled`.
  pub let disabled_if = pure (self, off: bool) -> Node<e> => Node { self | disabled: off }

  /// The node with a tooltip: `words` in a small box by the pointer once it rests on the node
  /// for [TIP_DELAY_MS] (`Tooltip`), gone when it leaves the node or presses, and heard as the
  /// node's description by assistive technology.
  pub let tooltip = pure (self, words: string) -> Node<e> =>
    Node { self | tip: [text::<e>(words)] }

  /// The node with `tip` as its tooltip, as [tooltip] shows its text: a tip with structure — a
  /// command's name and its shortcut. Nothing in it takes input.
  pub let tooltip_node = pure (self, tip: Node<e>) -> Node<e> =>
    Node { self | tip: [tip] }

  /// The node as a title bar the program draws (`ui.app`'s `DrawnTitleBar`): a press on it,
  /// but on one of its controls, moves the window, as the system's title bar's would.
  pub let window_drag = pure (self) -> Node<e> => Node { self | drags_window: true }

  /// The node with every event its controls raise passed through `f` — a component written
  /// for its own event type, placed in a tree of another's (Elm's `Html.map`):
  /// `settings_panel(s).map(SettingsSaid)`.
  pub let map<b> = pure (self, f: pure (e) -> b) -> Node<b> => Node {
    kind: mapped_kind(self.kind, f),
    tag: self.tag,
    class: self.class,
    part: self.part,
    style: self.style,
    children: [child in self.children | child.map(f)],
    key: self.key,
    label: self.label,
    disabled: self.disabled,
    drags_window: self.drags_window,
    tip: [t in self.tip | t.map(f)],
    role: self.role,
  }

  /// A painted element ([painted]) taking input raw ([RawInput]): every key and the text it
  /// types while focused, the pointer while it is over it or holds it. Any other node
  /// unchanged.
  pub let takes_input = pure (self, raw: RawInput<e>) -> Node<e> => match self.kind {
    Painted(painter) => {
      let kind: Kind<e> = Painted(Painter { painter | input: Some(raw) })
      Node { self | kind: kind }
    },
    _ => self,
  }

  /// A dock ([dock]) whose tabs tear off: one let go outside every window of the program
  /// raises `on_tear` with where a window of its own would go ([DockTear]) — the program opens
  /// one there, holding a dock of that panel (`ui.app`'s `App.windows`). A dock's only panel
  /// does not tear off: its window is already its own. Any other node unchanged.
  pub let tears_off = pure (self, on_tear: pure (DockTear) -> e) -> Node<e> =>
    match self.kind {
      Docked(spec) => {
        let kind: Kind<e> = Docked(DockSpec { spec | on_tear: Some(on_tear) })
        Node { self | kind: kind }
      },
      _ => self,
    }

  /// A row or column with its children placed by `main` and `cross`; any other node unchanged.
  pub let aligned = pure (self, main: MainAlign, cross: CrossAlign) -> Node<e> =>
    match self.kind {
      Flow(axis, _, _) => {
        let kind: Kind<e> = Flow(axis, main, cross)
        Node { self | kind: kind }
      },
      _ => self,
    }
}

/// `kind` with its events passed through `f`: a control's own, and a slider's or field's
/// through its function. Every other kind is the same in either event type.
let mapped_kind<a, b> = pure (kind: Kind<a>, f: pure (a) -> b) -> Kind<b> => match kind {
  Flow(axis, main, cross) => Flow(axis, main, cross),
  Grow(flex) => Grow(flex),
  Layers => Layers,
  Pin(edges) => Pin(edges),
  Inset(space) => Inset(space),
  Place(at) => Place(at),
  Measured(w, h) => Measured(w, h),
  Scrolls(axis, offset) => Scrolls(axis, offset),
  Words(content) => Words(content),
  Texels(texture, texels, size) => Texels(texture, texels, size),
  Pictured(source, size) => Pictured(source, size),
  Theming(theme, sheet) => Theming(theme, sheet),
  Scope(sheet) => Scope(sheet),
  Pressable(event) => Pressable(f(event)),
  Checkable(checked, event) => Checkable(checked, f(event)),
  Ranged(spec) => Ranged(SliderSpec {
    value: spec.value,
    min: spec.min,
    max: spec.max,
    step: spec.step,
    on_change: (v: f32) -> b => f((spec.on_change)(v)),
  }),
  Choosing(spec) => Choosing(SelectSpec {
    options: spec.options,
    selected: spec.selected,
    on_change: (i: i64) -> b => f((spec.on_change)(i)),
    separators: spec.separators,
    option_families: spec.option_families,
  }),
  PopsUp(open, side, dismissed) => PopsUp(open, side, f(dismissed)),
  Modal(open, dismissed) => Modal(open, f(dismissed)),
  Opens(spec) => Opens(MenuSpec { entries: mapped_entries(spec.entries, f), side: spec.side, in_bar: spec.in_bar }),
  Spelled(chord) => Spelled(chord),
  TabStrip => TabStrip,
  WindowControl(button) => WindowControl(button),
  Tabbed(spot) => Tabbed(TabSpot {
    index: spot.index,
    selected: spot.selected,
    closable: spot.closable,
    movable: spot.movable,
    on_select: (i: i64) -> b => f((spot.on_select)(i)),
    on_close: (i: i64) -> b => f((spot.on_close)(i)),
    on_move: (from: i64, to: i64) -> b => f((spot.on_move)(from, to)),
  }),
  Editable(spec) => Editable(FieldSpec {
    value: spec.value,
    placeholder: spec.placeholder,
    read_only: spec.read_only,
    on_edit: (text: string) -> b => f((spec.on_edit)(text)),
    draft: spec.draft,
    on_step: match spec.on_step {
      Some(step) => Some((n: i64) -> b => f(step(n))),
      None => None,
    },
  }),
  ColorAxis(spec) => ColorAxis(AxisSpec {
    channel: spec.channel,
    color: spec.color,
    on_change: (c: Color) -> b => f((spec.on_change)(c)),
  }),
  ColorPatch(color) => ColorPatch(color),
  Flexbox => Flexbox,
  Gridbox => Gridbox,
  Painted(painter) => {
    let on_size: Maybe<(Size) -> b> = match painter.on_size {
      Some(sized) => Some((size: Size) -> b => f(sized(size))),
      None => None,
    }
    let input: Maybe<RawInput<b>> = match painter.input {
      Some(raw) => Some(RawInput {
        on_key: (k: KeyInput) -> Maybe<b> => match (raw.on_key)(k) {
          Some(x) => Some(f(x)),
          None => None,
        },
        on_text: (t: TextInput) -> Maybe<b> => match (raw.on_text)(t) {
          Some(x) => Some(f(x)),
          None => None,
        },
        on_pointer: (p: PointerInput) -> Maybe<b> => match (raw.on_pointer)(p) {
          Some(x) => Some(f(x)),
          None => None,
        },
        caret: raw.caret,
      }),
      None => None,
    }
    Painted(Painter { paint: painter.paint, on_size: on_size, input: input })
  },
  Drags(spec) => Drags(DragSpec {
    axis: spec.axis,
    value: spec.value,
    per_unit: spec.per_unit,
    min: spec.min,
    max: spec.max,
    share: spec.share,
    on_drag: (v: f64) -> b => f((spec.on_drag)(v)),
  }),
  Radio(chosen, event) => Radio(chosen, f(event)),
  OneOf => OneOf,
  Docked(spec) => Docked(DockSpec {
    tree: spec.tree,
    on_change: (t: DockTree) -> b => f((spec.on_change)(t)),
    on_tear: match spec.on_tear {
      Some(tear) => Some((torn: DockTear) -> b => f(tear(torn))),
      None => None,
    },
  }),
  DockLeaf(path, keys) => DockLeaf(path, keys),
}

// ── Constraints ──────────────────────────────────────────────────────────────

/// The sizes a node may choose from: a least and a greatest width and height. A greatest of
/// [UNBOUNDED] is no limit.
pub struct Constraints {
  min_w: f32 = 0.0,
  max_w: f32 = UNBOUNDED,
  min_h: f32 = 0.0,
  max_h: f32 = UNBOUNDED,
}

/// No limit, in logical units: larger than any screen, small enough to add to.
pub const UNBOUNDED: f32 = 1.0e30

/// Exactly `size`.
pub let tight = pure (size: Size) -> Constraints =>
  Constraints { min_w: size.w, max_w: size.w, min_h: size.h, max_h: size.h }

/// Anything up to `size`.
pub let loose = pure (size: Size) -> Constraints =>
  Constraints { max_w: size.w, max_h: size.h }

impl Constraints {
  /// The size within these constraints nearest `size`.
  pub let constrain = pure (self, size: Size) -> Size => Size {
    w: size.w.clamp(self.min_w, self.max_w.max(self.min_w)),
    h: size.h.clamp(self.min_h, self.max_h.max(self.min_h)),
  }

  /// The constraints for what is inside `space`.
  pub let deflate = pure (self, space: Insets) -> Constraints => Constraints {
    min_w: (self.min_w - space.horizontal()).max(0.0),
    max_w: if self.max_w >= UNBOUNDED {
      UNBOUNDED
    } else {
      (self.max_w - space.horizontal()).max(0.0)
    },
    min_h: (self.min_h - space.vertical()).max(0.0),
    max_h: if self.max_h >= UNBOUNDED {
      UNBOUNDED
    } else {
      (self.max_h - space.vertical()).max(0.0)
    },
  }

  /// The same greatest sizes, and no least.
  pub let loosened = pure (self) -> Constraints =>
    Constraints { self | min_w: 0.0, min_h: 0.0 }

  /// Whether the width or the height has a limit.
  pub let bounded_w = pure (self) -> bool => self.max_w < UNBOUNDED
  pub let bounded_h = pure (self) -> bool => self.max_h < UNBOUNDED
}

// ── What the framework holds ─────────────────────────────────────────────────

/// The state of the interface that is not the program's: which element has the focus, which
/// is under the pointer and which is held down (each by its identity, `""` for none), each
/// element's own state, and the viewport a sheet's media rules are asked of. `ui.interact` keeps it; [layout_with] reads it.
pub struct Interaction {
  focus: string = "",
  hover: string = "",
  pressed: string = "",
  widgets: HashMap<string, WidgetState>,
  /// Whether the focus came from the keyboard (Tab, or assistive technology) rather than the
  /// pointer: `:focus-visible`.
  keyboard_focus: bool = false,
  /// The select whose list is open, by identity — one at a time, as a browser has it.
  open: string = "",
  /// The menus open, by their openers' identities: the one opened first, then each submenu
  /// open from it ([menu_bar], [menu_button]).
  menus: []string = [],
  /// The element whose tooltip shows, by identity (`""` for none), and where in the window the
  /// pointer rested on it.
  tip: string = "",
  tip_at: Point = Point {},
  /// The window as media queries see it; a size of nothing for the constraints' own.
  viewport: Viewport = Viewport {},
  /// What each element moving a property that changes sizes shows now (`ui.motion`), by
  /// identity: laid out with those properties until they arrive.
  shown: HashMap<string, Computed>,
  /// The text typed in a field that keeps a draft ([FieldSpec.draft]) while it has the focus,
  /// by the field's identity; and the hue a colour picker holds while its colour is grey and
  /// says none, by the picker's (`ui/layout/swatch.lyra`).
  drafts: HashMap<string, string>,
  hues: HashMap<string, f32>,
  /// The tab being docked, and where it would land ([dock]): `dock` its dock's identity, `""`
  /// while none is.
  dock_drop: DockDrop = DockDrop {},
}

/// What the framework keeps for one element: a scroll's offset once the user has scrolled
/// it, and a text field's caret and the other end of its selection (`anchor`, the caret
/// itself for none), in runes; how far its text is scrolled to keep the caret in view; and
/// the edits that undo steps back through.
pub struct WidgetState {
  /// How far it is scrolled down, and across, once scrolled; and where on a scrollbar's thumb
  /// the pointer took hold of it, while it drags one.
  scroll: Maybe<f32> = None,
  scroll_x: Maybe<f32> = None,
  /// Whether it was at its end when last scrolled (or has not been): a scroller that follows
  /// its end (`scroll_follow`) is kept there while this holds.
  following: bool = true,
  grab: f32 = 0.0,
  caret: i64 = 0,
  anchor: i64 = 0,
  field_scroll: f32 = 0.0,
  undo: []Edit = [],
}

/// A text field's value and caret, before an edit.
pub struct Edit {
  value: string,
  caret: i64,
}

/// No focus, nothing under the pointer, no element's state.
pub let interaction_new = pure () -> Interaction =>
  Interaction {
    widgets: hashmap_new(),
    shown: hashmap_new(),
    drafts: hashmap_new(),
    hues: hashmap_new(),
  }

// ── The laid-out tree ────────────────────────────────────────────────────────

/// A node laid out: its identity (`id`), tag and classes; its kind, which says what input it
/// takes and the events it raises; its role and label; the size it chose; its settled style;
/// what it draws itself (at `content_at`, inside its padding); whether it clips its children
/// to its box; the focus ring to draw round it; a text field's caret and selection; and its
/// children, each at its offset from this node's top-left corner.
pub struct Laid<e> {
  id: string = "",
  tag: string = "",
  class: string = "",
  kind: Kind<e>,
  role: Role = NoRole,
  label: string = "",
  size: Size,
  style: Computed,
  content: Content = Blank,
  content_at: Point = Point {},
  clips: bool = false,
  ring: Maybe<Color> = None,
  field: Maybe<FieldLook> = None,
  children: []Placed<e> = [],
  /// What it scrolls, if its overflow is not visible on an axis.
  scroller: Maybe<Scroller> = None,
  /// Whether it or anything in it has a transition (`ui.motion`), which a frame looks in for.
  moves: bool = false,
  /// Whether it takes no input ([Node.disabled]).
  disabled: bool = false,
  /// Whether it floats over everything (an open select's list, a popup's content): painted
  /// after the whole tree, outside every clip, and hit before anything else (`ui.interact`'s
  /// `hit`); where it goes against the element it floats from ([place_floats]); and whether
  /// anything in it floats, for that pass to look in.
  floats: bool = false,
  anchor: Maybe<Anchor> = None,
  floating: bool = false,
  /// Whether a press on it moves the window ([Node.window_drag]).
  drags_window: bool = false,
  /// Whether it has a tooltip ([Node.tooltip]), and the tooltip's text, which assistive
  /// technology reads as its description.
  tipped: bool = false,
  description: string = "",
  /// A colour picker's square's or strip's hue as it is drawn: the colour's own, or the one the
  /// picker holds while the colour is grey (`Interaction.hues`).
  hue: f32 = 0.0,
  /// The media queries this node's sheets, and those below it, asked of the viewport, and
  /// their answers: while they answer the same, so does its layout.
  media: []MediaAnswer = [],
}

/// A laid-out child and its offset from its parent's top-left corner.
pub struct Placed<e> {
  at: Point,
  laid: Laid<e>,
}

/// Where a floating element goes against the element it floats from — its parent, whose box
/// is the anchor: below it, or beside it (a submenu's), `gap` apart. [place_floats] puts it
/// there after the layout, within the window.
pub struct Anchor {
  side: FloatSide = FloatBelow,
  gap: f32 = FLOAT_GAP,
}

/// Below the anchor (flipped above it where the window's foot leaves no room), or beside it
/// (to its right, or its left where the window's right edge leaves none); or the framework's
/// own two: below a point in the window, the pointer's (a tooltip's, flipped above it the same
/// way), or over the whole window from its corner (a modal's scrim).
pub data FloatSide = FloatBelow | FloatBeside | FloatPointer(Point) | FloatWindow

/// How far a floating element stands from its anchor, and in from the window's edges.
const FLOAT_GAP: f32 = 2.0
const FLOAT_MARGIN: f32 = 4.0

/// How far below the pointer a tooltip goes — clear of the arrow — and how long the pointer
/// rests on an element before its tooltip shows, in milliseconds: macOS's half a second.
const TIP_BELOW: f32 = 18.0
pub const TIP_DELAY_MS: i64 = 500

/// What a node draws besides its box: nothing, a paragraph, or part of a texture at a size.
pub data Content = Blank | Prose(TextBlock) | Bitmap(
  TextureId,
  Rect,
  Size
) | Pixels(PictureSource, Size)

/// How a text field is drawn: its text's colour (the placeholder's while it is empty), how
/// far its text is scrolled, the caret's and the selection's ends across its text (each from
/// the text's start), their colours, how tall a line is, and whether it has the focus.
pub struct FieldLook {
  color: Color,
  scroll: f32 = 0.0,
  caret: f32 = 0.0,
  selection_from: f32 = 0.0,
  selection_to: f32 = 0.0,
  caret_color: Color,
  selection_color: Color,
  line_height: f32 = 0.0,
  focused: bool = false,
}

/// `root` laid out within `c`, in the light theme until a [themed] node says otherwise, its
/// text set in `fonts`, with nothing focused, hovered or scrolled.
pub let layout<e> = (root: Node<e>, c: Constraints, fonts: mut Fonts) -> Laid<e> =>
  layout_with(root, c, fonts, interaction_new())

/// `root` laid out as [layout] does, with the framework's state: the focused, hovered and
/// pressed elements' classes, scroll offsets and text fields' carets.
pub let layout_with<e> = (
  root: Node<e>,
  c: Constraints,
  fonts: mut Fonts,
  ui: ref Interaction
) -> Laid<e> => {
  var cache: LayoutCache<e> = layout_cache()
  layout_cached(root, c, fonts, ui, cache)
}

/// `root` laid out as [layout_with] does, each element whose node, constraints, cascade (its
/// theme among it) and framework state are what they were last frame given back as it was
/// laid out then, from `cache` — then the frame begun in `cache` becomes the last one.
pub let layout_cached<e> = (
  root: Node<e>,
  c: Constraints,
  fonts: mut Fonts,
  ui: ref Interaction,
  cache: mut LayoutCache<e>
) -> Laid<e> => {
  cache.laid_out = 0
  cache.reused = 0
  // With no viewport given, the window is as large as the constraints allow.
  let seen = if ui.viewport.size.w > 0.0 || ui.viewport.size.h > 0.0 { ui } else {
    Interaction {
      ui |
      viewport: Viewport {
        ui.viewport |
        size: Size { w: if c.bounded_w() { c.max_w } else { 0.0 }, h: if c.bounded_h() { c.max_h } else { 0.0 } },
      },
    }
  }
  let laid = lay(root, c, cascade_root(light_theme()), fonts, seen, "#", cache)
  // The root given back is the whole of last frame given back: its entries stand as they were.
  if cache.laid_out > 0 { cache.last = cache.now }
  cache.now = hashmap_new::<string, Cached<e>>()
  place_floats(laid, seen.viewport.size)
}

/// `laid` with each floating element that has an [Anchor] placed against its anchor within a
/// window `window` large (a side of nothing for no edge that way): below the anchor where it
/// fits, else above where that fits, else as low as it fits — over the anchor — and moved in
/// from the window's left and right; beside it the same way across. Placed from the anchor,
/// never from where it was, so a layout given back from the cache is placed alike. Only what
/// holds a float is walked ([Laid.floating]).
let place_floats<e> = pure (laid: Laid<e>, window: Size) -> Laid<e> =>
  if laid.floating { placed_within(laid, Point {}, window) } else { laid }

/// [place_floats] below `laid`, whose top-left corner is at `origin` in the window.
let placed_within<e> = pure (laid: Laid<e>, origin: Point, window: Size) -> Laid<e> => {
  var children: []Placed<e> = []
  for child in laid.children {
    if !child.laid.floats && !child.laid.floating {
      children.push(child)
      continue
    }
    var at = child.at
    if child.laid.floats {
      if let Some(anchor) = child.laid.anchor {
        let box = Rect { x: origin.x, y: origin.y, w: laid.size.w, h: laid.size.h }
        let spot = float_spot(anchor, box, child.laid.size, window)
        at = Point { x: spot.x - origin.x, y: spot.y - origin.y }
      }
    }
    let corner = Point { x: origin.x + at.x, y: origin.y + at.y }
    let inner = if child.laid.floating { placed_within(
      child.laid,
      corner,
      window
    ) } else { child.laid }
    children.push(Placed { at: at, laid: inner })
  }
  Laid { laid | children: children }
}

/// Where a floating element `size` large goes in the window against the anchor `box`.
let float_spot = pure (anchor: Anchor, box: Rect, size: Size, window: Size) -> Point =>
  match anchor.side {
    FloatBelow => Point {
      x: within_edges(box.x, size.w, window.w),
      y: flipped(box.y + box.h + anchor.gap, box.y - anchor.gap - size.h, size.h, window.h),
    },
    FloatBeside => Point {
      x: flipped(box.x + box.w + anchor.gap, box.x - anchor.gap - size.w, size.w, window.w),
      y: within_edges(box.y, size.h, window.h),
    },
    FloatPointer(at) => Point {
      x: within_edges(at.x, size.w, window.w),
      y: flipped(at.y + TIP_BELOW, at.y - anchor.gap - size.h, size.h, window.h),
    },
    FloatWindow => Point {},
  }

/// Where something `length` long starts along an axis `room` long: at `after` (past the
/// anchor) where it fits there, else at `before` (ahead of it) where that fits, else moved in
/// to fit — over the anchor. A room of nothing has no end.
let flipped = pure (after: f32, before: f32, length: f32, room: f32) -> f32 => {
  if room <= 0.0 || after + length <= room { return after }
  if before >= 0.0 { return before }
  within_edges(after, length, room)
}

/// `start`, where something `length` long fits in a room from there; else moved in to leave
/// [FLOAT_MARGIN] at the end it passed — or at the room's start, where it is longer than the
/// room. A room of nothing has no ends.
let within_edges = pure (start: f32, length: f32, room: f32) -> f32 => {
  if room <= 0.0 || (start >= 0.0 && start + length <= room) { return start }
  start.min(room - FLOAT_MARGIN - length).max(FLOAT_MARGIN)
}

/// What laid out each element last frame, and this frame so far, by identity — two frames
/// at most, so an element gone from the tree is gone from the cache a frame later — and how
/// many elements the last layout laid out afresh and gave back.
pub struct LayoutCache<e> {
  last: HashMap<string, Cached<e>>,
  now: HashMap<string, Cached<e>>,
  laid_out: i64 = 0,
  reused: i64 = 0,
}

/// One element's layout, and what it was laid out from.
struct Cached<e> {
  node: Node<e>,
  c: Constraints,
  cascade: Cascade,
  state: string,
  laid: Laid<e>,
}

/// A cache with nothing in it.
pub let layout_cache<e> = pure () -> LayoutCache<e> =>
  LayoutCache {
    last: hashmap_new::<string, Cached<e>>(),
    now: hashmap_new::<string, Cached<e>>()
  }

/// One node within `c`, styled at `cascade`, identified as `id`: last frame's layout of it when
/// nothing it was laid out from has changed — sound because a view is a pure function of its
/// state and an element's events are data, so equal inputs lay out equally — else afresh.
let lay<e> = (
  node: Node<e>,
  c: Constraints,
  cascade: ref Cascade,
  fonts: mut Fonts,
  ui: ref Interaction,
  id: string,
  cache: mut LayoutCache<e>
) -> Laid<e> => {
  let state = state_under(ui, id)
  if let Some(old) = cache.last.get(id) {
    if old.state == state && old.c == c && same_node(old.node, node, cascade.theme) &&
      old.cascade == cascade && still_answers(old.laid.media, ui.viewport) {
      cache.reused += 1
      // The layout is last frame's; what its elements raise is this frame's.
      let laid = refreshed(old.laid, node)
      // The root needs no entries carried: last frame's all stand (layout_cached).
      if id != "#" {
        carry(cache, old.laid)
        cache.now.insert(id, Cached { old | node: node, laid: laid })
      }
      return laid
    }
  }
  cache.laid_out += 1
  let laid = lay_fresh(node, c, cascade, fonts, ui, id, cache)
  cache.now.insert(
    id,
    Cached { node: node, c: c, cascade: cascade, state: state, laid: laid }
  )
  laid
}

/// Whether every media query a layout asked would answer `viewport` as it did then — a
/// resize that crosses no breakpoint changes nothing a sheet decides.
let still_answers = pure (asked: []MediaAnswer, viewport: Viewport) -> bool =>
  asked.all((a) => media_matches(a.media, viewport) == a.matched)

/// Every element below `laid` kept from last frame for the next, as `laid` is — so a change
/// inside it next frame finds its unchanged siblings.
let carry<e> = (cache: mut LayoutCache<e>, laid: Laid<e>) -> void => {
  for child in laid.children {
    if let Some(old) = cache.last.get(child.laid.id) { cache.now.insert(
      child.laid.id,
      old
    ) }
    carry(cache, child.laid)
  }
}

/// `laid`, laid out from a node equal to `node` in all but its events, with each element's kind
/// — which says what it raises — taken from `node` and its children's.
let refreshed<e> = (laid: Laid<e>, node: Node<e>) -> Laid<e> => {
  let kids = match node.kind {
    TabStrip => strip_children(laid, node),
    _ => laid_children(node),
  }
  var children: []Placed<e> = []
  for k, p in laid.children {
    var mine = p.laid
    // Most kinds lay their children out in order, so the child at the same index is the one;
    // else (a slider's own parts) it is looked for.
    if k < kids.len() && child_id(laid.id, kids[k], k) == p.laid.id {
      mine = refreshed(p.laid, kids[k])
    } else {
      for i, child in kids {
        if child_id(laid.id, child, i) == p.laid.id { mine = refreshed(p.laid, child) }
      }
    }
    children.push(Placed { p | laid: mine })
  }
  Laid { laid | kind: kept_draft(node.kind, laid.kind), children: children }
}

/// `node` as a field keeping a draft shows it: its value the text typed, while there is one
/// ([FieldSpec.draft]) — what layout, editing and every caret position then read. Any other
/// node is itself, not a copy: this is asked of every node laid out.
let drafted<e> = pure (node: Node<e>, ui: ref Interaction, id: string) -> Node<e> => {
  if ui.drafts.len() == 0 { return node }
  match node.kind {
    Editable(spec) => if spec.draft {
      match ui.drafts.get(id) {
        Some(typed) => Node { node | kind: Editable(FieldSpec { spec | value: typed }) },
        None => node,
      }
    } else { node },
    _ => node,
  }
}

/// `kind` refreshed from the cache with a draft `laid` showed kept (the cache was keyed on it).
let kept_draft<e> = pure (kind: Kind<e>, laid: Kind<e>) -> Kind<e> => match kind {
  Editable(fresh) => if fresh.draft {
    match laid {
      Editable(old) => Editable(FieldSpec { fresh | value: old.value }),
      _ => kind,
    }
  } else { kind },
  _ => kind,
}

/// The nodes a layout of `node` holds as its children: its own, but for what floats from a
/// popup or an opener — the framework's holder around a popup's content, a menu's list made
/// from its entries — so a layout from the cache is refreshed through them too.
let laid_children<e> = pure (node: Node<e>) -> []Node<e> => match node.kind {
  PopsUp(_, _, _) =>
    if node.children.len() > 1 { [node.children[0], popup_holder(node.children[1])] } else { node.children },
  Modal(_, _) =>
    if node.children.len() > 1 { [node.children[0], modal_scrim(node.children[1])] } else { node.children },
  Opens(spec) =>
    if node.children.len() > 0 { [node.children[0], menu_list::<e>(spec.entries)] } else { node.children },
  // Its glyph's events are none, so whichever glyph it shows refreshes alike.
  WindowControl(button) => [window_glyph::<e>(button, false)],
  _ => node.children,
}

/// The framework's state that reaches the element identified as `id` and those inside it:
/// focus, hover and press among them, and each one's own state — as a string to compare.
let state_under = pure (ui: ref Interaction, id: string) -> string => {
  let inside = (other: string) -> bool => other == id || other.starts_with("${id}/")
  // A window maximized or put back shows its maximize button otherwise (`window_buttons`) —
  // and is resized, so it is all laid out again then anyway.
  var out = if ui.viewport.maximized { "maximized" } else { "" }
  for holder in [ui.focus, ui.hover, ui.pressed, ui.open] {
    out = "${out}|${if inside(holder) { holder } else { "" }}"
  }
  for opened in ui.menus {
    if inside(opened) { out = "${out}|menu ${opened}" }
  }
  if inside(ui.tip) { out = "${out}|tip ${ui.tip}@${ui.tip_at.x},${ui.tip_at.y}" }
  if ui.dock_drop.dock.len() > 0 && inside(ui.dock_drop.dock) {
    out = "${out}|${dock_drop_key(ui.dock_drop)}"
  }
  if ui.drafts.len() > 0 {
    for (key, typed) in ui.drafts.entries() {
      if inside(key) { out = "${out}|draft ${key}:${typed}" }
    }
  }
  if ui.hues.len() > 0 {
    for (key, hue) in ui.hues.entries() {
      if inside(key) { out = "${out}|hue ${key}:${hue}" }
    }
  }
  for (key, w) in ui.widgets.entries() {
    if inside(key) {
      out = "${out}|${key}:${w.scroll ?? -1.0}:${w.scroll_x ?? -1.0}:${w.following}:${w.caret}:${w.anchor}:${w.field_scroll}"
    }
  }
  // An element whose sizes are moving lays out afresh each frame they move.
  for (key, moving) in ui.shown.entries() {
    if inside(key) { out = "${out}|${key}~${layout_key(moving)}" }
  }
  out
}

/// `node`'s narrowest — the width below which its content overflows, a flex row's items at
/// their least (`intrinsic_width`'s `shrunk`), so `min-width: 0` lets an item go as it does
/// in a browser — from last frame's layout of it when the node, its cascade,
/// the focus, hover and press inside it and its media answers are as they were — what the
/// width depends on, so a resize or a scroll gives it back — else measured.
let narrowest_of<e> = (
  node: Node<e>,
  cascade: ref Cascade,
  fonts: mut Fonts,
  ui: ref Interaction,
  id: string,
  cache: mut LayoutCache<e>
) -> f32 => {
  if let Some(old) = cache.last.get(id) {
    if let Some(sc) = old.laid.scroller {
      if sc.narrowest > 0.0 && sc.marks == marks_under(
        ui,
        id
      ) && old.cascade == cascade &&
        still_answers(
          old.laid.media,
          ui.viewport
        ) && same_node(old.node, node, cascade.theme) {
        return sc.narrowest
      }
    }
  }
  intrinsic_width(node, true, cascade, fonts, ui, id, false, true, true)
}

/// The focus, hover and press at or inside `id` — the part of [state_under] that can change a
/// style, and so a width.
let marks_under = pure (ui: ref Interaction, id: string) -> string => {
  let inside = (other: string) -> bool => other == id || other.starts_with("${id}/")
  [holder in [
    ui.focus,
    ui.hover,
    ui.pressed
  ] | if inside(holder) { holder } else { "" }].join("|")
}

/// Whether `a` and `b` lay out alike in `theme`: every field and child the same, events aside
/// — a control's events never change its layout, and a component's sheet compared as its
/// theme makes it.
let same_node<e> = (a: Node<e>, b: Node<e>, theme: Theme) -> bool => {
  if a.tag != b.tag || a.class != b.class || a.part != b.part || a.key != b.key {
    return false
  }
  if a.label != b.label || a.style != b.style || a.children.len() != b.children.len() {
    return false
  }
  // A control disabled or enabled is styled anew (`:disabled`, `:enabled`) and takes input or
  // none: not the same layout, though nothing else about it changed.
  if a.disabled != b.disabled || a.drags_window != b.drags_window { return false }
  if !same_kind(a.kind, b.kind, theme) { return false }
  if a.role != b.role || a.tip.len() != b.tip.len() { return false }
  for i in 0..<a.tip.len() {
    if !same_node(a.tip[i], b.tip[i], theme) { return false }
  }
  for i in 0..<a.children.len() {
    if !same_node(a.children[i], b.children[i], theme) { return false }
  }
  true
}

let same_kind<e> = (a: Kind<e>, b: Kind<e>, theme: Theme) -> bool => match (a, b) {
  (Flow(x1, m1, c1), Flow(x2, m2, c2)) => x1 == x2 && m1 == m2 && c1 == c2,
  (Grow(f1), Grow(f2)) => same_f32(f1, f2),
  (Layers, Layers) => true,
  (Pin(e1), Pin(e2)) => e1 == e2,
  (Inset(i1), Inset(i2)) => i1 == i2,
  (Place(p1), Place(p2)) => p1 == p2,
  (Measured(w1, h1), Measured(w2, h2)) => w1 == w2 && h1 == h2,
  (Scrolls(x1, o1), Scrolls(x2, o2)) => x1 == x2 && same_f32(o1, o2),
  (Words(t1), Words(t2)) => t1 == t2,
  (Texels(t1, r1, s1), Texels(t2, r2, s2)) => t1 == t2 && r1 == r2 && s1 == s2,
  (Pictured(p1, s1), Pictured(p2, s2)) =>
    p1.key == p2.key && p1.revision == p2.revision && s1 == s2,
  (Theming(t1, s1), Theming(t2, s2)) => t1 == t2 && s1 == s2,
  (Scope(f1), Scope(f2)) => f1(theme) == f2(theme),
  (Pressable(_), Pressable(_)) => true,
  (Checkable(on1, _), Checkable(on2, _)) => on1 == on2,
  (Ranged(r1), Ranged(r2)) =>
    same_f32(
      r1.value,
      r2.value
    ) && same_f32(r1.min, r2.min) && same_f32(r1.max, r2.max) &&
    same_f32(r1.step, r2.step),
  (Editable(f1), Editable(f2)) =>
    f1.value == f2.value && f1.placeholder == f2.placeholder && f1.draft == f2.draft,
  (Choosing(s1), Choosing(s2)) =>
    s1.selected == s2.selected && s1.options == s2.options && s1.separators == s2.separators,
  (PopsUp(open1, side1, _), PopsUp(open2, side2, _)) => open1 == open2 && side1 == side2,
  (Modal(open1, _), Modal(open2, _)) => open1 == open2,
  (Opens(m1), Opens(m2)) =>
    m1.side == m2.side && m1.in_bar == m2.in_bar && same_entries(m1.entries, m2.entries),
  (Spelled(c1), Spelled(c2)) => c1 == c2,
  (TabStrip, TabStrip) => true,
  (WindowControl(b1), WindowControl(b2)) => b1 == b2,
  (ColorAxis(a1), ColorAxis(a2)) => a1.channel == a2.channel && a1.color == a2.color,
  (ColorPatch(c1), ColorPatch(c2)) => c1 == c2,
  (Tabbed(t1), Tabbed(t2)) =>
    t1.index == t2.index && t1.selected == t2.selected && t1.closable == t2.closable && t1.movable == t2.movable,
  (Flexbox, Flexbox) => true,
  (Gridbox, Gridbox) => true,
  // What a painter draws is asked at paint, not kept with the layout: its box lays out alike.
  (Painted(_), Painted(_)) => true,
  (Drags(d1), Drags(d2)) => d1.axis == d2.axis,
  (Radio(c1, _), Radio(c2, _)) => c1 == c2,
  (OneOf, OneOf) => true,
  // What a dock lays out is its child's; the tree is for its events.
  (Docked(_), Docked(_)) => true,
  (DockLeaf(p1, k1), DockLeaf(p2, k2)) => p1 == p2 && k1 == k2,
  _ => false,
}

/// Whether two numbers are the same number — what a layout reads of them.
let same_f32 = pure (a: f32, b: f32) -> bool => !(a < b) && !(a > b)

/// The identity of `node`, child `index` of the node identified as `parent`.
pub let child_id<e> = pure (parent: string, node: Node<e>, index: i64) -> string =>
  if node.key.len() > 0 { "${parent}/:${node.key}" } else { "${parent}/${index}" }

/// Whether an element of `kind` takes the focus: a control.
pub let focusable<e> = pure (kind: Kind<e>) -> bool => match kind {
  Pressable(_) => true,
  Checkable(_, _) => true,
  Ranged(_) => true,
  Editable(_) => true,
  Choosing(_) => true,
  Opens(_) => true,
  Tabbed(_) => true,
  ColorAxis(_) => true,
  Painted(painter) => painter.input.is_some(),
  Radio(_, _) => true,
  _ => false,
}

/// Whether `kind` is a painter's.
let is_painted<e> = pure (kind: Kind<e>) -> bool => match kind {
  Painted(_) => true,
  _ => false,
}

/// One node within `c`, styled at `cascade`, identified as `id`, laid out afresh.
let lay_fresh<e> = (
  written: Node<e>,
  given: Constraints,
  cascade: ref Cascade,
  fonts: mut Fonts,
  ui: ref Interaction,
  id: string,
  cache: mut LayoutCache<e>
) -> Laid<e> => {
  // A field keeping a draft lays it out, the draft its value.
  let node = drafted(written, ui, id)
  let styled = styled_at(node, cascade, ui, id)
  let own = styled.own
  let style = styled.style
  let within = styled.within
  let space = styled.space
  // The sizes the element asks for, within what its parent allows.
  let c = sized_by(given, style)
  let port_c = c.deflate(space)
  let ctx = Ctx { cascade: within, ui: ui, id: id, gap: style.gap }
  // An axis whose overflow is not visible lays its content out open — down, as tall as it
  // wants; across, at the port's width unless its narrowest is wider — and shows it through
  // the port. A Scroll element is overflow auto on its axis.
  let (ox, oy) = overflows(node.kind, style)
  let scrolls = ox != OverflowVisible || oy != OverflowVisible
  var inner = port_c
  var narrowest: f32 = 0.0
  if scrolls {
    let across = if ox == OverflowVisible { port_c.max_w } else if legacy_across(node.kind) {
      UNBOUNDED
    } else {
      narrowest = narrowest_of(node, cascade, fonts, ui, id, cache)
      port_c.max_w.max(narrowest - space.horizontal())
    }
    inner = Constraints {
      min_w: port_c.min_w,
      max_w: across,
      min_h: port_c.min_h,
      max_h: if oy == OverflowVisible { port_c.max_h } else { UNBOUNDED },
    }
  }
  let body: Body<e> = match node.kind {
    Flow(axis, main, cross) =>
      lay_line(node.children, axis, main, cross, inner, true, ctx, fonts, cache),
    Layers => lay_layers(node.children, inner, ctx, fonts, cache),
    Place(at) => {
      let content = lay_wrapped(node.children, inner.loosened(), ctx, fonts, cache)
      let w = if inner.bounded_w() { inner.max_w } else { content.size.w }
      let h = if inner.bounded_h() { inner.max_h } else { content.size.h }
      let size = inner.constrain(Size { w: w, h: h })
      let shift = Point {
        x: (size.w - content.size.w) * at.x,
        y: (size.h - content.size.h) * at.y,
      }
      Body { size: size, children: moved(content.children, shift) }
    },
    Measured(w, h) => {
      let wanted = Constraints {
        min_w: w ?? inner.min_w,
        max_w: w ?? inner.max_w,
        min_h: h ?? inner.min_h,
        max_h: h ?? inner.max_h,
      }
      // The size asked for, within what the parent allows.
      let fixed = Constraints {
        min_w: wanted.min_w.clamp(inner.min_w, inner.max_w),
        max_w: wanted.max_w.clamp(inner.min_w, inner.max_w),
        min_h: wanted.min_h.clamp(inner.min_h, inner.max_h),
        max_h: wanted.max_h.clamp(inner.min_h, inner.max_h),
      }
      let content = lay_wrapped(node.children, fixed, ctx, fonts, cache)
      Body { size: fixed.constrain(content.size), children: content.children }
    },
    Words(content) => {
      let block = fonts.lay_out(content, style.font, inner.max_w)
      Body::<e> {
        size: inner.constrain(Size { w: block.width, h: block.height }),
        content: Prose(block),
      }
    },
    Texels(texture, texels, natural) => {
      Body::<e> {
        size: inner.constrain(natural),
        content: Bitmap(texture, texels, natural)
      }
    },
    Pictured(source, natural) =>
      Body::<e> { size: inner.constrain(natural), content: Pixels(source, natural) },
    Ranged(spec) => lay_slider(spec, inner, ctx, fonts, cache),
    Editable(spec) => lay_field(spec, inner, style, ctx, fonts),
    Choosing(spec) => lay_select(node.children, spec, inner, space, ctx, fonts, cache),
    PopsUp(open, side, _) =>
      lay_popup(node.children, open, side, inner, ctx, fonts, cache),
    Modal(open, _) => lay_modal(node.children, open, inner, ctx, fonts, cache),
    Docked(_) => lay_docked(node.children, inner, ctx, fonts, cache),
    Opens(spec) => lay_opens(node.children, spec, inner, ctx, fonts, cache),
    TabStrip => lay_tab_strip(node.children, inner, ctx, fonts, cache),
    WindowControl(button) => lay_window_control(button, inner, ctx, fonts, cache),
    ColorAxis(spec) => Body::<e> { size: inner.constrain(axis_size(spec.channel)) },
    // All the room it is given, as a painter's.
    ColorPatch(_) => Body::<e> {
      size: inner.constrain(Size { w: if inner.bounded_w() { inner.max_w } else { 0.0 }, h: if inner.bounded_h() { inner.max_h } else { 0.0 } }),
    },
    Spelled(chord) => {
      let block = fonts.lay_out(
        chord_text(chord, ui.viewport.apple),
        style.font,
        inner.max_w
      )
      Body::<e> {
        size: inner.constrain(Size { w: block.width, h: block.height }),
        content: Prose(block),
      }
    },
    Flexbox => lay_flex(node.children, style, inner, ctx, fonts, cache),
    Gridbox => lay_grid(node.children, style, inner, ctx, fonts, cache),
    // All the room it is given, on each axis that has a limit; nothing on one that has none.
    Painted(_) => {
      let w = if inner.bounded_w() { inner.max_w } else { 0.0 }
      let h = if inner.bounded_h() { inner.max_h } else { 0.0 }
      Body::<e> { size: inner.constrain(Size { w: w, h: h }) }
    },
    // A wrapper of its children: Grow, Pin, Inset, Theming, Scope, Pressable and Checkable.
    _ => {
      let content = lay_wrapped(node.children, inner, ctx, fonts, cache)
      Body { size: content.size, children: content.children }
    },
  }
  // What scrolls: the port is the content within the element's constraints (a Scroll element
  // fills them on its axis), the offset the user's or the program's, clamped to the room.
  var shown = body.size
  var offset = Point {}
  var scroller: Maybe<Scroller> = None
  if scrolls {
    let fill = filling(node.kind)
    let port = Size {
      w: if ox == OverflowVisible { body.size.w } else if fill == Some(Horizontal) && port_c.bounded_w() {
        port_c.max_w
      } else {
        body.size.w.clamp(port_c.min_w, port_c.max_w.max(port_c.min_w))
      },
      h: if oy == OverflowVisible { body.size.h } else if fill == Some(Vertical) && port_c.bounded_h() {
        port_c.max_h
      } else {
        body.size.h.clamp(port_c.min_h, port_c.max_h.max(port_c.min_h))
      },
    }
    let held = ui.widgets.get(id) ?? WidgetState {}
    let start = initial_offset(node.kind)
    let spare = Size {
      w: (body.size.w - port.w).max(0.0),
      h: (body.size.h - port.h).max(0.0)
    }
    offset = Point {
      x: if ox == OverflowClip { 0.0 } else { (held.scroll_x ?? start.x).clamp(0.0, spare.w) },
      y: if oy == OverflowClip { 0.0 } else if style.scroll_follow && held.following {
        // At its end it stays there, however far the content grew.
        spare.h
      } else {
        (held.scroll ?? start.y).clamp(0.0, spare.h)
      },
    }
    shown = port
    let bar_rules = scrollbar_rules(within.theme.colors)
    let track = within.compute("ScrollTrack", "", "", Style {}, bar_rules)
    scroller = Some(Scroller {
      content: body.size,
      port: Rect { x: space.left, y: space.top, w: port.w, h: port.h },
      offset: offset,
      x: ox,
      y: oy,
      track: track,
      thumb_x: within.compute("ScrollThumb", with_state("", "${id}#thumb-x", ui), "", Style {}, bar_rules),
      thumb_y: within.compute("ScrollThumb", with_state("", "${id}#thumb-y", ui), "", Style {}, bar_rules),
      narrowest: narrowest,
      marks: marks_under(ui, id),
    })
  }
  let size = c.constrain(Size {
    w: shown.w + space.horizontal(),
    h: shown.h + space.vertical(),
  })
  let corner = Point { x: space.left - offset.x, y: space.top - offset.y }
  var children = moved(body.children, corner)
  // A tooltip showing floats by the pointer, wherever the element scrolled its children.
  if node.tip.len() > 0 && ui.tip == id { children.push(lay_tip(
    node.tip[0],
    ui.tip_at,
    ctx,
    fonts,
    cache
  )) }
  let role = node.role ?? role_of(node.kind)
  Laid {
    id: id,
    tag: node.tag,
    class: node.class,
    kind: node.kind,
    role: role,
    // A shortcut's text is the layout's, spelled for the platform.
    label: match node.kind {
      Spelled(chord) => chord_text(chord, ui.viewport.apple),
      _ => label_of(node, children),
    },
    size: size,
    // The style the cascade asks for — what a transition moves towards — not what was laid
    // out with while one moves; a frame blends what is shown in (`ui.interact`).
    style: styled.goal,
    content: body.content,
    content_at: Point { x: corner.x - body.scrolled, y: corner.y },
    clips: body.clips || scrolls,
    // A painter taking input draws its own focus (a terminal's cursor), not a ring.
    ring: if ui.focus == id && focusable(node.kind) && !is_painted(node.kind) {
      Some(own.theme.colors.focus)
    } else {
      None
    },
    field: body.field,
    children: children,
    scroller: scroller,
    moves: styled.goal.transition.len() > 0 || children.any((p) => p.laid.moves),
    floating: children.any((p) => p.laid.floats || p.laid.floating),
    disabled: node.disabled,
    drags_window: node.drags_window,
    tipped: node.tip.len() > 0,
    description: if node.tip.len() > 0 { words_in(node.tip[0]) } else { "" },
    hue: match node.kind {
      ColorAxis(spec) => axis_hue(spec.color, ui, id),
      _ => 0.0,
    },
    media: asked_below(styled.media, children),
  }
}

/// `own` media answers and those of everything in `children`, each once.
let asked_below<e> = pure (
  own: []MediaAnswer,
  children: []Placed<e>
) -> []MediaAnswer => {
  var out = [...own]
  for child in children {
    for a in child.laid.media {
      if !out.any((b) => b.media == a.media) { out.push(a) }
    }
  }
  out
}

/// The overflow across and down an element of `kind` styled `style` has: its style's, and a
/// Scroll element's axis `OverflowAuto` where its style says nothing else.
let overflows<e> = pure (kind: Kind<e>, style: ref Computed) -> (Overflow, Overflow) =>
  match kind {
    Scrolls(Horizontal, _) => (if style.overflow_x == OverflowVisible { OverflowAuto } else { style.overflow_x }, style.overflow_y),
    Scrolls(Vertical, _) => (style.overflow_x, if style.overflow_y == OverflowVisible { OverflowAuto } else { style.overflow_y }),
    _ => (style.overflow_x, style.overflow_y),
  }

/// A Scroll element across lays its content out as wide as it wants, as it always has; an
/// element's `overflow-x` lays it out at its port's width, widened only to its narrowest.
let legacy_across<e> = pure (kind: Kind<e>) -> bool => match kind {
  Scrolls(Horizontal, _) => true,
  _ => false,
}

/// The axis a Scroll element fills, if `kind` is one: it takes all the room it is given
/// along it, its content seen through that.
let filling<e> = pure (kind: Kind<e>) -> Maybe<Axis> => match kind {
  Scrolls(axis, _) => Some(axis),
  _ => None,
}

/// Where an element of `kind` is scrolled before the user scrolls it: a Scroll element's
/// offset along its axis.
let initial_offset<e> = pure (kind: Kind<e>) -> Point => match kind {
  Scrolls(Horizontal, offset) => Point { x: offset },
  Scrolls(Vertical, offset) => Point { y: offset },
  _ => Point {},
}

/// A node's style where it stands: the cascade at the node (`own`, a theme's own), its
/// classes with the framework's states, its computed style, the cascade its children are
/// styled at, and the space inside its edge.
struct Styled {
  own: Cascade,
  classes: string,
  /// What it is laid out with — `goal` but for the sizes a transition is moving — and what
  /// the cascade asks for.
  style: Computed,
  goal: Computed,
  within: Cascade,
  space: Insets,
  media: []MediaAnswer,
}

/// `node`'s [Styled], at `cascade`, identified as `id` — what laying it out starts from, and
/// what a flex container or grid reads of an item before it lays the item out.
let styled_at<e> = (
  node: Node<e>,
  cascade: ref Cascade,
  ui: ref Interaction,
  id: string
) -> Styled => {
  // A theme reaches its own node; a component's sheet — and a control's insides — only what
  // it holds.
  // Each sheet as the viewport has it: its media rules in force or not.
  var media: []MediaAnswer = []
  let own = match node.kind {
    Theming(theme, sheet) => {
      let (elements, asked) = theme.elements.at(ui.viewport)
      let (global, also) = sheet.at(ui.viewport)
      media = [...asked, ...also]
      cascade.themed(Theme { theme | elements: elements }, global)
    },
    _ => cascade,
  }
  let classes = with_own_state(with_state(node.class, id, ui), node)
  let goal = own.compute(node.tag, classes, node.part, node.style)
  let style = match ui.shown.get(id) {
    Some(moving) => with_layout(goal, moving),
    None => goal,
  }
  let within = match node.kind {
    Scope(sheet_of) => {
      let (scoped, asked) = sheet_of(own.theme).at(ui.viewport)
      media = asked
      // Its children are its top-level elements: the sheet around reaches them ([Cascade.roots]).
      own.inside(style).in_component(node.tag, classes, scoped)
    },
    // A control owns its parts (`Slider::thumb`) — a window's own button too, which takes no
    // focus.
    WindowControl(_) => own.in_component(node.tag, classes, Sheet {}).inside(style),
    _ => if focusable(node.kind) {
      own.in_component(node.tag, classes, Sheet {}).inside(style)
    } else {
      own.inside(style)
    },
  }
  let space = match node.kind {
    Inset(extra) => style.padding.plus(extra),
    _ => style.padding,
  }
  Styled {
    own: own,
    classes: classes,
    style: style,
    goal: goal,
    within: within,
    space: space,
    media: media,
  }
}

/// `c` narrowed to the `width`, `height` and their least and greatest that `style` asks for —
/// each within `c`, which wins, as a parent's constraints do. A least beats a greatest, as in
/// CSS.
let sized_by = pure (c: Constraints, style: ref Computed) -> Constraints => {
  let w = narrowed(c.min_w, c.max_w, style.width, style.min_width, style.max_width)
  let h = narrowed(c.min_h, c.max_h, style.height, style.min_height, style.max_height)
  Constraints { min_w: w.0, max_w: w.1, min_h: h.0, max_h: h.1 }
}

/// A least and greatest `lo`…`hi` narrowed to `exact` (or to `least`…`most`), within themselves.
let narrowed = pure (
  lo: f32,
  hi: f32,
  exact: Maybe<f32>,
  least: Maybe<f32>,
  most: Maybe<f32>
) -> (f32, f32) => {
  if exact.is_none() && least.is_none() && most.is_none() { return (lo, hi) }
  let floor = least ?? 0.0
  let ceiling = (most ?? UNBOUNDED).max(floor)
  let want_lo = match exact {
    Some(x) => x.clamp(floor, ceiling),
    None => floor,
  }
  let want_hi = match exact {
    Some(x) => x.clamp(floor, ceiling),
    None => ceiling,
  }
  let top = hi.max(lo)
  (want_lo.max(lo).min(top), want_hi.min(top).max(want_lo.max(lo).min(top)))
}

/// What lays a node's children out needs besides them: the cascade they are styled at, the
/// framework's state, their parent's identity and its `gap`.
struct Ctx {
  cascade: Cascade,
  ui: Interaction,
  id: string,
  gap: f32,
}

/// What an element that scrolls holds: its content's size, the port it shows the content
/// through (inside its padding, from its top-left corner), how far the content is scrolled,
/// its overflow across and down, and its scrollbars' looks — the `ScrollTrack` and
/// `ScrollThumb` elements' styles, each thumb's with the states the pointer gives it.
pub struct Scroller {
  content: Size,
  port: Rect,
  offset: Point,
  x: Overflow,
  y: Overflow,
  track: Computed,
  thumb_x: Computed,
  thumb_y: Computed,
  /// The element's narrowest width (across only, [narrowest_of]), and the focus, hover and press it was
  /// measured under — kept so a resize, which cannot change it, need not measure it again.
  narrowest: f32 = 0.0,
  marks: string = "",
}

/// One scrollbar of an element: its axis, its track and its thumb, from the element's
/// top-left corner.
pub struct Bar {
  axis: Axis,
  track: Rect,
  thumb: Rect,
}

/// How thick a scrollbar is, and how far it keeps from the element's edge.
pub const BAR_THICKNESS: f32 = 8.0
pub const BAR_MARGIN: f32 = 2.0

impl Scroller {
  /// How far the content can scroll, across and down.
  pub let room = pure (self: ref) -> Size => Size {
    w: (self.content.w - self.port.w).max(0.0),
    h: (self.content.h - self.port.h).max(0.0),
  }

  /// The scrollbars an element `size` large shows: always for `OverflowScroll`, while the
  /// content does not fit for `OverflowAuto`, never otherwise — each along its edge, a thumb
  /// as long as the port's share of the content (at least 20) at the offset's share of the
  /// room.
  pub let bars = pure (self: ref, size: Size) -> []Bar => {
    let spare = self.room()
    let show_x = self.x == OverflowScroll || (self.x == OverflowAuto && spare.w > 0.5)
    let show_y = self.y == OverflowScroll || (self.y == OverflowAuto && spare.h > 0.5)
    var out: []Bar = []
    let t = BAR_THICKNESS
    let m = BAR_MARGIN
    if show_y {
      let track = Rect {
        x: size.w - t - m,
        y: m,
        w: t,
        h: (size.h - 2.0 * m - (if show_x { t + m } else { 0.0 })).max(0.0),
      }
      let long = if self.content.h <= 0.0 { track.h } else { (track.h * self.port.h / self.content.h).clamp(
        track.h.min(20.0),
        track.h
      ) }
      let at = if spare.h <= 0.0 { 0.0 } else { (track.h - long) * self.offset.y / spare.h }
      out.push(Bar {
        axis: Vertical,
        track: track,
        thumb: Rect { x: track.x, y: track.y + at, w: t, h: long }
      })
    }
    if show_x {
      let track = Rect {
        x: m,
        y: size.h - t - m,
        w: (size.w - 2.0 * m - (if show_y { t + m } else { 0.0 })).max(0.0),
        h: t,
      }
      let long = if self.content.w <= 0.0 { track.w } else { (track.w * self.port.w / self.content.w).clamp(
        track.w.min(20.0),
        track.w
      ) }
      let at = if spare.w <= 0.0 { 0.0 } else { (track.w - long) * self.offset.x / spare.w }
      out.push(Bar {
        axis: Horizontal,
        track: track,
        thumb: Rect { x: track.x + at, y: track.y, w: long, h: t }
      })
    }
    out
  }
}

/// Whether the user may scroll an axis of this overflow: `OverflowScroll` and `OverflowAuto`.
pub let user_scrolls = pure (o: Overflow) -> bool =>
  o == OverflowScroll || o == OverflowAuto

/// What a node's kind made of the space inside its padding: the size it fills, its children
/// placed from that space's corner, what it draws itself, whether it clips, and a text field's
/// look and how far its text is scrolled.
struct Body<e> {
  size: Size,
  children: []Placed<e> = [],
  content: Content = Blank,
  clips: bool = false,
  field: Maybe<FieldLook> = None,
  scrolled: f32 = 0.0,
}

/// `classes` with the states the element identified as `id` is in, each a pseudo-class
/// (`:hover`): `:hover` and `:active` when it, or something in it, is under the pointer or
/// pressed — as CSS's reach every element round the one they name — `:focus` when it has the
/// focus, `:focus-visible` when that came from the keyboard, and `:focus-within` when it or
/// something in it has it.
let with_state = pure (classes: string, id: string, ui: ref Interaction) -> string => {
  let inside = (holder: string) -> bool => holder == id || holder.starts_with("${id}/")
  var out = classes
  for (state, holds) in [
    (":hover", inside(ui.hover)),
    (":active", inside(ui.pressed)),
    (":focus", ui.focus == id),
    (":focus-visible", ui.focus == id && ui.keyboard_focus),
    (":focus-within", inside(ui.focus)),
    (":open", ui.menus.contains(id)),
  ] {
    if holds { out = if out.len() == 0 { state } else { "${out} ${state}" } }
  }
  out
}

/// `classes` with the states `node` itself says it is in: `:checked` for a ticked checkbox or the
/// selected tab, a
/// field `:read-only` or `:read-write`, and a control `:disabled` or `:enabled`.
let with_own_state<e> = pure (classes: string, node: Node<e>) -> string => {
  var states: []string = []
  if let Checkable(true, _) = node.kind { states.push(":checked") }
  if let Radio(true, _) = node.kind { states.push(":checked") }
  if let Tabbed(spot) = node.kind { if spot.selected { states.push(":checked") } }
  if let Editable(spec) = node.kind { states.push(if spec.read_only { ":read-only" } else { ":read-write" }) }
  if node.disabled { states.push(":disabled") } else if focusable(node.kind) { states.push(":enabled") }
  if states.len() == 0 { return classes }
  if classes.len() == 0 { states.join(" ") } else { "${classes} ${states.join(" ")}" }
}

/// The role an element of `kind` has.
let role_of<e> = pure (kind: Kind<e>) -> Role => match kind {
  Pressable(_) => ButtonRole,
  Checkable(_, _) => CheckboxRole,
  Ranged(_) => SliderRole,
  Editable(_) => TextFieldRole,
  Choosing(_) => ComboBoxRole,
  Words(_) => TextRole,
  Spelled(_) => TextRole,
  Opens(_) => ButtonRole,
  TabStrip => TabListRole,
  WindowControl(_) => ButtonRole,
  ColorAxis(_) => SliderRole,
  Tabbed(_) => TabRole,
  Radio(_, _) => RadioRole,
  OneOf => RadioGroupRole,
  Texels(_, _, _) => ImageRole,
  Pictured(_, _) => ImageRole,
  Scrolls(_, _) => ScrollRole,
  Flow(_, _, _) => GroupRole,
  Flexbox => GroupRole,
  Gridbox => GroupRole,
  Layers => GroupRole,
  Scope(_) => GroupRole,
  Painted(_) => GroupRole,
  _ => NoRole,
}

/// What assistive technology reads for `node`: its `label`, else for text its text, and for a
/// button or checkbox the text inside it.
let label_of<e> = pure (node: Node<e>, children: []Placed<e>) -> string => {
  if node.label.len() > 0 { return node.label }
  match node.kind {
    Words(content) => content,
    Pressable(_) => text_inside(children),
    // Its face's: what it floats is its menu.
    Opens(_) => if children.len() > 0 { text_inside([children[0]]) } else { "" },
    Checkable(_, _) => text_inside(children),
    Radio(_, _) => text_inside(children),
    _ => "",
  }
}

/// The text of every paragraph below `children`, in order, a space apart.
let text_inside<e> = pure (children: []Placed<e>) -> string => {
  var parts: []string = []
  for child in children {
    let own = match child.laid.content {
      Prose(_) => child.laid.label,
      _ => text_inside(child.laid.children),
    }
    if own.len() > 0 { parts.push(own) }
  }
  parts.join(" ")
}

/// A wrapper's children within `c`: one laid out with `c` as it stands — a wrapper hands its
/// child its own constraints, as Flutter's do — and several as a column lays them out.
/// A select: its face, as a wrapper lays its child out, and — while it is open
/// (`Interaction.open`) — its list, a column of its options as wide as the select,
/// floating just below its border (`Laid.floats`) and taking none of its size.
let lay_select<e> = (
  children: []Node<e>,
  spec: SelectSpec<e>,
  c: Constraints,
  space: Insets,
  ctx: ref Ctx,
  fonts: mut Fonts,
  cache: mut LayoutCache<e>
) -> Body<e> => {
  let face = lay_wrapped(children, c, ctx, fonts, cache)
  if ctx.ui.open != ctx.id { return Body { size: face.size, children: face.children } }
  // Each option keyed by its place, which is what `option_of` reads; a rule before one
  // listed in `separators`, keyed as no option is.
  var options: []Node<e> = []
  for i in 0..<spec.options.len() {
    if spec.separators.contains(i) {
      options.push(padding::<e>(
        Insets { top: 4.0, bottom: 4.0 },
        Node { kind: Measured(None, Some(1.0)), tag: "MenuSeparator" }
      ).keyed("rule ${i}"))
    }
    options.push(Node {
      kind: Checkable(i == spec.selected, (spec.on_change)(i)),
      tag: "Option",
      part: "option",
      key: "${i}",
      children: [text::<e>(spec.options[i]).with_style(Style { font_family: option_family(spec, i) })],
    })
  }
  // Scrolling where it is longer than the window has room for (`ui.interact` keeps the
  // option under the keys in view).
  let list = column::<e>(options)
    .aligned(MainStart, CrossStretch)
    .with_part("list")
    .with_style(Style { overflow_y: Some(OverflowAuto) })
    .keyed("list")
  // As wide as the select — which is as wide as its widest option — so each option's row
  // spans the list.
  let wide = face.size.w + space.horizontal()
  let limits = Constraints {
    min_w: wide,
    max_w: wide,
    max_h: float_room(ctx.ui.viewport.size).h
  }
  let laid = lay(
    list,
    limits,
    ctx.cascade,
    fonts,
    ctx.ui,
    child_id(ctx.id, list, children.len()),
    cache
  )
  let floating = Placed {
    at: Point { x: -space.left, y: face.size.h + space.bottom + FLOAT_GAP },
    laid: Laid {
      laid |
      role: ListBoxRole,
      floats: true,
      anchor: Some(Anchor {}),
      children: [p in laid.children | Placed { p | laid: Laid { p.laid | role: OptionRole } }],
    },
  }
  Body { size: face.size, children: [...face.children, floating] }
}

/// A popup's anchor, as a wrapper lays its child out, and — while `open` — its content
/// floating on `side` of it ([place_floats] puts it within the window), taking none of its
/// size. The content is as wide as it needs and no larger than the window has room for, in a
/// scroller of the framework's (`Popup::content`), so a long one scrolls.
let lay_popup<e> = (
  children: []Node<e>,
  open: bool,
  side: FloatSide,
  c: Constraints,
  ctx: ref Ctx,
  fonts: mut Fonts,
  cache: mut LayoutCache<e>
) -> Body<e> => {
  if children.len() == 0 { return Body::<e> { size: c.constrain(Size {}) } }
  let anchor = lay(
    children[0],
    c,
    ctx.cascade,
    fonts,
    ctx.ui,
    child_id(ctx.id, children[0], 0),
    cache
  )
  let laid_anchor = Placed { at: Point {}, laid: anchor }
  if !open || children.len() < 2 { return Body {
    size: anchor.size,
    children: [laid_anchor]
  } }
  let floating = lay_floating(
    popup_holder(children[1]),
    1,
    side,
    anchor.size,
    ctx,
    fonts,
    cache
  )
  Body { size: anchor.size, children: [laid_anchor, floating] }
}

/// The framework's holder around a popup's `content`: a scroller (`Popup::content`), so a
/// long one scrolls.
let popup_holder<e> = pure (content: Node<e>) -> Node<e> => {
  let wrapping: Kind<e> = Inset(Insets {})
  Node {
    kind: wrapping,
    tag: "Popup",
    part: "content",
    style: Style { overflow_y: Some(OverflowAuto) },
    children: [content],
    key: "content",
  }
}

/// A modal's `under`, as a wrapper lays its child out, and — while `open` — its scrim
/// floating over the whole window (placed at its corner by [place_floats]) with `content`
/// centred in it, taking none of its size.
let lay_modal<e> = (
  children: []Node<e>,
  open: bool,
  c: Constraints,
  ctx: ref Ctx,
  fonts: mut Fonts,
  cache: mut LayoutCache<e>
) -> Body<e> => {
  if children.len() == 0 { return Body::<e> { size: c.constrain(Size {}) } }
  let under = lay(
    children[0],
    c,
    ctx.cascade,
    fonts,
    ctx.ui,
    child_id(ctx.id, children[0], 0),
    cache
  )
  let laid_under = Placed { at: Point {}, laid: under }
  if !open || children.len() < 2 { return Body {
    size: under.size,
    children: [laid_under]
  } }
  let scrim = modal_scrim(children[1])
  // The whole window; with none known, as large as the constraints allow.
  let window = ctx.ui.viewport.size
  let whole = Constraints {
    min_w: window.w,
    max_w: if window.w > 0.0 { window.w } else { c.max_w },
    min_h: window.h,
    max_h: if window.h > 0.0 { window.h } else { c.max_h },
  }
  let laid = lay(
    scrim,
    whole,
    ctx.cascade,
    fonts,
    ctx.ui,
    child_id(ctx.id, scrim, 1),
    cache
  )
  let floating = Placed {
    at: Point {},
    laid: Laid { laid | floats: true, anchor: Some(Anchor { side: FloatWindow }) },
  }
  Body { size: under.size, children: [laid_under, floating] }
}

/// A dock's tree laid out in `c` — and, while a tab is docked into it, where the tab would
/// land (`DockPreview`) over it, taking no input.
let lay_docked<e> = (
  children: []Node<e>,
  c: Constraints,
  ctx: ref Ctx,
  fonts: mut Fonts,
  cache: mut LayoutCache<e>
) -> Body<e> => {
  if children.len() == 0 { return Body::<e> { size: c.constrain(Size {}) } }
  let tree = lay(
    children[0],
    c,
    ctx.cascade,
    fonts,
    ctx.ui,
    child_id(ctx.id, children[0], 0),
    cache
  )
  let placed = [Placed { at: Point {}, laid: tree }]
  let drop = ctx.ui.dock_drop
  if drop.dock != ctx.id { return Body { size: tree.size, children: placed } }
  let Some(box) = dock_drop_box(
    tree,
    drop
  ) else { return Body { size: tree.size, children: placed } }
  let shown: Kind<e> = Measured(Some(box.w), Some(box.h))
  let preview = Node { kind: shown, tag: "DockPreview", key: "preview" }
  let laid = lay(
    preview,
    tight(Size { w: box.w, h: box.h }),
    ctx.cascade,
    fonts,
    ctx.ui,
    child_id(ctx.id, preview, 1),
    cache
  )
  Body {
    size: tree.size,
    children: [...placed, Placed { at: Point { x: box.x, y: box.y }, laid: laid }]
  }
}

/// The framework's scrim around a modal's `content` (`ModalScrim`), centring it, and its
/// holder (`Dialog`): a scroller, so a long one scrolls. Tags of their own rather than parts,
/// so the program's sheets reach `under` as they would without the modal.
let modal_scrim<e> = pure (content: Node<e>) -> Node<e> => {
  let centred: Kind<e> = Place(CENTER)
  let wrapping: Kind<e> = Inset(Insets {})
  let holder = Node {
    kind: wrapping,
    tag: "Dialog",
    style: Style { overflow_y: Some(OverflowAuto) },
    children: [content],
    key: "content",
  }
  Node { kind: centred, tag: "ModalScrim", children: [holder], key: "scrim" }
}

/// An element's tooltip `tip` (`Tooltip`, as wide as it needs up to its style's `max-width`,
/// and no larger than the window has room for), floating below `at`, the pointer's rest.
let lay_tip<e> = (
  tip: Node<e>,
  at: Point,
  ctx: ref Ctx,
  fonts: mut Fonts,
  cache: mut LayoutCache<e>
) -> Placed<e> => {
  let wrapping: Kind<e> = Inset(Insets {})
  let holder = Node { kind: wrapping, tag: "Tooltip", children: [tip], key: "tip" }
  let most = float_room(ctx.ui.viewport.size)
  let laid = lay(
    holder,
    Constraints { max_w: most.w, max_h: most.h },
    ctx.cascade,
    fonts,
    ctx.ui,
    child_id(ctx.id, holder, 0),
    cache
  )
  Placed {
    at: Point {},
    laid: Laid { laid | floats: true, anchor: Some(Anchor { side: FloatPointer(at) }) },
  }
}

/// Whether `laid` is a tooltip showing: it floats by the pointer, and takes no input.
pub let is_tip<e> = pure (laid: Laid<e>) -> bool => match laid.anchor {
  Some(a) => match a.side {
    FloatPointer(_) => true,
    _ => false,
  },
  None => false,
}

/// The text of the paragraphs in `node`, a space between each — a tooltip's, as assistive
/// technology reads it.
let words_in<e> = pure (node: Node<e>) -> string => match node.kind {
  Words(content) => content,
  _ => [child in node.children | words_in(child)].filter((w) => w.len() > 0).join(" "),
}

/// `holder` — child `index` of the element being laid out, what floats from it — laid out
/// floating on `side` of an anchor `anchor` large: as wide as it needs — CSS's shrink-to-fit,
/// a floating box's width — and no larger than the window has room for. It is laid out first
/// with no width to learn its own, then at that width, so what stretches across it (a menu's
/// rows) spans it rather than the window.
let lay_floating<e> = (
  holder: Node<e>,
  index: i64,
  side: FloatSide,
  anchor: Size,
  ctx: ref Ctx,
  fonts: mut Fonts,
  cache: mut LayoutCache<e>
) -> Placed<e> => {
  let most = float_room(ctx.ui.viewport.size)
  let id = child_id(ctx.id, holder, index)
  let natural = lay(
    holder,
    Constraints { max_h: most.h },
    ctx.cascade,
    fonts,
    ctx.ui,
    id,
    cache
  )
  let wide = natural.size.w.min(most.w)
  let content = lay(
    holder,
    Constraints { min_w: wide, max_w: wide, max_h: most.h },
    ctx.cascade,
    fonts,
    ctx.ui,
    id,
    cache
  )
  let at = if side == FloatBeside { Point { x: anchor.w + FLOAT_GAP } } else { Point { y: anchor.h + FLOAT_GAP } }
  Placed {
    at: at,
    laid: Laid { content | floats: true, anchor: Some(Anchor { side: side }) }
  }
}

/// The most a floating element may take of a window `window` large: all of it but a margin
/// at each edge; no limit on a side of nothing.
let float_room = pure (window: Size) -> Size => Size {
  w: if window.w > 0.0 { (window.w - 2.0 * FLOAT_MARGIN).max(0.0) } else { UNBOUNDED },
  h: if window.h > 0.0 { (window.h - 2.0 * FLOAT_MARGIN).max(0.0) } else { UNBOUNDED },
}

let lay_wrapped<e> = (
  children: []Node<e>,
  c: Constraints,
  ctx: ref Ctx,
  fonts: mut Fonts,
  cache: mut LayoutCache<e>
) -> Body<e> => {
  if children.len() == 1 {
    let one = lay(
      children[0],
      c,
      ctx.cascade,
      fonts,
      ctx.ui,
      child_id(ctx.id, children[0], 0),
      cache
    )
    return Body { size: one.size, children: [Placed { at: Point {}, laid: one }] }
  }
  lay_line(children, Vertical, MainStart, CrossStart, c, false, ctx, fonts, cache)
}

/// `children` along `axis` within `c`, `ctx.gap` apart, placed by `main` and `cross` — a row's
/// or column's layout, and how a wrapper lays out several children. `fill` takes all the room
/// along the axis when it has a limit, as a row or column does; a wrapper takes what its
/// children need.
let lay_line<e> = (
  children: []Node<e>,
  axis: Axis,
  main: MainAlign,
  cross: CrossAlign,
  c: Constraints,
  fill: bool,
  ctx: ref Ctx,
  fonts: mut Fonts,
  cache: mut LayoutCache<e>
) -> Body<e> => {
  let count = children.len()
  if count == 0 { return Body::<e> { size: c.constrain(Size {}) } }
  let gap = ctx.gap
  let max_main = along(axis, c.max_w, c.max_h)
  let min_main = along(axis, c.min_w, c.min_h)
  let max_cross = along(axis, c.max_h, c.max_w)
  let min_cross = along(axis, c.min_h, c.min_w)
  let bounded = max_main < UNBOUNDED
  let stretch = cross == CrossStretch && max_cross < UNBOUNDED
  let cross_min = if stretch { max_cross } else { 0.0 }
  var laid: []Maybe<Laid<e>> = []
  for _ in 0..<count { laid.push(None) }
  // Children that do not grow first: what they take is what the growing ones share.
  var used = gap * f32(count - 1)
  var factors: f32 = 0.0
  for i, child in children {
    let factor = grow_factor(child)
    if factor > 0.0 {
      factors += factor
      continue
    }
    let limits = oriented(axis, 0.0, UNBOUNDED, cross_min, max_cross)
    let one = lay(
      child,
      limits,
      ctx.cascade,
      fonts,
      ctx.ui,
      child_id(ctx.id, child, i),
      cache
    )
    used += along(axis, one.size.w, one.size.h)
    laid[i] = Some(one)
  }
  let spare = if bounded { (max_main - used).max(0.0) } else { 0.0 }
  for i, child in children {
    let factor = grow_factor(child)
    if factor <= 0.0 { continue }
    let share = spare * factor / factors
    let main_c = if bounded { (share, share) } else { (0.0, UNBOUNDED) }
    let limits = oriented(axis, main_c.0, main_c.1, cross_min, max_cross)
    let one = lay(
      child,
      limits,
      ctx.cascade,
      fonts,
      ctx.ui,
      child_id(ctx.id, child, i),
      cache
    )
    used += along(axis, one.size.w, one.size.h)
    laid[i] = Some(one)
  }
  var thickest: f32 = 0.0
  for one in laid {
    if let Some(l) = one { thickest = thickest.max(along(axis, l.size.h, l.size.w)) }
  }
  let main_size = (if fill && bounded { max_main } else { used }).max(min_main)
  let cross_size = (if stretch { max_cross } else { thickest }).max(min_cross)
  let left = (main_size - used).max(0.0)
  let n = f32(count)
  let starts = match main {
    MainStart => (0.0, gap),
    MainCenter => (left / 2.0, gap),
    MainEnd => (left, gap),
    SpaceBetween => if count > 1 { (0.0, gap + left / (n - 1.0)) } else { (0.0, gap) },
    SpaceAround => (left / n / 2.0, gap + left / n),
    SpaceEvenly => (left / (n + 1.0), gap + left / (n + 1.0)),
  }
  var pen = starts.0
  var placed: []Placed<e> = []
  for one in laid {
    let Some(l) = one else { continue }
    let thick = along(axis, l.size.h, l.size.w)
    let across = match cross {
      CrossCenter => (cross_size - thick) / 2.0,
      CrossEnd => cross_size - thick,
      _ => 0.0,
    }
    placed.push(Placed { at: oriented_point(axis, pen, across), laid: l })
    pen += along(axis, l.size.w, l.size.h) + starts.1
  }
  Body { size: oriented_size(axis, main_size, cross_size), children: placed }
}

/// `children` over one another within `c`: the ones not [positioned] at the top-left corner,
/// as large as the largest of them; the positioned ones by their edges within that.
let lay_layers<e> = (
  children: []Node<e>,
  c: Constraints,
  ctx: ref Ctx,
  fonts: mut Fonts,
  cache: mut LayoutCache<e>
) -> Body<e> => {
  var laid: []Maybe<Laid<e>> = []
  for _ in children { laid.push(None) }
  var w: f32 = 0.0
  var h: f32 = 0.0
  for i, child in children {
    if pinned(child).is_some() { continue }
    let one = lay(
      child,
      c.loosened(),
      ctx.cascade,
      fonts,
      ctx.ui,
      child_id(ctx.id, child, i),
      cache
    )
    w = w.max(one.size.w)
    h = h.max(one.size.h)
    laid[i] = Some(one)
  }
  let size = c.constrain(Size { w: w, h: h })
  var placed: []Placed<e> = []
  for i, child in children {
    if let Some(l) = laid[i] {
      placed.push(Placed { at: Point {}, laid: l })
      continue
    }
    let Some(edges) = pinned(child) else { continue }
    let across = span(edges.left, edges.right, edges.width, size.w)
    let down = span(edges.top, edges.bottom, edges.height, size.h)
    let one = lay(
      child,
      Constraints { min_w: across.0, max_w: across.1, min_h: down.0, max_h: down.1 },
      ctx.cascade,
      fonts,
      ctx.ui,
      child_id(ctx.id, child, i),
      cache
    )
    let x = match (edges.left, edges.right) {
      (Some(l), _) => l,
      (None, Some(r)) => size.w - r - one.size.w,
      _ => 0.0,
    }
    let y = match (edges.top, edges.bottom) {
      (Some(t), _) => t,
      (None, Some(b)) => size.h - b - one.size.h,
      _ => 0.0,
    }
    placed.push(Placed { at: Point { x: x, y: y }, laid: one })
  }
  Body { size: size, children: placed }
}

/// A slider within `c`: as wide as it may be (160 units with no limit), its track, the part
/// of it up to the value, and a thumb at the value — the `Slider::track`, `Slider::fill` and
/// `Slider::thumb` parts, so a sheet styles them.
let lay_slider<e> = (
  spec: SliderSpec<e>,
  c: Constraints,
  ctx: ref Ctx,
  fonts: mut Fonts,
  cache: mut LayoutCache<e>
) -> Body<e> => {
  let w = (if c.bounded_w() { c.max_w } else { 160.0 }).max(SLIDER_THUMB)
  let size = c.constrain(Size { w: w, h: SLIDER_THUMB })
  let travel = size.w - SLIDER_THUMB
  let at = slider_fraction(spec) * travel
  let middle = (SLIDER_THUMB - SLIDER_TRACK) / 2.0
  let parts = stack::<e>([
    slider_piece::<e>("track", 0.0, middle, size.w, SLIDER_TRACK),
    slider_piece::<e>("fill", 0.0, middle, at + SLIDER_THUMB / 2.0, SLIDER_TRACK),
    slider_piece::<e>("thumb", at, 0.0, SLIDER_THUMB, SLIDER_THUMB),
  ])
  let one = lay(parts, tight(size), ctx.cascade, fonts, ctx.ui, "${ctx.id}/parts", cache)
  Body { size: size, children: [Placed { at: Point {}, laid: one }] }
}

/// Part `name` of a slider, `w` × `h` at `left`, `top`.
let slider_piece<e> = pure (
  name: string,
  left: f32,
  top: f32,
  w: f32,
  h: f32
) -> Node<e> =>
  positioned::<e>(
    Edges { left: Some(left), top: Some(top), width: Some(w), height: Some(h) },
    sized::<e>(None, None).with_part(name)
  )

/// A slider's thumb is this wide and tall; its track this thick.
pub const SLIDER_THUMB: f32 = 20.0
pub const SLIDER_TRACK: f32 = 4.0

/// How far along its range a slider's value is, `0.0` to `1.0`.
pub let slider_fraction<e> = pure (spec: SliderSpec<e>) -> f32 =>
  if spec.max <= spec.min { 0.0 } else {
    ((spec.value - spec.min) / (spec.max - spec.min)).clamp(0.0, 1.0)
  }

/// A text field within `c`: as wide as it may be (200 units with no limit), a line tall, its
/// value (or its placeholder, in the `TextInput::placeholder` part's colour) scrolled so its
/// caret is in view, and clipped to it.
let lay_field<e> = (
  spec: FieldSpec<e>,
  c: Constraints,
  style: ref Computed,
  ctx: ref Ctx,
  fonts: mut Fonts
) -> Body<e> => {
  let empty = spec.value.len() == 0
  let shown = if empty { spec.placeholder } else { spec.value }
  let block = fonts.lay_out(shown, style.font, UNBOUNDED)
  let line = if block.line_height > 0.0 { block.line_height } else { style.font.size }
  let size = c.constrain(Size { w: if c.bounded_w() { c.max_w } else { 200.0 }, h: line })
  let state = ctx.ui.widgets.get(ctx.id) ?? WidgetState {}
  let runes = spec.value.len()
  let caret = if empty { 0.0 } else { caret_x(
    block,
    byte_at(spec.value, state.caret.clamp(0, runes))
  ) }
  let anchor = if empty { 0.0 } else { caret_x(
    block,
    byte_at(spec.value, state.anchor.clamp(0, runes))
  ) }
  // Scrolled as little as keeps the caret inside, a pixel or two from the edge.
  var scrolled = state.field_scroll
  if caret - scrolled > size.w - 2.0 { scrolled = caret - size.w + 2.0 }
  if caret - scrolled < 0.0 { scrolled = caret }
  scrolled = scrolled.max(0.0)
  let part = (name: string) -> Computed =>
    ctx.cascade.compute("TextInput", "", name, Style {})
  let look = FieldLook {
    color: if empty { part("placeholder").color } else { style.color },
    scroll: scrolled,
    caret: caret,
    selection_from: caret.min(anchor),
    selection_to: caret.max(anchor),
    caret_color: part("caret").background ?? style.color,
    selection_color: part("selection").background ?? faded(style.color, 0.25),
    line_height: line,
    focused: ctx.ui.focus == ctx.id,
  }
  Body::<e> {
    size: size,
    content: Prose(block),
    clips: true,
    field: Some(look),
    scrolled: scrolled
  }
}

/// The byte offset of rune `index` of `text`, or its length past the end.
pub let byte_at = pure (text: string, index: i64) -> i64 =>
  text.byte_offset(index) ?? text.byte_len()

/// The least and greatest a positioned child may be along one axis of a stack `room` long:
/// exactly the space between its two edges when both are set, else exactly its size when that
/// is, else anything.
let span = pure (
  start: Maybe<f32>,
  end: Maybe<f32>,
  length: Maybe<f32>,
  room: f32
) -> (f32, f32) => {
  if let Some(a) = start {
    if let Some(b) = end {
      let between = (room - a - b).max(0.0)
      return (between, between)
    }
  }
  match length {
    Some(l) => (l, l),
    None => (0.0, UNBOUNDED),
  }
}

/// How much of a row's or column's free space a child takes, `0.0` for one that takes none.
let grow_factor<e> = pure (node: Node<e>) -> f32 => match node.kind {
  Grow(f) => f.max(0.0),
  _ => 0.0,
}

/// A child's edges in its stack, if it is positioned.
let pinned<e> = pure (node: Node<e>) -> Maybe<Edges> => match node.kind {
  Pin(edges) => Some(edges),
  _ => None,
}

/// `across` for a row's axis, `down` for a column's.
let along = pure (axis: Axis, across: f32, down: f32) -> f32 => match axis {
  Horizontal => across,
  Vertical => down,
}

/// Constraints from a least and greatest along the axis and across it.
let oriented = pure (
  axis: Axis,
  main_min: f32,
  main_max: f32,
  cross_min: f32,
  cross_max: f32
) -> Constraints => match axis {
  Horizontal => Constraints {
    min_w: main_min,
    max_w: main_max,
    min_h: cross_min,
    max_h: cross_max,
  },
  Vertical => Constraints {
    min_w: cross_min,
    max_w: cross_max,
    min_h: main_min,
    max_h: main_max,
  },
}

let oriented_point = pure (axis: Axis, main: f32, cross: f32) -> Point => match axis {
  Horizontal => Point { x: main, y: cross },
  Vertical => Point { x: cross, y: main },
}

let oriented_size = pure (axis: Axis, main: f32, cross: f32) -> Size => match axis {
  Horizontal => Size { w: main, h: cross },
  Vertical => Size { w: cross, h: main },
}

/// `r` moved by `by`.
let moved_rect = pure (r: Rect, by: Point) -> Rect =>
  Rect { r | x: r.x + by.x, y: r.y + by.y }

/// `placed`, each moved by `by`.
let moved<e> = pure (placed: []Placed<e>, by: Point) -> []Placed<e> =>
  [p in placed | Placed { p | at: Point { x: p.at.x + by.x, y: p.at.y + by.y } }]

// ── Painting ─────────────────────────────────────────────────────────────────

/// `laid` as a display list, its top-left corner at `origin`: each node's background, border
/// and content, then its children, clipped where the node clips, and a focus ring last. Text
/// is drawn from `atlas`, which renders the glyphs it lacks through `renderer` at `scale`
/// pixels a unit, and a painter's text is laid out in `fonts`.
pub let paint<e, r> where r: Renderer = (
  laid: Laid<e>,
  origin: Point,
  scale: f32,
  fonts: mut Fonts,
  atlas: mut GlyphAtlas,
  renderer: mut r
) -> []DrawOp => {
  var ops: []DrawOp = []
  // A frame: the atlas may empty a page the last one drew from, never one this one does.
  atlas.next_frame()
  // What floats (an open select's list) is drawn after the whole tree, over it and outside
  // every clip — and what floats in that, after it.
  var floating: []Placed<e> = []
  paint_into(ops, laid, origin, scale, fonts, atlas, renderer, floating, EVERYWHERE)
  var k = 0
  while k < floating.len() {
    let f = floating[k]
    paint_into(ops, f.laid, f.at, scale, fonts, atlas, renderer, floating, EVERYWHERE)
    k += 1
  }
  // A picture no part of this frame drew is no view's now.
  atlas.release_pictures(renderer)
  ops
}

/// How a picture fills a box larger or smaller than it: repeated at its own size from the box's
/// corner, stretched to the box, or stretched until it covers the box and cut to its shape
/// (CSS's `background-repeat`, and `background-size`'s `100% 100%` and `cover`).
pub data Fit = FitTile | FitStretch | FitCover

/// The most tiles a [FitTile] fill draws: a smaller picture's tile doubles until there are no
/// more than these, so a pixel's pattern does not cost a million quads.
pub const MOST_TILES: i64 = 4096

/// `source` filling `box` as `fit` says, inside its rounded `corners`, at `opacity` — a
/// painter's ops. Tiles are the picture's own pixels at `scale` pixels a unit (the painter's
/// `PaintArea.scale`), so one is as sharp as the display.
pub let picture_fill = pure (
  source: PictureSource,
  fit: Fit,
  box: Rect,
  corners: Radii,
  opacity: f32,
  scale: f32
) -> []PaintOp => {
  let pixels = source.image
  if pixels.width <= 0 || pixels.height <= 0 || box.w <= 0.0 || box.h <= 0.0 { return [] }
  let iw = f32(pixels.width)
  let ih = f32(pixels.height)
  let whole = whole_image(pixels)
  var ops: []PaintOp = [PaintDraw(PushClip(box, corners))]
  match fit {
    FitStretch => ops.push(PaintPicture(source, whole, box, opacity)),
    FitCover => {
      // The middle of the picture, as wide or as tall as the box's shape allows.
      let wide = iw / ih > box.w / box.h
      let texels = if wide {
        let w = ih * box.w / box.h
        Rect { x: (iw - w) / 2.0, y: 0.0, w: w, h: ih }
      } else {
        let h = iw * box.h / box.w
        Rect { x: 0.0, y: (ih - h) / 2.0, w: iw, h: h }
      }
      ops.push(PaintPicture(source, texels, box, opacity))
    },
    FitTile => {
      var tw = iw / scale.max(0.01)
      var th = ih / scale.max(0.01)
      while (box.w / tw + 1.0) * (box.h / th + 1.0) > f32(MOST_TILES) {
        tw = tw * 2.0
        th = th * 2.0
      }
      var y = box.y
      while y < box.y + box.h {
        var x = box.x
        while x < box.x + box.w {
          ops.push(PaintPicture(
            source,
            whole,
            Rect { x: x, y: y, w: tw, h: th },
            opacity
          ))
          x += tw
        }
        y += th
      }
    },
  }
  ops.push(PaintDraw(PopClip))
  ops
}

/// All of `image`'s pixels, as the texels a picture draws from.
pub let whole_image = pure (image: Image) -> Rect =>
  Rect { w: f32(image.width), h: f32(image.height) }

/// The clip around what nothing clips: everywhere a display could show.
const EVERYWHERE: Rect = Rect {
  x: -UNBOUNDED,
  y: -UNBOUNDED,
  w: 2.0 * UNBOUNDED,
  h: 2.0 * UNBOUNDED
}

/// `laid` painted into `ops` at `origin`, inside `clip` — the part of the display the clips
/// around it leave, which a painter is told of.
let paint_into<e, r> where r: Renderer = (
  ops: mut []DrawOp,
  laid: Laid<e>,
  origin: Point,
  scale: f32,
  fonts: mut Fonts,
  atlas: mut GlyphAtlas,
  renderer: mut r,
  floating: mut []Placed<e>,
  clip: Rect
) -> void => {
  let s = laid.style
  let box = Rect { x: origin.x, y: origin.y, w: laid.size.w, h: laid.size.h }
  let corners = s.corners ?? radius(s.radius)
  // A blurred element is drawn into a layer, wide enough for the blur to spread into.
  if s.filter_blur > 0.0 {
    ops.push(PushLayer(
      box.inset(-3.0 * s.filter_blur),
      LayerEffect { blur: s.filter_blur }
    ))
  }
  // Shadows under the element, the first on top as CSS has it.
  for i in (s.box_shadow.len() - 1)..>=0 {
    let shadow = s.box_shadow[i]
    if !shadow.inset {
      ops.push(Shadow(
        box,
        corners,
        BoxShadow { shadow | color: faded(shadow.color, s.opacity) }
      ))
    }
  }
  if s.backdrop_blur > 0.0 { ops.push(Backdrop(box, corners, s.backdrop_blur)) }
  if let Some(fill) = s.background { ops.push(Fill(
    box,
    corners,
    faded(fill, s.opacity)
  )) }
  if let Some(gradient) = s.background_gradient {
    let stops = [stop in gradient.stops | ColorStop { stop | color: faded(
      stop.color,
      s.opacity
    ) }]
    ops.push(GradientFill(box, corners, Gradient { gradient | stops: stops }))
  }
  for i in (s.box_shadow.len() - 1)..>=0 {
    let shadow = s.box_shadow[i]
    if shadow.inset {
      ops.push(Shadow(
        box,
        corners,
        BoxShadow { shadow | color: faded(shadow.color, s.opacity) }
      ))
    }
  }
  if let Some(line) = s.border_color {
    if s.border_width > 0.0 {
      ops.push(Border(box, corners, s.border_width, faded(line, s.opacity)))
    }
  }
  let at = Point { x: origin.x + laid.content_at.x, y: origin.y + laid.content_at.y }
  if let Some(look) = laid.field {
    // A field's text, selection and caret, clipped to the space inside its padding.
    let inside = Rect {
      x: origin.x + s.padding.left,
      y: origin.y + s.padding.top,
      w: (laid.size.w - s.padding.horizontal()).max(0.0),
      h: (laid.size.h - s.padding.vertical()).max(0.0),
    }
    ops.push(PushClip(inside, radius(0.0)))
    if look.focused && look.selection_to > look.selection_from {
      let from = Rect {
        x: at.x + look.selection_from,
        y: at.y,
        w: look.selection_to - look.selection_from,
        h: look.line_height,
      }
      ops.push(Fill(from, radius(0.0), faded(look.selection_color, s.opacity)))
    }
    if let Prose(block) = laid.content {
      let color = faded(look.color, s.opacity)
      for op in atlas.glyphs(
        fonts,
        renderer,
        block,
        at,
        scale,
        color
      ) { ops.push(op) }
    }
    if look.focused && look.selection_to <= look.selection_from {
      let caret = Rect {
        x: at.x + look.caret - 0.75,
        y: at.y,
        w: 1.5,
        h: look.line_height
      }
      ops.push(Fill(caret, radius(0.0), faded(look.caret_color, s.opacity)))
    }
    ops.push(PopClip)
  } else {
    match laid.content {
      Prose(block) => {
        let color = faded(s.color, s.opacity)
        for op in atlas.glyphs(
          fonts,
          renderer,
          block,
          at,
          scale,
          color
        ) { ops.push(op) }
      },
      Bitmap(texture, texels, natural) => {
        ops.push(Picture(
          texture,
          texels,
          Rect { x: at.x, y: at.y, w: natural.w, h: natural.h },
          1.0
        ))
      },
      Pixels(source, natural) => {
        if let Some(texture) = atlas.picture(source, renderer) {
          ops.push(Picture(
            texture,
            whole_image(source.image),
            Rect { x: at.x, y: at.y, w: natural.w, h: natural.h },
            s.opacity
          ))
        }
      },
      Blank => {},
    }
  }
  if let Painted(painter) = laid.kind {
    paint_painter(ops, painter, box, corners, scale, fonts, atlas, renderer, clip)
  }
  match laid.kind {
    ColorAxis(spec) => paint_axis(ops, spec, laid.hue, box),
    ColorPatch(color) => paint_patch(ops, color, box, corners),
    _ => {},
  }
  if laid.clips && laid.field.is_none() { ops.push(PushClip(box, corners)) }
  let inside = if laid.clips { clip.intersect(box) } else { clip }
  for child in laid.children {
    let corner = Point { x: origin.x + child.at.x, y: origin.y + child.at.y }
    if child.laid.floats {
      floating.push(Placed { at: corner, laid: child.laid })
      continue
    }
    paint_into(ops, child.laid, corner, scale, fonts, atlas, renderer, floating, inside)
  }
  if laid.clips && laid.field.is_none() { ops.push(PopClip) }
  // A scroller's bars, over its content.
  if let Some(scroller) = laid.scroller {
    for bar in scroller.bars(laid.size) {
      let thumb = if bar.axis == Vertical { scroller.thumb_y } else { scroller.thumb_x }
      if let Some(fill) = scroller.track.background {
        ops.push(Fill(
          moved_rect(bar.track, origin),
          radius(scroller.track.radius),
          faded(fill, s.opacity)
        ))
      }
      if let Some(fill) = thumb.background {
        ops.push(Fill(
          moved_rect(bar.thumb, origin),
          radius(thumb.radius),
          faded(fill, s.opacity)
        ))
      }
    }
  }
  if let Some(ring) = laid.ring {
    let around = Radii {
      top_left: corners.top_left + 3.0,
      top_right: corners.top_right + 3.0,
      bottom_right: corners.bottom_right + 3.0,
      bottom_left: corners.bottom_left + 3.0,
    }
    ops.push(Border(box.inset(-3.0), around, 2.5, ring))
  }
  if s.filter_blur > 0.0 { ops.push(PopLayer) }
}

/// What `painter` answers for its element's `box`, inside `clip`, moved to the box and
/// clipped to it (and its corners).
let paint_painter<e, r> where r: Renderer = (
  ops: mut []DrawOp,
  painter: Painter<e>,
  box: Rect,
  corners: Radii,
  scale: f32,
  fonts: mut Fonts,
  atlas: mut GlyphAtlas,
  renderer: mut r,
  clip: Rect
) -> void => {
  let shown = clip.intersect(box)
  let area = PaintArea {
    size: Size { w: box.w, h: box.h },
    visible: Rect { shown | x: shown.x - box.x, y: shown.y - box.y },
    scale: scale,
  }
  let at = Point { x: box.x, y: box.y }
  ops.push(PushClip(box, corners))
  for op in (painter.paint)(area) {
    match op {
      PaintDraw(drawn) => ops.push(moved_op(drawn, at)),
      PaintCells(baseline, advance, cells, font, color) => {
        let block = fonts.cells(cells, font, advance)
        let from = Point { x: at.x + baseline.x, y: at.y + baseline.y }
        for drawn in atlas.glyphs(
          fonts,
          renderer,
          block,
          from,
          scale,
          color
        ) { ops.push(drawn) }
      },
      PaintPicture(source, texels, into, opacity) => {
        if let Some(texture) = atlas.picture(source, renderer) {
          ops.push(Picture(
            texture,
            texels,
            Rect { into | x: into.x + at.x, y: into.y + at.y },
            opacity
          ))
        }
      },
      PaintWave(start, width, amplitude, thickness, color) => {
        for fill in wave(
          Point { x: at.x + start.x, y: at.y + start.y },
          width,
          amplitude,
          thickness,
          scale,
          color
        ) { ops.push(fill) }
      },
      PaintText(baseline, text, font, color) => {
        let block = fonts.lay_out(text, font, UNBOUNDED)
        if block.lines.len() == 0 { continue }
        let top = Point {
          x: at.x + baseline.x,
          y: at.y + baseline.y - block.lines[0].baseline
        }
        for drawn in atlas.glyphs(
          fonts,
          renderer,
          block,
          top,
          scale,
          color
        ) { ops.push(drawn) }
      },
    }
  }
  ops.push(PopClip)
}

/// A wave from `start` (its middle, at its left end) across `width`, `amplitude` either side,
/// `thickness` thick, as fills a device pixel wide: each column from the curve's lowest to its
/// highest over it, with half the thickness beyond each, so a steep stretch leaves no gap. (The
/// display list has no paths; a wave is the one curve a terminal draws.)
let wave = pure (
  start: Point,
  width: f32,
  amplitude: f32,
  thickness: f32,
  scale: f32,
  color: Color
) -> []DrawOp => {
  if width <= 0.0 { return [] }
  let step = 1.0 / scale.max(0.25)
  let period = (8.0 * amplitude).max(2.0)
  var fills: []DrawOp = []
  var x: f32 = 0.0
  while x < width {
    let w = step.min(width - x)
    let a = wave_y(start.y, amplitude, period, x)
    let b = wave_y(start.y, amplitude, period, x + w)
    let top = a.min(b) - thickness / 2.0
    let bottom = a.max(b) + thickness / 2.0
    fills.push(Fill(
      Rect { x: start.x + x, y: top, w: w, h: bottom - top },
      radius(0.0),
      color
    ))
    x += step
  }
  fills
}

/// Where a wave about `middle`, `amplitude` either side and a `period` long, is `x` along.
let wave_y = pure (middle: f32, amplitude: f32, period: f32, x: f32) -> f32 =>
  middle - amplitude * (6.2831855 * x / period).sin()

/// `op` moved by `by`.
let moved_op = pure (op: DrawOp, by: Point) -> DrawOp => match op {
  Fill(r, corners, color) => Fill(moved_rect(r, by), corners, color),
  Border(r, corners, width, color) => Border(moved_rect(r, by), corners, width, color),
  Glyphs(texture, quads, color) =>
    Glyphs(texture, [q in quads | GlyphQuad { q | at: moved_rect(q.at, by) }], color),
  Picture(texture, texels, r, opacity) =>
    Picture(texture, texels, moved_rect(r, by), opacity),
  PushClip(r, corners) => PushClip(moved_rect(r, by), corners),
  PopClip => PopClip,
  Shadow(r, corners, shadow) => Shadow(moved_rect(r, by), corners, shadow),
  GradientFill(r, corners, gradient) =>
    GradientFill(moved_rect(r, by), corners, gradient),
  Backdrop(r, corners, blur) => Backdrop(moved_rect(r, by), corners, blur),
  PushLayer(r, effect) => PushLayer(moved_rect(r, by), effect),
  PopLayer => PopLayer,
}
