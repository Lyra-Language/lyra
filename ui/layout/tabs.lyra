module ui.layout
//! A tab bar (`ui/WINDOW.md` §3): [tab_bar] over a [TabsSpec] — the tabs, the one selected, and
//! what selecting, closing and dragging one raise.
//!
//! **The order is the program's.** A drag raises `on_move(from, to)` as the tab passes half of
//! its neighbour, and the program reorders its own list, so the strip, its shortcuts and its
//! menus never disagree about it. A tab is keyed by its [TabSpec.key], so a title that changes
//! moves neither its framework state nor its place in the cache; a tab that is not `movable`
//! neither moves nor is passed by one that is.
//!
//! **Widths**: each tab as wide as its label (and its ×), up to [TAB_MOST], the strip's `gap`
//! between them; past the strip's width **the gap gives way first**, down to [TAB_GAP_LEAST]
//! (or the strip's own, where that is less); then they shrink together, each to no less than
//! [TAB_LEAST]; and where even then they do not fit, **the strip shows as many as fit beside a
//! more-tabs button** (`TabsMore`, an arrow, [more_tabs]) — the selected one always among them —
//! whose menu lists the rest, an item choosing one as a press on it would (`ui/WINDOW.md`'s open
//! question 2). A label too long for its tab is clipped, not wrapped.
//!
//! **The more-tabs menu is made at layout**, from the tabs hidden, as a select's list is; a
//! strip from the cache makes it again from the fresh nodes of the same tabs ([strip_children]),
//! so its events are this frame's.

import ui.style.{ OverflowHidden }

/// What a tab bar shows and raises: its tabs in order; the one selected, by place; the events
/// for selecting, closing and moving a tab (from its place to another); and what follows the
/// tabs in the strip — a `+`, a menu button.
pub struct TabsSpec<e> {
  tabs: []TabSpec,
  selected: i64,
  on_select: (i64) -> e,
  on_close: (i64) -> e,
  on_move: (i64, i64) -> e,
  after: []Node<e> = [],
}

/// A tab: its label, the key standing for it (its identity, whatever its place or label),
/// whether it has a × to close it, and whether it may be dragged to another place.
pub struct TabSpec {
  label: string,
  key: string,
  closable: bool = true,
  movable: bool = true,
}

/// What a tab of a strip is to the framework: its place, whether it is selected, closable and
/// movable, and the strip's functions making the events selecting, closing and moving a tab
/// raise — called with its place as it is pressed (`ui.interact`), since a builder, pure, may
/// call none.
pub struct TabSpot<e> {
  index: i64,
  selected: bool,
  closable: bool,
  movable: bool,
  on_select: (i64) -> e,
  on_close: (i64) -> e,
  on_move: (i64, i64) -> e,
}

/// The narrowest a tab shrinks to, and the widest it grows to.
pub const TAB_LEAST: f32 = 64.0
pub const TAB_MOST: f32 = 220.0
/// The least the strip's gap gives way to, before its tabs shrink.
pub const TAB_GAP_LEAST: f32 = 2.0

/// A tab bar (`TabBar`): each tab (`Tab`, `:checked` the selected) its label and, closable, a ×
/// (`TabClose`), then `spec.after`. A press on a tab selects it, on its × closes it, and a
/// middle click on it closes it; a drag moves it among the movable tabs; while a tab has the
/// focus, Enter or Space selects it and Left, Right, Home and End select another.
pub let tab_bar<e> = pure (spec: TabsSpec<e>) -> Node<e> => {
  let kind: Kind<e> = TabStrip
  Node {
    kind: kind,
    tag: "TabBar",
    // Scrolled by the program (its selected tab kept in view) and the wheel (`ui.interact`), but
    // showing no bar: CSS's `hidden`.
    style: Style { overflow_x: Some(OverflowHidden) },
    children: [...[i in 0..<spec.tabs.len() | tab_node(spec, i)], ...spec.after],
  }
}

/// Tab `i` of `spec`: its label clipped to its width, and its ×.
let tab_node<e> = pure (spec: TabsSpec<e>, i: i64) -> Node<e> => {
  let t = spec.tabs[i]
  // Laid out at its whole width and clipped there, never wrapped.
  let label = scroll::<e>(Horizontal, 0.0, text::<e>(t.label))
    .with_style(Style { overflow_x: Some(OverflowClip) })
    .with_part("label")
  // Not a control of its own: a press on it is the tab's, which closes it (`ui.interact`).
  let mark = text::<e>("×")
  let close: []Node<e> = if t.closable { [Node { mark | tag: "TabClose" }] } else { [] }
  let kind: Kind<e> = Tabbed(TabSpot {
    index: i,
    selected: i == spec.selected,
    closable: t.closable,
    movable: t.movable,
    on_select: spec.on_select,
    on_close: spec.on_close,
    on_move: spec.on_move,
  })
  Node {
    kind: kind,
    tag: "Tab",
    key: t.key,
    label: t.label,
    children: [row::<e>([expanded::<e>(label), ...close]).with_style(Style { gap: Some(6.0) })],
  }
}

/// A strip's children along it: its tabs as wide as they need up to [TAB_MOST], the gap between
/// them narrowed toward [TAB_GAP_LEAST] and then they shrunk together toward [TAB_LEAST] where
/// the strip is narrower than they and what follows them, each as tall as the tallest; where
/// even at their least they do not fit, as many as do — the selected one among them — and the
/// more-tabs button holding the rest; then what follows, at its own width.
let lay_tab_strip<e> = (
  children: []Node<e>,
  c: Constraints,
  ctx: Ctx,
  fonts: mut Fonts,
  cache: mut LayoutCache<e>
) -> Body<e> => {
  // Each as it would be with all the width it wants.
  var natural: []Laid<e> = []
  for i, child in children {
    natural.push(lay(
      child,
      Constraints { max_h: c.max_h },
      ctx.cascade,
      fonts,
      ctx.ui,
      child_id(ctx.id, child, i),
      cache
    ))
  }
  var height: f32 = 0.0
  var others: f32 = 0.0
  var tabs: []i64 = []
  var wants: []f32 = []
  for i, child in children {
    height = height.max(natural[i].size.h)
    if is_tab(child.kind) {
      tabs.push(i)
      wants.push(natural[i].size.w.min(TAB_MOST))
    } else {
      others += natural[i].size.w
    }
  }
  // The gap the style asks for while everything fits at the width it wants; narrowed as far as
  // [TAB_GAP_LEAST] where it does not, before any tab gives up width.
  let n_gaps = (children.len() - 1).max(0)
  let least_gap = ctx.gap.min(TAB_GAP_LEAST)
  var wanted: f32 = others
  for w in wants { wanted += w }
  let gap = if !c.bounded_w() || n_gaps == 0 { ctx.gap } else {
    ((c.max_w - wanted) / f32(n_gaps)).clamp(least_gap, ctx.gap)
  }
  // The tabs shown, by their place among the tabs; the rest go into the more-tabs menu.
  var shown: []i64 = [k in 0..<tabs.len() | k]
  var more: []Laid<e> = []
  let all_gaps = gap * f32((children.len() - 1).max(0))
  if c.bounded_w() && least_width(wants) > c.max_w - others - all_gaps {
    let empty = more_tabs::<e>([])
    let button_laid = lay(
      empty,
      Constraints { max_h: c.max_h },
      ctx.cascade,
      fonts,
      ctx.ui,
      child_id(ctx.id, empty, children.len()),
      cache
    )
    let others_gaps = gap * f32(children.len() - tabs.len())
    let beside = c.max_w - others - button_laid.size.w - others_gaps
    let selected = selected_tab(children, tabs)
    shown = fitting(wants, beside, gap, selected)
    let hidden = [k in 0..<tabs.len() | !shown.contains(k) | children[tabs[k]]]
    let list = more_tabs(hidden)
    more = [lay(
      list,
      Constraints { max_h: c.max_h },
      ctx.cascade,
      fonts,
      ctx.ui,
      child_id(ctx.id, list, children.len()),
      cache
    )]
    height = height.max(button_laid.size.h)
  }
  let count = shown.len() + more.len() + children.len() - tabs.len()
  let gaps = gap * f32((count - 1).max(0))
  let left = if c.bounded_w() {
    c.max_w - others - gaps - (if more.len() > 0 { more[0].size.w } else { 0.0 })
  } else { UNBOUNDED }
  let widths = shrunk([k in shown | wants[k]], left)
  var placed: []Placed<e> = []
  var x: f32 = 0.0
  for j, k in shown {
    let i = tabs[k]
    let laid = lay(
      children[i],
      Constraints { min_w: widths[j], max_w: widths[j], min_h: height, max_h: height },
      ctx.cascade,
      fonts,
      ctx.ui,
      child_id(ctx.id, children[i], i),
      cache
    )
    placed.push(placed_at(laid, x, height))
    x += laid.size.w + gap
  }
  for laid in more {
    placed.push(placed_at(laid, x, height))
    x += laid.size.w + gap
  }
  for i, child in children {
    if !is_tab(child.kind) {
      placed.push(placed_at(natural[i], x, height))
      x += natural[i].size.w + gap
    }
  }
  Body { size: Size { w: (x - gap).max(0.0), h: height }, children: placed }
}

/// `laid` at `left` along a strip `height` tall, centred down it.
let placed_at<e> = pure (laid: Laid<e>, left: f32, height: f32) -> Placed<e> =>
  Placed { at: Point { x: left, y: (height - laid.size.h) / 2.0 }, laid: laid }

/// The more-tabs button (`TabsMore`, its arrow the `TabsMore::arrow` part): its menu the tabs
/// `hidden` — each by its label, choosing it raising what a press on it would.
let more_tabs<e> = (hidden: []Node<e>) -> Node<e> => {
  var entries: []MenuEntry<e> = []
  for child in hidden {
    if let Tabbed(spot) = child.kind {
      entries.push(MenuItemEntry(MenuItem {
        label: child.label,
        on_select: (spot.on_select)(spot.index),
        checked: spot.selected,
      }))
    }
  }
  opener(select_arrow::<e>(), entries, FloatBelow, false, "TabsMore").keyed("more tabs")
}

/// What a strip from the cache holds as its children (`refreshed`): its own, and — where its
/// layout hid tabs — the more-tabs button made again from those tabs' nodes as they are now.
let strip_children<e> = (laid: Laid<e>, node: Node<e>) -> []Node<e> => {
  let ids = [p in laid.children | p.laid.id]
  let hidden = [
    i in 0..<node.children.len() |
      is_tab(node.children[i].kind) && !ids.contains(child_id(
        laid.id,
        node.children[i],
        i
      )) |
      node.children[i]
  ]
  if hidden.len() == 0 { node.children } else { [...node.children, more_tabs(hidden)] }
}

/// What `wants` come to at their least: each at [TAB_LEAST], or less where it wants less.
let least_width = pure (wants: []f32) -> f32 => {
  var total: f32 = 0.0
  for w in wants { total += w.min(TAB_LEAST) }
  total
}

/// The place among the tabs of the selected one, or -1.
let selected_tab<e> = pure (children: []Node<e>, tabs: []i64) -> i64 => {
  for k, i in tabs {
    if let Tabbed(spot) = children[i].kind { if spot.selected { return k } }
  }
  -1
}

/// The tabs, by place, that fit in `room` at their least, each with a `gap` after it: a run
/// from the first, or one ending at `selected` where the run from the first would not reach
/// it — never none.
let fitting = pure (wants: []f32, room: f32, gap: f32, selected: i64) -> []i64 => {
  var n = 0
  var used: f32 = 0.0
  while n < wants.len() && used + wants[n].min(TAB_LEAST) + gap <= room + 0.5 {
    used += wants[n].min(TAB_LEAST) + gap
    n += 1
  }
  n = n.max(1)
  let start = if selected < n { 0 } else { selected - n + 1 }
  [k in start..<(start + n) | k]
}

/// `wants` made to fit `room` where they do not: each shrunk by its share of what they are over,
/// in proportion to how far it is above [TAB_LEAST], and none below it (or below what it wants,
/// where that is less) — so they may still be wider than the room, and the strip scrolls.
let shrunk = pure (wants: []f32, room: f32) -> []f32 => {
  var total: f32 = 0.0
  var spare: f32 = 0.0
  for w in wants {
    total += w
    spare += (w - TAB_LEAST).max(0.0)
  }
  if total <= room || spare <= 0.0 { return wants }
  let over = (total - room).min(spare)
  [w in wants | w - over * (w - TAB_LEAST).max(0.0) / spare]
}

/// Whether a node of `kind` is a tab.
let is_tab<e> = pure (kind: Kind<e>) -> bool => match kind {
  Tabbed(_) => true,
  _ => false,
}
