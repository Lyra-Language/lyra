module ui.layout
//! Docking (`ui/VEGA.md` §7): panels in tab groups, the groups split and rearranged by
//! dragging a tab — [dock] over a [DockTree].
//!
//! **The arrangement is the program's data**, as a tab bar's order is: the program keeps the
//! tree (and saves it), and the dock raises `on_change` with the tree as a press, a drag or a
//! drop leaves it. Pure functions edit a tree the way the dock does — [dock_with] opening a
//! panel beside another, [dock_without] closing one — so a program places what it opens.
//!
//! **Dragging a tab off its strip docks it**: while it is dragged the dock shows where it would
//! land (`DockPreview`) — a group's middle (its tabs) or a side of it (a split of that group),
//! or the dock's own edge (a split of the whole) — and letting go there moves it ([DockDrop],
//! [dock_aim]). Escape, or letting go over nothing, leaves the tree as it was.
//!
//! **Across windows** (`ui/VEGA.md` §8): dragged out of its window, a tab aims at the dock of
//! another of the program's windows under the pointer, as at its own (`DockDrop.foreign`);
//! let go there, that dock raises its tree with the panel and this one its tree without
//! (`ui.app`'s host carries the drag). Let go outside every window, a dock that
//! [Node.tears_off] raises a [DockTear], and the program opens a window for the panel.

import ui.style.{ Style }

/// An arrangement of panels, each by its key: a group of tabs, or a split of two arrangements.
pub data DockTree = DockTabs(DockGroup) | DockSplit(DockSplitSpec)

/// A group of tabs: its panels' keys in order, and the one shown.
pub struct DockGroup {
  keys: []string = [],
  selected: string = "",
}

/// A split: its two `parts` along `axis` — side by side, or one over the other with
/// `Vertical` — and the share of its room the first has.
pub struct DockSplitSpec {
  axis: Axis = Horizontal,
  at: f32 = 0.5,
  parts: []DockTree = [],
}

/// Where a panel dropped on a group (or on the dock's edge) goes: among its tabs, or beside it.
pub data DockSide = DockCenter | DockLeft | DockRight | DockTop | DockBottom

/// What the program shows for a panel's key: its tab's title, what it holds, and whether its
/// tab has a × (raising the dock's `on_close`).
pub struct DockPanel<e> {
  title: string,
  content: Node<e>,
  closable: bool = true,
}

/// What a dock is to the framework ([Docked]): the tree it shows, the event a drop raises
/// with the tree rearranged, and the one a tab torn off raises ([Node.tears_off]) — none
/// where its tabs do not tear off.
pub struct DockSpec<e> {
  tree: DockTree,
  on_change: (DockTree) -> e,
  on_tear: Maybe<(DockTear) -> e>,
}

/// A tab let go outside every window of the program ([Node.tears_off]): its panel's key, where
/// a window of its own would put its top-left corner on the screens — under the pointer, in the
/// system's coordinates ([Platform.window_position]); `None` where the system does not say where
/// windows are — and the size of the group it was torn from, in logical units.
pub struct DockTear {
  key: string,
  place: Maybe<Point> = None,
  size: Size = Size {},
}

/// A tab being docked (`Interaction.dock_drop`): the dock's identity, the panel's key and the
/// group it came from (a path of a split's parts, `"0"` and `"1"`, from the root `""`); and
/// where it would land — a group by its path and a side of it, or the dock's own edge on
/// `side` — and whether a drop there changes anything (`aimed`). `foreign` for a tab of
/// another window's dock, aimed at this one: `dock` this window's dock, `from` none of its
/// groups.
pub struct DockDrop {
  dock: string = "",
  key: string = "",
  from: string = "",
  group: string = "",
  side: DockSide = DockCenter,
  edge: bool = false,
  aimed: bool = false,
  foreign: bool = false,
}

/// How far the pointer goes off a tab's strip before the tab is docking rather than moving
/// along it.
pub const DOCK_TEAR: f32 = 12.0
/// How near the dock's edge the pointer is for a drop on the edge.
pub const DOCK_EDGE: f32 = 28.0
/// The share of the dock a panel dropped on its edge takes.
pub const DOCK_EDGE_SHARE: f32 = 0.25
/// The least share of a split either part is dragged to.
pub const DOCK_LEAST: f32 = 0.05

/// A group of `keys`, the first shown.
pub let dock_tabs = pure (keys: []string) -> DockTree =>
  DockTabs(DockGroup { keys: keys, selected: if keys.len() > 0 { keys[0] } else { "" } })

/// `first` and `second` along `axis`, the first with `at` of the room.
pub let dock_split = pure (
  axis: Axis,
  at: f32,
  first: DockTree,
  second: DockTree
) -> DockTree =>
  DockSplit(DockSplitSpec { axis: axis, at: at, parts: [first, second] })

/// A dock (`Dock`) showing `tree`: each group (`DockGroup`) a tab bar of its panels' titles
/// over the one selected's content, each split (`DockSplit`) its parts and the edge between
/// them (`SplitEdge`), dragged to share the room anew. `panel` is what each key shows.
/// Selecting a tab, moving one along its strip, dragging a split's edge and docking a tab
/// elsewhere raise `on_change` with the tree that leaves; a tab's × raises `on_close` with its
/// key, and the program takes it out ([dock_without]) or keeps it.
pub let dock<e> = pure (
  tree: DockTree,
  panel: pure (string) -> DockPanel<e>,
  on_change: pure (DockTree) -> e,
  on_close: pure (string) -> e
) -> Node<e> => {
  // Written, not left to a default: a `None` in a field of a generic literal is not typed
  // from the field yet (todo.md).
  let stays: Maybe<(DockTear) -> e> = None
  let kind: Kind<e> = Docked(DockSpec {
    tree: tree,
    on_change: on_change,
    on_tear: stays
  })
  Node {
    kind: kind,
    tag: "Dock",
    children: [dock_part(tree, tree, "", panel, on_change, on_close)]
  }
}

/// The part of `whole` at `path`, `part`.
let dock_part<e> = pure (
  whole: DockTree,
  part: DockTree,
  path: string,
  panel: pure (string) -> DockPanel<e>,
  on_change: pure (DockTree) -> e,
  on_close: pure (string) -> e
) -> Node<e> => match part {
  DockTabs(group) => {
    let keys = group.keys
    let panels = [k in keys | panel(k)]
    let selected = keys.index_of(group.selected) ?? 0
    let strip = tab_bar(TabsSpec::<e> {
      tabs: [i in 0..<keys.len() | TabSpec {
        label: panels[i].title,
        key: keys[i],
        closable: panels[i].closable,
      }],
      selected: selected,
      on_select: (i: i64) -> e => on_change(dock_select(whole, keys[i])),
      on_close: (i: i64) -> e => on_close(keys[i]),
      on_move: (from: i64, to: i64) -> e =>
        on_change(dock_reordered(whole, keys[from], to)),
    })
    let shown: []Node<e> = if panels.len() > 0 {
      [expanded::<e>(panels[selected].content)]
    } else { [] }
    let kind: Kind<e> = DockLeaf(path, keys)
    Node {
      kind: kind,
      tag: "DockGroup",
      children: [column::<e>([strip, ...shown]).aligned(MainStart, CrossStretch)],
    }
  },
  DockSplit(split) => {
    if split.parts.len() < 2 {
      return if split.parts.len() == 1 {
        dock_part(whole, split.parts[0], "${path}0", panel, on_change, on_close)
      } else { column::<e>([]) }
    }
    let first = dock_part(whole, split.parts[0], "${path}0", panel, on_change, on_close)
    let second = dock_part(whole, split.parts[1], "${path}1", panel, on_change, on_close)
    let across = split.axis == Horizontal
    let drags: Kind<e> = Drags(DragSpec {
      axis: split.axis,
      value: f64(split.at),
      min: f64(DOCK_LEAST),
      max: f64(1.0 - DOCK_LEAST),
      share: true,
      on_drag: (v: f64) -> e => on_change(dock_resized(whole, path, f32(v))),
    })
    let edge = Node {
      kind: drags,
      tag: "SplitEdge",
      class: if across { "across" } else { "down" },
      style: if across { Style { width: Some(SPLIT_EDGE) } } else { Style { height: Some(SPLIT_EDGE) } },
    }
    let flow: Kind<e> = Flow(split.axis, MainStart, CrossStretch)
    Node {
      kind: flow,
      tag: "DockSplit",
      children: [expanded::<e>(first, split.at), edge, expanded::<e>(second, 1.0 - split.at)],
    }
  },
}

// ── Editing a tree ───────────────────────────────────────────────────────────

/// Every panel's key in `tree`, group by group.
pub let dock_keys = pure (tree: DockTree) -> []string => match tree {
  DockTabs(group) => group.keys,
  DockSplit(split) => {
    var out: []string = []
    for part in split.parts { out = [...out, ...dock_keys(part)] }
    out
  },
}

/// `tree` with `key` the one its group shows.
pub let dock_select = pure (tree: DockTree, key: string) -> DockTree => match tree {
  DockTabs(group) =>
    if group.keys.contains(key) { DockTabs(DockGroup { group | selected: key }) } else { tree },
  DockSplit(split) =>
    DockSplit(DockSplitSpec { split | parts: [part in split.parts | dock_select(part, key)] }),
}

/// `tree` without the panel `key`: its group shows the tab beside it where it was shown, a
/// group left empty goes, and a split left one part is that part — but the whole tree is
/// never less than an empty group.
pub let dock_without = pure (tree: DockTree, key: string) -> DockTree => match tree {
  DockTabs(group) => {
    let Some(at) = group.keys.index_of(key) else { return tree }
    let rest = [k in group.keys | k != key | k]
    let selected = if group.selected != key { group.selected } else if rest.len() == 0 { "" } else {
      rest[at.min(rest.len() - 1)]
    }
    DockTabs(DockGroup { keys: rest, selected: selected })
  },
  DockSplit(split) => {
    let parts = [part in split.parts | dock_without(part, key)]
    let kept = [part in parts | !is_empty_dock(part) | part]
    if kept.len() == 0 { return dock_tabs([]) }
    if kept.len() == 1 { return kept[0] }
    DockSplit(DockSplitSpec { split | parts: kept })
  },
}

/// `tree` with the panel `key` beside the panel `near` — among its tabs, shown, with
/// `DockCenter`, or in a group of its own on `side` of near's group, sharing its room — or,
/// with `near` `""`, on `side` of the whole dock. Moved there, if it was in the tree; where
/// `near` is not in it, in the first group.
pub let dock_with = pure (
  tree: DockTree,
  key: string,
  near: string,
  side: DockSide
) -> DockTree => {
  if near.len() == 0 { return moved_to(tree, key, "", side, DOCK_EDGE_SHARE) }
  let path = path_of(tree, near) ?? first_group(tree)
  moved_to(tree, key, path, side, 0.5)
}

/// `tree` with the split at `path` giving its first part `at` of its room.
pub let dock_resized = pure (tree: DockTree, path: string, at: f32) -> DockTree =>
  match tree {
    DockTabs(_) => tree,
    DockSplit(split) => {
      if path.len() == 0 {
        return DockSplit(DockSplitSpec { split | at: at.clamp(
          DOCK_LEAST,
          1.0 - DOCK_LEAST
        ) })
      }
      let k = if path.starts_with("1") { 1 } else { 0 }
      let rest = path.slice(1, path.len())
      DockSplit(DockSplitSpec {
        split |
        parts: [i in 0..<split.parts.len() | if i == k { dock_resized(
          split.parts[i],
          rest,
          at
        ) } else { split.parts[i] }]
      })
    },
  }

/// `tree` with the panel `key` moved to place `to` among its group's tabs.
pub let dock_reordered = pure (tree: DockTree, key: string, to: i64) -> DockTree =>
  match tree {
    DockTabs(group) => {
      let Some(from) = group.keys.index_of(key) else { return tree }
      let rest = [k in group.keys | k != key | k]
      let at = to.clamp(0, rest.len())
      DockTabs(DockGroup { group | keys: [
        ...rest.slice(0, at),
        key,
        ...rest.slice(at, rest.len())
      ] })
    },
    DockSplit(split) =>
      DockSplit(DockSplitSpec { split | parts: [part in split.parts | dock_reordered(part, key, to)] }),
  }

/// `tree` with the tab `drop` docks moved where it was dropped.
pub let dock_dropped = pure (tree: DockTree, drop: DockDrop) -> DockTree =>
  if drop.edge { moved_to(tree, drop.key, "", drop.side, DOCK_EDGE_SHARE) } else {
    moved_to(tree, drop.key, drop.group, drop.side, 0.5)
  }

/// A key no program's panel has: where a panel was, while it is placed anew.
const MOVING: string = "\tmoving\t"

/// `tree` with `key` at `side` of the part at `path` — taking `share` of its room, beside it —
/// and gone from where it was. The paths of `tree` hold while it is placed: it is first
/// renamed where it was, and that taken out after.
let moved_to = pure (
  tree: DockTree,
  key: string,
  path: string,
  side: DockSide,
  share: f32
) -> DockTree =>
  dock_without(landed(renamed(tree, key, MOVING), path, key, side, share), MOVING)

/// `tree` with `key` at `side` of its part at `path`.
let landed = pure (
  tree: DockTree,
  path: string,
  key: string,
  side: DockSide,
  share: f32
) -> DockTree => {
  if path.len() == 0 {
    return if side == DockCenter { joined(tree, key) } else {
      let alone = dock_tabs([key])
      let axis = if side == DockLeft || side == DockRight { Horizontal } else { Vertical }
      if side == DockLeft || side == DockTop { dock_split(
        axis,
        share,
        alone,
        tree
      ) } else {
        dock_split(axis, 1.0 - share, tree, alone)
      }
    }
  }
  match tree {
    DockTabs(_) => landed(tree, "", key, side, share),
    DockSplit(split) => {
      let k = if path.starts_with("1") { 1 } else { 0 }
      let rest = path.slice(1, path.len())
      DockSplit(DockSplitSpec {
        split |
        parts: [i in 0..<split.parts.len() | if i == k { landed(
          split.parts[i],
          rest,
          key,
          side,
          share
        ) } else { split.parts[i] }]
      })
    },
  }
}

/// `tree` with `key` among the tabs of its first group, shown.
let joined = pure (tree: DockTree, key: string) -> DockTree => match tree {
  DockTabs(group) => DockTabs(DockGroup { keys: [...group.keys, key], selected: key }),
  DockSplit(split) => {
    if split.parts.len() == 0 { return dock_tabs([key]) }
    DockSplit(DockSplitSpec {
      split |
      parts: [i in 0..<split.parts.len() | if i == 0 { joined(
        split.parts[i],
        key
      ) } else { split.parts[i] }]
    })
  },
}

/// `tree` with the panel `from` called `to`.
let renamed = pure (tree: DockTree, from: string, to: string) -> DockTree => match tree {
  DockTabs(group) => DockTabs(DockGroup {
    keys: [k in group.keys | if k == from { to } else { k }],
    selected: if group.selected == from { to } else { group.selected },
  }),
  DockSplit(split) =>
    DockSplit(DockSplitSpec { split | parts: [part in split.parts | renamed(part, from, to)] }),
}

/// The path of the group holding `key`, if one does.
let path_of = pure (tree: DockTree, key: string) -> Maybe<string> => match tree {
  DockTabs(group) => if group.keys.contains(key) { Some("") } else { None },
  DockSplit(split) => {
    for i, part in split.parts {
      if let Some(below) = path_of(part, key) { return Some("${i}${below}") }
    }
    None
  },
}

/// The path of the first group.
let first_group = pure (tree: DockTree) -> string => match tree {
  DockTabs(_) => "",
  DockSplit(split) =>
    if split.parts.len() == 0 { "" } else { "0${first_group(split.parts[0])}" },
}

/// Whether `tree` is a group with no panel.
let is_empty_dock = pure (tree: DockTree) -> bool => match tree {
  DockTabs(group) => group.keys.len() == 0,
  DockSplit(_) => false,
}

// ── Where a tab lands ────────────────────────────────────────────────────────

/// A group of a dock as laid out: its path, its panels' keys, its box in the dock's
/// coordinates, and how far down its box its tab strip ends.
struct GroupBox {
  path: string,
  keys: []string,
  box: Rect,
  strip: f32,
}

/// `drop` aimed at `at`, in the coordinates of `dock`, the dock's tree laid out (its child):
/// the dock's edge where the pointer is near it, else the group under it — its strip or middle
/// among its tabs, nearer a side beside it. Aimed only where a drop moves something: not the middle of
/// the group it came from, nor anywhere for a group's only tab when that is all there is — but
/// anywhere for a tab of another window's dock (`foreign`).
pub let dock_aim<e> = pure (dock: Laid<e>, at: Point, drop: DockDrop) -> DockDrop => {
  let none = DockDrop { drop | group: "", side: DockCenter, edge: false, aimed: false }
  let whole = Rect { x: 0.0, y: 0.0, w: dock.size.w, h: dock.size.h }
  if !whole.contains(at) { return none }
  let groups = group_boxes(dock)
  let alone = !drop.foreign && groups.len() == 1 && groups[0].keys.len() <= 1
  let (edge_side, edge_gone) = nearest_side(whole, at)
  if edge_gone <= DOCK_EDGE && !alone {
    return DockDrop { drop | group: "", side: edge_side, edge: true, aimed: true }
  }
  for g in groups {
    if !g.box.contains(at) { continue }
    let side = if at.y < g.box.y + g.strip { DockCenter } else {
      let (near, gone) = nearest_side(g.box, at)
      let across = if near == DockLeft || near == DockRight { g.box.w } else { g.box.h }
      if gone > across * 0.25 { DockCenter } else { near }
    }
    let own = !drop.foreign && g.path == drop.from
    let moves = if own { side != DockCenter && g.keys.len() > 1 } else { true }
    return DockDrop { drop | group: g.path, side: side, edge: false, aimed: moves }
  }
  none
}

/// Where `drop` would put its panel, in the coordinates of `dock`, the dock's tree laid out:
/// the part of the group or of the dock it would take.
pub let dock_drop_box<e> = pure (dock: Laid<e>, drop: DockDrop) -> Maybe<Rect> => {
  if !drop.aimed { return None }
  if drop.edge {
    return Some(side_of(
      Rect { x: 0.0, y: 0.0, w: dock.size.w, h: dock.size.h },
      drop.side,
      DOCK_EDGE_SHARE
    ))
  }
  for g in group_boxes(dock) {
    if g.path == drop.group { return Some(side_of(g.box, drop.side, 0.5)) }
  }
  None
}

/// The box of the group at `path` of `dock`, the dock's tree laid out, in its coordinates — if
/// it has one there.
pub let dock_group_box<e> = pure (dock: Laid<e>, path: string) -> Maybe<Rect> => {
  for g in group_boxes(dock) {
    if g.path == path { return Some(g.box) }
  }
  None
}

/// The part of `box` on `side` taking `share` of it; all of it for the middle.
let side_of = pure (box: Rect, side: DockSide, share: f32) -> Rect => match side {
  DockCenter => box,
  DockLeft => Rect { box | w: box.w * share },
  DockRight => Rect { box | x: box.x + box.w * (1.0 - share), w: box.w * share },
  DockTop => Rect { box | h: box.h * share },
  DockBottom => Rect { box | y: box.y + box.h * (1.0 - share), h: box.h * share },
}

/// The side of `box` nearest `at`, and how far `at` is from it.
let nearest_side = pure (box: Rect, at: Point) -> (DockSide, f32) => {
  let left = at.x - box.x
  let right = box.x + box.w - at.x
  let top = at.y - box.y
  let bottom = box.y + box.h - at.y
  var side = DockLeft
  var least = left
  if right < least {
    side = DockRight
    least = right
  }
  if top < least {
    side = DockTop
    least = top
  }
  if bottom < least {
    side = DockBottom
    least = bottom
  }
  (side, least)
}

/// The groups of `dock`, the dock's tree laid out, each where it is in it.
let group_boxes<e> = pure (dock: Laid<e>) -> []GroupBox => {
  var out: []GroupBox = []
  gather_groups(dock, Point {}, out)
  out
}

let gather_groups<e> = (laid: Laid<e>, origin: Point, out: mut []GroupBox) -> void => {
  if let DockLeaf(path, keys) = laid.kind {
    out.push(GroupBox {
      path: path,
      keys: keys,
      box: Rect { x: origin.x, y: origin.y, w: laid.size.w, h: laid.size.h },
      strip: strip_end(laid, 0.0) ?? 0.0,
    })
    return
  }
  for child in laid.children {
    gather_groups(
      child.laid,
      Point { x: origin.x + child.at.x, y: origin.y + child.at.y },
      out
    )
  }
}

/// How far down `laid` — `top` down its parent — its first tab strip ends, if it has one.
let strip_end<e> = pure (laid: Laid<e>, top: f32) -> Maybe<f32> => {
  if let TabStrip = laid.kind { return Some(top + laid.size.h) }
  for child in laid.children {
    if let Some(end) = strip_end(child.laid, top + child.at.y) { return Some(end) }
  }
  None
}

/// The share of a laid-out dock's identity's state that its drop shows: what lays it out anew.
pub let dock_drop_key = pure (drop: DockDrop) -> string =>
  "dock ${drop.key}>${drop.group}:${side_name(drop.side)}:${drop.edge}:${drop.aimed}:${drop.foreign}"

let side_name = pure (side: DockSide) -> string => match side {
  DockCenter => "center",
  DockLeft => "left",
  DockRight => "right",
  DockTop => "top",
  DockBottom => "bottom",
}
