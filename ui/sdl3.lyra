  poll_event,
  wait_event,
  modifiers,
  MOD_SHIFT,
  MOD_CTRL,
  MOD_ALT,
  MOD_GUI,
  start_text_input,
  stop_text_input,
  set_text_input_area,
  clipboard_text,
  set_clipboard_text,
  Cursor as SystemCursor,
  system_cursor,
  set_cursor,
  destroy_cursor,
  CURSOR_DEFAULT,
  CURSOR_TEXT,
  CURSOR_POINTER,
  CURSOR_CROSSHAIR,
  CURSOR_MOVE,
  CURSOR_NOT_ALLOWED,
  CURSOR_WAIT,
  KEY_RETURN,
  KEY_KP_ENTER,
  KEY_ESCAPE,
  KEY_TAB,
  KEY_BACKSPACE,
  KEY_DELETE,
  KEY_LEFT,
  KEY_RIGHT,
  KEY_UP,
  KEY_DOWN,
  KEY_HOME,
  KEY_END,
  KEY_PAGEUP,
  KEY_PAGEDOWN,
}
