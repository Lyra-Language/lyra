/// A window open for an interface: its [SdlPlatform] and [SdlRenderer], which [close] puts
/// away together.
pub struct SdlWindow {
  platform: SdlPlatform,
  renderer: SdlRenderer,
}

/// Open a window `width` × `height` logical units, resizable and at the display's full
/// density — see-through where a frame is translucent, if `see_through` — or why not.
pub let open = (
  title: string,
  width: f32,
  height: f32,
  see_through: bool = false
) -> Result<SdlWindow, string> => {
  let window = first_window(title, width, height, see_through)?
  let Some(renderer) = renderer_for(window) else {
    let why = last_error()
    destroy_window(window)
    quit()
    return Err("SDL could not make a renderer: ${why}")
  }
  var system = platform_for(window)
  if see_through { let _ = system.set_see_through(MAIN_WINDOW, true) }
  Ok(SdlWindow { platform: system, renderer: renderer })
}

/// SDL started and a window `width` × `height` logical units opened, with nothing drawing
/// into it yet — what [open] and `ui.gpu`'s `open` begin with: the platform's main window.
/// `see_through` makes it SDL's transparent window off macOS, the only time SDL takes it; on
/// macOS it is made so after its renderer claims it ([Platform.set_see_through]), since SDL's
/// GPU API refuses one made so.
pub let first_window = (
  title: string,
  width: f32,
  height: f32,
  see_through: bool = false
) -> Result<Window, string> => {
  if !init(INIT_VIDEO) {
    return Err("SDL could not start: ${last_error()}")
  }
  let transparent = if see_through && !apple() { WINDOW_TRANSPARENT } else { 0 }
  let Some(window) = sized_window(title, width, height, transparent) else {
    let why = last_error()
    quit()
    return Err("SDL could not open a window: ${why}")
  }
  Ok(window)
}

/// A resizable window at the display's full density, `width` × `height` logical units, with
/// `flags` besides — or `None`, and [last_error] says why.
let sized_window = (
  title: string,
  width: f32,
  height: f32,
  flags: u64
) -> Maybe<Window> => {
  let Some(window) = create_window(
    title,
    i32(width.round()),
    i32(height.round()),
    WINDOW_RESIZABLE | WINDOW_HIGH_PIXEL_DENSITY | flags
  ) else {
    return None
  }
  // Opened in points, which is a logical unit only on a display whose scale is its density.
  let per_point = units_per_point(window)
  if (per_point - 1.0).abs() > 0.001 {
    set_window_size(
      window,
      i32((width / per_point).round()),
      i32((height / per_point).round())
    )
  }
  Some(window)
}

/// SDL's 2D renderer for `window`, with vsync — or `None`, and [last_error] says why.
pub let renderer_for = (window: Window) -> Maybe<SdlRenderer> => {
  let Some(canvas) = window.create_renderer() else { return None }
  canvas.set_vsync(true)
  Some(SdlRenderer { canvas: canvas, window: window })
}

/// The platform of `window`, its main window — its input, its cursor, and assistive
/// technology told about it — once a renderer draws into it: its Metal layer is pinned
/// (`bindings.gpu`'s `pin_contents`), so a resize never shows the last frame stretched.
pub let platform_for = (window: Window) -> SdlPlatform => {
  pin_contents(window)
  main_number = window_id(window)
  SdlPlatform {
    window: window,
    look: system_look(),
    listening: accesskit.start(window),
    access_keys: hashmap_new(),
  }
}

/// Close the window: its textures, its renderer, the window, and SDL.
pub let close = (platform: SdlPlatform, renderer: SdlRenderer) -> void => {
  release_renderer(renderer)
  close_platform(platform)
}

/// The renderer's textures and the renderer itself put away — every window's.
pub let release_renderer = (renderer: SdlRenderer) -> void => {
  for other in renderer.others { release_canvas(other, renderer.live) }
  for i, texture in renderer.textures { if renderer.live[i] { destroy_texture(texture) } }
  destroy_renderer(renderer.canvas)
}

/// The platform's cursor and windows put away — the main one last — and SDL.
pub let close_platform = (platform: SdlPlatform) -> void => {
  if let Some(shown) = platform.cursor { destroy_cursor(shown) }
  if platform.listening { accesskit.stop() }
  for other in platform.others { destroy_window(other.window) }
  destroy_window(platform.window)
  quit()
}

// ── The platform ─────────────────────────────────────────────────────────────

/// SDL's windows and the input they receive: the main window, and the ones opened beside it
/// ([Platform.open_window]).
pub struct SdlPlatform {
  window: Window,
  /// The windows opened beside the main one, each by its number — SDL's own for it.
  others: []OtherWindow = [],
  /// The cursor shown, made from the platform's own shapes, and which shape it is.
  cursor: Maybe<SystemCursor> = None,
  shape: Cursor = Arrow,
  /// The system's look as last reported, to say when it changes.
  look: Appearance = LightMode,
  /// The main window's state as last said ([WindowStateChanged]).
  state: WindowState = WindowState {},
  /// Whether assistive technology can be told about the main window (AccessKit's adapter is on
  /// it — macOS), and the element each node of the tree it was last told stands for.
  listening: bool = false,
  access_keys: HashMap<u64, string>,
  /// The shape of the menus last installed in the Mac's own bar ([install_menus]), `""` for
  /// none.
  menus_installed: string = "",
  /// The paths of a drop in progress, gathered until it completes ([FilesDropped]).
  dropping: []string = [],
}

/// A window opened beside the main one: its number, the window, and its state as last said.
pub struct OtherWindow {
  id: WindowId,
  window: Window,
  state: WindowState = WindowState {},
}

impl Platform for SdlPlatform {
  next_events = (self, wait_ms) => {
    var events: [](WindowId, InputEvent) = []
    // Every event waiting, read before any is handled, so `next` is never reassigned while
    // an event bound out of it is read (COMPLETED.md 10/29: that freed typed text under it).
    var waiting: []WindowedEvent = []
    var next = if wait_ms == 0 { poll_window_event() } else { wait_window_event(wait_ms) }
    while let Some(got) = next {
      waiting.push(got)
      next = poll_window_event()
    }
    for got in waiting {
      // An event of a window this platform does not have — one just closed — goes nowhere.
      let Some(id) = self.id_of(got.window) else { continue }
      // A drop's files, gathered into one input when it completes.
      match got.event {
        SdlDropBegin => { self.dropping = [] },
        SdlDropFile(path) => { self.dropping.push(path) },
        SdlDropComplete => {
          if self.dropping.len() > 0 { events.push((id, FilesDropped(self.dropping))) }
          self.dropping = []
        },
        _ => {
          let Some(window) = self.window_of(id) else { continue }
          let per_point = units_per_point(window)
          if let Some(input) = translate(got.event, got.modifiers, per_point) {
            events.push((id, input))
          }
        },
      }
    }
    // The items of the Mac's own bar chosen — by click or key equivalent, during SDL's pump —
    // whose choice woke the wait above (`bindings.menubar` pushes an event for it).
    while let Some(tag) = menubar.poll_menu() { events.push((
      MAIN_WINDOW,
      MenuChosen(tag)
    )) }
    // File dialogs answered — possibly from another thread, during SDL's pump or between — whose
    // answer woke the wait (`bindings.dialog` pushes an event for it). A dialog SDL could not
    // show is no choice, and says why.
    while let Some(answer) = dialog.poll() {
      events.push((MAIN_WINDOW, match answer {
        PathChosen(tag, path) => FileAnswered(tag, Some(path)),
        ChoiceCancelled(tag) => FileAnswered(tag, None),
        ChoiceFailed(tag, why) => {
          println("ui.sdl3: the file dialog could not be shown: ${why}")
          FileAnswered(tag, None)
        },
      }))
    }
    // What assistive technology asked for; its request woke the wait above.
    while let Some(raw) = accesskit.next_request() {
      let Some(element) = self.access_keys.get(raw.target) else { continue }
      if let Some(request) = access_request(raw) { events.push((
        MAIN_WINDOW,
        AccessAction(element, request)
      )) }
    }
    // SDL's own theme event wakes the wait above; the look is read rather than the event
    // bound, so a change is said once whatever woke it.
    let look = system_look()
    if look != self.look {
      self.look = look
      events.push((MAIN_WINDOW, AppearanceChanged(look)))
    }
    // Minimized, maximized or fullscreen: read as the look is, said once a change.
    let state = state_of(window_flags(self.window))
    if state != self.state {
      self.state = state
      events.push((MAIN_WINDOW, WindowStateChanged(state)))
    }
    for i, other in self.others {
      let now = state_of(window_flags(other.window))
      if now != other.state {
        self.others[i].state = now
        events.push((other.id, WindowStateChanged(now)))
      }
    }
    events
  }
  held = (self) => modifiers_of(modifiers())
  wake_for = (self, fds) => {
    let _ = wake.watch(fds)
  }
  window_size = (self, id) => {
    let Some(window) = self.window_of(id) else { return Size {} }
    let (w, h) = window_size(window)
    let per_point = units_per_point(window)
    Size { w: f32(w) * per_point, h: f32(h) * per_point }
  }
  scale = (self, id) => match self.window_of(id) {
    Some(window) => window_display_scale(window),
    None => 1.0,
  }
  set_text_input = (self, id, field) => {
    let Some(window) = self.window_of(id) else { return }
    match field {
      Some(area) => {
        let per_point = units_per_point(window)
        set_text_input_area(window, pixel_rect(area.scaled(1.0 / per_point)), 0)
        start_text_input(window)
      },
      None => {
        stop_text_input(window)
      },
    }
  }
  clipboard = (self) => clipboard_text()
  set_clipboard = (self, text) => {
    set_clipboard_text(text)
  }
  set_cursor = (self, shape) => {
    if shape == self.shape {
      return
    }
    let Some(made) = system_cursor(cursor_id(shape)) else { return }
    set_cursor(made)
    if let Some(old) = self.cursor { destroy_cursor(old) }
    self.cursor = Some(made)
    self.shape = shape
  }
  now_ms = (self) => i64(ticks())
  appearance = pure (self) => self.look
  apple = (self) => apple()
  open_url = (self, url) => open_url(url)
  set_size_limits = (self, id, least, most) => {
    let Some(window) = self.window_of(id) else { return }
    let per_point = units_per_point(window)
    let points = (units: f32) -> i32 => i32((units / per_point).round())
    let (least_w, least_h) = (points(least.w), points(least.h))
    let (most_w, most_h) = (points(most.w), points(most.h))
    let _ = set_window_minimum_size(window, least_w, least_h)
    let _ = set_window_maximum_size(window, most_w, most_h)
    // Held to one size both ways, the window does not offer to resize at all — no resizing
    // edges, no zoom button.
    let fixed = least_w > 0 && least_w == most_w && least_h > 0 && least_h == most_h
    let _ = set_window_resizable(window, !fixed)
  }
  set_window_size = (self, id, size) => {
    let Some(window) = self.window_of(id) else { return }
    let per_point = units_per_point(window)
    let points = (units: f32) -> i32 => i32((units / per_point).round())
    let _ = set_window_size(window, points(size.w), points(size.h))
  }
  set_see_through = (self, id, on) => {
    let Some(window) = self.window_of(id) else { return false }
    if apple() { set_see_through(window, on) } else {
      // Made so or not as it opened: an opaque frame hides what is behind a see-through one.
      (window_flags(window) & WINDOW_TRANSPARENT) != 0 || !on
    }
  }
  set_backdrop_blur = (self, id, radius) => match self.window_of(id) {
    Some(window) => set_backdrop_blur(window, i32(radius.round())),
    None => false,
  }
  window_position = (self, id) => {
    let Some(window) = self.window_of(id) else { return None }
    match window_position(window) {
      Some((x, y)) => Some(Point { x: f32(x), y: f32(y) }),
      None => None,
    }
  }
  set_window_position = (self, id, at) => {
    let Some(window) = self.window_of(id) else { return }
    let x = i32(at.x.round())
    let y = i32(at.y.round())
    if on_a_display(x, y) { let _ = set_window_position(window, x, y) }
  }
  to_screen = (self, id, at) => {
    let Some(window) = self.window_of(id) else { return None }
    let Some((x, y)) = window_position(window) else { return None }
    let per_point = units_per_point(window)
    Some(Point { x: f32(x) + at.x / per_point, y: f32(y) + at.y / per_point })
  }
  from_screen = (self, id, at) => {
    let Some(window) = self.window_of(id) else { return None }
    let Some((x, y)) = window_position(window) else { return None }
    let per_point = units_per_point(window)
    Some(Point { x: (at.x - f32(x)) * per_point, y: (at.y - f32(y)) * per_point })
  }
  set_title = (self, id, title) => {
    let Some(window) = self.window_of(id) else { return }
    let _ = set_window_title(window, title)
  }
  window_state = (self, id) => match self.window_of(id) {
    Some(window) => state_of(window_flags(window)),
    None => WindowState {},
  }
  change_window = (self, id, change) => {
    let Some(window) = self.window_of(id) else { return }
    let _ = match change {
      ToMinimized => minimize_window(window),
      ToMaximized => maximize_window(window),
      ToRestored => restore_window(window),
    }
  }
  // A Mac's title bar stays the system's, its buttons where macOS puts them (`ui/WINDOW.md`).
  choose_file = (self, id, tag, d) => {
    let window = self.window_of(id) ?? self.window
    let _ = dialog.show(window, tag, d.save, d.filters, d.start)
  }
  set_decorated = (self, id, on) => {
    let Some(window) = self.window_of(id) else { return }
    if !apple() { let _ = set_window_bordered(window, on) }
  }
  set_window_areas = (self, id, drags, keeps, margin) => {
    if apple() { return }
    let Some(window) = self.window_of(id) else { return }
    // The window's coordinates: SDL's points, not the interface's logical units.
    let per_point = units_per_point(window)
    let _ = hittest.set_areas(
      window,
      flat_areas(drags, per_point),
      flat_areas(keeps, per_point),
      margin / per_point
    )
  }
  set_menus = (self, menus) => {
    self.menus_installed = install_menus(menus, self.menus_installed)
    self.menus_installed.len() > 0
  }
  on_live_resize = (self, hook) => {
    live_hook = Some(hook)
    if !watching {
      watching = unsafe { add_event_watch(on_event, nullptr) }
    }
  }
  update_access = (self, id, tree) => {
    // AccessKit's adapter is on the main window alone, for now (todo.md).
    if !self.listening || id != MAIN_WINDOW { return }
    let pixels = self.scale(MAIN_WINDOW)
    self.access_keys = hashmap_new::<u64, string>()
    accesskit.begin(tree.root, tree.focus)
    for node in tree.nodes {
      self.access_keys.insert(node.id, node.key)
      let at = access_bounds(node.bounds, pixels)
      accesskit.element(
        node.id,
        role_code(node.role),
        node.label,
        node.value,
        node.description,
        f64(at.x),
        f64(at.y),
        f64(at.w),
        f64(at.h),
        match node.toggled {
          Some(ticked) => if ticked { 1 } else { 0 },
          None => -1,
        },
        node.numeric,
        node.actions,
        node.children
      )
    }
    accesskit.commit()
  }
  // Opened hidden, placed, then shown, so it never shows where the system first put it; at
  // its size in logical units, as the main window is.
  open_window = (self, spec) => {
    let Some(window) = sized_window(
      spec.title,
      spec.size.w,
      spec.size.h,
      WINDOW_HIDDEN
    ) else {
      println("ui.sdl3: SDL could not open a window: ${last_error()}")
      return None
    }
    if let Some(at) = spec.place {
      let x = i32(at.x.round())
      let y = i32(at.y.round())
      if on_a_display(x, y) { let _ = set_window_position(window, x, y) }
    }
    let _ = show_window(window)
    pin_contents(window)
    let id = WindowId(i64(window_id(window)))
    self.others.push(OtherWindow {
      id: id,
      window: window,
      state: state_of(window_flags(window))
    })
    Some(id)
  }
  close_window = (self, id) => {
    for other in self.others {
      if other.id == id { destroy_window(other.window) }
    }
    self.others = [o in self.others | o.id != id | o]
  }
}

impl SdlPlatform {
  /// The window numbered `id`: the main window, or one opened beside it — `None` for one that
  /// is not open.
  pub let window_of = pure (self, id: WindowId) -> Maybe<Window> => {
    if id == MAIN_WINDOW { return Some(self.window) }
    for other in self.others {
      if other.id == id { return Some(other.window) }
    }
    None
  }

  /// The window SDL numbers `sdl` ([window_id]) as this platform numbers it: the main window
  /// [MAIN_WINDOW], and an event about no window the main one's — `None` for one that is not
  /// this platform's.
  let id_of = (self, sdl: u32) -> Maybe<WindowId> => {
    if sdl == 0 || sdl == main_number { return Some(MAIN_WINDOW) }
    let id = WindowId(i64(sdl))
    if self.others.any((o) => o.id == id) { Some(id) } else { None }
  }
}

/// A node's bounds as AccessKit's macOS adapter takes them: in the window's **pixels**, from
/// the top left of its content, which it divides by the backing scale itself. `scale` is pixels
/// a logical unit ([SdlPlatform.scale]); given points, VoiceOver's highlight on a Retina
/// display was half the size of the control and at half its offset.
pub let access_bounds = pure (bounds: Rect, scale: f32) -> Rect => bounds.scaled(scale)

/// A role as `bindings.accesskit` numbers it.
let role_code = pure (role: AccessRole) -> i32 => match role {
  AxWindow => 1,
  AxGroup => 2,
  AxLabel => 3,
  AxImage => 4,
  AxButton => 5,
  AxCheckbox => 6,
  AxSlider => 7,
  AxTextInput => 8,
  AxScroll => 9,
  AxComboBox => 10,
  AxListBox => 11,
  AxOption => 12,
  AxTabList => 13,
  AxTab => 14,
  AxRadio => 15,
  AxRadioGroup => 16,
  AxProgress => 17,
  AxTable => 18,
  AxRow => 19,
  AxContainer => 0,
}

/// A request from `bindings.accesskit` as the interface has it, or `None` for a kind it does
/// not know.
let access_request = pure (raw: AccessRequestRaw) -> Maybe<AccessRequest> =>
  match raw.kind {
    1 => Some(AxFocus),
    2 => Some(AxClick),
    3 => Some(AxSetValue(raw.text)),
    4 => Some(AxIncrement),
    5 => Some(AxDecrement),
    6 => Some(AxSetNumber(raw.number)),
    _ => None,
  }

/// The live-resize hook a program handed its platform, whether SDL's event watch is installed,
/// and whether the hook is drawing now — presenting a frame during a live resize can make
/// AppKit ask for another, which must not reach the hook from inside its own frame.
var live_hook: Maybe<(WindowId) -> void> = None
var watching: bool = false
var hook_running: bool = false

/// SDL's number for the main window ([window_id]): the window [MAIN_WINDOW] stands for, where
/// another window's [WindowId] is SDL's own number for it.
var main_number: u32 = 0

/// SDL's event watch: each frame a live resize asks for, handed to the hook with its window —
/// never from inside the hook. (A C callback, so a top-level function; the hook is the
/// program's.)
let on_event = (_: ^u8, event: ^u32) -> u8 => {
  if !live_resize(event) || hook_running { return 1 }
  if let Some(hook) = live_hook {
    let sdl = watched_window(event)
    hook_running = true
    hook(if sdl == main_number { MAIN_WINDOW } else { WindowId(i64(sdl)) })
    hook_running = false
  }
  1
}

/// The system's look, light unless it says dark.
let system_look = () -> Appearance =>
  if system_theme() == ThemeDark { DarkMode } else { LightMode }

/// Logical units a point of `window`'s coordinates is: its pixel density over its display
/// scale.
let units_per_point = (window: Window) -> f32 =>
  window_pixel_density(window) / window_display_scale(window)

/// An SDL event as the interface sees it, positions in logical units, a key's modifiers the
/// ones `held` as it was made — or `None` for one it has no use for.
let translate = (event: Event, held: u16, per_point: f32) -> Maybe<InputEvent> =>
  match event {
    SdlQuit => Some(QuitRequested),
    SdlCloseRequested => Some(CloseRequested),
    SdlResized(w, h) =>
      Some(Resized(Size { w: f32(w) * per_point, h: f32(h) * per_point })),
    SdlMoved(x, y) => Some(WindowPlaced(Point { x: f32(x), y: f32(y) })),
    SdlScaleChanged => Some(ScaleChanged),
    SdlMouseMotion(x, y) =>
      Some(PointerMoved(Point { x: x * per_point, y: y * per_point })),
    SdlMouseDown(button, x, y, clicks) => Some(PointerDown(
      pointer_button(button),
      Point { x: x * per_point, y: y * per_point },
      i64(clicks)
    )),
    SdlMouseUp(button, x, y) =>
      Some(PointerUp(pointer_button(button), Point { x: x * per_point, y: y * per_point })),
    // The content moves as the system's scroll views move theirs: with natural scrolling on,
    // the way the fingers go. Shift turns a wheel's turn across, as every platform's do.
    SdlMouseWheel(x, y, flipped) => {
      let way: f32 = if flipped { -1.0 } else { 1.0 }
      Some(if x.abs() < 0.0001 && modifiers() & MOD_SHIFT != 0 { Scrolled(
        -y * way,
        0.0
      ) } else { Scrolled(x * way, -y * way) })
    },
    SdlKeyDown(code) => Some(KeyPressed(key(code), modifiers_of(held))),
    SdlKeyUp(code) => Some(KeyReleased(key(code), modifiers_of(held))),
    SdlTextInput(text) => Some(TextTyped(text)),
    SdlTextEditing(text, start, length) =>
      Some(TextComposing(text, i64(start), i64(length))),
    SdlFocusGained => Some(WindowFocused),
    SdlFocusLost => Some(WindowUnfocused),
    _ => None,
  }

let pointer_button = pure (button: u8) -> PointerButton => match button {
  1 => Primary,
  2 => Middle,
  3 => Secondary,
  _ => OtherButton(button),
}

/// An SDL key code as a [Key]. SDL's code for a key that types is the character it types
/// (lower case, on the current layout); the rest are the scancode with bit 30 set.
let key = pure (code: u32) -> Key =>
  if code == KEY_RETURN || code == KEY_KP_ENTER {
    Enter
  } else if code == KEY_ESCAPE {
    Escape
  } else if code == KEY_TAB {
    Tab
  } else if code == KEY_BACKSPACE {
    Backspace
  } else if code == KEY_DELETE {
    Delete
  } else if code == KEY_LEFT {
    ArrowLeft
  } else if code == KEY_RIGHT {
    ArrowRight
  } else if code == KEY_UP {
    ArrowUp
  } else if code == KEY_DOWN {
    ArrowDown
  } else if code == KEY_HOME {
    Home
  } else if code == KEY_END {
    End
  } else if code == KEY_PAGEUP {
    PageUp
  } else if code == KEY_PAGEDOWN {
    PageDown
  } else if code == KEY_INSERT {
    Insert
  } else if code >= KEY_F1 && code <= KEY_F12 {
    FunctionKey(i64(code - KEY_F1) + 1)
  } else if code >= KEY_F13 && code <= KEY_F24 {
    FunctionKey(i64(code - KEY_F13) + 13)
  } else if code >= 0x20 && code < 0x40000000 {
    Character(rune(i32(code)))
  } else {
    Unnamed(code)
  }

/// The modifiers in an SDL mask (`MOD_*`). Command is the primary modifier on Apple's systems.
let modifiers_of = (held: u16) -> Modifiers => {
  let command = held & MOD_GUI != 0
  let control = held & MOD_CTRL != 0
  Modifiers {
    shift: held & MOD_SHIFT != 0,
    control: control,
    alt: held & MOD_ALT != 0,
    command: command,
    primary: if apple() { command } else { control },
  }
}

/// The window's state as its `WINDOW_*` flags say.
let state_of = pure (flags: u64) -> WindowState => WindowState {
  minimized: (flags & WINDOW_MINIMIZED) != 0,
  maximized: (flags & WINDOW_MAXIMIZED) != 0,
  fullscreen: (flags & WINDOW_FULLSCREEN) != 0,
}

/// `areas` in logical units as `bindings.hittest` takes them: four numbers each, in points.
let flat_areas = pure (areas: []Rect, per_point: f32) -> []f32 => {
  var out: []f32 = []
  for a in areas {
    out.push(a.x / per_point)
    out.push(a.y / per_point)
    out.push(a.w / per_point)
    out.push(a.h / per_point)
  }
  out
}

/// `menus` in the Mac's own menu bar (`bindings.menubar`): installed — the first as the
/// application menu, named for its title, and macOS's Window menu after the last — where
/// `installed`, the shape last installed, is not theirs ([menu_shape]); then every item greyed
/// and checked as they say. The shape now installed, or `""` where there is no such bar.
pub let install_menus = (menus: []NativeMenu, installed: string) -> string => {
  if platform() != "macOS" || menus.len() == 0 { return "" }
  let shape = menu_shape(menus)
  if shape != installed {
    for i, m in menus {
      if i == 0 { menubar.app_menu() } else { menubar.menu(m.label) }
      add_entries(m.entries)
    }
    menubar.window_menu()
    if !menubar.install(menus[0].label) { return "" }
  }
  for m in menus { sync_entries(m.entries) }
  shape
}

/// What installing menus depends on — their titles, entries and shortcuts, not their greying
/// or checks — as text to compare.
pub let menu_shape = pure (menus: []NativeMenu) -> string =>
  [m in menus | "${m.label}{${entries_shape(m.entries)}}"].join("")

let entries_shape = pure (entries: []NativeEntry) -> string => [
  entry in entries |
    match entry {
      NativeItem(it) => "${it.label}#${it.tag}${match it.shortcut { Some(c) => "@${key_equivalent(c)}${modifier_bits(c)}", None => "" }};",
      NativeSubmenu(label, inner) => "${label}>${entries_shape(inner)}<",
      NativeSeparator => "-;",
    }
].join("")

let add_entries = (entries: []NativeEntry) -> void => {
  for entry in entries {
    match entry {
      NativeItem(it) => match it.shortcut {
        Some(c) => menubar.item(it.label, key_equivalent(c), modifier_bits(c), it.tag),
        None => menubar.item(it.label, "", 0, it.tag),
      },
      NativeSubmenu(label, inner) => {
        menubar.submenu(label)
        add_entries(inner)
        menubar.end_submenu()
      },
      NativeSeparator => menubar.separator(),
    }
  }
}

let sync_entries = (entries: []NativeEntry) -> void => {
  for entry in entries {
    match entry {
      NativeItem(it) => {
        menubar.set_enabled(it.tag, it.enabled)
        menubar.set_checked(it.tag, it.checked)
      },
      NativeSubmenu(_, inner) => sync_entries(inner),
      NativeSeparator => {},
    }
  }
}

/// A shortcut's key as AppKit's key equivalent: a letter in lower case (Shift is a modifier
/// bit), a shifted punctuation key or digit as the character it types ([shifted_key]: AppKit
/// matches ⌘⇧[ as `{` with Command alone, and never as `[` with Shift), the editing keys'
/// control characters, and the arrows, Home, End, the pages, Insert and F1–F24 as AppKit's
/// private-use function-key characters. `""` for a key it has none for.
let key_equivalent = pure (c: Chord) -> string => match c.key {
  Character(r) => match shifted_key(c) {
    Some(typed) => "${typed}",
    None => "${r.to_ascii_lower()}",
  },
  Enter => "\r",
  Tab => "\t",
  Escape => "\e",
  Backspace => "\x08",
  Delete => "\x7f",
  ArrowUp => "${rune(0xF700)}",
  ArrowDown => "${rune(0xF701)}",
  ArrowLeft => "${rune(0xF702)}",
  ArrowRight => "${rune(0xF703)}",
  FunctionKey(n) => if n >= 1 && n <= 24 { "${rune(0xF704 + n - 1)}" } else { "" },
  Insert => "${rune(0xF727)}",
  Home => "${rune(0xF729)}",
  End => "${rune(0xF72B)}",
  PageUp => "${rune(0xF72C)}",
  PageDown => "${rune(0xF72D)}",
  _ => "",
}

/// The character a shortcut's Shift and punctuation key or digit type, on a US layout — the
/// key equivalent AppKit matches them by, Shift in it — or `None`: no Shift, or a letter or
/// another key, whose Shift stays a modifier bit.
let shifted_key = pure (c: Chord) -> Maybe<rune> => {
  if !c.mods.shift { return None }
  let Character(r) = c.key else { return None }
  let plain = "[]=-,./;'\\`1234567890".to_runes()
  let typed = "{}+_<>?:\"|~!@#$%^&*()".to_runes()
  for k, p in plain {
    if p == r { return Some(typed[k]) }
  }
  None
}

/// A shortcut's modifiers as `bindings.menubar`'s bits: the primary modifier is Command here,
/// and a Shift folded into its key ([shifted_key]) is none.
let modifier_bits = pure (c: Chord) -> u32 => {
  let m = c.mods
  let shift = m.shift && shifted_key(c).is_none()
  (if m.primary || m.command { menubar.COMMAND } else { 0 }) | (if shift { menubar.SHIFT } else { 0 }) |
    (if m.alt { menubar.OPTION } else { 0 }) | (if m.control { menubar.CONTROL } else { 0 })
}

let apple = () -> bool => {
  let name = platform()
  name == "macOS" || name == "iOS"
}

let cursor_id = pure (shape: Cursor) -> i32 => match shape {
  Arrow => CURSOR_DEFAULT,
  IBeam => CURSOR_TEXT,
  Hand => CURSOR_POINTER,
  Crosshair => CURSOR_CROSSHAIR,
  Move => CURSOR_MOVE,
  NotAllowed => CURSOR_NOT_ALLOWED,
  Busy => CURSOR_WAIT,
  ResizeAcross => CURSOR_EW_RESIZE,
  ResizeDown => CURSOR_NS_RESIZE,
}

// ── The renderer ─────────────────────────────────────────────────────────────

/// SDL's 2D renderer for the main window, and the textures uploaded to it, a [TextureId] the
/// index of each — and for each other window it has drawn, an SDL renderer of its own.
///
/// **A texture is drawn in any window**, as a [Renderer]'s is; SDL's textures belong to one
/// renderer, so each other window holds a copy of every one, made from what the texture holds
/// (`images`, kept for it) the first time the window is drawn, and written whenever the
/// texture is.
pub struct SdlRenderer {
  canvas: Canvas,
  window: Window,
  textures: []Texture = [],
  /// Whether each texture is held still: a released one's id is taken by the next upload.
  live: []bool = [],
  /// What each live texture holds, for a copy of it in another window.
  images: []Image = [],
  /// The other windows drawn, each by its number.
  others: []OtherCanvas = [],
}

/// Another window [SdlRenderer] draws: its number, the window, its SDL renderer, and its copy
/// of each texture — whether made, where the renderer's is live.
struct OtherCanvas {
  id: WindowId,
  window: Window,
  canvas: Canvas,
  textures: []Texture = [],
  made: []bool = [],
}

impl Renderer for SdlRenderer {
  upload = (self, image) => {
    let Some(texture) = made_texture(self.canvas, image) else { return None }
    var index = self.live.len()
    for i, held in self.live {
      if !held {
        index = i
        break
      }
    }
    if index == self.live.len() {
      self.textures.push(texture)
      self.live.push(true)
      self.images.push(image)
    } else {
      self.textures[index] = texture
      self.live[index] = true
      self.images[index] = image
    }
    for k, other in self.others {
      let copy = made_texture(other.canvas, image)
      while self.others[k].made.len() <= index {
        self.others[k].textures.push(texture)
        self.others[k].made.push(false)
      }
      self.others[k].made[index] = copy.is_some()
      if let Some(t) = copy { self.others[k].textures[index] = t }
    }
    Some(TextureId(index))
  }
  release = (self, id) => {
    let index = i64(id)
    if index < 0 || index >= self.live.len() || !self.live[index] { return }
    destroy_texture(self.textures[index])
    self.live[index] = false
    self.images[index] = Image { width: 0, height: 0, argb: [] }
    for k, other in self.others {
      if index < other.made.len() && other.made[index] {
        destroy_texture(other.textures[index])
        self.others[k].made[index] = false
      }
    }
  }
  update = (self, id, at, image) => {
    let index = i64(id)
    if index < 0 || index >= self.textures.len() || !self.live[index] {
      return false
    }
    let area = PixelRect {
      x: i32(at.x.round()),
      y: i32(at.y.round()),
      w: i32(image.width),
      h: i32(image.height),
    }
    if !update_texture_area(self.textures[index], area, image.argb) { return false }
    self.images[index] = written(self.images[index], area, image)
    for other in self.others {
      if index < other.made.len() && other.made[index] {
        let _ = update_texture_area(other.textures[index], area, image.argb)
      }
    }
    true
  }
  draw = (self, window, background, ops) => {
    if window == MAIN_WINDOW {
      let _ = paint(self.canvas, self.window, self.textures, self.live, background, ops)
      self.canvas.present()
      return
    }
    let Some(k) = self.canvas_of(window) else { return }
    let other = self.others[k]
    let _ = paint(other.canvas, other.window, other.textures, other.made, background, ops)
    other.canvas.present()
  }
  window_closed = (self, window) => {
    for other in self.others {
      if other.id == window { release_canvas(other, self.live) }
    }
    self.others = [o in self.others | o.id != window | o]
  }
}

impl SdlRenderer {
  /// The index among `others` of the window numbered `window` — an SDL renderer made for it,
  /// and a copy of each live texture, the first time it is drawn; `None` for a window SDL does
  /// not have, or one it cannot make a renderer for.
  let canvas_of = (self: mut, window: WindowId) -> Maybe<i64> => {
    for k, other in self.others {
      if other.id == window { return Some(k) }
    }
    // A number SDL has no window for, or the main window's own — a script's platform numbers
    // its windows without SDL — is drawn nowhere.
    let number = u32(i64(window))
    if number == window_id(self.window) { return None }
    let Some(sdl_window) = window_from_id(number) else { return None }
    let Some(canvas) = sdl_window.create_renderer() else {
      println("ui.sdl3: SDL could not make a renderer for another window: ${last_error()}")
      return None
    }
    canvas.set_vsync(true)
    var other = OtherCanvas { id: window, window: sdl_window, canvas: canvas }
    for i, held in self.live {
      let copy = if held { made_texture(canvas, self.images[i]) } else { None }
      other.textures.push(copy ?? self.textures[i])
      other.made.push(copy.is_some())
    }
    self.others.push(other)
    Some(self.others.len() - 1)
  }
}

/// A texture on `canvas` holding `image` — sampled pixel for pixel where it is pixelated — or
/// `None`.
let made_texture = (canvas: Canvas, image: Image) -> Maybe<Texture> => {
  let Some(texture) = create_texture(canvas, image.width, image.height, image.argb) else {
    return None
  }
  if image.pixelated {
    // SDL 3.4's pixel-art mode stays crisp at a scale like 1.5 too, where nearest
    // sampling makes some texels wider than others; an older SDL refuses it.
    if !set_texture_scale_mode(texture, SCALE_PIXELART) {
      set_texture_scale_mode(texture, SCALE_NEAREST)
    }
  }
  Some(texture)
}

/// `image` with `patch` written into it at `area` — what a texture holds after an update.
let written = pure (image: Image, area: PixelRect, patch: Image) -> Image => {
  if area.x == 0 && area.y == 0 && patch.width == image.width && patch.height == image.height {
    return Image { patch | pixelated: image.pixelated }
  }
  var argb = [...image.argb]
  for row in 0..<patch.height {
    let y = i64(area.y) + row
    if y < 0 || y >= image.height { continue }
    for col in 0..<patch.width {
      let x = i64(area.x) + col
      if x < 0 || x >= image.width { continue }
      argb[y * image.width + x] = patch.argb[row * patch.width + col]
    }
  }
  Image { image | argb: argb }
}

/// Another window's SDL renderer and its copies of the textures put away.
let release_canvas = (other: OtherCanvas, live: []bool) -> void => {
  for i,
  made in other.made { if made && i < live.len() { destroy_texture(other.textures[i]) } }
  destroy_renderer(other.canvas)
}

/// The frame [Renderer.draw] would show in the main window, read back rather than shown — what
/// a test compares with the picture it expected. `None` if SDL cannot read it.
pub let capture = (
  renderer: SdlRenderer,
  background: Color,
  ops: []DrawOp
) -> Maybe<Image> => {
  let _ = paint(
    renderer.canvas,
    renderer.window,
    renderer.textures,
    renderer.live,
    background,
    ops
  )
  let Some(frame) = renderer.canvas.read_pixels() else { return None }
  Some(Image { width: frame.width, height: frame.height, argb: frame.argb })
}

/// [capture] in the window numbered `window` — one the renderer has drawn before; `None` for
/// another.
pub let capture_in = (
  renderer: SdlRenderer,
  window: WindowId,
  background: Color,
  ops: []DrawOp
) -> Maybe<Image> => {
  if window == MAIN_WINDOW { return capture(renderer, background, ops) }
  for other in renderer.others {
    if other.id != window { continue }
    let _ = paint(other.canvas, other.window, other.textures, other.made, background, ops)
    let Some(frame) = other.canvas.read_pixels() else { return None }
    return Some(Image { width: frame.width, height: frame.height, argb: frame.argb })
  }
  None
}

/// Clear to `background` and draw `ops`, scaled to pixels, without showing them; how many
/// geometry calls it took.
///
/// **Ops are batched**: each piece — a fill, a border, a run of glyphs, a picture — joins the
/// latest batch drawing from its texture (or from none, for fills and borders) unless a batch
/// after that one overlaps it, which it would then be drawn under instead of over; else it
/// starts a batch of its own. A screen of boxes with labels in them is two calls, the boxes and
/// the labels, whatever their number. A clip ends every batch.
let paint = (
  canvas: Canvas,
  window: Window,
  textures: []Texture,
  live: []bool,
  background: Color,
  ops: []DrawOp
) -> i64 => {
  let scale = window_display_scale(window)
  canvas.clear_clip()
  canvas.set_draw_color(CanvasColor {
    r: background.r,
    g: background.g,
    b: background.b,
    a: background.a
  })
  canvas.clear()
  canvas.set_draw_blend(BLEND_ALPHA)
  var batches: []Batch = []
  var calls = 0
  var clips: []Rect = []
  for op in ops {
    match op {
      Fill(at, radii, color) => {
        let k = batch_for(batches, -1, [at.scaled(scale).inset(-1.0)])
        fill(batches[k].mesh, at.scaled(scale), radii.scaled(scale), color)
      },
      Border(at, radii, width, color) => {
        let k = batch_for(batches, -1, [at.scaled(scale).inset(-1.0)])
        border(
          batches[k].mesh,
          at.scaled(scale),
          radii.scaled(scale),
          width * scale,
          color
        )
      },
      Glyphs(id, glyphs, color) => {
        let Some(texture) = texture_of(textures, live, id) else { continue }
        let k = batch_for(
          batches,
          i64(id),
          [union_of([g in glyphs | g.at.scaled(scale)])]
        )
        for g in glyphs {
          quad(batches[k].mesh, g.at.scaled(scale), in_texture(g.texels, texture), color)
        }
      },
      Picture(id, texels, at, opacity) => {
        let Some(texture) = texture_of(textures, live, id) else { continue }
        let k = batch_for(batches, i64(id), [at.scaled(scale)])
        // The vertices' colour modulates the texture: its alpha the opacity.
        quad(
          batches[k].mesh,
          at.scaled(scale),
          in_texture(texels, texture),
          Color {
            r: 255,
            g: 255,
            b: 255,
            a: u8((opacity.clamp(0.0, 1.0) * 255.0).round())
          }
        )
      },
      GradientFill(at, radii, gradient) => {
        let k = batch_for(batches, -1, [at.scaled(scale).inset(-1.0)])
        fill_gradient(batches[k].mesh, at.scaled(scale), radii.scaled(scale), gradient)
      },
      Shadow(at, radii, shadow) => {
        // Approximated: a Gaussian's falloff as a straight ramp, and an inset shadow as a
        // soft band inside the edge.
        let grown = Rect {
          x: at.x + shadow.x - shadow.spread,
          y: at.y + shadow.y - shadow.spread,
          w: at.w + 2.0 * shadow.spread,
          h: at.h + 2.0 * shadow.spread,
        }.scaled(scale)
        let corners = Radii {
          top_left: radii.top_left + shadow.spread,
          top_right: radii.top_right + shadow.spread,
          bottom_right: radii.bottom_right + shadow.spread,
          bottom_left: radii.bottom_left + shadow.spread,
        }.scaled(scale)
        let reach = (shadow.blur * scale).max(1.0)
        let k = batch_for(batches, -1, [grown.inset(-reach)])
        if shadow.inset {
          border(
            batches[k].mesh,
            at.scaled(scale),
            radii.scaled(scale),
            (shadow.spread + shadow.blur / 2.0).max(1.0) * scale,
            Color { shadow.color | a: u8((f32(shadow.color.a) * 0.6).round()) }
          )
        } else {
          fill_soft(batches[k].mesh, grown, corners, shadow.color, reach * 1.6)
        }
      },
      Backdrop(_, _, _) => { unblurred("backdrop-filter") },
      PushLayer(_, effect) => { if effect.blur > 0.0 { unblurred("filter: blur()") } },
      PopLayer => {},
      PushClip(at, _) => {
        calls += flush(canvas, textures, live, batches)
        let inside = at.scaled(scale)
        let narrowed = if clips.len() == 0 { inside } else { clips[clips.len() - 1].intersect(inside) }
        clips.push(narrowed)
        canvas.set_clip(pixel_rect(narrowed))
      },
      PopClip => {
        calls += flush(canvas, textures, live, batches)
        if clips.len() > 0 {
          clips = clips.slice(0, clips.len() - 1)
        }
        if clips.len() == 0 {
          canvas.clear_clip()
        } else {
          canvas.set_clip(pixel_rect(clips[clips.len() - 1]))
        }
      },
    }
  }
  calls + flush(canvas, textures, live, batches)
}

/// Whether a blur this renderer cannot draw has been said: once a run.
var blur_said: bool = false

/// Say, once a run, that `what` is drawn without its blur here — SDL's 2D renderer has no
/// offscreen pass to blur in; `ui.gpu` does.
let unblurred = (what: string) -> void => {
  if blur_said { return }
  blur_said = true
  let _ = write_stderr("ui.sdl3: ${what} is drawn without blur by SDL's 2D renderer (ui.gpu draws it)\n")
}

/// The geometry calls `ops` take drawn over `background` — drawn, not shown: what a test of
/// the batching counts.
pub let geometry_calls = (
  renderer: SdlRenderer,
  background: Color,
  ops: []DrawOp
) -> i64 =>
  paint(
    renderer.canvas,
    renderer.window,
    renderer.textures,
    renderer.live,
    background,
    ops
  )

/// Triangles drawn in one call: from texture number `texture` (`-1` for none), the pixel
/// rectangles its pieces cover — a run of glyphs as one — and their union, to rule most
/// overlaps out at once.
struct Batch {
  texture: i64,
  mesh: Mesh = Mesh {},
  covers: []Rect = [],
  bounds: Rect = Rect {},
}

/// The batch a piece drawing from `texture` and covering `covers` joins — the latest drawing
/// from the same, if no later batch overlaps the piece — or a new one; its index.
let batch_for = (batches: mut []Batch, texture: i64, covers: []Rect) -> i64 => {
  let piece = union_of(covers)
  var k = batches.len() - 1
  while k >= 0 {
    if batches[k].texture == texture { break }
    if !batches[k].bounds.intersect(piece).is_empty() && overlaps(
      batches[k].covers,
      covers
    ) {
      k = -1
      break
    }
    k -= 1
  }
  if k < 0 {
    batches.push(Batch { texture: texture, bounds: piece })
    k = batches.len() - 1
  }
  for r in covers { batches[k].covers.push(r) }
  batches[k].bounds = union_of([batches[k].bounds, piece])
  k
}

/// The smallest rectangle holding all of `rects` (an empty one for none).
let union_of = pure (rects: []Rect) -> Rect => {
  if rects.len() == 0 { return Rect {} }
  var left = rects[0].x
  var top = rects[0].y
  var right = rects[0].x + rects[0].w
  var bottom = rects[0].y + rects[0].h
  for r in rects {
    if r.is_empty() { continue }
    left = left.min(r.x)
    top = top.min(r.y)
    right = right.max(r.x + r.w)
    bottom = bottom.max(r.y + r.h)
  }
  Rect { x: left, y: top, w: right - left, h: bottom - top }
}

/// Whether any of `a` overlaps any of `b`.
let overlaps = pure (a: []Rect, b: []Rect) -> bool =>
  a.any((x) => b.any((y) => !x.intersect(y).is_empty()))

/// Draw `batches` in order on `canvas`, each in one call, and empty them; how many calls that
/// was.
let flush = (
  canvas: Canvas,
  textures: []Texture,
  live: []bool,
  batches: mut []Batch
) -> i64 => {
  var calls = 0
  for b in batches {
    if b.mesh.indices.len() == 0 { continue }
    if b.texture < 0 {
      canvas.draw_geometry(vertices(b.mesh), b.mesh.indices)
    } else {
      let Some(texture) = texture_of(
        textures,
        live,
        TextureId(b.texture)
      ) else { continue }
      canvas.draw_textured_geometry(texture, vertices(b.mesh), b.mesh.indices)
    }
    calls += 1
  }
  batches = []
  calls
}

/// A mesh's corners as SDL's — the same eight floats, field for field.
let vertices = pure (mesh: Mesh) -> []Vertex => [
  v in mesh.vertices | Vertex {
    x: v.x,
    y: v.y,
    r: v.r,
    g: v.g,
    b: v.b,
    a: v.a,
    u: v.u,
    v: v.v
  }
]

/// Texture `id` of `textures`, where `live` says it is held, lent: the renderer still owns it,
/// and [close] destroys it.
@borrowed
let texture_of = pure (
  textures: []Texture,
  live: []bool,
  id: TextureId
) -> Maybe<Texture> => {
  let index = i64(id)
  if index < 0 || index >= textures.len() || index >= live.len() || !live[index] { None } else {
    Some(textures[index])
  }
}

/// A rectangle in a texture's texels as texture coordinates, `0.0`–`1.0`.
let in_texture = pure (texels: Rect, texture: Texture) -> Rect => Rect {
  x: texels.x / texture.width,
  y: texels.y / texture.height,
  w: texels.w / texture.width,
  h: texels.h / texture.height,
}

/// A rectangle to the nearest whole pixels at each edge.
let pixel_rect = pure (r: Rect) -> PixelRect => {
  let left = r.x.round()
  let top = r.y.round()
  PixelRect {
    x: i32(left),
    y: i32(top),
    w: i32((r.x + r.w).round() - left),
    h: i32((r.y + r.h).round() - top),
  }
}
