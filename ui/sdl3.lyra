/// A window open for an interface: its [SdlPlatform] and [SdlRenderer], which [close] puts
/// away together.
pub struct SdlWindow {
  platform: SdlPlatform,
  renderer: SdlRenderer,
}

/// Open a window `width` × `height` logical units, resizable and at the display's full
/// density — or why not.
pub let open = (title: string, width: f32, height: f32) -> Result<SdlWindow, string> => {
  let window = open_window(title, width, height)?
  let Some(renderer) = renderer_for(window) else {
    let why = last_error()
    destroy_window(window)
    quit()
    return Err("SDL could not make a renderer: ${why}")
  }
  Ok(SdlWindow { platform: platform_for(window), renderer: renderer })
}

/// SDL started and a window `width` × `height` logical units opened, with nothing drawing
/// into it yet — what [open] and `ui.gpu`'s `open` begin with.
pub let open_window = (
  title: string,
  width: f32,
  height: f32
) -> Result<Window, string> => {
  if !init(INIT_VIDEO) {
    return Err("SDL could not start: ${last_error()}")
  }
  let flags = WINDOW_RESIZABLE | WINDOW_HIGH_PIXEL_DENSITY
  let Some(window) = create_window(
    title,
    i32(width.round()),
    i32(height.round()),
    flags
  ) else {
    let why = last_error()
    quit()
    return Err("SDL could not open a window: ${why}")
  }
  // Opened in points, which is a logical unit only on a display whose scale is its density.
  let per_point = units_per_point(window)
  if (per_point - 1.0).abs() > 0.001 {
    set_window_size(
      window,
      i32((width / per_point).round()),
      i32((height / per_point).round())
    )
  }
  Ok(window)
}

/// SDL's 2D renderer for `window`, with vsync — or `None`, and [last_error] says why.
pub let renderer_for = (window: Window) -> Maybe<SdlRenderer> => {
  let Some(canvas) = window.create_renderer() else { return None }
  canvas.set_vsync(true)
  Some(SdlRenderer { canvas: canvas, window: window })
}

/// The platform of `window` — its input, its cursor, and assistive technology told about it —
/// once a renderer draws into it: its Metal layer is pinned (`bindings.gpu`'s
/// `pin_contents`), so a resize never shows the last frame stretched.
pub let platform_for = (window: Window) -> SdlPlatform => {
  pin_contents(window)
  SdlPlatform {
    window: window,
    look: system_look(),
    listening: accesskit.start(window),
    access_keys: hashmap_new(),
  }
}

/// Close the window: its textures, its renderer, the window, and SDL.
pub let close = (platform: SdlPlatform, renderer: SdlRenderer) -> void => {
  release_renderer(renderer)
  close_window(platform)
}

/// The renderer's textures and the renderer itself put away.
pub let release_renderer = (renderer: SdlRenderer) -> void => {
  for texture in renderer.textures { destroy_texture(texture) }
  destroy_renderer(renderer.canvas)
}

/// The platform's cursor and window put away, and SDL.
pub let close_window = (platform: SdlPlatform) -> void => {
  if let Some(shown) = platform.cursor { destroy_cursor(shown) }
  if platform.listening { accesskit.stop() }
  destroy_window(platform.window)
  quit()
}

// ── The platform ─────────────────────────────────────────────────────────────

/// An SDL window and the input it receives.
pub struct SdlPlatform {
  window: Window,
  /// The cursor shown, made from the platform's own shapes, and which shape it is.
  cursor: Maybe<SystemCursor> = None,
  shape: Cursor = Arrow,
  /// The system's look as last reported, to say when it changes.
  look: Appearance = LightMode,
  /// Whether assistive technology can be told about the window (AccessKit's adapter is on
  /// it — macOS), and the element each node of the tree it was last told stands for.
  listening: bool = false,
  access_keys: HashMap<u64, string>,
}

impl Platform for SdlPlatform {
  next_events = (self, wait_ms) => {
    var events: []InputEvent = []
    let per_point = units_per_point(self.window)
    var next = if wait_ms == 0 { poll_event_with_modifiers() } else {
      wait_event_with_modifiers(wait_ms)
    }
    while let Some((event, held)) = next {
      if let Some(input) = translate(event, held, per_point) { events.push(input) }
      next = poll_event_with_modifiers()
    }
    // What assistive technology asked for; its request woke the wait above.
    while let Some(raw) = accesskit.next_request() {
      let Some(element) = self.access_keys.get(raw.target) else { continue }
      if let Some(request) = access_request(raw) { events.push(AccessAction(
        element,
        request
      )) }
    }
    // SDL's own theme event wakes the wait above; the look is read rather than the event
    // bound, so a change is said once whatever woke it.
    let look = system_look()
    if look != self.look {
      self.look = look
      events.push(AppearanceChanged(look))
    }
    events
  }
  held = (self) => modifiers_of(modifiers())
  wake_for = (self, fds) => {
    let _ = wake.watch(fds)
  }
  window_size = (self) => {
    let (w, h) = window_size(self.window)
    let per_point = units_per_point(self.window)
    Size { w: f32(w) * per_point, h: f32(h) * per_point }
  }
  scale = (self) => window_display_scale(self.window)
  set_text_input = (self, field) => match field {
    Some(area) => {
      let per_point = units_per_point(self.window)
      set_text_input_area(self.window, pixel_rect(area.scaled(1.0 / per_point)), 0)
      start_text_input(self.window)
    },
    None => {
      stop_text_input(self.window)
    },
  }
  clipboard = (self) => clipboard_text()
  set_clipboard = (self, text) => {
    set_clipboard_text(text)
  }
  set_cursor = (self, shape) => {
    if shape == self.shape {
      return
    }
    let Some(made) = system_cursor(cursor_id(shape)) else { return }
    set_cursor(made)
    if let Some(old) = self.cursor { destroy_cursor(old) }
    self.cursor = Some(made)
    self.shape = shape
  }
  now_ms = (self) => i64(ticks())
  appearance = pure (self) => self.look
  open_url = (self, url) => open_url(url)
  set_size_limits = (self, least, most) => {
    let per_point = units_per_point(self.window)
    let points = (units: f32) -> i32 => i32((units / per_point).round())
    let (least_w, least_h) = (points(least.w), points(least.h))
    let (most_w, most_h) = (points(most.w), points(most.h))
    let _ = set_window_minimum_size(self.window, least_w, least_h)
    let _ = set_window_maximum_size(self.window, most_w, most_h)
    // Held to one size both ways, the window does not offer to resize at all — no resizing
    // edges, no zoom button.
    let fixed = least_w > 0 && least_w == most_w && least_h > 0 && least_h == most_h
    let _ = set_window_resizable(self.window, !fixed)
  }
  set_window_size = (self, size) => {
    let per_point = units_per_point(self.window)
    let points = (units: f32) -> i32 => i32((units / per_point).round())
    let _ = set_window_size(self.window, points(size.w), points(size.h))
  }
  set_title = (self, title) => {
    let _ = set_window_title(self.window, title)
  }
  on_live_resize = (self, hook) => {
    live_hook = Some(hook)
    if !watching {
      watching = unsafe { add_event_watch(on_event, nullptr) }
    }
  }
  update_access = (self, tree) => {
    if !self.listening { return }
    let pixels = self.scale()
    self.access_keys = hashmap_new::<u64, string>()
    accesskit.begin(tree.root, tree.focus)
    for node in tree.nodes {
      self.access_keys.insert(node.id, node.key)
      let at = access_bounds(node.bounds, pixels)
      accesskit.element(
        node.id,
        role_code(node.role),
        node.label,
        node.value,
        f64(at.x),
        f64(at.y),
        f64(at.w),
        f64(at.h),
        match node.toggled {
          Some(ticked) => if ticked { 1 } else { 0 },
          None => -1,
        },
        node.numeric,
        node.actions,
        node.children
      )
    }
    accesskit.commit()
  }
}

/// A node's bounds as AccessKit's macOS adapter takes them: in the window's **pixels**, from
/// the top left of its content, which it divides by the backing scale itself. `scale` is pixels
/// a logical unit ([SdlPlatform.scale]); given points, VoiceOver's highlight on a Retina
/// display was half the size of the control and at half its offset.
pub let access_bounds = pure (bounds: Rect, scale: f32) -> Rect => bounds.scaled(scale)

/// A role as `bindings.accesskit` numbers it.
let role_code = pure (role: AccessRole) -> i32 => match role {
  AxWindow => 1,
  AxGroup => 2,
  AxLabel => 3,
  AxImage => 4,
  AxButton => 5,
  AxCheckbox => 6,
  AxSlider => 7,
  AxTextInput => 8,
  AxScroll => 9,
  AxComboBox => 10,
  AxListBox => 11,
  AxOption => 12,
  AxContainer => 0,
}

/// A request from `bindings.accesskit` as the interface has it, or `None` for a kind it does
/// not know.
let access_request = pure (raw: AccessRequestRaw) -> Maybe<AccessRequest> =>
  match raw.kind {
    1 => Some(AxFocus),
    2 => Some(AxClick),
    3 => Some(AxSetValue(raw.text)),
    4 => Some(AxIncrement),
    5 => Some(AxDecrement),
    6 => Some(AxSetNumber(raw.number)),
    _ => None,
  }

/// The live-resize hook a program handed its platform, whether SDL's event watch is installed,
/// and whether the hook is drawing now — presenting a frame during a live resize can make
/// AppKit ask for another, which must not reach the hook from inside its own frame.
var live_hook: Maybe<() -> void> = None
var watching: bool = false
var hook_running: bool = false

/// SDL's event watch: each frame a live resize asks for, handed to the hook — never from
/// inside the hook. (A C callback, so a top-level function; the hook is the program's.)
let on_event = (_: ^u8, event: ^u32) -> u8 => {
  if !live_resize(event) || hook_running { return 1 }
  if let Some(hook) = live_hook {
    hook_running = true
    hook()
    hook_running = false
  }
  1
}

/// The system's look, light unless it says dark.
let system_look = () -> Appearance =>
  if system_theme() == ThemeDark { DarkMode } else { LightMode }

/// Logical units a point of `window`'s coordinates is: its pixel density over its display
/// scale.
let units_per_point = (window: Window) -> f32 =>
  window_pixel_density(window) / window_display_scale(window)

/// An SDL event as the interface sees it, positions in logical units, a key's modifiers the
/// ones `held` as it was made — or `None` for one it has no use for.
let translate = (event: Event, held: u16, per_point: f32) -> Maybe<InputEvent> =>
  match event {
    SdlQuit => Some(CloseRequested),
    SdlResized(w, h) =>
      Some(Resized(Size { w: f32(w) * per_point, h: f32(h) * per_point })),
    SdlScaleChanged => Some(ScaleChanged),
    SdlMouseMotion(x, y) =>
      Some(PointerMoved(Point { x: x * per_point, y: y * per_point })),
    SdlMouseDown(button, x, y, clicks) => Some(PointerDown(
      pointer_button(button),
      Point { x: x * per_point, y: y * per_point },
      i64(clicks)
    )),
    SdlMouseUp(button, x, y) =>
      Some(PointerUp(pointer_button(button), Point { x: x * per_point, y: y * per_point })),
    // The content moves as the system's scroll views move theirs: with natural scrolling on,
    // the way the fingers go. Shift turns a wheel's turn across, as every platform's do.
    SdlMouseWheel(x, y, flipped) => {
      let way: f32 = if flipped { -1.0 } else { 1.0 }
      Some(if x.abs() < 0.0001 && modifiers() & MOD_SHIFT != 0 { Scrolled(
        -y * way,
        0.0
      ) } else { Scrolled(x * way, -y * way) })
    },
    SdlKeyDown(code) => Some(KeyPressed(key(code), modifiers_of(held))),
    SdlKeyUp(code) => Some(KeyReleased(key(code), modifiers_of(held))),
    SdlTextInput(text) => Some(TextTyped(text)),
    SdlTextEditing(text, start, length) =>
      Some(TextComposing(text, i64(start), i64(length))),
    SdlFocusGained => Some(WindowFocused),
    SdlFocusLost => Some(WindowUnfocused),
    _ => None,
  }

let pointer_button = pure (button: u8) -> PointerButton => match button {
  1 => Primary,
  2 => Middle,
  3 => Secondary,
  _ => OtherButton(button),
}

/// An SDL key code as a [Key]. SDL's code for a key that types is the character it types
/// (lower case, on the current layout); the rest are the scancode with bit 30 set.
let key = pure (code: u32) -> Key =>
  if code == KEY_RETURN || code == KEY_KP_ENTER {
    Enter
  } else if code == KEY_ESCAPE {
    Escape
  } else if code == KEY_TAB {
    Tab
  } else if code == KEY_BACKSPACE {
    Backspace
  } else if code == KEY_DELETE {
    Delete
  } else if code == KEY_LEFT {
    ArrowLeft
  } else if code == KEY_RIGHT {
    ArrowRight
  } else if code == KEY_UP {
    ArrowUp
  } else if code == KEY_DOWN {
    ArrowDown
  } else if code == KEY_HOME {
    Home
  } else if code == KEY_END {
    End
  } else if code == KEY_PAGEUP {
    PageUp
  } else if code == KEY_PAGEDOWN {
    PageDown
  } else if code == KEY_INSERT {
    Insert
  } else if code >= KEY_F1 && code <= KEY_F12 {
    FunctionKey(i64(code - KEY_F1) + 1)
  } else if code >= KEY_F13 && code <= KEY_F24 {
    FunctionKey(i64(code - KEY_F13) + 13)
  } else if code >= 0x20 && code < 0x40000000 {
    Character(rune(i32(code)))
  } else {
    Unnamed(code)
  }

/// The modifiers in an SDL mask (`MOD_*`). Command is the primary modifier on Apple's systems.
let modifiers_of = (held: u16) -> Modifiers => {
  let command = held & MOD_GUI != 0
  let control = held & MOD_CTRL != 0
  Modifiers {
    shift: held & MOD_SHIFT != 0,
    control: control,
    alt: held & MOD_ALT != 0,
    command: command,
    primary: if apple() { command } else { control },
  }
}

let apple = () -> bool => {
  let name = platform()
  name == "macOS" || name == "iOS"
}

let cursor_id = pure (shape: Cursor) -> i32 => match shape {
  Arrow => CURSOR_DEFAULT,
  IBeam => CURSOR_TEXT,
  Hand => CURSOR_POINTER,
  Crosshair => CURSOR_CROSSHAIR,
  Move => CURSOR_MOVE,
  NotAllowed => CURSOR_NOT_ALLOWED,
  Busy => CURSOR_WAIT,
}

// ── The renderer ─────────────────────────────────────────────────────────────

/// SDL's 2D renderer for one window, and the textures uploaded to it, a [TextureId] the
/// index of each.
pub struct SdlRenderer {
  canvas: Canvas,
  window: Window,
  textures: []Texture = [],
}

impl Renderer for SdlRenderer {
  upload = (self, image) => {
    let Some(texture) = create_texture(
      self.canvas,
      image.width,
      image.height,
      image.argb
    ) else {
      return None
    }
    if image.pixelated {
      // SDL 3.4's pixel-art mode stays crisp at a scale like 1.5 too, where nearest
      // sampling makes some texels wider than others; an older SDL refuses it.
      if !set_texture_scale_mode(texture, SCALE_PIXELART) {
        set_texture_scale_mode(texture, SCALE_NEAREST)
      }
    }
    self.textures.push(texture)
    Some(TextureId(self.textures.len() - 1))
  }
  update = (self, id, at, image) => {
    let index = i64(id)
    if index < 0 || index >= self.textures.len() {
      return false
    }
    let area = PixelRect {
      x: i32(at.x.round()),
      y: i32(at.y.round()),
      w: i32(image.width),
      h: i32(image.height),
    }
    update_texture_area(self.textures[index], area, image.argb)
  }
  draw = (self, background, ops) => {
    let _ = paint(self, background, ops)
    self.canvas.present()
  }
}

/// The frame [Renderer.draw] would show, read back rather than shown — what a test compares
/// with the picture it expected. `None` if SDL cannot read it.
pub let capture = (
  renderer: SdlRenderer,
  background: Color,
  ops: []DrawOp
) -> Maybe<Image> => {
  let _ = paint(renderer, background, ops)
  let Some(frame) = renderer.canvas.read_pixels() else { return None }
  Some(Image { width: frame.width, height: frame.height, argb: frame.argb })
}

/// Clear to `background` and draw `ops`, scaled to pixels, without showing them; how many
/// geometry calls it took.
///
/// **Ops are batched**: each piece — a fill, a border, a run of glyphs, a picture — joins the
/// latest batch drawing from its texture (or from none, for fills and borders) unless a batch
/// after that one overlaps it, which it would then be drawn under instead of over; else it
/// starts a batch of its own. A screen of boxes with labels in them is two calls, the boxes and
/// the labels, whatever their number. A clip ends every batch.
let paint = (renderer: SdlRenderer, background: Color, ops: []DrawOp) -> i64 => {
  let canvas = renderer.canvas
  let scale = window_display_scale(renderer.window)
  canvas.clear_clip()
  canvas.set_draw_color(CanvasColor {
    r: background.r,
    g: background.g,
    b: background.b,
    a: background.a
  })
  canvas.clear()
  canvas.set_draw_blend(BLEND_ALPHA)
  var batches: []Batch = []
  var calls = 0
  var clips: []Rect = []
  for op in ops {
    match op {
      Fill(at, radii, color) => {
        let k = batch_for(batches, -1, [at.scaled(scale).inset(-1.0)])
        fill(batches[k].mesh, at.scaled(scale), radii.scaled(scale), color)
      },
      Border(at, radii, width, color) => {
        let k = batch_for(batches, -1, [at.scaled(scale).inset(-1.0)])
        border(
          batches[k].mesh,
          at.scaled(scale),
          radii.scaled(scale),
          width * scale,
          color
        )
      },
      Glyphs(id, glyphs, color) => {
        let Some(texture) = texture_of(renderer, id) else { continue }
        let k = batch_for(
          batches,
          i64(id),
          [union_of([g in glyphs | g.at.scaled(scale)])]
        )
        for g in glyphs {
          quad(batches[k].mesh, g.at.scaled(scale), in_texture(g.texels, texture), color)
        }
      },
      Picture(id, texels, at) => {
        let Some(texture) = texture_of(renderer, id) else { continue }
        let k = batch_for(batches, i64(id), [at.scaled(scale)])
        quad(
          batches[k].mesh,
          at.scaled(scale),
          in_texture(texels, texture),
          Color { r: 255, g: 255, b: 255 }
        )
      },
      GradientFill(at, radii, gradient) => {
        let k = batch_for(batches, -1, [at.scaled(scale).inset(-1.0)])
        fill_gradient(batches[k].mesh, at.scaled(scale), radii.scaled(scale), gradient)
      },
      Shadow(at, radii, shadow) => {
        // Approximated: a Gaussian's falloff as a straight ramp, and an inset shadow as a
        // soft band inside the edge.
        let grown = Rect {
          x: at.x + shadow.x - shadow.spread,
          y: at.y + shadow.y - shadow.spread,
          w: at.w + 2.0 * shadow.spread,
          h: at.h + 2.0 * shadow.spread,
        }.scaled(scale)
        let corners = Radii {
          top_left: radii.top_left + shadow.spread,
          top_right: radii.top_right + shadow.spread,
          bottom_right: radii.bottom_right + shadow.spread,
          bottom_left: radii.bottom_left + shadow.spread,
        }.scaled(scale)
        let reach = (shadow.blur * scale).max(1.0)
        let k = batch_for(batches, -1, [grown.inset(-reach)])
        if shadow.inset {
          border(
            batches[k].mesh,
            at.scaled(scale),
            radii.scaled(scale),
            (shadow.spread + shadow.blur / 2.0).max(1.0) * scale,
            Color { shadow.color | a: u8((f32(shadow.color.a) * 0.6).round()) }
          )
        } else {
          fill_soft(batches[k].mesh, grown, corners, shadow.color, reach * 1.6)
        }
      },
      Backdrop(_, _, _) => { unblurred("backdrop-filter") },
      PushLayer(_, effect) => { if effect.blur > 0.0 { unblurred("filter: blur()") } },
      PopLayer => {},
      PushClip(at, _) => {
        calls += flush(renderer, batches)
        let inside = at.scaled(scale)
        let narrowed = if clips.len() == 0 { inside } else { clips[clips.len() - 1].intersect(inside) }
        clips.push(narrowed)
        canvas.set_clip(pixel_rect(narrowed))
      },
      PopClip => {
        calls += flush(renderer, batches)
        if clips.len() > 0 {
          clips = clips.slice(0, clips.len() - 1)
        }
        if clips.len() == 0 {
          canvas.clear_clip()
        } else {
          canvas.set_clip(pixel_rect(clips[clips.len() - 1]))
        }
      },
    }
  }
  calls + flush(renderer, batches)
}

/// Whether a blur this renderer cannot draw has been said: once a run.
var blur_said: bool = false

/// Say, once a run, that `what` is drawn without its blur here — SDL's 2D renderer has no
/// offscreen pass to blur in; `ui.gpu` does.
let unblurred = (what: string) -> void => {
  if blur_said { return }
  blur_said = true
  let _ = write_stderr("ui.sdl3: ${what} is drawn without blur by SDL's 2D renderer (ui.gpu draws it)\n")
}

/// The geometry calls `ops` take drawn over `background` — drawn, not shown: what a test of
/// the batching counts.
pub let geometry_calls = (
  renderer: SdlRenderer,
  background: Color,
  ops: []DrawOp
) -> i64 =>
  paint(renderer, background, ops)

/// Triangles drawn in one call: from texture number `texture` (`-1` for none), the pixel
/// rectangles its pieces cover — a run of glyphs as one — and their union, to rule most
/// overlaps out at once.
struct Batch {
  texture: i64,
  mesh: Mesh = Mesh {},
  covers: []Rect = [],
  bounds: Rect = Rect {},
}

/// The batch a piece drawing from `texture` and covering `covers` joins — the latest drawing
/// from the same, if no later batch overlaps the piece — or a new one; its index.
let batch_for = (batches: mut []Batch, texture: i64, covers: []Rect) -> i64 => {
  let piece = union_of(covers)
  var k = batches.len() - 1
  while k >= 0 {
    if batches[k].texture == texture { break }
    if !batches[k].bounds.intersect(piece).is_empty() && overlaps(
      batches[k].covers,
      covers
    ) {
      k = -1
      break
    }
    k -= 1
  }
  if k < 0 {
    batches.push(Batch { texture: texture, bounds: piece })
    k = batches.len() - 1
  }
  for r in covers { batches[k].covers.push(r) }
  batches[k].bounds = union_of([batches[k].bounds, piece])
  k
}

/// The smallest rectangle holding all of `rects` (an empty one for none).
let union_of = pure (rects: []Rect) -> Rect => {
  if rects.len() == 0 { return Rect {} }
  var left = rects[0].x
  var top = rects[0].y
  var right = rects[0].x + rects[0].w
  var bottom = rects[0].y + rects[0].h
  for r in rects {
    if r.is_empty() { continue }
    left = left.min(r.x)
    top = top.min(r.y)
    right = right.max(r.x + r.w)
    bottom = bottom.max(r.y + r.h)
  }
  Rect { x: left, y: top, w: right - left, h: bottom - top }
}

/// Whether any of `a` overlaps any of `b`.
let overlaps = pure (a: []Rect, b: []Rect) -> bool =>
  a.any((x) => b.any((y) => !x.intersect(y).is_empty()))

/// Draw `batches` in order, each in one call, and empty them; how many calls that was.
let flush = (renderer: SdlRenderer, batches: mut []Batch) -> i64 => {
  var calls = 0
  for b in batches {
    if b.mesh.indices.len() == 0 { continue }
    if b.texture < 0 {
      renderer.canvas.draw_geometry(vertices(b.mesh), b.mesh.indices)
    } else {
      let Some(texture) = texture_of(renderer, TextureId(b.texture)) else { continue }
      renderer.canvas.draw_textured_geometry(texture, vertices(b.mesh), b.mesh.indices)
    }
    calls += 1
  }
  batches = []
  calls
}

/// A mesh's corners as SDL's — the same eight floats, field for field.
let vertices = pure (mesh: Mesh) -> []Vertex => [
  v in mesh.vertices | Vertex {
    x: v.x,
    y: v.y,
    r: v.r,
    g: v.g,
    b: v.b,
    a: v.a,
    u: v.u,
    v: v.v
  }
]

/// Texture `id`, lent: the renderer still owns it, and [close] destroys it.
@borrowed
let texture_of = pure (renderer: SdlRenderer, id: TextureId) -> Maybe<Texture> => {
  let index = i64(id)
  if index < 0 || index >= renderer.textures.len() { None } else { Some(renderer.textures[index]) }
}

/// A rectangle in a texture's texels as texture coordinates, `0.0`–`1.0`.
let in_texture = pure (texels: Rect, texture: Texture) -> Rect => Rect {
  x: texels.x / texture.width,
  y: texels.y / texture.height,
  w: texels.w / texture.width,
  h: texels.h / texture.height,
}

/// A rectangle to the nearest whole pixels at each edge.
let pixel_rect = pure (r: Rect) -> PixelRect => {
  let left = r.x.round()
  let top = r.y.round()
  PixelRect {
    x: i32(left),
    y: i32(top),
    w: i32((r.x + r.w).round() - left),
    h: i32((r.y + r.h).round() - top),
  }
}
