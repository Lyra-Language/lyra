  destroy_renderer,
  Color as CanvasColor,
  PixelRect,
  Vertex,
  BLEND_ALPHA,
  Texture,
  create_texture,
  update_texture_area,
  destroy_texture,
  Event,
  Quit as SdlQuit,
  WindowResized as SdlResized,
  WindowScaleChanged as SdlScaleChanged,
  MouseMotion as SdlMouseMotion,
  MouseDown as SdlMouseDown,
  MouseUp as SdlMouseUp,
  MouseWheel as SdlMouseWheel,
  KeyDown as SdlKeyDown,
  KeyUp as SdlKeyUp,
