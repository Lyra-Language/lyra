Program(1 statements) {
	Statements: {
		DestructuringDeclStmt {
			Keyword: let
			Pattern: {
				DataPattern(Some) {
					Name: Some
					Pattern: {
						DataPattern(AnotherData) {
							Name: AnotherData
							Pattern: {
								TuplePattern {
									Elements: {
										IdentifierPattern(x) {
											Name: x
										}
										IdentifierPattern(y) {
											Name: y
										}
									}
								}
							}
						}
					}
				}
			}
			Value: {
				IdentifierExpr(some_data) {
					Name: some_data
				}
			}
		}
	}
}
