Program(1 statements) {
	Statements: {
		DestructuringDeclStmt {
			Keyword: let
			Pattern: {
				DataPattern(Some) {
					Name: Some
					Pattern: {
						ArrayPattern {
							Elements: {
								IdentifierPattern(x) {
									Name: x
								}
								IdentifierPattern(y) {
									Name: y
								}
								IdentifierPattern(z) {
									Name: z
								}
							}
						}
					}
				}
			}
			Value: {
