Program(2 statements) {
	Statements: {
		{
			ElseDestructuringStmt {
				DestructuringStatement: {
					DestructuringDeclStmt {
						Keyword: let
						Pattern: {
							StructPattern {
								Fields: {
									{
										StructPatternField(foo) {
											Name: foo
										}
										StructPatternField(bar) {
											Name: bar
										}
									}
								}
							}
						}
						Value: {
							IdentifierExpr(some_struct) {
								Name: some_struct
							}
						}
					}
				}
				Else: {
					BlockExpr {
						Statements: {
							{
								ExpressionStmt {
									Expression: {
										FunctionCallExpr {
											Arguments: {
												ArgumentList {
													Arguments: {
														{
															StringLiteralExpr {
																Value: No struct found
															}
														}
													}
												}
											}
											Function: {
												IdentifierExpr(println) {
													Name: println
												}
											}
										}
									}
								}
							}
						}
					}
				}
			}
			ExpressionStmt {
				Expression: {
					FunctionCallExpr {
						Arguments: {
							ArgumentList {
								Arguments: {
									{
										StringLiteralExpr {
											Value: We got the struct: #{foo}, #{bar}
										}
									}
								}
							}
						}
						Function: {
							IdentifierExpr(println) {
								Name: println
							}
						}
					}
				}
			}
		}
	}
}
