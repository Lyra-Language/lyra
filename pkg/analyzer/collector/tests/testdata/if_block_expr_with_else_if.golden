Program(1 statements) {
	ExpressionStmt(if_expr) {
		IfExpr {
		  Condition: {
		    BooleanBinaryOpExpr {
		    	Left: {
		    		IdentifierExpr(x, IsConst: false)
		    	}
		    	Operator: ==
		    	Right: {
		    		IntegerLiteralExpr(3, Base: 10)
		    	}
		    }
		  }
		  Then: {
		    FunctionCallExpr {
		    	Function: {
		    		IdentifierExpr(println, IsConst: false)
		    	}
		    	Arguments: {
		    		ArgumentList(StringLiteralExpr(x is 3)) {
		    			StringLiteralExpr(x is 3)
		    		}
		    	}
		    }
		  }
		  Else: {
		    IfExpr {
		      Condition: {
		        BooleanBinaryOpExpr {
		        	Left: {
		        		IdentifierExpr(x, IsConst: false)
		        	}
		        	Operator: ==
		        	Right: {
		        		IntegerLiteralExpr(4, Base: 10)
		        	}
		        }
		      }
		      Then: {
		        FunctionCallExpr {
		        	Function: {
		        		IdentifierExpr(println, IsConst: false)
		        	}
		        	Arguments: {
		        		ArgumentList(StringLiteralExpr(x is 4)) {
		        			StringLiteralExpr(x is 4)
		        		}
		        	}
		        }
		      }
		      Else: {
		        FunctionCallExpr {
		        	Function: {
		        		IdentifierExpr(println, IsConst: false)
		        	}
		        	Arguments: {
		        		ArgumentList(StringLiteralExpr(x is not 3 or 4)) {
		        			StringLiteralExpr(x is not 3 or 4)
		        		}
		        	}
		        }
		      }
		    }
		  }
		}
	}
}
