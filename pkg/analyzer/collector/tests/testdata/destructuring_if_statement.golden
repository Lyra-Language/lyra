Program(1 statements) {
	Statements: {
		IfDestructuringStmt {
			DestructuringStatement: {
				DestructuringDeclStmt {
					Keyword: let
					Pattern: {
						ArrayPattern {
							Elements: {
								IdentifierPattern(a) {
									Name: a
								}
								IdentifierPattern(b) {
									Name: b
								}
								IdentifierPattern(c) {
									Name: c
								}
							}
						}
					}
					Value: {
						IdentifierExpr(some_array) {
							Name: some_array
						}
					}
				}
			}
			Then: {
				BlockExpr {
					Statements: {
						ExpressionStmt {
							Expression: {
								FunctionCallExpr {
									Arguments: {
										InterpolatedStringExpr {
											Segments: {
												IdentifierExpr(a) {
													Name: a
												}
												StringLiteralExpr {
													Value: , 
												}
												IdentifierExpr(b) {
													Name: b
												}
												StringLiteralExpr {
													Value: , 
												}
												IdentifierExpr(c) {
													Name: c
												}
											}
										}
									}
									Function: {
										IdentifierExpr(println) {
											Name: println
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}
}
