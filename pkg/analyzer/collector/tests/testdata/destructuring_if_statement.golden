Program(1 statements) {
	Statements: {
		{
			IfDestructuringStmt {
				DestructuringStatement: {
					DestructuringDeclStmt {
						Keyword: let
						Pattern: {
							ArrayPattern {
								Elements: {
									{
										IdentifierPattern(a) {
											Name: a
										}
										IdentifierPattern(b) {
											Name: b
										}
										IdentifierPattern(c) {
											Name: c
										}
									}
								}
							}
						}
						Value: {
							IdentifierExpr(some_array) {
								Name: some_array
							}
						}
					}
				}
				Then: {
					BlockExpr {
						Statements: {
							{
								ExpressionStmt {
									Expression: {
										FunctionCallExpr {
											Arguments: {
												ArgumentList {
													Arguments: {
														{
															StringLiteralExpr {
																Value: #{a}, #{b}, #{c}
															}
														}
													}
												}
											}
											Function: {
												IdentifierExpr(println) {
													Name: println
												}
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}
}
