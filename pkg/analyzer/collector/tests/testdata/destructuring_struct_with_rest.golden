Program(1 statements) {
	Statements: {
		{
			DestructuringDeclStmt {
				Keyword: let
				Pattern: {
					StructPattern {
						Fields: {
							{
								StructPatternField(a) {
									Name: a
								}
								StructPatternField(b) {
									Name: b
								}
								StructPatternField(...) {
									Name: ...
									Pattern: {
										RestPattern {
											Identifier: rest
										}
									}
								}
							}
						}
					}
				}
				Value: {
					IdentifierExpr(some_struct) {
						Name: some_struct
					}
				}
			}
		}
	}
}
