Program(1 statements) {
	Statements: {
		DestructuringDeclStmt {
			Keyword: let
			Pattern: {
				ArrayPattern {
					Elements: {
						RestPattern {
							Identifier: head
						}
						IdentifierPattern(a) {
							Name: a
						}
						IdentifierPattern(b) {
							Name: b
						}
						IdentifierPattern(c) {
							Name: c
						}
					}
				}
			}
			Value: {
				IdentifierExpr(some_array) {
					Name: some_array
				}
			}
		}
	}
}
