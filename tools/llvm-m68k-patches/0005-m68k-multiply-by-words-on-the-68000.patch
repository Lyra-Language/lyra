+/// An i32 multiply on a 68000 or 68010, which multiply only words (`muls.w`, `mulu.w`:
+/// 16 x 16 -> 32 bits, about 70 cycles), as the cheapest of what it can be made of:
+///
+///   - one word multiply, when both operands fit a word, signed or unsigned — a product of
+///     two `i16`s widened, or an index into an array;
+///   - shifts and adds, for a constant of at most three set bits;
+///   - two word multiplies, a shift and an add, when one operand fits an unsigned word —
+///     a constant such as an element's size (`xs[i]` of 166-byte structs), or a value
+///     known to: the other's halves each multiplied, the high one's product shifted up;
+///   - else __mulsi3, the whole 32 x 32 multiply.
+///
+/// Each is the low 32 bits of the product, exactly as the libcall's: a word's halves sum
+/// to the operand modulo 2^32 whatever its sign.
+SDValue M68kTargetLowering::LowerMUL(SDValue Op, SelectionDAG &DAG) const {
+  SDLoc DL(Op);
+  MVT VT = Op.getSimpleValueType();
+  assert(VT == MVT::i32 && !Subtarget.atLeastM68020() &&
+         "only the 68000's and 68010's i32 multiply is custom");
+  SDValue A = Op.getOperand(0), B = Op.getOperand(1);
+  if (isa<ConstantSDNode>(A) && !isa<ConstantSDNode>(B))
+    std::swap(A, B);
+
+  auto Mul16 = [&](bool Signed, SDValue X, SDValue Y) {
+    return DAG.getNode(Signed ? M68kISD::SMUL16 : M68kISD::UMUL16, DL, VT,
+                       DAG.getNode(ISD::TRUNCATE, DL, MVT::i16, X),
+                       DAG.getNode(ISD::TRUNCATE, DL, MVT::i16, Y));
+  };
+
+  if (DAG.ComputeNumSignBits(A) > 16 && DAG.ComputeNumSignBits(B) > 16)
+    return Mul16(/*Signed=*/true, A, B);
+  bool AWord = DAG.computeKnownBits(A).countMinLeadingZeros() >= 16;
+  bool BWord = DAG.computeKnownBits(B).countMinLeadingZeros() >= 16;
+  if (AWord && BWord)
+    return Mul16(/*Signed=*/false, A, B);
+
+  if (auto *C = dyn_cast<ConstantSDNode>(B)) {
+    uint32_t Value = C->getZExtValue();
+    if (llvm::popcount(Value) <= 3) {
+      SDValue Sum;
+      for (unsigned Bit = 0; Bit < 32; ++Bit) {
+        if (!(Value & (1u << Bit)))
+          continue;
+        SDValue Term = Bit == 0 ? A
+                                : DAG.getNode(ISD::SHL, DL, VT, A,
+                                              DAG.getShiftAmountConstant(Bit, VT, DL));
+        Sum = Sum ? DAG.getNode(ISD::ADD, DL, VT, Sum, Term) : Term;
+      }
+      return Sum ? Sum : DAG.getConstant(0, DL, VT);
+    }
+  }
+
+  if (AWord && !BWord) {
+    std::swap(A, B);
+    std::swap(AWord, BWord);
+  }
+  if (BWord) {
+    SDValue Sixteen = DAG.getShiftAmountConstant(16, VT, DL);
+    SDValue Low = Mul16(/*Signed=*/false, A, B);
+    SDValue High = Mul16(/*Signed=*/false,
+                         DAG.getNode(ISD::SRL, DL, VT, A, Sixteen), B);
+    return DAG.getNode(ISD::ADD, DL, VT, Low,
+                       DAG.getNode(ISD::SHL, DL, VT, High, Sixteen));
+  }
+
+  TargetLowering::MakeLibCallOptions CallOptions;
+  return makeLibCall(DAG, RTLIB::MUL_I32, VT, {A, B}, CallOptions, DL).first;
+}
