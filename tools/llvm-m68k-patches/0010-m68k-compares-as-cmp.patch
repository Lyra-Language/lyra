+    // more (x86 avoids 16-bit immediates; on a 68000 they are the cheaper).
     SDVTList VTs = DAG.getVTList(Op0.getValueType(), MVT::i8);
-    SDValue Sub = DAG.getNode(M68kISD::SUB, DL, VTs, Op0, Op1);
-    return SDValue(Sub.getNode(), 1);
+    if (DAG.getNodeIfExists(M68kISD::SUB, VTs, {Op0, Op1}) ||
+        DAG.getNodeIfExists(ISD::SUB, DAG.getVTList(Op0.getValueType()),
+                            {Op0, Op1})) {
+      SDValue Sub = DAG.getNode(M68kISD::SUB, DL, VTs, Op0, Op1);
+      return SDValue(Sub.getNode(), 1);
+    }
+    // CMP's operands are the other way about: (CMP src, dst) sets the flags of
+    // dst - src, as `cmp src, dst` does.
+    return DAG.getNode(M68kISD::CMP, DL, MVT::i8, Op1, Op0);
   }
   return DAG.getNode(M68kISD::CMP, DL, MVT::i8, Op0, Op1);
 }
