   MIB->setDesc(Desc);
   MIB->getOperand(0).setReg(SubDst);
 
+  // An any-extending load is only that: the rest of the register is whatever it was.
+  if (!Extend) {
+    LLVM_DEBUG(dbgs() << "nothing\n");
+    MIB.addReg(Dst, RegState::ImplicitDefine);
+    return true;
+  }
+
   MachineBasicBlock::iterator I = MIB.getInstr();
