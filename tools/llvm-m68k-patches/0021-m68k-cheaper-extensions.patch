+/// A data register cleared with `moveq #0` before `I`, and the move of a narrower value into
+/// its low part begun — the caller adds the source. The move says it reads and writes the
+/// whole register, so nothing after register allocation takes the clear for dead.
+MachineInstrBuilder M68kInstrInfo::AddZeroAndMove(MachineBasicBlock &MBB,
+                                                  MachineBasicBlock::iterator I,
+                                                  DebugLoc DL, Register Dst,
+                                                  MVT MVTDst, MVT MVTSrc,
+                                                  const MCInstrDesc *Load) const {
+  Register Dst32 =
+      MVTDst == MVT::i32
+          ? Dst
+          : Register(RI.getMatchingMegaReg(
+                Dst, RI.getRegClass(M68k::DR32RegClassID)));
+  assert(Dst32 && "No viable MEGA register available");
+  Register SubDst = RI.getSubReg(Dst32, MVTSrc == MVT::i8
+                                            ? M68k::MxSubRegIndex8Lo
+                                            : M68k::MxSubRegIndex16Lo);
+  assert(SubDst && "No viable SUB register available");
+  BuildMI(MBB, I, DL, get(M68k::MOVQ), Dst32).addImm(0);
+  const MCInstrDesc &Move =
+      Load ? *Load : get(MVTSrc == MVT::i8 ? M68k::MOV8dd : M68k::MOV16dd);
+  return BuildMI(MBB, I, DL, Move, SubDst)
+      .addReg(Dst32, RegState::Implicit)
+      .addReg(Dst32, RegState::ImplicitDefine);
+}
