+  // A zero-extending load is `moveq #0` and the narrow load, 12 cycles fewer than the load
+  // and an `and.l` — unless the address reads the register, which the clear would change.
+  bool AddressReadsDst = false;
+  for (unsigned K = 1; K < MIB->getNumOperands(); ++K) {
+    const MachineOperand &MO = MIB->getOperand(K);
+    if (MO.isReg() && MO.getReg() && RI.regsOverlap(MO.getReg(), Dst))
+      AddressReadsDst = true;
+  }
+  if (Extend && !IsSigned && !AddressReadsDst) {
+    LLVM_DEBUG(dbgs() << "MOVEQ before\n");
+    MachineInstrBuilder Load =
+        AddZeroAndMove(*MIB->getParent(), MIB.getInstr(), MIB->getDebugLoc(),
+                       Dst, MVTDst, MVTSrc, &Desc);
+    for (unsigned K = 1; K < MIB->getNumOperands(); ++K)
+      Load.add(MIB->getOperand(K));
+    Load.setMemRefs(MIB->memoperands());
