diff --git a/llvm/test/CodeGen/M68k/Data/zero-extend.ll b/llvm/test/CodeGen/M68k/Data/zero-extend.ll
new file mode 100644
index 0000000..4414dca
--- /dev/null
+++ b/llvm/test/CodeGen/M68k/Data/zero-extend.ll
@@ -0,0 +1,86 @@
+; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py
+; RUN: llc < %s -mtriple=m68k-linux -mcpu=M68000 -verify-machineinstrs | FileCheck %s
+
+; A zero extension is `moveq #0` and the narrow move where the value goes to another
+; register or comes from memory, an AND where it stays in place, and nothing at all where
+; the high bits are anything.
+
+; Into another register, the value live after it: `moveq #0` and the move.
+define i32 @into_another(i16 %a, i16 %b) {
+; CHECK-LABEL: into_another:
+; CHECK:         .cfi_startproc
+; CHECK-NEXT:  ; %bb.0:
+; CHECK-NEXT:    move.w (6,%sp), %d0
+; CHECK-NEXT:    add.w (10,%sp), %d0
+; CHECK-NEXT:    moveq #0, %d1
+; CHECK-NEXT:    move.w %d0, %d1
+; CHECK-NEXT:    ext.l %d0
+; CHECK-NEXT:    sub.l %d1, %d0
+; CHECK-NEXT:    rts
+  %x = add i16 %a, %b
+  %z = zext i16 %x to i32
+  %w = sext i16 %x to i32
+  %r = sub i32 %w, %z
+  ret i32 %r
+}
+
+; From memory: `moveq #0`, then the load.
+define i32 @from_memory(ptr %p) {
+; CHECK-LABEL: from_memory:
+; CHECK:         .cfi_startproc
+; CHECK-NEXT:  ; %bb.0:
+; CHECK-NEXT:    move.l (4,%sp), %a0
+; CHECK-NEXT:    moveq #0, %d0
+; CHECK-NEXT:    move.w (%a0), %d0
+; CHECK-NEXT:    rts
+  %v = load i16, ptr %p
+  %z = zext i16 %v to i32
+  ret i32 %z
+}
+
+; A byte into a word: a word's AND.
+define i16 @byte_to_word(i8 %a, i8 %b) {
+; CHECK-LABEL: byte_to_word:
+; CHECK:         .cfi_startproc
+; CHECK-NEXT:  ; %bb.0:
+; CHECK-NEXT:    move.b (7,%sp), %d0
+; CHECK-NEXT:    add.b (11,%sp), %d0
+; CHECK-NEXT:    and.w #255, %d0
+; CHECK-NEXT:    rts
+  %x = add i8 %a, %b
+  %z = zext i8 %x to i16
+  ret i16 %z
+}
+
+; The address's index is the register loaded: the clear would move the address, so the
+; load and an AND.
+define i32 @index_is_the_destination(ptr %p, i32 %i) {
+; CHECK-LABEL: index_is_the_destination:
+; CHECK:         .cfi_startproc
+; CHECK-NEXT:  ; %bb.0:
+; CHECK-NEXT:    move.l (8,%sp), %d0
+; CHECK-NEXT:    move.l (4,%sp), %a0
+; CHECK-NEXT:    move.b (0,%a0,%d0), %d0
+; CHECK-NEXT:    and.l #255, %d0
+; CHECK-NEXT:    rts
+  %a = getelementptr i8, ptr %p, i32 %i
+  %v = load i8, ptr %a
+  %z = zext i8 %v to i32
+  ret i32 %z
+}
+
+; The high bits shifted out: no extension.
+define i32 @shifted_out(ptr %p) {
+; CHECK-LABEL: shifted_out:
+; CHECK:         .cfi_startproc
+; CHECK-NEXT:  ; %bb.0:
+; CHECK-NEXT:    move.l (4,%sp), %a0
+; CHECK-NEXT:    move.b (%a0), %d0
+; CHECK-NEXT:    moveq #24, %d1
+; CHECK-NEXT:    lsl.l %d1, %d0
+; CHECK-NEXT:    rts
+  %v = load i8, ptr %p
+  %z = zext i8 %v to i32
+  %s = shl i32 %z, 24
+  ret i32 %s
+}
