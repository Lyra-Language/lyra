+// The opcode of a post-increment MOVE (M68kInstrData.td): size 8, 16 or 32, and the
+// destination's and source's addressing modes, as the instruction names spell them.
+static unsigned postIncrementMove(unsigned Size, char Dst, char Src) {
+#define MX_PI(D, S)                                                            \
+  if (Dst == (#D)[0] && Src == (#S)[0])                                        \
+    return Size == 8 ? M68k::MOV8##D##S##_PI                                    \
+                     : Size == 16 ? M68k::MOV16##D##S##_PI : M68k::MOV32##D##S##_PI;
+  MX_PI(o, o)
+  MX_PI(o, i)
+  MX_PI(j, o)
+  MX_PI(p, o)
+  MX_PI(f, o)
+  MX_PI(b, o)
+#undef MX_PI
+  if (Dst == 'o' && Src == 'r')
+    return Size == 8 ? M68k::MOV8od_PI
+                     : Size == 16 ? M68k::MOV16or_PI : M68k::MOV32or_PI;
+  if (Dst == 'r' && Src == 'o')
+    return Size == 8 ? M68k::MOV8do_PI
+                     : Size == 16 ? M68k::MOV16ro_PI : M68k::MOV32ro_PI;
+  llvm_unreachable("no such post-increment move");
+}
+
+// A post-increment load the store \p ST may read itself, as one memory-to-memory MOVE:
+// its value used by the store alone, the store chained straight after it, and the
+// store's address not made from it (or the MOVE would be its own operand).
+static LoadSDNode *foldablePostIncrementLoad(StoreSDNode *ST) {
+  auto *LD = dyn_cast<LoadSDNode>(ST->getValue());
+  if (!LD || LD->isMachineOpcode() || LD->getAddressingMode() != ISD::POST_INC ||
+      LD->getExtensionType() != ISD::NON_EXTLOAD || ST->isTruncatingStore() ||
+      LD->getMemoryVT() != ST->getMemoryVT() || !LD->hasNUsesOfValue(1, 0) ||
+      ST->getChain() != SDValue(LD, 2))
+    return nullptr;
+  SDNode *Ptr = ST->getBasePtr().getNode();
+  if (Ptr == LD || Ptr->hasPredecessor(LD))
+    return nullptr;
+  if (ST->getAddressingMode() != ISD::UNINDEXED) {
+    SDNode *Inc = ST->getOffset().getNode();
+    if (Inc == LD || Inc->hasPredecessor(LD))
+      return nullptr;
+  }
+  return LD;
+}
+
+// An unindexed store's address as a MOVE's destination operands: (An), (d16,An),
+// (d8,An,Xn) or an absolute address.
+bool M68kDAGToDAGISel::selectDestination(StoreSDNode *ST, char &Mode,
+                                         SmallVectorImpl<SDValue> &Ops) {
+  SDValue Addr = ST->getBasePtr(), A, B, C;
+  if (SelectARI(ST, Addr, A)) {
+    Mode = 'j';
+    Ops.push_back(A);
+  } else if (SelectARID(ST, Addr, A, B)) {
+    Mode = 'p';
+    Ops.append({A, B});
+  } else if (SelectARII(ST, Addr, A, B, C)) {
+    Mode = 'f';
+    Ops.append({A, B, C});
+  } else if (SelectAL(ST, Addr, A)) {
+    Mode = 'b';
+    Ops.push_back(A);
+  } else {
+    return false;
+  }
+  return true;
+}
+
+// Post-increment loads and stores, (An)+, which no pattern can name: an indexed node
+// has the address register's new value as a second result. A store of such a load's
+// value reads it itself, so `*p++ = *q++` is one MOVE.
+bool M68kDAGToDAGISel::selectPostIncrement(SDNode *Node) {
+  SDLoc DL(Node);
+  if (auto *LD = dyn_cast<LoadSDNode>(Node)) {
+    if (LD->getAddressingMode() != ISD::POST_INC)
+      return false;
+    EVT From = LD->getMemoryVT(), To = LD->getValueType(0);
+    MachineSDNode *MN = CurDAG->getMachineNode(
+        postIncrementMove(From.getSizeInBits(), 'r', 'o'), DL, From, MVT::i32,
+        MVT::Other, {LD->getBasePtr(), LD->getChain()});
+    CurDAG->setNodeMemRefs(MN, {LD->getMemOperand()});
+    if (From == To) {
+      ReplaceNode(Node, MN);
+      return true;
+    }
+    // Extended in the register, as the patterns for (i32 (zext i8)) and the rest do.
+    bool Signed = LD->getExtensionType() == ISD::SEXTLOAD;
+    unsigned Ext;
+    if (From == MVT::i8 && To == MVT::i16)
+      Ext = Signed ? M68k::MOVSXd16d8 : M68k::MOVZXd16d8;
+    else if (From == MVT::i8)
+      Ext = Signed ? M68k::MOVSXd32d8 : M68k::MOVZXd32d8;
+    else
+      Ext = Signed ? M68k::MOVSXd32d16 : M68k::MOVZXd32d16;
+    SDNode *Wide = CurDAG->getMachineNode(Ext, DL, To, SDValue(MN, 0));
+    ReplaceUses(SDValue(LD, 0), SDValue(Wide, 0));
+    ReplaceUses(SDValue(LD, 1), SDValue(MN, 1));
+    ReplaceUses(SDValue(LD, 2), SDValue(MN, 2));
+    CurDAG->RemoveDeadNode(LD);
+    return true;
+  }
+
+  auto *ST = cast<StoreSDNode>(Node);
+  bool Indexed = ST->getAddressingMode() == ISD::POST_INC;
+  if (!Indexed && ST->getAddressingMode() != ISD::UNINDEXED)
+    return false;
+  LoadSDNode *LD = foldablePostIncrementLoad(ST);
+  if (!Indexed && !LD)
+    return false;
+  unsigned Size = ST->getMemoryVT().getSizeInBits();
+
+  char Dst = 'o', Src = 'r';
+  SmallVector<SDValue, 6> Ops;
+  if (Indexed)
+    Ops.push_back(ST->getBasePtr());
+  else if (!selectDestination(ST, Dst, Ops))
+    return false;
+
+  SmallVector<EVT, 3> VTs;
+  if (Indexed)
+    VTs.push_back(MVT::i32);
+  if (LD) {
+    Src = 'o';
+    Ops.push_back(LD->getBasePtr());
+    VTs.push_back(MVT::i32);
+  } else if (auto *C = dyn_cast<ConstantSDNode>(ST->getValue())) {
+    Src = 'i';
+    Ops.push_back(CurDAG->getSignedTargetConstant(C->getSExtValue(), DL,
+                                                 ST->getMemoryVT()));
+  } else {
+    Ops.push_back(ST->getValue());
+  }
+  Ops.push_back(LD ? LD->getChain() : ST->getChain());
+  VTs.push_back(MVT::Other);
+
+  MachineSDNode *MN = CurDAG->getMachineNode(postIncrementMove(Size, Dst, Src),
+                                             DL, CurDAG->getVTList(VTs), Ops);
+  if (LD)
+    CurDAG->setNodeMemRefs(MN, {LD->getMemOperand(), ST->getMemOperand()});
+  else
+    CurDAG->setNodeMemRefs(MN, {ST->getMemOperand()});
+  unsigned Chain = VTs.size() - 1;
+  if (LD) {
+    // The load's results: its value went only to this store; its new address is the
+    // MOVE's last register result, and its chain the MOVE's.
+    ReplaceUses(SDValue(LD, 1), SDValue(MN, Chain - 1));
+    ReplaceUses(SDValue(LD, 2), SDValue(MN, Chain));
+  }
+  if (Indexed)
+    ReplaceUses(SDValue(ST, 0), SDValue(MN, 0));
+  ReplaceUses(SDValue(ST, Indexed ? 1 : 0), SDValue(MN, Chain));
+  CurDAG->RemoveDeadNode(ST);
+  return true;
+}
