+// A load or store followed by its address register stepped past what it moved, as the
+// 68000's (An)+ does in the move itself: a word copy `move.w (a0)+, (a1)+`, where the
+// increments were two ADDs through data registers. Only whole moves of a byte, word or
+// long (a load extended after, by the selector; never a truncating store), and not from
+// a frame index.
+bool M68kTargetLowering::getPostIndexedAddressParts(SDNode *N, SDNode *Op,
+                                                    SDValue &Base,
+                                                    SDValue &Offset,
+                                                    ISD::MemIndexedMode &AM,
+                                                    SelectionDAG &DAG) const {
+  EVT VT;
+  SDValue Ptr;
+  if (auto *LD = dyn_cast<LoadSDNode>(N)) {
+    EVT To = LD->getValueType(0);
+    if (LD->getExtensionType() != ISD::NON_EXTLOAD &&
+        To != MVT::i16 && To != MVT::i32)
+      return false;
+    VT = LD->getMemoryVT();
+    Ptr = LD->getBasePtr();
+  } else if (auto *ST = dyn_cast<StoreSDNode>(N)) {
+    if (ST->isTruncatingStore())
+      return false;
+    VT = ST->getMemoryVT();
+    Ptr = ST->getBasePtr();
+  } else {
+    return false;
+  }
+  if (VT != MVT::i8 && VT != MVT::i16 && VT != MVT::i32)
+    return false;
+  if (Op->getOpcode() != ISD::ADD || Op->getOperand(0) != Ptr)
+    return false;
+  auto *C = dyn_cast<ConstantSDNode>(Op->getOperand(1));
+  if (!C || C->getSExtValue() != (int64_t)VT.getStoreSize())
+    return false;
+  if (isa<FrameIndexSDNode>(Ptr) || Ptr.getOpcode() == ISD::TargetFrameIndex)
+    return false;
+  Base = Ptr;
+  Offset = Op->getOperand(1);
+  AM = ISD::POST_INC;
+  return true;
+}
