+#include "M68kTargetTransformInfo.h"
+#include "llvm/Analysis/LoopInfo.h"
+#include "llvm/Analysis/ScalarEvolution.h"
+#include "llvm/Analysis/ScalarEvolutionExpressions.h"
+#include "llvm/IR/Instructions.h"
+
+using namespace llvm;
+
+// A byte, word or long: what one MOVE through (An)+ moves.
+static bool movedWhole(Type *Ty) {
+  if (Ty->isPointerTy())
+    return true;
+  auto *IT = dyn_cast<IntegerType>(Ty);
+  return IT && (IT->getBitWidth() == 8 || IT->getBitWidth() == 16 ||
+                IT->getBitWidth() == 32);
+}
+
+// Post-increment only where every access stepping through memory can be one: each a
+// byte, word or long moved whole, its address advancing by just that each pass. An array
+// of structs read a field at a time steps by the struct's size, not the field's, and
+// asked to prefer post-increment there loop strength reduction makes an address register
+// of each field (three for a six-byte struct, where one index did) — more registers to
+// save, and slower, not faster. A loop with no such stream asks for nothing either.
+TargetTransformInfo::AddressingModeKind
+M68kTTIImpl::getPreferredAddressingMode(const Loop *L,
+                                        ScalarEvolution *SE) const {
+  if (!SE)
+    return TargetTransformInfo::AMK_None;
+  bool Any = false;
+  for (const BasicBlock *BB : L->blocks()) {
+    for (const Instruction &I : *BB) {
+      const Value *Ptr;
+      Type *Ty;
+      if (auto *LI = dyn_cast<LoadInst>(&I)) {
+        Ptr = LI->getPointerOperand();
+        Ty = LI->getType();
+      } else if (auto *SI = dyn_cast<StoreInst>(&I)) {
+        Ptr = SI->getPointerOperand();
+        Ty = SI->getValueOperand()->getType();
+      } else {
+        continue;
+      }
+      auto *AR = dyn_cast<SCEVAddRecExpr>(SE->getSCEV(const_cast<Value *>(Ptr)));
+      if (!AR || AR->getLoop() != L)
+        continue; // Loop-invariant (a port), or another loop's.
+      auto *Step = dyn_cast<SCEVConstant>(AR->getStepRecurrence(*SE));
+      if (!AR->isAffine() || !Step || !movedWhole(Ty) ||
+          Step->getAPInt() != getDataLayout().getTypeStoreSize(Ty).getFixedValue())
+        return TargetTransformInfo::AMK_None;
+      Any = true;
+    }
+  }
+  return Any ? TargetTransformInfo::AMK_PostIndexed : TargetTransformInfo::AMK_None;
+}
diff --git a/llvm/lib/Target/M68k/M68kTargetTransformInfo.h b/llvm/lib/Target/M68k/M68kTargetTransformInfo.h
new file mode 100644
index 0000000..596ee68
--- /dev/null
+++ b/llvm/lib/Target/M68k/M68kTargetTransformInfo.h
@@ -0,0 +1,51 @@
+//===-- M68kTargetTransformInfo.h - M68k specific TTI -----------*- C++ -*-===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+///
+/// \file
+/// What the target tells the IR passes: BasicTTIImpl's answers (what M68k had with no
+/// TTI of its own, CodeGenTargetMachineImpl's default) but the addressing a loop
+/// prefers. The 68000 has (An)+ and no scaled index, so a loop stepping through memory
+/// is best one address register a stream, each moved past what it read or wrote, rather
+/// than a counter added to a base at every access — where every access can be (An)+
+/// (see the .cpp). Whether an indexed load or store is legal BasicTTIImpl asks the
+/// target lowering, which says (An)+ is.
+///
+//===----------------------------------------------------------------------===//
+
+#ifndef LLVM_LIB_TARGET_M68K_M68KTARGETTRANSFORMINFO_H
+#define LLVM_LIB_TARGET_M68K_M68KTARGETTRANSFORMINFO_H
+
+#include "M68kSubtarget.h"
+#include "M68kTargetMachine.h"
+#include "llvm/CodeGen/BasicTTIImpl.h"
+#include "llvm/IR/DerivedTypes.h"
+
+namespace llvm {
+
+class M68kTTIImpl final : public BasicTTIImplBase<M68kTTIImpl> {
+  using BaseT = BasicTTIImplBase<M68kTTIImpl>;
+  friend BaseT;
+
+  const M68kSubtarget *ST;
+  const M68kTargetLowering *TLI;
+
+  const M68kSubtarget *getST() const { return ST; }
+  const M68kTargetLowering *getTLI() const { return TLI; }
+
+public:
+  explicit M68kTTIImpl(const M68kTargetMachine *TM, const Function &F)
+      : BaseT(TM, F.getDataLayout()), ST(TM->getSubtargetImpl(F)),
+        TLI(ST->getTargetLowering()) {}
+
+  TargetTransformInfo::AddressingModeKind
+  getPreferredAddressingMode(const Loop *L, ScalarEvolution *SE) const override;
+};
+
+} // end namespace llvm
+
+#endif
diff --git a/llvm/test/CodeGen/M68k/Data/post-increment.ll b/llvm/test/CodeGen/M68k/Data/post-increment.ll
new file mode 100644
index 0000000..8a797b0
--- /dev/null
+++ b/llvm/test/CodeGen/M68k/Data/post-increment.ll
@@ -0,0 +1,203 @@
+; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
+; RUN: llc < %s -mtriple=m68k-linux -mcpu=M68000 -verify-machineinstrs | FileCheck %s
+
+; A loop stepping through memory a whole byte, word or long at a time moves through
+; (An)+, each address register stepped by the move: copies are one MOVE a pass.
+
+define void @copy_words(ptr %a, ptr %b, i32 %n) {
+; CHECK-LABEL: copy_words:
+; CHECK:         .cfi_startproc
+; CHECK-NEXT:  ; %bb.0: ; %entry
+; CHECK-NEXT:    move.l (12,%sp), %d0
+; CHECK-NEXT:    tst.l %d0
+; CHECK-NEXT:    beq .LBB0_3
+; CHECK-NEXT:  ; %bb.1: ; %loop.preheader
+; CHECK-NEXT:    move.l (8,%sp), %a0
+; CHECK-NEXT:    move.l (4,%sp), %a1
+; CHECK-NEXT:  .LBB0_2: ; %loop
+; CHECK-NEXT:    ; =>This Inner Loop Header: Depth=1
+; CHECK-NEXT:    move.w (%a1)+, (%a0)+
+; CHECK-NEXT:    subq.l #1, %d0
+; CHECK-NEXT:    bne .LBB0_2
+; CHECK-NEXT:  .LBB0_3: ; %done
+; CHECK-NEXT:    rts
+entry:
+  %z = icmp eq i32 %n, 0
+  br i1 %z, label %done, label %loop
+loop:
+  %i = phi i32 [0, %entry], [%i.next, %loop]
+  %p = getelementptr i16, ptr %a, i32 %i
+  %q = getelementptr i16, ptr %b, i32 %i
+  %v = load i16, ptr %p, align 2
+  store i16 %v, ptr %q, align 2
+  %i.next = add nuw nsw i32 %i, 1
+  %c = icmp eq i32 %i.next, %n
+  br i1 %c, label %done, label %loop
+done:
+  ret void
+}
+
+; To a port, the stream's one address register stepping.
+define void @to_port(ptr %a) {
+; CHECK-LABEL: to_port:
+; CHECK:         .cfi_startproc
+; CHECK-NEXT:  ; %bb.0: ; %entry
+; CHECK-NEXT:    moveq #64, %d0
+; CHECK-NEXT:    move.l (4,%sp), %a0
+; CHECK-NEXT:    move.l #12582912, %a1
+; CHECK-NEXT:  .LBB1_1: ; %loop
+; CHECK-NEXT:    ; =>This Inner Loop Header: Depth=1
+; CHECK-NEXT:    move.w (%a0)+, (%a1)
+; CHECK-NEXT:    subq.l #1, %d0
+; CHECK-NEXT:    bne .LBB1_1
+; CHECK-NEXT:  ; %bb.2: ; %done
+; CHECK-NEXT:    rts
+entry:
+  br label %loop
+loop:
+  %i = phi i32 [0, %entry], [%i.next, %loop]
+  %p = getelementptr i16, ptr %a, i32 %i
+  %v = load i16, ptr %p, align 2
+  store volatile i16 %v, ptr inttoptr (i32 12582912 to ptr), align 2
+  %i.next = add nuw nsw i32 %i, 1
+  %c = icmp eq i32 %i.next, 64
+  br i1 %c, label %done, label %loop
+done:
+  ret void
+}
+
+define void @clear_longs(ptr %a, i32 %n) {
+; CHECK-LABEL: clear_longs:
+; CHECK:         .cfi_startproc
+; CHECK-NEXT:  ; %bb.0: ; %entry
+; CHECK-NEXT:    move.l (8,%sp), %d0
+; CHECK-NEXT:    tst.l %d0
+; CHECK-NEXT:    beq .LBB2_3
+; CHECK-NEXT:  ; %bb.1: ; %loop.preheader
+; CHECK-NEXT:    move.l (4,%sp), %a0
+; CHECK-NEXT:  .LBB2_2: ; %loop
+; CHECK-NEXT:    ; =>This Inner Loop Header: Depth=1
+; CHECK-NEXT:    move.l #0, (%a0)+
+; CHECK-NEXT:    subq.l #1, %d0
+; CHECK-NEXT:    bne .LBB2_2
+; CHECK-NEXT:  .LBB2_3: ; %done
+; CHECK-NEXT:    rts
+entry:
+  %z = icmp eq i32 %n, 0
+  br i1 %z, label %done, label %loop
+loop:
+  %i = phi i32 [0, %entry], [%i.next, %loop]
+  %p = getelementptr i32, ptr %a, i32 %i
+  store i32 0, ptr %p, align 2
+  %i.next = add nuw nsw i32 %i, 1
+  %c = icmp eq i32 %i.next, %n
+  br i1 %c, label %done, label %loop
+done:
+  ret void
+}
+
+; A byte read and widened: the load through (An)+, the extension after it.
+define i32 @sum_bytes(ptr %a, i32 %n) {
+; CHECK-LABEL: sum_bytes:
+; CHECK:         .cfi_startproc
+; CHECK-NEXT:  ; %bb.0: ; %entry
+; CHECK-NEXT:    subq.l #4, %sp
+; CHECK-NEXT:    .cfi_def_cfa_offset -8
+; CHECK-NEXT:    movem.l %d2, (0,%sp) ; 8-byte Folded Spill
+; CHECK-NEXT:    move.l (12,%sp), %d1
+; CHECK-NEXT:    tst.l %d1
+; CHECK-NEXT:    beq .LBB3_1
+; CHECK-NEXT:  ; %bb.2: ; %loop.preheader
+; CHECK-NEXT:    move.l (8,%sp), %a0
+; CHECK-NEXT:    moveq #0, %d0
+; CHECK-NEXT:  .LBB3_3: ; %loop
+; CHECK-NEXT:    ; =>This Inner Loop Header: Depth=1
+; CHECK-NEXT:    move.b (%a0)+, %d2
+; CHECK-NEXT:    and.l #255, %d2
+; CHECK-NEXT:    add.l %d2, %d0
+; CHECK-NEXT:    subq.l #1, %d1
+; CHECK-NEXT:    bne .LBB3_3
+; CHECK-NEXT:    bra .LBB3_4
+; CHECK-NEXT:  .LBB3_1:
+; CHECK-NEXT:    moveq #0, %d0
+; CHECK-NEXT:  .LBB3_4: ; %done
+; CHECK-NEXT:    movem.l (0,%sp), %d2 ; 8-byte Folded Reload
+; CHECK-NEXT:    addq.l #4, %sp
+; CHECK-NEXT:    rts
+entry:
+  %z = icmp eq i32 %n, 0
+  br i1 %z, label %done, label %loop
+loop:
+  %i = phi i32 [0, %entry], [%i.next, %loop]
+  %s = phi i32 [0, %entry], [%s.next, %loop]
+  %p = getelementptr i8, ptr %a, i32 %i
+  %v = load i8, ptr %p, align 1
+  %w = zext i8 %v to i32
+  %s.next = add i32 %s, %w
+  %i.next = add nuw nsw i32 %i, 1
+  %c = icmp eq i32 %i.next, %n
+  br i1 %c, label %done, label %loop
+done:
+  %r = phi i32 [0, %entry], [%s.next, %loop]
+  ret i32 %r
+}
+
+; Fields of an array of structs step by the struct, not the field: no stream there can
+; be (An)+, and the loop keeps one address register with displacements.
+%pair = type { i16, i16, i16 }
+define i32 @sum_fields(ptr %a, i32 %n) {
+; CHECK-LABEL: sum_fields:
+; CHECK:         .cfi_startproc
+; CHECK-NEXT:  ; %bb.0: ; %entry
+; CHECK-NEXT:    subq.l #8, %sp
+; CHECK-NEXT:    .cfi_def_cfa_offset -12
+; CHECK-NEXT:    movem.l %d2-%d3, (0,%sp) ; 12-byte Folded Spill
+; CHECK-NEXT:    move.l (16,%sp), %d1
+; CHECK-NEXT:    tst.l %d1
+; CHECK-NEXT:    beq .LBB4_1
+; CHECK-NEXT:  ; %bb.2: ; %loop.preheader
+; CHECK-NEXT:    move.l (12,%sp), %d2
+; CHECK-NEXT:    moveq #0, %d0
+; CHECK-NEXT:    addq.l #4, %d2
+; CHECK-NEXT:    move.l %d2, %a0
+; CHECK-NEXT:  .LBB4_3: ; %loop
+; CHECK-NEXT:    ; =>This Inner Loop Header: Depth=1
+; CHECK-NEXT:    move.w (%a0), %d2
+; CHECK-NEXT:    and.l #65535, %d2
+; CHECK-NEXT:    move.w (-2,%a0), %d3
+; CHECK-NEXT:    and.l #65535, %d3
+; CHECK-NEXT:    add.l %d2, %d3
+; CHECK-NEXT:    add.l %d3, %d0
+; CHECK-NEXT:    move.l %a0, %d2
+; CHECK-NEXT:    addq.l #6, %d2
+; CHECK-NEXT:    subq.l #1, %d1
+; CHECK-NEXT:    movea.l %d2, %a0
+; CHECK-NEXT:    bne .LBB4_3
+; CHECK-NEXT:    bra .LBB4_4
+; CHECK-NEXT:  .LBB4_1:
+; CHECK-NEXT:    moveq #0, %d0
+; CHECK-NEXT:  .LBB4_4: ; %done
+; CHECK-NEXT:    movem.l (0,%sp), %d2-%d3 ; 12-byte Folded Reload
+; CHECK-NEXT:    addq.l #8, %sp
+; CHECK-NEXT:    rts
+entry:
+  %z = icmp eq i32 %n, 0
+  br i1 %z, label %done, label %loop
+loop:
+  %i = phi i32 [0, %entry], [%i.next, %loop]
+  %s = phi i32 [0, %entry], [%s.next, %loop]
+  %p = getelementptr %pair, ptr %a, i32 %i, i32 1
+  %q = getelementptr %pair, ptr %a, i32 %i, i32 2
+  %v = load i16, ptr %p, align 2
+  %u = load i16, ptr %q, align 2
+  %vw = zext i16 %v to i32
+  %uw = zext i16 %u to i32
+  %t = add i32 %vw, %uw
+  %s.next = add i32 %s, %t
+  %i.next = add nuw nsw i32 %i, 1
+  %c = icmp eq i32 %i.next, %n
+  br i1 %c, label %done, label %loop
+done:
+  %r = phi i32 [0, %entry], [%s.next, %loop]
+  ret i32 %r
+}
