+// Post-increment: (An)+, with the address register's new value a def tied to the operand,
+// which the instructions above leave out (they are for the assembler). Selected by hand
+// (M68kDAGToDAGISel::selectPostIncrement) from an indexed load or store.
+defvar MxPIDstAMs = ["j", "p", "f", "b"];
+defvar MxPISrcAMs = ["j", "p", "f", "b", "k", "q"];
+let isCodeGenOnly = 1 in {
+foreach TYPE = [MxType8, MxType16, MxType32] in {
+  defvar S = TYPE.Size;
+  defvar PI = !cast<MxOpBundle>("MxOp"#S#"AddrMode_o");
+  defvar SZ = !cast<MxMoveSize>("MxMoveSize"#S);
+  // R <- (An)+
+  foreach REG = !if(!eq(S, 8), ["d"], ["r"]) in
+  let mayLoad = 1, Constraints = "$wb = $src" in
+  def MOV # S # REG # o_PI
+      : MxMove<TYPE.Prefix,
+               (outs !cast<MxOpBundle>("MxOp"#S#"AddrMode_"#REG).Op:$dst, AR32:$wb),
+               (ins PI.Op:$src), [],
+               MxMoveEncoding<SZ, !cast<MxEncMemOp>("MxMoveDstOpEnc_"#REG),
+                              MxMoveSrcOpEnc_o>>;
+  // (An)+ <- R
+  foreach REG = !if(!eq(S, 8), ["d"], ["r"]) in
+  let mayStore = 1, Constraints = "$wb = $dst" in
+  def MOV # S # o # REG # _PI
+      : MxMove<TYPE.Prefix, (outs AR32:$wb),
+               (ins PI.Op:$dst, !cast<MxOpBundle>("MxOp"#S#"AddrMode_"#REG).Op:$src), [],
+               MxMoveEncoding<SZ, MxMoveDstOpEnc_o,
+                              !cast<MxEncMemOp>("MxMoveSrcOpEnc_"#REG)>>;
+  // (An)+ <- #imm
+  let mayStore = 1, Constraints = "$wb = $dst" in
+  def MOV # S # oi_PI
+      : MxMove<TYPE.Prefix, (outs AR32:$wb),
+               (ins PI.Op:$dst, !cast<MxImmOpBundle>("MxOp"#S#"AddrMode_i").Op:$src), [],
+               MxMoveEncoding<SZ, MxMoveDstOpEnc_o, MxEncAddrMode_i<"src", S>>>;
+  // M <- (An)+
+  foreach AM = MxPIDstAMs in
+  let mayLoad = 1, mayStore = 1, Constraints = "$wb = $src" in
+  def MOV # S # AM # o_PI
+      : MxMove<TYPE.Prefix, (outs AR32:$wb),
+               (ins !cast<MxOpBundle>("MxOp"#S#"AddrMode_"#AM).Op:$dst, PI.Op:$src), [],
