@@ -0,0 +1,27 @@
+; RUN: llvm-mc -triple=m68k -show-encoding %s | FileCheck %s
+
+; ADDQ and SUBQ: the constant 1 to 8 in bits 11-9, 8 written as 0.
+; CHECK:      addq.b  #1, %d0
+; CHECK-SAME: encoding: [0x52,0x00]
+addq.b	#1, %d0
+; CHECK:      addq.w  #8, %d3
+; CHECK-SAME: encoding: [0x50,0x43]
+addq.w	#8, %d3
+; CHECK:      addq.l  #1, %d0
+; CHECK-SAME: encoding: [0x52,0x80]
+addq.l	#1, %d0
+; CHECK:      subq.b  #1, %d0
+; CHECK-SAME: encoding: [0x53,0x00]
+subq.b	#1, %d0
+; CHECK:      subq.w  #3, %d7
+; CHECK-SAME: encoding: [0x57,0x47]
+subq.w	#3, %d7
+; CHECK:      subq.l  #2, %d1
+; CHECK-SAME: encoding: [0x55,0x81]
+subq.l	#2, %d1
+; CHECK:      addq.l  #4, %sp
+; CHECK-SAME: encoding: [0x58,0x8f]
+addq.l	#4, %sp
+; CHECK:      subq.l  #8, %a0
+; CHECK-SAME: encoding: [0x51,0x88]
+subq.l	#8, %a0
