+  bool SRetInReg = !ArgLocs.empty() && ArgLocs[0].isRegLoc();
 
   unsigned LastVal = ~0U;
   SDValue ArgValue;
@@ -1057,7 +1065,8 @@
   } else {
     MMFI->setBytesToPopOnReturn(0); // Callee pops nothing.
