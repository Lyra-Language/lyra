   case M68k::Bcc16:
-    return M68k::Bcc32;
+    return Far ? M68k::Bccfar : M68k::Bcc32;
   case M68k::Bls16:
-    return M68k::Bls32;
+    return Far ? M68k::Blsfar : M68k::Bls32;
   case M68k::Blt16:
-    return M68k::Blt32;
+    return Far ? M68k::Bltfar : M68k::Blt32;
   case M68k::Beq16:
-    return M68k::Beq32;
+    return Far ? M68k::Beqfar : M68k::Beq32;
   case M68k::Bmi16:
-    return M68k::Bmi32;
+    return Far ? M68k::Bmifar : M68k::Bmi32;
   case M68k::Bne16:
-    return M68k::Bne32;
+    return Far ? M68k::Bnefar : M68k::Bne32;
   case M68k::Bge16:
-    return M68k::Bge32;
+    return Far ? M68k::Bgefar : M68k::Bge32;
   case M68k::Bcs16:
-    return M68k::Bcs32;
+    return Far ? M68k::Bcsfar : M68k::Bcs32;
   case M68k::Bpl16:
-    return M68k::Bpl32;
+    return Far ? M68k::Bplfar : M68k::Bpl32;
   case M68k::Bgt16:
-    return M68k::Bgt32;
+    return Far ? M68k::Bgtfar : M68k::Bgt32;
   case M68k::Bhi16:
-    return M68k::Bhi32;
+    return Far ? M68k::Bhifar : M68k::Bhi32;
   case M68k::Bvc16:
-    return M68k::Bvc32;
+    return Far ? M68k::Bvcfar : M68k::Bvc32;
   case M68k::Ble16:
-    return M68k::Ble32;
+    return Far ? M68k::Blefar : M68k::Ble32;
   case M68k::Bvs16:
