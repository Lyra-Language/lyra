diff --git a/llvm/lib/Target/M68k/M68kInstrControl.td b/llvm/lib/Target/M68k/M68kInstrControl.td
index b22b3a3ba..6f06df609 100644
--- a/llvm/lib/Target/M68k/M68kInstrControl.td
+++ b/llvm/lib/Target/M68k/M68kInstrControl.td
@@ -237,6 +237,38 @@ def BRA32 : MxBra<MxBrTarget32, (descend 0b1111, 0b1111),
 
 def : Pat<(br bb:$target), (BRA8 MxBrTarget8:$target)>;
 
+// Far branches, for the CPUs without a 32-bit displacement (the 68000 and 68010). A
+// displacement past 16 bits has no branch form there, so the assembler backend relaxes a
+// 16-bit branch into one of these: `bra` into `jmp` to the absolute target, and `b<cc>`
+// into the opposite condition stepping over that `jmp`. Never selected; made only by
+// relaxation, after layout has measured the displacement.
+let isBranch = 1, isTerminator = 1, isBarrier = 1, isCodeGenOnly = 1 in
+def BRAfar : MxInst<(outs), (ins MxBrTarget32:$dst), "jmp\t$dst", []> {
+  let Inst =
+    (ascend
+      (descend 0b0100, 0b1110, 0b11, MxEncAddrMode_abs<"dst", true>.EA),
+      MxEncAddrMode_abs<"dst", true>.Supplement
+    );
+}
+
+let isBranch = 1, isTerminator = 1, Uses = [CCR], isCodeGenOnly = 1 in
+class MxBccFar<string cc, string inverse>
+    : MxInst<(outs), (ins MxBrTarget32:$dst), "b"#inverse#"\t.+8\n\tjmp\t$dst", []> {
+  // The 8-bit displacement 6 steps over the 6-byte `jmp` (from the branch's PC + 2).
+  let Inst =
+    (ascend
+      (descend 0b0110, !cast<MxEncCondOp>("MxCC"#inverse).Value, 0b00000110),
+      (descend 0b0100, 0b1110, 0b11, MxEncAddrMode_abs<"dst", true>.EA),
+      MxEncAddrMode_abs<"dst", true>.Supplement
+    );
+}
+
+foreach pair = [["cc", "cs"], ["cs", "cc"], ["ls", "hi"], ["hi", "ls"],
+                ["lt", "ge"], ["ge", "lt"], ["eq", "ne"], ["ne", "eq"],
+                ["mi", "pl"], ["pl", "mi"], ["gt", "le"], ["le", "gt"],
+                ["vc", "vs"], ["vs", "vc"]] in
+  def B#pair[0]#"far" : MxBccFar<pair[0], pair[1]>;
+
 /// -------------------------------------------------
 ///  F  E  D  C  B  A  9  8 | 7  6  5  4  3  2  1  0
 /// -------------------------------------------------
