   }
 }
 
-static unsigned getRelaxedOpcode(unsigned Opcode) {
+static unsigned getRelaxedOpcode(unsigned Opcode, bool Allows32BitBranch) {
   // NOTE there will be some relaxations for PCD and ARD mem for x20
-  return getRelaxedOpcodeBranch(Opcode);
+  return getRelaxedOpcodeBranch(Opcode, !Allows32BitBranch);
 }
 
 bool M68kAsmBackend::mayNeedRelaxation(unsigned Opcode, ArrayRef<MCOperand>,
                                        const MCSubtargetInfo &STI) const {
   // Branches can always be relaxed in either mode.
-  return getRelaxedOpcode(Opcode) != Opcode;
+  return getRelaxedOpcode(Opcode, Allows32BitBranch) != Opcode;
 
   // NOTE will change for x20 mem
 }
@@ -198,7 +199,9 @@ bool M68kAsmBackend::fixupNeedsRelaxationAdvanced(const MCFragment &,
     return true;
   int64_t Value = static_cast<int64_t>(UnsignedValue);
 
-  if (!isInt<32>(Value) || (!Allows32BitBranch && !isInt<16>(Value)))
+  // Past 16 bits a 32-bit displacement takes it, or without one (the 68000 and
+  // 68010) a far branch, whose `jmp` takes an absolute address.
+  if (!isInt<32>(Value))
     llvm_unreachable("Cannot relax the instruction, value does not fit");
 
   // Relax if the value is too big for a (signed) i8
@@ -224,7 +227,7 @@ bool M68kAsmBackend::fixupNeedsRelaxationAdvanced(const MCFragment &,
 // we can relax?
 void M68kAsmBackend::relaxInstruction(MCInst &Inst,
                                       const MCSubtargetInfo &STI) const {
-  unsigned RelaxedOp = getRelaxedOpcode(Inst.getOpcode());
+  unsigned RelaxedOp = getRelaxedOpcode(Inst.getOpcode(), Allows32BitBranch);
   assert(RelaxedOp != Inst.getOpcode());
   Inst.setOpcode(RelaxedOp);
 }
diff --git a/llvm/test/MC/M68k/Relaxations/branch-far.s b/llvm/test/MC/M68k/Relaxations/branch-far.s
new file mode 100644
index 000000000..078ee1772
--- /dev/null
+++ b/llvm/test/MC/M68k/Relaxations/branch-far.s
@@ -0,0 +1,47 @@
+; RUN: llvm-mc -triple=m68k --mcpu=M68000 -motorola-integers -filetype=obj < %s \
+; RUN:     | llvm-objdump -dr - | FileCheck %s
+; RUN: llvm-mc -triple=m68k --mcpu=M68010 -motorola-integers -filetype=obj < %s \
+; RUN:     | llvm-objdump -dr - | FileCheck %s
+
+; Without a 32-bit displacement (the 68000 and 68010), a branch past 16 bits
+; becomes a `jmp` to the absolute address (4e f9 + R_68K_32), and a conditional
+; one takes the opposite condition over that `jmp` (displacement 6).
+
+; CHECK-LABEL: <TIGHT>:
+TIGHT:
+	; CHECK: bra  $7ffe
+	bra	.LBB0_2
+	.space 0x7ffc  ; a displacement of 0x7ffe from the branch's PC + 2
+.LBB0_2:
+	rts
+
+; CHECK-LABEL: <FAR_BRA>:
+FAR_BRA:
+	; CHECK:      4e f9 <unknown>
+	; CHECK-NEXT: 00 00 <unknown>
+	; CHECK-NEXT: R_68K_32 .text+0x10008
+	bra	.LBB1_2
+	.space 0x8000
+.LBB1_2:
+	rts
+
+; CHECK-LABEL: <FAR_BEQ>:
+FAR_BEQ:
+	; CHECK:      66 06 bne $6
+	; CHECK-NEXT: 4e f9 <unknown>
+	; CHECK-NEXT: 00 00 <unknown>
+	; CHECK-NEXT: R_68K_32 .text+0x18012
+	beq	.LBB2_2
+	.space 0x8000
+.LBB2_2:
+	rts
+
+; CHECK-LABEL: <FAR_BACK>:
+FAR_BACK:
+	; CHECK:      64 06 bcc $6
+	; CHECK-NEXT: 4e f9 <unknown>
+	; CHECK-NEXT: 00 00 <unknown>
+	; CHECK-NEXT: R_68K_32 .text+0x18012
+	.space 0x8000
+	bcs	.LBB2_2
+	rts
