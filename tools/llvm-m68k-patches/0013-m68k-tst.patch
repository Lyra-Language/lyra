diff --git a/llvm/lib/Target/M68k/M68kInstrArithmetic.td b/llvm/lib/Target/M68k/M68kInstrArithmetic.td
index 1a29c91..ee5c4a5 100644
--- a/llvm/lib/Target/M68k/M68kInstrArithmetic.td
+++ b/llvm/lib/Target/M68k/M68kInstrArithmetic.td
@@ -519,6 +519,49 @@ defm CMP8d  : MMxCmp_RM<MxType8d>;
 defm CMP16d : MMxCmp_RM<MxType16d>;
 defm CMP32d : MMxCmp_RM<MxType32d>;
 
+//===----------------------------------------------------------------------===//
+// TST: a compare with zero, the flags as CMPI #0 sets them (N and Z from the value, V and
+// C cleared) — four cycles on a register where CMPI's are eight, two bytes where it is
+// four. Selected for (CMP 0, x): a data register, (An), (d16,An) or (d8,An,Xn) — never
+// PC-relative, which is the 68020's (and a global is reached through an address register).
+//===----------------------------------------------------------------------===//
+
+/// ------------+------------+------+---------+---------
+///  F  E  D  C | B  A  9  8 | 7  6 | 5  4  3 | 2  1  0
+/// ------------+------------+------+---------+---------
+///  0  1  0  0 | 1  0  1  0 | SIZE |  MODE   |   REG
+/// ------------+------------+------+---------+---------
+let Defs = [CCR] in {
+class MxTst_R<MxType TYPE>
+    : MxInst<(outs), (ins TYPE.ROp:$reg), "tst."#TYPE.Prefix#"\t$reg",
+             [(set CCR, (MxCmp (TYPE.VT 0), TYPE.VT:$reg))]> {
+  let Inst = (descend 0b01001010, !cast<MxEncSize>("MxEncSize"#TYPE.Size).Value,
+                      /*MODE*/0b000, /*REGISTER*/(operand "$reg", 3));
+}
+
+let mayLoad = 1 in {
+class MxTst_M<MxType TYPE, MxOperand MEMOpd, ComplexPattern MEMPat,
+              MxEncMemOp MEM_ENC>
+    : MxInst<(outs), (ins MEMOpd:$mem), "tst."#TYPE.Prefix#"\t$mem",
+             [(set CCR, (MxCmp (TYPE.VT 0), (load MEMPat:$mem)))]> {
+  let Inst = (ascend
+    (descend 0b01001010, !cast<MxEncSize>("MxEncSize"#TYPE.Size).Value, MEM_ENC.EA),
+    MEM_ENC.Supplement);
+}
+
+} // mayLoad
+} // Defs = [CCR]
+
+let AddedComplexity = 10 in
+foreach S = [8, 16, 32] in {
+  defvar TYPE = !cast<MxType>("MxType"#S#"d");
+  defvar MEM = !cast<MxType>("MxType"#S);
+  def TST#S#d : MxTst_R<TYPE>;
+  def TST#S#p : MxTst_M<TYPE, MEM.POp, MEM.PPat, MxEncAddrMode_p<"mem">>;
+  def TST#S#j : MxTst_M<TYPE, MEM.JOp, MEM.JPat, MxEncAddrMode_j<"mem">>;
+  def TST#S#f : MxTst_M<TYPE, MEM.FOp, MEM.FPat, MxEncAddrMode_f<"mem">>;
+}
+
 // cmp #imm, mem
 defm CMP8  : MMxCmp_MI<MxType8d>;
 defm CMP16 : MMxCmp_MI<MxType16d>;
diff --git a/llvm/test/MC/M68k/Arith/Classes/MxTst.s b/llvm/test/MC/M68k/Arith/Classes/MxTst.s
