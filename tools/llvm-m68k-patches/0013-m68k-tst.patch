+; RUN: llvm-mc -triple=m68k -show-encoding %s | FileCheck %s
+
+; TST: 0100 1010 SIZE EA.
+; CHECK:      tst.b  %d0
+; CHECK-SAME: encoding: [0x4a,0x00]
+tst.b	%d0
+; CHECK:      tst.w  %d3
+; CHECK-SAME: encoding: [0x4a,0x43]
+tst.w	%d3
+; CHECK:      tst.l  %d7
+; CHECK-SAME: encoding: [0x4a,0x87]
+tst.l	%d7
+; CHECK:      tst.b  (4,%a0)
+; CHECK-SAME: encoding: [0x4a,0x28,0x00,0x04]
+tst.b	(4,%a0)
+; CHECK:      tst.l  (%a1)
+; CHECK-SAME: encoding: [0x4a,0x91]
+tst.l	(%a1)
+; CHECK:      tst.w  (2,%a0,%d1)
+; CHECK-SAME: encoding: [0x4a,0x70,0x18,0x02]
+tst.w	(2,%a0,%d1)
