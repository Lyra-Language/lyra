index 000000000..2eaf47cd0
--- /dev/null
+++ b/llvm/test/CodeGen/M68k/Data/store-zero-volatile.ll
@@ -0,0 +1,118 @@
+; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py
+; RUN: llc < %s -mtriple=m68k-linux -mcpu=M68000 -verify-machineinstrs | FileCheck %s --check-prefix=M68000
+; RUN: llc < %s -mtriple=m68k-linux -mcpu=M68010 -verify-machineinstrs | FileCheck %s --check-prefix=M68010
+
+; On the M68000, CLR reads its destination before writing it. A volatile store
+; of zero must not read the location (a memory-mapped device register can
+; change state when read), so there it is a MOVE of zero; a plain store, or any
+; store on the M68010 and later, is still CLR.
+
+@port = external global i16
+
+define void @volatile_zero_i8(ptr %p) {
+; M68000-LABEL: volatile_zero_i8:
+; M68000:         .cfi_startproc
+; M68000-NEXT:  ; %bb.0:
+; M68000-NEXT:    move.l (4,%sp), %a0
+; M68000-NEXT:    move.b #0, (%a0)
+; M68000-NEXT:    rts
+;
+; M68010-LABEL: volatile_zero_i8:
+; M68010:         .cfi_startproc
+; M68010-NEXT:  ; %bb.0:
+; M68010-NEXT:    move.l (4,%sp), %a0
+; M68010-NEXT:    clr.b (%a0)
+; M68010-NEXT:    rts
+  store volatile i8 0, ptr %p
+  ret void
+}
+
+define void @volatile_zero_i16(ptr %p) {
+; M68000-LABEL: volatile_zero_i16:
+; M68000:         .cfi_startproc
+; M68000-NEXT:  ; %bb.0:
+; M68000-NEXT:    move.l (4,%sp), %a0
+; M68000-NEXT:    move.w #0, (%a0)
+; M68000-NEXT:    rts
+;
+; M68010-LABEL: volatile_zero_i16:
+; M68010:         .cfi_startproc
+; M68010-NEXT:  ; %bb.0:
+; M68010-NEXT:    move.l (4,%sp), %a0
+; M68010-NEXT:    clr.w (%a0)
+; M68010-NEXT:    rts
+  store volatile i16 0, ptr %p
+  ret void
+}
+
+define void @volatile_zero_i32(ptr %p) {
+; M68000-LABEL: volatile_zero_i32:
+; M68000:         .cfi_startproc
+; M68000-NEXT:  ; %bb.0:
+; M68000-NEXT:    move.l (4,%sp), %a0
+; M68000-NEXT:    move.l #0, (%a0)
+; M68000-NEXT:    rts
+;
+; M68010-LABEL: volatile_zero_i32:
+; M68010:         .cfi_startproc
+; M68010-NEXT:  ; %bb.0:
+; M68010-NEXT:    move.l (4,%sp), %a0
+; M68010-NEXT:    clr.l (%a0)
+; M68010-NEXT:    rts
+  store volatile i32 0, ptr %p
+  ret void
+}
+
+define void @volatile_zero_global() {
+; M68000-LABEL: volatile_zero_global:
+; M68000:         .cfi_startproc
+; M68000-NEXT:  ; %bb.0:
+; M68000-NEXT:    lea (port,%pc), %a0
+; M68000-NEXT:    move.w #0, (%a0)
+; M68000-NEXT:    rts
+;
+; M68010-LABEL: volatile_zero_global:
+; M68010:         .cfi_startproc
+; M68010-NEXT:  ; %bb.0:
+; M68010-NEXT:    lea (port,%pc), %a0
+; M68010-NEXT:    clr.w (%a0)
+; M68010-NEXT:    rts
+  store volatile i16 0, ptr @port
+  ret void
+}
+
+define void @plain_zero_i16(ptr %p) {
+; M68000-LABEL: plain_zero_i16:
+; M68000:         .cfi_startproc
+; M68000-NEXT:  ; %bb.0:
+; M68000-NEXT:    move.l (4,%sp), %a0
+; M68000-NEXT:    clr.w (%a0)
+; M68000-NEXT:    rts
+;
+; M68010-LABEL: plain_zero_i16:
+; M68010:         .cfi_startproc
+; M68010-NEXT:  ; %bb.0:
+; M68010-NEXT:    move.l (4,%sp), %a0
+; M68010-NEXT:    clr.w (%a0)
+; M68010-NEXT:    rts
+  store i16 0, ptr %p
+  ret void
+}
+
+define void @plain_zero_global() {
+; M68000-LABEL: plain_zero_global:
+; M68000:         .cfi_startproc
+; M68000-NEXT:  ; %bb.0:
+; M68000-NEXT:    lea (port,%pc), %a0
+; M68000-NEXT:    clr.w (%a0)
+; M68000-NEXT:    rts
+;
+; M68010-LABEL: plain_zero_global:
+; M68010:         .cfi_startproc
+; M68010-NEXT:  ; %bb.0:
+; M68010-NEXT:    lea (port,%pc), %a0
+; M68010-NEXT:    clr.w (%a0)
+; M68010-NEXT:    rts
+  store i16 0, ptr @port
+  ret void
+}
