diff --git a/llvm/lib/Target/M68k/M68kInstrInfo.cpp b/llvm/lib/Target/M68k/M68kInstrInfo.cpp
index 21067cb..e3c98d5 100644
--- a/llvm/lib/Target/M68k/M68kInstrInfo.cpp
+++ b/llvm/lib/Target/M68k/M68kInstrInfo.cpp
@@ -611,13 +611,25 @@ bool M68kInstrInfo::ExpandMOVEM(MachineInstrBuilder &MIB,
   bool Word = Move == M68k::MOV16rp || Move == M68k::MOV16pr;
   const TargetRegisterClass &Moved =
       Word ? M68k::XR16RegClass : M68k::XR32RegClass;
-  if (Move && Moved.contains(Reg) &&
+  // A byte register has a word's slot, as MOVEM has no byte form: its MOVE is a byte
+  // at the word's low byte, one past the slot on the big-endian 68000, so it reads or
+  // writes what a MOVEM.W spill or reload of the same slot does.
+  int MoveOffset = Offset;
+  if (Word && M68k::DR8RegClass.contains(Reg)) {
+    Move = IsRM ? M68k::MOV8dp : M68k::MOV8pd;
+    MoveOffset = Offset + 1;
+  } else if (Move && !Moved.contains(Reg)) {
+    Move = 0;
+  }
+  if (Move &&
       MBB.computeRegisterLiveness(&RI, M68k::CCR, MI, 32) ==
           MachineBasicBlock::LQR_Dead) {
     MachineInstrBuilder Built =
-        IsRM ? BuildMI(MBB, MI, DL, get(Move), Reg).addImm(Offset).addReg(Base)
+        IsRM ? BuildMI(MBB, MI, DL, get(Move), Reg)
+                   .addImm(MoveOffset)
+                   .addReg(Base)
              : BuildMI(MBB, MI, DL, get(Move))
-                   .addImm(Offset)
+                   .addImm(MoveOffset)
                    .addReg(Base)
                    .addReg(Reg, getKillRegState(MIB->getOperand(2).isKill()));
     if (MachineOperand *Flags =
@@ -1054,7 +1066,7 @@ unsigned getLoadStoreRegOpcode(unsigned Reg, const TargetRegisterClass *RC,
     if (M68k::XR16RegClass.hasSubClassEq(RC))
       return load ? M68k::MOVM16mp_P : M68k::MOVM16pm_P;
     if (M68k::DR8RegClass.hasSubClassEq(RC))
-      return load ? M68k::MOVM16mp_P : M68k::MOVM16pm_P;
+      return load ? M68k::MOVM8mp_P : M68k::MOVM8pm_P;
     if (M68k::CCRCRegClass.hasSubClassEq(RC))
       return load ? M68k::MOVM16mp_P : M68k::MOVM16pm_P;
     llvm_unreachable("Unknown 2-byte regclass");
