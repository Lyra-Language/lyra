diff --git a/llvm/lib/Target/M68k/M68kISelLowering.cpp b/llvm/lib/Target/M68k/M68kISelLowering.cpp
index c65e7e6..d0294bb 100644
--- a/llvm/lib/Target/M68k/M68kISelLowering.cpp
+++ b/llvm/lib/Target/M68k/M68kISelLowering.cpp
@@ -3744,6 +3744,27 @@ static SDValue combineADDX(SDNode *N, SelectionDAG &DAG,
   return SDValue();
 }
 
+// A compare of a loaded value the compare alone reads, seen through what the legalizer
+// says of its bits (a boolean's load is `AssertZext` of an i8 one): the compare's memory
+// form, `cmpi.b #1, (8,%a0)`, matches only the load itself. Through a register it took a
+// MOVE and a register more.
+static SDValue combineM68kCmp(SDNode *N, SelectionDAG &DAG) {
+  SDValue Ops[2] = {N->getOperand(0), N->getOperand(1)};
+  bool Changed = false;
+  for (SDValue &Op : Ops) {
+    if ((Op.getOpcode() == ISD::AssertZext ||
+         Op.getOpcode() == ISD::AssertSext) &&
+        Op.hasOneUse() && isa<LoadSDNode>(Op.getOperand(0)) &&
+        Op.getOperand(0).hasOneUse()) {
+      Op = Op.getOperand(0);
+      Changed = true;
+    }
+  }
+  if (!Changed)
+    return SDValue();
+  return DAG.getNode(M68kISD::CMP, SDLoc(N), N->getVTList(), Ops);
+}
+
 SDValue M68kTargetLowering::PerformDAGCombine(SDNode *N,
                                               DAGCombinerInfo &DCI) const {
   SelectionDAG &DAG = DCI.DAG;
@@ -3756,6 +3777,8 @@ SDValue M68kTargetLowering::PerformDAGCombine(SDNode *N,
     return combineM68kSetCC(N, DAG, Subtarget);
   case M68kISD::BRCOND:
     return combineM68kBrCond(N, DAG, Subtarget);
+  case M68kISD::CMP:
+    return combineM68kCmp(N, DAG);
   }
 
   return SDValue();
diff --git a/llvm/lib/Target/M68k/M68kInstrInfo.cpp b/llvm/lib/Target/M68k/M68kInstrInfo.cpp
index e61fc74..b1b47a4 100644
--- a/llvm/lib/Target/M68k/M68kInstrInfo.cpp
+++ b/llvm/lib/Target/M68k/M68kInstrInfo.cpp
@@ -684,17 +684,54 @@ bool M68kInstrInfo::ExpandMOVEM(MachineInstrBuilder &MIB,
   } else if (Move && !Moved.contains(Reg)) {
     Move = 0;
   }
-  if (Move &&
-      MBB.computeRegisterLiveness(&RI, M68k::CCR, MI, 32) ==
-          MachineBasicBlock::LQR_Dead) {
+  // Where CCR is live, the MOVE may still go ahead of what set the flags — a reload the
+  // allocator put between a compare and its branch, the commonest — when the setter does
+  // not read them and nothing from it to here touches the register or the base, or memory
+  // the slot may be (a load beside a reload is fine).
+  MachineBasicBlock::iterator At = MI;
+  bool KeepKill = true;
+  if (Move && MBB.computeRegisterLiveness(&RI, M68k::CCR, MI, 32) !=
+                  MachineBasicBlock::LQR_Dead) {
+    At = MBB.end();
+    if (MachineBasicBlock::iterator(MI) != MBB.begin()) {
+      MachineBasicBlock::iterator Setter =
+          std::prev(MachineBasicBlock::iterator(MI));
+      while (true) {
+        if (!Setter->isDebugInstr()) {
+          bool Touches =
+              Setter->modifiesRegister(Reg, &RI) ||
+              Setter->modifiesRegister(Base, &RI) || Setter->isCall() ||
+              Setter->hasUnmodeledSideEffects() ||
+              (IsRM && Setter->readsRegister(Reg, &RI)) ||
+              ((Setter->mayStore() || (!IsRM && Setter->mayLoad())) &&
+               Setter->mayAlias(static_cast<AAResults *>(nullptr), *MI,
+                                /*UseTBAA=*/false));
+          if (Touches)
+            break;
+          if (!IsRM && Setter->readsRegister(Reg, &RI))
+            KeepKill = false;
+          if (Setter->modifiesRegister(M68k::CCR, &RI)) {
+            if (!Setter->readsRegister(M68k::CCR, &RI))
+              At = Setter;
+            break;
+          }
+        }
+        if (Setter == MBB.begin())
+          break;
+        --Setter;
+      }
+    }
+  }
+  if (Move && At != MBB.end()) {
     MachineInstrBuilder Built =
-        IsRM ? BuildMI(MBB, MI, DL, get(Move), Reg)
+        IsRM ? BuildMI(MBB, At, DL, get(Move), Reg)
                    .addImm(MoveOffset)
                    .addReg(Base)
-             : BuildMI(MBB, MI, DL, get(Move))
+             : BuildMI(MBB, At, DL, get(Move))
                    .addImm(MoveOffset)
                    .addReg(Base)
-                   .addReg(Reg, getKillRegState(MIB->getOperand(2).isKill()));
+                   .addReg(Reg, getKillRegState(KeepKill &&
+                                                MIB->getOperand(2).isKill()));
     if (MachineOperand *Flags =
             Built->findRegisterDefOperand(M68k::CCR, /*TRI=*/nullptr))
       Flags->setIsDead();
diff --git a/llvm/test/CodeGen/M68k/Control/compare-a-loaded-boolean.ll b/llvm/test/CodeGen/M68k/Control/compare-a-loaded-boolean.ll
new file mode 100644
index 0000000..a2a7041
--- /dev/null
+++ b/llvm/test/CodeGen/M68k/Control/compare-a-loaded-boolean.ll
@@ -0,0 +1,31 @@
+; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py
+; RUN: llc < %s -mtriple=m68k-linux -mcpu=M68000 -verify-machineinstrs | FileCheck %s
+
+; A boolean loaded only to branch on is compared where it is, `cmpi.b #1, (8,%a0)`: the
+; legalizer's AssertZext over the load no longer keeps it out of the compare's memory form.
+
+declare void @f()
+
+define void @branch_on_a_loaded_boolean(ptr %p) {
+; CHECK-LABEL: branch_on_a_loaded_boolean:
+; CHECK:         .cfi_startproc
+; CHECK-NEXT:  ; %bb.0:
+; CHECK-NEXT:    subq.l #4, %sp
+; CHECK-NEXT:    .cfi_def_cfa_offset -8
+; CHECK-NEXT:    move.l (8,%sp), %a0
+; CHECK-NEXT:    cmpi.b #1, (8,%a0)
+; CHECK-NEXT:    bne .LBB0_2
+; CHECK-NEXT:  ; %bb.1: ; %yes
+; CHECK-NEXT:    jsr f
+; CHECK-NEXT:  .LBB0_2: ; %no
+; CHECK-NEXT:    addq.l #4, %sp
+; CHECK-NEXT:    rts
+  %a = getelementptr i8, ptr %p, i32 8
+  %b = load i1, ptr %a
+  br i1 %b, label %yes, label %no
+yes:
+  call void @f()
+  ret void
+no:
+  ret void
+}
diff --git a/llvm/test/CodeGen/M68k/spill-ahead-of-flags.mir b/llvm/test/CodeGen/M68k/spill-ahead-of-flags.mir
new file mode 100644
index 0000000..95b62ba
--- /dev/null
+++ b/llvm/test/CodeGen/M68k/spill-ahead-of-flags.mir
@@ -0,0 +1,92 @@
+# RUN: llc %s -mtriple=m68k -mcpu=M68000 -run-pass=m68k-expand-pseudo -o - | FileCheck %s
+
+# A spill or reload of one register is a MOVE where the flags are dead, a MOVEM (which
+# leaves them alone) where they are live — or a MOVE still, put ahead of what set them,
+# where nothing from the setter to the spill touches its register, its base or memory its
+# slot may be, and the setter does not read the flags.
+
+--- |
+  define void @reload_before_its_compare(ptr %p) { ret void }
+  define void @reload_read_by_its_compare(ptr %p) { ret void }
+  define void @spill_past_a_load(ptr %p) { ret void }
+  define void @setter_reads_the_flags(ptr %p) { ret void }
+...
+---
+# The compare reads another register: the reload goes ahead of it, a MOVE.
+# CHECK-LABEL: name: reload_before_its_compare
+# CHECK:       $d2 = MOV32rp 4, $sp
+# CHECK-NEXT:  CMP8di 1, $bd0
+# CHECK-NEXT:  Bne8
+name: reload_before_its_compare
+tracksRegLiveness: true
+stack:
+  - { id: 0, type: spill-slot, offset: 0, size: 4, alignment: 4 }
+body: |
+  bb.0:
+    liveins: $bd0
+    CMP8di 1, $bd0, implicit-def $ccr
+    $d2 = MOVM32mp_P 4, $sp :: (load (s32) from %stack.0)
+    Bne8 %bb.1, implicit $ccr
+  bb.1:
+    liveins: $d2
+    RTS implicit $d2
+...
+---
+# The compare reads the register reloaded: it stays a MOVEM where it was.
+# CHECK-LABEL: name: reload_read_by_its_compare
+# CHECK:       CMP8di 1, $bd2
+# CHECK-NEXT:  MOVM32mp
+# CHECK-NEXT:  Bne8
+name: reload_read_by_its_compare
+tracksRegLiveness: true
+stack:
+  - { id: 0, type: spill-slot, offset: 0, size: 4, alignment: 4 }
+body: |
+  bb.0:
+    liveins: $d2
+    CMP8di 1, $bd2, implicit-def $ccr
+    $d2 = MOVM32mp_P 4, $sp :: (load (s32) from %stack.0)
+    Bne8 %bb.1, implicit $ccr
+  bb.1:
+    liveins: $d2
+    RTS implicit $d2
+...
+---
+# A spill past a compare that loads, not from its slot: ahead of it, a MOVE.
+# CHECK-LABEL: name: spill_past_a_load
+# CHECK:       MOV32pr 4, $sp, killed $d2
+# CHECK-NEXT:  CMP8pi 1, 0, $a0
+# CHECK-NEXT:  Bne8
+name: spill_past_a_load
+tracksRegLiveness: true
+stack:
+  - { id: 0, type: spill-slot, offset: 0, size: 4, alignment: 4 }
+body: |
+  bb.0:
+    liveins: $a0, $d2
+    CMP8pi 1, 0, $a0, implicit-def $ccr :: (load (s8) from %ir.p)
+    MOVM32pm_P 4, $sp, killed $d2 :: (store (s32) into %stack.0)
+    Bne8 %bb.1, implicit $ccr
+  bb.1:
+    RTS
+...
+---
+# The setter reads the flags (ADDX, X): the spill stays a MOVEM after it.
+# CHECK-LABEL: name: setter_reads_the_flags
+# CHECK:       ADDX32dd
+# CHECK-NEXT:  MOVM32pm
+# CHECK-NEXT:  Bne8
+name: setter_reads_the_flags
+tracksRegLiveness: true
+stack:
+  - { id: 0, type: spill-slot, offset: 0, size: 4, alignment: 4 }
+body: |
+  bb.0:
+    liveins: $d0, $d1, $d2, $ccr
+    $d0 = ADDX32dd $d0, $d1, implicit-def $ccr, implicit $ccr
+    MOVM32pm_P 4, $sp, killed $d2 :: (store (s32) into %stack.0)
+    Bne8 %bb.1, implicit $ccr
+  bb.1:
+    liveins: $d0
+    RTS implicit $d0
+...
