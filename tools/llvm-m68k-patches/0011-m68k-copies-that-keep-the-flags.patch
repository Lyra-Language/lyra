diff --git a/llvm/lib/Target/M68k/M68kInstrData.td b/llvm/lib/Target/M68k/M68kInstrData.td
index 3a81eb4..30808f2 100644
--- a/llvm/lib/Target/M68k/M68kInstrData.td
+++ b/llvm/lib/Target/M68k/M68kInstrData.td
@@ -137,6 +137,29 @@ def MOV # TYPE.Size # dd # TYPE.Postfix
                 MxMoveEncoding<!cast<MxMoveSize>("MxMoveSize"#TYPE.Size),
                                MxMoveDstOpEnc_d, MxMoveSrcOpEnc_d>>;
 
+// Copies that leave the flags alone, for copyPhysReg while CCR is live (a copy PHI
+// elimination left between a compare and its branch), in place of saving CCR around a
+// MOVE: MOVEA into an address register sets no flags, and EXG of two data registers
+// sets none — the second register's value given up, so only where it dies.
+def MOVA32ar : MxInst<(outs MxOp32AddrMode_a.Op:$dst), (ins MxOp32AddrMode_r.Op:$src),
+                      "movea.l\t$src, $dst", []> {
+  let Inst = MxMoveEncoding<MxMoveSize32, MxMoveDstOpEnc_a, MxMoveSrcOpEnc_r>.Value;
+  // MOV32ar's encoding: that one decodes and assembles it.
+  let isCodeGenOnly = 1;
+}
+
+/// ------------+---------+---+---------------+---------
+///  F  E  D  C | B  A  9 | 8 | 7  6  5  4  3 | 2  1  0
+/// ------------+---------+---+---------------+---------
+///  1  1  0  0 |   RX    | 1 |  0  1  0  0  0 |   RY
+/// ------------+---------+---+---------------+---------
+let Constraints = "$dx = $x, $dy = $y" in
+def EXG32dd : MxInst<(outs MxType32d.ROp:$dx, MxType32d.ROp:$dy),
+                     (ins MxType32d.ROp:$x, MxType32d.ROp:$y),
+                     "exg\t$x, $y", []> {
+  let Inst = (descend 0b1100, (operand "$x", 3), 0b1, 0b01000, (operand "$y", 3));
+}
+
 // M <- R
 let mayStore = 1 in {
 class MxMove_MR<MxType TYPE, MxOpBundle DST, string SRC_REG, MxMoveEncoding ENC,
diff --git a/llvm/lib/Target/M68k/M68kInstrInfo.cpp b/llvm/lib/Target/M68k/M68kInstrInfo.cpp
index 79792ce..fe78024 100644
--- a/llvm/lib/Target/M68k/M68kInstrInfo.cpp
+++ b/llvm/lib/Target/M68k/M68kInstrInfo.cpp
@@ -908,6 +908,39 @@ void M68kInstrInfo::copyPhysReg(MachineBasicBlock &MBB,
     return;
   }
 
+  // CCR is live: first the copies that leave it alone, for which saving it (MOVE
+  // from SR, the copy, MOVE to CCR: 18 cycles more on a 68000) is wasted. A long into
+  // an address register is MOVEA, which sets no flags.
+  if (Opc == M68k::MOV32rr && M68k::AR32RegClass.contains(DstReg)) {
+    BuildMI(MBB, MI, DL, get(M68k::MOVA32ar), DstReg)
+        .addReg(SrcReg, getKillRegState(KillSrc));
+    return;
+  }
+  // A data register's value whose register dies here: EXG, which sets none either,
+  // giving the dying register the destination's old value. Whole registers: a word or
+  // byte register's other bits hold nothing then.
+  auto WholeData = [&](Register Reg) -> Register {
+    if (M68k::DR32RegClass.contains(Reg))
+      return Reg;
+    if (M68k::DR16RegClass.contains(Reg))
+      return RI.getMatchingSuperReg(Reg, M68k::MxSubRegIndex16Lo,
+                                    &M68k::DR32RegClass);
+    if (M68k::DR8RegClass.contains(Reg))
+      return RI.getMatchingSuperReg(Reg, M68k::MxSubRegIndex8Lo,
+                                    &M68k::DR32RegClass);
+    return Register();
+  };
+  Register Into = WholeData(DstReg), From = WholeData(SrcReg);
+  if (KillSrc && Into && From && Into != From &&
+      (Opc == M68k::MOV32rr || Opc == M68k::MOV16rr || Opc == M68k::MOV8dd)) {
+    BuildMI(MBB, MI, DL, get(M68k::EXG32dd))
+        .addReg(Into, RegState::Define)
+        .addReg(From, RegState::Define | RegState::Dead)
+        .addReg(Into, RegState::Undef)
+        .addReg(From, RegState::Kill);
+    return;
+  }
+
   // CCR is live, so we must restore it after the copy. Prepare push/pop ops.
   // 68000 must use MOVE from SR, 68010+ must use MOVE from CCR. In either
   // case, upon moving back, MOVE to CCR will mask out the upper byte anyway.
diff --git a/llvm/test/MC/M68k/Data/Classes/MxExg.s b/llvm/test/MC/M68k/Data/Classes/MxExg.s
new file mode 100644
index 0000000..c3787b3
--- /dev/null
+++ b/llvm/test/MC/M68k/Data/Classes/MxExg.s
@@ -0,0 +1,9 @@
+; RUN: llvm-mc -triple=m68k -show-encoding %s | FileCheck %s
+
+; EXG of two data registers: 1100 RX 1 01000 RY.
+; CHECK:      exg  %d0, %d1
+; CHECK-SAME: encoding: [0xc1,0x41]
+exg	%d0, %d1
+; CHECK:      exg  %d7, %d2
+; CHECK-SAME: encoding: [0xcf,0x42]
+exg	%d7, %d2
