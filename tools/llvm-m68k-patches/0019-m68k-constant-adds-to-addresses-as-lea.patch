diff --git a/llvm/test/CodeGen/M68k/Data/address-adds.ll b/llvm/test/CodeGen/M68k/Data/address-adds.ll
new file mode 100644
index 0000000..0dd4731
--- /dev/null
+++ b/llvm/test/CodeGen/M68k/Data/address-adds.ll
@@ -0,0 +1,60 @@
+; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
+; RUN: llc < %s -mtriple=m68k-linux -mcpu=M68000 -verify-machineinstrs | FileCheck %s
+
+; A pointer in an address register stepped by a constant is LEA, not a round trip
+; through a data register.
+
+; Stepped past a struct each pass, and kept in its address register.
+%rec = type { i16, i16, i16 }
+define void @mark_all(ptr %a, i32 %n) {
+; CHECK-LABEL: mark_all:
+; CHECK:         .cfi_startproc
+; CHECK-NEXT:  ; %bb.0: ; %entry
+; CHECK-NEXT:    move.l (8,%sp), %d0
+; CHECK-NEXT:    tst.l %d0
+; CHECK-NEXT:    beq .LBB0_3
+; CHECK-NEXT:  ; %bb.1: ; %loop.preheader
+; CHECK-NEXT:    move.l (4,%sp), %d1
+; CHECK-NEXT:    addq.l #2, %d1
+; CHECK-NEXT:    move.l %d1, %a0
+; CHECK-NEXT:  .LBB0_2: ; %loop
+; CHECK-NEXT:    ; =>This Inner Loop Header: Depth=1
+; CHECK-NEXT:    move.w #1, (%a0)
+; CHECK-NEXT:    lea (6,%a0), %a0
+; CHECK-NEXT:    subq.l #1, %d0
+; CHECK-NEXT:    bne .LBB0_2
+; CHECK-NEXT:  .LBB0_3: ; %done
+; CHECK-NEXT:    rts
+entry:
+  %z = icmp eq i32 %n, 0
+  br i1 %z, label %done, label %loop
+loop:
+  %i = phi i32 [0, %entry], [%i.next, %loop]
+  %p = getelementptr %rec, ptr %a, i32 %i, i32 1
+  store i16 1, ptr %p, align 2
+  %i.next = add nuw nsw i32 %i, 1
+  %c = icmp eq i32 %i.next, %n
+  br i1 %c, label %done, label %loop
+done:
+  ret void
+}
+
+; A pointer stored: the store takes the address register itself.
+define void @store_next(ptr %a, ptr %out) {
+; CHECK-LABEL: store_next:
+; CHECK:         .cfi_startproc
+; CHECK-NEXT:  ; %bb.0:
+; CHECK-NEXT:    move.l (4,%sp), %a0
+; CHECK-NEXT:    move.l (%a0), %a1
+; CHECK-NEXT:    move.w (%a1), (%a0)
+; CHECK-NEXT:    lea (12,%a1), %a0
+; CHECK-NEXT:    move.l (8,%sp), %a1
+; CHECK-NEXT:    move.l %a0, (%a1)
+; CHECK-NEXT:    rts
+  %b = load ptr, ptr %a, align 2
+  %v = load i16, ptr %b, align 2
+  store i16 %v, ptr %a, align 2
+  %n = getelementptr i8, ptr %b, i32 12
+  store ptr %n, ptr %out, align 2
+  ret void
+}
