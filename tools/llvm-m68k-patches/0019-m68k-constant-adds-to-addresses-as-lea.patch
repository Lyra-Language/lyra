diff --git a/llvm/lib/Target/M68k/M68kAddressAdds.cpp b/llvm/lib/Target/M68k/M68kAddressAdds.cpp
new file mode 100644
index 0000000..a6e67e9
--- /dev/null
+++ b/llvm/lib/Target/M68k/M68kAddressAdds.cpp
@@ -0,0 +1,158 @@
+//===-- M68kAddressAdds.cpp - Constant adds to addresses as LEA -----------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+///
+/// \file
+/// An address register plus a constant, made in an address register. The selector
+/// makes every (add x, c) an ADD into a data register, so a pointer living in an
+/// address register — a loop's, stepped past a struct each pass — went out to a data
+/// register, was added to, and came back:
+///
+///   move.l %a0, %d2; addq.l #6, %d2; movea.l %d2, %a0
+///
+/// where `lea (6,%a0), %a0` is one instruction of 8 cycles that touches no flags. Before
+/// register allocation, an ADD or SUB of a 16-bit constant to a copy of an address
+/// register, its flags unread, becomes LEA (d16,An) into a new address register. Where
+/// everything reading the sum takes an address register, that is the sum; otherwise
+/// copies into an address register take it from there, and the rest from a copy.
+///
+//===----------------------------------------------------------------------===//
+
+#include "M68k.h"
+#include "M68kInstrInfo.h"
+#include "M68kSubtarget.h"
+
+#include "llvm/CodeGen/MachineFunctionPass.h"
+#include "llvm/CodeGen/MachineInstrBuilder.h"
+#include "llvm/CodeGen/MachineRegisterInfo.h"
+#include "llvm/Support/MathExtras.h"
+
+using namespace llvm;
+
+#define DEBUG_TYPE "m68k-address-adds"
+#define PASS_NAME "M68k constant adds to addresses as LEA"
+
+namespace {
+
+class M68kAddressAdds : public MachineFunctionPass {
+public:
+  static char ID;
+  M68kAddressAdds() : MachineFunctionPass(ID) {}
+
+  bool runOnMachineFunction(MachineFunction &MF) override;
+
+  void getAnalysisUsage(AnalysisUsage &AU) const override {
+    AU.setPreservesCFG();
+    MachineFunctionPass::getAnalysisUsage(AU);
+  }
+
+  StringRef getPassName() const override { return PASS_NAME; }
+};
+
+char M68kAddressAdds::ID = 0;
+
+} // namespace
+
+INITIALIZE_PASS(M68kAddressAdds, DEBUG_TYPE, PASS_NAME, false, false)
+
+FunctionPass *llvm::createM68kAddressAddsPass() { return new M68kAddressAdds(); }
+
+// Whether each instruction reading \p Reg would take a register of \p RC there.
+static bool everyUseTakes(Register Reg, const TargetRegisterClass *RC,
+                          const MachineRegisterInfo &MRI,
+                          const TargetInstrInfo &TII,
+                          const TargetRegisterInfo &TRI) {
+  for (const MachineOperand &Use : MRI.use_nodbg_operands(Reg)) {
+    const MachineInstr &User = *Use.getParent();
+    if (Use.getSubReg())
+      return false;
+    if (User.isCopy() || User.isPHI()) {
+      Register To = User.getOperand(0).getReg();
+      if (User.getOperand(0).getSubReg() || !To.isVirtual() ||
+          !MRI.getRegClass(To)->hasSubClassEq(RC))
+        return false;
+      continue;
+    }
+    const TargetRegisterClass *Wants =
+        User.getRegClassConstraint(User.getOperandNo(&Use), &TII, &TRI);
+    if (!Wants || !Wants->hasSubClassEq(RC))
+      return false;
+  }
+  return true;
+}
+
+bool M68kAddressAdds::runOnMachineFunction(MachineFunction &MF) {
+  if (skipFunction(MF.getFunction()))
+    return false;
+  MachineRegisterInfo &MRI = MF.getRegInfo();
+  const TargetInstrInfo &TII = *MF.getSubtarget().getInstrInfo();
+  const TargetRegisterInfo &TRI = *MF.getSubtarget().getRegisterInfo();
+  const TargetRegisterClass *AR = &M68k::AR32RegClass;
+  bool Changed = false;
+
+  for (MachineBasicBlock &MBB : MF) {
+    for (MachineInstr &MI : make_early_inc_range(MBB)) {
+      bool Sub = MI.getOpcode() == M68k::SUB32di;
+      if (MI.getOpcode() != M68k::ADD32di && !Sub)
+        continue;
+      const MachineOperand &Imm = MI.getOperand(2);
+      if (!Imm.isImm() || !MI.registerDefIsDead(M68k::CCR, &TRI))
+        continue;
+      int64_t Value = SignExtend64<32>(Imm.getImm());
+      if (Sub)
+        Value = -Value;
+      if (!isInt<16>(Value))
+        continue;
+      Register Dst = MI.getOperand(0).getReg(), Src = MI.getOperand(1).getReg();
+      if (!Dst.isVirtual() || !Src.isVirtual())
+        continue;
+
+      // The added register a copy of an address register's value.
+      MachineInstr *Copy = MRI.getUniqueVRegDef(Src);
+      if (!Copy || !Copy->isCopy() || Copy->getOperand(1).getSubReg())
+        continue;
+      Register From = Copy->getOperand(1).getReg();
+      if (!From.isVirtual() || !AR->hasSubClassEq(MRI.getRegClass(From)))
+        continue;
+
+      Register Sum = MRI.createVirtualRegister(AR);
+      BuildMI(MBB, MI, MI.getDebugLoc(), TII.get(M68k::LEA32p), Sum)
+          .addImm(Value)
+          .addReg(From);
+      MRI.clearKillFlags(From);
+
+      // Where every use takes an address register — a store, a copy, a phi into a
+      // register that may be one — the sum is the LEA's register itself.
+      if (everyUseTakes(Dst, AR, MRI, TII, TRI)) {
+        MRI.replaceRegWith(Dst, Sum);
+        MI.eraseFromParent();
+        if (MRI.use_nodbg_empty(Src))
+          Copy->eraseFromParent();
+        Changed = true;
+        continue;
+      }
+
+      // Otherwise copies into a register that may be an address register read it.
+      for (MachineOperand &Use : make_early_inc_range(MRI.use_operands(Dst))) {
+        MachineInstr &User = *Use.getParent();
+        if (!User.isCopy() || User.getOperand(0).getSubReg())
+          continue;
+        Register To = User.getOperand(0).getReg();
+        if (To.isVirtual() && MRI.getRegClass(To)->hasSubClassEq(AR))
+          Use.setReg(Sum);
+      }
+      if (!MRI.use_nodbg_empty(Dst))
+        BuildMI(MBB, MI, MI.getDebugLoc(), TII.get(TargetOpcode::COPY), Dst)
+            .addReg(Sum);
+      MI.eraseFromParent();
+      if (MRI.use_nodbg_empty(Src))
+        Copy->eraseFromParent();
+      Changed = true;
+    }
+  }
+  return Changed;
+}
