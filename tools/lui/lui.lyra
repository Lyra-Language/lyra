// lui — markup for `bindings.imgui.ui` or `ui`, generated into Lyra.
//
//   build/lui view.lui            # writes view.lyra beside it
//   build/lui --target ui view.lui   # for `ui` where the file does not say
//   build/lui src                 # every .lui file beneath src, each its module
//   build/lui --check view.lui    # exit 1 when view.lyra is not what view.lui makes
//   build/lui --watch view.lui    # again whenever view.lui changes, until stopped
//   build/lui --watch src         # every .lui beneath src, files added later too
//   build/lui --stdin --name view.lui < view.lui   # the module on stdout (lyra-lsp's way)
//   build/lyrac check app.lyra 2>&1 | build/lui map   # errors at the markup's lines
//
// A `.lui` file holds components, each a function returning a `Node<e>`; lyrac checks
// what it generates, so a misspelt event or field is a compile error as it would be in
// Lyra. The format:
//
//   <script>
//     import app.{ State, Event }        // copied to the top of the module as written
//   </script>
//
//   <component name="confirm" props={{ question: string, yes: e, no: e }}>
//     <style>
//       Button { rounding: 6; padding: 14 4 }
//       Button.danger { background: #aa2828 }
//     </style>
//     <Text>{question}</Text>
//     <Row>
//       <Button class="danger" on_click={yes}>Yes</Button>
//       <Button on_click={no}>No</Button>
//     </Row>
//   </component>
//
// - **A capitalized tag is an element** of `bindings.imgui.ui` (`<Button>` is `Button`,
//   its attributes `ButtonAttrs`' fields); its text is its label. **A lowercase tag calls a
//   component of the same file**, attributes matched to its props by name, its children
//   passed as a `children: []Node<e>` prop. `<if test={…}>`, `<else>` and
//   `<for each={x in xs}>` are control flow.
// - **An input's `on_change={Width}`** — a bare name — is written as the typed lambda
//   calling it, `(value: i64) -> Ev => Width(value)`; a lambda written out passes through.
// - **`{…}` is Lyra**, copied through: an attribute (`on_click={yes}`), part of a text or
//   quoted string (`Reset {n} times`; a text of one `{n}` alone is `"${n}"`, a string
//   whatever `n` is), or a child node (`{node}`, or `{...nodes}` for an
//   array).
// - **A component's `<style>` is its scoped sheet**: rules of `Tag`, `.class` or
//   `Tag.class` selectors, with `color`/`background` (`#rgb`, `#rrggbb`, `#rrggbbaa`),
//   `padding` (one or two numbers), `rounding`, `opacity`, `width` (pixels, or `6em`)
//   and `height`. An
//   element's `style="…"` takes the same declarations.
// - `event={Event}` makes a component's events a concrete type; the default is `e`, a
//   type variable, so the component fits any program's tree.
// - **Two targets.** `<script target="ui">` (or `--target ui`) writes for `ui.layout`:
//   `<Row main="between" cross="center">`, `<Column>`, `<Stack>`, `<Expanded flex>`,
//   `<Positioned left top right bottom width height>`, `<Padding all | x y | top …>`,
//   `<Align at="center">`, `<Scroll axis offset>`, `<SizedBox width height>`, `<Text>`,
//   `<Button on_click>`, `<Checkbox checked on_toggle>`, `<Slider value min max step
//   on_change>`, `<Select options selected on_change>` (or `<Option>`s inside), `<TextInput value
//   placeholder readonly on_edit>`, `<Image texture texels width height>`
//   and `<Themed theme sheet>`; any of them takes `class`, `part`, `key`, `label` and `style`.
//   A component is named for its parts' rules and its sheet is a function of the theme
//   (`component_of`). The default target is `bindings.imgui.ui`, as before.
// - **Styling for ui**: a top-level `<style global theme={AppTheme} name="app_sheet">` is a
//   public function of that theme answering the sheet (for `<Themed>`); a `$path` in a sheet
//   reads the theme (`$colors.accent` is `t.colors.accent`); `Comp::part` and
//   `Comp.class::part` rules are checked against the parts the component's markup marks
//   (`part="title"`), or a control's (`Checkbox::box`), as a prop is.
// - **Another file's components**: `<import src="widgets.lui"/>` reads that file's
//   components, checks calls to them, and imports the ones called from its module (its path
//   without `.lui`, or `module="…"`).

import std.collections.{ parse_args }
import std.io.{ read_file, write_file, read_stdin, sleep_ms, read_dir, is_symlink }
import std.path
import ui.color.{ parse_color, color_text }

let main = () -> u8 => {
  let args = parse_args(["--name", "--target"])
  let target = args.value("--target").unwrap_or(IMGUI)
  if target != IMGUI && target != UI {
    println("lui: --target is ${UI} or ${IMGUI}, not ${target}")
    return 2
  }
  // An editor's buffer, not a file: the module on standard output, or `line: what` and 1.
  if args.has("--stdin") {
    let name = args.value("--name").unwrap_or("stdin.lui")
    let source = read_stdin()
    match generate_with(name.base(), source, imported_files(name, source), target) {
      Ok(code) => print(code),
      Err(problem) => {
        println(problem)
        return 1
      },
    }
    return 0
  }
  if args.positional.len() == 1 && args.positional[0] == "map" {
    for line in read_stdin().lines() { println(mapped(line)) }
    return 0
  }
  if args.positional.len() == 0 {
    println("usage: lui [--check | --watch] <file.lui | directory>...  |  lyrac check … 2>&1 | lui map  |  lui --stdin --name <file.lui>")
    return 2
  }
  if args.has("--watch") { return watch(args.positional, target) }
  let check = args.has("--check")
  let paths = lui_files(args.positional)
  if paths.len() == 0 {
    println("lui: no .lui file in ${args.positional.join(", ")}")
    return 1
  }
  var failures = 0
  for path in paths {
    if !run(path, read_file(path), check, target) { failures += 1 }
  }
  u8(failures.min(255))
}

/// `paths` with each directory among them the `.lui` files beneath it, in `read_dir`'s
/// sorted order; any other path as written, for `run` to judge. **A directory is a path
/// `read_dir` can read.** A name beginning with `.` is skipped and a symlinked directory
/// never followed, while walking only — as lyrafmt walks for `.lyra` files: `.git` holds no
/// markup, and a link back up the tree would not end.
let lui_files = (paths: []string) -> []string => {
  var out: []string = []
  for path in paths {
    match read_dir(path) {
      Some(names) => gather(path, names, out),
      None => out.push(path),
    }
  }
  out
}

/// Appends every `.lui` file at or below `dir`, whose entries are `names`, to `out`.
let gather = (dir: string, names: []string, out: mut []string) -> void => {
  for name in names {
    if name.starts_with(".") { continue }
    let entry = "${dir}/${name}"
    match read_dir(entry) {
      Some(below) => if !is_symlink(entry) { gather(entry, below, out) },
      None => if entry.ends_with(".lui") { out.push(entry) },
    }
  }
}

/// `path` (its text `source`, `None` when it could not be read) generated into the module
/// beside it, or with `check`, compared with it; whether all was well, what was not said.
let run = (path: string, source: Maybe<string>, check: bool, target: string) -> bool => {
  if !path.ends_with(".lui") {
    println("lui: ${path} is not a .lui file")
    return false
  }
  let Some(text) = source else {
    println("lui: cannot read ${path}")
    return false
  }
  let out = "${path.slice(0, path.len() - 4)}.lyra"
  match generate_with(path.base(), text, imported_files(path, text), target) {
    Err(problem) => {
      println("${path}:${problem}")
      false
    },
    Ok(code) => {
      if check {
        if read_file(out).unwrap_or("") != code {
          println("lui: ${out} is not what ${path} makes; run lui ${path}")
          return false
        }
      } else if read_file(out).unwrap_or("") != code && !write_file(out, code) {
        println("lui: cannot write ${out}")
        return false
      }
      true
    },
  }
}

/// `paths` generated now and again whenever one's text changes — read a few times a
/// second, as a markup file is small — until the program is stopped. A directory is walked
/// again on every pass ([lui_files]), so a `.lui` file added beneath it is generated as it
/// appears. Each generation is said, and a mistake at its line, as when run once.
let watch = (paths: []string, target: string) -> u8 => {
  // The files met so far, and the text each was last generated from: a NUL no file holds
  // at first, so each is generated on the pass that finds it.
  var known: []string = []
  var seen: []string = []
  println("lui: watching ${paths.join(", ")}; Ctrl-C stops")
  loop {
    for path in lui_files(paths) {
      var k = known.len()
      for i, p in known { if p == path { k = i } }
      if k == known.len() {
        known.push(path)
        seen.push("\u0000")
      }
      let text = read_file(path)
      let now = text.unwrap_or("")
      if now == seen[k] { continue }
      seen[k] = now
      if run(path, text, false, target) { println("lui: ${path} generated") }
    }
    sleep_ms(WATCH_MS)
  }
}

/// How often `--watch` reads its files.
const WATCH_MS: i64 = 250

/// The element modules a file can target: `ui`'s (`ui.layout`) or `bindings.imgui.ui`, the
/// default. A file names its own in a script, `<script target="ui">`; `--target` is the
/// default for one that does not.
const UI = "ui"
const IMGUI = "imgui"

/// The files `<import src="…"/>` names in `source` (the file at `path`), each read beside
/// it: `(src, text)`, the text `None` where it could not be read — `generate_with` says so at
/// the import's line.
let imported_files = (path: string, source: string) -> [](string, Maybe<string>) => {
  let Ok(tops) = parse_file(source.encode_utf8()) else { return [] }
  let dir = match path.parent() {
    Some(d) => d,
    None => "",
  }
  var out: [](string, Maybe<string>) = []
  for t in tops {
    if t.name != "import" { continue }
    let Some(src) = t.text_attr("src") else { continue }
    out.push((src, read_file(if dir.len() > 0 { dir.join(src) } else { src })))
  }
  out
}

// ── Errors, put back at the markup ───────────────────────────────────────────

/// A line of lyrac's output with its place in a module lui generated put back at the
/// markup's line: `src/view.lyra:41:12: error …` is `src/view.lui:17: error …`. A line
/// naming no such place is as it was.
let mapped = (line: string) -> string => {
  let Some(at) = line.index(".lyra:") else { return line }
  let runes = line.to_runes()
  var start = at
  while start > 0 && runes[start - 1] != ' ' && runes[start - 1] != '\t' { start -= 1 }
  let path = line.slice(start, at + 5)
  var k = at + 6
  var row = 0
  while k < runes.len() && runes[k] >= '0' && runes[k] <= '9' {
    row = row * 10 + (i64(runes[k]) - i64('0'))
    k += 1
  }
  if k == at + 6 { return line }
  // The column is the generated module's, so it goes too.
  if k < runes.len() && runes[k] == ':' {
    var c = k + 1
    while c < runes.len() && runes[c] >= '0' && runes[c] <= '9' { c += 1 }
    if c > k + 1 { k = c }
  }
  let Some(code) = read_file(path) else { return line }
  let Some((markup, at_line)) = markup_line(path, code, row) else { return line }
  "${line.slice(0, start)}${markup}:${at_line}${line.slice(k, line.len())}"
}

/// The markup file and line that line `row` of the generated module `code` (at `path`)
/// came from: the nearest marker at or above it. `None` for a module lui did not write,
/// or a line no marker covers (its imports).
let markup_line = pure (path: string, code: string, row: i64) -> Maybe<(string, i64)> => {
  let rows = code.lines()
  if rows.len() == 0 { return None }
  let Some(header) = rows[0].strip_prefix("// Generated by lui from ") else { return None }
  let file = header.split(":")[0]
  let markup = match path.parent() {
    Some(dir) => if dir.len() > 0 { dir.join(file) } else { file },
    None => file,
  }
  var k = (row - 1).min(rows.len() - 1)
  while k > 0 {
    let r = rows[k]
    if let Some(n) = marker_line(
      r,
      "/// From ${file}, line "
    ) { return Some((markup, n)) }
    if let Some(n) = marker_line(r, "// ${file}:") {
      // A marker alone on its line is the next line's: a script's first line.
      let alone = r.trim().starts_with("// ")
      return Some((markup, if alone { n + (row - 1) - (k + 1) } else { n }))
    }
    k -= 1
  }
  None
}

/// The number after `prefix` in `row`, if `row` holds it.
let marker_line = pure (row: string, prefix: string) -> Maybe<i64> => {
  let Some(at) = row.index(prefix) else { return None }
  var n = 0
  var digits = 0
  for c in row.slice(at + prefix.len(), row.len()) {
    if c < '0' || c > '9' { break }
    n = n * 10 + (i64(c) - i64('0'))
    digits += 1
  }
  if digits > 0 { Some(n) } else { None }
}

// ── The file, generated ──────────────────────────────────────────────────────

/// The Lyra module `source` (the file `name`) makes for `bindings.imgui.ui`, or the first
/// thing wrong with it, as `line: what`.
pub let generate = pure (name: string, source: string) -> Result<string, string> =>
  generate_with(name, source, [], IMGUI)

/// The Lyra module `source` (the file `name`) makes, `imports` the text of each file its
/// `<import>`s name, for the `target` element module unless a script names one.
pub let generate_with = pure (
  name: string,
  source: string,
  imports: [](string, Maybe<string>),
  default_target: string
) -> Result<string, string> => {
  let b = source.encode_utf8()
  let tops = parse_file(b)?
  var target = default_target
  for t in tops {
    if t.name != "script" { continue }
    if let Some(named) = t.text_attr("target") {
      if named != UI && named != IMGUI {
        return Err("${t.line}: target is \"${UI}\" or \"${IMGUI}\", not \"${named}\"")
      }
      target = named
    }
  }
  var scripts: []string = []
  var components: []Component = []
  var globals: []Tag = []
  var imported: []Imported = []
  var window = ""
  for t in tops {
    match t.name {
      "script" => scripts.push("// ${name}:${first_line(t)}\n${dedent(t.raw)}"),
      "component" => components.push(read_component(t)?),
      "style" => {
        if target != UI { return Err("${t.line}: a global <style> is the ui target's; name it with <script target=\"ui\">") }
        if !t.attrs.any((a) => a.name == "global") {
          return Err("${t.line}: a <style> at the top of a file is global: <style global theme={AppTheme}>")
        }
        globals.push(t)
      },
      "import" => imported.push(read_import(t, imports)?),
      "window" => {
        if target != UI { return Err("${t.line}: <window> is the ui target's") }
        if window.len() > 0 { return Err("${t.line}: a file has one <window>") }
        window = window_spec(t, name)?
      },
      _ => { return Err("${t.line}: <${t.name}> at the top of a file; only <script>, <import>, <window>, <style global> and <component> go there") },
    }
  }
  var writer = Writer {
    components: components,
    imported: imported,
    used: [],
    file: name,
    target: target
  }
  var bodies: []string = []
  var sheets: []string = []
  for c in components {
    bodies.push(writer.component(name, c)?)
    if c.rules.len() > 0 { sheets.push(writer.sheet(c)?) }
  }
  for g in globals { sheets.push(writer.global_sheet(g)?) }
  if window.len() > 0 {
    writer.use("WindowSpec")
    if window.contains("Size {") { writer.use("Size") }
    writer.ui_uses_in([window])
  }
  var out: []string = ["// Generated by lui from ${name}: edit that file, not this one."]
  out.push(writer.imports())
  for s in scripts { out.push(s) }
  for body in bodies { out.push(body) }
  for s in sheets { out.push(s) }
  if window.len() > 0 { out.push(window) }
  Ok("${out.join("\n\n")}\n")
}

/// A `<window title="Counter" width="520" height="640" min-width="420" min-height="480"
/// max-width max-height resize resize_x resize_y overflow/>` as `window_spec`, a function
/// answering a `ui.app.WindowSpec` — a function, not a constant, so that under `lyrac run
/// --live` an edit reaches the open window (`ui.gpu.open_app` keeps it, `App.window`): its
/// title, the size it opens at (`width` and `height` together), the least and greatest size
/// the user may make it (a side not given is no limit), which ways it resizes —
/// `resize={false}` neither, `resize_x`/`resize_y` one side, overriding `resize` for theirs —
/// and its overflow. What is not given keeps `WindowSpec`'s default.
let window_spec = pure (t: Tag, file: string) -> Result<string, string> => {
  for a in t.attrs {
    if ![
      "title",
      "width",
      "height",
      "min-width",
      "min-height",
      "max-width",
      "max-height",
      "resize",
      "resize_x",
      "resize_y",
      "overflow"
    ].any((n) => n == a.name) {
      return Err("${a.line}: <window> has no attribute ${a.name} (title, width, height, min-width, min-height, max-width, max-height, resize, resize_x, resize_y, overflow)")
    }
  }
  if t.children.len() > 0 && words_of(t.children)
    .trim()
    .len() > 0 { return Err("${t.line}: <window> holds nothing") }
  var fields: []string = []
  if let Some(a) = attr_named(t.attrs, "title") {
    if a.value == Bare { return Err("${a.line}: title of <window> needs a value") }
    fields.push("title: ${attr_lyra(a.value)}")
  }
  // `width` and `height` — the size it opens at — together or not at all: a window has no
  // size of nothing to fall back on for the other.
  let width = number_attr(t, "width")?
  let height = number_attr(t, "height")?
  if (width.len() == 0) != (height.len() == 0) {
    return Err("${t.line}: <window> takes width and height together")
  }
  if width.len() > 0 { fields.push("size: Size { w: ${width}, h: ${height} }") }
  let side = (name: string) -> Result<string, string> => {
    let n = number_attr(t, name)?
    Ok(if n.len() == 0 { "0.0" } else { n })
  }
  let given = (names: []string) -> bool =>
    names.any((n) => attr_named(t.attrs, n).is_some())
  if given(["min-width", "min-height"]) {
    fields.push("min_size: Size { w: ${side("min-width")?}, h: ${side("min-height")?} }")
  }
  if given(["max-width", "max-height"]) {
    fields.push("max_size: Size { w: ${side("max-width")?}, h: ${side("max-height")?} }")
  }
  // `resize`, `resize_x` and `resize_y`: bare or `{condition}`, as `disabled` is; a side's
  // own attribute before `resize`, and resizable when neither is given.
  let flag = (name: string) -> Result<Maybe<string>, string> =>
    match attr_named(t.attrs, name) {
      None => Ok(None),
      Some(a) => match a.value {
        Quoted(_) => Err("${a.line}: ${name} is bare or {condition}, not text: ${name} or ${name}={false}"),
        other => Ok(Some(attr_lyra(other))),
      },
    }
  let both = flag("resize")?
  if let Some(x) = (flag("resize_x")?).or(both) { fields.push("resize_x: ${x}") }
  if let Some(y) = (flag("resize_y")?).or(both) { fields.push("resize_y: ${y}") }
  // `overflow` — what the window does with a page that does not fit it — when given.
  if let Some(word) = t.text_attr("overflow") {
    fields.push("overflow: ${overflow_of(word).map_err((why) => "${t.line}: ${why}")?}")
  }
  let body = if fields.len() == 0 { "WindowSpec {}" } else {
    "WindowSpec {\n  ${fields.join(",\n  ")},\n}"
  }
  Ok("/// From ${file}, line ${t.line}: the window, for `ui.gpu.open_app` — or an `App`'s\n/// `min_size`, `max_size`, `resize_x`, `resize_y` and `window_overflow`.\npub let window_spec = pure () -> WindowSpec => ${body}")
}

/// Another file's components, for this one's to call: the module they are in and their
/// props.
struct Imported {
  module: string,
  components: []Component,
}

/// An `<import src="widgets.lui"/>`: the file's components, read from `files` — the module
/// its `module="…"` names, else its path with `/` for `.` and no `.lui`, so a file beside
/// this one is the module of its name.
let read_import = pure (
  t: Tag,
  files: [](string, Maybe<string>)
) -> Result<Imported, string> => {
  let Some(src) = t.text_attr("src") else { return Err("${t.line}: an <import> needs src=\"file.lui\"") }
  if !src.ends_with(".lui") { return Err("${t.line}: <import> names a .lui file, not ${src}") }
  var text: Maybe<string> = None
  for (path, read) in files {
    if path == src { text = read }
  }
  let Some(source) = text else { return Err("${t.line}: cannot read ${src}") }
  let tops = parse_file(source.encode_utf8()).map_err((what) => "${t.line}: in ${src}: ${what}")?
  var components: []Component = []
  for top in tops {
    if top.name == "component" {
      components.push(read_component(top).map_err((what) => "${t.line}: in ${src}: ${what}")?)
    }
  }
  let module = t.text_attr("module") ?? src.slice(0, src.len() - 4).replace("/", ".")
  Ok(Imported { module: module, components: components })
}

/// A `<component>`: its name, props, event type, sheet and children.
struct Component {
  name: string,
  props: []Prop,
  props_text: string,
  event: string,
  rules: []Rule,
  /// The parts its markup names (`part="title"`), for a `component::part` rule to be checked
  /// against.
  parts: []string,
  /// Its `<style>`'s line, 0 for none.
  style_line: i64,
  children: []Markup,
  line: i64,
}

struct Prop {
  name: string,
  default: string,
}

/// A style rule: a selector, its declarations as written, the markup line it is on, and the
/// `@media` it is inside as Lyra's `[]Media` (`""` for none).
struct Rule {
  selector: string,
  body: string,
  line: i64,
  media: string = "",
}

let read_component = pure (t: Tag) -> Result<Component, string> => {
  let Some(name) = t.text_attr("name") else {
    return Err("${t.line}: a <component> needs a name")
  }
  let props_text = match attr_named(t.attrs, "props") {
    None => "",
    Some(a) => match a.value {
      Braced(code) => object_props(code, a.line)?,
      _ => { return Err("${a.line}: props are an object: props={{ name: Type, other: Type = default }}") },
    },
  }
  // The events' type, Lyra in braces: `event={SettingsEvent}`; none, the variable `e`.
  let event = match attr_named(t.attrs, "event") {
    None => "e",
    Some(a) => match a.value {
      Braced(code) => code,
      _ => { return Err("${a.line}: event is a type in braces: event={SettingsEvent}") },
    },
  }
  var rules: []Rule = []
  var style_line = 0
  var children: []Markup = []
  for child in t.children {
    if let Element(c) = child {
      if c.name == "style" {
        for r in read_style(c.raw, c.line)? { rules.push(r) }
        style_line = c.line
        continue
      }
    }
    children.push(child)
  }
  var parts: []string = []
  parts_in(children, parts)
  Ok(Component {
    name: name,
    props: read_props(props_text),
    props_text: props_text,
    event: event,
    rules: rules,
    parts: parts,
    style_line: style_line,
    children: children,
    line: t.line,
  })
}

/// The part names `children` mark (`part="…"`), at any depth, appended to `out`.
let parts_in = (children: []Markup, out: mut []string) -> void => {
  for child in children {
    if let Element(t) = child {
      if let Some(p) = t.text_attr("part") {
        if !out.any((q) => q == p) { out.push(p) }
      }
      parts_in(t.children, out)
    }
  }
}

/// The generator's state: the file's components and the ones it imports, for calls between
/// them, the names of the target's modules the module uses, for its imports, and the target.
struct Writer {
  components: []Component,
  imported: []Imported = [],
  used: []string,
  /// The imported components called, as `module.name`.
  called: []string = [],
  target: string = IMGUI,
  /// The markup file's name, for the markers `lui map` reads.
  file: string,
  /// The event type of the component being written, for the lambdas `on_change` becomes.
  event: string = "e",
  /// What the ui target's elements are being written as: nodes (`""`), or the data a control
  /// holds — a menu bar's menus (`"menus"`), a menu's entries (`"entries"`), a tab bar's tabs
  /// (`"tabs"`) — so `<for>` and `<if>` work among them as among nodes.
  making: string = "",
}

/// A generated array element and the markup line it came from.
struct Item {
  text: string,
  line: i64,
}

impl Writer {
  let component = (self: mut, file: string, c: Component) -> Result<string, string> => {
    let generic = if is_type_variable(c.event) && !mentions(c.props_text, c.event) {
      "<${c.event}>"
    } else {
      ""
    }
    self.use("Node")
    self.event = c.event
    let items = self.nodes_of(c.children, "    ")?
    let head = "/// From ${file}, line ${c.line}.\npub let ${c.name}${generic} = pure (${c.props_text}) -> Node<${c.event}> =>"
    if self.target == UI {
      // Named for its parts' rules (`confirm::question`); its sheet made from the theme.
      let made = if c.rules.len() > 0 {
        self.use("component_of")
        "component_of(${quote(c.name)}, ${c.name}_sheet, ${self.listed(items, "  ")})"
      } else {
        self.use("component")
        self.use("Sheet")
        "component(${quote(c.name)}, Sheet {}, ${self.listed(items, "  ")})"
      }
      return Ok("${head}\n  ${made}")
    }
    self.use("Component")
    let sheet_name = if c.rules.len() > 0 {
      "${c.name}_sheet"
    } else {
      self.use("Sheet")
      "Sheet {}"
    }
    Ok("${head}\n  Component(${sheet_name}, ${self.listed(items, "  ")})")
  }

  /// A component's `<style>`: for `bindings.imgui.ui` a `Sheet`; for `ui` a function of the
  /// theme it is drawn in, which its `$tokens` read.
  let sheet = (self: mut, c: Component) -> Result<string, string> => {
    if self.target == UI {
      let rules = self.ui_rules(c.rules)?
      return Ok("let ${c.name}_sheet = pure (${theme_param(c.rules)}: Theme) -> Sheet => Sheet { // ${self.file}:${c.style_line}\n  rules: ${self.listed(rules, "  ")},\n}")
    }
    self.use("Sheet")
    self.use("StyleRule")
    self.use("Style")
    var rules: []string = []
    for r in c.rules {
      if r.media.len() > 0 { return Err("${r.line}: @media is the ui target's") }
      let fields = declarations(r.body, r.line)?
      self.uses_in(fields)
      rules.push("StyleRule { selector: ${quote(r.selector)}, style: Style { ${fields.join(", ")} } }")
    }
    Ok("let ${c.name}_sheet = Sheet { // ${self.file}:${c.style_line}\n  rules: ${list(rules, "  ")},\n}")
  }

  /// A file's `<style global theme={AppTheme} name="app_sheet">`: a public function of the
  /// theme — `Theme` unless it names another — answering the sheet, for a `Themed` element
  /// (`<Themed theme={t} sheet={app_sheet(t)}>`). Named `global_sheet` unless it says.
  let global_sheet = (self: mut, t: Tag) -> Result<string, string> => {
    let rules = read_style(t.raw, t.line)?
    let theme = t.code_attr("theme") ?? "Theme"
    let name = t.text_attr("name") ?? "global_sheet"
    if theme == "Theme" { self.use("Theme") }
    let written = self.ui_rules(rules)?
    Ok("/// From ${self.file}, line ${t.line}.\npub let ${name} = pure (${theme_param(rules)}: ${theme}) -> Sheet => Sheet {\n  rules: ${self.listed(written, "  ")},\n}")
  }

  /// `rules` as `ui.style` `Rule`s, each marked with its markup line; a part rule checked
  /// against the parts its component has.
  let ui_rules = (self: mut, rules: []Rule) -> Result<[]Item, string> => {
    self.use("Sheet")
    self.use("Rule")
    self.use("Style")
    self.use("Theme")
    var out: []Item = []
    for r in rules {
      self.check_part(r)?
      let fields = ui_declarations(r.body, r.line, true)?
      self.ui_uses_in(fields)
      let media = if r.media.len() == 0 { "" } else {
        self.use("Media")
        self.ui_uses_in([r.media])
        ", media: ${r.media}"
      }
      out.push(Item {
        text: "Rule { selector: ${quote(r.selector)}, style: Style { ${fields.join(", ")} }${media} }",
        line: r.line,
      })
    }
    Ok(out)
  }

  /// A rule's `component::part` (or `component.class::part`) naming a part its component does
  /// not have, as a prop that is not one is: the component of this file or one it imports, or
  /// one of `ui`'s controls. Another component, written in Lyra, is taken on trust.
  let check_part = pure (self, r: Rule) -> Result<void, string> => {
    let halves = r.selector.split("::")
    if halves.len() == 1 { return Ok() }
    if halves.len() > 2 { return Err("${r.line}: ${r.selector} has more than one ::") }
    let owner = pieces(halves[0])[0]
    let part = pieces(halves[1].trim())[0]
    let known = match self.parts_of(owner) {
      Some(parts) => parts,
      None => return Ok(),
    }
    if known.any((p) => p == part) { return Ok() }
    let named = if known.len() == 0 { "none" } else { known.join(", ") }
    Err("${r.line}: ${owner} has no part ${part} (its parts: ${named})")
  }

  /// The parts of the component or control named `name`, if lui knows it.
  let parts_of = pure (self, name: string) -> Maybe<[]string> => {
    if let Some(c) = component_named(self.components, name) { return Some(c.parts) }
    for i in self.imported {
      if let Some(c) = component_named(i.components, name) { return Some(c.parts) }
    }
    match name {
      "Checkbox" => Some(["box", "checked", "fill"]),
      "Slider" => Some(["track", "fill", "thumb"]),
      "Select" => Some(["arrow", "list", "option"]),
      "Popup" => Some(["content"]),
      "TextInput" => Some(["placeholder", "selection", "caret"]),
      "MenuItem" => Some(["check", "shortcut", "arrow"]),
      "Tab" => Some(["label"]),
      "WindowButton" => Some(["glyph", "frame", "cross"]),
      _ => None,
    }
  }

  /// `children` as array elements, each written at `indent`.
  let nodes_of = (
    self: mut,
    children: []Markup,
    indent: string
  ) -> Result<[]Item, string> => {
    var items: []Item = []
    var i = 0
    while i < children.len() {
      match children[i] {
        Words(text, line) => {
          if text.trim().len() > 0 {
            return Err("${line}: text \"${text.trim()}\" outside an element that takes it; wrap it in <Text>")
          }
        },
        Code(code, line) => items.push(Item { text: code, line: line }),
        Element(t) => {
          if t.name == "if" {
            let then_items = self.nodes_of(t.children, "${indent}    ")?
            var else_items: []Item = []
            let next = next_element(children, i + 1)
            if let Some((k, e)) = next {
              if e.name == "else" {
                else_items = self.nodes_of(e.children, "${indent}    ")?
                i = k
              }
            }
            let test = t.code_attr("test").unwrap_or("")
            if test.len() == 0 { return Err("${t.line}: <if> needs test={…}") }
            self.use("Node")
            let then_list = self.listed(then_items, "${indent}  ")
            let else_list = self.listed(else_items, "${indent}  ")
            items.push(Item {
              text: "...(if ${test} {\n${indent}  ${then_list}\n${indent}} else {\n${indent}  ${else_list}\n${indent}})",
              line: t.line,
            })
          } else if t.name == "else" {
            return Err("${t.line}: <else> with no <if> before it")
          } else if t.name == "for" {
            let each = t.code_attr("each").unwrap_or("")
            if each.len() == 0 { return Err("${t.line}: <for> needs each={x in xs}") }
            let body = self.nodes_of(t.children, "${indent}  ")?
            if body.len() == 1 && !body[0].text.starts_with("...") {
              items.push(Item { text: "...[${each} | ${body[0].text}]", line: t.line })
            } else if self.target == UI {
              // Several a time, in place: an array each, flattened — called as a function, which
              // the list's element type reaches (a method's receiver it does not).
              items.push(Item {
                text: "...flatten([${each} | ${self.listed(body, "${indent}  ")}])",
                line: t.line
              })
            } else {
              self.use("Fragment")
              items.push(Item {
                text: "...[${each} | Fragment(${self.listed(body, indent)})]",
                line: t.line
              })
            }
          } else {
            items.push(Item { text: self.element(t, indent)?, line: t.line })
          }
        },
      }
      i += 1
    }
    Ok(items)
  }

  /// One element or component call, its continuation lines at `indent`.
  let element = (self: mut, t: Tag, indent: string) -> Result<string, string> => {
    if self.making.len() > 0 { return self.datum(t, indent) }
    if !is_upper(t.name) { return self.call(t, indent) }
    if self.target == UI { return self.ui_element(t, indent) }
    if attr_named(t.attrs, "key").is_some() || attr_named(t.attrs, "part").is_some() {
      return Err("${t.line}: key= and part= are the ui target's; name it with <script target=\"ui\">")
    }
    // A slot is its name alone: where the caller draws, through `seen`.
    if t.name == "Slot" {
      let Some(name) = attr_named(t.attrs, "name") else {
        return Err("${t.line}: <Slot> needs name=\"…\"")
      }
      if name.value == Bare { return Err("${t.line}: <Slot> needs name=\"…\"") }
      self.use("Slot")
      return Ok("Slot(${attr_lyra(name.value)})")
    }
    let Some(kind) = element_kind(t.name) else {
      return Err("${t.line}: <${t.name}> is not an element of bindings.imgui.ui")
    }
    self.use(t.name)
    if kind.attrs.len() == 0 && kind.text_field.len() == 0 {
      if t.attrs.len() > 0 { return Err("${t.line}: <${t.name}> takes no attributes") }
      if !kind.holds {
        if t.children.len() > 0 && words_of(t.children).trim().len() > 0 {
          return Err("${t.line}: <${t.name}> holds nothing")
        }
        return Ok(t.name)
      }
      let items = self.nodes_of(t.children, "${indent}  ")?
      return Ok("${t.name}(${self.listed(items, indent)})")
    }
    // An element whose text is its only payload (SeparatorText).
    if kind.attrs_struct.len() == 0 {
      return Ok("${t.name}(${label_of(t)?})")
    }
    var fields: []string = []
    if kind.text_field.len() > 0 {
      let text = label_of(t)?
      if text != "\"\"" || kind.required.filter((r) => r == kind.text_field).len() > 0 {
        fields.push("${kind.text_field}: ${text}")
      }
    }
    for a in t.attrs {
      let Some(field) = field_named(kind.attrs, a.name) else {
        return Err("${a.line}: <${t.name}> has no attribute ${a.name}")
      }
      fields.push("${a.name}: ${self.attr_value(t.name, field, a)?}")
    }
    for r in kind.required {
      if r != kind.text_field && t.attrs.filter((a) => a.name == r).len() == 0 {
        return Err("${t.line}: <${t.name}> needs ${r}")
      }
    }
    self.use(kind.attrs_struct)
    let attrs = if fields.len() == 0 {
      "${kind.attrs_struct} {}"
    } else {
      "${kind.attrs_struct} { ${fields.join(", ")} }"
    }
    if !kind.holds { return Ok("${t.name}(${attrs})") }
    let items = self.nodes_of(t.children, "${indent}  ")?
    Ok("${t.name}(${attrs}, ${self.listed(items, indent)})")
  }

  /// A call of a component of this file: its props in order, from the attributes, the
  /// children, or the defaults.
  let call = (self: mut, t: Tag, indent: string) -> Result<string, string> => {
    var found = component_named(self.components, t.name)
    if found.is_none() {
      for i in self.imported {
        if let Some(c) = component_named(i.components, t.name) {
          found = Some(c)
          let called = "${i.module}.${c.name}"
          if !self.called.any((k) => k == called) { self.called.push(called) }
        }
      }
    }
    let Some(c) = found else {
      return Err("${t.line}: no component ${t.name} in this file or one it imports (<import src=\"…\"/>); call one written in Lyra as {${t.name}(…)}")
    }
    // In the ui target a call takes the common attributes too — `class`, `style`, `key` —
    // on the component's own node, where its parent's layout (a grid's `grid-column`) reads
    // them; a prop of the same name is the prop.
    let is_prop = (name: string) -> bool => c.props.any((p) => p.name == name)
    for a in t.attrs {
      let common = self.target == UI && UI_COMMON.any((n) => n == a.name)
      if !is_prop(a.name) && !common {
        return Err("${a.line}: component ${c.name} has no prop ${a.name}")
      }
    }
    var args: []string = []
    for p in c.props {
      match attr_named(t.attrs, p.name) {
        Some(a) => args.push(attr_lyra(a.value)),
        None => {
          if p.name == "children" {
            let items = self.nodes_of(t.children, "${indent}  ")?
            args.push(self.listed(items, indent))
          } else if p.default.len() > 0 {
            args.push(p.default)
          } else {
            return Err("${t.line}: <${c.name}> needs ${p.name}")
          }
        },
      }
    }
    let made = "${c.name}(${args.join(", ")})"
    if self.target != UI { return Ok(made) }
    self.ui_modifiers(Tag { t | attrs: [a in t.attrs | !is_prop(a.name) | a] }, made)
  }

  /// An attribute's value as the Lyra its field takes.
  let attr_value = (
    self: mut,
    tag: string,
    field: Field,
    a: Attr
  ) -> Result<string, string> => {
    let wrong = "${a.line}: ${a.name} of <${tag}>"
    match (field.kind, a.value) {
      (Changes(value_type), Braced(code)) => Ok(if is_bare_name(code) {
        "(value: ${value_type}) -> ${self.event} => ${code}(value)"
      } else {
        code
      }),
      (Looks, Braced(code)) => {
        self.use("Style")
        Ok(code)
      },
      (_, Braced(code)) => Ok(if field.kind == MaybeOf { "Some(${code})" } else { code }),
      (Str, Quoted(text)) => Ok(interpolated(text)),
      (Flag, Bare) => Ok("true"),
      (Flag, Quoted(text)) => if text == "true" || text == "false" {
        Ok(text)
      } else {
        Err("${wrong} is true or false")
      },
      (Keys, Quoted(text)) => {
        self.use("Shortcut")
        shortcut(text).map_err((what) => "${wrong}: ${what}")
      },
      (Looks, Quoted(text)) => {
        self.use("Style")
        let fields = declarations(text, a.line)?
        self.uses_in(fields)
        Ok("Style { ${fields.join(", ")} }")
      },
      (_, Bare) => Err("${wrong} needs a value"),
      _ => Err("${wrong} takes {…}"),
    }
  }

  /// The names of `bindings.imgui` a style's fields use: `col32`, `Vec2`.
  let uses_in = (self: mut, fields: []string) -> void => {
    for f in fields {
      if f.contains("col32(") { self.use("col32") }
      if f.contains("Vec2 {") { self.use("Vec2") }
    }
  }

  /// `items` as an array literal, one a line, each marked with the markup line it came
  /// from (`// view.lui:12`, on its first line) for `lui map`; the bracket at `indent`.
  let listed = pure (self, items: []Item, indent: string) -> string => {
    if items.len() == 0 { return "[]" }
    var out = "["
    for item in items {
      let marker = " // ${self.file}:${item.line}"
      let text = match item.text.index("\n") {
        Some(nl) =>
          "${item.text.slice(0, nl)}${marker}${item.text.slice(nl, item.text.len())},",
        None => "${item.text},${marker}",
      }
      out = "${out}\n${indent}  ${text}"
    }
    "${out}\n${indent}]"
  }

  let use = (self: mut, name: string) -> void => {
    if self.used.filter((u) => u == name).len() == 0 { self.used.push(name) }
  }

  /// The module's imports: the names of the target's modules it uses, in a fixed order — for
  /// `bindings.imgui.ui`, `bindings.imgui`'s colours and sizes too — and the components it
  /// calls from the files it imports.
  let imports = pure (self) -> string => {
    var import_lines: []string = []
    if self.target == UI {
      for (module, listed) in UI_MODULES {
        // `ui.style`'s layout names are kept in a list of their own.
        let names = if module == "ui.style" { [
          ...listed,
          ...LAYOUT_NAMES
        ] } else { listed }
        let mine = [n in names | self.used.any((u) => u == n) | n]
        if mine.len() > 0 { import_lines.push("import ${module}.{ ${mine.join(", ")} }") }
      }
    } else {
      var ui: []string = []
      for name in ui_names {
        if self.used.filter((u) => u == name).len() > 0 { ui.push(name) }
      }
      import_lines.push("import bindings.imgui.ui.{ ${ui.join(", ")} }")
      var imgui: []string = []
      if self.used.filter((u) => u == "col32").len() > 0 { imgui.push("col32") }
      if self.used.filter((u) => u == "Vec2").len() > 0 { imgui.push("Vec2") }
      if imgui.len() > 0 { import_lines.push("import bindings.imgui.{ ${imgui.join(", ")} }") }
    }
    for i in self.imported {
      let names = [c in i.components | self.called.any((k) => k == "${i.module}.${c.name}") | c.name]
      if names.len() > 0 { import_lines.push("import ${i.module}.{ ${names.join(", ")} }") }
    }
    import_lines.join("\n")
  }
}

/// Every name of `bindings.imgui.ui` a module may use, in its import's order.
let ui_names = [
  "Node",
  "Window",
  "MainMenuBar",
  "MenuBar",
  "Menu",
  "MenuItem",
  "Button",
  "Checkbox",
  "Combo",
  "Selectable",
  "Radio",
  "InputInt",
  "InputText",
  "Slider",
  "ColorEdit",
  "Modal",
  "Slot",
  "Form",
  "Field",
  "Text",
  "Separator",
  "SeparatorText",
  "Row",
  "Space",
  "Group",
  "Component",
  "Fragment",
  "WindowAttrs",
  "MenuAttrs",
  "MenuItemAttrs",
  "ButtonAttrs",
  "CheckboxAttrs",
  "ComboAttrs",
  "SelectableAttrs",
  "RadioAttrs",
  "InputIntAttrs",
  "InputTextAttrs",
  "SliderAttrs",
  "ColorEditAttrs",
  "ModalAttrs",
  "FieldAttrs",
  "FormAttrs",
  "RowAttrs",
  "SpaceAttrs",
  "GroupAttrs",
  "TextAttrs",
  "Shortcut",
  "Style",
  "Sheet",
  "StyleRule",
]

/// The next element among `children` from `from`, past blank text and comments, with its
/// index; `None` at anything else.
let next_element = pure (children: []Markup, from: i64) -> Maybe<(i64, Tag)> => {
  var k = from
  while k < children.len() {
    match children[k] {
      Words(text, _) => if text.trim().len() > 0 { return None },
      Code(_, _) => { return None },
      Element(t) => { return Some((k, t)) },
    }
    k += 1
  }
  None
}

/// An element's text as a Lyra string: its words, its `{…}` interpolated.
let label_of = pure (t: Tag) -> Result<string, string> => {
  var text = ""
  for child in t.children {
    match child {
      Element(c) => { return Err("${c.line}: <${t.name}> holds text, not <${c.name}>") },
      Words(w, _) => { text = "${text}${w}" },
      Code(code, _) => { text = "${text}{${code}}" },
    }
  }
  Ok(interpolated(collapse(text).trim()))
}

/// A component call's argument as written: a quoted string, Lyra, or a bare `true`.
let attr_lyra = pure (v: Value) -> string => match v {
  Quoted(text) => interpolated(text),
  Braced(code) => code,
  Bare => "true",
}

let field_named = pure (fields: []Field, name: string) -> Maybe<Field> => {
  for f in fields {
    if f.name == name { return Some(f) }
  }
  None
}

let component_named = pure (
  components: []Component,
  name: string
) -> Maybe<Component> => {
  for c in components {
    if c.name == name { return Some(c) }
  }
  None
}

let attr_named = pure (attrs: []Attr, name: string) -> Maybe<Attr> => {
  for a in attrs {
    if a.name == name { return Some(a) }
  }
  None
}

/// `items` as an array literal, one an line, the closing bracket at `indent`.
let list = pure (items: []string, indent: string) -> string => {
  if items.len() == 0 { return "[]" }
  var out = "["
  for item in items { out = "${out}\n${indent}  ${item}," }
  "${out}\n${indent}]"
}

// ── The ui target ────────────────────────────────────────────────────────────

/// The names a module for the ui target may import, by module, in each import's order.
const UI_MODULES = [
  (
    "ui.layout",
    [
      "Node",
      "Edges",
      "Alignment",
      "SliderSpec",
      "FieldSpec",
      "SelectSpec",
      "Horizontal",
      "Vertical",
      "MainStart",
      "MainCenter",
      "MainEnd",
      "SpaceBetween",
      "SpaceAround",
      "SpaceEvenly",
      "CrossStart",
      "CrossCenter",
      "CrossEnd",
      "CrossStretch",
      "FloatBeside",
      "row",
      "column",
      "stack",
      "expanded",
      "positioned",
      "padding",
      "align",
      "sized",
      "scroll",
      "text",
      "image",
      "themed",
      "component",
      "component_of",
      "button",
      "checkbox",
      "slider",
      "select",
      "popup",
      "text_input",
      "flex",
      "grid",
      "Menu",
      "MenuItem",
      "MenuItemEntry",
      "Submenu",
      "MenuSeparator",
      "menu_bar",
      "menu_button",
      "TabsSpec",
      "TabSpec",
      "tab_bar",
      "swatch",
      "color_picker",
      "window_buttons",
    ],
  ),
  ("ui.style", [
    "Style",
    "Sheet",
    "Rule",
    "Theme",
    "Insets",
    "insets",
    "insets_xy",
  ]),
  ("ui.draw", [
    "Size",
    "Rect",
    "Radii",
    "Color",
    "rgb",
    "rgba",
    "BoxShadow",
    "Gradient",
    "ColorStop",
    "LinearGradient",
    "RadialGradient",
  ]),
  ("ui.backend", [
    "LightMode",
    "DarkMode",
    "Chord",
    "Modifiers",
    "Character",
    "FunctionKey",
    "Enter",
    "Tab",
    "Escape",
    "Backspace",
    "Delete",
    "ArrowLeft",
    "ArrowRight",
    "ArrowUp",
    "ArrowDown",
    "Home",
    "End",
    "PageUp",
    "PageDown",
    "Insert",
  ]),
  ("ui.app", ["WindowSpec"]),
]

/// The names of `ui.style` that its layout properties are written with, which a module
/// imports as it uses them.
const LAYOUT_NAMES = [
  "Transition",
  "TimingEase",
  "TimingLinear",
  "TimingEaseIn",
  "TimingEaseOut",
  "TimingEaseInOut",
  "TimingBezier",
  "TimingSteps",
  "Overflow",
  "OverflowVisible",
  "OverflowHidden",
  "OverflowClip",
  "OverflowScroll",
  "OverflowAuto",
  "Media",
  "Portrait",
  "Landscape",
  "FlexRow",
  "FlexRowReverse",
  "FlexColumn",
  "FlexColumnReverse",
  "NoWrap",
  "Wrap",
  "WrapReverse",
  "JustifyStart",
  "JustifyEnd",
  "JustifyCenter",
  "JustifyBetween",
  "JustifyAround",
  "JustifyEvenly",
  "JustifyStretch",
  "AlignStart",
  "AlignEnd",
  "AlignCenter",
  "AlignStretch",
  "AlignBaseline",
  "BasisAuto",
  "BasisLength",
  "BasisFraction",
  "TrackPx",
  "TrackFr",
  "TrackAuto",
  "TrackMinContent",
  "TrackMaxContent",
  "px",
  "fr",
  "auto_track",
  "min_content",
  "max_content",
  "minmax",
  "repeat_tracks",
  "GridSpan",
  "FlowRow",
  "FlowColumn",
  "FlowRowDense",
  "FlowColumnDense",
]

/// What a ui element writes: the builder it calls and how its markup becomes the call.
data UiShape =
  /// Children in a row or column: `main=` and `cross=` place them.
  ShapeLine(string)
  /// Children over one another.
  | ShapePile
  /// One child: `expanded`, `positioned`, `padding`, `align`, `scroll`.
  | ShapeWrap(string)
  /// A box of a size, its children inside.
  | ShapeBox
  /// Its text: `text`.
  | ShapeText
  /// A control, its text its label: `button`, `checkbox`.
  | ShapeLabelled(string)
  /// A control of attributes alone: `slider`, `text_input`, `image`.
  | ShapeBare(string)
  /// Two children, an anchor and what floats from it while `open`: `popup`.
  | ShapePopup
  /// A theme and sheet for its children.
  | ShapeThemed
  /// A flex container or a grid: its attributes are style properties (`direction="column"`
  /// is `flex-direction: column`), which a sheet may set as well.
  | ShapeLayout(string)
  /// Menus as data: `menu_bar` (its `<Menu>`s), `menu_button` (its face and entries).
  | ShapeMenus(string)
  /// A tab bar: its `<Tab>`s, then what follows them.
  | ShapeTabs

/// The attributes every ui element takes: its classes, the part of its component it is, its
/// key, its label for assistive technology, its inline style, whether it is disabled (bare, or
/// `disabled={condition}`), and whether a press on it moves the window (`window-drag`, bare: a
/// title bar the program draws).
const UI_COMMON = ["class", "part", "key", "label", "style", "disabled", "window-drag"]

impl Writer {
  /// A capitalized tag as the `ui.layout` call it stands for, its common attributes chained
  /// after it (`.with_class(…)`, `.keyed(…)`).
  let ui_element = (self: mut, t: Tag, indent: string) -> Result<string, string> => {
    let Some((shape, allowed)) = ui_kind(t.name) else {
      return Err("${t.line}: <${t.name}> is not an element of ui")
    }
    for a in t.attrs {
      if !allowed.any((n) => n == a.name) && !UI_COMMON.any((n) => n == a.name) {
        return Err("${a.line}: <${t.name}> has no attribute ${a.name}")
      }
    }
    let base = match shape {
      ShapeLine(builder) => {
        self.use(builder)
        let items = self.nodes_of(t.children, "${indent}  ")?
        let made = "${builder}(${self.listed(items, indent)})"
        let main_word = t.text_attr("main")
        let cross_word = t.text_attr("cross")
        if main_word.is_none() && cross_word.is_none() {
          made
        } else {
          let m = main_align(main_word ?? "start").map_err((what) => "${t.line}: ${what}")?
          let default_cross = if builder == "row" { "center" } else { "start" }
          let c = cross_align(cross_word ?? default_cross).map_err((what) => "${t.line}: ${what}")?
          self.use(m)
          self.use(c)
          "${made}.aligned(${m}, ${c})"
        }
      },
      ShapePile => {
        self.use("stack")
        let items = self.nodes_of(t.children, "${indent}  ")?
        "stack(${self.listed(items, indent)})"
      },
      ShapeBox => {
        self.use("sized")
        let items = self.nodes_of(t.children, "${indent}  ")?
        let w = maybe_number(t, "width")?
        let h = maybe_number(t, "height")?
        if items.len() == 0 {
          "sized(${w}, ${h})"
        } else {
          "sized(${w}, ${h}, ${self.listed(items, indent)})"
        }
      },
      ShapeWrap(builder) => {
        self.use(builder)
        let child = self.only_child(t, indent)?
        match builder {
          "expanded" => {
            let flex = number_attr(t, "flex")?
            if flex.len() > 0 { "expanded(${child}, ${flex})" } else { "expanded(${child})" }
          },
          "positioned" => {
            self.use("Edges")
            var edges: []string = []
            for side in ["left", "top", "right", "bottom", "width", "height"] {
              let n = number_attr(t, side)?
              if n.len() > 0 { edges.push("${side}: Some(${n})") }
            }
            "positioned(Edges { ${edges.join(", ")} }, ${child})"
          },
          "padding" => "padding(${self.insets_attr(t)?}, ${child})",
          "align" => {
            self.use("Alignment")
            let at = alignment(t.text_attr("at") ?? "center").map_err((what) => "${t.line}: ${what}")?
            "align(${at}, ${child})"
          },
          _ => {
            let axis = match t.text_attr("axis") ?? "vertical" {
              "vertical" => "Vertical",
              "horizontal" => "Horizontal",
              other =>
                return Err("${t.line}: axis is vertical or horizontal, not ${other}"),
            }
            self.use(axis)
            let offset = number_attr(t, "offset")?
            "scroll(${axis}, ${if offset.len() > 0 { offset } else { "0.0" }}, ${child})"
          },
        }
      },
      ShapeText => {
        self.use("text")
        "text(${label_of(t)?})"
      },
      ShapeLabelled(builder) => {
        self.use(builder)
        let label = label_of(t)?
        if builder == "button" {
          "button(${label}, ${required(t, "on_click")?})"
        } else {
          let checked = match attr_named(t.attrs, "checked") {
            Some(a) => match a.value {
              Bare => "true",
              Braced(code) => code,
              Quoted(text) => text,
            },
            None => return Err("${t.line}: <Checkbox> needs checked"),
          }
          "checkbox(${label}, ${checked}, ${required(t, "on_toggle")?})"
        }
      },
      ShapeBare(builder) => {
        self.use(builder)
        if builder == "select" { return Ok(self.select_of(t)?) }
        // A colour's picker holds the program's controls under its strips (`below`).
        if builder == "swatch" || builder == "color_picker" {
          let items = self.nodes_of(t.children, "${indent}  ")?
          let below = if items.len() == 0 { "" } else { self.listed(items, indent) }
          return self.bare_control(t, builder, below)
        }
        if words_of(t.children).trim().len() > 0 || t.children.any((c) => match c {
          Element(_) => true,
          _ => false,
        }) {
          return Err("${t.line}: <${t.name}> holds nothing")
        }
        match builder {
          "slider" => {
            self.use("SliderSpec")
            var fields = ["value: ${required(t, "value")?}"]
            for f in ["min", "max", "step"] {
              let n = number_attr(t, f)?
              if n.len() > 0 { fields.push("${f}: ${n}") }
            }
            fields.push("on_change: ${self.changes(t, "on_change", "f32")?}")
            "slider(SliderSpec { ${fields.join(", ")} })"
          },
          "text_input" => {
            self.use("FieldSpec")
            var fields = ["value: ${required(t, "value")?}"]
            if let Some(a) = attr_named(t.attrs, "placeholder") {
              fields.push("placeholder: ${attr_lyra(a.value)}")
            }
            // HTML's `readonly`: bare, the field never edits and needs no on_edit; or a
            // condition, which needs one for while it does not hold.
            let read_only = attr_named(t.attrs, "readonly")
            if let Some(a) = read_only {
              match a.value {
                Quoted(_) => return Err("${a.line}: readonly is bare or {condition}, not text: readonly or readonly={!s.editing}"),
                other => fields.push("read_only: ${attr_lyra(other)}"),
              }
            }
            let bare = match read_only {
              Some(a) => a.value == Bare,
              None => false,
            }
            if bare && attr_named(t.attrs, "on_edit").is_none() {
              fields.push("on_edit: (_: string) -> ${self.event} => panic(\"a read-only field raised an edit\")")
            } else {
              fields.push("on_edit: ${self.changes(t, "on_edit", "string")?}")
            }
            "text_input(FieldSpec { ${fields.join(", ")} })"
          },
          "window_buttons" => self.bare_control(t, builder)?,
          _ => {
            self.use("Size")
            let w = number_attr(t, "width")?
            let h = number_attr(t, "height")?
            if w.len() == 0 || h.len() == 0 { return Err("${t.line}: <Image> needs width and height") }
            "image(${required(t, "texture")?}, ${required(t, "texels")?}, Size { w: ${w}, h: ${h} })"
          },
        }
      },
      ShapePopup => {
        self.use("popup")
        let items = self.nodes_of(t.children, "${indent}  ")?
        if items.len() != 2 || items.any((i) => i.text.starts_with("...")) {
          return Err("${t.line}: <Popup> holds two elements, its anchor and what opens from it")
        }
        let open = match attr_named(t.attrs, "open") {
          Some(a) => match a.value {
            Bare => "true",
            Braced(code) => code,
            Quoted(_) => return Err("${a.line}: open of <Popup> is bare or {condition}"),
          },
          None => return Err("${t.line}: <Popup> needs open"),
        }
        let side = match t.text_attr("side") ?? "below" {
          "below" => "",
          "beside" => {
            self.use("FloatBeside")
            ", FloatBeside"
          },
          other =>
            return Err("${t.line}: side of <Popup> is below or beside, not ${other}"),
        }
        "popup(${items[0].text}, ${open}, ${items[1].text}, ${required(t, "on_dismiss")?}${side})"
      },
      ShapeMenus(which) => {
        if which == "menu_bar" {
          self.use("menu_bar")
          let menus = self.making_of("menus", t.children, indent)?
          "menu_bar(${self.listed(menus, indent)})"
        } else {
          self.use("menu_button")
          let face = match (t.text_attr("title"), t.code_attr("face")) {
            (Some(title), None) => {
              self.use("text")
              "text::<${self.event}>(${interpolated(title)})"
            },
            (None, Some(code)) => code,
            _ => return Err("${t.line}: <MenuButton> needs title=\"…\" or face={…}, one of them"),
          }
          let entries = self.making_of("entries", t.children, indent)?
          "menu_button(${face}, ${self.listed(entries, indent)})"
        }
      },
      ShapeTabs => self.tab_bar_of(t, indent)?,
      ShapeThemed => {
        self.use("themed")
        let items = self.nodes_of(t.children, "${indent}  ")?
        "themed(${required(t, "theme")?}, ${required(t, "sheet")?}, ${self.listed(items, indent)})"
      },
      ShapeLayout(builder) => {
        self.use(builder)
        let items = self.nodes_of(t.children, "${indent}  ")?
        let made = "${builder}(${self.listed(items, indent)})"
        // Each attribute is the style property it names.
        var fields: []string = []
        for a in t.attrs {
          if UI_COMMON.any((n) => n == a.name) { continue }
          let property = layout_attribute(builder, a.name)
          let set: Maybe<Result<[]string, string>> = match a.value {
            Quoted(text) => layout_declaration(property, text),
            Braced(code) =>
              if NUMBER_PROPERTIES.any((n) => n == property) { Some(Ok(["${property}: Some(${code})"])) } else {
                Some(Err("${a.name} of <${t.name}> is written as text, not {…}"))
              },
            Bare => Some(Err("${a.name} of <${t.name}> needs a value")),
          }
          match set {
            Some(Ok(more)) => { for f in more { fields = with_field(fields, f) } },
            Some(Err(what)) => return Err("${a.line}: ${what}"),
            None => return Err("${a.line}: <${t.name}> has no attribute ${a.name}"),
          }
        }
        if fields.len() == 0 { made } else {
          self.use("Style")
          self.ui_uses_in(fields)
          "${made}.with_style(Style { ${fields.join(", ")} })"
        }
      },
    }
    self.ui_modifiers(t, base)
  }

  /// `base` with the element's common attributes chained after it.
  let ui_modifiers = (self: mut, t: Tag, base: string) -> Result<string, string> => {
    var out = base
    for a in t.attrs {
      match a.name {
        "class" => { out = "${out}.with_class(${attr_lyra(a.value)})" },
        "part" => { out = "${out}.with_part(${attr_lyra(a.value)})" },
        "key" => { out = "${out}.keyed(${attr_lyra(a.value)})" },
        "label" => { out = "${out}.labelled(${attr_lyra(a.value)})" },
        "disabled" => {
          let off = match a.value {
            Quoted(_) => return Err("${a.line}: disabled is bare or {condition}, not text: disabled or disabled={!s.ready}"),
            other => attr_lyra(other),
          }
          out = "${out}.disabled_if(${off})"
        },
        "window-drag" => {
          if a.value != Bare { return Err("${a.line}: window-drag is bare") }
          out = "${out}.window_drag()"
        },
        "style" => {
          self.use("Style")
          let fields = match a.value {
            Quoted(text) => ui_declarations(text, a.line, false)?,
            _ => return Err("${a.line}: style is \"…\": style=\"gap: 8; color: #333\""),
          }
          self.ui_uses_in(fields)
          out = "${out}.with_style(Style { ${fields.join(", ")} })"
        },
        _ => {},
      }
    }
    Ok(out)
  }

  /// The one element `t` holds, written at `indent`.
  let only_child = (self: mut, t: Tag, indent: string) -> Result<string, string> => {
    let items = self.nodes_of(t.children, indent)?
    if items.len() != 1 || items[0].text.starts_with("...") {
      return Err("${t.line}: <${t.name}> holds one element")
    }
    Ok(items[0].text)
  }

  /// An `on_change`-style attribute: a bare name is the lambda calling it.
  let changes = pure (
    self,
    t: Tag,
    name: string,
    value_type: string
  ) -> Result<string, string> => {
    let Some(a) = attr_named(
      t.attrs,
      name
    ) else { return Err("${t.line}: <${t.name}> needs ${name}") }
    match a.value {
      Braced(code) => Ok(if is_bare_name(code) {
        "(value: ${value_type}) -> ${self.event} => ${code}(value)"
      } else {
        code
      }),
      _ => Err("${a.line}: ${name} of <${t.name}> takes {…}"),
    }
  }

  /// `children` written as the data `making` names (`"menus"`, `"entries"`, `"tabs"`), at
  /// `indent`: `<for>`, `<if>` and `{…}` among them as among nodes.
  let making_of = (
    self: mut,
    making: string,
    children: []Markup,
    indent: string
  ) -> Result<[]Item, string> => {
    let was = self.making
    self.making = making
    let items = self.nodes_of(children, "${indent}  ")
    self.making = was
    items
  }

  /// One element written as the data [making_of] makes: a `<Menu title>` of a menu bar; a
  /// menu's `<MenuItem>`, `<Separator/>` or `<Menu title>` (a submenu); a tab bar's `<Tab>`.
  let datum = (self: mut, t: Tag, indent: string) -> Result<string, string> => {
    let wanted = match self.making {
      "menus" => ["Menu"],
      "entries" => ["MenuItem", "Separator", "Menu"],
      _ => ["Tab"],
    }
    if !wanted.any((w) => w == t.name) {
      let holder = match self.making {
        "menus" => "<MenuBar> holds <Menu>s",
        "entries" => "a menu holds <MenuItem>s, <Separator/>s and <Menu>s",
        _ => "<TabBar>'s tabs are <Tab>s",
      }
      return Err("${t.line}: ${holder}, not <${t.name}>")
    }
    let allowed = match t.name {
      "Menu" => ["title"],
      "MenuItem" => ["on_select", "shortcut", "disabled", "checked"],
      "Tab" => ["key", "closable", "movable"],
      _ => [],
    }
    for a in t.attrs {
      if !allowed.any((n) => n == a.name) { return Err("${a.line}: <${t.name}> has no attribute ${a.name}") }
    }
    match t.name {
      "Menu" => {
        let Some(title) = attr_named(
          t.attrs,
          "title"
        ) else { return Err("${t.line}: <Menu> needs title") }
        let entries = self.making_of("entries", t.children, indent)?
        if self.making == "menus" {
          self.use("Menu")
          Ok("Menu { label: ${attr_lyra(title.value)}, entries: ${self.listed(entries, indent)} }")
        } else {
          self.use("Submenu")
          Ok("Submenu(${attr_lyra(title.value)}, ${self.listed(entries, indent)})")
        }
      },
      "Separator" => {
        if t.children.len() > 0 && words_of(t.children).trim().len() > 0 {
          return Err("${t.line}: <Separator> holds nothing")
        }
        self.use("MenuSeparator")
        Ok("MenuSeparator")
      },
      "MenuItem" => {
        self.use("MenuItem")
        self.use("MenuItemEntry")
        var fields = ["label: ${label_of(t)?}", "on_select: ${required(t, "on_select")?}"]
        if let Some(a) = attr_named(t.attrs, "shortcut") {
          let Quoted(text) = a.value else { return Err("${a.line}: shortcut is text: shortcut=\"Cmd+S\"") }
          fields.push("shortcut: Some(${self.chord(text).map_err((what) => "${a.line}: ${what}")?})")
        }
        if let Some(a) = attr_named(t.attrs, "disabled") {
          match a.value {
            Bare => fields.push("enabled: false"),
            Braced(code) => fields.push("enabled: !(${code})"),
            Quoted(_) => return Err("${a.line}: disabled is bare or {condition}"),
          }
        }
        if let Some(a) = attr_named(t.attrs, "checked") {
          match a.value {
            Quoted(_) => return Err("${a.line}: checked is bare or {condition}"),
            other => fields.push("checked: ${attr_lyra(other)}"),
          }
        }
        Ok("MenuItemEntry(MenuItem { ${fields.join(", ")} })")
      },
      _ => {
        self.use("TabSpec")
        var fields = ["label: ${label_of(t)?}", "key: ${required(t, "key")?}"]
        for flag in ["closable", "movable"] {
          if let Some(a) = attr_named(t.attrs, flag) {
            match a.value {
              Quoted(text) => {
                if text != "true" && text != "false" { return Err("${a.line}: ${flag} is bare, {condition}, or \"false\"") }
                fields.push("${flag}: ${text}")
              },
              other => fields.push("${flag}: ${attr_lyra(other)}"),
            }
          }
        }
        Ok("TabSpec { ${fields.join(", ")} }")
      },
    }
  }

  /// A `<TabBar selected={…} on_select={…} on_close={…} on_move={…}>`: its tabs — `<Tab
  /// key={…}>`s, or `tabs={…}`, a Lyra `[]TabSpec` — then any other elements, which follow the
  /// tabs in the strip (a `+`, a menu button). `on_select` and `on_close` take the tab's place,
  /// `on_move` its place and the place it moves to.
  let tab_bar_of = (self: mut, t: Tag, indent: string) -> Result<string, string> => {
    self.use("tab_bar")
    self.use("TabsSpec")
    var tab_markup: []Markup = []
    var after_markup: []Markup = []
    for child in t.children {
      match child {
        Element(c) => {
          if c.name == "Tab" || c.name == "for" || c.name == "if" || c.name == "else" {
            tab_markup.push(child)
          } else {
            after_markup.push(child)
          }
        },
        Words(w, line) => {
          if w
            .trim()
            .len() > 0 { return Err("${line}: <TabBar> holds <Tab>s and elements, not text") }
        },
        Code(_, line) => { return Err("${line}: <TabBar> holds <Tab>s, not {…}; or write tabs={…}") },
      }
    }
    let tabs = match t.code_attr("tabs") {
      Some(code) => {
        if tab_markup.len() > 0 { return Err("${t.line}: <TabBar> takes tabs={…} or <Tab>s, not both") }
        code
      },
      None => {
        if tab_markup.len() == 0 { return Err("${t.line}: <TabBar> needs tabs={…} or <Tab>s") }
        self.listed(self.making_of("tabs", tab_markup, indent)?, indent)
      },
    }
    var fields = [
      "tabs: ${tabs}",
      "selected: ${required(t, "selected")?}",
      "on_select: ${self.changes(t, "on_select", "i64")?}",
      "on_close: ${self.changes(t, "on_close", "i64")?}",
      "on_move: ${self.moves(t, "on_move")?}",
    ]
    if after_markup.len() > 0 {
      let after = self.nodes_of(after_markup, "${indent}  ")?
      fields.push("after: ${self.listed(after, indent)}")
    }
    Ok("tab_bar(TabsSpec { ${fields.join(", ")} })")
  }

  /// A move's attribute: a bare name is the lambda calling it with a place and the place it
  /// moves to.
  let moves = pure (self, t: Tag, name: string) -> Result<string, string> => {
    let Some(a) = attr_named(
      t.attrs,
      name
    ) else { return Err("${t.line}: <${t.name}> needs ${name}") }
    match a.value {
      Braced(code) => Ok(if is_bare_name(code) {
        "(from: i64, to: i64) -> ${self.event} => ${code}(from, to)"
      } else {
        code
      }),
      _ => Err("${a.line}: ${name} of <${t.name}> takes {…}"),
    }
  }

  /// `<Swatch>`, `<ColorPicker>` and `<WindowButtons/>`: controls of attributes, a colour's
  /// with `below` — its children, listed — under its picker's strips.
  let bare_control = (
    self: mut,
    t: Tag,
    builder: string,
    below: string = ""
  ) -> Result<string, string> => {
    self.use(builder)
    // Positional after the alpha, which is then written out whether or not `opaque` was.
    let alpha = opaque_arg(t)?
    let tail = if below == "" { alpha } else { "${if alpha == "" { ", true" } else { alpha }}, ${below}" }
    match builder {
      "swatch" => {
        self.use("Color")
        let open = match attr_named(t.attrs, "open") {
          Some(a) => match a.value {
            Bare => "true",
            Braced(code) => code,
            Quoted(_) => return Err("${a.line}: open of <Swatch> is bare or {condition}"),
          },
          None => return Err("${t.line}: <Swatch> needs open"),
        }
        Ok("swatch(${required(t, "color")?}, ${open}, ${required(t, "on_open")?}, ${self.changes(t, "on_change", "Color")?}, ${required(t, "on_dismiss")?}${tail})")
      },
      "color_picker" => {
        self.use("Color")
        Ok("color_picker(${required(t, "color")?}, ${self.changes(t, "on_change", "Color")?}${tail})")
      },
      _ => Ok("window_buttons::<${self.event}>()"),
    }
  }

  /// A shortcut as `ui.backend`'s `Chord`: modifiers and a key joined by `+` — `Cmd` or `Ctrl`
  /// (the primary modifier either way: Cmd on a Mac, Ctrl elsewhere), `Alt`, `Shift` — and a
  /// character or a key's name (`Enter`, `Tab`, `Escape`, `Backspace`, `Delete`, `Left`,
  /// `Right`, `Up`, `Down`, `Home`, `End`, `PgUp`, `PgDn`, `Insert`, `Space`, `F1`–`F24`).
  let chord = (self: mut, text: string) -> Result<string, string> => {
    var mods: []string = []
    var key = ""
    let parts = text.split("+")
    for i, part in parts {
      let p = part.trim().to_ascii_lower()
      if i < parts.len() - 1 {
        let field = match p {
          "cmd" => "primary",
          "ctrl" => "primary",
          "alt" => "alt",
          "shift" => "shift",
          _ => return Err("${part.trim()} is not Cmd, Ctrl, Alt or Shift"),
        }
        if !mods.any((m) => m == "${field}: true") { mods.push("${field}: true") }
      } else {
        key = part.trim()
      }
    }
    // `Cmd++`: the key is the last `+`, which split leaves empty.
    if key.len() == 0 && text.ends_with("+") { key = "+" }
    if key.len() == 0 { return Err("a shortcut needs a key: \"Cmd+S\"") }
    let named = match key.to_ascii_lower() {
      "enter" => "Enter",
      "tab" => "Tab",
      "escape" => "Escape",
      "esc" => "Escape",
      "backspace" => "Backspace",
      "delete" => "Delete",
      "left" => "ArrowLeft",
      "right" => "ArrowRight",
      "up" => "ArrowUp",
      "down" => "ArrowDown",
      "home" => "Home",
      "end" => "End",
      "pgup" => "PageUp",
      "pageup" => "PageUp",
      "pgdn" => "PageDown",
      "pagedown" => "PageDown",
      "insert" => "Insert",
      "space" => "",
      _ => "",
    }
    let written = if named.len() > 0 {
      self.use(named)
      named
    } else if key.to_ascii_lower() == "space" {
      self.use("Character")
      "Character(' ')"
    } else if let Some(n) = function_number(key) {
      self.use("FunctionKey")
      "FunctionKey(${n})"
    } else if key.to_runes().len() == 1 {
      self.use("Character")
      "Character(${rune_literal(key.to_ascii_lower())})"
    } else {
      return Err("a shortcut's key is one character or a key's name, not \"${key}\"")
    }
    self.use("Chord")
    if mods.len() == 0 { return Ok("Chord { key: ${written} }") }
    self.use("Modifiers")
    Ok("Chord { key: ${written}, mods: Modifiers { ${mods.join(", ")} } }")
  }

  /// A `<Select selected={…} on_change={…}>` and its options: `options={…}`, a Lyra
  /// `[]string`, or `<Option>`s inside it, each its text (`{…}` interpolated, as a button's
  /// label is) — one or the other — with `<Separator/>`s between groups of them, or
  /// `separators={…}`, the indices a rule goes before; `option_families={…}`, each option's font
  /// family (a `[]string`, `""` for the select's own). `on_change` takes the index chosen, an
  /// `i64`.
  let select_of = (self: mut, t: Tag) -> Result<string, string> => {
    self.use("SelectSpec")
    var texts: []string = []
    var rules: []string = []
    for child in t.children {
      match child {
        Element(o) => {
          if o.name == "Separator" {
            if o.attrs.len() > 0 { return Err("${o.attrs[0].line}: <Separator> takes no attributes") }
            rules.push("${texts.len()}")
            continue
          }
          if o.name != "Option" {
            return Err("${o.line}: <Select> holds <Option>s and <Separator/>s, not <${o.name}>")
          }
          if o.attrs.len() > 0 { return Err("${o.attrs[0].line}: <Option> takes no attributes") }
          texts.push(label_of(o)?)
        },
        Words(w, _) => {
          let blank = w.trim().len() == 0
          if !blank { return Err("${t.line}: <Select> holds <Option>s, not text") }
        },
        Code(_, _) => { return Err("${t.line}: <Select> holds <Option>s, not {…}; or write options={…}") },
      }
    }
    let options = match attr_named(t.attrs, "options") {
      Some(a) => match a.value {
        Braced(code) => {
          if texts.len() > 0 {
            return Err("${a.line}: <Select> takes options={…} or <Option>s, not both")
          }
          code
        },
        _ => return Err("${a.line}: options of <Select> takes {…}, a []string"),
      },
      None => {
        if texts.len() == 0 { return Err("${t.line}: <Select> needs options={…} or <Option>s") }
        "[${texts.join(", ")}]"
      },
    }
    var fields = [
      "options: ${options}",
      "selected: ${required(t, "selected")?}",
      "on_change: ${self.changes(t, "on_change", "i64")?}",
    ]
    match t.code_attr("separators") {
      Some(code) => {
        if rules.len() > 0 { return Err("${t.line}: <Select> takes separators={…} or <Separator/>s, not both") }
        fields.push("separators: ${code}")
      },
      None => if rules.len() > 0 { fields.push("separators: [${rules.join(", ")}]") },
    }
    if let Some(code) = t.code_attr("option_families") { fields.push("option_families: ${code}") }
    Ok("select(SelectSpec { ${fields.join(", ")} })")
  }

  /// A `<Padding>`'s space: `all`, else `x` and `y`, else `top`, `right`, `bottom`, `left`.
  let insets_attr = (self: mut, t: Tag) -> Result<string, string> => {
    let all = number_attr(t, "all")?
    if all.len() > 0 {
      self.use("insets")
      return Ok("insets(${all})")
    }
    let x = number_attr(t, "x")?
    let y = number_attr(t, "y")?
    if x.len() > 0 || y.len() > 0 {
      self.use("insets_xy")
      return Ok("insets_xy(${if x.len() > 0 { x } else { "0.0" }}, ${if y.len() > 0 { y } else { "0.0" }})")
    }
    self.use("Insets")
    var sides: []string = []
    for side in ["top", "right", "bottom", "left"] {
      let n = number_attr(t, side)?
      if n.len() > 0 { sides.push("${side}: ${n}") }
    }
    Ok("Insets { ${sides.join(", ")} }")
  }

  /// The names of `ui.style` and `ui.draw` a style's fields use.
  let ui_uses_in = (self: mut, fields: []string) -> void => {
    for f in fields {
      for word in identifiers(f) {
        let known = [
          "rgb",
          "rgba",
          "Radii",
          "insets",
          "insets_xy",
          "Insets",
          "LightMode",
          "DarkMode",
          "BoxShadow",
          "Gradient",
          "ColorStop",
          "LinearGradient",
          "RadialGradient"
        ].any((n) => n == word) ||
          LAYOUT_NAMES.any((n) => n == word)
        if known { self.use(word) }
      }
    }
  }
}

/// An attribute the element cannot do without, as Lyra.
let required = pure (t: Tag, name: string) -> Result<string, string> =>
  match attr_named(t.attrs, name) {
    Some(a) => Ok(attr_lyra(a.value)),
    None => Err("${t.line}: <${t.name}> needs ${name}"),
  }

/// A number attribute as an `f32`: `"8"` is `8.0`, `{w}` is `w`; `""` when absent.
let number_attr = pure (t: Tag, name: string) -> Result<string, string> =>
  match attr_named(t.attrs, name) {
    None => Ok(""),
    Some(a) => match a.value {
      Quoted(text) => number(text).map_err((what) => "${a.line}: ${what}"),
      Braced(code) => Ok(code),
      Bare => Err("${a.line}: ${name} of <${t.name}> needs a value"),
    },
  }

/// A number attribute as a `Maybe<f32>`: absent is `None`.
let maybe_number = pure (t: Tag, name: string) -> Result<string, string> => {
  let n = number_attr(t, name)?
  Ok(if n.len() == 0 { "None" } else { "Some(${n})" })
}

/// A ui element's shape and the attributes of its own it takes, beside [UI_COMMON].
let ui_kind = pure (tag: string) -> Maybe<(UiShape, []string)> => match tag {
  "Row" => Some((ShapeLine("row"), ["main", "cross"])),
  "Column" => Some((ShapeLine("column"), ["main", "cross"])),
  "Stack" => Some((ShapePile, [])),
  "Expanded" => Some((ShapeWrap("expanded"), ["flex"])),
  "Positioned" => Some((ShapeWrap("positioned"), ["left", "top", "right", "bottom", "width", "height"])),
  "Padding" =>
    Some((ShapeWrap("padding"), ["all", "x", "y", "top", "right", "bottom", "left"])),
  "Align" => Some((ShapeWrap("align"), ["at"])),
  "Scroll" => Some((ShapeWrap("scroll"), ["axis", "offset"])),
  "SizedBox" => Some((ShapeBox, ["width", "height"])),
  "Text" => Some((ShapeText, [])),
  "Button" => Some((ShapeLabelled("button"), ["on_click"])),
  "Checkbox" => Some((ShapeLabelled("checkbox"), ["checked", "on_toggle"])),
  "Slider" => Some((ShapeBare("slider"), ["value", "min", "max", "step", "on_change"])),
  "Select" =>
    Some((ShapeBare("select"), ["options", "selected", "on_change", "separators", "option_families"])),
  "Popup" => Some((ShapePopup, ["open", "on_dismiss", "side"])),
  "TextInput" =>
    Some((ShapeBare("text_input"), ["value", "placeholder", "readonly", "on_edit"])),
  "Image" => Some((ShapeBare("image"), ["texture", "texels", "width", "height"])),
  "Themed" => Some((ShapeThemed, ["theme", "sheet"])),
  "MenuBar" => Some((ShapeMenus("menu_bar"), [])),
  "MenuButton" => Some((ShapeMenus("menu_button"), ["title", "face"])),
  "TabBar" => Some((ShapeTabs, ["tabs", "selected", "on_select", "on_close", "on_move"])),
  "Swatch" =>
    Some((ShapeBare("swatch"), ["color", "open", "on_open", "on_change", "on_dismiss", "opaque"])),
  "ColorPicker" => Some((ShapeBare("color_picker"), ["color", "on_change", "opaque"])),
  "WindowButtons" => Some((ShapeBare("window_buttons"), [])),
  "Flex" => Some((ShapeLayout("flex"), FLEX_ATTRIBUTES)),
  "Grid" => Some((ShapeLayout("grid"), GRID_ATTRIBUTES)),
  _ => None,
}

/// A `<Flex>`'s attributes and a `<Grid>`'s: style properties, short where CSS's names are
/// long (`direction` is `flex-direction`, `columns` is `grid-template-columns`).
const FLEX_ATTRIBUTES = [
  "direction",
  "wrap",
  "justify",
  "align",
  "align-content",
  "gap",
  "row-gap",
  "column-gap"
]
const GRID_ATTRIBUTES = [
  "columns",
  "rows",
  "gap",
  "row-gap",
  "column-gap",
  "flow",
  "justify-items",
  "align-items",
  "auto-columns",
  "auto-rows"
]

/// The style property (in `ui.style`'s spelling) attribute `name` of `builder`'s element sets.
let layout_attribute = pure (builder: string, name: string) -> string => match name {
  "direction" => "flex_direction",
  "wrap" => "flex_wrap",
  "justify" => "justify_content",
  "align" => "align_items",
  "columns" => "grid_template_columns",
  "rows" => "grid_template_rows",
  "flow" => "grid_auto_flow",
  "auto-columns" => "grid_auto_columns",
  "auto-rows" => "grid_auto_rows",
  other => other.replace("-", "_"),
}

/// The layout properties a `{…}` value may give: lengths.
const NUMBER_PROPERTIES = [
  "gap",
  "row_gap",
  "column_gap",
  "width",
  "height",
  "min_width",
  "max_width",
  "min_height",
  "max_height"
]

/// The `ui.style` fields layout declaration `name: value` sets (`name` with `_` for `-`) —
/// sizes, flex and grid properties, as CSS writes them — or `None` for a name that is not
/// one. An unknown value is an error naming the ones there are.
let layout_declaration = pure (
  name: string,
  value: string
) -> Maybe<Result<[]string, string>> => {
  let one = (
    field: string,
    made: Result<string, string>
  ) -> Maybe<Result<[]string, string>> =>
    Some(made.map((v) => ["${field}: Some(${v})"]))
  match name {
    "width" => one(name, ui_number(value)),
    "height" => one(name, ui_number(value)),
    "min_width" => one(name, ui_number(value)),
    "max_width" => one(name, ui_number(value)),
    "min_height" => one(name, ui_number(value)),
    "max_height" => one(name, ui_number(value)),
    "row_gap" => one(name, ui_number(value)),
    "column_gap" => one(name, ui_number(value)),
    "gap" => one(name, ui_number(value)),
    "flex_direction" => one(name, word_of(name, value, [
      ("row", "FlexRow"),
      ("row-reverse", "FlexRowReverse"),
      ("column", "FlexColumn"),
      ("column-reverse", "FlexColumnReverse"),
    ])),
    "flex_wrap" => one(name, word_of(name, value, [("nowrap", "NoWrap"), ("wrap", "Wrap"), ("wrap-reverse", "WrapReverse")])),
    "justify_content" => one(name, word_of(name, value, JUSTIFY_WORDS)),
    "align_content" =>
      one(name, word_of(name, value, [...JUSTIFY_WORDS, ("stretch", "JustifyStretch")])),
    "align_items" => one(name, word_of(name, value, ALIGN_WORDS)),
    "align_self" => one(name, word_of(name, value, ALIGN_WORDS)),
    "justify_items" => one(name, word_of(name, value, ALIGN_WORDS)),
    "justify_self" => one(name, word_of(name, value, ALIGN_WORDS)),
    "flex_grow" => one("grow", number(value)),
    "flex_shrink" => one("shrink", number(value)),
    "flex_basis" => one("basis", basis_of(value)),
    "order" => one(name, integer(value)),
    "flex" => Some(flex_shorthand(value)),
    "grid_template_columns" => one("grid_columns", track_list(value)),
    "grid_template_rows" => one("grid_rows", track_list(value)),
    "grid_auto_columns" => one(name, one_track(value)),
    "grid_auto_rows" => one(name, one_track(value)),
    "grid_auto_flow" => one("grid_flow", word_of(name, value, [
      ("row", "FlowRow"),
      ("column", "FlowColumn"),
      ("dense", "FlowRowDense"),
      ("row dense", "FlowRowDense"),
      ("column dense", "FlowColumnDense"),
    ])),
    "grid_column" => one(name, grid_line(value)),
    "overflow" => {
      // CSS's shorthand: one value for both axes, or across then down.
      let words = value.trim().split_when((c) => c == ' ')
      if words.len() == 0 || words.len() > 2 {
        return Some(Err("overflow is one or two of visible, hidden, clip, scroll, auto, not ${value}"))
      }
      let across = overflow_of(words[0])
      let down = overflow_of(if words.len() == 2 { words[1] } else { words[0] })
      match (across, down) {
        (Ok(x), Ok(y)) => Some(Ok(["overflow_x: Some(${x})", "overflow_y: Some(${y})"])),
        (Err(why), _) => Some(Err(why)),
        (_, Err(why)) => Some(Err(why)),
      }
    },
    "overflow_x" => one(name, overflow_of(value)),
    "overflow_y" => one(name, overflow_of(value)),
    "scroll_follow" => one(name, match value.trim() {
      "true" => Ok("true"),
      "false" => Ok("false"),
      other => Err("scroll-follow is true or false, not ${other}"),
    }),
    "grid_row" => one(name, grid_line(value)),
    _ => None,
  }
}

const JUSTIFY_WORDS = [
  ("start", "JustifyStart"),
  ("flex-start", "JustifyStart"),
  ("end", "JustifyEnd"),
  ("flex-end", "JustifyEnd"),
  ("center", "JustifyCenter"),
  ("space-between", "JustifyBetween"),
  ("space-around", "JustifyAround"),
  ("space-evenly", "JustifyEvenly"),
]

const ALIGN_WORDS = [
  ("start", "AlignStart"),
  ("flex-start", "AlignStart"),
  ("end", "AlignEnd"),
  ("flex-end", "AlignEnd"),
  ("center", "AlignCenter"),
  ("stretch", "AlignStretch"),
  ("baseline", "AlignBaseline"),
]

/// `value` as the constructor `words` pairs it with, or an error listing the words.
let word_of = pure (
  name: string,
  value: string,
  words: [](string, string)
) -> Result<string, string> => {
  let said = value.trim().split_when((c) => c == ' ').join(" ")
  for (word, made) in words {
    if word == said { return Ok(made) }
  }
  let all = [w in words | w.0]
  Err("${name.replace("_", "-")} is ${all.join(", ")}, not ${value}")
}

/// An overflow keyword as `ui.style`'s `Overflow`.
let overflow_of = pure (value: string) -> Result<string, string> => match value.trim() {
  "visible" => Ok("OverflowVisible"),
  "hidden" => Ok("OverflowHidden"),
  "clip" => Ok("OverflowClip"),
  "scroll" => Ok("OverflowScroll"),
  "auto" => Ok("OverflowAuto"),
  other => Err("overflow is visible, hidden, clip, scroll or auto, not ${other}"),
}

/// A whole number, as Lyra.
let integer = pure (value: string) -> Result<string, string> => {
  let Some(n) = value
    .trim()
    .parse_i64() else { return Err("${value} is not a whole number") }
  Ok("${n}")
}

/// `flex-basis`: `auto`, a length, or a percentage of the container.
let basis_of = pure (value: string) -> Result<string, string> => {
  let v = value.trim()
  if v == "auto" || v == "content" { return Ok("BasisAuto") }
  if let Some(part) = v.strip_suffix("%") {
    let n = number(part)?
    return Ok("BasisFraction(${n} / 100.0)")
  }
  Ok("BasisLength(${ui_number(v)?})")
}

/// CSS's `flex` shorthand: `none` (0 0 auto), `auto` (1 1 auto), or a grow, a shrink and a
/// basis — `flex: 1` is `1 1 0`.
let flex_shorthand = pure (value: string) -> Result<[]string, string> => {
  let parts = value.trim().split_when((c) => c == ' ')
  if parts.len() == 1 && parts[0] == "none" {
    return Ok(["grow: Some(0.0)", "shrink: Some(0.0)", "basis: Some(BasisAuto)"])
  }
  if parts.len() == 1 && parts[0] == "auto" {
    return Ok(["grow: Some(1.0)", "shrink: Some(1.0)", "basis: Some(BasisAuto)"])
  }
  if parts.len() == 0 || parts.len() > 3 {
    return Err("flex is none, auto, or a grow, a shrink and a basis, not ${value}")
  }
  let grow = number(parts[0])?
  let shrink = if parts.len() >= 2 { number(parts[1])? } else { "1.0" }
  let basis = if parts.len() == 3 { basis_of(parts[2])? } else { "BasisLength(0.0)" }
  Ok(["grow: Some(${grow})", "shrink: Some(${shrink})", "basis: Some(${basis})"])
}

/// A track list — `100 1fr auto min-content max-content minmax(100, 1fr) repeat(3, 1fr)` —
/// as Lyra's `[]Track`.
let track_list = pure (value: string) -> Result<string, string> => {
  let items = top_level(value.trim(), ' ')?
  var out: []string = []
  for item in items {
    if let Some(inner) = call_args(item, "repeat") {
      let args = top_level(inner, ',')?
      if args.len() != 2 { return Err("repeat is repeat(count, tracks), not ${item}") }
      let count = integer(args[0])?
      out.push("...repeat_tracks(${count}, ${track_list(args[1])?})")
    } else {
      out.push(one_track(item)?)
    }
  }
  Ok("[${out.join(", ")}]")
}

/// One track: a size, or `minmax(least, most)`.
let one_track = pure (value: string) -> Result<string, string> => {
  let v = value.trim()
  if let Some(inner) = call_args(v, "minmax") {
    let args = top_level(inner, ',')?
    if args.len() != 2 { return Err("minmax is minmax(least, most), not ${v}") }
    return Ok("minmax(${track_size(args[0])?}, ${track_size(args[1])?})")
  }
  match v {
    "auto" => Ok("auto_track()"),
    "min-content" => Ok("min_content()"),
    "max-content" => Ok("max_content()"),
    _ => {
      if let Some(share) = v.strip_suffix("fr") { return Ok("fr(${number(share)?})") }
      match ui_number(v) {
        Ok(n) => Ok("px(${n})"),
        Err(_) => Err("a track is a length, Nfr, auto, min-content, max-content, minmax(…) or repeat(…), not ${v}"),
      }
    },
  }
}

/// One bound of `minmax(…)`.
let track_size = pure (value: string) -> Result<string, string> => {
  let v = value.trim()
  match v {
    "auto" => Ok("TrackAuto"),
    "min-content" => Ok("TrackMinContent"),
    "max-content" => Ok("TrackMaxContent"),
    _ => {
      if let Some(share) = v.strip_suffix("fr") { return Ok("TrackFr(${number(share)?})") }
      Ok("TrackPx(${ui_number(v)?})")
    },
  }
}

/// `grid-column` and `grid-row`: `2`, `span 2`, `1 / 3` (lines), or `2 / span 3`.
let grid_line = pure (value: string) -> Result<string, string> => {
  let halves = [h in value.split("/") | h.trim()]
  let span_of = (text: string) -> Maybe<string> =>
    text.strip_prefix("span ").map((n) => n.trim())
  let bad = "grid lines are N, span N, N / M or N / span M, not ${value}"
  match halves.len() {
    1 => match span_of(halves[0]) {
      Some(n) => Ok("GridSpan { span: ${integer(n)?} }"),
      None => Ok("GridSpan { start: ${integer(halves[0])?} }"),
    },
    2 => {
      let start = halves[0].parse_i64() ?? 0
      if start < 1 { return Err(bad) }
      match span_of(halves[1]) {
        Some(n) => Ok("GridSpan { start: ${start}, span: ${integer(n)?} }"),
        None => {
          let end = halves[1].parse_i64() ?? 0
          if end <= start { return Err(bad) }
          Ok("GridSpan { start: ${start}, span: ${end - start} }")
        },
      }
    },
    _ => Err(bad),
  }
}

/// `text`'s arguments if it is a call to `name` (`repeat(3, 1fr)` → `3, 1fr`).
let call_args = pure (text: string, name: string) -> Maybe<string> => {
  let Some(rest) = text.strip_prefix("${name}(") else { return None }
  rest.strip_suffix(")")
}

/// `text` split at `by` outside parentheses, empty pieces dropped.
let top_level = pure (text: string, by: rune) -> Result<[]string, string> => {
  var out: []string = []
  var depth = 0
  var piece = ""
  for c in text {
    if c == '(' { depth += 1 }
    if c == ')' {
      depth -= 1
      if depth < 0 { return Err("unbalanced ) in ${text}") }
    }
    if c == by && depth == 0 {
      if piece.trim().len() > 0 { out.push(piece.trim()) }
      piece = ""
    } else {
      piece = "${piece}${c}"
    }
  }
  if depth != 0 { return Err("unbalanced ( in ${text}") }
  if piece.trim().len() > 0 { out.push(piece.trim()) }
  Ok(out)
}

/// The identifiers in `code`, in order.
let identifiers = pure (code: string) -> []string => {
  var out: []string = []
  var word = ""
  for c in code {
    if c.is_ascii_alpha() || c.is_ascii_digit() || c == '_' {
      word = "${word}${c}"
    } else {
      if word.len() > 0 { out.push(word) }
      word = ""
    }
  }
  if word.len() > 0 { out.push(word) }
  out
}

let main_align = pure (word: string) -> Result<string, string> => match word {
  "start" => Ok("MainStart"),
  "center" => Ok("MainCenter"),
  "end" => Ok("MainEnd"),
  "between" => Ok("SpaceBetween"),
  "around" => Ok("SpaceAround"),
  "evenly" => Ok("SpaceEvenly"),
  _ => Err("main is start, center, end, between, around or evenly, not ${word}"),
}

let cross_align = pure (word: string) -> Result<string, string> => match word {
  "start" => Ok("CrossStart"),
  "center" => Ok("CrossCenter"),
  "end" => Ok("CrossEnd"),
  "stretch" => Ok("CrossStretch"),
  _ => Err("cross is start, center, end or stretch, not ${word}"),
}

/// `at="top-left"` and its kin as an `Alignment`.
let alignment = pure (word: string) -> Result<string, string> => {
  let (x, y) = match word {
    "top-left" => ("0.0", "0.0"),
    "top" => ("0.5", "0.0"),
    "top-right" => ("1.0", "0.0"),
    "left" => ("0.0", "0.5"),
    "center" => ("0.5", "0.5"),
    "right" => ("1.0", "0.5"),
    "bottom-left" => ("0.0", "1.0"),
    "bottom" => ("0.5", "1.0"),
    "bottom-right" => ("1.0", "1.0"),
    _ => return Err("at is center, top, bottom, left, right or a corner (top-left…), not ${word}"),
  }
  Ok("Alignment { x: ${x}, y: ${y} }")
}

/// The theme parameter's name for a sheet of `rules`: `t` when a rule reads a `$token`, `_`
/// when none does.
let theme_param = pure (rules: []Rule) -> string =>
  if rules.any((r) => r.body.contains("$")) { "t" } else { "_" }

/// `color: $colors.accent; padding: 8 4` as `ui.style` `Style` fields. A `$path` reads the
/// theme (`$space.m` is `t.space.m`) where `tokens` allows it — a sheet's rules, not an
/// element's inline style, which has no theme to read.
let ui_declarations = pure (
  text: string,
  line: i64,
  tokens: bool
) -> Result<[]string, string> => {
  var fields: []string = []
  // `transition` and its longhands, put together once every declaration is read: the lists
  // pair up by place, a shorter one repeated, as CSS does.
  var moves = Moves {}
  for d in text.split(";") {
    if d.trim().len() == 0 { continue }
    let Some(colon) = d.index(":") else { return Err("${line}: \"${d.trim()}\" has no `:`") }
    let name = d.slice(0, colon).trim().replace("-", "_")
    let given = d.slice(colon + 1, d.len()).trim()
    if given.contains("$") && !tokens {
      return Err("${line}: ${given} reads the theme, which an inline style cannot; give the element a class and the rule to a <style>")
    }
    if name.starts_with("transition") {
      moves = moves.taking(name, given).map_err((why) => "${line}: ${why}")?
      continue
    }
    let field = match name {
      "rounding" => "radius",
      "border_radius" => "radius",
      other => other,
    }
    // Two to four radii, in CSS's order, round each corner: `corners`.
    if field == "radius" && given.split(" ").filter((w) => w.len() > 0).len() > 1 {
      fields = with_field(
        fields,
        "corners: Some(${corners_of(given).map_err((what) => "${line}: ${what}")?})"
      )
      continue
    }
    let set_by = effect_declaration(name, given).or(layout_declaration(name, given))
    if let Some(set) = set_by {
      match set {
        Ok(more) => { for f in more { fields = with_field(fields, f) } },
        Err(what) => return Err("${line}: ${what}"),
      }
      continue
    }
    let lyra: Result<string, string> = match name {
      "color" => ui_color(given),
      "background" => ui_color(given),
      "border_color" => ui_color(given),
      "border_width" => ui_number(given),
      "radius" => ui_number(given),
      "rounding" => ui_number(given),
      "border_radius" => ui_number(given),
      "opacity" => ui_number(given),
      "font_size" => ui_number(given),
      "line_height" => ui_number(given),
      "padding" => ui_padding(given),
      _ => Err("no style property ${name} in ui (color, background, border-color, border-width, radius (one to four numbers, as border-radius), gap, opacity, font-size, line-height, padding; transition and transition-property, -duration, -timing-function, -delay; overflow (one or two of visible, hidden, clip, scroll, auto), overflow-x, overflow-y; box-shadow, a gradient background or background-image, filter: blur(), backdrop-filter: blur(); width, height and their min- and max-; row-gap, column-gap; flex, flex-direction, flex-wrap, flex-grow, flex-shrink, flex-basis, order, justify-content, align-content, align-items, align-self; grid-template-columns, grid-template-rows, grid-auto-columns, grid-auto-rows, grid-auto-flow, grid-column, grid-row, justify-items, justify-self)"),
    }
    match lyra {
      Ok(v) => { fields = with_field(fields, "${field}: Some(${v})") },
      Err(what) => return Err("${line}: ${what}"),
    }
  }
  if moves.given { fields = with_field(fields, "transition: Some(${moves.as_lyra()})") }
  Ok(fields)
}

/// `border-radius`'s two to four radii as each corner's, in CSS's order: top-left and
/// bottom-right then the other two; top-left, those two, bottom-right; or each from the top
/// left round.
let corners_of = pure (value: string) -> Result<string, string> => {
  let words = value.split(" ").filter((w) => w.len() > 0)
  var n: []string = []
  for w in words { n.push(ui_number(w)?) }
  let (tl, tr, br, bl) = match n.len() {
    2 => (n[0], n[1], n[0], n[1]),
    3 => (n[0], n[1], n[2], n[1]),
    4 => (n[0], n[1], n[2], n[3]),
    _ => return Err("a radius is one to four numbers, not ${value}"),
  }
  Ok("Radii { top_left: ${tl}, top_right: ${tr}, bottom_right: ${br}, bottom_left: ${bl} }")
}

/// A rule's `transition` declarations so far: the properties, durations, timing functions
/// and delays, each a list in Lyra, and whether any was given.
struct Moves {
  properties: []string = [],
  durations: []string = [],
  timings: []string = [],
  delays: []string = [],
  given: bool = false,
}

impl Moves {
  /// These with declaration `name` (`transition` or a longhand, its `-` made `_`) read.
  let taking = pure (self, name: string, value: string) -> Result<Moves, string> => {
    let items = top_level(value, ',')?
    match name {
      "transition" => {
        var out = Moves { given: true }
        if value == "none" { return Ok(out) }
        for item in items {
          let one = transition_of(item)?
          out.properties.push(one.0)
          out.durations.push(one.1)
          out.timings.push(one.2)
          out.delays.push(one.3)
        }
        Ok(out)
      },
      "transition_property" => {
        var names: []string = []
        if value != "none" { for item in items { names.push(transition_property(item)?) } }
        Ok(Moves { self | properties: names, given: true })
      },
      "transition_duration" =>
        Ok(Moves { self | durations: [item in items | time_of("transition-duration", item)?], given: true }),
      "transition_timing_function" =>
        Ok(Moves { self | timings: [item in items | timing_of(item)?], given: true }),
      "transition_delay" =>
        Ok(Moves { self | delays: [item in items | time_of("transition-delay", item)?], given: true }),
      _ => Err("no style property ${name.replace("_", "-")} in ui; a transition is transition, transition-property, transition-duration, transition-timing-function or transition-delay"),
    }
  }

  /// The transitions as a Lyra `[]Transition`: one a property, the other lists repeated.
  let as_lyra = pure (self) -> string => {
    var each: []string = []
    for i, property in self.properties {
      let duration = pick(self.durations, i, "0.0")
      let timing = pick(self.timings, i, "TimingEase")
      let delay = pick(self.delays, i, "0.0")
      each.push("Transition { property: \"${property}\", duration: ${duration}, timing: ${timing}, delay: ${delay} }")
    }
    "[${each.join(", ")}]"
  }
}

/// The `i`th of `list`, repeated from its start when it is shorter — `default` when empty.
let pick = pure (list: []string, i: i64, default: string) -> string =>
  if list.len() == 0 { default } else { list[i % list.len()] }

/// One transition of a `transition` list — `[property] duration [timing-function] [delay]`
/// in any order, the first time its duration and the second its delay — as its property and
/// the Lyra for the others.
let transition_of = pure (item: string) -> Result<(
  string,
  string,
  string,
  string
), string> => {
  var property = "all"
  var named = false
  var times: []string = []
  var timing = "TimingEase"
  var timed = false
  for word in top_level(item, ' ')? {
    if is_time(word) {
      if times.len() == 2 { return Err("a transition is [property] duration [timing-function] [delay], not ${item}") }
      times.push(time_of("transition", word)?)
    } else if is_timing(word) {
      if timed { return Err("a transition has one timing function, not two in ${item}") }
      timing = timing_of(word)?
      timed = true
    } else if decimal(word).is_some() {
      return Err("a transition's duration and delay are times, Nms or Ns, not ${word}")
    } else {
      if named { return Err("a transition is [property] duration [timing-function] [delay], not ${item}") }
      property = transition_property(word)?
      named = true
    }
  }
  let duration = if times.len() > 0 { times[0] } else { "0.0" }
  let delay = if times.len() > 1 { times[1] } else { "0.0" }
  Ok((property, duration, timing, delay))
}

/// The properties a transition may name, by their CSS names (`ui.motion`'s, and lui's own
/// `radius` for `border-radius`), as `ui.motion` names them.
let transition_property = pure (word: string) -> Result<string, string> => {
  let name = match word {
    "radius" => "border-radius",
    "rounding" => "border-radius",
    other => other,
  }
  if TRANSITIONED.any((p) => p == name) { return Ok(name) }
  Err("transition-property is all or a property that animates (${TRANSITIONED.join(", ")}), not ${word}")
}

/// What a transition may name: every property, `background` for its colour and image, and
/// each property that animates.
const TRANSITIONED = [
  "all",
  "background",
  "opacity",
  "color",
  "background-color",
  "border-color",
  "border-radius",
  "box-shadow",
  "background-image",
  "filter",
  "backdrop-filter",
  "padding",
  "gap",
  "row-gap",
  "column-gap",
  "width",
  "height",
  "min-width",
  "max-width",
  "min-height",
  "max-height",
  "border-width",
]

/// Whether `word` is a time: a number and `ms` or `s`.
let is_time = pure (word: string) -> bool =>
  (word.ends_with("ms") || word.ends_with("s")) && word.len() > 1 &&
  (word[0] >= '0' && word[0] <= '9' || word[0] == '.' || word[0] == '-')

/// A time — `200ms`, `0.3s`, `.3s`, or `0` — in milliseconds, an `f32` literal.
let time_of = pure (name: string, word: string) -> Result<string, string> => {
  let bad = "${name} is a time, Nms or Ns, not ${word}"
  if word == "0" { return Ok("0.0") }
  var digits = ""
  var scale = 1.0
  if let Some(ms) = word.strip_suffix("ms") {
    digits = ms
  } else if let Some(sec) = word.strip_suffix("s") {
    digits = sec
    scale = 1000.0
  } else {
    return Err(bad)
  }
  let Some(n) = decimal(digits) else { return Err(bad) }
  if n < 0.0 { return Err(bad) }
  // Thousandths of a millisecond, so `0.3s` is `300.0` rather than its nearest double.
  let fine = (n * scale * 1000.0).round()
  Ok(if fine % 1000 == 0 { "${fine / 1000}.0" } else { "${f64(fine) / 1000.0}" })
}

/// `text` as a number — digits with at most one point, a leading `-` allowed — or `None`.
let decimal = pure (text: string) -> Maybe<f64> => {
  var whole = 0.0
  var scale = 1.0
  var pointed = false
  var digits = 0
  var sign = 1.0
  for i, c in text {
    if c == '-' && i == 0 {
      sign = -1.0
    } else if c == '.' && !pointed {
      pointed = true
    } else if c >= '0' && c <= '9' {
      let d = f64(i64(c) - i64('0'))
      if !pointed { whole = whole * 10.0 + d } else {
        scale = scale / 10.0
        whole += d * scale
      }
      digits += 1
    } else {
      return None
    }
  }
  if digits == 0 { None } else { Some(sign * whole) }
}

/// Whether `word` is a timing function's name or call.
let is_timing = pure (word: string) -> bool =>
  [
    "ease",
    "linear",
    "ease-in",
    "ease-out",
    "ease-in-out",
    "step-start",
    "step-end"
  ].any((n) => n == word) ||
  word.starts_with("cubic-bezier(") || word.starts_with("steps(")

/// A timing function as `ui.style`'s `Timing`.
let timing_of = pure (word: string) -> Result<string, string> => {
  let bad = "transition-timing-function is ease, linear, ease-in, ease-out, ease-in-out, cubic-bezier(x1, y1, x2, y2) or steps(n[, jump-start|jump-end]), not ${word}"
  match word {
    "ease" => return Ok("TimingEase"),
    "linear" => return Ok("TimingLinear"),
    "ease-in" => return Ok("TimingEaseIn"),
    "ease-out" => return Ok("TimingEaseOut"),
    "ease-in-out" => return Ok("TimingEaseInOut"),
    "step-start" => return Ok("TimingSteps(1, true)"),
    "step-end" => return Ok("TimingSteps(1, false)"),
    _ => {},
  }
  if let Some(inside) = call_args(word, "cubic-bezier") {
    let parts = top_level(inside, ',')?
    if parts.len() != 4 { return Err(bad) }
    var n: []string = []
    for part in parts { n.push(number(part).map_err((_) => bad)?) }
    for i in [0, 2] {
      let x = decimal(parts[i]) ?? -1.0
      if x < 0.0 || x > 1.0 { return Err("cubic-bezier's x1 and x2 are 0 to 1, not ${parts[i]} in ${word}") }
    }
    return Ok("TimingBezier(${n.join(", ")})")
  }
  if let Some(inside) = call_args(word, "steps") {
    let parts = top_level(inside, ',')?
    let Some(count) = parts[0].parse_i64() else { return Err(bad) }
    if count < 1 { return Err("steps(n) takes one step or more, not ${parts[0]}") }
    let start = if parts.len() == 1 { false } else {
      match parts[1] {
        "jump-start" => true,
        "start" => true,
        "jump-end" => false,
        "end" => false,
        _ => return Err(bad),
      }
    }
    if parts.len() > 2 { return Err(bad) }
    return Ok("TimingSteps(${count}, ${start})")
  }
  Err(bad)
}

/// `fields` with `field` (`name: value`) set: an earlier value of the same field dropped, as a
/// later declaration wins in CSS.
let with_field = pure (fields: []string, field: string) -> []string => {
  let name = field.slice(0, field.index(":") ?? field.len())
  [...[f in fields | !f.starts_with("${name}:") | f], field]
}

/// The `ui.style` fields an effect declaration sets — `box-shadow`, a gradient `background`
/// or `background-image`, `filter` and `backdrop-filter` — or `None` for a name that is not one
/// (or a `background` that is a plain colour).
let effect_declaration = pure (
  name: string,
  value: string
) -> Maybe<Result<[]string, string>> => {
  let v = value.trim()
  let one = (
    field: string,
    made: Result<string, string>
  ) -> Maybe<Result<[]string, string>> =>
    Some(made.map((x) => ["${field}: Some(${x})"]))
  match name {
    "box_shadow" => one("box_shadow", shadow_list(v)),
    "background" =>
      if is_gradient(v) { one("background_gradient", gradient_of(v)) } else { None },
    "background_image" => one("background_gradient", gradient_of(v)),
    "filter" => one("filter_blur", blur_of("filter", v)),
    "backdrop_filter" => one("backdrop_blur", blur_of("backdrop-filter", v)),
    _ => None,
  }
}

let is_gradient = pure (value: string) -> bool =>
  value.starts_with("linear-gradient(") || value.starts_with("radial-gradient(")

/// `box-shadow`: `none`, or shadows a comma apart, each `[inset] x y [blur [spread]] colour`.
let shadow_list = pure (value: string) -> Result<string, string> => {
  if value == "none" { return Ok("[]") }
  var each: []string = []
  for one in top_level(value, ',')? {
    var lengths: []string = []
    var color = ""
    var inset = false
    for word in top_level(one, ' ')? {
      if word == "inset" {
        inset = true
      } else if word.starts_with("#") || word.starts_with("$") || word.contains("(") {
        if color.len() > 0 { return Err("a box-shadow has one colour, not ${one}") }
        color = ui_color(word)?
      } else {
        let n = word.strip_suffix("px") ?? word
        match number(n) {
          Ok(x) => lengths.push(x),
          Err(_) =>
            return Err("a box-shadow is [inset] x y [blur [spread]] #colour, not ${one}"),
        }
      }
    }
    if lengths.len() < 2 || lengths.len() > 4 || color.len() == 0 {
      return Err("a box-shadow is [inset] x y [blur [spread]] #colour, not ${one}")
    }
    let blur = if lengths.len() > 2 { lengths[2] } else { "0.0" }
    if blur.starts_with("-") { return Err("a box-shadow's blur is not negative: ${one}") }
    let spread = if lengths.len() > 3 { lengths[3] } else { "0.0" }
    each.push("BoxShadow { x: ${lengths[0]}, y: ${lengths[1]}, blur: ${blur}, spread: ${spread}, color: ${color}${if inset { ", inset: true" } else { "" }} }")
  }
  Ok("[${each.join(", ")}]")
}

/// `linear-gradient([angle | to side], stops…)` or `radial-gradient([circle | ellipse],
/// stops…)`, each stop `#colour [N%]`.
let gradient_of = pure (value: string) -> Result<string, string> => {
  var kind = "linear"
  var inner = ""
  if let Some(args) = call_args(value, "linear-gradient") {
    inner = args
  } else if let Some(args) = call_args(value, "radial-gradient") {
    kind = "radial"
    inner = args
  } else {
    return Err("a gradient is linear-gradient(…) or radial-gradient(…), not ${value}")
  }
  var parts = top_level(inner, ',')?
  var made = if kind == "linear" { "LinearGradient(180.0)" } else { "RadialGradient(false)" }
  if parts.len() > 0 {
    let first = parts[0].trim()
    let direction = if kind == "linear" { linear_direction(first) } else { radial_shape(first) }
    if let Some(d) = direction {
      made = d?
      parts = parts.slice(1, parts.len())
    }
  }
  if parts.len() < 2 { return Err("a gradient needs two colour stops or more: ${value}") }
  var stops: []string = []
  for part in parts {
    // Words outside parentheses: an `oklch(…)` is one.
    let words = top_level(part.trim(), ' ')?
    if words.len() == 0 || words.len() > 2 { return Err("a colour stop is #colour [N%], not ${part.trim()}") }
    let color = ui_color(words[0])?
    if words.len() == 1 {
      stops.push("ColorStop { color: ${color} }")
    } else {
      let Some(pct) = words[1].strip_suffix("%") else {
        return Err("a colour stop's place is a percentage, not ${words[1]}")
      }
      stops.push("ColorStop { color: ${color}, at: Some(${number(pct)?} / 100.0) }")
    }
  }
  Ok("Gradient { kind: ${made}, stops: [${stops.join(", ")}] }")
}

/// A linear gradient's first argument, if it is a direction: an angle (`90deg`) or `to` a side
/// or corner — a corner taken as 45° between its sides.
let linear_direction = pure (word: string) -> Maybe<Result<string, string>> => {
  if let Some(deg) = word.strip_suffix("deg") {
    return Some(number(deg.trim()).map((n) => "LinearGradient(${n})"))
  }
  let Some(side) = word.strip_prefix("to ") else { return None }
  let degrees = match side.trim() {
    "top" => "0.0",
    "top right" => "45.0",
    "right top" => "45.0",
    "right" => "90.0",
    "bottom right" => "135.0",
    "right bottom" => "135.0",
    "bottom" => "180.0",
    "bottom left" => "225.0",
    "left bottom" => "225.0",
    "left" => "270.0",
    "top left" => "315.0",
    "left top" => "315.0",
    other => return Some(Err("a gradient goes to top, right, bottom, left or a corner, not to ${other}")),
  }
  Some(Ok("LinearGradient(${degrees})"))
}

/// A radial gradient's first argument, if it is its shape.
let radial_shape = pure (word: string) -> Maybe<Result<string, string>> => match word {
  "circle" => Some(Ok("RadialGradient(true)")),
  "ellipse" => Some(Ok("RadialGradient(false)")),
  _ => None,
}

/// `filter` and `backdrop-filter`: `none` or `blur(N)`.
let blur_of = pure (name: string, value: string) -> Result<string, string> => {
  if value == "none" { return Ok("0.0") }
  let Some(inside) = call_args(value, "blur") else {
    return Err("${name} is blur(N) or none, not ${value}")
  }
  let n = inside.trim().strip_suffix("px") ?? inside.trim()
  number(n).map_err((_) => "${name} is blur(N) or none, not ${value}")
}

/// A token `$a.b` as the theme's `t.a.b`, if `value` is one.
let token = pure (value: string) -> Maybe<Result<string, string>> => {
  let Some(path) = value.strip_prefix("$") else { return None }
  let fine = path.len() > 0 && path
    .to_runes()
    .all((c) => c.is_ascii_alpha() || c.is_ascii_digit() || c == '_' || c == '.')
  if !fine { return Some(Err("${value} is not a token: $name or $name.field")) }
  Some(Ok("t.${path}"))
}

/// A colour as CSS Color 4 writes it — `#rgb`, `#rrggbb`, `#rrggbbaa`, `rgb(…)`, `oklab(…)`,
/// `oklch(…)` (`ui.color`'s `parse_color`, which maps one outside sRGB into it) — or a `$token`,
/// as a `Color`: read here, written as its sRGB (`rgb(0x…)`, `rgba(0x…)` when translucent).
let ui_color = pure (value: string) -> Result<string, string> => {
  if let Some(read) = token(value) { return read }
  let Some(c) = parse_color(value) else {
    return Err("${value} is not a colour: #rgb, #rrggbb, #rrggbbaa, rgb(…), oklab(…), oklch(…) or a $token")
  }
  let text = color_text(c)
  let hex = text.slice(1, text.len()).to_ascii_upper()
  Ok(if c.a == 255 { "rgb(0x${hex})" } else { "rgba(0x${hex})" })
}

/// A number or a `$token`, an `f32`.
let ui_number = pure (value: string) -> Result<string, string> => {
  if let Some(read) = token(value) { return read }
  number(value)
}

/// Padding: one value all round, two (across, then down), or four (top, right, bottom, left,
/// as CSS has them) — numbers or `$tokens`.
let ui_padding = pure (value: string) -> Result<string, string> => {
  let parts = value.split_when((c) => c == ' ')
  var vs: []string = []
  for p in parts { vs.push(ui_number(p)?) }
  match vs.len() {
    1 => Ok("insets(${vs[0]})"),
    2 => Ok("insets_xy(${vs[0]}, ${vs[1]})"),
    4 =>
      Ok("Insets { top: ${vs[0]}, right: ${vs[1]}, bottom: ${vs[2]}, left: ${vs[3]} }"),
    _ => Err("padding is one, two or four values, not ${value}"),
  }
}

// ── The elements ─────────────────────────────────────────────────────────────

/// What a tag of `bindings.imgui.ui` takes: its attributes struct, the field its text
/// fills, its attributes, the ones it needs, and whether it holds children.
struct Kind {
  attrs_struct: string,
  text_field: string,
  attrs: []Field,
  required: []string,
  holds: bool,
}

struct Field {
  name: string,
  kind: FieldKind,
}

/// How an attribute is written: a string (quoted, `{…}` interpolated), any Lyra
/// (`{…}`), a `Maybe` of one (`{x}` is `Some(x)`), a flag (bare is true), a shortcut
/// (`"Cmd+Shift+S"`) or a style (`"rounding: 4"`).
/// A `Changes` attribute is `on_change`: a function of the new value, of the type named; a
/// bare name (a constructor, a function) becomes the lambda calling it.
data FieldKind = Str | Any | MaybeOf | Flag | Keys | Looks | Changes(string)

let element_kind = pure (tag: string) -> Maybe<Kind> => {
  let class = Field { name: "class", kind: Str }
  let style = Field { name: "style", kind: Looks }
  let enabled = Field { name: "enabled", kind: Flag }
  let id = Field { name: "id", kind: Str }
  match tag {
    "Window" => Some(Kind {
      attrs_struct: "WindowAttrs",
      text_field: "",
      attrs: [
        Field { name: "title", kind: Str },
        Field { name: "on_close", kind: MaybeOf },
        Field { name: "flags", kind: Any },
        Field { name: "centered", kind: Flag },
        class,
        style,
      ],
      required: ["title"],
      holds: true,
    }),
    "MainMenuBar" => Some(container()),
    "MenuBar" => Some(container()),
    "Row" => Some(Kind {
      attrs_struct: "RowAttrs",
      text_field: "",
      attrs: [Field { name: "wrap", kind: Flag }, class, style],
      required: [],
      holds: true,
    }),
    "Group" => Some(Kind {
      attrs_struct: "GroupAttrs",
      text_field: "",
      attrs: [class, style],
      required: [],
      holds: true,
    }),
    "Space" => Some(Kind {
      attrs_struct: "SpaceAttrs",
      text_field: "",
      attrs: [Field { name: "width", kind: Any }, Field { name: "height", kind: Any }],
      required: [],
      holds: false,
    }),
    "Fragment" => Some(container()),
    "Menu" => Some(Kind {
      attrs_struct: "MenuAttrs",
      text_field: "",
      attrs: [Field { name: "label", kind: Str }, enabled, class, style],
      required: ["label"],
      holds: true,
    }),
    "MenuItem" => Some(Kind {
      attrs_struct: "MenuItemAttrs",
      text_field: "label",
      attrs: [
        Field { name: "on_select", kind: Any },
        Field { name: "id", kind: Str },
        Field { name: "shortcut", kind: Keys },
        Field { name: "checked", kind: Flag },
        enabled,
        class,
        style,
      ],
      required: ["label", "on_select"],
      holds: false,
    }),
    "Button" => Some(Kind {
      attrs_struct: "ButtonAttrs",
      text_field: "label",
      attrs: [
        Field { name: "on_click", kind: Any },
        enabled,
        Field { name: "closes", kind: Flag },
        id,
        class,
        style,
      ],
      required: ["label", "on_click"],
      holds: false,
    }),
    "Checkbox" => Some(Kind {
      attrs_struct: "CheckboxAttrs",
      text_field: "label",
      attrs: [
        Field { name: "checked", kind: Flag },
        Field { name: "on_toggle", kind: Any },
        enabled,
        id,
        class,
        style,
      ],
      required: ["label", "checked", "on_toggle"],
      holds: false,
    }),
    "Combo" => Some(Kind {
      attrs_struct: "ComboAttrs",
      text_field: "",
      attrs: [Field { name: "label", kind: Str }, Field { name: "preview", kind: Str }, id, class, style],
      required: ["label", "preview"],
      holds: true,
    }),
    "Selectable" => Some(Kind {
      attrs_struct: "SelectableAttrs",
      text_field: "label",
      attrs: [Field { name: "selected", kind: Flag }, Field { name: "on_select", kind: Any }, id, class, style],
      required: ["label", "on_select"],
      holds: false,
    }),
    "Radio" => Some(Kind {
      attrs_struct: "RadioAttrs",
      text_field: "label",
      attrs: [Field { name: "selected", kind: Flag }, Field { name: "on_select", kind: Any }, id, enabled, class, style],
      required: ["label", "on_select"],
      holds: false,
    }),
    "InputInt" => Some(Kind {
      attrs_struct: "InputIntAttrs",
      text_field: "",
      attrs: [
        Field { name: "label", kind: Str },
        Field { name: "value", kind: Any },
        Field { name: "step", kind: Any },
        Field { name: "on_change", kind: Changes("i64") },
        Field { name: "on_commit", kind: MaybeOf },
        id,
        enabled,
        class,
        style,
      ],
      required: ["label", "value", "on_change"],
      holds: false,
    }),
    "InputText" => Some(Kind {
      attrs_struct: "InputTextAttrs",
      text_field: "",
      attrs: [
        Field { name: "label", kind: Str },
        Field { name: "value", kind: Str },
        Field { name: "hint", kind: Str },
        Field { name: "on_change", kind: Changes("string") },
        Field { name: "on_commit", kind: MaybeOf },
        id,
        enabled,
        class,
        style,
      ],
      required: ["label", "value", "on_change"],
      holds: false,
    }),
    "Slider" => Some(Kind {
      attrs_struct: "SliderAttrs",
      text_field: "",
      attrs: [
        Field { name: "label", kind: Str },
        Field { name: "value", kind: Any },
        Field { name: "min", kind: Any },
        Field { name: "max", kind: Any },
        Field { name: "format", kind: Str },
        Field { name: "on_change", kind: Changes("f32") },
        Field { name: "on_commit", kind: MaybeOf },
        id,
        enabled,
        class,
        style,
      ],
      required: ["label", "value", "min", "max", "on_change"],
      holds: false,
    }),
    "ColorEdit" => Some(Kind {
      attrs_struct: "ColorEditAttrs",
      text_field: "",
      attrs: [
        Field { name: "label", kind: Str },
        Field { name: "value", kind: Any },
        Field { name: "inputs", kind: Flag },
        Field { name: "on_change", kind: Changes("u32") },
        Field { name: "on_commit", kind: MaybeOf },
        id,
        enabled,
        class,
        style,
      ],
      required: ["label", "value", "on_change"],
      holds: false,
    }),
    "Modal" => Some(Kind {
      attrs_struct: "ModalAttrs",
      text_field: "",
      attrs: [
        Field { name: "title", kind: Str },
        Field { name: "flags", kind: Any },
        Field { name: "on_escape", kind: MaybeOf },
        class,
        style,
      ],
      required: ["title"],
      holds: true,
    }),
    "Form" => Some(Kind {
      attrs_struct: "FormAttrs",
      text_field: "",
      attrs: [class, style],
      required: [],
      holds: true,
    }),
    "Field" => Some(Kind {
      attrs_struct: "FieldAttrs",
      text_field: "",
      attrs: [Field { name: "label", kind: Str }, class, style],
      required: ["label"],
      holds: true,
    }),
    "Text" => Some(Kind {
      attrs_struct: "TextAttrs",
      text_field: "text",
      attrs: [Field { name: "disabled", kind: Flag }, Field { name: "wrapped", kind: Flag }, class, style],
      required: ["text"],
      holds: false,
    }),
    "Separator" => Some(Kind { attrs_struct: "", text_field: "", attrs: [], required: [], holds: false }),
    "SeparatorText" => Some(Kind { attrs_struct: "", text_field: "label", attrs: [], required: [], holds: false }),
    _ => None,
  }
}

/// A tag that only holds children: `<Row>`, `<MainMenuBar>`.
let container = pure () -> Kind =>
  Kind { attrs_struct: "", text_field: "", attrs: [], required: [], holds: true }

/// `"Cmd+Shift+S"` as a `Shortcut`: the primary modifier (Cmd or Ctrl, whichever the
/// platform has; either may be written), Alt, Shift, and one key — a character, or `PgUp`
/// or `PgDn`. The primary modifier is held unless Alt is written without it (`Alt+1`).
let shortcut = pure (text: string) -> Result<string, string> => {
  var shift = false
  var alt = false
  var primary = false
  var key = ""
  let parts = text.split("+")
  for i, part in parts {
    let p = part.trim().to_ascii_lower()
    if i < parts.len() - 1 {
      match p {
        "cmd" => { primary = true },
        "ctrl" => { primary = true },
        "alt" => { alt = true },
        "shift" => { shift = true },
        _ => { return Err("${part} is not Cmd, Ctrl, Alt or Shift") },
      }
    } else {
      key = part.trim()
    }
  }
  // `Cmd++`: the key is the last `+`, which split leaves empty.
  if key.len() == 0 && text.ends_with("+") { key = "+" }
  var named = ""
  for k in NAMED_KEYS {
    if k.to_ascii_lower() == key.to_ascii_lower() { named = k }
  }
  if named.len() > 0 {
    key = named
  } else if key.len() == 1 {
    key = key.to_ascii_lower()
  } else {
    return Err("a shortcut's key is one character, PgUp or PgDn, not \"${key}\"")
  }
  let with_shift = if shift { ", shift: true" } else { "" }
  let with_alt = if alt { ", alt: true" } else { "" }
  let without_primary = if alt && !primary { ", primary: false" } else { "" }
  Ok("Some(Shortcut { key: ${quote(key)}${with_shift}${with_alt}${without_primary} })")
}

/// The keys a shortcut names rather than types.
const NAMED_KEYS = ["PgUp", "PgDn"]

/// A swatch's or a picker's `opaque` — bare, or `{condition}` — as the `alpha` argument it
/// stands against; nothing where it is not written.
let opaque_arg = pure (t: Tag) -> Result<string, string> =>
  match attr_named(t.attrs, "opaque") {
    None => Ok(""),
    Some(a) => match a.value {
      Bare => Ok(", false"),
      Braced(code) => Ok(", !(${code})"),
      Quoted(_) => Err("${a.line}: opaque is bare or {condition}"),
    },
  }

/// `F1` to `F24`'s number.
let function_number = pure (key: string) -> Maybe<i64> => {
  let Some(digits) = key.to_ascii_lower().strip_prefix("f") else { return None }
  let Some(n) = digits.parse_i64() else { return None }
  if n >= 1 && n <= 24 { Some(n) } else { None }
}

/// One character as a Lyra rune literal.
let rune_literal = pure (c: string) -> string =>
  if c == "'" || c == "\\" { "'\\${c}'" } else { "'${c}'" }

// ── Styles ───────────────────────────────────────────────────────────────────

/// A `<style>`'s rules — `Button.danger, .note { … }`, `/* … */` comments between, and
/// `@media (min-width: 600) { … }` blocks of them — each at the markup line its selector
/// starts on; `line` is the `<style>`'s, its text starting on it. A selector list is a rule
/// for each selector, each checked to be one ui reads.
let read_style = pure (raw: string, line: i64) -> Result<[]Rule, string> =>
  read_rules(strip_comments_kept(raw), line, "")

/// The rules of `text` (comments gone), its first line `line`, inside `media` (`""` for
/// none).
let read_rules = pure (
  text: string,
  line: i64,
  media: string
) -> Result<[]Rule, string> => {
  var rules: []Rule = []
  var from = 0
  loop {
    let rest = text.slice(from, text.len())
    let Some(open) = rest.index("{") else {
      if rest.trim().len() > 0 {
        return Err("${line + lines_before(text, from)}: \"${rest.trim()}\" in <style> is no rule")
      }
      break
    }
    let head = rest.slice(0, open)
    // The rule's line: where its selector's first character is.
    let lead = head.len() - head.trim_start().len()
    let at = line + lines_before(text, from + lead)
    if let Some(query) = head.trim().strip_prefix("@media") {
      if media.len() > 0 { return Err("${at}: an @media inside an @media") }
      let Some(close) = matching_brace(rest, open) else {
        return Err("${at}: an @media in <style> is never closed")
      }
      let conditions = media_query(query.trim()).map_err((what) => "${at}: ${what}")?
      let inner_line = line + lines_before(text, from + open + 1)
      for r in read_rules(
        rest.slice(open + 1, close),
        inner_line,
        conditions
      )? { rules.push(r) }
      from += close + 1
      continue
    }
    if head.trim().starts_with("@") {
      return Err("${at}: ${head.trim().split(" ")[0]} is not an at-rule of a <style>; @media is")
    }
    let Some(close) = rest.index("}", open) else {
      return Err("${at}: a rule in <style> is never closed")
    }
    let body = rest.slice(open + 1, close)
    var offset = 0
    for selector in head.split(",") {
      let s = selector.trim()
      let here = line + lines_before(
        text,
        from + offset + selector.len() - selector.trim_start().len()
      )
      offset += selector.len() + 1
      if s.len() == 0 { return Err("${at}: a rule in <style> with no selector") }
      if let Some(why) = selector_problem(s) { return Err("${here}: ${why}") }
      rules.push(Rule { selector: s, body: body, line: here, media: media })
    }
    from += close + 1
  }
  Ok(rules)
}

/// Where the `}` closing the `{` at `open` in `text` is.
let matching_brace = pure (text: string, open: i64) -> Maybe<i64> => {
  var depth = 0
  for i, c in text {
    if i < open { continue }
    if c == '{' { depth += 1 }
    if c == '}' {
      depth -= 1
      if depth == 0 { return Some(i) }
    }
  }
  None
}

/// Why `selector` is not one a sheet reads, if it is not: a compound — `Tag`, `.class`,
/// `Tag.class`, more classes, and pseudo-classes among them (`Button.primary:hover`) — or a
/// part, `Comp::part` with classes and pseudo-classes on the component (`Comp.big:hover::part`)
/// and pseudo-classes on the part (`Comp::part:focus`).
let selector_problem = pure (selector: string) -> Maybe<string> => {
  let usage = "${selector} is not a selector ui reads: Tag, .class, Tag.class (more classes allowed), each with pseudo-classes (Button:hover), Comp::part, Comp.class::part or Comp::part:hover"
  let halves = selector.split("::")
  if halves.len() > 2 { return Some(usage) }
  let head = pieces(halves[0])
  if head.len() == 0 { return Some(usage) }
  for i, piece in head {
    if i == 0 && !piece.starts_with(".") && !piece.starts_with(":") {
      if !name_only(piece) { return Some(usage) }
      continue
    }
    if let Some(why) = piece_problem(piece) { return Some(why.replace(
      "{}",
      selector
    ).replace("{usage}", usage)) }
  }
  if halves.len() == 1 { return None }
  if head[0].starts_with(".") || head[0].starts_with(":") { return Some(usage) }
  let part = pieces(halves[1])
  if part.len() == 0 || part[0].starts_with(".") || part[0].starts_with(":") || !name_only(part[0]) {
    return Some(usage)
  }
  for piece in part.slice(1, part.len()) {
    if !piece.starts_with(":") {
      return Some("${selector}: a part takes pseudo-classes after it (Comp::part:hover), not classes")
    }
    if let Some(why) = piece_problem(piece) { return Some(why.replace(
      "{}",
      selector
    ).replace("{usage}", usage)) }
  }
  None
}

/// What is wrong with one `.class` or `:pseudo-class` of a selector (`{}` for the selector,
/// `{usage}` for what a selector may be), if anything: a class named for a state, which a
/// pseudo-class is now, or a pseudo-class ui does not have.
let piece_problem = pure (piece: string) -> Maybe<string> => {
  let name = piece.slice(1, piece.len())
  if !name_only(name) { return Some("{usage}") }
  if piece.starts_with(".") {
    let state = match name {
      "hover" => ":hover",
      "pressed" => ":active",
      "focus" => ":focus",
      _ => return None,
    }
    return Some("{}: a state is a pseudo-class, as in CSS: write ${state}, not .${name}")
  }
  if PSEUDO_CLASSES.any((p) => p == name) { return None }
  Some("{}: :${name} is not a pseudo-class ui has (${PSEUDO_CLASSES.join(", ")})")
}

/// The states ui styles, as CSS's pseudo-classes (ui.style's PSEUDO_CLASSES).
const PSEUDO_CLASSES = [
  "hover",
  "active",
  "focus",
  "focus-visible",
  "focus-within",
  "checked",
  "open",
  "read-only",
  "read-write",
  "disabled",
  "enabled",
]

/// A compound selector in its pieces: its tag (if any), then each `.class` and `:pseudo-class`
/// as written.
let pieces = pure (text: string) -> []string => {
  var out: []string = []
  var piece = ""
  for c in text {
    if (c == '.' || c == ':') && piece.len() > 0 {
      out.push(piece)
      piece = ""
    }
    piece = "${piece}${c}"
  }
  if piece.len() > 0 { out.push(piece) }
  out
}

/// A name: letters, digits, `_` and `-`, at least one.
let name_only = pure (text: string) -> bool =>
  text.len() > 0 && text
  .to_runes()
  .all((c) => c.is_ascii_alpha() || c.is_ascii_digit() || c == '_' || c == '-')

/// An `@media` query — `(min-width: 600) and (orientation: landscape), not (max-width: 400px)`
/// — as Lyra's `[]Media`: a comma is any of, `and` every one of, a leading `not` the whole
/// reversed; `screen` and `all` (`all and (…)`) are taken and mean nothing here. Lengths are
/// logical units, `px` allowed.
let media_query = pure (text: string) -> Result<string, string> => {
  if text.len() == 0 { return Err("@media needs a condition: @media (min-width: 600)") }
  var each: []string = []
  for query in top_level(text, ',')? {
    var words = query.trim()
    var negated = false
    if let Some(rest) = words.strip_prefix("not ") {
      negated = true
      words = rest.trim()
    }
    for kind in ["screen", "all"] {
      if words == kind { words = "" }
      if let Some(rest) = words.strip_prefix("${kind} and ") { words = rest.trim() }
    }
    var fields: []string = []
    if words.len() > 0 {
      for test in words.split(" and ") {
        let t = test.trim()
        let inner = t.strip_prefix("(").flat_map((x) => x.strip_suffix(")"))
        let Some(feature) = inner else {
          return Err("${t} is not a media feature in (…): (min-width: 600)")
        }
        fields.push(media_feature(feature)?)
      }
    }
    if negated { fields.push("not: true") }
    each.push("Media { ${fields.join(", ")} }")
  }
  Ok("[${each.join(", ")}]")
}

/// One media feature, `min-width: 600`, as a `Media` field.
let media_feature = pure (text: string) -> Result<string, string> => {
  let Some(colon) = text.index(":") else {
    return Err("(${text}) needs a value: (min-width: 600)")
  }
  let name = text.slice(0, colon).trim()
  let value = text.slice(colon + 1, text.len()).trim()
  match name {
    "min-width" => media_length("min_width", name, value),
    "max-width" => media_length("max_width", name, value),
    "min-height" => media_length("min_height", name, value),
    "max-height" => media_length("max_height", name, value),
    "orientation" => match value {
      "portrait" => Ok("orientation: Some(Portrait)"),
      "landscape" => Ok("orientation: Some(Landscape)"),
      _ => Err("orientation is portrait or landscape, not ${value}"),
    },
    "prefers-color-scheme" => match value {
      "light" => Ok("scheme: Some(LightMode)"),
      "dark" => Ok("scheme: Some(DarkMode)"),
      _ => Err("prefers-color-scheme is light or dark, not ${value}"),
    },
    _ => Err("no media feature ${name} in ui (min-width, max-width, min-height, max-height, orientation, prefers-color-scheme)"),
  }
}

/// A media length — logical units, `px` allowed — as the field `field`.
let media_length = pure (
  field: string,
  name: string,
  value: string
) -> Result<string, string> => {
  let n = value.strip_suffix("px") ?? value
  match number(n.trim()) {
    Ok(v) => Ok("${field}: Some(${v})"),
    Err(_) => Err("${name} is a length in logical units (600 or 600px), not ${value}"),
  }
}

/// How many line breaks `text` has before rune `at`.
let lines_before = pure (text: string, at: i64) -> i64 => {
  var n = 0
  for i, c in text {
    if i >= at { break }
    if c == '\n' { n += 1 }
  }
  n
}

/// `/* … */` comments blanked, their line breaks kept, so a rule's line still counts.
let strip_comments_kept = pure (text: string) -> string => {
  var out = text
  loop {
    let Some(open) = out.index("/*") else { break }
    let close = out.index("*/", open).unwrap_or(out.len() - 2)
    let kept = [c in out.slice(
      open,
      close + 2
    ) | if c == '\n' { "\n" } else { " " }].join()
    out = "${out.slice(0, open)}${kept}${out.slice(close + 2, out.len())}"
  }
  out
}

/// `color: #fff; rounding: 4` as `Style` fields.
let declarations = pure (text: string, line: i64) -> Result<[]string, string> => {
  var fields: []string = []
  for d in text.split(";") {
    if d.trim().len() == 0 { continue }
    let Some(colon) = d.index(":") else { return Err("${line}: \"${d.trim()}\" has no `:`") }
    let name = d.slice(0, colon).trim()
    let given = d.slice(colon + 1, d.len()).trim()
    let lyra = match name {
      "color" => color(given),
      "background" => color(given),
      "padding" => padding(given),
      "rounding" => number(given),
      "opacity" => number(given),
      "width" => if given.ends_with("em") { em(given) } else { number(given) },
      "height" => number(given),
      "gap" => number(given),
      _ => Err("no style property ${name}"),
    }
    let field = if name == "width" && given.ends_with("em") { "width_em" } else { name }
    match lyra {
      Ok(v) => fields.push("${field}: Some(${v})"),
      Err(what) => { return Err("${line}: ${what}") },
    }
  }
  Ok(fields)
}

/// A colour as CSS Color 4 writes it (as [ui_color] reads it) as `col32(…)`: its sRGB bytes, the
/// opacity among them where it is translucent.
let color = pure (value: string) -> Result<string, string> => {
  let Some(c) = parse_color(value) else {
    return Err("${value} is not a colour: #rgb, #rrggbb, #rrggbbaa, rgb(…), oklab(…) or oklch(…)")
  }
  Ok(if c.a == 255 { "col32(${c.r}, ${c.g}, ${c.b})" } else { "col32(${c.r}, ${c.g}, ${c.b}, ${c.a})" })
}

/// One number, both ways, or two: `4`, `14 4`.
let padding = pure (value: string) -> Result<string, string> => {
  let parts = value.split_when((c) => c == ' ')
  let (x, y) = match parts.len() {
    1 => (number(parts[0])?, number(parts[0])?),
    2 => (number(parts[0])?, number(parts[1])?),
    _ => { return Err("padding is one or two numbers, not ${value}") },
  }
  Ok("Vec2 { x: ${x}, y: ${y} }")
}

/// `6em` as the number of ems, an `f32` literal.
let em = pure (value: string) -> Result<string, string> =>
  number(value.slice(0, value.len() - 2).trim())

/// A number as an `f32` literal: `4` is `4.0`.
let number = pure (value: string) -> Result<string, string> => {
  var seen_digit = false
  for i, c in value {
    let digit = c >= '0' && c <= '9'
    if !(digit ||
        c == '.' ||
        (c == '-' && i == 0)) { return Err("${value} is not a number") }
    if digit { seen_digit = true }
  }
  if !seen_digit { return Err("${value} is not a number") }
  Ok(if value.contains(".") { value } else { "${value}.0" })
}

// ── Strings, props ───────────────────────────────────────────────────────────

/// Text with `{…}` in it as a Lyra string: `Reset {n} times` is `"Reset ${n} times"`. A
/// text that is one `{…}` alone is a string too, `"${n}"`, whatever `n` is — text is.
let interpolated = pure (text: string) -> string => {
  let runes = text.to_runes()
  var out = "\""
  var i = 0
  while i < runes.len() {
    let c = runes[i]
    if c == '{' {
      let end = closing(runes, i)
      let code = collapse(text.slice(i + 1, end)).trim()
      out = "${out}$" ++ "{${code}}"
      i = end + 1
      continue
    }
    out = "${out}${escaped(c)}"
    i += 1
  }
  "${out}\""
}

/// `text` as a Lyra string literal.
let quote = pure (text: string) -> string => {
  var out = "\""
  for c in text { out = "${out}${escaped(c)}" }
  "${out}\""
}

let escaped = pure (c: rune) -> string => match c {
  '"' => "\\\"",
  '\\' => "\\\\",
  '\n' => "\\n",
  '\t' => "\\t",
  _ => "${c}",
}

/// The index of the `}` closing the `{` at `open`, past nested braces and strings.
let closing = pure (runes: []rune, open: i64) -> i64 => {
  var depth = 0
  var i = open
  var in_string = false
  while i < runes.len() {
    let c = runes[i]
    if in_string {
      if c == '\\' { i += 1 } else if c == '"' { in_string = false }
    } else if c == '"' {
      in_string = true
    } else if c == '{' {
      depth += 1
    } else if c == '}' {
      depth -= 1
      if depth == 0 { return i }
    }
    i += 1
  }
  runes.len() - 1
}

/// A component's `props={{ question: string, yes: e, no: e = Cancel, }}` as the parameter
/// list it becomes, `question: string, yes: e, no: e = Cancel`: the object's entries (a
/// trailing comma allowed), each `name: Type` with an optional `= default`. `code` is what
/// is inside the attribute's outer braces — the object, braces and all.
let object_props = pure (code: string, line: i64) -> Result<string, string> => {
  let text = code.trim()
  if !text.starts_with("{") || !text.ends_with("}") {
    return Err("${line}: props are an object in a second pair of braces: props={{ name: Type }}")
  }
  var entries: []string = []
  for part in split_top_level(text.slice(1, text.len() - 1), ',') {
    let entry = part.trim()
    if entry.len() == 0 { continue }
    if entry
      .index(":")
      .is_none() { return Err("${line}: prop \"${entry}\" has no type: name: Type") }
    entries.push(entry)
  }
  Ok(entries.join(", "))
}

/// `question: string, yes: e, no: e = Cancel` as names and defaults.
let read_props = pure (text: string) -> []Prop => {
  var props: []Prop = []
  for part in split_top_level(text, ',') {
    let p = part.trim()
    if p.len() == 0 { continue }
    let name = match p.index(":") {
      Some(colon) => p.slice(0, colon).trim(),
      None => p,
    }
    let default = match top_level_equals(p) {
      Some(at) => p.slice(at + 1, p.len()).trim(),
      None => "",
    }
    props.push(Prop { name: name, default: default })
  }
  props
}

/// `text` split at each `sep` outside brackets and strings.
let split_top_level = pure (text: string, sep: rune) -> []string => {
  var parts: []string = []
  var depth = 0
  var start = 0
  var in_string = false
  let runes = text.to_runes()
  for i, c in runes {
    if in_string {
      if c == '"' { in_string = false }
    } else if c == '"' {
      in_string = true
    } else if c == '(' || c == '[' || c == '{' || (c == '<' && !preceded_by(
      runes,
      i,
      '-'
    )) {
      depth += 1
    } else if c == ')' || c == ']' || c == '}' || (c == '>' && !preceded_by(
      runes,
      i,
      '-'
    ) && !preceded_by(runes, i, '=')) {
      depth -= 1
    } else if c == sep && depth == 0 {
      parts.push(text.slice(start, i))
      start = i + 1
    }
  }
  parts.push(text.slice(start, text.len()))
  parts
}

/// The `=` of a default, outside brackets: not `==`, `=>`, `<=`, `>=` or `!=`.
let top_level_equals = pure (p: string) -> Maybe<i64> => {
  let runes = p.to_runes()
  var depth = 0
  for i, c in runes {
    if c == '(' || c == '[' || c == '{' || (c == '<' && !preceded_by(runes, i, '-')) {
      depth += 1
    } else if c == ')' || c == ']' || c == '}' || (c == '>' && !preceded_by(
      runes,
      i,
      '-'
    ) && !preceded_by(runes, i, '=')) {
      depth -= 1
    } else if c == '=' && depth == 0 {
      let next = if i + 1 < runes.len() { runes[i + 1] } else { ' ' }
      let before = if i > 0 { runes[i - 1] } else { ' ' }
      if next != '=' && next != '>' && before != '=' && before != '!' && before != '<' && before != '>' {
        return Some(i)
      }
    }
  }
  None
}

/// Whether `code` is a name alone (`FrameWidth`, `doc.rename`): what `on_change` calls.
let is_bare_name = pure (code: string) -> bool => {
  if code.len() == 0 { return false }
  for i, c in code {
    let letter = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_'
    if !(letter || (i > 0 && ((c >= '0' && c <= '9') || c == '.'))) { return false }
  }
  true
}

/// Whether the rune before `i` is `c` (`->` is an arrow, not a bracket).
let preceded_by = pure (runes: []rune, i: i64, c: rune) -> bool =>
  i > 0 && runes[i - 1] == c

let is_upper = pure (name: string) -> bool =>
  name.len() > 0 && name[0] >= 'A' && name[0] <= 'Z'

/// A lowercase name alone: a type variable.
let is_type_variable = pure (t: string) -> bool => {
  if t.len() == 0 { return false }
  for c in t {
    if !((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '_') { return false }
  }
  true
}

/// Whether `text` names `word` as a whole word.
let mentions = pure (text: string, word: string) -> bool => {
  let parts = text.split_when((c) => !((c >= 'a' && c <= 'z') ||
      (c >= 'A' && c <= 'Z') ||
      (c >= '0' && c <= '9') ||
      c == '_'))
  parts.filter((p) => p == word).len() > 0
}

/// Every run of whitespace as one space.
let collapse = pure (text: string) -> string => {
  var out = ""
  var space = false
  for c in text {
    if c == ' ' || c == '\n' || c == '\t' || c == '\r' {
      space = true
    } else {
      if space { out = "${out} " }
      space = false
      out = "${out}${c}"
    }
  }
  if space { "${out} " } else { out }
}

/// The words directly in `children`, joined.
let words_of = pure (children: []Markup) -> string => {
  var out = ""
  for child in children {
    if let Words(w, _) = child { out = "${out}${w}" }
  }
  out
}

/// The markup line a `<script>`'s first line of Lyra is on: past the blank ones.
let first_line = pure (t: Tag) -> i64 => {
  var line = t.line
  for row in t.raw.lines() {
    if row.trim().len() > 0 { return line }
    line += 1
  }
  line
}

/// A `<script>`'s Lyra, its common indentation removed and blank lines at either end gone.
let dedent = pure (raw: string) -> string => {
  let rows = raw.lines()
  var least = -1
  for l in rows {
    if l.trim().len() == 0 { continue }
    let lead = l.len() - l.trim_start().len()
    if least < 0 || lead < least { least = lead }
  }
  var kept: []string = []
  for l in rows {
    kept.push(if l.trim().len() == 0 { "" } else { l.slice(least.max(0), l.len()) })
  }
  kept.join("\n").trim()
}

let strip_comments = pure (text: string) -> string => {
  var out = text
  loop {
    let Some(open) = out.index("/*") else { break }
    let close = out.index("*/", open).unwrap_or(out.len() - 2)
    out = "${out.slice(0, open)}${out.slice(close + 2, out.len())}"
  }
  out
}

// ── The parser ───────────────────────────────────────────────────────────────

/// What a tag holds: elements, words, and `{…}` Lyra.
data Markup = Element(Tag) | Words(string, i64) | Code(string, i64)

struct Tag {
  name: string,
  attrs: []Attr,
  children: []Markup,
  /// A `<script>`'s or `<style>`'s text, as written.
  raw: string,
  line: i64,
}

struct Attr {
  name: string,
  value: Value,
  line: i64,
}

data Value = Quoted(string) | Braced(string) | Bare

impl Tag {
  /// A quoted attribute's text.
  let text_attr = pure (self, name: string) -> Maybe<string> => {
    for a in self.attrs {
      if a.name == name {
        if let Quoted(t) = a.value { return Some(t) }
      }
    }
    None
  }

  /// A braced attribute's Lyra.
  let code_attr = pure (self, name: string) -> Maybe<string> => {
    for a in self.attrs {
      if a.name == name {
        if let Braced(c) = a.value { return Some(c) }
      }
    }
    None
  }
}

const LT: i64 = 60
const GT: i64 = 62
const SLASH: i64 = 47
const EQUALS: i64 = 61
const QUOTE: i64 = 34
const OPEN_BRACE: i64 = 123
const CLOSE_BRACE: i64 = 125
const BACKSLASH: i64 = 92

/// The file's top-level tags.
let parse_file = pure (b: []u8) -> Result<[]Tag, string> => {
  var tags: []Tag = []
  var i = 0
  loop {
    i = skip_comments(b, skip_space(b, i))
    if i >= b.len() { break }
    if byte_at(
      b,
      i
    ) != LT { return Err(fail(b, i, "text outside a <component> or <script>")) }
    let (t, next) = parse_tag(b, i)?
    tags.push(t)
    i = next
  }
  Ok(tags)
}

/// The tag whose `<` is at `open`, and the offset after it.
let parse_tag = pure (b: []u8, open: i64) -> Result<(Tag, i64), string> => {
  let line = line_of(b, open)
  let (name, after_name) = read_name(b, open + 1)
  if name.len() == 0 { return Err(fail(b, open, "a tag with no name")) }
  var attrs: []Attr = []
  var i = skip_space(b, after_name)
  loop {
    let c = byte_at(b, i)
    if c < 0 { return Err(fail(b, open, "<${name}> is never closed")) }
    if c == SLASH && byte_at(b, i + 1) == GT {
      let t = Tag { name: name, attrs: attrs, children: [], raw: "", line: line }
      return Ok((t, i + 2))
    }
    if c == GT { break }
    let (key, after_key) = read_name(b, i)
    if key.len() == 0 { return Err(fail(b, i, "an unexpected character in <${name}>")) }
    let at = line_of(b, i)
    i = skip_space(b, after_key)
    if byte_at(b, i) != EQUALS {
      attrs.push(Attr { name: key, value: Bare, line: at })
      continue
    }
    i = skip_space(b, i + 1)
    if byte_at(b, i) == QUOTE {
      var end = i + 1
      while end < b.len() && i64(b[end]) != QUOTE { end += 1 }
      if end >= b.len() { return Err(fail(b, i, "${key} of <${name}> is never closed")) }
      attrs.push(Attr {
        name: key,
        value: Quoted(entities(b.slice(i + 1, end).decode_utf8())),
        line: at
      })
      i = skip_space(b, end + 1)
    } else if byte_at(b, i) == OPEN_BRACE {
      let (code, next) = read_braced(b, i)?
      attrs.push(Attr { name: key, value: Braced(code), line: at })
      i = skip_space(b, next)
    } else {
      return Err(fail(b, i, "${key} of <${name}> is \"…\" or {…}"))
    }
  }
  i += 1
  // A script's or a style's body is text, read to its end tag as it is.
  if name == "script" || name == "style" {
    let end_tag = "</${name}>".encode_utf8()
    var end = i
    while end < b.len() && !bytes_at(b, end, end_tag) { end += 1 }
    if end >= b.len() { return Err(fail(b, open, "<${name}> is never closed")) }
    let raw = b.slice(i, end).decode_utf8()
    let t = Tag { name: name, attrs: attrs, children: [], raw: raw, line: line }
    return Ok((t, end + end_tag.len()))
  }
  var children: []Markup = []
  loop {
    if i >= b.len() { return Err(fail(b, open, "<${name}> is never closed")) }
    let c = byte_at(b, i)
    if c == LT && byte_at(b, i + 1) == SLASH {
      let (closing_name, past_name) = read_name(b, i + 2)
      if closing_name != name {
        return Err(fail(b, i, "</${closing_name}> closes <${name}> (line ${line})"))
      }
      let end = skip_space(b, past_name)
      if byte_at(b, end) != GT { return Err(fail(b, i, "</${name} is never closed")) }
      let t = Tag { name: name, attrs: attrs, children: children, raw: "", line: line }
      return Ok((t, end + 1))
    }
    if c == LT && bytes_at(b, i, "<!--".encode_utf8()) {
      i = skip_comments(b, i)
    } else if c == LT {
      let (child, next) = parse_tag(b, i)?
      children.push(Element(child))
      i = next
    } else if c == OPEN_BRACE {
      let at = line_of(b, i)
      let (code, next) = read_braced(b, i)?
      children.push(Code(code, at))
      i = next
    } else {
      let at = line_of(b, i)
      var end = i
      while end < b.len() && i64(b[end]) != LT && i64(b[end]) != OPEN_BRACE { end += 1 }
      children.push(Words(entities(b.slice(i, end).decode_utf8()), at))
      i = end
    }
  }
  Err(fail(b, open, "<${name}> is never closed"))
}

/// The Lyra between the `{` at `open` and its `}`, with the offset after it — past
/// nested braces and strings.
let read_braced = pure (b: []u8, open: i64) -> Result<(string, i64), string> => {
  var depth = 0
  var i = open
  var in_string = false
  while i < b.len() {
    let c = i64(b[i])
    if in_string {
      if c == BACKSLASH { i += 1 } else if c == QUOTE { in_string = false }
    } else if c == QUOTE {
      in_string = true
    } else if c == OPEN_BRACE {
      depth += 1
    } else if c == CLOSE_BRACE {
      depth -= 1
      if depth == 0 { return Ok((
        collapse(b.slice(open + 1, i).decode_utf8()).trim(),
        i + 1
      )) }
    }
    i += 1
  }
  Err(fail(b, open, "a { is never closed"))
}

/// `&lt;`, `&gt;`, `&amp;`, `&quot;`, `&lbrace;` and `&rbrace;` decoded.
let entities = pure (text: string) -> string =>
  text.replace(
    "&lt;",
    "<"
  ).replace(
    "&gt;",
    ">"
  ).replace(
    "&quot;",
    "\""
  ).replace("&lbrace;", "{").replace("&rbrace;", "}").replace("&amp;", "&")

let read_name = pure (b: []u8, from: i64) -> (string, i64) => {
  var i = from
  while is_name_byte(byte_at(b, i)) { i += 1 }
  (b.slice(from, i).decode_utf8(), i)
}

let is_name_byte = pure (c: i64) -> bool =>
  (c >= 97 && c <= 122) ||
  (c >= 65 && c <= 90) ||
  (c >= 48 && c <= 57) ||
  c == 95 ||
  c == 45

/// Past `<!-- … -->` comments and the space around them.
let skip_comments = pure (b: []u8, from: i64) -> i64 => {
  var i = from
  let open = "<!--".encode_utf8()
  let close = "-->".encode_utf8()
  while bytes_at(b, i, open) {
    var end = i + 4
    while end < b.len() && !bytes_at(b, end, close) { end += 1 }
    i = skip_space(b, end + 3)
  }
  i
}

let bytes_at = pure (b: []u8, at: i64, want: []u8) -> bool => {
  if at < 0 || at + want.len() > b.len() { return false }
  for k in 0..<want.len() {
    if b[at + k] != want[k] { return false }
  }
  true
}

let skip_space = pure (b: []u8, from: i64) -> i64 => {
  var i = from
  while is_space(byte_at(b, i)) { i += 1 }
  i
}

let is_space = pure (c: i64) -> bool => c == 32 || c == 9 || c == 10 || c == 13

let byte_at = pure (b: []u8, i: i64) -> i64 =>
  if i >= 0 && i < b.len() { i64(b[i]) } else { -1 }

let line_of = pure (b: []u8, at: i64) -> i64 => {
  var line = 1
  for k in 0..<at.min(b.len()) {
    if b[k] == 10 { line += 1 }
  }
  line
}

let fail = pure (b: []u8, at: i64, what: string) -> string => "${line_of(b, at)}: ${what}"
