// A scrolling level, NES style: a tile map four screens wide, a camera that follows the
// explorer, and a game that updates at exactly 60 Hz whatever the display does.
//
// **Three pieces every side-scroller has, and nothing else.** The level is ASCII in this
// file, one character per 16×16 tile (`level.lyra` reads it, and holds the physics and
// drawing `game.lyra` shares); only the seventeen columns the camera can see are drawn. The explorer walks (B runs), jumps with A — shorter if A is let go early — and
// collides with solid tiles one axis at a time. Coins are taken out of the map when
// touched, and a fall into a pit starts over.
//
// **The update is fixed, the drawing is not.** `console.lyra`'s clock hands each frame
// the whole number of 1/60 s steps that real time has paid for, so a 120 Hz display draws
// every state twice and the physics — every speed and height below is per step — plays
// the same on any screen.
//
// `--check` tests the timestep and the physics headlessly. Escape quits; `--shot` as in
// `console.lyra`. Arrows/WASD move, X (A) jumps, Z (B) runs.

import bindings.sdl3.{
  last_error, Renderer, set_draw_color, clear, debug_text, Texture, destroy_texture,
  poll_event,
}
import bindings.sdl3_image.{ load_texture }
import console.{
  Screen,
  open_screen,
  close_screen,
  end_frame,
  wants_quit,
  start_clock,
  updates_due,
  accrue,
  MAX_STEPS,
}
import pad.{ Buttons, Pad, RELEASED, advance, read_buttons }
import level.{
  Level, Body, parse_level, explorer_at, steer, move_x, move_y, fell_out, collect_coins,
  camera_x, draw_level, draw_explorer, tile_at, TILE, SKY, BOX_W, BOX_H,
}
import palette.{ nes }

let main = () -> u8 => {
  if has_flag("--check") { return run_checks() }
  match open_screen("Lyra NES tilemap") {
    None => 1,
    Some(screen) => {
      let code = with_sheet(screen)
      close_screen(screen)
      code
    },
  }
}

let with_sheet = (screen: Screen) -> u8 =>
  match load_texture(screen.renderer, "examples/SDL3/assets/sprites.png") {
    Some(sheet) => {
      let code = run(screen, sheet)
      destroy_texture(sheet)
      code
    },
    None => match load_texture(screen.renderer, "../assets/sprites.png") {
      Some(sheet) => {
        let code = run(screen, sheet)
        destroy_texture(sheet)
        code
      },
      None => {
        println("could not load assets/sprites.png: ${last_error()}")
        println("run from the repository root or from examples/SDL3/nes/")
        1
      },
    },
  }

// ---------------------------------------------------------------------------------------
// The level
// ---------------------------------------------------------------------------------------

/// The level, in `level.lyra`'s characters.
const LEVEL: []string = [
  "................................................................",
  "................................................................",
  ".....cc.............ccc.........................................",
  "......................................cc............cc..........",
  ".............c..............................c...............c...",
  "................................................................",
  ".....................................o..........................",
  "....................................###.........................",
  ".........ooo................................oooo................",
  "........#####...............................####..............##",
  "..................ooo.........###ooo..........................##",
  "..........................==..................................##",
  "....b......b............==%%.............b...............b....##",
  "==================...===%%%%=====...=============..=============",
  "%%%%%%%%%%%%%%%%%%...%%%%%%%%%%%%...%%%%%%%%%%%%%..%%%%%%%%%%%%%",
]

const COLUMNS: i64 = 64
const ROWS: i64 = 15

const SPAWN_X: f32 = 34.0
const SPAWN_Y: f32 = 193.0

struct World {
  level: Level,
  player: Body,
  coins: i64,
  steps: i64,
}

let new_world = pure () -> World => World {
  level: parse_level(LEVEL),
  player: spawned(),
  coins: 0,
  steps: 0,
}

let spawned = pure () -> Body => explorer_at(SPAWN_X, SPAWN_Y)

/// One 1/60 s step: steer, move one axis at a time, fall out and start over, take coins.
let update = (world: mut World, pad: Pad) -> void => {
  var p = steer(world.player, pad)
  p = move_x(world.level, p)
  p = move_y(world.level, p)
  if fell_out(world.level, p) { p = spawned() }
  world.player = p
  world.coins += collect_coins(world.level, p)
  world.steps += 1
}

// ---------------------------------------------------------------------------------------
// The window
// ---------------------------------------------------------------------------------------

let run = (screen: Screen, sheet: Texture) -> u8 => {
  var world = new_world()
  var clock = start_clock()
  var previous = RELEASED
  var frame: i64 = 0
  var status: u8 = 0
  var running = true

  for running {
    var draining = true
    for draining {
      match poll_event() {
        None => { draining = false },
        Some(event) => {
          if wants_quit(event) { running = false }
        },
      }
    }

    for _ in 0..<updates_due(screen, clock) {
      let now = read_buttons(None)
      update(world, advance(previous, now))
      previous = now
    }

    draw(screen.renderer, sheet, world)
    match end_frame(screen, frame) {
      Stop(code) => {
        status = code
        running = false
      },
      Continue => {},
    }
    frame += 1
  }
  status
}

let draw = (r: Renderer, sheet: Texture, world: World) -> void => {
  set_draw_color(r, nes(0x21))
  clear(r)
  let camera = camera_x(world.level, world.player)
  draw_level(r, sheet, world.level, camera, world.steps)
  draw_explorer(r, sheet, world.player, camera, world.steps)
  set_draw_color(r, nes(0x0F))
  debug_text(r, 8.0, 8.0, "COINS ${world.coins}")
  debug_text(r, 168.0, 8.0, "X ${(world.player.x / TILE).floor()}/${COLUMNS}")
}

// ---------------------------------------------------------------------------------------
// --check: the timestep and the physics
// ---------------------------------------------------------------------------------------

let run_checks = () -> u8 => {
  var failures = 0

  var rectangular = LEVEL.len() == ROWS
  for row in LEVEL {
    if row.len() != COLUMNS { rectangular = false }
  }
  failures += check_that("the level is 64 by 15", rectangular)

  // Ten seconds of frames at three refresh rates all buy 600 updates, give or take the
  // one still owed at the end.
  for hz in [60, 120, 144] {
    let updates = updates_over(10, hz)
    failures += check_that(
      "${hz} Hz frames buy ${updates} updates in 10 s",
      updates >= 599 && updates <= 600
    )
  }
  let (capped, owed) = accrue(0, 2000000000)
  failures += check_that(
    "a two-second stall runs at most ${MAX_STEPS} updates",
    capped == MAX_STEPS && owed == 0
  )

  // Dropped from the air, the explorer lands on the ground and rests exactly on it.
  var landing = new_world()
  landing.player = Body { spawned() | y: 100.0 }
  steps(landing, RELEASED, 120)
  failures += check_that(
    "a fall lands on the ground",
    landing.player.on_ground && near(landing.player.y + BOX_H, 208.0)
  )

  // Held right into the end wall, the explorer stops flush against it.
  var walled = new_world()
  walled.player = Body { spawned() | x: 900.0 }
  steps(walled, Buttons { RELEASED | right: true }, 300)
  failures += check_that(
    "a wall stops the explorer flush",
    near(walled.player.x + BOX_W, 62.0 * TILE) && near(walled.player.vx, 0.0)
  )

  // A held jump from the ground rises about four tiles and comes back down.
  var jumping = new_world()
  steps(jumping, RELEASED, 30)
  let ground_y = jumping.player.y
  var highest = ground_y
  var previous = RELEASED
  for i in 0..<90 {
    let now = Buttons { RELEASED | a: i < 40 }
    update(jumping, advance(previous, now))
    previous = now
    highest = highest.min(jumping.player.y)
  }
  let rise = ground_y - highest
  failures += check_that(
    "a held jump rises ${rise} px (60-70)",
    rise >= 60.0 && rise <= 70.0
  )
  failures += check_that(
    "and lands again",
    jumping.player.on_ground && near(jumping.player.y, ground_y)
  )

  // A tapped jump is cut short.
  var tapped = new_world()
  steps(tapped, RELEASED, 30)
  var low = tapped.player.y
  var before = RELEASED
  for i in 0..<60 {
    let now = Buttons { RELEASED | a: i < 2 }
    update(tapped, advance(before, now))
    before = now
    low = low.min(tapped.player.y)
  }
  failures += check_that("a tapped jump is shorter", ground_y - low < rise / 2.0)

  // The level forgives ordinary timing: a running jump taken a tile and a half *before*
  // the first pit's edge still clears it. A platform once hung over this pit, and its
  // underside cut every jump short — clearable only with a frame-perfect jump at the very
  // edge, which is a check this would have passed, so the check jumps early.
  var leaping = new_world()
  leaping.player = Body { spawned() | x: 12.0 * TILE }
  steps(leaping, RELEASED, 20)
  var fell = false
  var was = RELEASED
  for _ in 0..<90 {
    let at_edge = leaping.player.x + BOX_W >= 18.0 * TILE - 24.0
    let now = Buttons { RELEASED | right: true, b: true, a: at_edge }
    update(leaping, advance(was, now))
    was = now
    if leaping.player.x < 100.0 { fell = true }
  }
  failures += check_that(
    "an early running jump clears the first pit",
    !fell && leaping.player.on_ground && leaping.player.x > 21.0 * TILE
  )

  // Touching a coin takes it out of the map.
  var rich = new_world()
  rich.player = Body { spawned() | x: 9.0 * TILE, y: 8.0 * TILE, on_ground: true }
  update(rich, advance(RELEASED, RELEASED))
  failures += check_that(
    "a touched coin is collected",
    rich.coins >= 1 && tile_at(rich.level, 9, 8) == SKY
  )

  // A fall into the first pit starts over.
  var falling = new_world()
  falling.player = Body { spawned() | x: 18.5 * TILE, y: 190.0 }
  steps(falling, RELEASED, 200)
  failures += check_that("a pit respawns the explorer", near(falling.player.x, SPAWN_X))

  if failures == 0 {
    println("all checks passed")
    0
  } else {
    println("${failures} check(s) failed")
    1
  }
}

/// Updates `seconds` of frames at `hz` would buy.
let updates_over = pure (seconds: i64, hz: i64) -> i64 => {
  let frame_ns = 1000000000 / hz
  var owed: i64 = 0
  var total: i64 = 0
  for _ in 0..<seconds * hz {
    let (n, left) = accrue(owed, frame_ns)
    total += n
    owed = left
  }
  total
}

/// `count` steps with `held` held throughout.
let steps = (world: mut World, held: Buttons, count: i64) -> void => {
  var previous = RELEASED
  for _ in 0..<count {
    update(world, advance(previous, held))
    previous = held
  }
}

/// Equal to within a thousandth of a pixel — positions here are set to exact tile edges,
/// but a test should not depend on that staying true.
let near = pure (a: f32, b: f32) -> bool => (a - b).abs() < 0.001

let check_that = (what: string, ok: bool) -> i64 => {
  if ok {
    0
  } else {
    println("FAIL: ${what}")
    1
  }
}

let has_flag = (name: string) -> bool => {
  var found = false
  for arg in program_args() {
    if arg == name { found = true }
  }
  found
}
