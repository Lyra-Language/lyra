import std.math.{ Complex }

const MAX_ITER = 100
const WIDTH = 125
const HEIGHT = 57

// How many times taller than wide one terminal cell is.
//
// **This is a property of the font, not of the fractal**, and it is the only number here
// that would need touching on a terminal whose cells are not the usual 2:1 (8x16, 9x18
// and 10x20 are all typical). Without it the set renders vertically stretched — the
// classic terminal-graphics distortion — because one character per pixel maps a square
// region of the complex plane onto a cell that is anything but square.
//
// Compensating in the *coordinate mapping* rather than by drawing two characters per
// pixel is what keeps the horizontal resolution: 125 samples across instead of 62.
const CELL_ASPECT = 2.0

const X_MIN = -2.00
const X_MAX = 0.47
const X_LEN = X_MAX - X_MIN

// The vertical extent is **derived, not chosen**, so the aspect correction holds by
// construction rather than by the constants happening to agree. Picking Y_MIN/Y_MAX by
// hand works right up until WIDTH or HEIGHT changes, and then it silently does not — the
// distortion looks like a rendering artifact rather than like arithmetic.
//
// It cannot be a `const`: deriving it needs f64(HEIGHT), and a conversion is not a
// compile-time constant. Declaring float copies of the dimensions beside the integer ones
// would fix that and introduce two numbers that can drift apart, which is worse.

// A generous bailout rather than the usual 4.0. The smooth term below is only
// asymptotically correct, so the further past the escape radius `z` is allowed to
// travel, the less the shading bands.
const ESCAPE = 65536.0

// The shading ramp runs logarithmically from one iteration up to this, and anything
// slower is drawn at the heaviest exterior character. Logarithmic because escape times
// are: nearly every point outside the set leaves within a handful of steps, so a linear
// scale against MAX_ITER spends the whole ramp on the thin band near the boundary and
// draws the entire far field identically.
const SHADE_MAX = 64.0

// Lightest first: a point that takes longer to escape is drawn heavier, and one that
// never escapes is drawn heaviest of all.
const RAMP = [" ", ".", ":", "-", "=", "+", "*", "#", "%", "@"]

/// How heavily to draw `c` — an index into `RAMP`, its last for a point in the set.
let shade = (c: Complex<f64>) -> i64 => {
  var z = Complex { re: 0.0, im: 0.0 }
  var mag2 = 0.0
  var iter = 0
  for iter < MAX_ITER {
    z = z * z + c
    mag2 = z.re * z.re + z.im * z.im
    if mag2 > ESCAPE { break }
    iter += 1
  }

  if iter >= MAX_ITER {
    RAMP.len() - 1
  } else {
    // Smooth escape time, `n + 1 - log2(log|z|)`: the integer iteration count alone
    // draws visible contours, since every point escaping on the same step gets the
    // same character.
    let smooth = f64(iter) + 1.0 - mag2.sqrt().log().log2()
    // The correction is worth about -1.5, so a point escaping immediately lands below
    // zero, and the log of that is a NaN — which `round` traps on rather than quietly
    // answering a number. Clamping is the fix; the trap is doing its job.
    let s = if smooth < 1.0 { 1.0 } else if smooth > SHADE_MAX { SHADE_MAX } else { smooth }
    let t = s.log() / SHADE_MAX.log()
    // `len() - 2`: the heaviest character is reserved for the set itself, so the
    // boundary stays visible instead of merging into it.
    (t * f64(RAMP.len() - 2)).round()
  }
}

let main = () => {
  // One cell should cover the same complex distance either way once the cell's own
  // shape is accounted for: X_LEN/WIDTH per column, and CELL_ASPECT times that per row.
  let y_len = X_LEN * CELL_ASPECT * f64(HEIGHT) / f64(WIDTH)
  // Centred on the real axis, which is where the set is.
  //
  // Note what this does *not* do: it holds the horizontal view fixed and lets the
  // vertical show whatever fits, so a wide, short window sees **less** of the imaginary
  // axis rather than a squashed set. That is what a uniform scale means. A viewer that
  // would rather always frame the whole set should derive the other way round, or take
  // whichever of the two extents is more constraining.
  let y_min = -y_len / 2.0

  var rows: []string = []
  for py in 0..<HEIGHT {
    var row = ""
    for px in 0..<WIDTH {
      let c = Complex {
        re: X_MIN + X_LEN * f64(px) / f64(WIDTH),
        im: y_min + y_len * f64(py) / f64(HEIGHT)
      }
      row = row ++ RAMP[shade(c)]
    }
    rows.push(row)
  }
  println(rows.join("\n"))
}
