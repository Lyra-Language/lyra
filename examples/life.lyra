import std.tui.{
  alt_screen_enter, alt_screen_leave, clear, cursor_home, cursor_hide, cursor_show,
  mouse_enable_motion, mouse_disable, event_reader, Event, MouseEvent, MouseButton,
  MouseAction, Key, fg, reset, rgb, fit
}

// Conway's Game of Life, animated in the terminal and sized to the window.
//
// Four rules on a grid of cells, applied to every cell at once: a live cell with two or
// three live neighbours survives, a dead cell with exactly three is born, and everything
// else dies. The whole program is those two lines plus the machinery to see them.
//
// **The grid is a torus** — the left edge neighbours the right, the top the bottom — so a
// glider that runs off one side comes back on the other rather than dissolving at a wall.
// It is one `%%` per axis (see `wrap`) and it is what makes a small window worth watching.
//
// Run: lyrac run examples/life.lyra
//   q or Escape  quit          space  pause / resume
//   s            single step   r      reseed        c  clear
//   click or drag on the grid to draw; press on a live cell to erase instead
//
// The window may be resized while it runs; the world is re-fitted and the pattern kept.

/// Milliseconds per generation. Also the input poll window: the program waits for a key
/// for exactly this long, so a keypress is answered at once and a quiet window advances
/// the world. There is no sleep in the language and none is wanted — the wait *is* the
/// frame timer, which is what `wait_for_key_ms` returning a bool buys.
const STEP_MS = 90

/// Live cells per hundred in a fresh world. A third is dense enough to be busy for a few
/// hundred generations and sparse enough that structure separates out of the soup.
const DENSITY = 33

let main = () => {
  setup()

  let (initial_width, initial_height) = playfield()
  var width = initial_width
  var height = initial_height
  var grid = empty_grid(width, height)
  var events = event_reader()
  var generation = 0
  var running = true
  var paused = true
  // A stroke in progress, and what it is painting. See the `Mouse` arm below.
  var painting = false
  var paint_alive = true

  for running {
    draw(grid, generation, paused)

    // Poll and animate in one call: true means a key is waiting, false means the window
    // elapsed with nothing typed — which is the tick.
    if events.event_available(STEP_MS) {
      match events.next_event() {
        None => { running = false },
        Some(e) => match e {
          Keyboard(Char c) => {
            if c == 'q' { running = false }
            else if c == ' ' { paused = !paused }
            else if c == 's' {
              grid = step(grid)
              generation += 1
            }
            else if c == 'c' {
              grid = empty_grid(width, height)
              generation = 0
            }
            else if c == 'r' {
              grid = random_grid(width, height, random_seed())
              generation = 0
            }
          },
          Keyboard(Escape) => { running = false },
          // A press starts a stroke, a drag continues it, a release ends it.
          //
          // **What to paint is decided once, at the press**, from the cell under it — on a
          // dead cell the stroke draws, on a live one it erases. Toggling per event instead
          // would undo the stroke as the hand wobbles: a drag reports every cell entered,
          // so crossing back over a cell already painted would flip it again.
          Mouse(m) => match m.action {
            Press => match m.button {
              MouseLeft => match cell_at(grid, m) {
                Some((x, y)) => {
                  paint_alive = !grid[y][x]
                  grid[y][x] = paint_alive
                  painting = true
                },
                None => { }
              },
              // A wheel notch is a press too, and must not draw.
              _ => { }
            },
            Move => {
              if painting {
                match cell_at(grid, m) {
                  Some((x, y)) => { grid[y][x] = paint_alive },
                  None => { }
                }
              }
            },
            Release => { painting = false }
          },
          _ => { }
        }
      }
    } else {
      // The poll window elapsed with nothing typed, and two things share it.
      //
      // **The window is re-measured here**, because nothing announces a resize — there is
      // no SIGWINCH handler, and `terminal_size` is EffectInput precisely because the
      // answer can change with no input. Measuring once at startup is what makes a resized
      // window fatal rather than untidy: the frame keeps its old height, the extra lines
      // scroll the screen, and every cell is then displayed above where it was written
      // while the mouse still reports true screen rows — so clicks toggle the wrong cell.
      let (now_width, now_height) = playfield()
      if now_width != width || now_height != height {
        grid = resized(grid, now_width, now_height)
        width = now_width
        height = now_height
        // A shrink leaves the old frame's right and bottom edges on screen, outside
        // anything the new one writes over.
        clear()
      }

      // And the world advances. A resize is not a pause, so this is not an `else`.
      if !paused {
        grid = step(grid)
        generation += 1
      }
    }
  }

  // In reverse, and all three matter: a program that exits without them leaves a terminal
  // with no echo, no cursor and the world still on screen.
  teardown()
}

let setup = () => {
  // Order matters on the way in, and the reverse order on the way out.
  set_raw_mode(true)
  alt_screen_enter()
  cursor_hide()
  mouse_enable_motion()
  clear()
}

let teardown = () -> void => {
  mouse_disable()
  cursor_show()
  alt_screen_leave()
  set_raw_mode(false)
}

/// The next generation, as a fresh grid.
///
/// Fresh rather than in place, and that is Life's one real constraint: every cell reads
/// its neighbours' *current* states, so a grid mutated as it is walked would feed a cell
/// its neighbour's new value and quietly compute a different automaton.
let step = pure (grid: [][]bool) -> [][]bool => {
  let height = grid.len()
  let width = grid[0].len()
  var next: [][]bool = []
  for y in 0..<height {
    var row: []bool = []
    for x in 0..<width {
      let n = neighbours(grid, x, y)
      row.push(if grid[y][x] { n == 2 || n == 3 } else { n == 3 })
    }
    next.push(row)
  }
  next
}

/// How many of the eight cells around `(x, y)` are alive, wrapping at every edge.
let neighbours = pure (grid: [][]bool, x: i64, y: i64) -> i64 => {
  let height = grid.len()
  let width = grid[0].len()
  var count = 0
  for dy in -1..<=1 {
    for dx in -1..<=1 {
      // The cell itself is not its own neighbour, and it is the one case the double loop
      // gets wrong for free.
      if dx != 0 || dy != 0 {
        if grid[wrap(y + dy, height)][wrap(x + dx, width)] { count += 1 }
      }
    }
  }
  count
}

/// `i` brought into `0..<limit` by wrapping, for a neighbour one step off either edge.
///
/// `%%` rather than `%`: Lyra has both, and this is exactly the case that tells them
/// apart. `-1 % 10` is `-1` — the sign follows the dividend, as in C — and would index
/// out of bounds and trap. `-1 %% 10` is `9`, which is the edge the torus joins to.
let wrap = pure (i: i64, limit: i64) -> i64 => i %% limit

let empty_grid = pure (width: i64, height: i64) -> [][]bool => {
  var grid: [][]bool = []
  for _ in 0..<height {
    var row: []bool = []
    for _ in 0..<width {
      row.push(false)
    }
    grid.push(row)
  }
  grid
}

/// A world seeded from `seed`, `DENSITY` cells per hundred alive.
///
/// **Deterministic**, and marked so: it draws from a generator built out of the seed it
/// was handed, and `rng_seeded` only mutates its own receiver. Asking the OS for entropy
/// is the non-deterministic act, and it happens once, at the call site in `main` — so the
/// same seed replays the same world exactly.
let random_grid = det (width: i64, height: i64, seed: u64) -> [][]bool => {
  var rng = rng_seeded(seed)
  var grid: [][]bool = []
  for _ in 0..<height {
    // **A fresh row per iteration, deliberately.** The short spelling for this is
    // `[[false; width]; height]` and it is wrong: `[v; n]` evaluates its value once, so
    // every one of the `height` slots would hold the *same* row and each generation would
    // print `height` copies of one line. The compiler says so (lyra-W019)
    var row: []bool = []
    for _ in 0..<width {
      row.push(rng.below(100) < DENSITY)
    }
    grid.push(row)
  }
  grid
}

/// Draw the whole world, plus a status line.
///
/// One `print` for the frame rather than one per row: a terminal renders what it is given
/// when it is given it, so a frame written in `height` separate writes can be displayed
/// half-updated, which reads as tearing. Rows are separated by `\r\n` — the `\r` because
/// raw mode has turned off the newline translation that would otherwise supply it.
///
/// The status line carries no trailing newline, deliberately: writing one on the last row
/// of the screen scrolls it, and the whole frame walks up a line every generation. It is
/// also cut to the window's width, for the same reason one row down — see `fit`.
let draw = (grid: [][]bool, generation: i64, paused: bool) -> void => {
  cursor_home()
  var frame = ""
  for row in grid {
    for cell in row {
      frame = frame ++ (if cell { "█" } else { " " })
    }
    frame = frame ++ "\r\n"
  }
  let status = " generation ${generation}${if paused { "  [paused]" } else { "" }}" ++
    " (click or drag to draw) [q quit · space pause · s step · c clear · r reseed]"
  // The colour codes go *outside* `fit`: they occupy no cells, and counting them as
  // characters would cut the visible text dozens of columns early.
  frame = frame ++ (fg(rgb(2, 2, 2)) ++ (fit(status, grid[0].len()) ++ reset()))
  print(frame)
}
/// The world re-fitted to a new window: the overlap is kept, everything new is dead.
///
/// **Kept rather than reseeded**, because a resize is not a request to lose the pattern you
/// drew — dragging a window wider should not clear it. The torus wraps at the new edges, so
/// the topology changes under a running world; that is inherent in resizing a wrapped grid
/// rather than something to correct.
let resized = pure (grid: [][]bool, width: i64, height: i64) -> [][]bool => {
  let old_height = grid.len()
  let old_width = grid[0].len()
  var next: [][]bool = []
  for y in 0..<height {
    var row: []bool = []
    for x in 0..<width {
      row.push(if y < old_height && x < old_width { grid[y][x] } else { false })
    }
    next.push(row)
  }
  next
}

/// The window, less the status line — and never smaller than one cell, so a terminal too
/// short to hold the status bar still runs.
///
/// The return type is written out rather than inferred because `main` destructures the
/// result and this is declared below it: an inferred return type is not known until the
/// declaration is reached, and a destructure needs the element types where it stands
/// (lyra-E058). Helpers-below-main is the house style, so this is the ordinary case.
let playfield = () -> (i64, i64) => {
  let (cols, rows) = terminal_size()
  (cols, if rows > 1 { rows - 1 } else { 1 })
}

/// The grid cell under a mouse event, or `None` when the pointer is off the playfield.
///
/// **No arithmetic**, because `std.tui` reports a mouse in the same 0-based cells the grid
/// is indexed by. What is left is the bounds check, and that is not optional: the status
/// line is a row the mouse can reach and the grid cannot, so an unchecked click there
/// indexes past the last row and **traps**, ending the program with the terminal still in
/// raw mode.
let cell_at = pure (grid: [][]bool, m: MouseEvent) -> Maybe<(i64, i64)> => {
  if m.row >= 0 && m.row < grid.len() && m.col >= 0 && m.col < grid[0].len() {
    Some((m.col, m.row))
  } else {
    None
  }
}
