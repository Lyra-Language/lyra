// A panel of forms beside a table: `ui.layout`'s smaller controls (ui/VEGA.md §5) and files
// dropped on the window (§6), the view the markup of panels_view.lui (§9). On the left, a sprite's properties — number fields typed, stepped
// by their buttons and the arrow keys and scrubbed by dragging their labels; a palette chosen
// by radio buttons; a collapsing Collision section; separators with text; a progress bar. Its
// edge is dragged to resize it. On the right, the sprites in a table whose columns are resized
// by their header's edges and whose rows are selected by a click or the arrow keys; a file
// dropped on the window is added to it.
//
//     lyrac run examples/ui/panels.lyra
//     build/lui examples/ui/panels_view.lui      # after editing the markup
//     lyrac run examples/ui/panels.lyra -- --script "Tab Up Up drop:/tmp/bat.png" [--png FILE]
//
// **The second form** plays a script (`ui.script`) headless, prints the state it leaves and
// what happened, and with `--png FILE` writes the last frame.

import ui.sdl3
import ui.sdl3.{ SdlRenderer, capture }
import ui.gpu
import ui.app.{ App, Subscription, OnFilesDropped, run, running, step_running }
import ui.script.{ timed_platform, parse_steps }
import ui.draw.{ Point, Size, Color }
import ui.text.{ Fonts, fonts_new, glyph_atlas }
import ui.style.{ OverflowVisible }
import ui.layout.{ Laid, paint }
import panels_view.{ State, Event, Dropped, WIDTH, view, update }
import std.collections.{ parse_args }
import std.png.{ write_png }
import std.io.{ write_bytes }

const HEIGHT: f32 = 440.0
const BACKGROUND: Color = Color { r: 0xF4, g: 0xF4, b: 0xF6 }

let main = () -> u8 => {
  let args = parse_args(["--script", "--png"])
  var fonts = fonts_new()
  if !fonts.add_system_font() {
    println("no font: none of ui.text's SYSTEM_FONTS is here")
    return 1
  }
  let _ = fonts.add_system_fallbacks()
  let app = App {
    view: view,
    update: update,
    subscriptions: (_: State) -> []Subscription<Event> => [OnFilesDropped(Dropped)],
    background: BACKGROUND,
    window_overflow: OverflowVisible,
  }
  if let Some(script) = args.value("--script") {
    let Ok(steps) = parse_steps(script) else {
      println("the script does not parse")
      return 1
    }
    let window = match sdl3.open("Panels", WIDTH, HEIGHT) {
      Ok(w) => w,
      Err(why) => {
        println(why)
        fonts.close()
        return 2
      },
    }
    let played = running(
      app,
      State {},
      timed_platform(steps, Size { w: WIDTH, h: HEIGHT }),
      window.renderer,
      fonts
    )
    while step_running(played) {}
    let s = played.host.state
    println("width ${s.width}, height ${s.height}, speed ${s.speed}, palette ${s.palette}, collision ${s.collision}")
    println("side ${s.side}, columns ${[c in s.columns | "${c.width}"].join(" ")}")
    println("sprites ${s.sprites.join(" ")}, selected ${s.selected}")
    var status: u8 = 0
    if let Some(path) = args.value("--png") {
      if !save(
        played.renderer,
        played.fonts,
        played.host.main_laid(),
        path
      ) { status = 1 }
    }
    sdl3.close(window.platform, played.renderer)
    fonts.close()
    return status
  }
  let window = match gpu.open("Panels", WIDTH, HEIGHT) {
    Ok(w) => w,
    Err(why) => {
      println(why)
      fonts.close()
      return 2
    },
  }
  var platform = window.platform
  var renderer = window.renderer
  let _ = run(app, State {}, platform, renderer, fonts)
  gpu.close(platform, renderer)
  fonts.close()
  0
}

/// `laid` — the window as the host last laid it out — drawn without showing it, and written to
/// `path` as a PNG.
let save = (
  renderer: SdlRenderer,
  fonts: Fonts,
  laid: Laid<Event>,
  path: string
) -> bool => {
  var r = renderer
  var f = fonts
  var atlas = glyph_atlas()
  let ops = paint(laid, Point {}, 1.0, f, atlas, r)
  let Some(frame) = capture(r, BACKGROUND, ops) else { return false }
  var bytes: []u8 = []
  for p in frame.argb {
    bytes.push(u8((p >> 16) & 0xFF))
    bytes.push(u8((p >> 8) & 0xFF))
    bytes.push(u8(p & 0xFF))
    bytes.push(u8((p >> 24) & 0xFF))
  }
  match write_png(frame.width, frame.height, bytes) {
    Ok(png) => write_bytes(path, png),
    Err(_) => false,
  }
}
