// A panel of forms beside a table: `ui.layout`'s smaller controls (ui/VEGA.md §5) and files
// dropped on the window (§6). On the left, a sprite's properties — number fields typed, stepped
// by their buttons and the arrow keys and scrubbed by dragging their labels; a palette chosen
// by radio buttons; a collapsing Collision section; separators with text; a progress bar. Its
// edge is dragged to resize it. On the right, the sprites in a table whose columns are resized
// by their header's edges and whose rows are selected by a click or the arrow keys; a file
// dropped on the window is added to it.
//
//     lyrac run examples/ui/panels.lyra
//     lyrac run examples/ui/panels.lyra -- --script "Tab Up Up drop:/tmp/bat.png" [--png FILE]
//
// **The second form** plays a script (`ui.script`) headless, prints the state it leaves and
// what happened, and with `--png FILE` writes the last frame.

import ui.sdl3
import ui.sdl3.{ SdlRenderer, capture }
import ui.gpu
import ui.app.{ App, Command, Subscription, OnFilesDropped, run, running, step_running }
import ui.script.{ timed_platform, parse_steps }
import ui.draw.{ Point, Size, Color }
import ui.text.{ Fonts, fonts_new, glyph_atlas }
import ui.style.{ Style, Sheet, Rule, light_theme, insets, OverflowVisible }
import ui.layout.{
  Node,
  Laid,
  paint,
  column,
  text,
  checkbox,
  expanded,
  padding,
  themed,
  number_field,
  NumberSpec,
  radio_group,
  disclosure,
  progress,
  separator,
  splitter,
  table,
  TableColumn,
  MainStart,
  CrossStretch,
}
import std.collections.{ parse_args }
import std.png.{ write_png }
import std.io.{ write_bytes }

const WIDTH: f32 = 720.0
const HEIGHT: f32 = 440.0
const BACKGROUND: Color = Color { r: 0xF4, g: 0xF4, b: 0xF6 }

let main = () -> u8 => {
  let args = parse_args(["--script", "--png"])
  var fonts = fonts_new()
  if !fonts.add_system_font() {
    println("no font: none of ui.text's SYSTEM_FONTS is here")
    return 1
  }
  let _ = fonts.add_system_fallbacks()
  let app = App {
    view: view,
    update: update,
    subscriptions: (_: State) -> []Subscription<Event> => [OnFilesDropped(Dropped)],
    background: BACKGROUND,
    window_overflow: OverflowVisible,
  }
  if let Some(script) = args.value("--script") {
    let Ok(steps) = parse_steps(script) else {
      println("the script does not parse")
      return 1
    }
    let window = match sdl3.open("Panels", WIDTH, HEIGHT) {
      Ok(w) => w,
      Err(why) => {
        println(why)
        fonts.close()
        return 2
      },
    }
    let played = running(
      app,
      State {},
      timed_platform(steps, Size { w: WIDTH, h: HEIGHT }),
      window.renderer,
      fonts
    )
    while step_running(played) {}
    let s = played.host.state
    println("width ${s.width}, height ${s.height}, speed ${s.speed}, palette ${s.palette}, collision ${s.collision}")
    println("side ${s.side}, columns ${[c in s.columns | "${c.width}"].join(" ")}")
    println("sprites ${s.sprites.join(" ")}, selected ${s.selected}")
    var status: u8 = 0
    if let Some(path) = args.value("--png") {
      if !save(
        played.renderer,
        played.fonts,
        played.host.main_laid(),
        path
      ) { status = 1 }
    }
    sdl3.close(window.platform, played.renderer)
    fonts.close()
    return status
  }
  let window = match gpu.open("Panels", WIDTH, HEIGHT) {
    Ok(w) => w,
    Err(why) => {
      println(why)
      fonts.close()
      return 2
    },
  }
  var platform = window.platform
  var renderer = window.renderer
  let _ = run(app, State {}, platform, renderer, fonts)
  gpu.close(platform, renderer)
  fonts.close()
  0
}

/// The side panel's width; the sprite's size, speed and palette, and whether its Collision
/// section is open and it is solid; the table's columns, sprites and the one selected.
struct State {
  side: f32 = 260.0,
  width: f64 = 16.0,
  height: f64 = 16.0,
  speed: f64 = 1.5,
  palette: i64 = 0,
  collision: bool = true,
  solid: bool = false,
  columns: []TableColumn = [
    TableColumn { title: "Name", width: 160.0 },
    TableColumn { title: "Width", width: 70.0 },
    TableColumn { title: "Height", width: 70.0 },
  ],
  sprites: []string = ["hero.png", "slime.png", "coin.png"],
  selected: i64 = 0,
}

data Event =
  Side(f32)
  | Width(f64)
  | Height(f64)
  | Speed(f64)
  | Palette(i64)
  | ToggleCollision
  | Solid
  | Select(i64)
  | Resize(i64, f32)
  | Dropped([]string)

let update = pure (state: State, event: Event) -> (State, []Command<Event>) => {
  let next = match event {
    Side(w) => State { state | side: w.min(WIDTH - 200.0) },
    Width(w) => State { state | width: w },
    Height(h) => State { state | height: h },
    Speed(v) => State { state | speed: v },
    Palette(k) => State { state | palette: k },
    ToggleCollision => State { state | collision: !state.collision },
    Solid => State { state | solid: !state.solid },
    Select(i) => State { state | selected: i },
    Resize(i, w) => State {
      state |
      columns: [k in 0..<state.columns.len() | if k == i { TableColumn { state.columns[k] | width: w } } else { state.columns[k] }]
    },
    // A dropped file joins the sprites by its name, selected.
    Dropped(paths) => {
      let names = [p in paths | p.split("/")[p.split("/").len() - 1]]
      State {
        state | sprites: [...state.sprites, ...names],
        selected: state.sprites.len() + names.len() - 1
      }
    },
  }
  (next, [])
}

/// The window: the properties and the sprites, the edge between them dragged.
let view = pure (state: State) -> Node<Event> => themed::<Event>(light_theme(), sheet(), [
  splitter(properties(state), sprites(state), state.side, Side),
])

/// The form's labels one width, so its fields line up.
let sheet = pure () -> Sheet => Sheet {
  rules: [Rule { selector: "NumberField::label", style: Style { min_width: Some(52.0) } }],
}

/// The sprite's properties, a form down the side.
let properties = pure (state: State) -> Node<Event> => padding(insets(12.0), column([
  separator("Sprite"),
  number_field(NumberSpec { value: state.width, min: 8.0, max: 64.0, step: 8.0, label: "Width" }, Width),
  number_field(NumberSpec { value: state.height, min: 8.0, max: 64.0, step: 8.0, label: "Height" }, Height),
  number_field(
    NumberSpec { value: state.speed, min: 0.0, max: 10.0, step: 0.25, decimals: 2, label: "Speed" },
    Speed
  ),
  separator("Palette"),
  radio_group([k in 0..<4 | "Palette ${k}"], state.palette, Palette),
  disclosure("Collision", state.collision, column([
    checkbox("Solid", state.solid, Solid),
    text("Hit box follows the sprite's size."),
  ]).with_style(Style { gap: Some(6.0), padding: Some(insets(6.0)) }), ToggleCollision),
  separator(),
  progress(0.4),
]).aligned(MainStart, CrossStretch).with_style(Style { gap: Some(10.0) }))

/// The sprites, each a row of the table.
let sprites = pure (state: State) -> Node<Event> => padding(insets(12.0), column([
  text("Sprites — drop a file on the window to add it"),
  expanded(table(
    state.columns,
    [name in state.sprites | [text::<Event>(name), text::<Event>("${state.width}"), text::<Event>("${state.height}")]],
    state.selected,
    Select,
    Resize
  )),
]).aligned(MainStart, CrossStretch).with_style(Style { gap: Some(8.0) }))

/// `laid` — the window as the host last laid it out — drawn without showing it, and written to
/// `path` as a PNG.
let save = (
  renderer: SdlRenderer,
  fonts: Fonts,
  laid: Laid<Event>,
  path: string
) -> bool => {
  var r = renderer
  var f = fonts
  var atlas = glyph_atlas()
  let ops = paint(laid, Point {}, 1.0, f, atlas, r)
  let Some(frame) = capture(r, BACKGROUND, ops) else { return false }
  var bytes: []u8 = []
  for p in frame.argb {
    bytes.push(u8((p >> 16) & 0xFF))
    bytes.push(u8((p >> 8) & 0xFF))
    bytes.push(u8(p & 0xFF))
    bytes.push(u8((p >> 24) & 0xFF))
  }
  match write_png(frame.width, frame.height, bytes) {
    Ok(png) => write_bytes(path, png),
    Err(_) => false,
  }
}
