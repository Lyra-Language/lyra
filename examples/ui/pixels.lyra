// Pixels: a small pixel editor — its canvas a picture of the program's own (`ui.layout`'s
// `PaintPicture`), kept by the host as a texture and written again only when a stroke moves its
// revision, drawn zoomed with its pixels crisp under a grid and the pixel the pointer is over.
//
//     lyrac run examples/ui/pixels.lyra
//     lyrac run examples/ui/pixels.lyra -- --script "down:300,200 move:360,240 up:360,240" --png FILE
//     lyrac run examples/ui/pixels.lyra -- --size 512 --script "…" --time
//
// Draw with the left button, erase with the right; pick a colour on the left; − and + (or
// Cmd/Ctrl + the wheel) zoom, the wheel pans. **The update is pure**: each stroke's step copies
// the pixels it changes, which is what `--size` and `--time` measure (`ui/VEGA.md` §12). The
// second form plays a script (`ui.script`) headless and prints what it drew; `--png FILE`
// writes the last frame; `--time` the passes the script took and their average cost.

import ui.sdl3
import ui.sdl3.{ SdlRenderer, capture }
import ui.gpu
import ui.app.{ App, sandbox, run, running, follow_resizes, step_running }
import ui.script.{ timed_platform, parse_steps }
import ui.backend.{ Primary, Secondary }
import ui.draw.{ Point, Size, Rect, Color, Image, PictureSource, Fill, Border, radius }
import ui.text.{ Fonts, fonts_new, glyph_atlas }
import ui.style.{ Style, insets, light_theme, OverflowVisible }
import ui.layout.{
  Node,
  Laid,
  PaintArea,
  PaintOp,
  PaintDraw,
  PaintPicture,
  RawInput,
  KeyInput,
  TextInput,
  PointerInput,
  PointerPress,
  PointerRelease,
  PointerMove,
  PointerWheel,
  MainStart,
  CrossStretch,
  column,
  row,
  expanded,
  text,
  button,
  painted,
  paint,
}
import std.collections.{ parse_args }
import std.png.{ write_png }
import std.io.{ write_bytes }

const WIDTH: f32 = 760.0
const HEIGHT: f32 = 520.0

let main = () -> u8 => {
  let args = parse_args(["--script", "--png", "--size"])
  var side: i64 = 32
  if let Some(text) = args.value("--size") {
    let Some(n) = text.parse_i64() else {
      println("--size wants a number of pixels, not ${text}")
      return 1
    }
    side = n.max(1).min(MAX_SIDE)
  }
  var fonts = fonts_new()
  if !fonts.add_system_font() {
    println("no font: none of ui.text's SYSTEM_FONTS is here")
    return 1
  }
  let start = new_state(side)
  let background = light_theme().colors.background
  let app = App { sandbox(view, update, background) | window_overflow: OverflowVisible }
  var status: u8 = 0
  if let Some(script) = args.value("--script") {
    // Played headless through SDL's 2D renderer, whose frame `--png` reads back.
    let window = match sdl3.open("Pixels", WIDTH, HEIGHT) {
      Ok(w) => w,
      Err(why) => {
        println(why)
        fonts.close()
        return 2
      },
    }
    var renderer = window.renderer
    match parse_steps(script) {
      Ok(steps) => {
        let played = running(
          app,
          start,
          timed_platform(steps, Size { w: WIDTH, h: HEIGHT }),
          renderer,
          fonts
        )
        follow_resizes(played)
        let began = wall_clock_nanos()
        var passes = 0
        while step_running(played) { passes += 1 }
        let took = wall_clock_nanos() - began
        let s = played.host.state
        println("${s.side}x${s.side} at ${s.zoom}x, colour ${s.color}: ${coloured(s)} pixels coloured, revision ${s.revision}")
        if args.has("--time") {
          let each = f64(took) / f64(passes.max(1)) / 1000000.0
          println("${passes} passes, ${each} ms a pass")
        }
        if let Some(path) = args.value("--png") {
          if !save(
            played.renderer,
            played.fonts,
            played.host.main_laid(),
            background,
            path
          ) {
            status = 1
          }
        }
        renderer = played.renderer
        fonts = played.fonts
      },
      Err(why) => {
        println("the script: ${why}")
        status = 1
      },
    }
    sdl3.close(window.platform, renderer)
  } else {
    // On the GPU where there is one.
    let window = match gpu.open("Pixels", WIDTH, HEIGHT) {
      Ok(w) => w,
      Err(why) => {
        println(why)
        fonts.close()
        return 2
      },
    }
    var platform = window.platform
    var renderer = window.renderer
    let _ = run(app, start, platform, renderer, fonts)
    gpu.close(platform, renderer)
  }
  fonts.close()
  status
}

/// The picture — `side` pixels a side, `0` transparent, else `0xAARRGGBB` — and its revision,
/// moved by every change to it; the colour drawn with; how it is shown; and the stroke under
/// way, if any.
struct State {
  side: i64,
  pixels: []u32,
  revision: i64 = 1,
  color: i64 = 8,
  zoom: i64 = 12,
  pan: Point = Point {},
  canvas: Size = Size {},
  stroke: Maybe<Stroke> = None,
  hover: Maybe<Pixel> = None,
}

/// A stroke under way: the last pixel it reached, and whether it erases.
struct Stroke {
  last: Pixel,
  erasing: bool,
}

struct Pixel {
  x: i64,
  y: i64,
}

data Event =
  Pressed(Point, bool)
  | Moved(Point)
  | Released
  | Wheeled(f32, f32, bool)
  | Chose(i64)
  | Zoomed(i64)
  | Cleared
  | CanvasSized(Size)

const MAX_SIDE: i64 = 2048
const MIN_ZOOM: i64 = 1
const MAX_ZOOM: i64 = 48
/// How far a line of the wheel pans, in units.
const WHEEL_STEP: f32 = 24.0

/// A clear picture `side` pixels a side, at a zoom that shows it whole in the window.
let new_state = pure (side: i64) -> State => {
  var pixels: []u32 = []
  pixels.reserve(side * side)
  for _ in 0..<side * side { pixels.push(0) }
  State {
    side: side,
    pixels: pixels,
    zoom: ((HEIGHT * 0.75).floor() / side).max(MIN_ZOOM).min(MAX_ZOOM)
  }
}

let update = pure (state: State, event: Event) -> State => match event {
  Pressed(at, erasing) => {
    let Some(p) = state.pixel_at(at) else { return state }
    let next = state.drawn(p, p, erasing)
    State { next | stroke: Some(Stroke { last: p, erasing: erasing }) }
  },
  Moved(at) => {
    let hover = state.pixel_at(at)
    match state.stroke {
      Some(stroke) => {
        // Off the canvas the stroke waits where it left; back on, it joins up from there.
        let Some(p) = hover else { return State { state | hover: None } }
        let next = state.drawn(stroke.last, p, stroke.erasing)
        State { next | hover: hover, stroke: Some(Stroke { stroke | last: p }) }
      },
      None => State { state | hover: hover },
    }
  },
  Released => State { state | stroke: None },
  Wheeled(dx, dy, zooms) =>
    if zooms {
      state.zoomed(if dy < 0.0 { 1 } else if dy > 0.0 { -1 } else { 0 })
    } else {
      State {
        state | pan: Point {
          x: state.pan.x - dx * WHEEL_STEP,
          y: state.pan.y - dy * WHEEL_STEP
        }
      }
    },
  Chose(i) => State { state | color: i },
  Zoomed(by) => state.zoomed(by),
  Cleared => {
    if coloured(state) == 0 { return state }
    let fresh = new_state(state.side)
    State { state | pixels: fresh.pixels, revision: state.revision + 1 }
  },
  CanvasSized(size) => State { state | canvas: size },
}

impl State {
  /// The canvas's top-left corner in the painted element: centred, then panned, on a whole
  /// unit so the pixels' edges are.
  let origin = pure (self, area: Size) -> Point => {
    let shown = f32(self.side * self.zoom)
    Point {
      x: f32(((area.w - shown) / 2.0).floor()) + self.pan.x,
      y: f32(((area.h - shown) / 2.0).floor()) + self.pan.y,
    }
  }

  /// The picture's pixel under `at`, a point in the painted element, if it is on the picture.
  let pixel_at = pure (self, at: Point) -> Maybe<Pixel> => {
    let o = self.origin(self.canvas)
    let fx = (at.x - o.x) / f32(self.zoom)
    let fy = (at.y - o.y) / f32(self.zoom)
    if fx < 0.0 || fy < 0.0 { return None }
    let x = i64(fx.floor())
    let y = i64(fy.floor())
    if x >= self.side || y >= self.side { return None }
    Some(Pixel { x: x, y: y })
  }

  /// The state with a line from `from` to `to` drawn in the chosen colour, or erased: the
  /// pixels copied and the revision moved only where the line changes one — the update is
  /// pure, so it cannot write the pixels the last state holds.
  let drawn = pure (self, from: Pixel, to: Pixel, erasing: bool) -> State => {
    let value = if erasing { u32(0) } else { PALETTE[self.color] }
    let line = line_between(from, to)
    var changes = false
    for p in line {
      if self.pixels[p.y * self.side + p.x] != value { changes = true }
    }
    if !changes { return self }
    var pixels = [...self.pixels]
    for p in line { pixels[p.y * self.side + p.x] = value }
    State { self | pixels: pixels, revision: self.revision + 1 }
  }

  /// The zoom `by` steps in (out for a negative), within its limits.
  let zoomed = pure (self, by: i64) -> State =>
    State { self | zoom: (self.zoom + by).max(MIN_ZOOM).min(MAX_ZOOM) }
}

/// The pixels from `a` to `b`, both included, a pixel a step along the longer axis (Bresenham's).
let line_between = pure (a: Pixel, b: Pixel) -> []Pixel => {
  let dx = (b.x - a.x).abs()
  let dy = -(b.y - a.y).abs()
  let sx: i64 = if a.x < b.x { 1 } else { -1 }
  let sy: i64 = if a.y < b.y { 1 } else { -1 }
  var err = dx + dy
  var x = a.x
  var y = a.y
  var line: []Pixel = []
  loop {
    line.push(Pixel { x: x, y: y })
    if x == b.x && y == b.y { break }
    let e2 = 2 * err
    if e2 >= dy {
      err += dy
      x += sx
    }
    if e2 <= dx {
      err += dx
      y += sy
    }
  }
  line
}

/// How many of the picture's pixels are not transparent.
let coloured = pure (state: State) -> i64 => {
  var n = 0
  for p in state.pixels {
    if p != 0 { n += 1 }
  }
  n
}

/// The palette down the left, the zoom and Clear under it, and the canvas filling the rest.
let view = pure (state: State) -> Node<Event> => row([
  column([
    palette(state.color),
    text("${state.side}×${state.side}, ${state.zoom}×"),
    row([button("−", Zoomed(-1)), button("+", Zoomed(1))]).with_style(Style { gap: Some(6.0) }),
    button("Clear", Cleared),
  ]).with_style(Style { padding: Some(insets(12.0)), gap: Some(10.0) }),
  expanded(canvas(state)),
]).aligned(MainStart, CrossStretch)

/// The canvas: a grey field, the picture over it at the zoom — its texels crisp — a grid
/// where the pixels are large enough, and the pixel the pointer is over outlined.
let canvas = pure (state: State) -> Node<Event> => {
  let source = PictureSource {
    key: "canvas",
    image: Image { width: state.side, height: state.side, argb: state.pixels, pixelated: true },
    revision: state.revision,
  }
  painted::<Event>(
    (area: PaintArea) -> []PaintOp => {
      let o = state.origin(area.size)
      let z = f32(state.zoom)
      let shown = f32(state.side) * z
      let whole = Rect { x: o.x, y: o.y, w: shown, h: shown }
      var ops: []PaintOp = [
        PaintDraw(Fill(Rect { w: area.size.w, h: area.size.h }, radius(0.0), DESK)),
        PaintDraw(Fill(whole, radius(0.0), FIELD)),
        PaintPicture(source, Rect { w: f32(state.side), h: f32(state.side) }, whole, 1.0),
      ]
      // A line a pixel's edge, only while there are few enough to see between.
      if state.zoom >= GRID_ZOOM && state.side <= GRID_MOST {
        let thin = 1.0 / area.scale
        for i in 0..<=state.side {
          let at = f32(i) * z
          ops.push(PaintDraw(Fill(
            Rect { x: o.x + at, y: o.y, w: thin, h: shown },
            radius(0.0),
            GRID
          )))
          ops.push(PaintDraw(Fill(
            Rect { x: o.x, y: o.y + at, w: shown, h: thin },
            radius(0.0),
            GRID
          )))
        }
      }
      if let Some(p) = state.hover {
        let cell = Rect { x: o.x + f32(p.x) * z, y: o.y + f32(p.y) * z, w: z, h: z }
        ops.push(PaintDraw(Border(cell, radius(0.0), 1.0, HOVER)))
      }
      ops
    },
    Some(CanvasSized)
  ).takes_input(RawInput {
    on_key: (_: KeyInput) -> Maybe<Event> => None,
    on_text: (_: TextInput) -> Maybe<Event> => None,
    on_pointer: (p: PointerInput) -> Maybe<Event> => match p.kind {
      PointerPress(Primary, _) => Some(Pressed(p.at, false)),
      PointerPress(Secondary, _) => Some(Pressed(p.at, true)),
      PointerPress(_, _) => None,
      PointerRelease(_) => Some(Released),
      PointerMove => Some(Moved(p.at)),
      PointerWheel(dx, dy) => Some(Wheeled(dx, dy, p.mods.primary)),
    },
    caret: None,
  })
}

/// The palette's colours, two columns of squares, the chosen one ringed; a press chooses.
let palette = pure (chosen: i64) -> Node<Event> => {
  let rows = (PALETTE.len() + 1) / 2
  painted::<Event>((_: PaintArea) -> []PaintOp => {
    var ops: []PaintOp = []
    for i in 0..<PALETTE.len() {
      let at = swatch_at(i)
      let c = PALETTE[i]
      let color = Color {
        r: u8((c >> 16) & 0xFF),
        g: u8((c >> 8) & 0xFF),
        b: u8(c & 0xFF)
      }
      ops.push(PaintDraw(Fill(at, radius(3.0), color)))
      ops.push(PaintDraw(Border(at, radius(3.0), 1.0, EDGE)))
      if i == chosen {
        ops.push(PaintDraw(Border(
          Rect { x: at.x - 3.0, y: at.y - 3.0, w: at.w + 6.0, h: at.h + 6.0 },
          radius(5.0),
          2.0,
          HOVER
        )))
      }
    }
    ops
  }).with_style(Style {
    width: Some(2.0 * SWATCH + 3.0 * SWATCH_GAP),
    height: Some(f32(rows) * SWATCH + f32(rows + 1) * SWATCH_GAP),
  }).takes_input(RawInput {
    on_key: (_: KeyInput) -> Maybe<Event> => None,
    on_text: (_: TextInput) -> Maybe<Event> => None,
    on_pointer: (p: PointerInput) -> Maybe<Event> => match p.kind {
      PointerPress(_, _) => {
        for i in 0..<PALETTE.len() {
          let r = swatch_at(i)
          if p.at.x >= r.x && p.at.x < r.x + r.w && p.at.y >= r.y && p.at.y < r.y + r.h {
            return Some(Chose(i))
          }
        }
        None
      },
      _ => None,
    },
    caret: None,
  })
}

/// Where the palette's `i`th square is, in its element.
let swatch_at = pure (i: i64) -> Rect => Rect {
  x: SWATCH_GAP + f32(i % 2) * (SWATCH + SWATCH_GAP),
  y: SWATCH_GAP + f32(i / 2) * (SWATCH + SWATCH_GAP),
  w: SWATCH,
  h: SWATCH,
}

/// PICO-8's sixteen colours, opaque.
const PALETTE: []u32 = [
  0xFF000000,
  0xFF1D2B53,
  0xFF7E2553,
  0xFF008751,
  0xFFAB5236,
  0xFF5F574F,
  0xFFC2C3C7,
  0xFFFFF1E8,
  0xFFFF004D,
  0xFFFFA300,
  0xFFFFEC27,
  0xFF00E436,
  0xFF29ADFF,
  0xFF83769C,
  0xFFFF77A8,
  0xFFFFCCAA,
]

const SWATCH: f32 = 26.0
const SWATCH_GAP: f32 = 6.0
/// The grid is drawn from this zoom up, on a picture no more than this many pixels a side.
const GRID_ZOOM: i64 = 6
const GRID_MOST: i64 = 128

const DESK: Color = Color { r: 0x3A, g: 0x3D, b: 0x44 }
const FIELD: Color = Color { r: 0xCF, g: 0xD2, b: 0xD8 }
const GRID: Color = Color { r: 0x00, g: 0x00, b: 0x00, a: 0x30 }
const HOVER: Color = Color { r: 0x2F, g: 0x6F, b: 0xD8 }
const EDGE: Color = Color { r: 0x00, g: 0x00, b: 0x00, a: 0x28 }

/// `laid` — the window as the host last laid it out — drawn without showing it, and written to
/// `path` as a PNG.
let save = (
  renderer: SdlRenderer,
  fonts: Fonts,
  laid: Laid<Event>,
  background: Color,
  path: string
) -> bool => {
  var r = renderer
  var f = fonts
  var atlas = glyph_atlas()
  let ops = paint(laid, Point {}, 1.0, f, atlas, r)
  let Some(frame) = capture(r, background, ops) else { return false }
  var bytes: []u8 = []
  for p in frame.argb {
    bytes.push(u8((p >> 16) & 0xFF))
    bytes.push(u8((p >> 8) & 0xFF))
    bytes.push(u8(p & 0xFF))
    bytes.push(u8((p >> 24) & 0xFF))
  }
  match write_png(frame.width, frame.height, bytes) {
    Ok(png) => write_bytes(path, png),
    Err(_) => false,
  }
}
