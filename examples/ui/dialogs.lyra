// Tooltips and a modal dialog: `ui.layout`'s `.tooltip` and `modal`, the view the markup of
// dialogs_view.lui (ui/VEGA.md §9). The toolbar's buttons
// each have a tooltip, shown once the pointer rests on one for half a second; Open's has a
// shortcut in it. Close, with the title edited since it was saved, asks first: a dialog over
// the dimmed window, which takes the focus — on its name field — keeps Tab inside it, lets no
// press through to the window under it, and gives the focus back when it closes. Escape
// cancels it.
//
//     lyrac run examples/ui/dialogs.lyra
//     build/lui examples/ui/dialogs_view.lui      # after editing the markup
//     lyrac run examples/ui/dialogs.lyra -- --script "Tab Tab Tab Enter" [--png FILE]
//
// **The second form** plays a script (`ui.script`) headless, prints what happened and the
// tooltip showing at its end, and with `--png FILE` writes the last frame.

import ui.sdl3
import ui.sdl3.{ SdlRenderer, capture }
import ui.gpu
import ui.app.{ sandbox, run, running, step_running }
import ui.script.{ timed_platform, parse_steps }
import ui.interact.{ find }
import ui.draw.{ Point, Size, Color }
import ui.text.{ Fonts, fonts_new, glyph_atlas }
import ui.layout.{ Laid, paint }
import dialogs_view.{ State, Event, view, update }
import std.collections.{ parse_args }
import std.png.{ write_png }
import std.io.{ write_bytes }

const WIDTH: f32 = 560.0
const HEIGHT: f32 = 380.0
const BACKGROUND: Color = Color { r: 0xF4, g: 0xF4, b: 0xF6 }

let main = () -> u8 => {
  let args = parse_args(["--script", "--png"])
  var fonts = fonts_new()
  if !fonts.add_system_font() {
    println("no font: none of ui.text's SYSTEM_FONTS is here")
    return 1
  }
  let _ = fonts.add_system_fallbacks()
  let app = sandbox(view, update, BACKGROUND)
  if let Some(script) = args.value("--script") {
    let Ok(steps) = parse_steps(script) else {
      println("the script does not parse")
      return 1
    }
    let window = match sdl3.open("Dialogs", WIDTH, HEIGHT) {
      Ok(w) => w,
      Err(why) => {
        println(why)
        fonts.close()
        return 2
      },
    }
    let played = running(
      app,
      State {},
      timed_platform(steps, Size { w: WIDTH, h: HEIGHT }),
      window.renderer,
      fonts
    )
    while step_running(played) {}
    for line in played.host.state.log { println(line) }
    let shown = played.host.main_laid()
    let tip = match find(shown, played.host.windows[0].ui.state.tip, Point {}) {
      Some(f) => f.laid.description,
      None => "none",
    }
    println("tooltip: ${tip}")
    var status: u8 = 0
    if let Some(path) = args.value("--png") {
      if !save(played.renderer, played.fonts, shown, path) { status = 1 }
    }
    sdl3.close(window.platform, played.renderer)
    fonts.close()
    return status
  }
  let window = match gpu.open("Dialogs", WIDTH, HEIGHT) {
    Ok(w) => w,
    Err(why) => {
      println(why)
      fonts.close()
      return 2
    },
  }
  var platform = window.platform
  var renderer = window.renderer
  let _ = run(app, State {}, platform, renderer, fonts)
  gpu.close(platform, renderer)
  fonts.close()
  0
}

/// The document's title and the one last saved; whether Close is asking, and the name the
/// dialog will save under; and what happened, newest last.
/// `laid` — the window as the host last laid it out — drawn without showing it, and written to
/// `path` as a PNG.
let save = (
  renderer: SdlRenderer,
  fonts: Fonts,
  laid: Laid<Event>,
  path: string
) -> bool => {
  var r = renderer
  var f = fonts
  var atlas = glyph_atlas()
  let ops = paint(laid, Point {}, 1.0, f, atlas, r)
  let Some(frame) = capture(r, BACKGROUND, ops) else { return false }
  var bytes: []u8 = []
  for p in frame.argb {
    bytes.push(u8((p >> 16) & 0xFF))
    bytes.push(u8((p >> 8) & 0xFF))
    bytes.push(u8(p & 0xFF))
    bytes.push(u8((p >> 24) & 0xFF))
  }
  match write_png(frame.width, frame.height, bytes) {
    Ok(png) => write_bytes(path, png),
    Err(_) => false,
  }
}
