/// What the interface can be asked to do.
pub data Event =
  ToggleSound
  | ToggleMusic
  | AskReset
  | ConfirmReset
  | CancelReset
  | AskQuit
  | ConfirmQuit
  | CancelQuit
  | Load(i64)
  | Rename(string)
  | NameDone
  | NameSaved(bool)
  | SetVolume(f32)
  | SetAccent(u32)
  | ClearNotice
  | Looked(Appearance)

pub struct State {
  sound: bool = true,
  music: bool = false,
  asking_reset: bool = false,
  asking_quit: bool = false,
  resets: i64 = 0,
  loaded: i64 = -1,
  quit: bool = false,
  /// The player's name as typed, and as last saved (to the file `name.txt`).
  name: string = "Hero",
  saved_name: string = "",
  commits: i64 = 0,
  volume: f32 = 0.5,
  /// A colour, `0xRRGGBB`.
  accent: u32 = 0x3C78D8,
  /// A line shown for two seconds after something happens.
  notice: string = "",
  /// The system's look, followed.
  dark: bool = false,
}

/// `s` after `event`, and the work it asks for.
pub let update = pure (s: State, event: Event) -> (State, []Command<Event>) => match event {
  ToggleSound => (State { s | sound: !s.sound }, []),
  ToggleMusic => (State { s | music: !s.music }, []),
  AskReset => (State { s | asking_reset: true }, []),
  ConfirmReset => noticed(State { s | asking_reset: false, resets: s.resets + 1 }, "Every save erased."),
  CancelReset => (State { s | asking_reset: false }, []),
  AskQuit => (State { s | asking_quit: true }, []),
  ConfirmQuit => (State { s | quit: true }, [QuitApp]),
  CancelQuit => (State { s | asking_quit: false }, []),
  Load(slot) => noticed(State { s | loaded: slot }, "Slot ${slot + 1} loaded."),
  Rename(name) => (State { s | name: name }, []),
  NameDone => (State { s | commits: s.commits + 1 }, [WriteFile("name.txt", s.name, NameSaved)]),
  NameSaved(ok) => if ok {
    noticed(State { s | saved_name: s.name }, "Saved ${s.name}.")
  } else {
    noticed(s, "Could not save the name.")
  },
  SetVolume(v) => (State { s | volume: v }, []),
  SetAccent(c) => (State { s | accent: c }, []),
  ClearNotice => (State { s | notice: "" }, []),
  Looked(look) => (State { s | dark: look == DarkMode }, []),
}

/// `s` showing `what`, cleared again in two seconds.
let noticed = pure (s: State, what: string) -> (State, []Command<Event>) =>
  (State { s | notice: what }, [After(2000, ClearNotice)])

/// The system's look, followed while the program runs.
pub let subscriptions = pure (_: State) -> []Subscription<Event> => [OnAppearance(Looked)]

/// The theme for the state: the system's look.
pub let theme_for = pure (s: State) -> Theme => if s.dark { dark_theme() } else { light_theme() }

/// A colour's swatch: a square of it, to pick it, ringed while it is the one picked.
let swatch = pure (s: State, rgb_hex: u32) -> Node<Event> => sized(Some(28.0), Some(28.0), [
  button("", SetAccent(rgb_hex))
    .with_class(if s.accent == rgb_hex { "swatch picked" } else { "swatch" })
    .with_style(Style { background: Some(rgb(rgb_hex)) })
    .labelled("accent #${rgb_hex}"),
])

