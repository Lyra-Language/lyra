import ui.gpu
import ui.app.{ step_running }
import temp_convert_view.{ BLANK_STATE, view, update, subscriptions, WINDOW }

let main = () -> u8 => {
  let window = match gpu.open_app(WINDOW, view, update, subscriptions, BLANK_STATE) {
    Ok(w) => w,
    Err(why) => {
      println(why)
      return 1
    },
  }
  // The loop is `main`'s own, for `lyrac run --live`.
  while step_running(window) {}
  gpu.close_app(window)
  0
}
