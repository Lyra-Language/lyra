import ui.backend.{ Chord, Modifiers, Character }
import ui.style.{ light_theme }
import ui.layout.{ row, spelled }

pub struct State {
  title: string = "Untitled",
  saved: string = "Untitled",
  asking: bool = false,
  name: string = "",
  log: []string = [],
}

pub data Event = Did(string) | Edited(string) | Closed | Named(string) | Saved | Discarded | Cancelled

pub let update = pure (state: State, event: Event) -> State => match event {
  Did(what) => State { state | log: [...state.log, what] },
  Edited(title) => State { state | title: title },
  // Close asks first when the title has changed since it was saved.
  Closed => if state.title == state.saved {
    State { state | log: [...state.log, "closed"] }
  } else {
    State { state | asking: true, name: state.title, log: [...state.log, "asked"] }
  },
  Named(name) => State { state | name: name },
  Saved => State {
    state |
    asking: false,
    title: state.name,
    saved: state.name,
    log: [...state.log, "saved as ${state.name}"]
  },
  Discarded => State { state | asking: false, saved: state.title, log: [...state.log, "closed without saving"] },
  Cancelled => State { state | asking: false, log: [...state.log, "cancelled"] },
}

/// Open's tooltip: what it does, and its shortcut dimmed beside it.
let open_tip = pure () -> Node<Event> => row([
  text::<Event>("Open a document"),
  spelled::<Event>(Chord { key: Character('o'), mods: Modifiers { primary: true } })
    .with_style(Style { opacity: Some(0.6) }),
]).with_style(Style { gap: Some(10.0) })

