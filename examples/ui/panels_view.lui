<!--
  A panel of forms beside a table, as markup (ui/VEGA.md §9): number fields, radio buttons, a
  collapsing section, separators with text and a progress bar down the side; the sprites in a
  table, a row each from a `<for>`; the edge between them a splitter. `build/lui
  examples/ui/panels_view.lui` writes panels_view.lyra beside it, which panels.lyra runs.
-->

<script target="ui">
  import ui.style.{ light_theme }
  import ui.app.{ Command }
  import ui.layout.{ TableColumn }

  /// How wide the window opens; the side panel stops 200 short of it.
  pub const WIDTH: f32 = 720.0

  /// The side panel's width; the sprite's size, speed and palette, and whether its Collision
  /// section is open and it is solid; the table's columns, sprites and the one selected.
  pub struct State {
    side: f32 = 260.0,
    width: f64 = 16.0,
    height: f64 = 16.0,
    speed: f64 = 1.5,
    palette: i64 = 0,
    collision: bool = true,
    solid: bool = false,
    columns: []TableColumn = [
      TableColumn { title: "Name", width: 160.0 },
      TableColumn { title: "Width", width: 70.0 },
      TableColumn { title: "Height", width: 70.0 },
    ],
    sprites: []string = ["hero.png", "slime.png", "coin.png"],
    selected: i64 = 0,
  }

  pub data Event =
    Side(f32)
    | Width(f64)
    | Height(f64)
    | Speed(f64)
    | Palette(i64)
    | ToggleCollision
    | Solid
    | Select(i64)
    | Resize(i64, f32)
    | Dropped([]string)

  pub let update = pure (state: State, event: Event) -> (State, []Command<Event>) => {
    let next = match event {
      Side(w) => State { state | side: w.min(WIDTH - 200.0) },
      Width(w) => State { state | width: w },
      Height(h) => State { state | height: h },
      Speed(v) => State { state | speed: v },
      Palette(k) => State { state | palette: k },
      ToggleCollision => State { state | collision: !state.collision },
      Solid => State { state | solid: !state.solid },
      Select(i) => State { state | selected: i },
      Resize(i, w) => State {
        state |
        columns: [k in 0..<state.columns.len() | if k == i { TableColumn { state.columns[k] | width: w } } else { state.columns[k] }]
      },
      // A dropped file joins the sprites by its name, selected.
      Dropped(paths) => {
        let names = [p in paths | p.split("/")[p.split("/").len() - 1]]
        State {
          state | sprites: [...state.sprites, ...names],
          selected: state.sprites.len() + names.len() - 1
        }
      },
    }
    (next, [])
  }
</script>

<!-- The form's labels one width, so its fields line up. -->
<style global name="panels_sheet">
  NumberField::label { min-width: 52 }
</style>

<!-- The window: the properties and the sprites, the edge between them dragged. -->
<component name="view" props={{ s: State }} event={Event}>
  <Themed theme={light_theme()} sheet={panels_sheet(light_theme())}>
    <Splitter at={s.side} on_drag={Side}>
      <properties s={s}/>
      <sprites s={s}/>
    </Splitter>
  </Themed>
</component>

<!-- The sprite's properties, a form down the side. -->
<component name="properties" props={{ s: State }} event={Event}>
  <Padding all="12">
    <Column cross="stretch" style="gap: 10">
      <Separator>Sprite</Separator>
      <NumberField value={s.width} min="8" max="64" step="8" on_change={Width}>Width</NumberField>
      <NumberField value={s.height} min="8" max="64" step="8" on_change={Height}>Height</NumberField>
      <NumberField value={s.speed} min="0" max="10" step="0.25" decimals="2" on_change={Speed}>Speed</NumberField>
      <Separator>Palette</Separator>
      <RadioGroup options={[k in 0..<4 | "Palette ${k}"]} selected={s.palette} on_change={Palette}/>
      <Disclosure title="Collision" open={s.collision} on_toggle={ToggleCollision}>
        <Column style="gap: 6; padding: 6">
          <Checkbox checked={s.solid} on_toggle={Solid}>Solid</Checkbox>
          <Text>Hit box follows the sprite's size.</Text>
        </Column>
      </Disclosure>
      <Separator/>
      <Progress value="0.4"/>
    </Column>
  </Padding>
</component>

<!-- The sprites, each a row of the table. -->
<component name="sprites" props={{ s: State }} event={Event}>
  <Padding all="12">
    <Column cross="stretch" style="gap: 8">
      <Text>Sprites — drop a file on the window to add it</Text>
      <Expanded>
        <Table columns={s.columns} selected={s.selected} on_select={Select} on_resize={Resize}>
          <for each={name in s.sprites}>
            <TableRow>
              <Text>{name}</Text>
              <Text>{s.width}</Text>
              <Text>{s.height}</Text>
            </TableRow>
          </for>
        </Table>
      </Expanded>
    </Column>
  </Padding>
</component>
