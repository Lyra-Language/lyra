/// A note: its title, the key it is known by whatever its place, and its colour.
pub struct Note {
  title: string,
  id: string,
  color: Color,
}

/// The notes, the one shown, whether lines wrap, which note's swatch is open (`-1` for none),
/// and how many notes have been made.
pub struct State {
  notes: []Note,
  selected: i64 = 0,
  wrap: bool = false,
  open: i64 = -1,
  made: i64 = 0,
}

/// What the menus, the tabs and the swatches say.
pub data Event =
  Add
  | Close(i64)
  | Select(i64)
  | Move(i64, i64)
  | ToggleWrap
  | Opened(i64)
  | Shut
  | Paint(i64, Color)

/// The colours new notes take in turn.
const COLORS: []Color = [
  Color { r: 0xF2, g: 0xC1, b: 0x4E },
  Color { r: 0x7F, g: 0xB0, b: 0x69 },
  Color { r: 0x5D, g: 0x8C, b: 0xD6 },
  Color { r: 0xD9, g: 0x6C, b: 0x75 },
]

/// `s` after `event`.
pub let update = pure (s: State, event: Event) -> State => match event {
  Add => {
    let made = s.made + 1
    let note = Note { title: "Note ${made}", id: "note ${made}", color: COLORS[(made - 1) %% COLORS.len()] }
    let notes = [...s.notes, note]
    State { s | notes: notes, made: made, selected: notes.len() - 1 }
  },
  Close(i) => {
    if i < 0 || i >= s.notes.len() { return s }
    let notes = [k in 0..<s.notes.len() | k != i | s.notes[k]]
    let shown = if s.selected > i || s.selected >= notes.len() { s.selected - 1 } else { s.selected }
    State { s | notes: notes, selected: shown.max(0), open: -1 }
  },
  Select(i) => State { s | selected: i },
  // The note at `from` to `to`'s place; the shown note stays shown.
  Move(from, to) => {
    let rest = [k in 0..<s.notes.len() | k != from | s.notes[k]]
    var placed: []Note = []
    for k in 0..<rest.len() {
      if k == to { placed.push(s.notes[from]) }
      placed.push(rest[k])
    }
    if to >= rest.len() { placed.push(s.notes[from]) }
    let shown = s.notes[s.selected].id
    var selected = 0
    for k, n in placed { if n.id == shown { selected = k } }
    State { s | notes: placed, selected: selected }
  },
  ToggleWrap => State { s | wrap: !s.wrap },
  Opened(k) => State { s | open: k },
  Shut => State { s | open: -1 },
  Paint(k, c) => State { s | notes: [i in 0..<s.notes.len() | if i == k { Note { s.notes[i] | color: c } } else { s.notes[i] }] },
}

