/// What the buttons ask for.
pub data Event = MoreCards | FewerCards

pub struct State {
  cards: i64 = 7,
}

/// `s` after `event`.
pub let update = pure (s: State, event: Event) -> State => match event {
  MoreCards => State { s | cards: s.cards + 1 },
  FewerCards => State { s | cards: (s.cards - 1).max(0) },
}

/// What each card says.
let blurb = pure (i: i64) -> string => if i % 3 == 0 {
  "A card with more to say than the others, so its text wraps onto a few lines."
} else {
  "A short card."
}

