import std.math.{ Complex }

import bindings.raylib.{
  init_window, close_window, should_close, set_target_fps,
  begin_drawing, end_drawing, gen_image_color, unload_image,
  rgb, mouse_position, mouse_wheel, draw_line, Vector2, Color,
  texture_from_image, update_texture, draw_texture, unload_texture, WHITE, BLACK,
  mouse_down, mouse_delta, MOUSE_BUTTON_LEFT, Texture2D,
  set_config_flags, set_window_min_size, window_resized, screen_width, screen_height,
  toggle_borderless, key_pressed, FLAG_WINDOW_RESIZABLE, KEY_F
}

const MAX_ITER = 100
const X_MIN = -2.00
const X_MAX = 0.47
const X_LEN = X_MAX - X_MIN

const Y_MIN = -1.12
const Y_MAX = 1.12
const Y_LEN = Y_MAX - Y_MIN

const ASPECT_RATIO = Y_LEN / X_LEN

const WINDOW_WIDTH = 800

const ESCAPE = 65536.0
// Colour is computed rather than looked up, now that the terminal takes 24-bit values:
// a **hue circle** at full saturation, which is piecewise linear over six sectors and
// closes on itself.
//
// Closing on itself is the point. A palette had to be walked there-and-back to avoid a
// seam where the cycle repeated; a hue circle has no ends to join, so it simply wraps.
// And "running out of colours" stops being a concept — the gradient is continuous, so
// depth costs nothing.
//
// Black is still the set, and the far field still fades to black, but by *value* now
// rather than by landing on a dark palette entry.

/// How far the escape time must travel, in log space, for one full turn of the hue circle.
///
/// **The sweep is logarithmic**, so a turn is a fixed *ratio* rather than a fixed count:
/// at 2.5 the hue comes round once per factor of e^2.5, about 12x. That is what keeps
/// detail legible at depth. The escape counts in a filament spread wider and wider as the
/// view descends — hundreds of iterations between one pixel and its neighbour — and under
/// a fixed count per turn those neighbours land on unrelated points of the circle, which
/// is the confetti the boundary dissolves into. A ratio compresses exactly where the
/// spread grows, so the same structure reads as bands of colour instead of noise.
///
/// It also leaves the colouring **fixed under zoom**: the turn count depends on the escape
/// time alone and not on `max_iter`, so descending does not slowly rotate every hue in the
/// picture the way normalising against the iteration limit would.
const COLOR_CYCLE = 2.5

/// Escape iterations over which the colour fades up from black.
///
/// Without it the fastest-escaping points — the whole far field — come out fully bright,
/// and the picture reads as a flat wash with the structure lost in it. Fading the first
/// few iterations to black is what keeps the boundary the brightest thing on screen.
const FADE_IN = 8.0

/// How much one wheel notch multiplies the scale by. Zoom is **multiplicative**, not a level
/// counter: a fixed step feels like the same movement at every depth, which is what makes
/// it read as smooth rather than as jumping between preset magnifications.
const ZOOM_STEP = 0.85

/// Pixels per side of a preview block: one point computed per 4x4 square while the wheel
/// is still moving, so a preview costs a **sixteenth** of a full render.
///
/// Zoom is the one thing in the program that cannot be cached — the whole set is new at
/// every scale — and a full pass is far too slow to run between two frames, so a sustained
/// scroll would otherwise stutter along at the render's pace rather than the wheel's.
/// A coarse frame is what keeps the gesture attached to the hand; the sharp one follows
/// the moment the wheel stops.
const PREVIEW_STEP = 4

/// Sample points per side within a pixel on the full pass: 2 means 4 points averaged.
///
/// **What is left after the colouring is fixed is not a colour problem.** Deep in the
/// boundary the structure is finer than the pixel grid, so a pixel that stands for one
/// point is reporting a sample of something it cannot resolve, and its neighbour reports
/// a different one — real detail, aliased. Averaging four points over the pixel's area
/// answers with what is actually there.
///
/// **The order the two changes go in matters.** Supersampling the old linear hue sweep
/// made the picture worse: neighbouring samples landed on unrelated points of the colour
/// wheel, and averaging unrelated hues gives grey, so the filaments turned to mush. It is
/// only worth doing once neighbouring samples are near-neighbours in colour too.
///
/// **The full pass only, and only where it shows** — see [refine_edges]. Averaging every
/// pixel costs 4x, and most pixels sit in smooth gradient or inside the set, where four
/// points answer what one did. A preview never supersamples: standing one point in for a
/// 4x4 block is already coarser than the aliasing this fixes.
const SUPERSAMPLE = 2

/// How far apart two neighbouring pixels' colours must be, in the largest channel out of
/// 255, before both are supersampled.
///
/// Measured rather than chosen: at 16, a 50,000x view refines about a fifth of its pixels
/// and lands within 16 of supersampling everything on all but one of 1.9 million, in about
/// 60% of the time. Lower buys nothing visible; higher starts missing the thinnest
/// filaments at depth, where a sub-pixel feature changes a colour by less than it should.
const EDGE_CONTRAST = 16

/// The fractal is drawn into a pixel buffer and uploaded to one texture, and the frame
/// loop only draws that texture. Recomputing the set every frame is the expensive part —
/// a million points, each iterated up to `MAX_ITER` times — and nothing about it changes
/// while the view does not, so it is done once and repeated only when the view moves or
/// the window changes size.
///
/// **One texture, reused.** The pixels go up through [update_texture] rather than through
/// a fresh [texture_from_image] per render: a new texture is a new GPU allocation, and the
/// old one is only released if something remembers to, which is the shape a redraw loop
/// leaks from.
let main = () -> void => {
  var width = WINDOW_WIDTH
  var height = (f64(WINDOW_WIDTH) * ASPECT_RATIO).floor()
  set_config_flags(FLAG_WINDOW_RESIZABLE)
  init_window(width, height, "Lyra - raylib Mandelbrot Set")
  set_window_min_size(320, 240)
  set_target_fps(60)

  let Some(first_texture) = blank_texture(width, height) else {
    close_window()
    println("could not upload the texture")
    return
  }
  var tex = first_texture
  var buffer: []Color = [BLACK; width * height]

  // **The view is a corner and a scale**: the plane point at the window's top-left pixel,
  // and how much of the plane one pixel covers. Not a corner and a span, which is how it
  // began — a span has to be divided by the window's size to mean anything, so a window
  // that can change shape would stretch every pixel the moment it did. A scale per pixel
  // is square by construction, whatever the window's proportions.
  //
  // It opens with the whole set across the width and centred top to bottom.
  var scale = X_LEN / f64(width)
  var min_x = X_MIN
  var min_y = (Y_MIN + Y_MAX) / 2.0 - scale * f64(height) / 2.0

  // Two levels of owing a render, because they resolve at different moments: a preview is
  // owed for *this* frame, and the full pass is owed for the first frame after the wheel
  // goes quiet. The opening frame owes only the sharp one.
  var needs_preview = false
  var needs_full = true

  for !should_close() {
    // **`f` toggles fullscreen**, borderless rather than exclusive: the window grows to
    // cover the screen instead of the display switching video modes. Measured on this
    // machine, both cover the screen exactly, so the one that leaves the display alone
    // wins.
    //
    // A toggle is then simply a resize, and needs nothing of its own: raylib reports it
    // through [window_resized] on the same frame, exactly as it reports a dragged edge.
    if key_pressed(KEY_F) {
      toggle_borderless()
    }

    // **A resize keeps the plane point at the window's centre where it is, and keeps the
    // scale.** The window is a hole onto the plane: making it bigger shows more around what
    // you were looking at, rather than stretching it or re-framing the whole set. Keeping
    // the scale is also what keeps the iteration limit, since detail per pixel is what did
    // not change.
    //
    // The buffer and the texture are both sized to the window, so both are replaced — and
    // the render owed is a preview, because a dragged edge resizes on every frame of the
    // drag, which is the same shape as a turning wheel.
    if window_resized() {
      let new_width = screen_width()
      let new_height = screen_height()
      if new_width > 0 && new_height > 0 {
        min_x += scale * f64(width - new_width) / 2.0
        min_y += scale * f64(height - new_height) / 2.0
        width = new_width
        height = new_height

        unload_texture(tex)
        let Some(resized) = blank_texture(width, height) else {
          close_window()
          println("could not upload a ${width}x${height} texture")
          return
        }
        tex = resized
        buffer = [BLACK; width * height]
        needs_preview = true
      }
    }

    let mouse_pos = mouse_position()

    // **Zoom toward the pointer.** The point of the plane under the cursor is the one
    // thing that must not move, so the new corner is derived from that point rather than
    // from the old corner. Zooming about the centre instead makes whatever you were
    // aiming at drift off the edge as you go in, and the gesture becomes
    // chase-the-fractal.
    let wheel = f64(mouse_wheel())
    if wheel.abs() > 0.0 {
      // The pointer in pixels, clamped to the window.
      let at_x = f64(width) * fraction(f64(mouse_pos.x), f64(width))
      let at_y = f64(height) * fraction(f64(mouse_pos.y), f64(height))
      let anchor_x = min_x + scale * at_x
      let anchor_y = min_y + scale * at_y
      scale *= zoom_factor(wheel)
      min_x = anchor_x - scale * at_x
      min_y = anchor_y - scale * at_y
      needs_preview = true
    }

    // **Pan by dragging**, and a dragged point stays under the cursor exactly, which is
    // the invariant the zoom already keeps: a pixel of movement is one pixel's worth of
    // plane. That worth is the scale, and the same on both axes because a pixel is square.
    let { x: delta_x, y: delta_y } = mouse_delta()
    if mouse_down(MOUSE_BUTTON_LEFT) && (f64(delta_x).abs() + f64(delta_y).abs()) > 0.0 {
      min_x -= f64(delta_x) * scale
      min_y -= f64(delta_y) * scale
      needs_preview = true
    }

    // Coarse while the wheel is turning, sharp once it stops. The `else` is what makes
    // that work: a frame the wheel moved in renders the preview *and* owes the full pass,
    // and the first frame it does not move in is where that debt comes due.
    if needs_preview {
      render(buffer, width, height, min_x, min_y, scale, PREVIEW_STEP)
      update_texture(tex, buffer)
      needs_preview = false
      needs_full = true
    } else if needs_full {
      render(buffer, width, height, min_x, min_y, scale, 1)
      refine_edges(buffer, width, height, min_x, min_y, scale)
      update_texture(tex, buffer)
      needs_full = false
    }

    begin_drawing()
    draw_texture(tex, 0, 0, WHITE)
    draw_crosshairs(mouse_pos)

    end_drawing()
  }

  unload_texture(tex)
  close_window()
  println("closed cleanly")
}

/// A texture of the given size in the pixel format [update_texture] writes, or `None` if
/// the GPU would not take one.
///
/// The image exists only to give the texture its size and format — the pixels come from
/// the buffer afterwards — so it is released before this returns.
let blank_texture = (width: i64, height: i64) -> Maybe<Texture2D> => {
  var img = gen_image_color(i32(width), i32(height), BLACK)
  let created = texture_from_image(img)
  unload_image(img)
  created
}

/// Where a pointer coordinate falls across an extent, as 0.0 through 1.0.
///
/// **Clamped**, because the pointer is reported outside the window when a button is held
/// and the cursor leaves it. An unclamped fraction would translate the view by the
/// overshoot as well as scaling it, so a notch delivered from just off the edge would
/// fling the picture sideways.
let fraction = pure (position: f64, extent: f64) -> f64 => {
  let f = position / extent
  if f < 0.0 { 0.0 } else if f > 1.0 { 1.0 } else { f }
}

/// What one frame's wheel movement multiplies the scale by.
///
/// **The movement is a proportion of a notch, clamped to one per frame.** A wheel reports
/// whole notches, but a trackpad reports fractions of one — several per frame during a
/// flick — and unclamped that arrives as one large value crossing several magnifications
/// between two frames, with no rendered frame in between to see them.
///
/// **Zooming out is the exact reciprocal of zooming in**, so a notch back undoes a notch
/// forward and the view returns to the scale it came from. Scaling by `1.15` instead of by
/// `1.0 / 0.85` is wrong by half a percent each way, which compounds over a few dozen
/// notches into a view that no longer comes back.
let zoom_factor = pure (wheel: f64) -> f64 => {
  let amount = wheel.abs()
  let notch = if amount > 1.0 { 1.0 } else { amount }
  // 1.0 at no movement, ZOOM_STEP at a full notch.
  let closer = 1.0 - notch * (1.0 - ZOOM_STEP)
  if wheel > 0.0 { closer } else { 1.0 / closer }
}

/// Compute the set into `buffer`, one `Color` per pixel in row-major order — which is the
/// order [update_texture] reads them in.
///
/// `step` is the block size: one point per `step`-by-`step` square of pixels, its colour
/// filling the square, so a step of 1 is the full picture and [PREVIEW_STEP] is the coarse
/// one. **The buffer is filled either way** — a preview writes the same pixel count as a
/// full render, it just computes a sixteenth as many points — which is what keeps one
/// texture, one length and one upload across both.
///
/// The point sits at the block's **centre**, which is why the offset carries a half. A
/// preview's block is therefore stood in for by its middle rather than its top-left
/// corner, so a coarse frame sits where the sharp one will rather than two pixels up and
/// to the left of it.
let render = (buffer: mut []Color, width: i64, height: i64,
  min_x: f64, min_y: f64, scale: f64, step: i64) -> void => {
  // The iteration limit is a property of the view, not of a point, so it is computed once
  // per render rather than once per pixel.
  let max_iter = iter_limit(scale)
  for block_y in 0..<height:step {
    for block_x in 0..<width:step {
      let at_x = f64(block_x) + f64(step) * 0.5
      let at_y = f64(block_y) + f64(step) * 0.5
      let c = Complex { re: min_x + scale * at_x, im: min_y + scale * at_y }
      let color = shade(c, max_iter)
      // A trailing block is clipped rather than skipped, since the window's size is not
      // obliged to divide by the step — and a skipped one would leave the right edge and
      // the bottom row holding whatever the previous view left there.
      let y_end = (block_y + step).min(height)
      let x_end = (block_x + step).min(width)
      for py in block_y..<y_end {
        for px in block_x..<x_end {
          buffer[py * width + px] = color
        }
      }
    }
  }
}

/// Supersample, in place, the pixels of a one-sample render that need it: [SUPERSAMPLE]
/// points per side, averaged, but only where the picture has an edge.
///
/// **An edge is where two neighbouring pixels disagree** by more than [EDGE_CONTRAST].
/// Aliasing is a pixel reporting one point of something finer than itself, and a
/// neighbour that reports a very different point is the evidence of it. In smooth
/// gradient and inside the set the neighbours agree, and four points would only have
/// repeated the one — which is most of the picture, and why this is cheaper than
/// supersampling all of it.
///
/// **The detected edge is then grown by one pixel**, because a contrast test can only see
/// what one sample per pixel already resolved. Where the set's boundary passes through a
/// pixel whose centre and whose four neighbours' centres all land inside, all five are
/// black and nothing disagrees, yet its corners escape. Such a pixel is always beside one
/// that *was* caught, so growing the mask reaches it. Measured on the top view, the grown
/// mask cut the pixels still visibly off from 936 to 82, for 5% more time.
///
/// Detection reads only the one-sample picture: every pair is judged before any pixel is
/// replaced, so a refined pixel cannot make its neighbour look like an edge that was not.
///
/// The sample points are placed exactly as a whole-picture supersample would place them, so
/// a refined pixel's colour is bit-for-bit what it would have been.
let refine_edges = (buffer: mut []Color, width: i64, height: i64,
  min_x: f64, min_y: f64, scale: f64) -> void => {
  let max_iter = iter_limit(scale)

  // Mark both pixels of every neighbouring pair that disagree — right and down from each
  // pixel, which visits every pair once.
  var edge: []bool = [false; width * height]
  for py in 0..<height {
    for px in 0..<width {
      let i = py * width + px
      if px + 1 < width && color_distance(buffer[i], buffer[i + 1]) > EDGE_CONTRAST {
        edge[i] = true
        edge[i + 1] = true
      }
      if py + 1 < height && color_distance(buffer[i], buffer[i + width]) > EDGE_CONTRAST {
        edge[i] = true
        edge[i + width] = true
      }
    }
  }

  // Grow the edge by one pixel. Into a second mask, since growing in place would let a
  // freshly marked pixel mark its own neighbours further along the same scan.
  var refine: []bool = [false; width * height]
  for py in 0..<height {
    for px in 0..<width {
      let i = py * width + px
      if edge[i] {
        refine[i] = true
        if px > 0 { refine[i - 1] = true }
        if px + 1 < width { refine[i + 1] = true }
        if py > 0 { refine[i - width] = true }
        if py + 1 < height { refine[i + width] = true }
      }
    }
  }

  let per_side = f64(SUPERSAMPLE)
  let taken = SUPERSAMPLE * SUPERSAMPLE
  for py in 0..<height {
    for px in 0..<width {
      if refine[py * width + px] {
        var sum_r = 0
        var sum_g = 0
        var sum_b = 0
        for sample_y in 0..<SUPERSAMPLE {
          for sample_x in 0..<SUPERSAMPLE {
            // Each sample sits at the centre of its share of the pixel.
            let at_x = f64(px) + (f64(sample_x) + 0.5) / per_side
            let at_y = f64(py) + (f64(sample_y) + 0.5) / per_side
            let c = Complex { re: min_x + scale * at_x, im: min_y + scale * at_y }
            let sample = shade(c, max_iter)
            sum_r += i64(sample.r)
            sum_g += i64(sample.g)
            sum_b += i64(sample.b)
          }
        }
        // Averaged channel by channel as stored, which is not the same as averaging
        // light — the channels are what a display will gamma-decode. For a palette
        // invented to make structure legible there is no true colour to be wrong about,
        // and the alternative costs a pow per sample.
        buffer[py * width + px] = rgb(u8(sum_r / taken), u8(sum_g / taken), u8(sum_b / taken))
      }
    }
  }
}

/// How different two colours look, as the largest difference in any one channel.
///
/// The largest rather than a sum, so a change confined to one channel — red to magenta
/// is blue alone — counts as much as it looks.
let color_distance = pure (a: Color, b: Color) -> i64 => {
  let dr = (i64(a.r) - i64(b.r)).abs()
  let dg = (i64(a.g) - i64(b.g)).abs()
  let db = (i64(a.b) - i64(b.b)).abs()
  dr.max(dg).max(db)
}

let draw_crosshairs = (pos: Vector2) => {
  draw_line(
    Vector2{ x: pos.x - 10, y: pos.y },
    Vector2{ x: pos.x + 10, y: pos.y },
    WHITE,
  )
  draw_line(
    Vector2{ x: pos.x, y: pos.y - 10 },
    Vector2{ x: pos.x, y: pos.y + 10 },
    WHITE,
  )
}

/// More iterations the further in the view is zoomed: a deeper view resolves finer
/// filaments, and the points along them are exactly the ones that take longest to escape.
///
/// The magnification is measured against the **starting** scale — the whole set across the
/// window as it first opens — so it is 1.0 before any zoom and grows as the scale shrinks.
/// It is keyed on the scale rather than on how much of the plane is visible, so resizing
/// or going fullscreen shows more of the picture without changing how hard each pixel of
/// it works.
let iter_limit = pure (scale: f64) -> i64 => {
  let magnification = X_LEN / f64(WINDOW_WIDTH) / scale
  if magnification <= 1.0 {
    MAX_ITER
  } else {
    MAX_ITER + (120.0 * magnification.log10()).round()
  }
}

let shade = pure (c: Complex<f64>, max_iter: i64) -> Color => {
  // A point inside either of the two largest regions never escapes, so iterating it is
  // `max_iter` steps spent learning an answer a formula gives in five multiplies. Those
  // are also the most expensive points in any view that shows them.
  if in_main_bulbs(c) { return BLACK }

  var z = Complex { re: 0.0, im: 0.0 }
  var mag2 = 0.0
  var iter = 0
  for iter < max_iter {
    z = z * z + c
    mag2 = z.re * z.re + z.im * z.im
    if mag2 > ESCAPE { break }
    iter += 1
  }

  if iter >= max_iter {
    BLACK // the set itself: black
  } else {
    // Smooth escape time, `n + 1 - log2(log|z|)`: the integer iteration count alone
    // draws visible contours, since every point escaping on the same step gets the same
    // colour.
    let smooth = f64(iter) + 1.0 - mag2.sqrt().log().log2()
    // The correction is worth about -1.5, so a point escaping immediately lands below
    // zero — and a negative would run the hue backwards round the circle.
    let s = if smooth < 0.0 { 0.0 } else { smooth }

    // The fractional part of the turn count is the position on the hue circle, so the
    // colour wraps with no seam however many times it goes round.
    //
    // **The turn count is logarithmic** — see [COLOR_CYCLE]. This is a logarithm the
    // file used to have and gave up: back when the palette was a single ramp, the log
    // was there to spend a fixed number of colours sensibly, and switching to a cycle
    // retired that reason. It comes back for a different one. A cycle has no colours to
    // run out of, but it can still turn faster than the pixel grid can follow, and at
    // depth a linear sweep does. The `1.0 +` is what keeps `log` away from zero, where a
    // point escaping on the first iteration would otherwise send the hue to -inf.
    let turns = (1.0 + s).log() / COLOR_CYCLE
    let hue = 6.0 * (turns - f64(turns.floor()))
    let value = if s >= FADE_IN { 1.0 } else { s / FADE_IN }
    hue_rgb(hue, value)
  }
}

/// Whether `c` lies inside the main cardioid or the period-2 bulb — the two largest regions
/// of the set, and the only two with closed-form boundaries.
///
/// The cardioid is `q * (q + x - 1/4) <= y^2 / 4`, where `q = (x - 1/4)^2 + y^2`; the bulb
/// is the disc of radius 1/4 about -1. Neither can say a point is in the set when it is
/// not, so skipping the iteration changes no pixel. It only helps where the view shows
/// them: 2.7x on the top view, nothing in a deep view of the boundary, which is mostly
/// points that escape.
let in_main_bulbs = pure (c: Complex<f64>) -> bool => {
  let x = c.re - 0.25
  let y2 = c.im * c.im
  let q = x * x + y2
  let in_cardioid = q * (q + x) <= 0.25 * y2
  let in_bulb = (c.re + 1.0) * (c.re + 1.0) + y2 <= 0.0625
  in_cardioid || in_bulb
}

/// A hue at full saturation and the given value, packed.
///
/// Plain HSV with S = 1: each sector holds one channel at full, ramps a second up or down,
/// and leaves the third at zero. Six linear sectors, no trigonometry — which is what HSV
/// actually is; `cos` exists (09/15) and a hue ramp has no use for it.
let hue_rgb = pure (hue: f64, value: f64) -> Color => {
  let sector = hue.floor()
  let f = hue - f64(sector)
  let full = u8((255.0 * value).round())
  let up = u8((255.0 * value * f).round())
  let down = u8((255.0 * value * (1.0 - f)).round())
  if sector <= 0 { rgb(full, up, 0) }
  else if sector == 1 { rgb(down, full, 0) }
  else if sector == 2 { rgb(0, full, up) }
  else if sector == 3 { rgb(0, down, full) }
  else if sector == 4 { rgb(up, 0, full) }
  else { rgb(full, 0, down) }
}
