// raylib from Lyra — the library that needed **struct-by-value**.
//
// **There is no `unsafe` in this file, and no `extern`.** Every one of both is in
// `bindings/raylib/`, which is what a binding module is for: `Vector2` is an ordinary
// struct here, passed to `draw_circle` the way any value is passed, and the fact that it
// travels in the float registers is `pkg/abi`'s business rather than this program's.
//
// SDL3 never needed any of that — its render API takes `const SDL_FRect *`, so every
// aggregate crosses as a pointer. raylib passes them by value everywhere, which is a
// per-target calling convention rather than a spelling, and was refused until the
// classifier existed.
//
// Run it with:
//
//     LIBRARY_PATH=$(pkg-config --variable=libdir raylib) lyrac run examples/raylib/basic.lyra
//
// That is `build/lyrac` from `./build.sh`, which puts `std/` and `bindings/` beside the
// binary. Running the compiler from source (`go run ./cmd/lyrac`) needs `LYRA_STD=$(pwd)`
// from `lyra/`, since `go run` builds into a temp directory that has neither.
//
// A ball bounces around, a rectangle follows the mouse, and clicking drops a marker.
// Press Escape or close the window to quit.

import bindings.raylib.{
  init_window, close_window, should_close, set_target_fps, frame_time,
  begin_drawing, end_drawing, clear_background,
  Vector2, Rectangle, draw_circle, draw_rectangle, draw_line,
  rgba, RAYWHITE, DARKGRAY, RED, BLUE,
  mouse_position, mouse_pressed, key_down, MOUSE_LEFT, KEY_SPACE,
  draw_text, measure_text, draw_fps,
}

const WIDTH: f32 = 800.0
const HEIGHT: f32 = 450.0
const RADIUS: f32 = 28.0

let main = () -> void => {
  init_window(800, 450, "Lyra × raylib")
  set_target_fps(60)

  var x: f32 = 120.0
  var y: f32 = 140.0
  var dx: f32 = 260.0
  var dy: f32 = 190.0
  var marks: []Vector2 = []

  for !should_close() {
    // **Frame-rate independent movement**: raylib caps the rate, but scaling by the
    // frame's own duration is what keeps the ball at the same speed if it ever does not.
    let dt = frame_time()
    x += dx * dt
    y += dy * dt
    if x <= RADIUS || x >= WIDTH - RADIUS { dx = -dx }
    if y <= RADIUS || y >= HEIGHT - RADIUS { dy = -dy }

    let m = mouse_position()
    if mouse_pressed(MOUSE_LEFT) { marks.push(m) }
    if key_down(KEY_SPACE) { marks = [] }

    begin_drawing()
    clear_background(RAYWHITE)

    // A crosshair on the cursor, then a box around it — `Vector2` and `Rectangle` both
    // cross by value, and both are just structs here.
    draw_line(Vector2 { x: m.x - 12.0, y: m.y }, Vector2 { x: m.x + 12.0, y: m.y }, DARKGRAY)
    draw_line(Vector2 { x: m.x, y: m.y - 12.0 }, Vector2 { x: m.x, y: m.y + 12.0 }, DARKGRAY)
    draw_rectangle(
      Rectangle { x: m.x - 34.0, y: m.y - 24.0, width: 68.0, height: 48.0 },
      rgba(60, 60, 90, 40),
    )

    for mark in marks {
      draw_circle(mark, 5.0, rgba(0, 121, 241, 160))
    }

    draw_circle(Vector2 { x: x, y: y }, RADIUS, RED)

    let hint = "click to mark · space to clear"
    draw_text(hint, 400 - measure_text(hint, 20) / 2, 410, 20, DARKGRAY)
    draw_text("${marks.len()} marks", 12, 12, 20, BLUE)
    draw_fps(12, 40)

    end_drawing()
  }

  close_window()
  println("closed cleanly")
}
