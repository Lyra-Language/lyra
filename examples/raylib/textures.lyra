module main
//! Images and textures: every drawing call `bindings.raylib` has, and the image pipeline
//! behind them.
//!
//!   export LIBRARY_PATH=$(pkg-config --variable=libdir raylib)
//!   lyrac run examples/raylib/textures.lyra -- --check   # the image half, exits 0 or 1
//!   lyrac run examples/raylib/textures.lyra              # the gallery, in a window
//!
//! Two programs in one file, and here the split is not a convention but the shape of the
//! library: an `Image` is pixels in ordinary memory, so everything about generating,
//! editing and reading one is checkable with no window at all. A `Texture2D` lives in the
//! GPU and needs a context, so the six drawing calls can only be looked at. `--check` is
//! the half a machine can hold to account.
//!
//! **It draws real artwork**, from `assets/` beside this file: a sprite sheet, a UI panel
//! and a small landscape. They are committed PNGs, and `assets/generate.py` is the
//! standard-library script that made them — so they are reproducible rather than opaque
//! binaries that arrived somehow. Flat generated colour was what this example used first
//! and it was the wrong choice twice over: bilinear filtering has nothing to show against
//! a hard-edged disc, and a nine-patch's whole point is invisible without a border worth
//! preserving.
//!
//! **Run it from the repository root**, or from `examples/raylib/` — those are the two
//! places it looks for `assets/`.

import bindings.raylib.{
  init_window, close_window, should_close, set_target_fps, elapsed,
  begin_drawing, end_drawing, clear_background,
  Vector2, vec2, rect, draw_rectangle, draw_rectangle_lines, draw_circle, draw_line_ex,
  draw_text, mouse_position, key_pressed, KEY_SPACE,
  Color, rgb, rgba,
  Image, Texture2D, RenderTexture, NPatchInfo, Degrees,
  gen_image_color, gen_image_checked, gen_image_gradient_linear, gen_image_gradient_radial,
  gen_image_gradient_square, gen_image_white_noise, gen_image_perlin_noise,
  gen_image_cellular, gen_image_text,
  image_valid, unload_image, image_color_at, image_colors, export_image, load_image,
  image_from_memory, image_from_texture, image_from_screen,
  resize, resize_nearest, crop, rotate, flip_vertical, flip_horizontal,
  grayscale, invert, tint, reformat,
  texture_from_image, texture_valid, unload_texture, update_texture, update_texture_rect,
  load_texture, set_texture_filter, set_texture_wrap, gen_mipmaps,
  load_render_texture, render_texture_valid, unload_render_texture,
  begin_texture_mode, end_texture_mode,
  draw_texture, draw_texture_v, draw_texture_ex, draw_texture_rect, draw_texture_pro,
  draw_texture_npatch,
  FILTER_POINT, FILTER_BILINEAR, WRAP_CLAMP, NPATCH_NINE, PIXELFORMAT_R8G8B8A8,
  RAYWHITE, WHITE, BLACK, RED, GREEN, BLUE, YELLOW, ORANGE, PURPLE, DARKGRAY, LIGHTGRAY,
}

/// One sprite frame, and how many `assets/sprites.png` holds.
const FRAME: i64 = 32
const FRAMES: i64 = 4
/// `assets/panel.png`'s size, and how wide the border a nine-patch must not stretch is.
const PANEL: i64 = 48
const BORDER: i64 = 14

/// Label and caption sizes. Named because they are set together and were once too small
/// to read at a normal viewing distance.
const LABEL: i32 = 22
const CAPTION: i32 = 18

let main = () -> u8 => {
  if wants_check() { return run_checks() }
  run_gallery()
  0
}

let wants_check = () -> bool => {
  var found = false
  for arg in program_args() {
    if arg == "--check" { found = true }
  }
  found
}

/// Where an asset lives, tried in order: from the repository root, then from beside the
/// example itself. Answers the first that loads, so the program works from either.
let asset_path = (name: string) -> Maybe<string> => {
  let candidates: []string = ["examples/raylib/assets/" ++ name, "assets/" ++ name]
  var found: Maybe<string> = None
  for path in candidates {
    match found {
      Some(_) => {},
      None => {
        match load_image(path) {
          Some(probe) => { unload_image(probe); found = Some(path) },
          None => {},
        }
      },
    }
  }
  found
}

// ---------------------------------------------------------------------------------------
// The headless half — everything an Image can do, checked
// ---------------------------------------------------------------------------------------

/// Every image binding against an answer that follows from the numbers.
///
/// A solid 8x4 has 32 pixels all of one colour; a 2x2-checked square has corners that
/// differ; a top-to-bottom gradient differs top from bottom. Nothing here asks raylib what
/// the answer is and then asserts it — that would only establish that raylib agrees with
/// itself. The assets are checked against the sizes `assets/generate.py` writes.
let run_checks = () -> u8 => {
  var failures = 0

  var img = gen_image_color(8, 4, rgb(200, 100, 50))
  failures += check_case("gen_image_color is valid", image_valid(img), true)
  failures += check_case("gen_image_color size", img.width == 8 && img.height == 4, true)
  let c = image_color_at(img, 2, 2)
  failures += check_case("pixel is the colour asked for",
    c.r == 200 && c.g == 100 && c.b == 50 && c.a == 255, true)
  failures += check_case("format is R8G8B8A8", img.format == PIXELFORMAT_R8G8B8A8, true)

  let colors = image_colors(img)
  failures += check_case("image_colors length is w*h", colors.len() == 32, true)
  failures += check_case("image_colors are all the fill colour",
    colors[0].r == 200 && colors[31].r == 200, true)

  // The in-place edits mutate this binding rather than a copy — the whole reason they
  // take `self: mut Image`.
  img.resize(16, 8)
  failures += check_case("resize reaches the caller's binding",
    img.width == 16 && img.height == 8, true)
  img.crop(rect(0.0, 0.0, 4.0, 4.0))
  failures += check_case("crop", img.width == 4 && img.height == 4, true)
  img.rotate(90)
  failures += check_case("rotate keeps a square square",
    img.width == 4 && img.height == 4, true)
  img.grayscale()
  let g = image_color_at(img, 1, 1)
  failures += check_case("grayscale makes r == g == b", g.r == g.g && g.g == g.b, true)

  var checks = gen_image_checked(4, 4, 2, 2, RED, BLUE)
  let before = image_color_at(checks, 0, 0)
  failures += check_case("checked corners differ",
    before.r != image_color_at(checks, 3, 0).r, true)
  checks.flip_horizontal()
  failures += check_case("flip_horizontal swaps the corners",
    image_color_at(checks, 3, 0).r == before.r, true)
  checks.flip_vertical()
  checks.invert()
  failures += check_case("invert", image_color_at(checks, 3, 3).r != before.r, true)
  checks.tint(WHITE)
  checks.resize_nearest(8, 8)
  failures += check_case("resize_nearest", checks.width == 8, true)
  checks.reformat(PIXELFORMAT_R8G8B8A8)
  failures += check_case("reformat", checks.format == PIXELFORMAT_R8G8B8A8, true)

  var grad = gen_image_gradient_linear(8, 8, 0, RED, BLUE)
  failures += check_case("linear gradient runs top to bottom",
    image_color_at(grad, 4, 0).r != image_color_at(grad, 4, 7).r, true)
  var radial = gen_image_gradient_radial(16, 16, 0.0, RED, BLUE)
  failures += check_case("radial gradient differs centre from corner",
    image_color_at(radial, 8, 8).r != image_color_at(radial, 0, 0).r, true)
  var square = gen_image_gradient_square(16, 16, 0.0, RED, BLUE)
  failures += check_case("square gradient differs centre from corner",
    image_color_at(square, 8, 8).r != image_color_at(square, 0, 0).r, true)

  // Noise is random, so the only thing worth asserting is the shape.
  var noise = gen_image_white_noise(8, 8, 0.5)
  failures += check_case("white noise size", noise.width == 8 && noise.height == 8, true)
  var perlin = gen_image_perlin_noise(8, 8, 0, 0, 4.0)
  failures += check_case("perlin noise size", perlin.width == 8, true)
  var cells = gen_image_cellular(16, 16, 4)
  failures += check_case("cellular noise size", cells.width == 16, true)
  var text = gen_image_text(64, 16, "lyra")
  failures += check_case("text image size", text.width == 64, true)

  // A file round trip: what was written comes back the same size.
  let wrote = export_image(checks, "/tmp/lyra_textures_check.png")
  failures += check_case("export_image", wrote, true)
  var reloaded = false
  match load_image("/tmp/lyra_textures_check.png") {
    Some(back) => {
      reloaded = back.width == checks.width && back.height == checks.height
      unload_image(back)
    },
    None => {},
  }
  failures += check_case("load_image round trip", reloaded, true)
  var missing = false
  match load_image("/tmp/definitely_not_here.png") {
    Some(bad) => { unload_image(bad) },
    None => { missing = true },
  }
  failures += check_case("a missing file is None", missing, true)

  // The memory path, and the two refusals its wrapper absorbs.
  var junk = false
  match image_from_memory("png", [1, 2, 3, 4]) {
    Some(bad) => { unload_image(bad) },
    None => { junk = true },
  }
  failures += check_case("junk bytes are refused", junk, true)
  let nothing: []u8 = []
  var empty = false
  match image_from_memory("png", nothing) {
    Some(bad) => { unload_image(bad) },
    None => { empty = true },
  }
  failures += check_case("an empty byte list is refused, not a trap", empty, true)

  // The committed artwork, at the sizes assets/generate.py writes. Loading an Image needs
  // no window, so the assets the gallery draws are checkable here.
  failures += check_asset("assets/sprites.png", "sprites.png", FRAME * FRAMES, FRAME)
  failures += check_asset("assets/panel.png", "panel.png", PANEL, PANEL)
  failures += check_asset("assets/scene.png", "scene.png", 160, 100)

  unload_image(text)
  unload_image(cells)
  unload_image(perlin)
  unload_image(noise)
  unload_image(square)
  unload_image(radial)
  unload_image(grad)
  unload_image(checks)
  unload_image(img)

  if failures == 0 {
    println("all image checks passed")
    0
  } else {
    println("${failures} check(s) FAILED")
    1
  }
}

/// An asset loads and is the size its generator writes.
let check_asset = (label: string, name: string, width: i64, height: i64) -> i64 => {
  var right_size = false
  match asset_path(name) {
    Some(path) => {
      match load_image(path) {
        Some(img) => {
          right_size = i64(img.width) == width && i64(img.height) == height
          unload_image(img)
        },
        None => {},
      }
    },
    None => {},
  }
  check_case(label, right_size, true)
}

let check_case = (name: string, got: bool, want: bool) -> i64 => {
  if got == want {
    println("  ok    ${name}")
    0
  } else {
    println("  FAIL  ${name}")
    1
  }
}

// ---------------------------------------------------------------------------------------
// The gallery
// ---------------------------------------------------------------------------------------

let run_gallery = () -> void => {
  // A 3x3 grid of 390x230 cells, each label 34px above its cell. The cell width is what
  // caps the labels: raylib's default font is about 0.55em per character, so 390px at
  // `LABEL` holds roughly 29 — which is why they are short. The first version wrote
  // "draw_texture_npatch — follows the mouse" in a 360px column and three of them
  // overlapped their neighbours while a fourth ran off the window.
  init_window(1200, 760, "Lyra — raylib textures")
  set_target_fps(60)
  match load_assets() {
    Some(_) => {},
    None => println("could not load assets/ — run from the repository root"),
  }
  close_window()
}

/// Load the three textures, run the gallery, and release them. Nested rather than
/// flattened because each load can fail on its own; the `Maybe` is what says so.
let load_assets = () -> Maybe<bool> => {
  var done: Maybe<bool> = None
  match asset_texture("sprites.png") {
    Some(fresh) => {
      // `gen_mipmaps` mutates the `Texture2D` it is handed, so it wants a `var` — and
      // moving the match arm's binding into one keeps a single name on the resource.
      // Two names for one GPU object is a shape the compiler cannot see through: it
      // tracks bindings, not textures, so it would ask for two unloads of a thing that
      // must be freed once.
      var sheet = fresh
      set_texture_filter(sheet, FILTER_POINT)
      set_texture_wrap(sheet, WRAP_CLAMP)
      sheet.gen_mipmaps()
      println("sprite sheet: ${sheet.width}x${sheet.height}, valid=${texture_valid(sheet)}, "
        ++ "${sheet.mipmaps} mipmap level(s)")
      match asset_texture("panel.png") {
        Some(panel) => {
          match asset_texture("scene.png") {
            Some(scene) => {
              with_all(sheet, panel, scene)
              done = Some(true)
              unload_texture(scene)
            },
            None => {},
          }
          unload_texture(panel)
        },
        None => {},
      }
      unload_texture(sheet)
    },
    None => {},
  }
  done
}

/// A texture from a file in `assets/`, wherever that turns out to be.
let asset_texture = (name: string) -> Maybe<Texture2D> => {
  var made: Maybe<Texture2D> = None
  match asset_path(name) {
    Some(path) => {
      match load_texture(path) {
        Some(t) => { made = Some(t) },
        None => {},
      }
    },
    None => {},
  }
  made
}

/// The render texture, and a second copy of the scene the program edits pixel by pixel.
let with_all = (sheet: Texture2D, panel: Texture2D, scene: Texture2D) -> void => {
  match sepia_of(scene) {
    Some(sepia) => {
      match load_render_texture(240, 170) {
        Some(rt) => {
          println("render texture valid: ${render_texture_valid(rt)}")
          loop_frames(sheet, panel, scene, sepia, Some(rt))
          unload_render_texture(rt)
        },
        None => loop_frames(sheet, panel, scene, sepia, None),
      }
      unload_texture(sepia)
    },
    None => println("could not build the edited copy"),
  }
}

/// Read a texture's pixels back, warm them in Lyra, and upload the result to a new
/// texture — the read-modify-write path, on real artwork rather than a flat fill.
///
/// `update_texture_rect` then patches one corner, which is how an atlas is usually
/// changed: a region at a time rather than a whole reupload.
let sepia_of = (source: Texture2D) -> Maybe<Texture2D> => {
  var made: Maybe<Texture2D> = None
  match image_from_texture(source) {
    Some(img) => {
      let pixels = image_colors(img)
      var warmed: []Color = []
      for p in pixels {
        let lum = (i64(p.r) * 30 + i64(p.g) * 59 + i64(p.b) * 11) / 100
        warmed.push(rgba(u8(min_i64(255, lum * 12 / 10)), u8(lum), u8(lum * 7 / 10), p.a))
      }
      let blank = gen_image_color(img.width, img.height, rgba(0, 0, 0, 0))
      match texture_from_image(blank) {
        Some(t) => {
          if update_texture(t, warmed) {
            // A corner swatch, so the partial update is visible against the rest.
            let patch = solid_block(24, 24, rgb(210, 96, 72))
            let patched = update_texture_rect(t, rect(0.0, 0.0, 24.0, 24.0), patch)
            println("corner repatched: ${patched}")
            made = Some(t)
          } else {
            unload_texture(t)
          }
        },
        None => {},
      }
      unload_image(blank)
      unload_image(img)
    },
    None => {},
  }
  made
}

let solid_block = pure (width: i64, height: i64, color: Color) -> []Color => {
  var out: []Color = []
  var i = 0
  for i < width * height {
    out.push(color)
    i += 1
  }
  out
}

let min_i64 = pure (a: i64, b: i64) -> i64 => if a < b { a } else { b }

let loop_frames =
  (sheet: Texture2D, panel: Texture2D, scene: Texture2D, sepia: Texture2D,
   target: Maybe<RenderTexture>) -> void => {
    var shot: Maybe<Texture2D> = None
    for !should_close() {
      let t = f32(elapsed())
      let cursor = mouse_position()
      let frame = i64(f64(t * 6.0).floor()) %% FRAMES

      // Space takes a screenshot: the framebuffer becomes an `Image`, the `Image` goes
      // to a PNG, and the PNG is loaded straight back as a texture and shown as a
      // thumbnail — a realistic gesture that exercises four bindings at once.
      if key_pressed(KEY_SPACE) {
        match capture_to_texture() {
          Some(fresh) => {
            // The previous thumbnail is released *before* the name is rebound, because
            // rebinding over a live resource is the one leak lyra-W022 cannot attribute
            // to a scope end — it is the caller's to get right.
            match shot {
              Some(old) => unload_texture(old),
              None => {},
            }
            shot = Some(fresh)
          },
          None => {},
        }
      }

      // **Drawn into first, outside the frame's own drawing.** A texture-mode block does
      // not nest inside `begin_drawing`, so the framebuffer is filled before the screen
      // is, and then drawn back below like any other texture.
      match target {
        Some(rt) => render_into(rt, sheet, scene, t),
        None => {},
      }

      begin_drawing()
      clear_background(RAYWHITE)

      draw_scene_panel(scene, 30.0, 70.0)
      draw_transformed_panel(scene, 420.0, 70.0, t)
      draw_filter_panel(sheet, 810.0, 70.0)
      draw_edited_panel(sepia, 30.0, 300.0)
      draw_sheet_panel(sheet, 420.0, 300.0, frame)
      draw_npatch_panel(panel, 810.0, 300.0, cursor)

      match target {
        Some(rt) => draw_render_texture_panel(rt.texture, 30.0, 530.0),
        None => draw_text("unavailable", 30, 530, CAPTION, DARKGRAY),
      }

      draw_text("as loaded / tinted", 30, 36, LABEL, DARKGRAY)
      draw_text("_ex and _pro", 420, 36, LABEL, DARKGRAY)
      draw_text("point / bilinear", 810, 36, LABEL, DARKGRAY)
      draw_text("update_texture", 30, 266, LABEL, DARKGRAY)
      draw_text("sprite sheet", 420, 266, LABEL, DARKGRAY)
      draw_text("nine-patch", 810, 266, LABEL, DARKGRAY)
      draw_text("render texture", 30, 496, LABEL, DARKGRAY)
      draw_text("screenshot", 420, 496, LABEL, DARKGRAY)

      match shot {
        Some(tex) => {
          draw_rectangle_lines(rect(420.0, 530.0, 260.0, 176.0), 2.0, DARKGRAY)
          draw_texture_pro(tex, rect(0.0, 0.0, f32(tex.width), f32(tex.height)),
            rect(422.0, 532.0, 256.0, 172.0), vec2(0.0, 0.0), 0.0, WHITE)
        },
        None => draw_text("press space", 420, 530, CAPTION, DARKGRAY),
      }
      end_drawing()
    }
    match shot {
      Some(tex) => unload_texture(tex),
      None => {},
    }
  }

/// Fill the framebuffer with something this program drew, so what comes back is visibly
/// not a blank rectangle.
let render_into = (rt: RenderTexture, sheet: Texture2D, scene: Texture2D, t: f32) -> void => {
  begin_texture_mode(rt)
  clear_background(rgb(30, 30, 46))
  draw_texture_ex(scene, vec2(10.0, 24.0), 0.0, 0.9, rgba(255, 255, 255, 150))
  draw_circle(vec2(200.0, 40.0), 22.0, ORANGE)
  draw_line_ex(vec2(10.0, 160.0), vec2(230.0, 20.0), 4.0, GREEN)
  draw_texture_pro(sheet, rect(0.0, 0.0, f32(FRAME), f32(FRAME)),
    rect(150.0, 110.0, 56.0, 56.0), vec2(28.0, 28.0), Degrees(25.0 * t), WHITE)
  draw_text("offscreen", 12, 10, CAPTION, RAYWHITE)
  end_texture_mode()
}

/// The scene as loaded and the same scene tinted: `draw_texture` and `draw_texture_v`.
let draw_scene_panel = (scene: Texture2D, x: f32, y: f32) -> void => {
  draw_texture(scene, i32(x.round()), i32(y.round()), WHITE)
  draw_texture_v(scene, vec2(x + 180.0, y), rgba(255, 170, 120, 255))
  draw_text("as loaded", i32(x.round()), i32(y.round()) + 106, CAPTION, DARKGRAY)
  draw_text("tinted", i32(x.round()) + 180, i32(y.round()) + 106, CAPTION, DARKGRAY)
}

/// The copy this program built pixel by pixel and uploaded with `update_texture`, with one
/// corner patched by `update_texture_rect`.
let draw_edited_panel = (sepia: Texture2D, x: f32, y: f32) -> void => {
  draw_texture_v(sepia, vec2(x, y), WHITE)
  draw_text("read back, warmed, re-uploaded",
    i32(x.round()), i32(y.round()) + 106, CAPTION, DARKGRAY)
}

/// `draw_texture_ex` rotates about the top-left corner; `draw_texture_pro` about a chosen
/// origin, so the second spins in place rather than orbiting.
let draw_transformed_panel = (scene: Texture2D, x: f32, y: f32, t: f32) -> void => {
  let spin = Degrees(30.0 * t)
  draw_texture_ex(scene, vec2(x + 40.0, y + 10.0), spin, 0.5, WHITE)
  draw_texture_pro(scene, rect(0.0, 0.0, 160.0, 100.0),
    rect(x + 250.0, y + 60.0, 130.0, 82.0), vec2(65.0, 41.0), spin, WHITE)
  draw_text("_ex", i32(x.round()) + 30, i32(y.round()) + 130, CAPTION, DARKGRAY)
  draw_text("_pro, centred", i32(x.round()) + 190, i32(y.round()) + 130, CAPTION, DARKGRAY)
}

/// One frame of the sheet at a time — what `draw_texture_rect` is for. The second copy
/// uses a **negative source width**, which is how a sprite faces the other way.
///
/// **`x` stays the frame's left edge.** raylib reads a negative width as "mirror this
/// region", not as "measure leftwards from here" — it flips the texture coordinates and
/// takes `|width|` from `x`. Shifting `x` to the right edge, which is what the
/// OpenGL-texcoord intuition suggests, silently draws frame *n+1* and wraps past the end
/// of the sheet at the last one. Measured, not reasoned: a probe drew four solid colour
/// bands through both spellings and read the pixels back.
let draw_sheet_panel = (sheet: Texture2D, x: f32, y: f32, frame: i64) -> void => {
  let source = rect(f32(frame * FRAME), 0.0, f32(FRAME), f32(FRAME))
  let flipped = rect(f32(frame * FRAME), 0.0, 0.0 - f32(FRAME), f32(FRAME))
  draw_rectangle(rect(x, y, 110.0, 110.0), LIGHTGRAY)
  draw_texture_pro(sheet, source, rect(x + 11.0, y + 11.0, 88.0, 88.0),
    vec2(0.0, 0.0), 0.0, WHITE)
  draw_rectangle(rect(x + 130.0, y, 110.0, 110.0), LIGHTGRAY)
  draw_texture_pro(sheet, flipped, rect(x + 141.0, y + 11.0, 88.0, 88.0),
    vec2(0.0, 0.0), 0.0, WHITE)
  draw_text("frame ${frame}", i32(x.round()), i32(y.round()) + 118, CAPTION, DARKGRAY)
  draw_text("flipped", i32(x.round()) + 130, i32(y.round()) + 118, CAPTION, DARKGRAY)
}

/// A nine-patch stretched to wherever the cursor is: the border keeps its thickness while
/// the middle grows, which is the whole point of the form and the reason the panel needed
/// to be real artwork rather than a flat square.
let draw_npatch_panel = (panel: Texture2D, x: f32, y: f32, cursor: Vector2) -> void => {
  let w = clamp_f32(cursor.x - x, 80.0, 340.0)
  let h = clamp_f32(cursor.y - y, 60.0, 165.0)
  let patch = NPatchInfo {
    source: rect(0.0, 0.0, f32(PANEL), f32(PANEL)),
    left: i32(BORDER),
    top: i32(BORDER),
    right: i32(BORDER),
    bottom: i32(BORDER),
    layout: NPATCH_NINE,
  }
  draw_texture_npatch(panel, patch, rect(x, y, w, h), vec2(0.0, 0.0), 0.0, WHITE)
}

/// One sprite magnified hard under each filter, so the difference is unmissable — which
/// is what anti-aliased artwork buys and a flat disc could never show.
let draw_filter_panel = (sheet: Texture2D, x: f32, y: f32) -> void => {
  let source = rect(0.0, 0.0, f32(FRAME), f32(FRAME))
  set_texture_filter(sheet, FILTER_POINT)
  draw_texture_pro(sheet, source, rect(x, y, 110.0, 110.0), vec2(0.0, 0.0), 0.0, WHITE)
  set_texture_filter(sheet, FILTER_BILINEAR)
  draw_texture_pro(sheet, source, rect(x + 130.0, y, 110.0, 110.0), vec2(0.0, 0.0), 0.0, WHITE)
  set_texture_filter(sheet, FILTER_POINT)
  draw_text("point", i32(x.round()), i32(y.round()) + 118, CAPTION, DARKGRAY)
  draw_text("bilinear", i32(x.round()) + 130, i32(y.round()) + 118, CAPTION, DARKGRAY)
}

/// A render texture drawn back to the screen.
///
/// **With a negative source height**, because a framebuffer's contents are upside down
/// relative to the screen — OpenGL's y axis runs the other way. Getting this wrong is not
/// an error, just a picture that is inexplicably inverted.
let draw_render_texture_panel = (tex: Texture2D, x: f32, y: f32) -> void => {
  let source = rect(0.0, 0.0, f32(tex.width), 0.0 - f32(tex.height))
  draw_texture_rect(tex, source, vec2(x, y), WHITE)
}

/// Grab the screen, write it to a PNG, and load that PNG back as a texture.
///
/// Not `take_screenshot`: raylib exports one of those now (it writes a file and stops),
/// and a local declaration quietly winning an imported name is lyra-W016.
///
/// Deliberately the long way round rather than `image_from_texture`: it is the round trip
/// a "save a screenshot" button actually performs, and it exercises the file path as well
/// as the memory one. Every intermediate `Image` is released here — only the texture
/// leaves.
let capture_to_texture = () -> Maybe<Texture2D> => {
  var made: Maybe<Texture2D> = None
  match image_from_screen() {
    Some(shot) => {
      if export_image(shot, "/tmp/lyra_textures_shot.png") {
        match load_texture("/tmp/lyra_textures_shot.png") {
          Some(t) => { made = Some(t) },
          None => {},
        }
      }
      unload_image(shot)
    },
    None => {},
  }
  made
}

let clamp_f32 = pure (v: f32, lo: f32, hi: f32) -> f32 =>
  if v < lo { lo } else { if v > hi { hi } else { v } }
