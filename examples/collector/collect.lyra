module collect
//! CST to AST — the bootstrap's third slice, and the first that does the compiler's own job.
//!
//! Slices 1 and 2 built what this stands on: the accessors a collector asks for
//! (`bindings/treesitter`) and a printer whose output the Go collector's 245 golden files
//! can judge (`print.lyra`). So a mismatch here is a mistake in this walk, which is the
//! whole reason for that order.
//!
//! The subset is what the smallest goldens use: a `let`/`var` declaration over an integer,
//! character or string literal, or an empty lambda. Anything else is skipped rather than
//! guessed at — a node kind this does not know yields no statement, so the test that grows
//! the subset fails by printing too little rather than by printing something invented.

import bindings.treesitter.{
  Node, kind, field, named_child, named_child_count, text, start_byte, end_byte,
}
import ast.{
  Program, Stmt, VarDecl, ExprStmt, Expr,
  IntegerLiteral, CharacterLiteral, StringLiteral, Identifier, BinaryOp, Lambda,
  Parameter, TypeNode, ReturnType, FunctionCall, Block,
  MemberAccess, IndexAccess, TupleIndexAccess, Unary, Range,
  TypeDecl,
  StructTypeDef,
  StructField,
  TupleTypeDef,
  DataTypeDef,
  DataTypeConstructor,
  GenericParam,
  DestructuringDecl,
  DataPatternDef,
  ConstrainedTypeDef,
  Interpolated,
  Pattern,
  FloatLiteral,
  TupleLiteral,
  ArrayLiteral,
  ArrayRepeat,
  StructInstance,
  StructInstanceField,
  Spread,
  Conditional,
  Location,
  Wildcard,
  ForInLoop,
  ForLoop,
  Break,
  Continue,
  VarReassignment,
  Match,
  MatchArm,
  Guard,
  LiteralPatternDef,
  PatternRange,
  PatternList,
  StructPatternDef,
  StructPatternField,
  Rest,
  BindingPatternDef,
  RangeEndOperator,
}

/// The file being collected: its bytes, and where each line begins.
///
/// **One parameter, not two.** Every collector already threaded `source` for `text`, and a
/// location needs a line table as well; bundling them keeps each signature at one argument
/// and means the table is built once for the file rather than rebuilt per node. Scanning
/// for newlines at each node instead would be quadratic in the file — a collector visits
/// every node, and `lyrafmt` is already 3000 lines.
pub struct Source {
  bytes: []u8,
  /// The byte offset each line starts at, line 1 first. Strictly increasing, so a byte
  /// offset finds its line by binary search.
  line_starts: []i64,
}

/// A file's bytes with its line table computed.
pub let source_of = pure (bytes: []u8) -> Source => {
  var line_starts = [0]
  for i in 0..<bytes.len() {
    // `\n` ends a line wherever it appears; a `\r\n` leaves the `\r` on the previous
    // line, which is what tree-sitter counts too — its column is a **byte** offset into
    // the line, not a character count, so nothing here decodes UTF-8.
    if bytes[i] == 10 { line_starts.push(i + 1) }
  }
  Source { bytes: bytes, line_starts: line_starts }
}

/// The span a CST node covers, 1-based, as `collector_ctx.NodeLocation` reports it.
let location_of = (self: Source, node: Node) -> Location => {
  let start = self.position_of(node.start_byte())
  let end = self.position_of(node.end_byte())
  Location {
    start_line: start.0,
    start_col: start.1,
    end_line: end.0,
    end_col: end.1,
  }
}

/// The 1-based `(line, column)` a byte offset falls on.
///
/// Binary search over the line table: the line is the last one starting at or before the
/// offset, and the column is the distance from that start. **Bytes, not runes** — a line
/// holding `é` counts it twice, which is what tree-sitter's own point does, and agreeing
/// with the compiler matters more here than agreeing with a text editor.
let position_of = pure (self: Source, offset: i64) -> (i64, i64) => {
  var low = 0
  var high = self.line_starts.len() - 1
  for low < high {
    // Round up, so the loop always moves: `low` is a candidate answer and `high` shrinks
    // toward it. Rounding down lets `low == mid` and spins forever on two entries.
    let mid = low + (high - low + 1) / 2
    if self.line_starts[mid] <= offset { low = mid } else { high = mid - 1 }
  }
  (low + 1, offset - self.line_starts[low] + 1)
}

/// Every statement at the file's top level.
pub let collect = (self: Node, source: Source) -> Program => {
  var statements: []Stmt = []
  for child in self.named_children() {
    match collect_statement(child, source) {
      Some(stmt) => statements.push(stmt),
      None => {},
    }
  }
  Program { statements: statements }
}

/// One statement, or `None` for a node this slice does not collect.
///
/// **A comment is a named node** — verified, not assumed: `// x` at the top level is a
/// named child of the root, beside the declarations. That is the compiler's own hazard 16.
/// The catch-all below would drop it anyway, so naming it is for what comes next: a
/// growing subset wants to say "this kind is not collected yet", and a comment is not an
/// uncollected construct, it is not a construct.
let collect_statement = (node: Node, source: Source) -> Maybe<Stmt> => {
  return match node.kind() {
    "comment" => None,
    // **A `const` is the same declaration under another kind.** The Go collector routes
    // `const_declaration` into the same collector, and the `keyword` field carries the
    // word, so nothing here is special-cased beyond the name of the node.
    "declaration" | "const_declaration" => collect_declaration(node, source),
    "type_declaration" => collect_type_declaration(node, source),
    "var_reassignment" => collect_var_reassignment(node, source),
    "break_statement" => collect_break(node, source),
    "continue_statement" =>
      Some(ContinueStmt(Continue { location: source.location_of(node), label: jump_label(node, source) })),
    "expression_statement" => {
      // The statement wraps one expression; if that expression is a kind this slice does
      // not know, the statement is not collected either — a wrapper around nothing is a
      // node this did not understand, not an empty one.
      if node.named_child_count() > 0 {
        return match collect_expr(node.named_child(0), source) {
          Some(expr) => Some(ExpressionStmt(ExprStmt { location: source.location_of(node), expression: expr })),
          None => None,
        }
      }
      None
    },
    _ => None
  }
}

/// `x = 2`.
///
/// **The name has no field** — it is simply the first named child, which is how the Go
/// collector reads it too. Asking for a `name` field answers nothing and the statement
/// disappears, which is how this was written first.
let collect_var_reassignment = (node: Node, source: Source) -> Maybe<Stmt> => {
  if node.named_child_count() == 0 { return None }
  let value = collect_expr(node.field("value")?, source)?
  Some(VarReassignmentStmt(VarReassignment {
    location: source.location_of(node),
    name: text(node.named_child(0), source.bytes),
    value: value,
  }))
}

/// `break`, `break outer`, `break outer 1`.
let collect_break = (node: Node, source: Source) -> Maybe<Stmt> => Some(BreakStmt(Break {
  location: source.location_of(node),
  label: jump_label(node, source),
  value: match node.field("value") {
    Some(value) => collect_expr(value, source),
    None => None,
  },
}))

/// The label a `break` or `continue` names, or `""` for the bare form.
let jump_label = (node: Node, source: Source) -> string => match node.field("label") {
  Some(label) => label.text(source.bytes),
  None => "",
}

/// `struct Point { … }`, `tuple Pair(…)`, `data Color = …`.
///
/// The keyword's node is a child rather than a field, so which of the three it is comes
/// from that child's kind — the same "the grammar already decided" the binary/boolean split
/// rests on.
let collect_type_declaration = (node: Node, source: Source) -> Maybe<Stmt> => {
  if node.named_child_count() == 0 { return None }
  let body = node.named_child(0)
  let declared = match kind(body) {
    "struct_type" => collect_struct_type(body, source),
    "named_tuple_type" => collect_tuple_type(body, source),
    "data_type" => collect_data_type(body, source),
    "constrained_type" => collect_constrained_type(body, source),
    _ => return None
  }
  let Some(declared_type) = declared else { return None }
  Some(TypeDeclStmt(TypeDecl {
    location: source.location_of(node),
    derives: [],
    generic_params: collect_generic_params(body, source),
    is_public: match field(body, "visibility") {
      Some(_) => true,
      None => false,
    },
    name: type_name_of(declared_type),
    declared: declared_type,
  }))
}

/// `struct Point { x: i64, y: i64 = 0 }`.
let collect_struct_type = (node: Node, source: Source) -> Maybe<shared TypeNode> => {
  var name = ""
  var fields: []StructField = []
  for child in node.named_children() {
    let k = child.kind()
    if k == "struct_name" { name = child.text(source.bytes) }
    if k == "struct_type_body" {
      for j in 0..<child.named_child_count() {
        let member = child.named_child(j)
        if member.kind() == "struct_member" {
          match collect_struct_field(member, source) {
            Some(f) => fields.push(f),
            None => {},
          }
        }
      }
    }
  }
  Some(NamedStructType(StructTypeDef { fields: fields, name: name }))
}

/// `x: i64`, `y: i64 = 0`.
let collect_struct_field = (node: Node, source: Source) -> Maybe<StructField> => {
  var name = ""
  var declared: Maybe<shared TypeNode> = None
  for child in node.named_children() {
    match child.kind() {
      "field_name" => {
        name = child.text(source.bytes)
      },
      "field_type" if child.named_child_count() > 0 => {
        declared = collect_type(child.named_child(0), source)
      },
      _ => {}
    }
  }
  let Some(declared_type) = declared else { return None }
  Some(StructField {
    default_value: match node.field("default_value") {
      Some(wrapper) => collect_wrapped_at(wrapper, source),
      None => None,
    },
    name: name,
    declared: declared_type,
  })
}

/// `tuple Point2D(f64, f64)`.
let collect_tuple_type = (node: Node, source: Source) -> Maybe<shared TypeNode> => {
  var name = ""
  match node.field("name") {
    Some(n) => {
      name = n.text(source.bytes)
    },
    None => {},
  }
  Some(TupleType(TupleTypeDef {
    elements: collect_tuple_elements(node, source),
    name: name,
  }))
}

/// `data Color = Red | Hex(HexStr)`.
let collect_data_type = (node: Node, source: Source) -> Maybe<shared TypeNode> => {
  var name = ""
  var constructors: []DataTypeConstructor = []
  for child in node.named_children() {
    let k = child.kind()
    if k == "data_type_name" { name = child.text(source.bytes) }
    if k == "data_type_constructor" {
      constructors.push(DataTypeConstructor {
        name: match child.field("name") {
          Some(n) => n.text(source.bytes),
          None => "",
        },
        packed: has_packed_payload(child),
        // A nullary constructor has no payload at all, which is an empty list rather than
        // an absent one.
        params: collect_constructor_params(child, source),
      })
    }
  }
  Some(DataType(DataTypeDef { constructors: constructors, name: name }))
}

/// Whether a constructor's payload was written in parentheses.
let has_packed_payload = (node: Node) -> bool => {
  for child in node.named_children() {
    if child.kind() == "anonymous_tuple_type" { return true }
  }
  false
}

/// The payload types of one data constructor.
///
/// **The two payload spellings are different shapes.** `Wrap(t)` carries one anonymous
/// tuple whose elements are the written types; `Some t` carries those types directly.
/// Flattening the parenthesised form into the juxtaposed one reads as tidier and is a
/// different tree — the Go collector was the thing that said so, since no stored golden
/// uses the packed form.
///
/// The anonymous tuple is named `?`, which is what an unnamed one answers when asked.
let collect_constructor_params = (node: Node, source: Source) -> []shared TypeNode => {
  var params: []shared TypeNode = []
  for child in node.named_children() {
    if child.kind() == "anonymous_tuple_type" {
      params.push(TupleType(TupleTypeDef {
        elements: collect_tuple_elements(child, source),
        name: "?",
      }))
      return params
    }
    // A juxtaposed payload: each type sits beside the name as a child of its own.
    match collect_type(child, source) {
      Some(collected) => params.push(collected),
      None => {},
    }
  }
  params
}

/// The element types of a `tuple_type_body` under `node`, each unwrapped from the
/// `tuple_type_element` the grammar wraps it in.
let collect_tuple_elements = (node: Node, source: Source) -> []shared TypeNode => {
  var elements: []shared TypeNode = []
  var i = 0
  for i < node.named_child_count() {
    let child = node.named_child(i)
    if child.kind() != "tuple_type_body" {
      i += 1
      continue
    }
    var j = 0
    for j < child.named_child_count() {
      let element = child.named_child(j)
      if element.kind() == "tuple_type_element" {
        match element.field("type") {
          Some(t) => match collect_type(t, source) {
            Some(collected) => elements.push(collected),
            None => {},
          },
          None => {},
        }
      }
      j += 1
    }
    i += 1
  }
  elements
}

/// `newtype Angle = f64`.
///
/// The constraints a newtype may carry (`where range(…)`) are not collected yet, which is
/// why the goldens that have them still differ — an honest gap rather than a silent one.
let collect_constrained_type = (node: Node, source: Source) -> Maybe<shared TypeNode> => {
  let name_node = node.field("name")?
  let base = collect_type(node.field("type")?, source)?
  Some(ConstrainedType(ConstrainedTypeDef {
    name: name_node.text(source.bytes),
    declared: base,
  }))
}

/// `<t, u>` — the variables a declaration binds, or none.
let collect_generic_params = (node: Node, source: Source) -> []GenericParam => {
  var params: []GenericParam = []
  // **Found among the children rather than by field name.** `named_tuple_type` exposes a
  // `generic_parameters` field and `struct_type`/`data_type` do not, so asking for the
  // field collects a tuple's variables and silently none of the other two's — which is
  // the shape of bug that prints a *shorter* tree rather than a wrong one.
  var list = node
  var found = false
  for child in node.named_children() {
    if child.kind() == "generic_parameters" {
      list = child
      found = true
    }
  }
  if !found { return params }
  for child in list.named_children() {
    if child.kind() == "generic_parameter" {
      match child.field("name") {
        Some(n) => params.push(GenericParam { location: source.location_of(child), name: n.text(source.bytes) }),
        None => {},
      }
    }
  }
  params
}

/// The name a declared type carries, which is also the declaration's own.
let type_name_of = pure (declared: shared TypeNode) -> string => match declared {
  ConstrainedType(def) => def.name,
  NamedStructType(def) => def.name,
  TupleType(def) => def.name,
  DataType(def) => def.name,
  PrimitiveType(identifier) => identifier.name,
  UnresolvedType(identifier) => identifier.name,
  GenericType(identifier) => identifier.name,
}

/// The expression inside an already-located wrapper node.
let collect_wrapped_at = (wrapper: Node, source: Source) -> Maybe<shared Expr> => {
  if named_child_count(wrapper) == 0 { return None }
  collect_expr(named_child(wrapper, 0), source)
}

/// `let x = 1`, `pub var y = 2`.
///
/// Every field is optional in the grammar even where it reads as required, so each is a
/// `field` lookup with an answer for the absent case rather than an unwrap.
let collect_declaration = (node: Node, source: Source) -> Maybe<Stmt> => {
  let binding_kind = match node.field("keyword") {
    Some(keyword) => keyword.text(source.bytes),
    None => "let",
  }
  let name = match node.field("name") {
    Some(identifier) => identifier.text(source.bytes),
    None => "",
  }
  // **The modifiers may sit on the declaration rather than on the lambda.**
  // `let add = pure (…) => …` writes them inside the lambda, and `let pure add(…) => …`
  // writes them before the name, where the grammar hangs them off the declaration as
  // `fn_modifiers`. The two spellings are one program and the Go AST records both on the
  // lambda, so what the declaration found is handed down to it.
  let (is_pure, is_async) = declaration_modifiers(node)
  let value = match node.field("value") {
    Some(expr) => match expr.kind() {
      "lambda_expr" => Some(collect_lambda(expr, source, is_pure, is_async)),
      _ => collect_expr(expr, source)
    },
    None => None,
  }
  // **The same node in two shapes**, told apart by which field it carries. A `pattern`
  // means the left side matches rather than names, and there is no `name` to read.
  match field(node, "pattern") {
    Some(pattern_node) => {
      let Some(pattern) = collect_pattern(pattern_node, source) else { return None }
      return Some(DestructuringDeclStmt(DestructuringDecl {
        location: source.location_of(node),
        keyword: binding_kind,
        pattern: pattern,
        value: value,
      }))
    },
    None => {},
  }
  Some(VarDeclStmt(VarDecl {
    location: source.location_of(node),
    binding_kind: binding_kind,
    generic_params: collect_generic_params(node, source),
    // The field's presence *is* the answer; `pub` is the only thing it can say.
    is_public: match node.field("visibility") {
      Some(_) => true,
      None => false,
    },
    name: name,
    // **The annotation sits in a wrapper of its own** (`type_annotation`), holding the
    // written type in a `type` field — the same shape a return type has, and not the
    // shape the value fields have.
    type_annotation: match node.field("type_annotation") {
      Some(wrapper) => match wrapper.field("type") {
        Some(declared) => collect_type(declared, source),
        None => None,
      },
      None => None,
    },
    value: value,
  }))
}

/// The `pure` and `async` a declaration may carry ahead of its name, as `(pure, async)`.
///
/// Answering a pair rather than reading the fields at the two use sites: they are written
/// together, they travel together, and a caller that asked for one and forgot the other is
/// the mistake this shape rules out.
let declaration_modifiers = (node: Node) -> (bool, bool) => {
  let Some(list) = node.field("modifiers") else { return (false, false) }
  var is_pure = false
  var is_async = false
  for child in list.named_children() {
    match child.kind() {
      "pure_modifier" => { is_pure = true },
      "async_modifier" => { is_async = true },
      _ => {}
    }
  }
  (is_pure, is_async)
}

/// `match x { … }`.
///
/// The arms are children rather than a field, and the scrutinee is the `value` field — so
/// a walk over the children meets the arms and nothing else, comments aside.
let collect_match = (node: Node, source: Source) -> Maybe<shared Expr> => {
  let scrutinee = collect_expr(node.field("value")?, source)?
  var arms: []MatchArm = []
  for child in node.named_children() {
    if child.kind() != "match_arm" { continue }
    match collect_match_arm(child, source) {
      Some(arm) => arms.push(arm),
      None => {},
    }
  }
  Some(MatchExpr(Match {
    location: source.location_of(node),
    match_arms: arms,
    scrutinee: scrutinee
  }))
}

/// One arm: `p if g => body`.
///
/// The guard is a node of its own in the AST (`GuardExpr`) holding the condition the
/// grammar puts in `guard_expression`, so the wrapper is built here rather than the
/// condition being carried bare.
let collect_match_arm = (node: Node, source: Source) -> Maybe<MatchArm> => {
  let pattern = collect_pattern(node.field("pattern")?, source)?
  let body = collect_expr(node.field("body")?, source)?
  Some(MatchArm {
    body: body,
    guard: match node.field("guard") {
      Some(guard) => collect_guard(guard, source),
      None => None,
    },
    pattern: pattern,
  })
}

/// `if x > 0` on an arm.
let collect_guard = (node: Node, source: Source) -> Maybe<shared Expr> => {
  let condition = collect_expr(node.field("guard_expression")?, source)?
  Some(GuardExpr(Guard { location: source.location_of(node), condition: condition }))
}

/// One pattern, or `None` for a form this slice does not collect.
///
/// The grammar wraps a destructuring declaration's pattern in `destructuring_only_pattern`,
/// the fourth wrapper in this walk — so it is unwrapped like the others rather than given
/// a case of its own.
let collect_pattern = (node: Node, source: Source) -> Maybe<shared Pattern> => {
  match node.kind() {
    "destructuring_only_pattern" => {
      if node.named_child_count() == 0 { return None }
      return collect_pattern(node.named_child(0), source)
    },
    "identifier" =>
      return Some(IdentifierPattern(Identifier { location: source.location_of(node), name: node.text(source.bytes) })),
    "data_pattern" => {
      let name_node = node.field("name")?
      return Some(DataPattern(DataPatternDef {
        location: source.location_of(node),
        name: name_node.text(source.bytes),
        pattern: match node.field("pattern") {
          Some(inner) => collect_pattern(inner, source),
          None => None,
        },
      }))
    },
    "literal_pattern" => return Some(collect_literal_pattern(node, source)),
    "wildcard_pattern" =>
      return Some(WildcardPattern(Wildcard { location: source.location_of(node) })),
    "range_pattern" => return Some(RangePattern(PatternRange {
      location: source.location_of(node),
      end: match node.field("end") {
        Some(e) => collect_expr(e, source),
        None => None,
      },
      end_operator: match node.field("end_operator") {
        Some(operator) => text(operator, source.bytes),
        None => "",
      },
      start: match node.field("start") {
        Some(e) => collect_expr(e, source),
        None => None,
      },
    })),
    "tuple_pattern" =>
      return Some(TuplePattern(PatternList { location: source.location_of(node), elements: collect_pattern_list(node, source) })),
    "array_pattern" =>
      return Some(ArrayPattern(PatternList { location: source.location_of(node), elements: collect_pattern_list(node, source) })),
    "or_pattern" =>
      return Some(OrPattern(PatternList { location: source.location_of(node), elements: collect_pattern_list(node, source) })),
    "rest_pattern" => return Some(RestPattern(Rest {
      location: source.location_of(node),
      identifier: match node.field("identifier") {
        Some(name) => name.text(source.bytes),
        None => "",
      },
    })),
    "binding_pattern" => {
      let name_node = node.field("name")?
      let inner = collect_pattern(node.field("pattern")?, source)?
      return Some(BindingPattern(BindingPatternDef {
        location: source.location_of(node),
        name: name_node.text(source.bytes),
        pattern: inner,
      }))
    },
    "struct_pattern" => return Some(collect_struct_pattern(node, source)),
    _ => None
  }
}

/// `42`, `"s"`, `'a'`.
///
/// **The raw text, except for a character literal**, whose decoded code point is stored
/// instead — the one literal whose pattern and expression forms disagree about what the
/// value *is*, and the reason this reuses the character collector rather than the text.
let collect_literal_pattern = (node: Node, source: Source) -> shared Pattern => {
  if node.named_child_count() > 0 {
    let child = node.named_child(0)
    if child.kind() == "char_literal" {
      return match collect_character(child, source) {
        CharacterLiteralExpr(lit) =>
          LiteralPattern(LiteralPatternDef { location: source.location_of(node), value: quote_rune(lit.value) }),
        _ => LiteralPattern(LiteralPatternDef { location: source.location_of(node), value: node.text(source.bytes) }),
      }
    }
  }
  LiteralPattern(LiteralPatternDef {
    location: source.location_of(node),
    value: node.text(source.bytes)
  })
}

/// A code point as Go's `strconv.QuoteRune` renders it: `'a'`, `'\n'`, `'\x00'`.
///
/// **Why a quoted rune and not a number.** The Go field is `any`, and a character pattern
/// puts a `RunePatternValue` in it — an integer type with a `String()` method — which the
/// printer's `%v` reaches. Every other literal pattern holds a plain string, and the same
/// `%v` prints that as itself. So one field prints two ways depending on what was put in
/// it, and this is the half that is not the source text.
///
/// The gap, stated: Go decides whether a **non-ASCII** rune is printable from Unicode
/// tables, quoting an unprintable one as `\uXXXX`. There is no such table here, so one is
/// rendered as itself — right for every letter and wrong for, say, a zero-width joiner.
/// ASCII, which is where the escapes live, is exact.
let quote_rune = pure (value: i64) -> string => {
  if value == i64('\n') { return "'\\n'" }
  if value == i64('\t') { return "'\\t'" }
  if value == i64('\r') { return "'\\r'" }
  if value == i64('\\') { return "'\\\\'" }
  if value == i64('\'') { return "'\\''" }
  if value == 7 { return "'\\a'" }
  if value == 8 { return "'\\b'" }
  if value == 11 { return "'\\v'" }
  if value == 12 { return "'\\f'" }
  // The other ASCII controls, `\x00` through `\x1f` and `\x7f`, in two hex digits.
  if value < 32 || value == 127 {
    return "'\\x${hex_digit(value / 16)}${hex_digit(value % 16)}'"
  }
  "'${rune(value)}'"
}

/// One lower-case hex digit.
let hex_digit = pure (value: i64) -> string =>
  if value < 10 { "${value}" } else { "${rune(i64('a') + value - 10)}" }

/// The element patterns of a tuple, array or or-pattern, each a child directly.
let collect_pattern_list = (node: Node, source: Source) -> []shared Pattern => {
  var elements: []shared Pattern = []
  for child in node.named_children() {
    if child.kind() == "comment" { continue }
    match collect_pattern(child, source) {
      Some(element) => elements.push(element),
      None => {},
    }
  }
  elements
}

/// `{ x, y: 0, ...rest }`.
///
/// Three shapes of field under one kind: a bare name (no pattern at all), a
/// `struct_field_with_pattern`, and a rest element — which becomes a field **named
/// `...`**, the Go collector's spelling, holding the `RestPattern`.
let collect_struct_pattern = (node: Node, source: Source) -> shared Pattern => {
  var fields: []StructPatternField = []
  for child in node.named_children() {
    if child.kind() != "struct_field_pattern" { continue }
    match child.field("struct_field_with_pattern") {
      Some(with_pattern) => {
        match collect_struct_pattern_field(with_pattern, source) {
          Some(f) => fields.push(f),
          None => {},
        }
        continue
      },
      None => {},
    }
    // A rename (`a: foo`) is a fourth shape, and a *different node* from a field with a
    // pattern under it — the new name is a `new_name`, not a pattern — so it is turned
    // into the identifier pattern the Go collector builds.
    match child.field("struct_field_rename") {
      Some(rename) => {
        match collect_struct_pattern_rename(rename, source) {
          Some(f) => fields.push(f),
          None => {},
        }
        continue
      },
      None => {},
    }
    match field(child, "rest_pattern") {
      Some(rest) => {
        match collect_pattern(rest, source) {
          Some(inner) => fields.push(StructPatternField {
            location: source.location_of(child),
            name: "...",
            pattern: Some(inner),
          }),
          None => {},
        }
        continue
      },
      None => {},
    }
    match field(child, "name") {
      Some(name) => fields.push(StructPatternField {
        location: source.location_of(child),
        name: name.text(source.bytes),
        pattern: None,
      }),
      None => {},
    }
  }
  StructPattern(StructPatternDef {
    location: source.location_of(node),
    fields: fields,
    name: ""
  })
}

/// `a: foo` — the field `a`, bound under the name `foo`.
let collect_struct_pattern_rename = (
  node: Node,
  source: Source
) -> Maybe<StructPatternField> => {
  let name = node.field("name")?
  let new_name = node.field("new_name")?
  Some(StructPatternField {
    location: source.location_of(node),
    name: name.text(source.bytes),
    pattern: Some(IdentifierPattern(Identifier { location: source.location_of(new_name), name: new_name.text(source.bytes) })),
  })
}

/// `y: 0` — a named field with a pattern under it.
let collect_struct_pattern_field = (
  node: Node,
  source: Source
) -> Maybe<StructPatternField> => {
  let name = node.field("name")?
  let inner = collect_pattern(node.field("pattern")?, source)?
  Some(StructPatternField {
    location: source.location_of(node),
    name: name.text(source.bytes),
    pattern: Some(inner)
  })
}

/// One expression, or `None` for a kind this slice does not collect.
let collect_expr = (node: Node, source: Source) -> Maybe<shared Expr> =>
  match node.kind() {
    "integer_literal" => Some(collect_integer(node, source)),
    "char_literal" => Some(collect_character(node, source)),
    "float_literal" => Some(collect_float(node, source)),
    "string_literal" => Some(collect_string(node, source)),
    "raw_string_literal" => Some(collect_raw_string(node, source)),
    // A lambda met as an expression carries whatever modifiers it was written with; only
    // a declaration can hand it more.
    "lambda_expr" => Some(collect_lambda(node, source, false, false)),
    "identifier" => Some(IdentifierExpr(Identifier { location: source.location_of(node), name: node.text(source.bytes) })),
    // A const name is a **kind of its own**, so nothing here reads the spelling to decide
    // — `MAX` is const because the grammar said so, not because it is upper case.
    "const_identifier" =>
      Some(IdentifierExpr(Identifier { location: source.location_of(node), is_const: true, name: node.text(source.bytes) })),
    "binary_expr" => collect_binary(node, source),
    "call_expr" => collect_call(node, source),
    "block" => Some(collect_block(node, source)),
    "if_block_expr" => collect_if(node, source),
    "for_in_loop" => collect_for_in_loop(node, source),
    "for_loop" => collect_for_loop(node, source),
    "compound_assignment" => collect_compound_assignment(node, source),
    "match_expr" => collect_match(node, source),
    // A loop's body is a block under another name, which is how the Go collector reads it
    // too — so the three kinds share one collector rather than each growing a case.
    "for_body" | "for_in_body" => Some(collect_block(node, source)),
    // `a?.b` and `a?[i]` are **separate node kinds**, not a flag on the ordinary ones, so
    // the optional-ness is decided here and carried into one collector rather than
    // re-derived from the text.
    "member_expr" => collect_member(node, source, false),
    "optional_member_expr" => collect_member(node, source, true),
    "index_expr" => collect_index(node, source, false),
    "optional_index_expr" => collect_index(node, source, true),
    "tuple_index_expr" => collect_tuple_index(node, source),
    "boolean_expr" => collect_boolean(node, source),
    "string_concat_expr" => collect_string_concat(node, source),
    // Named and anonymous are separate CST kinds and separate AST nodes, and one walk:
    // what differs is a name the anonymous form does not have.
    "named_struct_literal" => Some(collect_struct_instance(node, source, true)),
    "anonymous_struct_literal" => Some(collect_struct_instance(node, source, false)),
    "spread_expr" => collect_spread(node, source),
    "tuple_literal" => Some(collect_tuple_literal(node, source)),
    "array_literal" => Some(collect_array_literal(node, source)),
    "array_repeat_init" => collect_array_repeat(node, source),
    "negation" => collect_unary(node, source, false),
    "try_expr" => collect_unary(node, source, true),
    "range_expr" => collect_range(node, source),
    _ => None
  }

/// `person.name`.
let collect_member = (
  node: Node,
  source: Source,
  optional: bool
) -> Maybe<shared Expr> => {
  let object_node = node.field("object")?
  let property_node = node.field("property")?
  let object = collect_expr(object_node, source)?
  let property = collect_expr(property_node, source)?
  Some(MemberExpr(MemberAccess {
    location: source.location_of(node),
    object: object,
    optional: optional,
    property: property,
  }))
}

/// `array[0]`.
let collect_index = (
  node: Node,
  source: Source,
  optional: bool
) -> Maybe<shared Expr> => {
  let object_node = node.field("object")?
  let index_node = node.field("index")?
  let object = collect_expr(object_node, source)?
  let subscript = collect_expr(index_node, source)?
  Some(IndexExpr(IndexAccess {
    location: source.location_of(node),
    index: subscript,
    object: object,
    optional: optional,
  }))
}

/// `pair.0` — the position is read from the text, the grammar having already decided it
/// is a decimal integer.
let collect_tuple_index = (node: Node, source: Source) -> Maybe<shared Expr> => {
  let object_node = node.field("object")?
  let index_node = node.field("index")?
  let object = collect_expr(object_node, source)?
  Some(TupleIndexExpr(TupleIndexAccess {
    location: source.location_of(node),
    index: digits_value(index_node.text(source.bytes).to_runes(), 10),
    object: object,
  }))
}

/// `foo()`, `bar(1, x)`.
///
/// `None` when the callee is a shape this slice does not collect: a call whose function is
/// missing is not a call, and printing it with the callee left out would be a node that
/// never occurs.
let collect_call = (node: Node, source: Source) -> Maybe<shared Expr> => {
  let callee_node = node.field("function")?
  let callee = collect_expr(callee_node, source)?
  var arguments: []shared Expr = []
  match node.field("arguments") {
    Some(list) => {
      for i in 0..<list.named_child_count() {
        // **Each argument is wrapped in a `value` node** by the grammar, so the
        // expression is one level down; a walk that took the wrapper would ask for the
        // kind of a node that is never an expression and collect nothing.
        let wrapper = list.named_child(i)
        let inner = if wrapper.kind() == "value" && wrapper.named_child_count() > 0 {
          wrapper.named_child(0)
        } else {
          wrapper
        }
        match collect_expr(inner, source) {
          Some(argument) => arguments.push(argument),
          None => {},
        }
      }
    },
    None => {},
  }
  Some(FunctionCallExpr(FunctionCall {
    location: source.location_of(node),
    arguments: arguments,
    function: callee,
    generic_arguments: collect_generic_arguments(node, source),
  }))
}

/// `::<i64, i64>` — the type arguments written at a callee or a tuple name, or none.
///
/// The types sit directly under the `generic_arguments` node rather than in a wrapper
/// each, which is why this is a walk over its children and not over a field.
let collect_generic_arguments = (node: Node, source: Source) -> []shared TypeNode => {
  var arguments: []shared TypeNode = []
  let Some(list) = node.field("generic_arguments") else { return arguments }
  for child in list.named_children() {
    match collect_type(child, source) {
      Some(argument) => arguments.push(argument),
      None => {},
    }
  }
  arguments
}

/// `if c { … } else { … }`.
///
/// The `else` branch is whatever the grammar put there — a block, or another
/// `if_block_expr` for an `else if` — so this collects an expression and does not ask
/// which, and the ladder keeps its shape.
let collect_if = (node: Node, source: Source) -> Maybe<shared Expr> => {
  let condition = collect_expr(node.field("condition")?, source)?
  Some(IfExpr(Conditional {
    location: source.location_of(node),
    condition: condition,
    else_branch: match node.field("else_branch") {
      Some(branch) => collect_expr(branch, source),
      None => None,
    },
    then_branch: match node.field("then_block") {
      Some(branch) => collect_expr(branch, source),
      None => None,
    },
  }))
}

/// `for item, idx in xs { … }`.
///
/// **The parts are children rather than fields**, so which binding is which comes from the
/// child's *kind* — `for_variable_or_key` then `for_index_or_value` — and the iterable is
/// the one child of the condition that is neither. A comment can sit there, so it is
/// skipped explicitly: taking "the last child that is not a binding" would collect one.
let collect_for_in_loop = (node: Node, source: Source) -> Maybe<shared Expr> => {
  var key = ""
  var value = ""
  var iterable: Maybe<shared Expr> = None
  var body: Maybe<shared Expr> = None
  var label = ""
  for child in node.named_children() {
    let k = child.kind()
    if k == "label" { label = child.text(source.bytes) }
    if k == "for_in_body" { body = collect_expr(child, source) }
    if k != "for_in_condition" { continue }
    for part in child.named_children() {
      let part_kind = part.kind()
      if part_kind == "for_variable_or_key" { key = part.text(source.bytes) }
      else if part_kind == "for_index_or_value" { value = part.text(source.bytes) }
      else if part_kind != "comment" { iterable = collect_expr(part, source) }
    }
  }
  // A loop missing its iterable or its body is not a loop: the Go collector reports and
  // answers nothing, and printing a loop with a hole would be a node that never occurs.
  let Some(over) = iterable else { return None }
  let Some(block) = body else { return None }
  Some(ForInLoopExpr(ForInLoop {
    location: source.location_of(node),
    body: block,
    iterable: over,
    key: key,
    label: label,
    value: value,
  }))
}

/// `for var i = 0; i < n; i += 1 { … }`, and every shorter form.
///
/// The three header parts live inside a `for_condition` and each is optional; the infinite
/// loop has no `for_condition` at all.
let collect_for_loop = (node: Node, source: Source) -> Maybe<shared Expr> => {
  var label = ""
  var body: Maybe<shared Expr> = None
  var condition: Maybe<shared Expr> = None
  var init: Maybe<VarDecl> = None
  var post: Maybe<shared Expr> = None
  for child in node.named_children() {
    let k = child.kind()
    if k == "label" { label = child.text(source.bytes) }
    if k == "for_body" { body = collect_expr(child, source) }
    if k != "for_condition" { continue }
    match child.field("condition_expr") {
      Some(expr) => { condition = collect_expr(expr, source) },
      None => {},
    }
    match child.field("initial_expr") {
      Some(expr) => { init = collect_for_init(expr, source) },
      None => {},
    }
    match child.field("post_expr") {
      Some(expr) => { post = collect_wrapped_at(expr, source) },
      None => {},
    }
  }
  let Some(block) = body else { return None }
  Some(ForLoopExpr(ForLoop {
    location: source.location_of(node),
    body: block,
    condition: condition,
    init: init,
    label: label,
    post: post,
  }))
}

/// `var i = 0` in a loop header — the same declaration node under another kind, which is
/// why this reuses the declaration collector and then asks for the binding it produced.
let collect_for_init = (node: Node, source: Source) -> Maybe<VarDecl> =>
  match collect_declaration(node, source) {
    Some(VarDeclStmt(decl)) => Some(decl),
    _ => None,
  }

/// `i += 1`.
///
/// The same three fields the arithmetic operators have, under a node kind of its own — so
/// `+=` is never mistaken for `+` by an operator table.
let collect_compound_assignment = (node: Node, source: Source) -> Maybe<shared Expr> => {
  let operator = node.field("operator")?
  let left = collect_expr(node.field("left")?, source)?
  let right = collect_expr(node.field("right")?, source)?
  Some(MathAssignOpExpr(BinaryOp {
    location: source.location_of(node),
    left: left,
    operator: operator.text(source.bytes),
    right: right,
  }))
}

/// `{ … }` — the statements it holds, in order.
///
/// It reuses `collect_statement`, so a block's contents are collected by exactly the rule
/// the file's top level is, comment-skipping included.
let collect_block = (node: Node, source: Source) -> shared Expr => {
  var statements: []Stmt = []
  for child in node.named_children() {
    match collect_statement(child, source) {
      Some(statement) => statements.push(statement),
      None => {},
    }
  }
  BlockExpr(Block { location: source.location_of(node), statements: statements })
}

/// `(x: i64) -> i64 => x * 2`.
/// Whether `node` carries the named field at all, which for a modifier is the whole
/// question: `pure` is a field the grammar sets and has no value to read.
///
/// Its own function because a `match` is not an operand of `||`, and the alternative was
/// a `var` and two statements ahead of a struct literal that reads well as one expression.
let has_field = (self: Node, name: string) -> bool => match self.field(name) {
  Some(_) => true,
  None => false,
}

let collect_lambda = (
  node: Node,
  source: Source,
  declared_pure: bool,
  declared_async: bool
) -> shared Expr => {
  var parameters: []Parameter = []
  match node.field("parameters") {
    Some(list) => {
      for child in list.named_children() {
        if child.kind() == "parameter" {
          match collect_parameter(child, source) {
            Some(parameter) => parameters.push(parameter),
            None => {},
          }
        }
      }
    },
    None => {},
  }
  LambdaExpr(Lambda {
    location: source.location_of(node),
    body: match node.field("body") {
      Some(body) => collect_expr(body, source),
      None => None,
    },
    is_async: declared_async || node.has_field("is_async"),
    is_pure: declared_pure || node.has_field("is_pure"),
    parameters: parameters,
    return_type: match node.field("return_type") {
      Some(declared) => collect_return_type(declared, source),
      None => None,
    },
  })
}

/// `x: i64` — a pattern and the type annotating it.
///
/// `None` when the pattern is a form this slice does not collect, since a parameter with
/// no pattern is not a parameter.
let collect_parameter = (node: Node, source: Source) -> Maybe<Parameter> => {
  let pattern_node = node.field("pattern")?
  if kind(pattern_node) != "identifier" { return None }
  Some(Parameter {
    location: source.location_of(node),
    // The default sits in a `default_value` wrapper holding an `expression` field.
    default_value: match node.field("default_value") {
      Some(wrapper) => match wrapper.field("expression") {
        Some(expr) => collect_expr(expr, source),
        None => None,
      },
      None => None,
    },
    pattern: IdentifierPattern(Identifier { location: source.location_of(pattern_node), name: text(pattern_node, source.bytes) }),
    type_annotation: match node.field("type") {
      Some(declared) => collect_type(declared, source),
      None => None,
    },
  })
}

/// `-> i64`.
let collect_return_type = (node: Node, source: Source) -> Maybe<ReturnType> => {
  let declared = node.field("type")?
  match collect_type(declared, source) {
    Some(collected) => Some(ReturnType { type_annotation: collected }),
    None => None,
  }
}

/// A written type, or `None` for a form this slice does not collect.
///
/// The primitives are exactly the kinds the grammar names for them, so the *kind* decides
/// and the text is only the name — no list of spellings to fall out of date.
let collect_type = (node: Node, source: Source) -> Maybe<shared TypeNode> => {
  return match node.kind() {
    // **`bool` is the one primitive whose AST name is not what was written**: the Go
    // collector maps `boolean_type` to `types.Boolean`, which is spelled `boolean`, where
    // every other primitive takes its name from the source text. Reading the text here
    // gave `bool`, which no golden could see — none of the ones matching uses a boolean
    // annotation — and the differential test did (09/24).
    "boolean_type" => Some(PrimitiveType(Identifier { location: source.location_of(node), name: "boolean" })),
    "signed_integer_type" | "unsigned_integer_type" | "float_type" | "string_type"
      | "rune_type" => Some(PrimitiveType(Identifier { location: source.location_of(node), name: node.text(source.bytes) })),
    // A name the program declared. The collector records what was written and does not
    // look it up — resolution is the typechecker's, which is what "unresolved" says.
    "user_defined_type_name" =>
      Some(UnresolvedType(Identifier { location: source.location_of(node), name: text(node, source.bytes) })),
    // A variable the enclosing declaration bound.
    "generic_type" => Some(GenericType(Identifier { location: source.location_of(node), name: node.text(source.bytes) })),
    // `(i64, i64)` written inside another type — the same node a packed data payload
    // carries, and named `?` for the same reason: an unnamed tuple answers that when
    // asked for its name.
    "anonymous_tuple_type" => Some(TupleType(TupleTypeDef {
      elements: collect_tuple_elements(node, source),
      name: "?",
    })),
    _ => None
  }
}

/// `a + b`, `x * 2` — the arithmetic operators only.
///
/// A comparison or a boolean operator is a **different node** in the Go AST
/// (`BooleanBinaryOpExpr`), so one is not collected here rather than collected as this:
/// printing the wrong node is worse than printing none, which a diff shows plainly.
let collect_binary = (node: Node, source: Source) -> Maybe<shared Expr> => {
  let operator = node.field("operator")?
  if !is_math_operator(operator.kind()) { return None }
  let left_node = node.field("left")?
  let right_node = node.field("right")?
  let left = collect_expr(left_node, source)?
  let right = collect_expr(right_node, source)?
  Some(MathBinaryOpExpr(BinaryOp {
    location: source.location_of(node),
    left: left,
    operator: operator.text(source.bytes),
    right: right,
  }))
}

/// `a < b`, `p && q` — comparison and logic.
///
/// A separate CST kind from `binary_expr`, so the grammar has already told the two apart
/// and nothing here classifies an operator: the node's kind is the answer.
let collect_boolean = (node: Node, source: Source) -> Maybe<shared Expr> => {
  let operator = field(node, "operator")?
  let left = collect_expr(node.field("left")?, source)?
  let right = collect_expr(node.field("right")?, source)?
  Some(BooleanBinaryOpExpr(BinaryOp {
    location: source.location_of(node),
    left: left,
    operator: operator.text(source.bytes),
    right: right,
  }))
}

/// `"a" ++ b`.
///
/// A node kind of its own, as `boolean_expr` is — so `++` is never classified here, and a
/// concatenation cannot be collected as arithmetic by an operator table that grew a case.
let collect_string_concat = (node: Node, source: Source) -> Maybe<shared Expr> => {
  let operator = node.field("operator")?
  let left = collect_expr(node.field("left")?, source)?
  let right = collect_expr(node.field("right")?, source)?
  Some(StringConcatExpr(BinaryOp {
    location: source.location_of(node),
    left: left,
    operator: operator.text(source.bytes),
    right: right,
  }))
}

/// `Point { x: 1 }`, `{ x: 1 }`, `Player { p | health: h }`.
///
/// The body holds exactly one of three shapes and they are collected into the same list:
/// `struct_fields` (named), `struct_shorthand` (positional, so each field has a value and
/// no name) and `struct_update` (a base and the fields that change).
let collect_struct_instance = (
  node: Node,
  source: Source,
  named: bool
) -> shared Expr => {
  var fields: []StructInstanceField = []
  var base: Maybe<shared Expr> = None
  match node.field("struct_body") {
    Some(body) => {
      for part in body.named_children() {
        let k = part.kind()
        match k {
          "struct_fields" | "struct_update" => {
            for f in collect_struct_instance_fields(part, source) {
              fields.push(f)
            }
            if k == "struct_update" {
              base = match part.field("base") {
                Some(b) => collect_expr(b, source),
                None => None,
              }
            }
          },
          "struct_shorthand" => {
            for j in 0..<part.named_child_count() {
              let value_node = part.named_child(j)
              if value_node.kind() != "field_value" { continue }
              match collect_wrapped_at(value_node, source) {
                Some(value) =>
                  fields.push(StructInstanceField { name: "", value: value }),
                None => {},
              }
            }
          },
          _ => {},
        }
      }
    },
    None => {},
  }
  let instance = StructInstance {
    location: source.location_of(node),
    base_struct: base,
    fields: fields,
    generic_args: collect_generic_arguments(node, source),
    name: match node.field("struct_name") {
      Some(name) => name.text(source.bytes),
      None => "",
    },
  }
  if named { StructInstanceExpr(instance) } else { AnonymousStructInstanceExpr(instance) }
}

/// The `struct_field` children of `node`: `x: 1`, each value inside a `field_value`.
///
/// Shared by the named and the record-update shapes, whose fields are the same node —
/// `struct_update` names them `field_updates` and holds the same kind.
let collect_struct_instance_fields = (
  node: Node,
  source: Source
) -> []StructInstanceField => {
  var fields: []StructInstanceField = []
  for child in node.named_children() {
    if child.kind() != "struct_field" { continue }
    let Some(value_node) = child.field("field_value") else { continue }
    match collect_wrapped_at(value_node, source) {
      Some(value) => fields.push(StructInstanceField {
        name: match child.field("field_name") {
          Some(name) => name.text(source.bytes),
          None => "",
        },
        value: value,
      }),
      None => {},
    }
  }
  fields
}

/// `...xs`.
let collect_spread = (node: Node, source: Source) -> Maybe<shared Expr> => {
  let value = collect_expr(node.field("value")?, source)?
  Some(SpreadExpr(Spread { location: source.location_of(node), value: value }))
}

/// `(1, 2)` and `Point(1, 2)`.
///
/// Each element is wrapped in a `tuple_value`, as an argument is in a `value`. An unnamed
/// tuple has no `tuple_name` field and takes `?`, the placeholder the Go collector uses
/// and `TupleTypeDef` already carries.
let collect_tuple_literal = (node: Node, source: Source) -> shared Expr => {
  var elements: []shared Expr = []
  var arguments: []shared TypeNode = []
  for child in node.named_children() {
    match child.kind() {
      "tuple_value" if child.named_child_count() > 0 => {
        match collect_expr(child.named_child(0), source) {
          Some(element) => elements.push(element),
          None => {},
        }
      },
      "generic_arguments" => {
        for j in 0..<child.named_child_count() {
          match collect_type(child.named_child(j), source) {
            Some(argument) => arguments.push(argument),
            None => {},
          }
        }
      },
      _ => {}
    }
  }
  TupleLiteralExpr(TupleLiteral {
    location: source.location_of(node),
    elements: elements,
    generic_arguments: arguments,
    name: match node.field("tuple_name") {
      Some(name) => name.text(source.bytes),
      None => "?",
    },
  })
}

/// `[1, 2, 3]` and `#[1, 2, 3]`.
///
/// The elements are children directly rather than through a wrapper — the one list in this
/// walk that is not wrapped — and `#[` is exposed as a `fixed` field, so the flavor is read
/// rather than derived from the text.
let collect_array_literal = (node: Node, source: Source) -> shared Expr => {
  var elements: []shared Expr = []
  for child in node.named_children() {
    match collect_expr(child, source) {
      Some(element) => elements.push(element),
      None => {},
    }
  }
  ArrayLiteralExpr(ArrayLiteral {
    location: source.location_of(node),
    elements: elements,
    fixed: node.has_field("fixed"),
  })
}

/// `[0; n]` and `#[0; 8]`.
///
/// The count sits in an `array_repeat_count` wrapper and the value does not, which is why
/// only one of the two is unwrapped.
let collect_array_repeat = (node: Node, source: Source) -> Maybe<shared Expr> => {
  let value = collect_expr(node.field("value")?, source)?
  let count_node = node.field("count")?
  if count_node.named_child_count() == 0 { return None }
  let repeated = collect_expr(count_node.named_child(0), source)?
  Some(ArrayRepeatExpr(ArrayRepeat {
    location: source.location_of(node),
    count: repeated,
    fixed: node.has_field("fixed"),
    value: value,
  }))
}

/// `-x` and `read()?` — one operand under two node names.
let collect_unary = (node: Node, source: Source, is_try: bool) -> Maybe<shared Expr> => {
  let operand = collect_expr(node.field("operand")?, source)?
  if is_try { Some(TryExpr(Unary {
    location: source.location_of(node),
    operand: operand
  })) }
  else { Some(NegationExpr(Unary {
    location: source.location_of(node),
    operand: operand
  })) }
}

/// `0..<10`, `0..<=9:2`.
///
/// **Each bound is wrapped** by the grammar (`range_start`, `range_end`, `range_step`), the
/// same shape an argument has, so the expression is one level down. A walk that took the
/// wrapper would ask for the kind of a node that is never an expression and collect
/// nothing — which is how a range would have printed as empty rather than wrong.
let collect_range = (node: Node, source: Source) -> Maybe<shared Expr> => {
  Some(RangeExpr(Range {
    location: source.location_of(node),
    end: collect_wrapped(node, "end", source),
    end_operator: match node.field("end_operator") {
      Some(operator) => range_end_operator(text(operator, source.bytes)),
      None => None,
    },
    start: collect_wrapped(node, "start", source),
    step: collect_wrapped(node, "step", source),
  }))
}

/// The operator a range's end was written with.
///
/// `None` for anything else, which the grammar cannot produce — `range_end_operator` is
/// `choice("<=", ">=", "<", ">")`. The arm exists because a set the grammar guarantees is
/// still a set this function has to be total over, and answering `None` is the honest
/// reading of "not one of them".
let range_end_operator = pure (symbol: string) -> Maybe<RangeEndOperator> =>
  match symbol {
    "<" => Some(LessThan),
    "<=" => Some(LessThanOrEqual),
    ">" => Some(GreaterThan),
    ">=" => Some(GreaterThanOrEqual),
    _ => None,
  }

/// A field whose value the grammar wraps in a node of its own: the expression inside it, or
/// `None` when the field is absent — an open bound, or a range with no step.
let collect_wrapped = (
  node: Node,
  name: string,
  source: Source
) -> Maybe<shared Expr> => {
  let wrapper = node.field(name)?
  if wrapper.named_child_count() == 0 { return None }
  collect_expr(wrapper.named_child(0), source)
}

/// Whether an operator node's kind is one of the arithmetic ones.
let is_math_operator = pure (k: string) -> bool =>
  k == "add_operator" || k == "sub_operator" || k == "mul_operator" ||
  k == "div_operator" || k == "rem_operator" || k == "rem_floor_operator"

/// `42`, `0x2A`, `0b101010`, `0o52`.
///
/// The base is the **child's kind**, not something re-derived from the text: the grammar
/// already decided, and two answers to one question is how they come to disagree.
let collect_integer = (node: Node, source: Source) -> shared Expr => {
  let base = integer_base(node)
  let digits = node.text(source.bytes).to_runes()
  // A prefix is two runes (`0x`, `0b`, `0o`); base 10 has none.
  let start = if base == 10 { 0 } else { 2 }
  IntegerLiteralExpr(IntegerLiteral {
    location: source.location_of(node),
    base: base,
    value: digits_value(digits.slice(start, digits.len()), base),
  })
}

/// The base the grammar recognised: `decimal_int`, `binary_int`, `octal_int` or
/// `hexadecimal_int`, one named child of the literal.
let integer_base = (node: Node) -> i64 => {
  if node.named_child_count() == 0 { return 10 }
  return match kind(node.named_child(0)) {
    "binary_int" => 2,
    "octal_int" => 8,
    "hexadecimal_int" => 16,
    _ => 10
  }
}

/// `'a'`, `'\n'` — the code point, quotes stripped and the escape decoded.
let collect_character = (node: Node, source: Source) -> shared Expr => {
  let raw = node.text(source.bytes).to_runes()
  let inner = raw.slice(1, raw.len() - 1)
  let decoded = decode_escapes(inner).to_runes()
  CharacterLiteralExpr(CharacterLiteral {
    location: source.location_of(node),
    // An empty literal does not parse, so the guard is for a malformed tree rather than a
    // program: answering 0 keeps one bad node from taking the file down with it.
    value: if decoded.len() == 0 { 0 } else { i64(decoded[0]) },
  })
}

/// `"hi"` — the text, quotes stripped and escapes decoded.
let collect_string = (node: Node, source: Source) -> shared Expr => {
  // **An interpolation makes it a different node**, not a string with extra parts: the Go
  // AST has `InterpolatedStringExpr` with segments, where a text run is itself a
  // `StringLiteralExpr` segment. The list is homogeneous, so a reader needs no second
  // shape for "the parts that are not expressions".
  if has_interpolation(node) {
    var segments: []shared Expr = []
    var i = 0
    for child in node.named_children() {
      let k = child.kind()
      if k == "string_content" {
        // **The whole literal's span, not the run's.** The Go collector builds a text
        // chunk with the string's own location, so a segment reports where the string is
        // rather than where the text inside it sits.
        segments.push(StringLiteralExpr(StringLiteral {
          location: source.location_of(node),
          value: decode_escapes(child.text(source.bytes).to_runes()),
        }))
      }
      if k == "string_interpolation" && named_child_count(child) > 0 {
        match collect_expr(child.named_child(0), source) {
          Some(expr) => segments.push(expr),
          None => {},
        }
      }
      i += 1
    }
    return InterpolatedStringExpr(Interpolated {
      location: source.location_of(node),
      segments: segments
    })
  }
  let raw = text(node, source.bytes).to_runes()
  StringLiteralExpr(StringLiteral {
    location: source.location_of(node),
    value: decode_escapes(raw.slice(1, raw.len() - 1))
  })
}

/// Whether a string literal holds at least one `${…}`.
let has_interpolation = (node: Node) -> bool => {
  for child in node.named_children() {
    if child.kind() == "string_interpolation" { return true }
  }
  false
}

/// The runes with their escape sequences resolved.
///
/// The set is `pkg/analyzer/collector/expressions/string_literal.go`'s: the simple escapes,
/// `\oNNN`, `\xNN`, `\uNNNN` and `\UNNNNNNNN`. A sequence too short for its digits is left
/// as written rather than half-read — the grammar does not produce one, and inventing a
/// value for a malformed literal is how a collector comes to disagree with the compiler
/// about what a program says.
///
/// **One divergence, deliberate and narrow.** Go writes `\xNN` as a *byte*, so `"\xE9"`
/// there is one byte that is not valid UTF-8 on its own; this writes the code point. Below
/// 128 the two agree, which is every `\x` any golden uses. Fixing it properly wants the
/// value to be a byte string rather than runes, which is a decision for the AST and not
/// for this function.
let decode_escapes = pure (runes: []rune) -> string => {
  var out = ""
  var i = 0
  for i < runes.len() {
    let c = runes[i]
    if c != '\\' || i + 1 >= runes.len() {
      out = out ++ "${c}"
      i += 1
      continue
    }
    let next = runes[i + 1]
    let width = numeric_escape_width(next)
    if width > 0 && i + 1 + width < runes.len() {
      let base = if next == 'o' { 8 } else { 16 }
      let digits = runes.slice(i + 2, i + 2 + width)
      out = out ++ "${rune(digits_value(digits, base))}"
      i += 2 + width
      continue
    }
    out = out ++ "${simple_escape(next)}"
    i += 2
  }
  out
}

/// How many digits follow `\o`, `\x`, `\u` or `\U`, and 0 for an escape that takes none.
///
/// A fixed width per prefix rather than "digits until one stops": `"\012"` is NUL followed
/// by `12`, not a newline, because Lyra spells octal `\o` and so has no run for `\0` to
/// begin. That is the one place this could quietly inherit C's rule.
let numeric_escape_width = pure (c: rune) -> i64 => match c {
  'o' => 3,
  'x' => 2,
  'u' => 4,
  'U' => 8,
  _ => 0,
}

/// The rune a one-letter escape stands for.
///
/// The final arm covers `\\`, `\'`, `\"` and `\#`, which each stand for themselves — and
/// anything else, which the grammar does not admit. Answering the character as written is
/// the reading that loses no source.
let simple_escape = pure (c: rune) -> rune => match c {
  '0' => rune(0),
  'a' => rune(7),
  'b' => rune(8),
  'e' => rune(27),
  'f' => rune(12),
  'n' => '\n',
  'r' => '\r',
  't' => '\t',
  'v' => rune(11),
  _ => c,
}

/// `` `C:\new` `` — a raw string, whose whole point is that nothing in it is an escape.
///
/// The delimiters are hidden tokens rather than children, so the content node is asked for
/// directly instead of slicing the literal's own text: `##` ` ##` has two of them at each
/// end and slicing a fixed width would take the wrong bytes. An empty raw string has no
/// content child at all.
let collect_raw_string = (node: Node, source: Source) -> shared Expr => {
  for child in node.named_children() {
    if child.kind() == "raw_string_content" {
      // The **literal's** span, not the content node's: the delimiters are part of the
      // string as written, and `##` is three characters at each end.
      return StringLiteralExpr(StringLiteral {
        location: source.location_of(node),
        value: child.text(source.bytes),
      })
    }
  }
  StringLiteralExpr(StringLiteral { location: source.location_of(node), value: "" })
}

/// `3.14159`, `0.03141592e2`, `3.141_59`.
let collect_float = (node: Node, source: Source) -> shared Expr =>
  FloatLiteralExpr(FloatLiteral {
    location: source.location_of(node),
    value: float_value(node.text(source.bytes).to_runes())
  })

/// The number a float literal denotes.
///
/// Mantissa digits into an integer, then one scaling by a power of ten — Clinger's fast
/// path. **It is exact where it applies**: a mantissa below 2^53 and a power of ten at or
/// under 10^22 are each exactly representable, so the single multiply or divide is
/// correctly rounded and lands on the same double `strconv.ParseFloat` does. Every float a
/// person writes is in that range.
///
/// Outside it the answer can differ in its last digits, where Go falls back to arbitrary
/// precision: `1.0e308` comes out `9.999999999999998e+307` here, because ten to the 308th
/// is built by multiplying and that rounds at every step. A real limit, stated rather than
/// hidden — closing it is a big-integer algorithm, not a tweak.
///
/// **Digits past the mantissa's capacity are dropped, not accumulated.** Multiplying an
/// i64 past its range *traps*, so a 25-digit literal took the whole file down with it
/// rather than being collected imprecisely — one bad literal, no output at all, which is
/// the compiler's own hazard 3. A dropped digit before the point still shifts the
/// magnitude, so it moves into the exponent; one after the point is below the precision
/// already lost and simply goes.
///
/// A literal too large for an `f64` collects as **zero**, which is not a guess: the Go
/// collector reports `lyra-E…` and places a zero-valued node, and a zero float prints no
/// `Value:` line, so the two agree on the tree. The diagnostic itself is a later slice.
let float_value = pure (runes: []rune) -> f64 => {
  // (2^63 - 1) / 10, the largest mantissa another digit can still be appended to.
  let mantissa_limit = 922337203685477580
  var mantissa = 0
  var fraction_digits = 0
  var dropped_digits = 0
  var exponent = 0
  var exponent_sign = 1
  var in_exponent = false
  var after_point = false
  for c in runes {
    match c {
      '_' | '+' => { continue },
      '.' => {
        after_point = true
        continue
      },
      'e' | 'E' => {
        in_exponent = true
        continue
      },
      '-' => {
        exponent_sign = -1
        continue
      },
      _ => {}
    }
    if in_exponent {
      exponent = exponent * 10 + digit_value(c)
      continue
    }
    if mantissa > mantissa_limit {
      if !after_point { dropped_digits += 1 }
      continue
    }
    mantissa = mantissa * 10 + digit_value(c)
    if after_point { fraction_digits += 1 }
  }
  let scaled = scale_by_power_of_ten(
    f64(mantissa),
    exponent_sign * exponent - fraction_digits + dropped_digits
  )
  if is_finite(scaled) { scaled } else { 0.0 }
}

/// Whether `value` is a real number rather than an infinity or a NaN.
///
/// Written as two comparisons against an infinity built on the spot: the prelude has no
/// predicate for it, and the usual `value != value` earns lyra-W008. A NaN fails both, an
/// infinity fails one.
let is_finite = pure (value: f64) -> bool => {
  let infinity = 1.0e308 * 10.0
  value > -infinity && value < infinity
}

/// `value` times ten to the `power` — dividing rather than multiplying by a negative one,
/// since `1e-5` is not exactly representable and `1e5` is: `x / 1e5` rounds once where
/// `x * 1e-5` rounds twice.
let scale_by_power_of_ten = pure (value: f64, power: i64) -> f64 =>
  if power >= 0 { value * power_of_ten(power) } else { value / power_of_ten(-power) }

/// Ten to the `power`, built by multiplication — exact through 10^22, the last power of
/// ten a double holds exactly.
let power_of_ten = pure (power: i64) -> f64 => {
  var result = 1.0
  for _ in 0..<power {
    result = result * 10.0
  }
  result
}

/// The value of `digits` read in `base`, underscores ignored as the grammar allows them.
let digits_value = pure (digits: []rune, base: i64) -> i64 => {
  var total = 0
  for d in digits {
    if d == '_' { continue }
    total = total * base + digit_value(d)
  }
  total
}

/// One digit's value, in any base up to 16.
let digit_value = pure (d: rune) -> i64 => match d {
  '0'..<='9' => i64(d) - i64('0'),
  'a'..<='f' => i64(d) - i64('a') + 10,
  'A'..<='F' => i64(d) - i64('A') + 10,
  _ => 0
}
