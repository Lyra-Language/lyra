module ast
//! The Lyra AST, in Lyra — the bootstrap's second slice.
//!
//! **Every node mirrors the Go AST's type and field names exactly**, and that constraint is
//! the whole reason this is checkable. `pkg/printer` dumps the Go AST by reflection, and
//! `pkg/analyzer/collector/tests/testdata` holds 245 golden files of those dumps; a printer
//! here that produces the same text turns every one of them into a differential test
//! against an independent implementation — the trick `std.temporal` used against Go's
//! `time` and Python's `zoneinfo`. An AST of its own design would leave the bootstrap
//! checked only against itself, which is no check at all.
//!
//! So `Base` and `Value` are the field names even though Lyra writes `base` and `value`:
//! the printer spells the Go names, and these structs spell Lyra ones. The two are kept
//! together, one per node, rather than reconciled by a table nobody would maintain.
//!
//! **A node is a struct, and the `data` constructor wraps it**, even where one field would
//! fit in the constructor directly (`CharacterLiteralExpr`). The Go AST gains fields
//! steadily, and a positional payload makes each new one an edit at every construction
//! site in the port; a struct makes it an edit at the ones that care.

/// A whole file: the statements at its top level, in source order.
pub struct Program {
  statements: []Stmt,
}

/// A statement. One constructor per Go statement type, named as Go names it.
pub data Stmt =
  /// `let x = 1`, `var y = 2`, `pub let z = 3`.
  VarDeclStmt(VarDecl)
  /// An expression standing alone as a statement.
  | ExpressionStmt(ExprStmt)
  /// `struct Point { … }`, `data Color = …`, `tuple Pair(i64, i64)`.
  | TypeDeclStmt(TypeDecl)
  /// `let Some x = m` — a binding whose left side is a pattern rather than a name.
  | DestructuringDeclStmt(DestructuringDecl)

/// An expression used for its own sake.
pub struct ExprStmt {
  expression: shared Expr,
}

/// A binding declaration.
pub struct VarDecl {
  /// `let` or `var` — the word as written, which is what the golden prints.
  binding_kind: string,
  /// `let sum<n> = …` — the variables the declaration binds. On the declaration rather
  /// than on the lambda: `<n>` is written before the `=`, and that is where the Go AST
  /// records it too.
  generic_params: []GenericParam = [],
  /// True for `pub`. Printed only when true, the printer omitting zero values.
  is_public: bool,
  /// The bound name, which is also the label in the node's header line.
  name: string,
  /// `var x: i64 = 42` — the written annotation, which is not the lambda's return type
  /// and is absent far more often than present. Spelled `type_annotation` and printed
  /// `Type`, as `Parameter` is.
  type_annotation: Maybe<shared TypeNode> = None,
  /// The initialiser. `None` for a declaration without one.
  value: Maybe<shared Expr>,
}

/// An expression. One constructor per Go expression type, named as Go names it.
pub data Expr =
  /// `42`, `0x2A`, `0b101010` — the value, and the base it was written in.
  IntegerLiteralExpr(IntegerLiteral)
  /// `'\n'` — the rune's code point.
  | CharacterLiteralExpr(CharacterLiteral)
  /// `3.14159` — the value, not the spelling: `0.03141592e2` and `314.1592e-2` are one
  /// number and collect identically.
  | FloatLiteralExpr(FloatLiteral)
  /// `"hello"` — the text, escapes already decoded.
  | StringLiteralExpr(StringLiteral)
  /// `"a ${x} b"` — the pieces in order, text and expression alike.
  | InterpolatedStringExpr(Interpolated)
  /// `x` — a name standing for a value.
  | IdentifierExpr(Identifier)
  /// `a + b` — the arithmetic operators.
  | MathBinaryOpExpr(BinaryOp)
  /// `a < b`, `p && q` — comparison and logic.
  | BooleanBinaryOpExpr(BinaryOp)
  /// `"a" ++ b` — the third node sharing `BinaryOp`'s shape, and the only operator whose
  /// node kind the grammar decides on its own rather than by the symbol.
  | StringConcatExpr(BinaryOp)
  /// `-x` — arithmetic negation.
  | NegationExpr(Unary)
  /// `read()?` — propagate a failure to the enclosing function.
  | TryExpr(Unary)
  /// `0..<10`, `0..<=9:2` — a range as a value.
  | RangeExpr(Range)
  /// `foo(1, x)` — a call, whatever the callee expression is.
  | FunctionCallExpr(FunctionCall)
  /// `person.name` — a named member of a value.
  | MemberExpr(MemberAccess)
  /// `array[0]` — an element at a computed position.
  | IndexExpr(IndexAccess)
  /// `pair.0` — a tuple element, whose position is written rather than computed.
  | TupleIndexExpr(TupleIndexAccess)
  /// `{ … }` — statements in a scope, used as a value.
  | BlockExpr(Block)
  /// `(1, 2)`, `Point(1, 2)` — a tuple built inline, named or not.
  | TupleLiteralExpr(TupleLiteral)
  /// `[1, 2, 3]`, `#[1, 2, 3]` — a list of elements, dynamic or fixed.
  | ArrayLiteralExpr(ArrayLiteral)
  /// `[0; n]`, `#[0; 8]` — one value repeated.
  | ArrayRepeatExpr(ArrayRepeat)
  /// `(a, b) => …` — a function literal.
  | LambdaExpr(Lambda)

/// An integer literal.
pub struct IntegerLiteral {
  /// 10, 16, 8 or 2, as the source spelled it.
  base: i64,
  value: i64,
}

/// A character literal, as a code point.
pub struct CharacterLiteral {
  value: i64,
}

/// A float literal, as a number.
///
/// **The value, not the text.** `0.03141592e2` prints as `3.141592`, so the collector
/// parses and the printer formats — the one literal in this AST that is not carried as
/// either its digits or its spelling.
pub struct FloatLiteral {
  value: f64,
}

/// A string literal, escapes decoded.
pub struct StringLiteral {
  value: string,
}

/// A name, used as an expression, a pattern or a type — the three places one appears, all
/// printed as `Kind(name) { Name: name }` and so all one struct.
pub struct Identifier {
  /// True for a **const** name — `limits.MAX`, which the grammar tells apart as a node
  /// kind of its own rather than by its spelling. Only an `IdentifierExpr` prints it: a
  /// pattern binds a name and a type names one, and neither can be const.
  is_const: bool = false,
  name: string,
}

/// `a + b`, `x < y`, `p && q` — two operands and the operator between them.
///
/// **One struct for two node kinds.** `MathBinaryOpExpr` and `BooleanBinaryOpExpr` are
/// distinct in the Go AST and print under their own names, but they hold the same three
/// fields, so the constructor carries the distinction and the payload does not repeat
/// itself.
///
/// **The operand fields are `shared`**, which is what makes the type finitely sized: an
/// expression holding expressions inline has no size at all. That is the ordinary way to
/// write a tree here, not a workaround — though a cycle through `Maybe<Expr>` *is* one
/// today, and crashes the compiler rather than being refused (todo.md, 09/22).
pub struct BinaryOp {
  left: shared Expr,
  operator: string,
  right: shared Expr,
}

/// One operand and the operator applied to it — `NegationExpr` and `TryExpr` share the
/// shape, differing only in the node name the printer gives them. `TryExpr` has no operator
/// of its own to record: the `?` is the node.
pub struct Unary {
  operand: shared Expr,
}

/// The four operators a range's end may take.
///
/// **A closed set, so a data type rather than the symbol as text.** The grammar admits
/// exactly `<`, `<=`, `>` and `>=`, and holding the spelling made "an operator" and "any
/// string" the same type — `end_operator: "nonsense"` was representable and `""` meant
/// *absent*. The symbol now lives in one function (`range_operator_symbol`) instead of
/// being scattered as literals.
///
/// The binary operators beside this one stay as text deliberately: their sets are larger
/// (six arithmetic, eight comparison and logical) and carry no absent case, so the trade
/// that pays here does not obviously pay there.
pub data RangeEndOperator =
  /// `..<` — ascending, exclusive.
  LessThan
  /// `..<=` — ascending, inclusive.
  | LessThanOrEqual
  /// `..>` — descending, exclusive. Legal in an expression; `lyra-E034` in a pattern.
  | GreaterThan
  /// `..>=` — descending, inclusive.
  | GreaterThanOrEqual

/// `0..<10:2`.
///
/// Every part is optional but the operator: an open range omits a bound (`0..`, `..<10`),
/// and most have no step. The printer drops each absent one, which is why they are `Maybe`
/// rather than a sentinel.
pub struct Range {
  end: Maybe<shared Expr>,
  /// `None` when the range has no end operator at all (`0..`), which the empty string used
  /// to stand for — a sentinel a `Maybe` carries better.
  end_operator: Maybe<RangeEndOperator>,
  start: Maybe<shared Expr>,
  step: Maybe<shared Expr>,
}

/// A call.
///
/// The callee is an expression rather than a name: `foo()` and `table[i]()` are the same
/// node, which is why the field is `function` and not something narrower.
pub struct FunctionCall {
  arguments: []shared Expr,
  function: shared Expr,
  /// `map::<i64, i64>(xs, f)` — the type arguments written at the callee, and an empty
  /// list for the ordinary spelling. The same field a `TupleLiteral` carries, since
  /// `Point::<i32>(1, 2)` is the same syntax over a different node.
  generic_arguments: []shared TypeNode = [],
}

/// `person.name`. The property is an expression node, as the Go AST has it, even though
/// only an identifier can appear there.
pub struct MemberAccess {
  object: shared Expr,
  /// True for `a?.b` — a different CST node, not a flag the grammar hangs off `.`.
  optional: bool = false,
  property: shared Expr,
}

/// `array[0]`.
pub struct IndexAccess {
  index: shared Expr,
  object: shared Expr,
  /// True for `a?[i]`, as `MemberAccess.optional` is for `a?.b`.
  optional: bool = false,
}

/// `pair.0`.
///
/// **The index is a number, not a node** — it prints as `Index: 0` on one line rather
/// than as a nested literal, because a tuple's position is part of the access and not a
/// value computed at it. That is the one place in this AST where an `Index` is a scalar.
pub struct TupleIndexAccess {
  index: i64,
  object: shared Expr,
}

/// `(1, 2)` and `Point(1, 2)`.
///
/// The two are one node with a name or without: an anonymous tuple is named `?`, the
/// placeholder an unnamed tuple answers when asked, which is the same sentinel
/// `TupleTypeDef` carries.
pub struct TupleLiteral {
  elements: []shared Expr,
  /// `Point::<i32>(1, 2)` — the arguments written at the name, and an empty list for the
  /// ordinary spelling.
  generic_arguments: []shared TypeNode,
  name: string,
}

/// `[1, 2, 3]` and `#[1, 2, 3]`.
pub struct ArrayLiteral {
  elements: []shared Expr,
  /// **The opener is the flavor**: `#[` builds a fixed `[N]T` and `[` a dynamic `[]T`.
  /// Nothing infers it, here or in the compiler — the grammar exposes the `#[` as a field
  /// and this records whether it was there.
  fixed: bool,
}

/// `[0; n]` and `#[0; 8]`.
pub struct ArrayRepeat {
  count: shared Expr,
  fixed: bool,
  value: shared Expr,
}

/// A block used as a value — a lambda's body, or an arm's.
pub struct Block {
  statements: []Stmt,
}

/// An interpolated string: its segments in written order.
///
/// A text run is a `StringLiteralExpr` segment, so a reader of the segments needs no
/// second shape for "the parts that are not expressions" — which is what the Go AST does
/// and the reason the list is homogeneous.
pub struct Interpolated {
  segments: []shared Expr,
}

/// A function literal.
///
/// An empty one still prints with **no `Value:` line at all**: every field is zero, and the
/// Go printer omits a composite whose fields are all zero. That rule was pinned before
/// parameters and bodies existed, and it keeps `basic_function_declaration_without_params`
/// passing now for a better reason than it did in slice 2.
pub struct Lambda {
  body: Maybe<shared Expr>,
  /// `async (…) => …`.
  is_async: bool = false,
  /// `pure (…) => …`. Each modifier is a field on the CST node, so the collector reads
  /// its presence rather than scanning the text before the parameters.
  is_pure: bool = false,
  parameters: []Parameter,
  return_type: Maybe<ReturnType>,
}

/// One parameter: the pattern it binds and the type it was annotated with.
///
/// It prints with **no label** — `Parameter {`, not `Parameter(x) {` — because it has no
/// `Name` field of its own. The name lives in the pattern.
pub struct Parameter {
  /// `(prefix: string = "Hello")` — the expression after `=`, or `None`.
  default_value: Maybe<shared Expr> = None,
  pattern: shared Pattern,
  /// Spelled `type_annotation` and printed `Type`: `type` is not a field name Lyra will
  /// take, and the golden's word is not negotiable.
  type_annotation: Maybe<shared TypeNode>,
}

/// A parameter's binding form. One constructor per Go pattern type.
pub data Pattern =
  /// `x` — a plain name.
  IdentifierPattern(Identifier)
  /// `Some x` — a constructor and what it binds.
  | DataPattern(DataPatternDef)

/// `Some x`: the constructor's name and the pattern for its payload.
pub struct DataPatternDef {
  name: string,
  /// The payload's pattern. `None` for a nullary constructor — `None` matches nothing
  /// further, and the field disappears rather than printing as empty.
  pattern: Maybe<shared Pattern>,
}

/// A declaration that binds by matching.
///
/// The same grammar node as a `VarDeclStmt`, told apart by which field it carries: a
/// `pattern` rather than a `name`. So the two are one collector asking which it got, not
/// two walks over the same shape.
pub struct DestructuringDecl {
  keyword: string,
  pattern: shared Pattern,
  value: Maybe<shared Expr>,
}

/// A type declaration: the name it binds and the type it binds to it.
pub struct TypeDecl {
  /// `@derive(Eq, Hash)` — bare names, printed as themselves rather than as nodes.
  derives: []string,
  /// `<t>` — the variables the declaration binds, in order.
  generic_params: []GenericParam,
  is_public: bool,
  name: string,
  /// Spelled `declared` and printed `Type`, for the reason `Parameter` gives.
  declared: shared TypeNode,
}

/// One declared type variable.
pub struct GenericParam {
  name: string,
}

/// A written type. One constructor per Go type node.
pub data TypeNode =
  /// `i64`, `bool`, `string` — a type the language names itself.
  PrimitiveType(Identifier)
  /// `t` — a type variable, in a declaration that binds one.
  | GenericType(Identifier)
  /// A name the program declared. Unresolved because the collector does not look it up —
  /// that is the typechecker's job, and the AST records what was written.
  | UnresolvedType(Identifier)
  /// `struct Point { x: i64 }`.
  | NamedStructType(StructTypeDef)
  /// `tuple Point2D(f64, f64)`.
  | TupleType(TupleTypeDef)
  /// `data Color = Red | Green`.
  | DataType(DataTypeDef)
  /// `newtype Angle = f64` — a name over a base type, with constraints it may carry.
  | ConstrainedType(ConstrainedTypeDef)

/// The body of a struct declaration.
///
/// **The cycle through here is finite because the field list is an array**: a `TypeNode`
/// holds a `StructTypeDef` holds `[]StructField` holds a `TypeNode`, and an array is a box
/// pointer, so the type has a size. That is the same reason `std.json`'s `JsonValue` works,
/// and it is why none of these needs `shared`.
pub struct StructTypeDef {
  fields: []StructField,
  name: string,
}

/// One field: its name, its type, and the default it may carry.
pub struct StructField {
  default_value: Maybe<shared Expr>,
  name: string,
  declared: shared TypeNode,
}

/// The body of a named-tuple declaration.
pub struct TupleTypeDef {
  elements: []shared TypeNode,
  name: string,
}

/// The body of a data declaration.
pub struct DataTypeDef {
  constructors: []DataTypeConstructor,
  name: string,
}

/// The body of a `newtype` declaration.
pub struct ConstrainedTypeDef {
  name: string,
  /// The base it wraps. `shared` because a `TypeNode` holding one directly is a cycle with
  /// no array to break it — the other type bodies reach their children through lists.
  declared: shared TypeNode,
}

/// One constructor, and the types of the payload it carries.
pub struct DataTypeConstructor {
  name: string,
  /// True when the payload was written in parentheses (`Wrap(t)`) rather than juxtaposed
  /// (`Some t`). The two are different shapes, not spellings of one: a packed constructor
  /// carries a **single anonymous tuple** whose elements are the written types, where a
  /// juxtaposed one carries those types directly.
  packed: bool,
  params: []shared TypeNode,
}

/// `-> i64`, the declared result.
///
/// Its label is the **type's** name (`ReturnType(i64)`), which the Go node answers through
/// `GetName()` rather than a `Name` field — so the printer here spells that out.
pub struct ReturnType {
  type_annotation: shared TypeNode,
}
