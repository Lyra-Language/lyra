module ast
//! The Lyra AST, in Lyra — the bootstrap's second slice.
//!
//! **Every node mirrors the Go AST's type and field names exactly**, and that constraint is
//! the whole reason this is checkable. `pkg/printer` dumps the Go AST by reflection, and
//! `pkg/analyzer/collector/tests/testdata` holds 245 golden files of those dumps; a printer
//! here that produces the same text turns every one of them into a differential test
//! against an independent implementation — the trick `std.temporal` used against Go's
//! `time` and Python's `zoneinfo`. An AST of its own design would leave the bootstrap
//! checked only against itself, which is no check at all.
//!
//! So `Base` and `Value` are the field names even though Lyra writes `base` and `value`:
//! the printer spells the Go names, and these structs spell Lyra ones. The two are kept
//! together, one per node, rather than reconciled by a table nobody would maintain.
//!
//! **A node is a struct, and the `data` constructor wraps it**, even where one field would
//! fit in the constructor directly (`CharacterLiteralExpr`). The Go AST gains fields
//! steadily, and a positional payload makes each new one an edit at every construction
//! site in the port; a struct makes it an edit at the ones that care.

/// A whole file: the statements at its top level, in source order.
pub struct Program {
  statements: []Stmt,
}

/// A statement. One constructor per Go statement type, named as Go names it.
pub data Stmt =
  /// `let x = 1`, `var y = 2`, `pub let z = 3`.
  VarDeclStmt(VarDecl)
  /// An expression standing alone as a statement.
  | ExpressionStmt(ExprStmt)

/// An expression used for its own sake.
pub struct ExprStmt {
  expression: shared Expr,
}

/// A binding declaration.
pub struct VarDecl {
  /// `let` or `var` — the word as written, which is what the golden prints.
  binding_kind: string,
  /// True for `pub`. Printed only when true, the printer omitting zero values.
  is_public: bool,
  /// The bound name, which is also the label in the node's header line.
  name: string,
  /// The initialiser. `None` for a declaration without one.
  value: Maybe<shared Expr>,
}

/// An expression. One constructor per Go expression type, named as Go names it.
pub data Expr =
  /// `42`, `0x2A`, `0b101010` — the value, and the base it was written in.
  IntegerLiteralExpr(IntegerLiteral)
  /// `'\n'` — the rune's code point.
  | CharacterLiteralExpr(CharacterLiteral)
  /// `"hello"` — the text, escapes already decoded.
  | StringLiteralExpr(StringLiteral)
  /// `x` — a name standing for a value.
  | IdentifierExpr(Identifier)
  /// `a + b` — the arithmetic operators.
  | MathBinaryOpExpr(MathBinaryOp)
  /// `(a, b) => …` — a function literal.
  | LambdaExpr(Lambda)

/// An integer literal.
pub struct IntegerLiteral {
  /// 10, 16, 8 or 2, as the source spelled it.
  base: i64,
  value: i64,
}

/// A character literal, as a code point.
pub struct CharacterLiteral {
  value: i64,
}

/// A string literal, escapes decoded.
pub struct StringLiteral {
  value: string,
}

/// A name, used as an expression, a pattern or a type — the three places one appears, all
/// printed as `Kind(name) { Name: name }` and so all one struct.
pub struct Identifier {
  name: string,
}

/// `a + b`, `x * 2`.
///
/// **The operand fields are `shared`**, which is what makes the type finitely sized: an
/// expression holding expressions inline has no size at all. That is the ordinary way to
/// write a tree here, not a workaround — though a cycle through `Maybe<Expr>` *is* one
/// today, and crashes the compiler rather than being refused (todo.md, 09/22).
pub struct MathBinaryOp {
  left: shared Expr,
  operator: string,
  right: shared Expr,
}

/// A function literal.
///
/// An empty one still prints with **no `Value:` line at all**: every field is zero, and the
/// Go printer omits a composite whose fields are all zero. That rule was pinned before
/// parameters and bodies existed, and it keeps `basic_function_declaration_without_params`
/// passing now for a better reason than it did in slice 2.
pub struct Lambda {
  body: Maybe<shared Expr>,
  parameters: []Parameter,
  return_type: Maybe<ReturnType>,
}

/// One parameter: the pattern it binds and the type it was annotated with.
///
/// It prints with **no label** — `Parameter {`, not `Parameter(x) {` — because it has no
/// `Name` field of its own. The name lives in the pattern.
pub struct Parameter {
  pattern: Pattern,
  /// Spelled `type_annotation` and printed `Type`: `type` is not a field name Lyra will
  /// take, and the golden's word is not negotiable.
  type_annotation: Maybe<TypeNode>,
}

/// A parameter's binding form. One constructor per Go pattern type.
pub data Pattern =
  /// `x` — a plain name.
  IdentifierPattern(Identifier)

/// A written type. One constructor per Go type node.
pub data TypeNode =
  /// `i64`, `bool`, `string` — a type the language names itself.
  PrimitiveType(Identifier)

/// `-> i64`, the declared result.
///
/// Its label is the **type's** name (`ReturnType(i64)`), which the Go node answers through
/// `GetName()` rather than a `Name` field — so the printer here spells that out.
pub struct ReturnType {
  type_annotation: TypeNode,
}
