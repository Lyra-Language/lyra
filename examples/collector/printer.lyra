module printer
//! The AST printer, in the format `pkg/printer` produces by reflection.
//!
//! Matching it byte for byte is what makes the 245 golden files in
//! `pkg/analyzer/collector/tests/testdata` an oracle for the bootstrap, so the rules are
//! copied deliberately rather than invented:
//!
//!   - a node is `TypeName {`, its fields one tab deeper, then `}` at the node's own level;
//!   - a node with a non-empty `Name` field is `TypeName(that name) {`, and `Program` is
//!     `Program(N statements) {`;
//!   - **fields print in alphabetical order of their Go names**, not declaration order;
//!   - a **zero** field is omitted entirely — `false`, `0`, `""`, an empty list, `None`;
//!   - a field holding a composite whose own fields are all zero is omitted too, which is
//!     not the same rule and is the one that surprises: `let foo = () => { }` prints no
//!     `Value:` line at all, the lambda being empty, and `let blank = ""` prints none
//!     either;
//!   - a composite field is `Name: {`, its value one tab deeper, then `}`; a scalar field
//!     is `Name: value` on one line;
//!   - the indent is a **tab**, and the last line ends with a newline.
//!
//! Lyra has no reflection, so where Go walks fields generically this names them one at a
//! time. That is a cost per node and a benefit at the same time: the alphabetical order and
//! the omission rules are written down at each node rather than emerging from a walk, so a
//! field added to the AST and forgotten here shows up as a golden that no longer matches.

import ast.{
  Program,
  Stmt,
  VarDecl,
  Expr,
  Identifier,
  Lambda,
  Parameter,
  Pattern,
  TypeNode,
  ReturnType,
  FunctionCall,
  Block,
  BinaryOp,
  Range,
}

/// A whole program, as `pkg/printer.PrintAST` would render it.
pub let print_ast = pure (program: Program) -> string => {
  // `Program(N statements)` is the one header the Go printer special-cases, and it counts
  // the statements even when it is about to omit the empty list below.
  var out = "Program(${program.statements.len()} statements) {\n"
  if program.statements.len() > 0 {
    out = out ++ field_open("Statements", 1)
    for stmt in program.statements {
      out = out ++ print_stmt(stmt, 2)
    }
    out = out ++ close(1)
  }
  out ++ close(0)
}

/// One statement at `depth`.
let print_stmt = pure (stmt: Stmt, depth: i64) -> string => match stmt {
  VarDeclStmt(decl) => print_var_decl(decl, depth),
  ExpressionStmt(statement) =>
    header_unnamed("ExpressionStmt", depth) ++
    node_field("Expression", print_expr(statement.expression, depth + 2), depth + 1) ++
    close(depth),
}

/// `VarDeclStmt(name) { … }`.
///
/// Fields in the Go type's alphabetical order — `BindingKind`, `IsPublic`, `Name`,
/// `Value` — each omitted when zero.
let print_var_decl = pure (decl: VarDecl, depth: i64) -> string => {
  var out = header("VarDeclStmt", decl.name, depth)
  out = out ++ scalar("BindingKind", decl.binding_kind, depth + 1)
  if decl.is_public { out = out ++ scalar("IsPublic", "true", depth + 1) }
  out = out ++ scalar("Name", decl.name, depth + 1)
  match decl.value {
    Some(value) => if !expr_is_empty(value) {
      out = out ++ field_open("Value", depth + 1)
      out = out ++ print_expr(value, depth + 2)
      out = out ++ close(depth + 1)
    },
    None => {},
  }
  out ++ close(depth)
}

/// One expression at `depth`.
let print_expr = pure (expr: shared Expr, depth: i64) -> string => match expr {
  IntegerLiteralExpr(lit) =>
    header_unnamed("IntegerLiteralExpr", depth) ++
    scalar("Base", "${lit.base}", depth + 1) ++
    scalar("Value", "${lit.value}", depth + 1) ++
    close(depth),
  CharacterLiteralExpr(lit) =>
    header_unnamed("CharacterLiteralExpr", depth) ++
    scalar("Value", "${lit.value}", depth + 1) ++
    close(depth),
  StringLiteralExpr(lit) =>
    header_unnamed("StringLiteralExpr", depth) ++
    scalar("Value", lit.value, depth + 1) ++
    close(depth),
  IdentifierExpr(identifier) => print_named("IdentifierExpr", identifier, depth),
  // Left, Operator, Right — alphabetical, and the operator is the symbol itself.
  MathBinaryOpExpr(op) => print_binary("MathBinaryOpExpr", op, depth),
  BooleanBinaryOpExpr(op) => print_binary("BooleanBinaryOpExpr", op, depth),
  // `NegationExpr` and `TryExpr` are one field under two names.
  NegationExpr(unary) =>
    header_unnamed("NegationExpr", depth) ++
    node_field("Operand", print_expr(unary.operand, depth + 2), depth + 1) ++
    close(depth),
  TryExpr(unary) =>
    header_unnamed("TryExpr", depth) ++
    node_field("Operand", print_expr(unary.operand, depth + 2), depth + 1) ++
    close(depth),
  RangeExpr(range) => print_range(range, depth),
  // Arguments before Function — alphabetical, and an empty argument list is omitted like
  // any other empty composite, so `foo()` prints with only its callee.
  FunctionCallExpr(call) => print_call(call, depth),
  BlockExpr(block) => print_block(block, depth),
  MemberExpr(member) =>
    header_unnamed("MemberExpr", depth) ++
    node_field("Object", print_expr(member.object, depth + 2), depth + 1) ++
    node_field("Property", print_expr(member.property, depth + 2), depth + 1) ++
    close(depth),
  IndexExpr(access) =>
    header_unnamed("IndexExpr", depth) ++
    node_field("Index", print_expr(access.index, depth + 2), depth + 1) ++
    node_field("Object", print_expr(access.object, depth + 2), depth + 1) ++
    close(depth),
  // `Index` here is the position the access names, so it prints as a scalar on one line
  // rather than as a nested literal — the one `Index` in this AST that is not a node.
  TupleIndexExpr(access) =>
    header_unnamed("TupleIndexExpr", depth) ++
    scalar("Index", "${access.index}", depth + 1) ++
    node_field("Object", print_expr(access.object, depth + 2), depth + 1) ++
    close(depth),
  LambdaExpr(lambda) => print_lambda(lambda, depth),
}

/// `FunctionCallExpr { Arguments, Function }`.
let print_call = pure (call: FunctionCall, depth: i64) -> string => {
  var out = header_unnamed("FunctionCallExpr", depth)
  if call.arguments.len() > 0 {
    var items = ""
    for argument in call.arguments {
      items = items ++ print_expr(argument, depth + 2)
    }
    out = out ++ node_field("Arguments", items, depth + 1)
  }
  out = out ++ node_field("Function", print_expr(call.function, depth + 2), depth + 1)
  out ++ close(depth)
}

/// `BlockExpr { Statements }`.
let print_block = pure (block: Block, depth: i64) -> string => {
  var out = header_unnamed("BlockExpr", depth)
  if block.statements.len() > 0 {
    var items = ""
    for statement in block.statements {
      items = items ++ print_stmt(statement, depth + 2)
    }
    out = out ++ node_field("Statements", items, depth + 1)
  }
  out ++ close(depth)
}

/// `Left`, `Operator`, `Right` — alphabetical, and the operator is the symbol itself.
let print_binary = pure (node_kind: string, op: BinaryOp, depth: i64) -> string =>
  header_unnamed(node_kind, depth) ++
  node_field("Left", print_expr(op.left, depth + 2), depth + 1) ++
  scalar("Operator", op.operator, depth + 1) ++
  node_field("Right", print_expr(op.right, depth + 2), depth + 1) ++
  close(depth)

/// `RangeExpr { End, EndOperator, Start, Step }` — alphabetical, each omitted when absent,
/// which for a range is the common case rather than the exception.
let print_range = pure (range: Range, depth: i64) -> string => {
  var out = header_unnamed("RangeExpr", depth)
  match range.end {
    Some(e) => {
      out = out ++ node_field("End", print_expr(e, depth + 2), depth + 1)
    },
    None => {},
  }
  if range.end_operator != "" {
    out = out ++ scalar("EndOperator", range.end_operator, depth + 1)
  }
  match range.start {
    Some(e) => {
      out = out ++ node_field("Start", print_expr(e, depth + 2), depth + 1)
    },
    None => {},
  }
  match range.step {
    Some(e) => {
      out = out ++ node_field("Step", print_expr(e, depth + 2), depth + 1)
    },
    None => {},
  }
  out ++ close(depth)
}

/// `LambdaExpr { Body, Parameters, ReturnType }`, each omitted when absent or empty.
let print_lambda = pure (lambda: Lambda, depth: i64) -> string => {
  var out = header_unnamed("LambdaExpr", depth)
  match lambda.body {
    // **An empty body is omitted like an absent one**, which is the emptiness rule applied
    // through a field rather than to a node: `() => { }` has a `BlockExpr` with no
    // statements, and the Go printer drops a field whose composite is empty. Printing
    // `Body: { BlockExpr { } }` looks right and matches nothing.
    Some(body) => if !expr_is_empty(body) {
      out = out ++ node_field("Body", print_expr(body, depth + 2), depth + 1)
    },
    None => {},
  }
  if lambda.parameters.len() > 0 {
    var items = ""
    for parameter in lambda.parameters {
      items = items ++ print_parameter(parameter, depth + 2)
    }
    out = out ++ node_field("Parameters", items, depth + 1)
  }
  match lambda.return_type {
    Some(declared) => {
      out = out ++ node_field(
        "ReturnType",
        print_return_type(declared, depth + 2),
        depth + 1
      )
    },
    None => {},
  }
  out ++ close(depth)
}

/// `Parameter { Pattern, Type }` — **no label**, the node having no `Name` of its own.
let print_parameter = pure (parameter: Parameter, depth: i64) -> string => {
  var out = header_unnamed("Parameter", depth)
  out = out ++ node_field(
    "Pattern",
    print_pattern(parameter.pattern, depth + 2),
    depth + 1
  )
  match parameter.type_annotation {
    Some(declared) => {
      out = out ++ node_field("Type", print_type(declared, depth + 2), depth + 1)
    },
    None => {},
  }
  out ++ close(depth)
}

/// `ReturnType(i64) { Type }` — labelled by the type it names, not by a field of its own.
let print_return_type = pure (declared: ReturnType, depth: i64) -> string =>
  header("ReturnType", type_name(declared.type_annotation), depth) ++
  node_field("Type", print_type(declared.type_annotation, depth + 2), depth + 1) ++
  close(depth)

/// One pattern.
let print_pattern = pure (pattern: Pattern, depth: i64) -> string => match pattern {
  IdentifierPattern(identifier) => print_named("IdentifierPattern", identifier, depth),
}

/// One written type.
let print_type = pure (declared: TypeNode, depth: i64) -> string => match declared {
  PrimitiveType(identifier) => print_named("PrimitiveType", identifier, depth),
}

/// The name a type node carries, for a label that is not the node's own field.
let type_name = pure (declared: TypeNode) -> string => match declared {
  PrimitiveType(identifier) => identifier.name,
}

/// `Kind(name) { Name: name }` — the shape every named leaf shares.
let print_named = pure (
  node_kind: string,
  identifier: Identifier,
  depth: i64
) -> string =>
  header(node_kind, identifier.name, depth) ++
  scalar("Name", identifier.name, depth + 1) ++
  close(depth)

/// Whether every field of `expr` is zero, which is what makes the **field holding it**
/// disappear rather than print as an empty node.
///
/// The Go printer answers this by walking fields, so it is one rule there and one arm per
/// node here. Getting it wrong is invisible in the common case and changes two of the five
/// smallest goldens, which is why it is a named function rather than a condition inline.
let expr_is_empty = pure (expr: shared Expr) -> bool => match expr {
  IdentifierExpr(identifier) => identifier.name == "",
  // Never empty: every operand is itself a node. The arm exists because the rule is per
  // node, and a missing one is a silent wrong answer rather than a compile error.
  MathBinaryOpExpr(op) => false,
  BooleanBinaryOpExpr(op) => false,
  NegationExpr(unary) => false,
  TryExpr(unary) => false,
  // A range with no bound and no step does not parse, so one is always present.
  RangeExpr(range) => false,
  // A call always has a callee and each access always has an object, so none of these is
  // ever empty; a block with no statements is.
  FunctionCallExpr(call) => false,
  MemberExpr(member) => false,
  IndexExpr(access) => false,
  TupleIndexExpr(access) => false,
  BlockExpr(block) => block.statements.len() == 0,
  // A zero base with a zero value is not reachable from the grammar — a literal always has
  // a base — so this is the honest reading of the rule rather than a live case.
  IntegerLiteralExpr(lit) => lit.base == 0 && lit.value == 0,
  CharacterLiteralExpr(lit) => lit.value == 0,
  StringLiteralExpr(lit) => lit.value == "",
  LambdaExpr(lambda) => lambda_is_empty(lambda),
}

/// Whether a lambda has nothing in it — no body, no parameters, no declared return.
///
/// Its own function because the rule is three questions joined, and a `match` is not an
/// operand of `&&` here.
let lambda_is_empty = pure (lambda: Lambda) -> bool => {
  match lambda.body {
    // Recursive for the same reason: a lambda whose only content is an empty block has
    // nothing in it, so the lambda is empty and its holder drops it in turn.
    Some(body) => if !expr_is_empty(body) { return false },
    None => {},
  }
  match lambda.return_type {
    Some(_) => return false,
    None => {},
  }
  lambda.parameters.len() == 0
}

/// `TypeName(label) {` at `depth`, or `TypeName {` when the label is empty.
let header = pure (type_name: string, label: string, depth: i64) -> string =>
  if label == "" { header_unnamed(type_name, depth) }
  else { tabs(depth) ++ "${type_name}(${label}) {\n" }

/// `TypeName {` at `depth`.
let header_unnamed = pure (type_name: string, depth: i64) -> string =>
  tabs(depth) ++ "${type_name} {\n"

/// `Name: {` at `depth` — a field whose value is a node or a list.
let field_open = pure (name: string, depth: i64) -> string =>
  tabs(depth) ++ "${name}: {\n"

/// A whole field whose value is already-rendered lines: `Name: {`, them, then `}`.
let node_field = pure (name: string, rendered: string, depth: i64) -> string =>
  field_open(name, depth) ++ rendered ++ close(depth)

/// `Name: value` at `depth` — a field whose value fits on the line.
let scalar = pure (name: string, value: string, depth: i64) -> string =>
  tabs(depth) ++ "${name}: ${value}\n"

/// `}` at `depth`.
let close = pure (depth: i64) -> string => tabs(depth) ++ "}\n"

/// `depth` tabs. The Go printer builds its indent by appending `"\t"` as it descends; this
/// rebuilds it from the depth, which is the same string and one fewer thing to thread.
let tabs = pure (depth: i64) -> string => {
  var out = ""
  for _ in 0..<depth {
    out = out ++ "\t"
  }
  out
}
