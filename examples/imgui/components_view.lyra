/// What the interface can be asked to do.
pub data Event =
  ToggleSound
  | ToggleMusic
  | AskReset
  | ConfirmReset
  | CancelReset
  | AskQuit
  | ConfirmQuit
  | CancelQuit
  | Load(i64)
  | Rename(string)
  | NameDone

pub struct State {
  sound: bool = true,
  music: bool = false,
  asking_reset: bool = false,
  asking_quit: bool = false,
  resets: i64 = 0,
  loaded: i64 = -1,
  quit: bool = false,
  /// The player's name as typed, and as last committed (Enter, or the focus gone).
  name: string = "Hero",
  saved_name: string = "",
  commits: i64 = 0,
}

/// `s` after `event`.
pub let update = pure (s: State, event: Event) -> State => match event {
  ToggleSound => State { s | sound: !s.sound },
  ToggleMusic => State { s | music: !s.music },
  AskReset => State { s | asking_reset: true },
  ConfirmReset => State { s | asking_reset: false, resets: s.resets + 1 },
  CancelReset => State { s | asking_reset: false },
  AskQuit => State { s | asking_quit: true },
  ConfirmQuit => State { s | quit: true },
  CancelQuit => State { s | asking_quit: false },
  Load(slot) => State { s | loaded: slot },
  Rename(name) => State { s | name: name },
  NameDone => State { s | saved_name: s.name, commits: s.commits + 1 },
}

