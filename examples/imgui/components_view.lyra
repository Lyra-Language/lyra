import bindings.imgui.ui.{ Node, Window, MainMenuBar, Menu, MenuItem, Button, Checkbox, Text, Separator, SeparatorText, Row, Component, WindowAttrs, MenuAttrs, MenuItemAttrs, ButtonAttrs, CheckboxAttrs, TextAttrs, Shortcut, Style, Sheet, StyleRule }
import bindings.imgui.{ col32, Vec2 }

/// What the interface can be asked to do.
pub data Event =
  ToggleSound
  | ToggleMusic
  | AskReset
  | ConfirmReset
  | CancelReset
  | AskQuit
  | ConfirmQuit
  | CancelQuit
  | Load(i64)

pub struct State {
  sound: bool = true,
  music: bool = false,
  asking_reset: bool = false,
  asking_quit: bool = false,
  resets: i64 = 0,
  loaded: i64 = -1,
  quit: bool = false,
}

/// `s` after `event`.
pub let update = pure (s: State, event: Event) -> State => match event {
  ToggleSound => State { s | sound: !s.sound },
  ToggleMusic => State { s | music: !s.music },
  AskReset => State { s | asking_reset: true },
  ConfirmReset => State { s | asking_reset: false, resets: s.resets + 1 },
  CancelReset => State { s | asking_reset: false },
  AskQuit => State { s | asking_quit: true },
  ConfirmQuit => State { s | quit: true },
  CancelQuit => State { s | asking_quit: false },
  Load(slot) => State { s | loaded: slot },
}

/// From components_view.lui, line 44.
pub let view = pure (s: State) -> Node<Event> =>
  Component(Sheet {}, [
    MainMenuBar([
      Menu(MenuAttrs { label: "File" }, [
        MenuItem(MenuItemAttrs { label: "Reset...", on_select: AskReset, shortcut: Some(Shortcut { key: "r" }) }),
        SeparatorText("Load"),
        ...[slot in 0..<3 | MenuItem(MenuItemAttrs { label: "Slot ${slot + 1}", on_select: Load(slot), checked: s.loaded == slot })],
        Separator,
        MenuItem(MenuItemAttrs { label: "Quit", on_select: AskQuit, shortcut: Some(Shortcut { key: "q" }) }),
      ]),
    ]),
    Window(WindowAttrs { title: "Settings", style: Style { width: Some(340.0), height: Some(260.0) } }, [
      SeparatorText("Audio"),
      toggle_row("Sound", "effects and voices", s.sound, ToggleSound),
      toggle_row("Music", "the soundtrack", s.music, ToggleMusic),
      SeparatorText("Saves"),
      Text(TextAttrs { text: "Reset ${s.resets} times", disabled: true }),
      ...(if s.asking_reset {
        [
          confirm("Erase every save?", ConfirmReset, CancelReset),
        ]
      } else {
        [
          Button(ButtonAttrs { label: "Reset...", on_click: AskReset }),
        ]
      }),
    ]),
    ...(if s.asking_quit {
      [
        Window(WindowAttrs { title: "Quit", on_close: Some(CancelQuit) }, [
          confirm("Quit without saving?", ConfirmQuit, CancelQuit),
        ]),
      ]
    } else {
      []
    }),
  ])

