let confirm_sheet = Sheet {
  rules: [
    StyleRule { selector: "Button", style: Style { rounding: Some(6.0), padding: Some(Vec2 { x: 14.0, y: 4.0 }) } },
    StyleRule { selector: "Button.danger", style: Style { background: Some(col32(170, 40, 40)) } },
    StyleRule { selector: ".question", style: Style { color: Some(col32(240, 200, 90)) } },
