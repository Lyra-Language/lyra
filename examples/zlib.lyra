//! Calling zlib from Lyra: the whole FFI surface in one program.
//!
//! Build it like anything else — `@link("z")` on the declarations is what puts `-lz` on
//! the link line, so no flag is needed here:
//!
//!     lyrac run examples/zlib.lyra
//!
//! What it demonstrates: a `pure` bound on a foreign function, a buffer crossing as a
//! pointer plus a length, a `^mut` in/out scalar (zlib reports the compressed size by
//! overwriting the capacity you gave it), and a real round-trip — compress, uncompress,
//! compare — rather than "it did not crash".
//!
//! Three rules the code obeys. **`unsafe` marks the bound, not the declaration**: an
//! extern with no bound carries every effect and claims nothing, so writing `pure` is the
//! unverifiable assertion and the keyword is what marks it. **Only FFI-safe types cross**
//! — the widths, `^T` and `void` — which is why the buffers are handed over as `^u8` and
//! a length rather than as the `[]u8` they live in. And the pointers are taken *at* the
//! call: between Lyra functions a buffer travels as an ordinary `mut []u8`, so the raw
//! pointer never outlives the statement that made it.
//!
//! **The wrappers are Lyra's shape, not zlib's**, which is the point of writing them at
//! all. C reports a result by filling a buffer you sized and overwriting a length, so its
//! answer is two values and an error code; a Lyra caller wants one value or an error. Each
//! wrapper below returns a `Result<[]u8, ZlibError>` holding a **right-sized** array —
//! `xs.slice(0, n)` is what makes that spellable, and until it existed (08/26) this file
//! passed buffers and lengths around in pairs and trapped on failure, which is C's shape
//! surviving into a language that has better ones. `?` then carries the errors, so the
//! round-trip reads as a sequence of three steps rather than as a staircase of matches.

import std.ffi.{ CBuffer, CULong, cstring_len, data, data_mut }

let main = () -> u8 => {
  println("zlib ${version()}")
  match roundtrip() {
    Ok(true) => 0,
    Ok(false) => 1,
    Err(e) => { println("failed: ${describe(e)}"); 1 },
  }
}

/// Compress, uncompress, compare — and **`?` is what makes it read as a sequence** rather
/// than as a staircase of nested matches. Each call answers a `Result`, and `?` hands back
/// the value or returns the error to `main`, which is the one place that decides what to
/// do about it.
let roundtrip = () -> Result<bool, ZlibError> => {
  let original = sample()
  println("original:   ${original.len()} bytes, crc32 ${checksum(original)}")

  let packed = squeeze(original)?
  println("compressed: ${packed.len()} bytes")

  let back = expand(packed, original.len())?
  println("restored:   ${back.len()} bytes")

  let identical = same(original, back)
  if identical { println("identical") } else { println("MISMATCH") }
  Ok(identical)
}

/// What zlib can answer other than success. The codes are zlib's own; `Unknown` carries
/// the rest rather than collapsing them, because a code this program has not seen is
/// still worth printing.
data ZlibError = BufferTooSmall | OutOfMemory | Corrupt | Unknown(i32)

/// Compress `src`, answering a buffer of exactly the compressed length.
///
/// **`compressBound` sizes the output**, which is what a program that does not know its
/// input has to do: it is zlib's own worst case for a given input length, so a buffer that
/// size cannot be too small. `room` then goes in as the space available and comes back as
/// the space used, because that is C's way of returning two things — and `slice` is what
/// turns those two things back into one.
///
/// `det noalloc` is not available here: the slice allocates, which is the point.
let squeeze = (src: []u8) -> Result<[]u8, ZlibError> => {
  let cap = i64(unsafe { compressBound(u64(src.len())) })
  var dst: []u8 = [0; cap]
  var room: CULong = u64(cap)
  let rc = unsafe { compress(dst.data_mut(), &mut room, src.data(), u64(src.len())) }
  if rc != 0 { return Err(classify(rc)) }
  Ok(dst.slice(0, i64(room)))
}

/// The inverse. `expected` is the *uncompressed* length, which the caller has to know:
/// a deflate stream does not carry it, so this is zlib's contract rather than a shortcut.
/// Passing one too small is `BufferTooSmall` rather than a truncated answer.
let expand = (src: []u8, expected: i64) -> Result<[]u8, ZlibError> => {
  var dst: []u8 = [0; expected]
  var room: CULong = u64(expected)
  let rc = unsafe { uncompress(dst.data_mut(), &mut room, src.data(), u64(src.len())) }
  if rc != 0 { return Err(classify(rc)) }
  Ok(dst.slice(0, i64(room)))
}

/// zlib's version string, which is the direction that needs `std.ffi`.
///
/// `zlibVersion` hands back a `char*` — memory Lyra does not own, with no length. A raw
/// pointer alone can only be read at offset zero, so the length has to come from
/// somewhere before anything can be checked: `cstring_len` scans for the terminator,
/// `CBuffer` holds the two together, and `decode_utf8` copies them into a string Lyra
/// owns — which is the only way to hold them, since foreign memory may be freed or
/// rewritten the moment the call returns.
///
/// Note that `cstring_len` is ordinary Lyra rather than a binding to `strlen`. Scanning
/// for a zero byte is expressible in the language, so it is written in it — the same
/// reason `parse_i64` is prelude code while `read_line` is a builtin.
let version = pure () -> string => {
  let p = unsafe { zlibVersion() }
  let buf = unsafe { CBuffer { ptr: p, len: cstring_len(p) } }
  buf.decode_utf8()
}

/// crc32 of a whole buffer, which is `crc32`'s own contract: seed with 0, hand it the
/// bytes, take the answer back.
///
/// The `unsafe` block covers both halves of the call — `std.ffi`'s `data()` hands out a
/// pointer into a live buffer, which needs one as much as calling a foreign function does.
///
/// The `u64(…)` is where the boundary's width stops: `crc32` answers a `CULong`, and
/// everything above this line is in Lyra's own fixed widths.
let checksum = pure (xs: []u8) -> u64 => u64(unsafe { crc32(0, xs.data(), u32(xs.len())) })

/// The bytes to round-trip: repetitive, so zlib has something to find.
let sample = pure () -> []u8 => {
  var xs: []u8 = [0; 96]
  for i in 0..<96 { xs[i] = u8(i %% 8) + 65 }
  xs
}

/// zlib's negative return codes, named. Anything else is `Unknown`.
let classify = pure (rc: i32) -> ZlibError => match rc {
  -3 => Corrupt,
  -4 => OutOfMemory,
  -5 => BufferTooSmall,
  _ => Unknown(rc),
}

let describe = pure (e: ZlibError) -> string => match e {
  BufferTooSmall => "the output buffer was too small",
  OutOfMemory => "zlib could not allocate",
  Corrupt => "the input is not a valid deflate stream",
  Unknown(rc) => "zlib returned ${rc}",
}

/// Whether two buffers hold the same bytes. Both are right-sized now, so the length is
/// part of the comparison rather than a third argument the caller has to carry.
let same = pure (a: []u8, b: []u8) -> bool => {
  if a.len() != b.len() { return false }
  for i in 0..<a.len() { if a[i] != b[i] { return false } }
  true
}

// The foreign declarations sit at the bottom rather than the top because they are the
// least interesting thing in the file: a reader wants the program, and these say only
// what C already said.

/// `uLong crc32(uLong crc, const Bytef *buf, uInt len)` — a checksum, so `pure` is
/// honest: it reads the bytes and touches nothing else.
///
/// `uLong` is `unsigned long`, which is `std.ffi`'s `CULong`; `uInt` is `unsigned int`,
/// which is `u32` on every target and needs no alias. See `compress` for why the
/// distinction is worth making in a program that runs on one platform.
@link("z")
unsafe extern pure crc32: (crc: CULong, buf: ^u8, len: u32) -> CULong

/// `uLong compressBound(uLong sourceLen)` — zlib's worst case for an input of that
/// length, so a buffer of the answer's size cannot be too small. `pure`: it is arithmetic
/// on the argument and reads nothing.
@link("z")
unsafe extern pure compressBound: (sourceLen: CULong) -> CULong

/// `int compress(Bytef *dest, uLongf *destLen, const Bytef *source, uLong sourceLen)`.
///
/// `det noalloc` rather than `pure`: it writes through the caller's pointers, which is an
/// effect, and it allocates nothing the caller does not own — zlib's scratch space comes
/// and goes inside the call.
///
/// **`uLong` is `unsigned long`**, 64 bits here and 32 under Windows' LLP64 — the one C
/// type in this file whose width is not the same everywhere. Written `CULong` rather than
/// `u64` so that a port changes one line in `std.ffi` and the compiler then points at
/// every site that has to follow, rather than leaving someone to audit each `u64` and
/// decide which ones meant `long`. The alias is the *boundary's*: the Lyra functions above
/// convert to a fixed width at their edge, so the target-dependent type stops there.
@link("z")
unsafe extern det noalloc compress: (dest: ^mut u8, destLen: ^mut CULong, source: ^u8, sourceLen: CULong) -> i32

/// `int uncompress(Bytef *dest, uLongf *destLen, const Bytef *source, uLong sourceLen)`.
@link("z")
unsafe extern det noalloc uncompress: (dest: ^mut u8, destLen: ^mut CULong, source: ^u8, sourceLen: CULong) -> i32

/// `const char *zlibVersion(void)` — a pointer into zlib's own static storage, which is
/// why nothing here frees it. Ownership does not cross the boundary in either direction.
@link("z")
unsafe extern pure zlibVersion: () -> ^u8
