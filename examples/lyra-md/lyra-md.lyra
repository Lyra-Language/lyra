// lyra-md — Markdown to HTML, in Lyra. The standard library's forcing function.
//
//   build/lyrac build -o build/lyra-md examples/lyra-md/lyra-md.lyra
//   build/lyra-md post.md           # the HTML, to stdout
//   build/lyra-md -                 # renders standard input
//
// lyrafmt probes the *compiler* by being a large Lyra program. This probes the *standard
// library* by being an ordinary one: every line of it is text handling, file handling and
// collections, so whatever it has to write by hand is something `std` is missing. The
// missing pieces are added as it needs them and not before — a standard library written
// against imagined callers grows functions nobody calls.
//
// **Blocks first, spans later.** This slice renders the block level: ATX headings, fenced
// code, and paragraphs, with every character of text escaped for HTML. Inline spans —
// `code`, emphasis, links — are the next slice, and the split is deliberate: a block-level
// renderer is a complete program that produces correct (if plain) HTML, which is the same
// shape lyrafmt's round-trip baseline had.
//
// What it is not: a CommonMark implementation. The subset is the one a dev blog writes,
// and every rule it does implement follows CommonMark where they overlap.
//
// Exit 0 when the file rendered, 1 when it could not be read, 2 for usage.

import std.collections.{ parse_args }
import markdown.{ render }
import std.io.{ read_file, read_stdin }

let main = () -> u8 => {
  let args = parse_args([])
  if args.positional.len() == 0 {
    println("usage: lyra-md <file.md | ->")
    return 2
  }
  var failures = 0
  for path in args.positional {
    if path == "-" {
      print(render(read_stdin()))
      continue
    }
    match read_file(path) {
      Some(source) => print(render(source)),
      None => {
        println("lyra-md: cannot read ${path}")
        failures += 1
      },
    }
  }
  if failures == 0 { 0 } else { 1 }
}
