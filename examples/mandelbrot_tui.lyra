import std.math.{ Complex }
import std.tui.{
  event_reader, Event, Key, event_available,
  mouse_enable, mouse_disable,
  alt_screen_enter, alt_screen_leave, clear, cursor_hide, cursor_show, cursor_home, move_to,
  bg_rgb, reset, bold, inverse
}

const MAX_ITER = 100
const X_MIN = -2.00
const X_MAX = 0.47
const X_LEN = X_MAX - X_MIN

const Y_MIN = -1.12
const Y_MAX = 1.12
const Y_LEN = Y_MAX - Y_MIN

const CELL_ASPECT = 2.2
const ASPECT_RATIO = Y_LEN / X_LEN

const ESCAPE = 65536.0
// Colour is computed rather than looked up, now that the terminal takes 24-bit values:
// a **hue circle** at full saturation, which is piecewise linear over six sectors and
// closes on itself.
//
// Closing on itself is the point. A palette had to be walked there-and-back to avoid a
// seam where the cycle repeated; a hue circle has no ends to join, so it simply wraps.
// And "running out of colours" stops being a concept — the gradient is continuous, so
// depth costs nothing.
//
// Black is still the set, and the far field still fades to black, but by *value* now
// rather than by landing on a dark palette entry.

/// Escape iterations per full turn of the hue circle.
const COLOR_CYCLE = 64.0

/// Escape iterations over which the colour fades up from black.
///
/// Without it the fastest-escaping points — the whole far field — come out fully bright,
/// and the picture reads as a flat wash with the structure lost in it. Fading the first
/// few iterations to black is what keeps the boundary the brightest thing on screen.
const FADE_IN = 8.0

/// The visible region: its centre and horizontal span. The **vertical** span is not
/// stored — it is derived from the frame's shape every time, so it cannot drift out of
/// step with the cells and reintroduce the distortion CELL_ASPECT exists to remove.
struct View { cx: f64, cy: f64, x_len: f64 }

/// The same region as a concrete rectangle, which is what the renderer wants.
struct Window { x_min: f64, y_min: f64, x_len: f64, y_len: f64 }

/// How much one wheel notch scales the span. Zoom is **multiplicative**, not a level
/// counter: a fixed step feels like the same movement at every depth, which is what makes
/// it read as smooth rather than as jumping between preset magnifications.
const ZOOM_STEP = 0.85

/// How long the loop waits for input before looking at the terminal size again. Short
/// enough that a resize feels immediate, long enough that an idle program is not spinning
/// — it wakes 20 times a second and does nothing.
const redraw_interval_ms = 50

let main = () -> void => {
  setup()

  var view = View { cx: (X_MIN + X_MAX) / 2.0, cy: 0.0, x_len: X_LEN }
  var mx = 1
  var my = 1
  var running = true
  var events = event_reader()

  let (cols0, rows0) = terminal_size()
  draw(cols0, rows0, view, mx, my)

  var last_cols = cols0
  var last_rows = rows0
  for running {
    if !events.event_available(redraw_interval_ms) {
      let (poll_cols, poll_rows) = terminal_size()
      if poll_cols != last_cols || poll_rows != last_rows {
        last_cols = poll_cols
        last_rows = poll_rows
        mx = clamp(mx, 1, poll_cols)
        my = clamp(my, 1, poll_rows - 1)
        clear()
        draw(poll_cols, poll_rows, view, mx, my)
      }
    } else {
      // **Drain everything pending, then draw once.** A wheel spin delivers a notch per
      // event, and redrawing after each one renders N frames to show the last — which is
      // exactly the lag a fast spin produces. Applying them all first makes a burst cost
      // one frame however long it is, which is what `event_available(0)` is for: it asks
      // "is there more right now" without waiting.
      let (cols, rows) = terminal_size()
      last_cols = cols
      last_rows = rows
      let (fcols, frows, left, top) = frame_geometry(cols, rows)
      var more = true
      for more {
        match events.next_event() {
          None => { running = false; more = false },
          Some(e) => {
            match e {
              Keyboard(Up) => { my -= 1 },
              Keyboard(Down) => { my += 1 },
              Keyboard(Left) => { mx -= 1 },
              Keyboard(Right) => { mx += 1 },
              // Keys zoom about the marker, since a keypress has no pointer of its own.
              Keyboard(PageUp) => { view = zoom_at(view, fcols, frows, left, top, mx, my, 1.0 / ZOOM_STEP) },
              Keyboard(PageDown) => { view = zoom_at(view, fcols, frows, left, top, mx, my, ZOOM_STEP) },
              Keyboard(Char c) => { running = i64(c) != 113 },
              Mouse(m) => match m.button {
                // Wheel up zooms *out*, matching the direction chosen for this viewer.
                // Swap the two factors to invert it.
                WheelUp => { view = zoom_at(view, fcols, frows, left, top, m.col, m.row, 1.0 / ZOOM_STEP) },
                WheelDown => { view = zoom_at(view, fcols, frows, left, top, m.col, m.row, ZOOM_STEP) },
                _ => { mx = m.col; my = m.row }
              },
              _ => { }
            }
            mx = clamp(mx, 1, cols)
            my = clamp(my, 1, rows - 1)
          }
        }
        if more && !events.event_available(0) { more = false }
      }
      if running { draw(cols, rows, view, mx, my) }
    }
  }

  teardown()
}

/// Where the set sits inside the terminal: its size in cells and its top-left margin.
///
/// One source of truth, because two callers need it and they must agree: `draw` places
/// the frame with it, and the zoom handler needs the same numbers to work out which
/// complex point is under the pointer. Computing it in each place is how the marker ends
/// up offset from the thing it is zooming towards.
let frame_geometry = pure (term_cols: i64, term_rows: i64) -> (i64, i64, i64, i64) => {
  let canvas_rows = term_rows - 1
  let (cols, rows) = contain_set(term_cols, canvas_rows)
  (cols, rows, (term_cols - cols) / 2, (canvas_rows - rows) / 2)
}

/// The view as a rectangle, with the vertical span derived so a cell stays square.
let window_for = pure (v: View, cols: i64, rows: i64) -> Window => {
  let y_len = v.x_len * f64(rows) * CELL_ASPECT / f64(cols)
  Window { x_min: v.cx - v.x_len / 2.0, y_min: v.cy - y_len / 2.0, x_len: v.x_len, y_len: y_len }
}

/// Scale the view by `factor` **about the cell under (mx, my)**, so the complex point
/// there stays exactly where it is on screen.
///
/// Zooming about the *centre* instead is the obvious version and is wrong in use: the
/// feature you are heading for slides away as you zoom, so you chase it with the arrows
/// between every notch. Keeping the pointer's point fixed is what makes a wheel feel like
/// it is pulling that spot towards you.
///
/// The arithmetic: the pointer sits at fraction `u` across the window, so the point under
/// it is `x_min + u * x_len`. After scaling, the centre that puts the same point at the
/// same fraction is `p + x_len' * (0.5 - u)`.
let zoom_at = pure (v: View, cols: i64, rows: i64, left: i64, top: i64, mx: i64, my: i64, factor: f64) -> View => {
  let w = window_for(v, cols, rows)
  let u = f64(clamp(mx - left, 0, cols)) / f64(cols)
  let t = f64(clamp(my - top, 0, rows)) / f64(rows)
  let px = w.x_min + u * w.x_len
  let py = w.y_min + t * w.y_len
  let nx = v.x_len * factor
  let ny = w.y_len * factor
  View { cx: px + nx * (0.5 - u), cy: py + ny * (0.5 - t), x_len: nx }
}

let contain_set = pure (cols: i64, rows: i64) -> (i64, i64) => {
  var width = cols
  var height = (f64(cols) * ASPECT_RATIO / CELL_ASPECT).round()
  if height > rows {
    height = rows
    width = (f64(height) * CELL_ASPECT / ASPECT_RATIO).round()
  }
  (width, height)
}

let setup = () => {
  // Order matters on the way in, and the reverse order on the way out.
  set_raw_mode(true)
  alt_screen_enter()
  cursor_hide()
  mouse_enable()
  clear()
}

let teardown = () => {
  mouse_disable()
  cursor_show()
  alt_screen_leave()
  set_raw_mode(false)
}

let clamp = pure (v: i64, lo: i64, hi: i64) -> i64 => if v < lo { lo } else if v > hi { hi } else { v }

/// Draw one whole frame: rows of the set, then the status line, in a single write.
///
/// Takes the **terminal** size and calls `contain_set` itself, rather than being handed a
/// pre-contained size. That is what makes the aspect correction unforgettable: it used to
/// be the caller's job, and two of the three call sites did it while the third — the one
/// that redraws after a keypress or a click — passed the raw terminal size straight
/// through. The frame was correct until you touched anything, then stretched to full
/// width. A parameter that must be pre-processed by every caller is a parameter that will
/// eventually not be.
let draw = (term_cols: i64, term_rows: i64, view: View, mx: i64, my: i64) -> void => {
  // The status bar owns the last row, so the set is fitted into what is left rather than
  // into the whole terminal — otherwise it is one row too tall and the bottom is lost
  // under the bar.
  // Geometry comes from the one helper the zoom handler also uses, so the frame drawn
  // and the frame zoomed about are the same frame. Centred in whichever direction has
  // room; only one offset is ever non-zero, since the fit makes the set touch one pair of
  // edges exactly.
  let (cols, rows, left, top) = frame_geometry(term_cols, term_rows)
  let w = window_for(view, cols, rows)
  let canvas_rows = term_rows - 1

  var lines: []string = []
  for _ in 1..<=top {
    lines.push(spaces(term_cols))
  }
  for row in 1..<=rows {
    // **Every line is exactly `term_cols` wide**, blanks included. The frame is redrawn
    // over the previous one with no `clear` between, so a short line leaves the old
    // frame's pixels to its right — and after centring there is old content on *both*
    // sides to overwrite.
    //
    // The padding is counted rather than measured: a rendered row carries escape
    // sequences, so its `len()` is nothing like its width in cells, and `fit` would
    // truncate it to ribbons.
    let painted = render_row(row, rows, cols, w, mx - left, my - top)
    lines.push(spaces(left) ++ (painted ++ spaces(term_cols - cols - left)))
  }
  for _ in 1..<=(canvas_rows - rows - top) {
    lines.push(spaces(term_cols))
  }
  lines.push(status(term_cols, term_rows, view))
  cursor_home()
  print(lines.join("\r\n"))
}

/// `n` spaces, and none for a negative count — the padding arithmetic can ask for a
/// negative width on a terminal too small to hold the status text, and a blank is the
/// right answer there rather than a trap.
let spaces = pure (n: i64) -> string => {
  var out = ""
  for _ in 1..<=n { out = out ++ " " }
  out
}


/// One row of the frame, as a string. Built by concatenation into a single row rather
/// than printed per cell.
///
/// `mx`/`my` are in the **set's** coordinates, not the terminal's — `draw` subtracts the
/// centring offsets before calling. A click arrives in terminal cells, and without that
/// translation the marker would land offset by exactly the left margin, which reads as
/// the click being inaccurate rather than as a coordinate-space mixup.
let render_row = pure (row: i64, rows: i64, cols: i64, w: Window, mx: i64, my: i64) -> string => {
  var out = ""
  // **A background escape is emitted only where the colour changes.** Repeating it per
  // cell costs about half the frame time and three to four times the bytes, and a
  // Mandelbrot is mostly large single-colour regions — measured at 80x24, 15.7 KB of
  // escapes became 5.4 KB. The terminal parses every one of those bytes, so this is the
  // cheapest thing available that makes a fast zoom feel smooth.
  //
  // `prev` starts at -1, which is no palette entry, so the first cell always emits.
  var prev = -1
  for col in 1..<=cols {
    if col == mx && row == my {
      out = out ++ (inverse() ++ ("+" ++ reset()))
      // The reset cleared the background, so the next cell has to restate it.
      prev = -1
    } else {
      let c = Complex {
        re: w.x_min + w.x_len * f64(col) / f64(cols),
        im: w.y_min + w.y_len * f64(row) / f64(rows)
      }
      let p = shade(c, iter_limit(w))
      if p != prev {
        out = out ++ bg_rgb((p >> 16) & 255, (p >> 8) & 255, p & 255)
        prev = p
      }
      out = out ++ " "
    }
  }
  out ++ reset()
}

/// How many iterations this window needs.
///
/// A fixed limit stops working the moment you zoom: the points that survive longest are
/// exactly the ones near the boundary being zoomed into, so at depth everything reads as
/// "in the set" and the picture goes flat black. The budget grows with the *log* of the
/// magnification, which is how the boundary's detail actually scales.
let iter_limit = pure (w: Window) -> i64 => {
  let magnification = X_LEN / w.x_len
  if magnification <= 1.0 {
    MAX_ITER
  } else {
    MAX_ITER + (120.0 * magnification.log10()).round()
  }
}

/// The colour of a point, packed as `r * 65536 + g * 256 + b`.
///
/// Packed rather than returned as a tuple or a string so the renderer can compare one
/// integer to decide whether to re-emit an escape — the run-length test that keeps the
/// frame small.
let shade = pure (c: Complex<f64>, max_iter: i64) -> i64 => {
  var z = Complex { re: 0.0, im: 0.0 }
  var mag2 = 0.0
  var iter = 0
  for iter < max_iter {
    z = z * z + c
    mag2 = z.re * z.re + z.im * z.im
    if mag2 > ESCAPE { break }
    iter += 1
  }

  if iter >= max_iter {
    0 // the set itself: black
  } else {
    // Smooth escape time, `n + 1 - log2(log|z|)`: the integer iteration count alone
    // draws visible contours, since every point escaping on the same step gets the same
    // colour. The smooth value is used **linearly** here — the logarithmic mapping this
    // replaced existed to spend a single fixed ramp sensibly, and a cycle has no ramp to
    // exhaust.
    let smooth = f64(iter) + 1.0 - mag2.sqrt().log().log2()
    // The correction is worth about -1.5, so a point escaping immediately lands below
    // zero — and a negative feeds a negative into the remainder below, which would index
    // backwards off the palette.
    let s = if smooth < 0.0 { 0.0 } else { smooth }

    // The fractional part of the turn count is the position on the hue circle, so the
    // colour wraps with no seam however many times it goes round.
    let turns = s / COLOR_CYCLE
    let hue = 6.0 * (turns - f64(turns.floor()))
    let value = if s >= FADE_IN { 1.0 } else { s / FADE_IN }
    hue_rgb(hue, value)
  }
}

/// A hue at full saturation and the given value, packed.
///
/// Plain HSV with S = 1: each sector holds one channel at full, ramps a second up or down,
/// and leaves the third at zero. Six linear sectors, no trigonometry — which is just as
/// well, since the language has `log` and `sqrt` and no `cos`.
let hue_rgb = pure (hue: f64, value: f64) -> i64 => {
  let sector = hue.floor()
  let f = hue - f64(sector)
  let full = (255.0 * value).round()
  let up = (255.0 * value * f).round()
  let down = (255.0 * value * (1.0 - f)).round()
  if sector <= 0 { pack(full, up, 0) }
  else if sector == 1 { pack(down, full, 0) }
  else if sector == 2 { pack(0, full, up) }
  else if sector == 3 { pack(0, down, full) }
  else if sector == 4 { pack(up, 0, full) }
  else { pack(full, 0, down) }
}

let pack = pure noalloc (r: i64, g: i64, b: i64) -> i64 => r * 65536 + g * 256 + b

/// The status line, always exactly one terminal row wide.
let status = pure (cols: i64, rows: i64, view: View) -> string => {
  let text = " ${cols}x${rows}  ${(X_LEN / view.x_len).to_fixed(1)}x at " ++
    "${view.cx.to_fixed(4)},${view.cy.to_fixed(4)}  " ++
    "wheel zooms to the pointer · q quits "
  inverse() ++ (bold() ++ (fit(text, cols) ++ reset()))
}

/// `text` at exactly `width` characters: padded if short, cut if long.
let fit = pure (text: string, width: i64) -> string => {
  if text.len() > width {
    text.slice(0, width)
  } else {
    var padded = text
    for _ in text.len()..<width {
      padded = padded ++ " "
    }
    padded
  }
}
