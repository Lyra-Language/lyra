let main = () => {
  var guess_count = 0
  let secret = random_between(1, 100)
  println("I am thinking of an integer between 1 and 100.")
  for {
    print("Enter your guess: ")
    match read_line() {
      Some input => {
        match input.parse_i64() {
          Some guess => {
            match guess {
              1..<=100 => {
                guess_count += 1
                match guess <=> secret {
                  Less    => println("Too low!"),
                  Greater => println("Too high!"),
                  Equal   => { println("You guessed it!"); break },
                }
              },
              _ => {
                println("My integer is between 1 and 100. Try again.")
                continue
              }
            }
          },
          None => {
            println("Hey, that's not an integer! Try again.")
          },
        }
      },
      None => {
        println("")
        println("No more input — the number was ${secret}.")
        break
      },
    }
  }
  println("It took you ${guess_count} guesses.")
}
