let main = () => {
  var guess_count = 0
  let rand_int = random_between(1, 100)
  println("I am thinking of an integer between 1 and 100.")
  for {
    print("Enter your guess: ")
    match read_line() {
      Some input => {
        match input.parse_i64() {
          Some guess => {
            if guess < 1 || guess > 100 {
              println("My integer is between 1 and 100. Try again.")
              continue
            } else {
              guess_count += 1
              if guess < rand_int {
                println("Too low!")
              } else if guess > rand_int {
                println("Too high!")
              } else {
                println("You guessed it!")
                break
              }
            }
          },
          None => {
            println("Hey, that's not an integer! Try again.")
          },
        }
      },
      None => {
        println("")
        println("No more input — the number was ${rand_int}.")
        break
      },
    }
  }
  println("It took you ${guess_count} guesses.")
}
