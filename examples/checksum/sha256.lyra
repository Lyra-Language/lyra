module sha256
//! SHA-256, after FIPS 180-4 — the standard library's third probe, and the first one made
//! of arithmetic rather than text.
//!
//! **Why a hash, when the other examples render and format.** `lyrafmt` is the compiler's
//! probe and `lyra-md`/`site` are the library's, and all three are programs about strings,
//! structs and files. Nothing in this repo had yet leaned on the *integer* half of the
//! language: `u32` that must wrap rather than trap, shifts, xor, and a byte array read and
//! written as numbers. A digest is that program, and it has the property no renderer has —
//! **a right answer that somebody else computed**, so the test is a comparison against
//! `sha256sum` rather than against what this happened to produce.

/// The SHA-256 digest of `data`: 32 bytes, high byte first.
///
/// ```
/// let digest = sha256(read_bytes(path).unwrap_or([]))
/// println(digest.to_hex())
/// ```
pub let sha256 = pure (data: []u8) -> []u8 => {
  let k = round_constants()
  var h = initial_state()
  let padded = pad(data)
  var at = 0
  for at < padded.len() {
    h = compress(h, schedule(padded, at), k)
    at += 64
  }
  var out: []u8 = []
  for word in h {
    out.push(u8(word >> 24))
    out.push(u8((word >> 16) & 255))
    out.push(u8((word >> 8) & 255))
    out.push(u8(word & 255))
  }
  out
}

// ---------------------------------------------------------------------------------------

/// The message, padded to whole blocks: a `1` bit, then zeros, then the **bit** length as
/// 64 bits, high byte first.
///
/// The bit length is what makes the padding unambiguous — without it a message ending in
/// the same bytes the padding writes would hash like a shorter one. It is `i64` here and
/// the standard allows 2⁶⁴ bits, so the top four bytes are zero for every message this can
/// hold: a file long enough to need them is longer than the address space.
let pad = pure (data: []u8) -> []u8 => {
  var out: []u8 = []
  for b in data { out.push(b) }
  out.push(128)
  for out.len() % 64 != 56 { out.push(0) }
  let bits = data.len() * 8
  for i in 0..<8 { out.push(u8((bits >> (56 - i * 8)) & 255)) }
  out
}

/// The 64-word message schedule for the block at `at`: sixteen words read from the block,
/// and forty-eight more derived from them.
let schedule = pure (padded: []u8, at: i64) -> []u32 => {
  var w: []u32 = []
  for i in 0..<16 {
    let j = at + i * 4
    w.push((u32(padded[j]) << 24) | (u32(padded[j + 1]) << 16) |
        (u32(padded[j + 2]) << 8) | u32(padded[j + 3]))
  }
  for i in 16..<64 {
    let s0 = rotate_right(w[i - 15], 7) ~ rotate_right(w[i - 15], 18) ~ (w[i - 15] >> 3)
    let s1 = rotate_right(w[i - 2], 17) ~ rotate_right(w[i - 2], 19) ~ (w[i - 2] >> 10)
    w.push(w[i - 16].wrapping_add(s0).wrapping_add(w[i - 7]).wrapping_add(s1))
  }
  w
}

/// The state with one block mixed into it.
///
/// **Answers a new state rather than mutating one**, so the digest above can be `pure`:
/// writing through a `mut` receiver is `EffectMut`, and a `pure` function may not call
/// something that has it. Eight words copied per block is the price, and it buys a hash
/// that is a function of its input in the language's own terms.
let compress = pure (state: []u32, w: []u32, k: []u32) -> []u32 => {
  var a = state[0]
  var b = state[1]
  var c = state[2]
  var d = state[3]
  var e = state[4]
  var f = state[5]
  var g = state[6]
  var h = state[7]
  for i in 0..<64 {
    let s1 = rotate_right(e, 6) ~ rotate_right(e, 11) ~ rotate_right(e, 25)
    let ch = (e & f) ~ (~e & g)
    let temp1 = h.wrapping_add(s1).wrapping_add(ch).wrapping_add(k[i]).wrapping_add(w[i])
    let s0 = rotate_right(a, 2) ~ rotate_right(a, 13) ~ rotate_right(a, 22)
    let maj = (a & b) ~ (a & c) ~ (b & c)
    let temp2 = s0.wrapping_add(maj)
    h = g
    g = f
    f = e
    e = d.wrapping_add(temp1)
    d = c
    c = b
    b = a
    a = temp1.wrapping_add(temp2)
  }
  [
    state[0].wrapping_add(a), state[1].wrapping_add(b),
    state[2].wrapping_add(c), state[3].wrapping_add(d),
    state[4].wrapping_add(e), state[5].wrapping_add(f),
    state[6].wrapping_add(g), state[7].wrapping_add(h),
  ]
}

/// `x` rotated right by `n` bits, the operation SHA-256 is mostly made of.
///
/// **Written here because the language has no rotate.** `wrapping_*`, `saturating_*` and
/// `checked_*` are builtin on every width (LANGUAGE.md); a rotate belongs in that table and
/// is not in it, so every program needing one writes this line. A shift is the only part
/// that has to be primitive — `>>` and `<<` truncate rather than trap, which is what makes
/// the two halves recombine — and `n` is never 0 or 32 here, where `x << 32` would be the
/// shift the hardware leaves undefined.
let rotate_right = pure noalloc (x: u32, n: u32) -> u32 => (x >> n) | (x << (32 - n))

/// The eight starting words: the fractional parts of the square roots of the first eight
/// primes, as FIPS 180-4 tabulates them.
let initial_state = pure () -> []u32 => [
  0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,
  0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19,
]

/// The sixty-four round constants: the fractional parts of the cube roots of the first
/// sixty-four primes.
///
/// A function rather than a `const`, and built once per digest rather than per block: a
/// module-level `const []u32` indexed from a function panics the backend on one of the
/// raylib tests (todo.md), and the shape that compiles everywhere is this one.
let round_constants = pure () -> []u32 => [
  0x428a2f98,
  0x71374491,
  0xb5c0fbcf,
  0xe9b5dba5,
  0x3956c25b,
