// lyrafmt — a Lyra formatter, in Lyra. The self-hosting probe.
//
//   examples/lyrafmt/libs.sh
//   LIBRARY_PATH=build/lib:$(pkg-config --variable=libdir tree-sitter) \
//     build/lyrac build -o build/lyrafmt examples/lyrafmt/lyrafmt.lyra
//   build/lyrafmt file.lyra           # the formatted text, to stdout
//   build/lyrafmt --check *.lyra      # names each file that would change; exit 1 if any
//   build/lyrafmt -w *.lyra           # rewrites each file that would change
//   build/lyrafmt --check .           # a directory is every `.lyra` file beneath it
//   build/lyrafmt -                   # formats standard input onto standard output
//
// The `-` form is what an editor uses: `lyra-lsp` runs it for `textDocument/formatting`,
// so the buffer being formatted need not be saved, and both editor extensions get the
// formatter without a second copy of these rules living in Go.
//
// The tree-sitter grammar parses each file; the formatter walks the tree to its leaves
// and rebuilds the text from the leaves' own bytes, deciding only what goes *between*
// them. A leaf is never changed, so a string, a comment or a raw string is what it was;
// with no rule in force (`--roundtrip`) the output is the input byte for byte, which is
// the baseline every rule is built on.
//
// The first rule is **indentation**. Every token has an **owner**: the statement,
// declaration, member, argument, arm or import name it is part of — a child of the program,
// a block or a member list, or whatever follows an opening delimiter, a comma or a comment.
// A line's level is then:
//
//   - one more than the level of the line its innermost open delimiter's **anchor** is on —
//     the construct the delimiter belongs to: the `if` of its block, the callee of its
//     argument list, the `match` of its arms, the declaration of a lambda's parameters
//     (`{`, `(`, `[`, `#[`, an import's `.{`, an interpolation's `${`) — or zero with none
//     open; so a block's body indents from the `if` that opened it even when that `if`
//     was itself a continuation, and from the declaration when only its signature wrapped;
//   - plus one if the line *continues* its owner from an earlier line with no delimiter
//     to say so (a lambda body after `=>`, a `data` type's constructors after `=`, a
//     chained `.method()`, the second half of a wrapped expression) — one level however
//     deep the expression, except that a body following a line-ending `=>` or `=` sits one
//     deeper than that line, so the body of a wrapped signature is not level with the
//     signature's own continuation;
//   - a line beginning with a closing delimiter closes it first and sits at the level of
//     its anchor's line, and an `else` on its own line takes the previous line's level.
//
// Four more, all about the space *between* tokens, and none of them touching a leaf — so
// a comment, a string or a raw string keeps every byte it had:
//
//   - **trailing whitespace** is dropped, and a file ends with exactly one newline;
//   - **blank lines** run at most one deep;
//   - **spacing** between two tokens on a line is one space or none: none where it is
//     forbidden (before `,` and `:`), one where it is required (each side of `=>`, after
//     `,` and `:`), and otherwise one if anything was there and none if nothing was — so
//     `a   +   b` closes up and `xs.len()` stays closed. A run of spaces is not preserved,
//     which does lose hand alignment; that is the trade for two files with the same tokens
//     formatting the same way;
//   - **an inline block** — a `{` with its `}` on the same line, and so also a struct's
//     fields, a struct literal and an inline import list — holds its contents one space
//     from each brace: `{ n }`, never `{n}` or `{ n}`. Empty braces close up to `{}`,
//     having nothing to hold apart, and an interpolation's `${…}` is not a block and stays
//     tight. This is a spacing rule and not a breaking one: **nothing here ever decides
//     that a line should break**, so a block written on one line stays on one line however
//     long it is, and a block written across lines keeps its lines.
//
// A leaf spanning lines (a block comment, a raw string) is copied verbatim, since its
// inner lines are content.
//
// **A gap is not always whitespace, and one that is not is copied untouched.** Some of the
// grammar's tokens are hidden — a raw string's own backticks (`_raw_string_start`/`_end`)
// and a float's mantissa before its `e30` exponent are not nodes, so those bytes sit in the
// gap between two leaves with nothing naming them. Every rule above therefore runs only on
// a gap that is entirely spaces, tabs and newlines; anything else is reproduced exactly,
// indentation and all. Treating a gap as whitespace unconditionally deleted the opening
// backtick of a raw string and turned `1.0e30` into `e30` (09/15).
//
// Exit 0 when nothing is wrong (or, under `--check`, nothing would change), 1 otherwise,
// 2 for usage.

import std.collections.{ parse_args, HashMap, hashmap_new, insert, get_or }
import std.io.{ read_file, read_stdin, write_file, read_dir, is_symlink }
import std.ffi.{ cstring }
import bindings.treesitter.{
  Node, Parser, lyra_language, new_parser, parser_delete, parse, tree_delete,
  root, child, child_count, start_byte, end_byte, kind, has_error,
}

let main = () -> u8 => {
  let args = parse_args([])
  if args.positional.len() == 0 {
    println("usage: lyrafmt [--check | -w | --roundtrip] <file.lyra | directory>...")
    return 2
  }
  let Some(parser) = new_parser(lyra_language()) else {
    println("lyrafmt: the tree-sitter runtime refused the Lyra grammar")
    return 1
  }
  let mode = if args.has("--check") { Check } else if args.has("-w") { Write } else { Print }
  let rule = !args.has("--roundtrip")
  var failures = 0
  for path in expand(args.positional) {
    // `-` is standard input, which has no name to report and nothing to write back to.
    if path == "-" {
      if mode == Write {
        println("lyrafmt: -w needs a file to write to, and `-` is standard input")
        parser_delete(parser)
        return 2
      }
      match format_source(parser, "<stdin>", read_stdin(), rule) {
        Ok(f) => if !deliver("<stdin>", f, mode) { failures += 1 },
        Err(problem) => {
          println("lyrafmt: ${problem}")
          failures += 1
        },
      }
      continue
    }
    match format_file(parser, path, rule) {
      Ok(f) => if !deliver(path, f, mode) { failures += 1 },
      Err(problem) => {
        println("lyrafmt: ${problem}")
        failures += 1
      },
    }
  }
  parser_delete(parser)
  if failures == 0 { 0 } else { 1 }
}

/// What to do with a formatted file.
data Mode = Print | Check | Write

/// A file and what the rules make of it.
struct Formatted {
  source: string,
  text: string,
}

/// The files the command line names: a `-` or a file as written, and a **directory
/// expanded to the `.lyra` files beneath it**, so `lyrafmt --check .` is the whole repo.
///
/// **A path is a directory if it can be read as one**, which is the only question this
/// needs and the only one `std.io` answers. A file, a missing path and an unreadable
/// directory all come back `None` and are passed through as written — so a path that names
/// nothing is reported by the read that follows, against the name the user typed, rather
/// than swallowed here as "not a directory".
///
/// The order is `read_dir`'s, which is sorted, so a run over a tree visits the same files
/// in the same order on every machine — which is what makes `--check`'s output, and its
/// exit code, reproducible.
let expand = (paths: []string) -> []string => {
  var out: []string = []
  for path in paths {
    match read_dir(path) {
      Some(names) => walk(path, names, out),
      None => out.push(path),
    }
  }
  out
}

/// Appends every `.lyra` file at or below `dir` — whose entries are `names` — to `out`.
///
/// **A name beginning with `.` is skipped**, and only while walking: `.git` holds no Lyra
/// to format and is most of the work of walking a repo, and a file the author hid is not
/// one a formatter should find on its own. A path named on the command line is never
/// filtered — it was asked for by name, which is the convention every tool that skips
/// dotfiles keeps.
///
/// Recursion rather than a work list because a directory tree is one, and the depth is the
/// tree's: a repo is tens deep at worst.
let walk = (dir: string, names: []string, out: mut []string) -> void => {
  for name in names {
    if name.starts_with(".") { continue }
    // `entry`, not `child`: the grammar binding exports a `child`, and a local of that
    // name shadows it (lyra-W001) two functions above where the tree is walked.
    let entry = dir ++ "/" ++ name
    match read_dir(entry) {
      // **A symlink is never descended.** `build/std` here points back at `std/`, so
      // following links formats every prelude file twice under two names, and a link into
      // an ancestor would not terminate at all. A symlinked *file* is still formatted —
      // it is a file, and the caller could have named it — which is where every walker
      // that refuses symlinked directories lands.
      Some(names_below) => if !is_symlink(entry) { walk(entry, names_below, out) },
      None => if entry.ends_with(".lyra") { out.push(entry) },
    }
  }
}

/// Hands one result to its destination; answers whether it counts as success under `mode`
/// — under `--check`, a file that would change does not.
let deliver = (path: string, f: Formatted, mode: Mode) -> bool => match mode {
  Print => {
    print(f.text)
    true
  },
  Check => {
    if f.text == f.source { return true }
    println("would reformat ${path}")
    false
  },
  Write => {
    if f.text == f.source { return true }
    if write_file(path, f.text) {
      println("reformatted ${path}")
      true
    } else {
      println("lyrafmt: cannot write ${path}")
      false
    }
  },
}

/// The file at `path`, formatted (or rebuilt unchanged when `rule` is off).
let format_file = (parser: Parser, path: string, rule: bool) -> Result<Formatted, string> => {
  let Some(source) = read_file(path) else { return Err("cannot read ${path}") }
  format_source(parser, path, source, rule)
}

/// `source`, formatted; `name` is what a problem is reported against.
let format_source = (parser: Parser, name: string, source: string, rule: bool) -> Result<Formatted, string> => {
  let path = name
  let Some(tree) = parse(parser, source) else { return Err("${path}: the parser answered no tree") }
  let top = root(tree)
  if has_error(top) {
    tree_delete(tree)
    return Err("${path}: syntax error")
  }
  var leaves: []Leaf = []
  collect_leaves(top, 0, 0, "", leaves)
  tree_delete(tree)
  // Byte offsets index the source's bytes, not its runes; `cstring` is the byte view (its
  // trailing NUL is past every offset the tree reports).
  let bytes = source.cstring()
  let text = lay_out(bytes, bytes.len() - 1, leaves, rule).decode_utf8()
  Ok(Formatted { source: source, text: text })
}

/// The file laid out: `format` run until no line is over the budget that breaking can fix.
///
/// **Render, measure, break, render again.** A break's effect on the lines around it is
/// what the existing indentation rules say it is, so the honest way to know a line's width
/// after a break is to lay the file out again and look — rather than to predict it, which
/// is the same computation done twice and wrong the second time. Each pass explodes the
/// *outermost* list on each over-long line, so a nested one is reached by the pass after,
/// with the widths it actually has by then.
///
/// The pass cap is what makes this terminate whatever the planner does. Each pass must add
/// a break or it stops, so the cap is only reached by a file nested deeper than it — and a
/// line that is still long then is one no further break would shorten.
let lay_out = (bytes: []u8, len: i64, leaves: []Leaf, rule: bool) -> []u8 => {
  var breaks = [false; leaves.len()]
  var cols = [0; leaves.len()]
  var lines = [0; leaves.len()]
  var out = format(bytes, len, leaves, rule, breaks, cols, lines)
  if !rule { return out }
  for _ in 0..<BREAK_PASSES {
    if !plan_breaks(bytes, leaves, cols, lines, breaks) { return out }
    out = format(bytes, len, leaves, rule, breaks, cols, lines)
  }
  out
}

/// A token of the source: where it is, what the grammar calls it, and where the thing it
/// belongs to began.
struct Leaf {
  start: i64,
  end: i64,
  kind: string,
  /// The start of the token's owner — the statement, declaration, member or list element
  /// it is part of. A token on a later line than its owner's start continues the owner.
  owner: i64,
  /// The start of the construct an opening delimiter belongs to — the nearest ancestor
  /// that begins before the token — whose line the delimiter's contents indent from.
  anchor: i64,
  /// What the token is a direct part of, as the grammar names it. Spacing asks: a `:` in
  /// a `range_expr` is a step separator, not an annotation.
  parent: string,
}

/// Appends `node`'s leaves to `out`, in source order. `owner` is the enclosing owner's
/// start; a child of a block-like node, or one that follows an opening delimiter or a
/// comma, begins an owner of its own.
let collect_leaves = (node: Node, owner: i64, anchor: i64, parent: string, out: mut []Leaf) -> void => {
  let n = child_count(node)
  let start = start_byte(node)
  if n == 0 {
    out.push(Leaf { start: start, end: end_byte(node), kind: kind(node), owner: owner,
      anchor: anchor, parent: parent })
    return
  }
  let own_kind = kind(node)
  let block_like = is_block_like(kind(node))
  // A lambda anchors at its parameter list, not at a modifier before it: `pure` may end
  // the `let` line with the signature on the next, and the body indents from the
  // signature's line.
  let anchor_start = if kind(node) == "lambda_expr" { parameter_list_start(node, start) } else { start }
  var after_attributes = false
  for i in 0..<n {
    let c = child(node, i)
    let after_separator = separates(last_code_kind(out)) || after_update_bar(out)
    // An attribute sits on its own line above what it marks (`@link("z")` above
    // `module`, `@must_release(f)` above `pub struct`), inside the declaration's node:
    // the declaration proper begins fresh after it.
    let own = if block_like || after_separator || after_attributes { start_byte(c) } else { owner }
    // A node beginning where its parent does (a block at its `{`, an argument list at
    // its `(`) is not a construct of its own for anchoring; the parent that begins
    // earlier is.
    let anchored = if start_byte(c) == anchor_start { anchor } else { anchor_start }
    collect_leaves(c, own, anchored, own_kind, out)
    after_attributes = kind(c) == "attribute_list"
  }
}

/// Where a lambda's parameter list begins, or `fallback` if it has none.
let parameter_list_start = (lambda: Node, fallback: i64) -> i64 => {
  for i in 0..<child_count(lambda) {
    let c = child(lambda, i)
    let k = kind(c)
    if k == "parameter_list" || k == "pattern_parameter_list" { return start_byte(c) }
  }
  fallback
}

/// Whether a node's children are each their own line's business: the program, a block, a
/// loop's body, and the member lists a newline separates.
let is_block_like = pure (k: string) -> bool =>
  k == "program" || k == "block" || k == "for_body" || k == "for_in_body" ||
  k == "impl_methods" || k == "trait_methods"

/// Whether the token before a node makes the node an owner: an opening delimiter or a
/// comma, so an argument, a parameter, a field, a match arm or an import name starts
/// fresh. Comments are looked past (last_code_kind): a doc comment above a field is
/// preceded by the comma, and the field after it still is.
let separates = pure (k: string) -> bool => opens(k) || k == ","

/// Whether the last code token is the `|` of a record update — `P { base |` — after which
/// each field is its own owner, exactly as after a comma.
///
/// **By its parent, because `|` means four things**: bitwise-or, a `data` type's
/// constructor separator and a comprehension's section break are all `|` too, and each of
/// those is a continuation. Without this the *first* field of a record update written
/// across lines read as continuing `base` and sat a level deeper than the fields after it,
/// which each followed a comma (09/18, found formatting `std.temporal`).
let after_update_bar = pure (out: []Leaf) -> bool => {
  var i = out.len() - 1
  for i >= 0 {
    let k = out[i].kind
    if k != "comment" && k != "doc_comment" { return k == "|" && out[i].parent == "struct_update" }
    i -= 1
  }
  false
}

/// The kind of the last token in `out` that is not a comment, or "" with none.
let last_code_kind = pure (out: []Leaf) -> string => {
  var i = out.len() - 1
  for i >= 0 {
    let k = out[i].kind
    if k != "comment" && k != "doc_comment" { return k }
    i -= 1
  }
  ""
}

/// A delimiter that is open — one entry of the scope stack the formatter carries through a
/// file, and what the two questions a line asks its enclosing delimiter are answered from.
struct Scope {
  /// The level the delimiter's contents sit at: one more than the level of the line its
  /// anchor is on.
  level: i64,
  /// The level a closing delimiter that *starts* a line sits at: the anchor's line itself,
  /// so the `}` of an `if` that was a continuation lines up with the `if` and not with the
  /// statement the `if` continued.
  closer: i64,
}

/// The formatted bytes: every leaf as it was, and between leaves the source's own bytes —
/// except, with the rule on, the whitespace that begins a line, which becomes the
/// indentation the enclosing delimiters call for.
let format = (bytes: []u8, len: i64, leaves: []Leaf, rule: bool, breaks: []bool,
  cols: mut []i64, lines: mut []i64) -> []u8 => {
  var out: []u8 = []
  // One entry per delimiter still open, innermost last.
  var scopes: []Scope = []
  // The level of the line each token sits on, by the token's start — read back for an
  // opener's anchor, so a block indents from the line of the construct that opened it.
  var level_at: HashMap<i64, i64> = hashmap_new()
  var line_level = 0
  var previous_line_level = 0
  var previous_line_last_kind = ""
  var last_kind = ""
  var last_parent = ""
  var cursor = 0
  // The line each token lands on and the column it starts at, reported back for the
  // planner: it decides from the layout as rendered, never from a prediction of it.
  var line = 0
  for i in 0..<leaves.len() {
    let leaf = leaves[i]
    var closer_level = 0
    if rule && closes(leaf.kind) && scopes.len() > 0 {
      closer_level = scopes[scopes.len() - 1].closer
      scopes = scopes.slice(0, scopes.len() - 1)
    }
    let nl = last_newline(bytes, cursor, leaf.start)
    let plain = all_whitespace(bytes, cursor, leaf.start)
    // Whether this token begins its line, which is what an opener's contents indent from
    // when the opener is the line's first token (below).
    var starts_line = false
    if rule && plain && nl >= 0 && joins_up(leaf, last_kind) {
      // The one break the formatter removes: a parameter list that begins a line of its
      // own under its `=`. It is a list's opener, so the lines below it indent from the
      // line it sits on — and left where it was, that is the continuation line rather
      // than the declaration's, which puts the parameters one level too shallow and the
      // `)` at the margin. Pulled up, the header reads `pub let draw_ring = (` and the
      // parameters sit under the name, which is how this repo writes them by hand.
      push_spacing(leaf.start - cursor, last_kind, last_parent, leaf, out)
    } else if rule && plain && nl >= 0 {
      line += push_line_breaks(bytes, cursor, nl + 1, out)
      let base = if closes(leaf.kind) {
        closer_level
      } else if scopes.len() == 0 {
        0
      } else {
        scopes[scopes.len() - 1].level
      }
      let continuation = !closes(leaf.kind) && last_newline(bytes, leaf.owner, leaf.start) >= 0
      previous_line_level = line_level
      previous_line_last_kind = last_kind
      // An `else` on its own line sits under the line its `if` began — the previous line,
      // whether that held the whole `if … { … }` or only the `}` closing it. A body after
      // a line ending in `=>` or `=` sits one deeper than that line — the line right
      // before, so a doc comment between `=` and a constructor does not deepen it again.
      line_level = if leaf.kind == "else" {
        previous_line_level
      } else if continuation && introduces_body(previous_line_last_kind) {
        previous_line_level + 1
      } else if continuation {
        base + 1
      } else {
        base
      }
      starts_line = true
      push_indent(line_level, out)
    } else if rule && plain && breaks[i] {
      // A break the planner asked for, where the source had a space. It starts a line, so
      // it answers the same two questions a source line break answers — and it is never a
      // continuation: the planner only breaks after an opener or a comma and before a
      // closer, which are the positions where the enclosing delimiter's own level is the
      // right one.
      out.push(10)
      line += 1
      previous_line_level = line_level
      previous_line_last_kind = last_kind
      line_level = if closes(leaf.kind) {
        closer_level
      } else if scopes.len() == 0 {
        0
      } else {
        scopes[scopes.len() - 1].level
      }
      starts_line = true
      push_indent(line_level, out)
    } else if rule && plain {
      push_spacing(leaf.start - cursor, last_kind, last_parent, leaf, out)
    } else {
      copy_bytes(bytes, cursor, leaf.start, out)
    }
    level_at.insert(leaf.start, line_level)
    cols[i] = column_of(out)
    lines[i] = line
    copy_bytes(bytes, leaf.start, leaf.end, out)
    cursor = leaf.end
    last_kind = leaf.kind
    last_parent = leaf.parent
    if rule && opens(leaf.kind) {
      // Contents indent from the line of the construct that opened the delimiter — except
      // where the delimiter **is** the first token on its line, and then from its own
      // line. The two differ only when the construct began on an earlier, shallower line:
      // `if a &&` / `  b {` indents its body from the `if` (the anchor), while a list
      // whose `[` was pushed onto a continuation line of its own indents from that line,
      // where an anchor would put the elements level with their own opener.
      let anchor_level = level_at.get_or(leaf.anchor, line_level)
      let base = if starts_line { line_level } else { anchor_level }
      scopes.push(Scope { level: base + 1, closer: base })
    }
  }
  // What follows the last leaf is normally a newline and possibly blank lines, and a file
  // ends with exactly one newline. Normally: a file ending in a raw string ends with the
  // hidden backtick that closes it, which is real source sitting in this gap, so the
  // whitespace test decides here too. (A file with no leaves has nothing to end.)
  if rule && all_whitespace(bytes, cursor, len) {
    if leaves.len() > 0 { out.push(10) }
  } else {
    copy_bytes(bytes, cursor, len, out)
    if rule && (len == 0 || bytes[len - 1] != 10) { out.push(10) }
  }
  out
}

/// The width a line may reach before the formatter breaks it, and the cap on how many
/// render-and-break passes one file gets.
///
/// **90 is what this repo already writes**: the 95th percentile line in `std` and
/// `examples` is 91 columns and doc comments wrap near 90, so the budget enforces the
/// house style rather than imposing a new one. Counted in **bytes**, so a line carrying
/// non-ASCII text measures a little wider than it looks; every such line here is prose in
/// a comment, which this never breaks.
const WIDTH = 90
const BREAK_PASSES = 8

/// Plans the breaks for one pass: on every line over the budget, explodes **one** comma
/// list — the outermost one the line has to offer. Answers whether it planned anything,
/// which is what ends the loop.
///
/// **Exploding, not filling.** A list that must break puts every element on its own line,
/// rather than packing as many as fit per line. Packing makes a one-element edit reflow
/// the elements after it, so a diff shows lines that did not change; exploding makes an
/// edit touch one line. It is what the code in this repo already does by hand.
///
/// **Only breaking, never joining**: a line the author split stays split even if it would
/// now fit. The formatter can make a line shorter and never longer, which is what keeps a
/// deliberate layout — an aligned table of match arms, a struct literal grouped by meaning
/// — from being flattened by a tool that cannot know why it was written that way.
let plan_breaks = (bytes: []u8, leaves: []Leaf, cols: []i64, lines: []i64,
  breaks: mut []bool) -> bool => {
  if leaves.len() == 0 { return false }
  // The delimiter each token sits directly inside, and whether any string interpolation
  // encloses it — inside one, the "whitespace" between tokens is a string's own bytes and
  // a newline there would rewrite the string.
  var inside = [0 - 1; leaves.len()]
  var closer_of = [0 - 1; leaves.len()]
  var in_interp = [false; leaves.len()]
  var open_stack: []i64 = []
  var interp_depth = 0
  for i in 0..<leaves.len() {
    let kind = leaves[i].kind
    if closes(kind) && open_stack.len() > 0 {
      let opener = open_stack[open_stack.len() - 1]
      open_stack = open_stack.slice(0, open_stack.len() - 1)
      closer_of[opener] = i
      if leaves[opener].kind == `${` { interp_depth -= 1 }
    }
    inside[i] = if open_stack.len() > 0 { open_stack[open_stack.len() - 1] } else { 0 - 1 }
    in_interp[i] = interp_depth > 0
    if opens(kind) {
      if kind == `${` { interp_depth += 1 }
      open_stack.push(i)
    }
  }
  // How wide each line came out: the far edge of its last token.
  var widest = [0; lines[leaves.len() - 1] + 1]
  for i in 0..<leaves.len() {
    let edge = cols[i] + (leaves[i].end - leaves[i].start)
    if edge > widest[lines[i]] { widest[lines[i]] = edge }
  }
  var planned = false
  var i = 0
  for i < leaves.len() {
    let line = lines[i]
    var last = i
    for last + 1 < leaves.len() && lines[last + 1] == line { last += 1 }
    if widest[line] > WIDTH {
      let chosen = widest_list(leaves, inside, in_interp, closer_of, i, last)
      if chosen >= 0 && explode(bytes, leaves, inside, closer_of, chosen, breaks) {
        planned = true
      }
    }
    i = last + 1
  }
  planned
}

/// The list to break on a line that is too long: the **outermost** delimiter with a comma
/// of its own on that line.
///
/// Outermost, because breaking it is what shortens the line the most and what leaves the
/// remaining pieces whole: exploding the inner list of `f(g(a, b), c)` leaves `f(g(` at
/// the front of a line that still holds everything else, while exploding `f`'s arguments
/// puts `g(a, b)` on a line of its own — where the next pass can break it in turn if it is
/// still too long.
///
/// A delimiter with no comma on this line is not a list here and is passed over; a `${` is
/// refused outright, along with everything inside one, since its gaps are a string's bytes.
let widest_list = pure (leaves: []Leaf, inside: []i64, in_interp: []bool, closer_of: []i64,
  from: i64, to: i64) -> i64 => {
  var best = 0 - 1
  var best_depth = 0
  for i in from..<=to {
    if leaves[i].kind != "," || in_interp[i] { continue }
    let owner = inside[i]
    if owner < 0 || closer_of[owner] < 0 { continue }
    if leaves[owner].kind == `${` { continue }
    let depth = nesting(inside, owner)
    if best < 0 || depth < best_depth {
      best = owner
      best_depth = depth
    }
  }
  best
}

/// How many delimiters enclose the one at `i`, itself included.
let nesting = pure (inside: []i64, i: i64) -> i64 => {
  var depth = 0
  var at = i
  for at >= 0 {
    depth += 1
    at = inside[at]
  }
  depth
}

/// Puts every element of the list opened at `opener` on a line of its own: a break after
/// the opener, after each of its commas, and before its closer. Answers whether it planned
/// a break that was not already planned — a list already exploded is how a pass runs out
/// of work on a line it cannot shorten further.
///
/// **A position whose gap is not plain whitespace is left alone, and takes the whole list
/// with it.** The gap between two tokens is normally the space between them, but the
/// grammar hides source in some gaps (a raw string's backticks), and a break there would
/// move bytes that are not whitespace. Refusing the list rather than that one position
/// keeps the result something a reader recognizes: a list is exploded or it is not.
let explode = (bytes: []u8, leaves: []Leaf, inside: []i64, closer_of: []i64, opener: i64,
  breaks: mut []bool) -> bool => {
  let closer = closer_of[opener]
  var wanted: []i64 = []
  if opener + 1 < closer { wanted.push(opener + 1) }
  for i in (opener + 1)..<closer {
    if leaves[i].kind == "," && inside[i] == opener && i + 1 < closer { wanted.push(i + 1) }
  }
  if wanted.len() == 0 { return false }
  wanted.push(closer)
  for at in wanted {
    if !all_whitespace(bytes, leaves[at - 1].end, leaves[at].start) { return false }
  }
  var added = false
  for at in wanted {
    if !breaks[at] {
      breaks[at] = true
      added = true
    }
  }
  added
}

/// The column the next byte would be written at: how far `out` has run since its last
/// newline.
let column_of = pure (out: []u8) -> i64 => {
  var i = out.len() - 1
  var n = 0
  for i >= 0 && out[i] != 10 {
    n += 1
    i -= 1
  }
  n
}

/// Whether every byte of `bytes[from..<to]` is a space, tab, carriage return or newline —
/// which is what lets a gap be rewritten. A gap holding anything else holds source the
/// grammar hid (a raw string's backticks, a float's mantissa) and must be left alone.
let all_whitespace = pure (bytes: []u8, from: i64, to: i64) -> bool => {
  for i in from..<to {
    let b = bytes[i]
    if b != 32 && b != 9 && b != 13 && b != 10 { return false }
  }
  true
}

/// Emits the line breaks of a gap that spans lines: every byte in it is either a newline
/// or the whitespace before one (the indentation of the line being started is pushed by
/// the caller), so the whitespace is trailing and is dropped, and a run of newlines is cut
/// to at most two — one line ending, one blank line. Anything else is copied, which cannot
/// happen between two leaves and is the leak-safe direction if it ever does.
let push_line_breaks = pure (bytes: []u8, from: i64, to: i64, out: mut []u8) -> i64 => {
  var newlines = 0
  for i in from..<to {
    let b = bytes[i]
    if b == 10 {
      newlines += 1
      if newlines <= 2 { out.push(10) }
    } else if b != 32 && b != 9 && b != 13 {
      out.push(b)
    }
  }
  if newlines > 2 { 2 } else { newlines }
}

/// Emits the space between two tokens on one line: **one space, or none**. None where a
/// space is forbidden, one where it is required, and otherwise one if there was any
/// whitespace at all and none if there was not — so `a   +   b` closes up to `a + b` while
/// `xs.len()` and `f(a)` keep their tokens together.
///
/// A run of spaces is therefore not preserved, and that loses hand alignment: the match
/// arms in `examples/guess_game.lyra` used to line up on their `=>`. It is the trade a
/// formatter makes to be one — two files with the same tokens format the same way, which
/// is the point of running it, and an alignment the formatter cannot produce itself is one
/// it cannot promise to keep.
let push_spacing = pure (gap: i64, before: string, before_parent: string,
  after: Leaf, out: mut []u8) -> void => {
  let want = wanted_space(before, before_parent, after.kind, after.parent)
  if want < 0 { return }
  if want > 0 || gap > 0 { out.push(32) }
}

/// Whether a space between two adjacent tokens is forbidden (-1), required (1) or the
/// author's business (0).
///
/// `::` and `::<` are tokens of their own, so a trait path (`Ord::compare`) and a turbofish
/// (`sum::<i64>`) are untouched by the rule for `:`. A range's **step** separator is a
/// plain `:` and is left alone on both sides: it binds as tightly as the `..` beside it,
/// and the language writes it `0..<10:2`.
///
/// **Braces hold their contents apart** — `{ n }`, never `{n}` or `{ n}` — which is the
/// inline-block rule, since a gap spanning lines is indented rather than spaced and never
/// reaches here. Empty braces close up to `{}`: there is nothing to hold apart.
let wanted_space = pure (before: string, before_parent: string, after: string, after_parent: string) -> i64 => {
  if is_range_step(before, before_parent) || is_range_step(after, after_parent) { return 0 }
  if opens_braces(before) && closes_braces(after, after_parent) { return 0 - 1 }
  if opens_braces(before) || closes_braces(after, after_parent) { return 1 }
  if after == "," || after == ":" { return 0 - 1 }
  if before == "," { return if closes(after) { 0 } else { 1 } }
  if before == ":" { return 1 }
  if before == "=>" || after == "=>" { return 1 }
  0
}

/// Whether a token is a range's step separator, `:` directly inside a `range_expr`.
let is_range_step = pure (k: string, parent: string) -> bool => k == ":" && parent == "range_expr"

/// Whether a token opens a brace-delimited body whose contents are held one space away
/// when they share its line: a block, a struct's fields or type, an import's names. An
/// interpolation's `${` is not one — those braces are part of a string literal and stay
/// tight against the expression between them.
let opens_braces = pure (k: string) -> bool => k == "{" || k == ".{"

/// Whether a token closes one. A `}` is a closer for every brace; only its parent says
/// whether the pair was an interpolation's.
let closes_braces = pure (k: string, parent: string) -> bool =>
  k == "}" && parent != "string_interpolation"

/// Whether a token opens a level of indentation. An interpolation's `${` is one, since
/// its `}` is a closer; the raw-string spelling is the only way to write those two
/// characters, as `"${"` begins an interpolation.
let opens = pure (k: string) -> bool =>
  k == "{" || k == "(" || k == "[" || k == "#[" || k == ".{" || k == `${`

/// Whether a token that begins a line is one the formatter moves back onto the line
/// above: a parameter list's `(` directly under the `=` that binds the function.
///
/// **The only join in the formatter**, and deliberately the only one. Breaking is safe in
/// a way joining is not — a break can always be read, while a join can undo a layout the
/// author meant — so joining is confined to the one shape where the alternative is a
/// parameter list the indentation rules cannot place: its contents indent from the line
/// its `(` is on, and a `(` alone on a continuation line is not a line anything should
/// indent from.
let joins_up = pure (leaf: Leaf, before: string) -> bool =>
  leaf.kind == "(" && leaf.parent == "parameter_list" && before == "="

/// Whether a token at the end of a line introduces a body on the next: `=>` before a
/// lambda's or an arm's, `=` before a declaration's value or a `data` type's constructors.
let introduces_body = pure (k: string) -> bool => k == "=>" || k == "="

/// Whether a token closes one.
let closes = pure (k: string) -> bool => k == "}" || k == ")" || k == "]"

/// The offset of the last newline in `bytes[from..<to]`, or -1.
let last_newline = pure (bytes: []u8, from: i64, to: i64) -> i64 => {
  var i = to - 1
  for i >= from {
    if bytes[i] == 10 { return i }
    i -= 1
  }
  -1
}

/// Appends two spaces per level.
let push_indent = pure (depth: i64, out: mut []u8) -> void => {
  for _ in 0..<(depth * 2) { out.push(32) }
}

/// Appends `bytes[from..<to]` to `out`.
let copy_bytes = pure (bytes: []u8, from: i64, to: i64, out: mut []u8) -> void => {
  for i in from..<to { out.push(bytes[i]) }
}
