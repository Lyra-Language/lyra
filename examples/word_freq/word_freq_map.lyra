// Word frequencies — `word_freq.lyra` with the linear scan replaced by
// `std.collections`'s `HashMap`, so a lookup is expected O(1) rather than O(words), and
// the command line read through `ProgramArgs`.
//
//   lyrac run examples/word_freq/word_freq_map.lyra < some.txt
//   lyrac build -o word_count examples/word_freq/word_freq_map.lyra
//   ./word_count -f some.txt          # a file instead of stdin
//   ./word_count -f some.txt -n 5     # only the five most frequent
//
// The map's iteration order is the table's, so the report is sorted here by count.

import std.collections.{ HashMap, hashmap_new, insert, get_or, entries, ProgramArgs, parse_args, has, value }
import std.io.{ read_file }

let main = () -> u8 => {
  let args = parse_args(["-f", "-n"])

  // `-f` written with nothing after it is present without a value: `has` and `value`
  // together are how a program tells that from `-f` never given.
  if args.has("-f") && args.value("-f").is_none() {
    println("usage: ${args.program} [-f FILE] [-n COUNT]    (reads stdin without -f)")
    return 2
  }
  let text = match args.value("-f") {
    None => read_stdin(),
    Some(path) => match read_file(path) {
      Some(t) => t,
      None => {
        println("${args.program}: cannot read ${path}")
        return 1
      },
    },
  }
  // A valued flag with a default: absent, or not a number, means every word.
  let limit = args.value("-n").flat_map((s) => s.parse_i64()).unwrap_or(-1)

  var word_counts: HashMap<string, i64> = hashmap_new()
  for w in text.split_when((r) => !r.is_ascii_alpha()) {
    let word = w.to_ascii_lower()
    word_counts.insert(word, word_counts.get_or(word, 0) + 1)
  }
  for i, (word, n) in by_count(word_counts.entries()) {
    if limit >= 0 && i >= limit { break }
    println("${word}: ${n}")
  }
  0
}

// Every line of stdin, joined back with the newlines `read_line` removed — so the two
// sources hand the counting loop one shape.
let read_stdin = () -> string => {
  var lines: []string = []
  for {
    match read_line() {
      Some(line) => { lines.push(line) },
      None => { break },
    }
  }
  lines.join("\n")
}

// Descending by count, then ascending by word, so a tie is the same across runs — the
// map's iteration order is the table's. `sorted_by` is the prelude's stable copy, and the
// comparator says the order once, in the `Ordering` every sort takes.
let by_count = pure (pairs: [](string, i64)) -> [](string, i64) =>
  pairs.sorted_by((a, b) => if a.1 != b.1 { b.1.compare(a.1) } else { a.0.compare(b.0) })
