// A hero who walks where the pad says — the first game on `std.genesis`.
//
//   lyrac build walker.lyra          # -> walker.bin
//   lyrac run walker.lyra            # in Sheliak: the arrow keys move him
//
// Each frame: read the pad, move (two pixels a frame, stopped at the screen's edges),
// step the walk while moving and stand still otherwise, and put the sprite in the list.
// The vertical blank interrupt (`each_frame`) shows the list; the main loop waits for it,
// and once set up never touches the VDP itself. The art is two 16×16 frames (`HERO`),
// four tiles each, as Vega's sprite editor exports them.

import std.genesis.vdp
import std.genesis.pad
import std.genesis.sprites
import std.genesis.sprites.{ Sprite }

/// How far a held direction moves the hero each frame, in pixels.
const SPEED: i16 = 2

/// How many frames each step of the walk shows for.
const STEP_FRAMES: u16 = 8

/// The hero is 16×16: 2×2 tiles.
const SIZE: i16 = 16

let main = () -> void => {
  vdp.init()
  pad.init()
  vdp.load_palette(0, PALETTE)
  vdp.load_tiles(1, HERO)
  vdp.set_backdrop(0, 7)
  vdp.display_on()
  vdp.enable_vblank_interrupt()

  var x: i16 = (vdp.SCREEN_WIDTH - SIZE) / 2
  var y: i16 = (vdp.SCREEN_HEIGHT - SIZE) / 2
  var step: u16 = 0
  var frames: u16 = 0
  for {
    let buttons = pad.read(1)
    var dx: i16 = 0
    var dy: i16 = 0
    if pad.held(buttons, pad.LEFT) { dx = -SPEED }
    if pad.held(buttons, pad.RIGHT) { dx = SPEED }
    if pad.held(buttons, pad.UP) { dy = -SPEED }
    if pad.held(buttons, pad.DOWN) { dy = SPEED }
    let nx = (x + dx).clamp(0, vdp.SCREEN_WIDTH - SIZE)
    let ny = (y + dy).clamp(0, vdp.SCREEN_HEIGHT - SIZE)
    if nx != x || ny != y {
      // Walking: the next step every STEP_FRAMES frames.
      frames += 1
      if frames == STEP_FRAMES {
        frames = 0
        step = 1 - step
      }
    } else {
      // Standing — against a wall too.
      step = 0
      frames = 0
    }
    x = nx
    y = ny

    sprites.clear()
    sprites.add(Sprite { x: x, y: y, width: 2, height: 2, tile: 1 + step * 4 })
    // The next vertical blank shows it: wait for that before the next frame.
    let shown = vblanks
    for vblanks == shown {}
  }
}

/// Vertical blanks so far — how the main loop knows its frame has been shown.
var vblanks: u16 = 0

/// Each vertical blank: the sprite list to the VDP, then the count. The list is complete
/// by now, since a frame's work is done long before the next blank; and nothing else
/// writes to the VDP after setup, so this cannot interrupt a command half given.
@interrupt(vblank)
let each_frame = () -> void => {
  sprites.show()
  vblanks += 1
}

/// Palette 0: transparent, outline, skin, shirt, trousers, hair and shoes, eyes, and the
/// night-blue backdrop.
const PALETTE: [16]u16 = #[
  0x0000, 0x0000, 0x068E, 0x002E, 0x0C42, 0x0246, 0x0EEE, 0x0400,
  0x0000, 0x0000, 0x0000, 0x0000, 0x0000, 0x0000, 0x0000, 0x0000,
]

/// Two frames — standing, then mid-step — of four tiles each, column by column.
const HERO: [64]u32 = #[
  // frame 0, tile 0
  0x00000111, 0x00001555, 0x00001555, 0x00001222,
  0x00001262, 0x00001222, 0x00000122, 0x00001333,
  // frame 0, tile 1
  0x00012333, 0x00012333, 0x00001333, 0x00001444,
  0x00001441, 0x00001441, 0x00001551, 0x00001111,
  // frame 0, tile 2
  0x11100000, 0x55510000, 0x55510000, 0x22210000,
  0x26210000, 0x22210000, 0x22100000, 0x33310000,
  // frame 0, tile 3
  0x33321000, 0x33321000, 0x33310000, 0x44410000,
  0x14410000, 0x14410000, 0x15510000, 0x11110000,
  // frame 1, tile 0
  0x00000111, 0x00001555, 0x00001555, 0x00001222,
  0x00001262, 0x00001222, 0x00000122, 0x00001333,
  // frame 1, tile 1
  0x00012333, 0x00012333, 0x00001333, 0x00001444,
  0x00014411, 0x00144100, 0x00155100, 0x00111100,
  // frame 1, tile 2
  0x11100000, 0x55510000, 0x55510000, 0x22210000,
  0x26210000, 0x22210000, 0x22100000, 0x33310000,
  // frame 1, tile 3
  0x33321000, 0x33321000, 0x33310000, 0x44410000,
  0x14410000, 0x01441000, 0x01551000, 0x01111000,
]
