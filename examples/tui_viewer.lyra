import std.tui.{
  event_reader, Event, Key,
  mouse_enable, mouse_disable,
  alt_screen_enter, alt_screen_leave, clear, cursor_hide, cursor_show, cursor_home, move_to,
  fg, bg, rgb, reset, bold, inverse
}

// A full-screen interactive skeleton: the shape a terminal viewer wants, with a colour
// gradient standing in for whatever the program actually renders.
//
// What it demonstrates, and why each is here:
//
//   * **Setup and teardown pair up.** Four things are switched on and all four must be
//     switched off, in reverse. Leave any of them and the user's shell is broken after
//     the program exits.
//   * **One frame, one `print`.** Every cell goes into a single string and reaches the
//     terminal in one write. Positioning and printing per cell is the obvious way and is
//     far slower.
//   * **The size is read every frame**, so a resize is picked up. See the note on that
//     at the bottom — it is not free.
//   * Arrows and mouse both move the marker, the wheel changes a zoom number: the input
//     vocabulary a pan-and-zoom viewer needs.
//
// Run: lyrac run examples/tui_viewer.lyra   (q to quit)

/// Spread a **1-based** position over `span` cells onto the cube's 0..5, in six even
/// bands.
///
/// `6 * (pos - 1) / span`, and both adjustments are the point. The obvious
/// `5 * pos / span` looks right and is wrong at exactly one place: it reaches 5 only when
/// `pos == span`, so the top band is a **single cell** while the other five are `span/5`
/// wide each — which is visible as one anomalously bright edge and nothing else. Scaling
/// by 6 rather than 5 gives six buckets instead of five-and-a-bit; subtracting 1 is
/// because the position is 1-based, as everything in this library is.
///
/// Needs no clamp: `pos - 1` is at most `span - 1`, so the result is at most 5 whenever
/// `span >= 6`, and `rgb` clamps anyway on a terminal too narrow for six bands.
let band = pure noalloc (pos: i64, span: i64) -> i64 =>
  if span <= 0 { 0 } else { 6 * (pos - 1) / span }

/// The gradient cell for a position — stands in for a rendered pixel.
///
/// `span_rows` is the number of rows actually drawn, not the terminal's height: the
/// status line takes the last row, so passing the full height would leave the vertical
/// axis one band short of its top — the same off-by-one as above, one axis over.
let cell_color = pure (col: i64, row: i64, cols: i64, span_rows: i64, zoom: i64) -> i64 =>
  rgb(band(col, cols), band(row, span_rows), zoom % 6)

/// One row of the frame, as a string. Built by concatenation into a single row rather
/// than printed per cell.
let render_row = (row: i64, cols: i64, span_rows: i64, zoom: i64, mx: i64, my: i64) -> string => {
  var out = ""
  for col in 1..<=cols {
    // **Exactly one character per cell, marker included.** A terminal has no notion of
    // drawing "over" a cell — everything is a stream, so a two-character marker does not
    // cover its neighbour, it *displaces* it and shoves the rest of the row right by one.
    // Inverted rather than coloured, so it stands out against any gradient colour.
    let painted = if col == mx && row == my {
      inverse() ++ ("+" ++ reset())
    } else {
      bg(cell_color(col, row, cols, span_rows, zoom)) ++ " "
    }
    out = out ++ painted
  }
  out ++ reset()
}

/// `text` at exactly `width` characters: padded if short, cut if long.
///
/// **Both halves matter, and for opposite reasons.** Padding to full width is what lets
/// the status line be redrawn without `clear_line` — a shorter line would otherwise leave
/// the tail of the longer one that was there before. Cutting is what stops a long line
/// *wrapping*: a terminal has no concept of a line that is too wide, so it continues onto
/// the next row and pushes the whole frame up by one, which reads as the display jittering
/// rather than as text being too long.
let fit = (text: string, width: i64) -> string => {
  if text.len() > width {
    text.slice(0, width)
  } else {
    var padded = text
    for i in text.len()..<width {
      padded = padded ++ " "
    }
    padded
  }
}

/// The status line, always exactly one terminal row wide.
let status = (cols: i64, rows: i64, zoom: i64, mx: i64, my: i64, events: i64) -> string => {
  let text = " ${cols}x${rows}  zoom ${zoom}  marker ${mx},${my}  events ${events}  " ++
    "arrows/click move · wheel zooms · q quits "
  inverse() ++ (bold() ++ (fit(text, cols) ++ reset()))
}

/// Draw one whole frame: rows of gradient, then the status line, in a single write.
let draw = (cols: i64, rows: i64, zoom: i64, mx: i64, my: i64, events: i64) -> void => {
  var lines: []string = []
  // rows - 1, leaving the last line for the status bar. Drawing into the final row and
  // then emitting a newline scrolls the screen, which is what makes a full-height frame
  // jitter. The same count is also the vertical span the gradient spreads over — passing
  // the terminal's full height instead would leave the top band unused.
  let span_rows = rows - 1
  for row in 1..<=span_rows {
    lines.push(render_row(row, cols, span_rows, zoom, mx, my))
  }
  lines.push(status(cols, rows, zoom, mx, my, events))
  cursor_home()
  print(lines.join("\r\n"))
}

let clamp = pure (v: i64, lo: i64, hi: i64) -> i64 => if v < lo { lo } else if v > hi { hi } else { v }

let main = () => {
  // Order matters on the way in, and the reverse order on the way out.
  set_raw_mode(true)
  alt_screen_enter()
  cursor_hide()
  mouse_enable()
  clear()

  var zoom = 0
  var mx = 1
  var my = 1
  var count = 0
  var running = true
  var events = event_reader()

  let (cols0, rows0) = terminal_size()
  draw(cols0, rows0, zoom, mx, my, count)

  for running {
    match events.next_event() {
      None => { running = false },
      Some(e) => {
        count += 1
        // Read the size every frame rather than once: the window can change, and this is
        // exactly why `terminal_size` is EffectInput rather than a constant.
        let (cols, rows) = terminal_size()
        match e {
          Keyboard(Up) => { my -= 1 },
          Keyboard(Down) => { my += 1 },
          Keyboard(Left) => { mx -= 1 },
          Keyboard(Right) => { mx += 1 },
          Keyboard(PageUp) => { zoom += 1 },
          Keyboard(PageDown) => { zoom -= 1 },
          Keyboard(Char c) => { running = i64(c) != 113 },
          Mouse(m) => match m.button {
            WheelUp => { zoom += 1 },
            WheelDown => { zoom -= 1 },
            // A click sets the marker where the pointer is — the coordinates are
            // already 1-based, matching the frame's own numbering.
            _ => { mx = m.col; my = m.row }
          },
          _ => { }
        }
        mx = clamp(mx, 1, cols)
        my = clamp(my, 1, rows - 1)
        zoom = clamp(zoom, 0, 99)
        draw(cols, rows, zoom, mx, my, count)
      }
    }
  }

  mouse_disable()
  cursor_show()
  alt_screen_leave()
  set_raw_mode(false)

  // A resize is only noticed on the *next* event, because `read_key` blocks and there is
  // no way to wake it: no signal handler for SIGWINCH, and no timed read. Resizing the
  // window and then pressing any key redraws correctly. Closing that properly is the
  // `timed read_key` item in todo.md.
  println("marker ended at ${mx},${my} after ${count} events")
}
