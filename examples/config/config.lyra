// A config loader — the program that drove conversion traits.
//
//   lyrac build -o config examples/config/config.lyra
//   ./config examples/config/server.json       # loads
//   ./config examples/config/bad_port.json     # a field of the wrong kind
//   ./config examples/config/malformed.json    # not JSON at all
//   ./config examples/config/nowhere.json      # no such file
//
// Loading a config composes two error types: `std.json`'s `JsonError` and this program's
// own `ConfigError`. Two features carry the composition, both landed 09/15/26 with this
// file as the driver:
//
// 1. `?` across error types applies a declared conversion. `parse_json(text)?` inside a
//    function answering `Result<_, ConfigError>` runs `impl From<JsonError> for
//    ConfigError` on the error before propagating it. `?` knows both types, so the impl is
//    found by a direct lookup; `map_err` is the one-off spelling.
//
// 2. Typed field decoding is return-type-directed. `FromJson`'s method takes no `self`,
//    so the impl is chosen from the type the caller expects: `let port: i64 =
//    required(json, "port")?` solves `required`'s `t` from the annotation (which reaches
//    through `?`), and inside `required` the annotation on `decoded` picks the impl.
//
// What the message says a field should be comes from the impl too, as the `Err` of
// `from_json` — a question about the type, answered by the impl rather than by a
// `kind_name::<t>()` the language does not have.

import std.collections.{ parse_args }
import std.io.{ read_file }
import std.json.{ JsonError, JsonValue, parse_json }

let main = () -> u8 => {
  let args = parse_args([])
  if args.positional.len() != 1 {
    println("usage: config <file.json>")
    return 2
  }
  match load(args.positional[0]) {
    Ok(c) => {
      println("${c}")
      0
    },
    Err(problem) => {
      println("config: ${problem}")
      1
    },
  }
}

/// A server's settings, every field required.
struct Config {
  host: string,
  port: i64,
  tls: bool,
  workers: i64,
}

impl Show for Config {
  show = pure (self) => {
    let scheme = if self.tls { "https" } else { "http" }
    "${scheme}://${self.host}:${self.port} with ${self.workers} workers"
  }
}

/// Everything that can go wrong loading a config — one type, so a caller can tell the cases
/// apart and `load` has one error to answer.
data ConfigError =
  /// The file could not be read.
  Unreadable(string)
  /// The file is not JSON; carries the parser's own error unchanged.
  | Malformed(JsonError)
  /// A required field is absent.
  | MissingField(string)
  /// A field is present but holds the wrong kind of value: name, wanted kind, found kind.
  | WrongKind(string, string, string)

impl Show for ConfigError {
  show = pure (self) => match self {
    Unreadable(path) => "cannot read ${path}",
    Malformed(e) => "not valid JSON at byte ${e.offset}: ${e.message}",
    MissingField(name) => "missing field \"${name}\"",
    WrongKind(name, want, got) => "field \"${name}\" should be ${want}, found ${got}",
  }
}

/// The parser's error becomes this program's, so `?` can propagate it unchanged.
impl From<JsonError> for ConfigError {
  from = pure (e) => Malformed(e)
}

/// The file at `path` as a `Config`, or the first thing wrong with it.
let load = (path: string) -> Result<Config, ConfigError> => {
  let text = read_file(path).ok_or(Unreadable(path))?
  let json = parse_json(text)?
  let host: string = required(json, "host")?
  let port: i64 = required(json, "port")?
  let tls: bool = required(json, "tls")?
  let workers: i64 = required(json, "workers")?
  Ok(Config { host: host, port: port, tls: tls, workers: workers })
}

/// A type that can be read out of a JSON value. `Err` names what the value should have
/// been, in the words a message wants ("a whole number").
trait FromJson {
  from_json: (JsonValue) -> Result<Self, string>
}

impl FromJson for i64 {
  from_json = pure (v) => v.as_int().ok_or("a whole number")
}

impl FromJson for string {
  from_json = pure (v) => v.as_text().ok_or("a string")
}

impl FromJson for bool {
  from_json = pure (v) => v.as_bool().ok_or("a bool")
}

/// Field `name` of `obj` as a `t`, which the caller's annotation chooses.
let required<t> where t: FromJson = pure (obj: JsonValue, name: string) -> Result<t, ConfigError> => {
  let value = obj.field(name).ok_or(MissingField(name))?
  let decoded: Result<t, string> = FromJson::from_json(value)
  decoded.map_err((want) => WrongKind(name, want, value.kind()))
}
