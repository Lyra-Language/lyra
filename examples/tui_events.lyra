import std.tui.{
  event_reader, Event, Key, MouseButton, MouseAction,
  mouse_enable, mouse_enable_motion, mouse_disable
}

// The input half of `std.tui`, line by line rather than full-screen so the output can be
// read as a transcript.
//
// Two phases, and the first exists to show why the second is needed: `read_key()` is the
// raw builtin and answers one *code point*, so an arrow key arrives as three of them.
// `next_event()` is the decoder over it, and answers `Up`.
//
// Run: lyrac run examples/tui_events.lyra

/// A rune's name, printable or not — the control codes have no glyph, so show the number.
let show_code = (c: rune) -> string => {
  let n = i64(c)
  if n < 32 || n == 127 { "<${n}>" } else { "'${c}' (${n})" }
}

let key_name = (k: Key) -> string => match k {
  Char c => "Char ${show_code(c)}",
  Up => "Up", Down => "Down", Left => "Left", Right => "Right",
  Home => "Home", End => "End", PageUp => "PageUp", PageDown => "PageDown",
  Delete => "Delete", Enter => "Enter", Tab => "Tab", Backspace => "Backspace",
  Escape => "Escape"
}

let button_name = (b: MouseButton) -> string => match b {
  MouseLeft => "left", MouseMiddle => "middle", MouseRight => "right",
  WheelUp => "wheel-up", WheelDown => "wheel-down", NoButton => "no button"
}

let action_name = (a: MouseAction) -> string => match a {
  Press => "press", Release => "release", Move => "move"
}

let describe = (e: Event) -> string => match e {
  Keyboard(k) => "key    ${key_name(k)}",
  Mouse(m) => "mouse  ${button_name(m.button)} ${action_name(m.action)} at col ${m.col}, row ${m.row}"
}

/// Phase 1: the raw builtin. Three code points, whatever they are.
let show_raw_reads = () -> void => {
  print("Press one arrow key. `read_key()` will report it as three code points:\r\n")
  var i = 0
  for i < 3 {
    match read_key() {
      Some(c) => print("  read_key -> ${show_code(c)}\r\n"),
      None => { print("  read_key -> None (input ended)\r\n"); i = 3 }
    }
    i += 1
  }
  print("\r\nThat is ESC, '[' and a letter — one key, three reads. Now the decoder:\r\n\r\n")
}

let main = () => {
  // Raw mode first: without it `read_key` waits for Enter and none of this works.
  set_raw_mode(true)
  mouse_enable()

  let (cols, rows) = terminal_size()
  print("terminal is ${cols} columns x ${rows} rows\r\n\r\n")

  show_raw_reads()

  print("Keys, clicks and the wheel are reported below.\r\n")
  print("  m = toggle drag/motion reporting    q = quit\r\n\r\n")

  var events = event_reader()
  var running = true
  var motion = false
  for running {
    match events.next_event() {
      None => { print("input ended\r\n"); running = false },
      Some(e) => {
        print("${describe(e)}\r\n")
        // Dispatching on a key inside a `match` on the event — the natural shape, and
        // one that only became legal on 08/17: a one-armed `if` as the tail of a
        // statement-position arm used to be refused.
        match e {
          Keyboard(Char c) => {
            let n = i64(c)
            // `q` quits. Escape deliberately does not: it is reported one keypress late,
            // so binding it here would feel broken — see std.tui's next_event.
            if n == 113 { running = false }
            else if n == 109 {
              motion = !motion
              if motion { mouse_enable_motion() } else { mouse_enable() }
              print("  motion reporting ${if motion { "on" } else { "off" }}\r\n")
            }
          },
          _ => { }
        }
      }
    }
  }

  // Teardown, in reverse. Leaving either of these on strands the terminal: no echo, and
  // every click pasting escape sequences into the shell.
  mouse_disable()
  set_raw_mode(false)
  println("")
}
