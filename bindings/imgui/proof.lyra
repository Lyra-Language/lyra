module bindings.imgui
// Hand-written stand-ins for what gen/ will emit — replaced by generated.lyra.

import std.ffi

pub let begin = (name: string) -> bool =>
  name.with_cstring((n) => unsafe { imgui_begin(n, nullptr, 0) })

pub let end = () -> void => unsafe { imgui_end() }

pub let button = (label: string) -> bool =>
  label.with_cstring((l) => unsafe { imgui_button(l) })

/// Flips `v` when clicked, and answers whether it was.
pub let checkbox = (label: string, v: mut bool) -> bool => {
  let p = unsafe { &mut v }
  label.with_cstring((l) => unsafe { imgui_checkbox(l, p) })
}

pub let slider_float = (label: string, v: mut f32, v_min: f32, v_max: f32) -> bool => {
  let p = unsafe { &mut v }
  label.with_cstring((l) => unsafe { imgui_slider_float(l, p, v_min, v_max) })
}

pub let text = (s: string) -> void => s.with_cstring((t) => unsafe { imgui_text_unformatted(t) })

pub let show_demo_window = () -> void => unsafe { imgui_show_demo_window(nullptr) }

pub let dock_space_over_viewport = () -> void => unsafe { imgui_dock_space_over_viewport() }

@symbol("ImGui_Begin")
unsafe extern imgui_begin: (name: ^u8, p_open: ^mut bool, flags: i32) -> bool
@symbol("ImGui_End")
unsafe extern imgui_end: () -> void
@symbol("ImGui_Button")
unsafe extern imgui_button: (label: ^u8) -> bool
@symbol("ImGui_Checkbox")
unsafe extern imgui_checkbox: (label: ^u8, v: ^mut bool) -> bool
@symbol("ImGui_SliderFloat")
unsafe extern imgui_slider_float: (label: ^u8, v: ^mut f32, v_min: f32, v_max: f32) -> bool
@symbol("ImGui_TextUnformatted")
unsafe extern imgui_text_unformatted: (text: ^u8) -> void
@symbol("ImGui_ShowDemoWindow")
unsafe extern imgui_show_demo_window: (p_open: ^mut bool) -> void
@symbol("ImGui_DockSpaceOverViewport")
unsafe extern imgui_dock_space_over_viewport: () -> u32
