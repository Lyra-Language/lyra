  from_cstring(unsafe { c_get_version() })
}

/// `ImGui::StyleColorsDark` — new, recommended style (default)
pub let style_colors_dark = () -> void => unsafe { c_style_colors_dark(Style(nullptr)) }

/// `ImGui::StyleColorsLight` — best used with borders and a custom, thicker font
pub let style_colors_light = () -> void => unsafe { c_style_colors_light(Style(nullptr)) }

/// `ImGui::StyleColorsClassic` — classic imgui style
