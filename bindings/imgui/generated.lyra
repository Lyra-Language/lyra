/// `ImGui::BeginChild`.
pub let begin_child_id = (id: u32, size: Vec2 = Vec2 { x: 0.0, y: 0.0 }, child_flags: i32 = 0, window_flags: i32 = 0) -> bool => unsafe { c_begin_child_id(id, size, child_flags, window_flags) }

