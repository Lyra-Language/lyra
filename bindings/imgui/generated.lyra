/// `ImGui::TreeNode`.
pub let tree_node = (label: string) -> bool => label.with_cstring((c_label) => unsafe { c_tree_node(c_label) })

/// `ImGui::TreeNode` — helper variation to easily decorrelate the id from the displayed string. Read the FAQ about why and how to use ID. to align arbitrary text at the same level as a TreeNode() you can use Bullet().
pub let tree_node_str = (str_id: string, text: string) -> bool => str_id.with_cstring((c_str_id) => text.with_cstring((c_text) => unsafe { c_tree_node_str_unformatted(c_str_id, c_text) }))

/// `ImGui::TreeNodeEx`.
pub let tree_node_ex = (label: string, flags: i32 = 0) -> bool => label.with_cstring((c_label) => unsafe { c_tree_node_ex(c_label, flags) })

/// `ImGui::TreeNodeEx`.
pub let tree_node_ex_str = (str_id: string, flags: i32, text: string) -> bool => str_id.with_cstring((c_str_id) => text.with_cstring((c_text) => unsafe { c_tree_node_ex_str_unformatted(c_str_id, flags, c_text) }))

/// `ImGui::TreePush` — ~ Indent()+PushID(). Already called by TreeNode() when returning true, but you can call TreePush/TreePop yourself if desired.
pub let tree_push = (str_id: string) -> void => str_id.with_cstring((c_str_id) => unsafe { c_tree_push(c_str_id) })

/// `ImGui::TreePop` — ~ Unindent()+PopID()
pub let tree_pop = () -> void => unsafe { c_tree_pop() }

/// `ImGui::GetTreeNodeToLabelSpacing` — horizontal distance preceding label when using TreeNode*() or Bullet() == (g.FontSize + style.FramePadding.x*2) for a regular unframed TreeNode
pub let get_tree_node_to_label_spacing = () -> f32 => unsafe { c_get_tree_node_to_label_spacing() }

/// `ImGui::CollapsingHeader` — if returning 'true' the header is open. doesn't indent nor push on ID stack. user doesn't have to call TreePop().
pub let collapsing_header = (label: string, flags: i32 = 0) -> bool => label.with_cstring((c_label) => unsafe { c_collapsing_header(c_label, flags) })

/// `ImGui::CollapsingHeader` — when 'p_visible != NULL': if '*p_visible==true' display an additional small close button on upper right of the header which will set the bool to false when clicked, if '*p_visible==false' don't display the header.
pub let collapsing_header_bool_ptr = (label: string, p_visible: mut bool, flags: i32 = 0) -> bool => {
  let c_p_visible = unsafe { &mut p_visible }
  label.with_cstring((c_label) => unsafe { c_collapsing_header_bool_ptr(c_label, c_p_visible, flags) })
}

/// `ImGui::SetNextItemOpen` — set next TreeNode/CollapsingHeader open state.
pub let set_next_item_open = (is_open: bool, cond: i32 = 0) -> void => unsafe { c_set_next_item_open(is_open, cond) }

/// `ImGui::SetNextItemStorageID` — set id to use for open/close storage (default to same as item id).
pub let set_next_item_storage_id = (storage_id: u32) -> void => unsafe { c_set_next_item_storage_id(storage_id) }

/// `ImGui::TreeNodeGetOpen` — retrieve tree node open/close state.
pub let tree_node_get_open = (storage_id: u32) -> bool => unsafe { c_tree_node_get_open(storage_id) }

/// `ImGui::Selectable` — "bool selected" carry the selection state (read-only). Selectable() is clicked is returns true so you can modify your selection state. size.x==0.0: use remaining width, size.x>0.0: specify width. size.y==0.0: use label height, size.y>0.0: specify height
pub let selectable = (label: string, selected: bool = false, flags: i32 = 0, size: Vec2 = Vec2 { x: 0.0, y: 0.0 }) -> bool => label.with_cstring((c_label) => unsafe { c_selectable_ex(c_label, selected, flags, size) })

/// `ImGui::Selectable` — "bool* p_selected" point to the selection state (read-write), as a convenient helper.
pub let selectable_bool_ptr = (label: string, p_selected: mut bool, flags: i32 = 0, size: Vec2 = Vec2 { x: 0.0, y: 0.0 }) -> bool => {
  let c_p_selected = unsafe { &mut p_selected }
  label.with_cstring((c_label) => unsafe { c_selectable_bool_ptr_ex(c_label, c_p_selected, flags, size) })
}

/// `ImGui::BeginMultiSelect`.
pub let begin_multi_select = (flags: i32, selection_size: i32 = -1, items_count: i32 = -1) -> MultiSelectIO => unsafe { c_begin_multi_select_ex(flags, selection_size, items_count) }

/// `ImGui::EndMultiSelect`.
pub let end_multi_select = () -> MultiSelectIO => unsafe { c_end_multi_select() }

/// `ImGui::SetNextItemSelectionUserData`.
pub let set_next_item_selection_user_data = (selection_user_data: i64) -> void => unsafe { c_set_next_item_selection_user_data(selection_user_data) }

/// `ImGui::IsItemToggledSelection` — Was the last item selection state toggled? Useful if you need the per-item information _before_ reaching EndMultiSelect(). We only returns toggle _event_ in order to handle clipping correctly.
pub let is_item_toggled_selection = () -> bool => unsafe { c_is_item_toggled_selection() }

/// `ImGui::BeginListBox` — open a framed scrolling region
pub let begin_list_box = (label: string, size: Vec2 = Vec2 { x: 0.0, y: 0.0 }) -> bool => label.with_cstring((c_label) => unsafe { c_begin_list_box(c_label, size) })

/// `ImGui::EndListBox` — only call EndListBox() if BeginListBox() returned true!
pub let end_list_box = () -> void => unsafe { c_end_list_box() }

/// `ImGui::BeginMenuBar` — append to menu-bar of current window (requires ImGuiWindowFlags_MenuBar flag set on parent window).
pub let begin_menu_bar = () -> bool => unsafe { c_begin_menu_bar() }

/// `ImGui::EndMenuBar` — only call EndMenuBar() if BeginMenuBar() returns true!
pub let end_menu_bar = () -> void => unsafe { c_end_menu_bar() }

/// `ImGui::BeginMainMenuBar` — create and append to a full screen menu-bar.
pub let begin_main_menu_bar = () -> bool => unsafe { c_begin_main_menu_bar() }

/// `ImGui::EndMainMenuBar` — only call EndMainMenuBar() if BeginMainMenuBar() returns true!
pub let end_main_menu_bar = () -> void => unsafe { c_end_main_menu_bar() }

/// `ImGui::BeginMenu` — create a sub-menu entry. only call EndMenu() if this returns true!
pub let begin_menu = (label: string, enabled: bool = true) -> bool => label.with_cstring((c_label) => unsafe { c_begin_menu_ex(c_label, enabled) })

/// `ImGui::EndMenu` — only call EndMenu() if BeginMenu() returns true!
pub let end_menu = () -> void => unsafe { c_end_menu() }

/// `ImGui::MenuItem` — return true when activated.
pub let menu_item = (label: string, shortcut: Maybe<string> = None, selected: bool = false, enabled: bool = true) -> bool => label.with_cstring((c_label) => with_maybe_cstring(shortcut, (c_shortcut) => unsafe { c_menu_item_ex(c_label, c_shortcut, selected, enabled) }))

/// `ImGui::MenuItem` — return true when activated + toggle (*p_selected) if p_selected != NULL
pub let menu_item_bool_ptr = (label: string, shortcut: string, p_selected: mut bool, enabled: bool = true) -> bool => {
  let c_p_selected = unsafe { &mut p_selected }
  label.with_cstring((c_label) => shortcut.with_cstring((c_shortcut) => unsafe { c_menu_item_bool_ptr(c_label, c_shortcut, c_p_selected, enabled) }))
}

/// `ImGui::BeginTooltip` — begin/append a tooltip window.
pub let begin_tooltip = () -> bool => unsafe { c_begin_tooltip() }

/// `ImGui::EndTooltip` — only call EndTooltip() if BeginTooltip()/BeginItemTooltip() returns true!
pub let end_tooltip = () -> void => unsafe { c_end_tooltip() }

/// `ImGui::SetTooltip` — set a text-only tooltip. Often used after a ImGui::IsItemHovered() check. Override any previous call to SetTooltip().
pub let set_tooltip = (text: string) -> void => text.with_cstring((c_text) => unsafe { c_set_tooltip_unformatted(c_text) })

/// `ImGui::BeginItemTooltip` — begin/append a tooltip window if preceding item was hovered.
pub let begin_item_tooltip = () -> bool => unsafe { c_begin_item_tooltip() }

/// `ImGui::SetItemTooltip` — set a text-only tooltip if preceding item was hovered. override any previous call to SetTooltip().
pub let set_item_tooltip = (text: string) -> void => text.with_cstring((c_text) => unsafe { c_set_item_tooltip_unformatted(c_text) })

/// `ImGui::BeginPopup` — return true if the popup is open, and you can start outputting to it.
pub let begin_popup = (str_id: string, flags: i32 = 0) -> bool => str_id.with_cstring((c_str_id) => unsafe { c_begin_popup(c_str_id, flags) })

/// `ImGui::BeginPopupModal` — return true if the modal is open, and you can start outputting to it.
pub let begin_popup_modal = (name: string, flags: i32 = 0) -> bool => name.with_cstring((c_name) => unsafe { c_begin_popup_modal(c_name, nullptr, flags) })

/// `ImGui::BeginPopupModal` — return true if the modal is open, and you can start outputting to it.
pub let begin_popup_modal_closable = (name: string, open: mut bool, flags: i32 = 0) -> bool => {
  let c_open = unsafe { &mut open }
  name.with_cstring((c_name) => unsafe { c_begin_popup_modal(c_name, c_open, flags) })
}

/// `ImGui::EndPopup` — only call EndPopup() if BeginPopupXXX() returns true!
pub let end_popup = () -> void => unsafe { c_end_popup() }

/// `ImGui::OpenPopup` — call to mark popup as open (don't call every frame!).
pub let open_popup = (str_id: string, popup_flags: i32 = 0) -> bool => str_id.with_cstring((c_str_id) => unsafe { c_open_popup(c_str_id, popup_flags) })

/// `ImGui::OpenPopup` — id overload to facilitate calling from nested stacks
pub let open_popup_id = (id: u32, popup_flags: i32 = 0) -> bool => unsafe { c_open_popup_id(id, popup_flags) }

/// `ImGui::OpenPopupOnItemClick` — helper to open popup when clicked on last item. Default to ImGuiPopupFlags_MouseButtonRight == 1. (note: actually triggers on the mouse _released_ event to be consistent with popup behaviors)
pub let open_popup_on_item_click = (str_id: Maybe<string> = None, popup_flags: i32 = 0) -> bool => with_maybe_cstring(str_id, (c_str_id) => unsafe { c_open_popup_on_item_click(c_str_id, popup_flags) })

/// `ImGui::CloseCurrentPopup` — manually close the popup we have begin-ed into.
pub let close_current_popup = () -> void => unsafe { c_close_current_popup() }

/// `ImGui::BeginPopupContextItem` — open+begin popup when clicked on last item. Use str_id==NULL to associate the popup to previous item. If you want to use that on a non-interactive item such as Text() you need to pass in an explicit ID here. read comments in .cpp!
pub let begin_popup_context_item = (str_id: Maybe<string> = None, popup_flags: i32 = 0) -> bool => with_maybe_cstring(str_id, (c_str_id) => unsafe { c_begin_popup_context_item_ex(c_str_id, popup_flags) })

/// `ImGui::BeginPopupContextWindow` — open+begin popup when clicked on current window.
pub let begin_popup_context_window = (str_id: Maybe<string> = None, popup_flags: i32 = 0) -> bool => with_maybe_cstring(str_id, (c_str_id) => unsafe { c_begin_popup_context_window_ex(c_str_id, popup_flags) })

/// `ImGui::BeginPopupContextVoid` — open+begin popup when clicked in void (where there are no windows).
pub let begin_popup_context_void = (str_id: Maybe<string> = None, popup_flags: i32 = 0) -> bool => with_maybe_cstring(str_id, (c_str_id) => unsafe { c_begin_popup_context_void_ex(c_str_id, popup_flags) })

/// `ImGui::IsPopupOpen` — return true if the popup is open.
pub let is_popup_open = (str_id: string, flags: i32 = 0) -> bool => str_id.with_cstring((c_str_id) => unsafe { c_is_popup_open(c_str_id, flags) })

/// `ImGui::BeginTable`.
pub let begin_table = (str_id: string, columns: i32, flags: i32 = 0, outer_size: Vec2 = Vec2 { x: 0.0, y: 0.0 }, inner_width: f32 = 0.0) -> bool => str_id.with_cstring((c_str_id) => unsafe { c_begin_table_ex(c_str_id, columns, flags, outer_size, inner_width) })

/// `ImGui::EndTable` — only call EndTable() if BeginTable() returns true!
pub let end_table = () -> void => unsafe { c_end_table() }

/// `ImGui::TableNextRow` — append into the first cell of a new row. 'min_row_height' include the minimum top and bottom padding aka CellPadding.y * 2.0f.
pub let table_next_row = (row_flags: i32 = 0, min_row_height: f32 = 0.0) -> void => unsafe { c_table_next_row_ex(row_flags, min_row_height) }

/// `ImGui::TableNextColumn` — append into the next column (or first column of next row if currently in last column). Return true when column is visible.
pub let table_next_column = () -> bool => unsafe { c_table_next_column() }

/// `ImGui::TableSetColumnIndex` — append into the specified column. Return true when column is visible.
pub let table_set_column_index = (column_n: i32) -> bool => unsafe { c_table_set_column_index(column_n) }

/// `ImGui::TableSetupColumn`.
pub let table_setup_column = (label: string, flags: i32 = 0, init_width_or_weight: f32 = 0.0, user_data: u32 = 0) -> void => label.with_cstring((c_label) => unsafe { c_table_setup_column_ex(c_label, flags, init_width_or_weight, user_data) })

/// `ImGui::TableSetupScrollFreeze` — lock columns/rows so they stay visible when scrolled.
pub let table_setup_scroll_freeze = (cols: i32, rows: i32) -> void => unsafe { c_table_setup_scroll_freeze(cols, rows) }

/// `ImGui::TableHeader` — submit one header cell manually (rarely used)
pub let table_header = (label: string) -> void => label.with_cstring((c_label) => unsafe { c_table_header(c_label) })

/// `ImGui::TableHeadersRow` — submit a row with headers cells based on data provided to TableSetupColumn() + submit context menu
pub let table_headers_row = () -> void => unsafe { c_table_headers_row() }

/// `ImGui::TableAngledHeadersRow` — submit a row with angled headers for every column with the ImGuiTableColumnFlags_AngledHeader flag. MUST BE FIRST ROW.
pub let table_angled_headers_row = () -> void => unsafe { c_table_angled_headers_row() }

/// `ImGui::TableGetSortSpecs` — get latest sort specs for the table (NULL if not sorting).  Lifetime: don't hold on this pointer over multiple frames or past any subsequent call to BeginTable().
pub let table_get_sort_specs = () -> TableSortSpecs => unsafe { c_table_get_sort_specs() }

/// `ImGui::TableGetColumnCount` — return number of columns (value passed to BeginTable)
pub let table_get_column_count = () -> i32 => unsafe { c_table_get_column_count() }

/// `ImGui::TableGetColumnIndex` — return current column index.
pub let table_get_column_index = () -> i32 => unsafe { c_table_get_column_index() }

/// `ImGui::TableGetRowIndex` — return current row index (header rows are accounted for)
pub let table_get_row_index = () -> i32 => unsafe { c_table_get_row_index() }

/// `ImGui::TableGetColumnName` — return "" if column didn't have a name declared by TableSetupColumn(). Pass -1 to use current column.
pub let table_get_column_name = (column_n: i32 = -1) -> string => {
  from_cstring(unsafe { c_table_get_column_name(column_n) })
}

/// `ImGui::TableGetColumnFlags` — return column flags so you can query their Enabled/Visible/Sorted/Hovered status flags. Pass -1 to use current column.
pub let table_get_column_flags = (column_n: i32 = -1) -> i32 => unsafe { c_table_get_column_flags(column_n) }

/// `ImGui::TableSetColumnEnabled` — change user accessible enabled/disabled state of a column. Set to false to hide the column. User can use the context menu to change this themselves (right-click in headers, or right-click in columns body with ImGuiTableFlags_ContextMenuInBody)
pub let table_set_column_enabled = (column_n: i32, v: bool) -> void => unsafe { c_table_set_column_enabled(column_n, v) }

/// `ImGui::TableGetHoveredColumn` — return hovered column. return -1 when table is not hovered. return columns_count if the unused space at the right of visible columns is hovered. Can also use (TableGetColumnFlags() & ImGuiTableColumnFlags_IsHovered) instead.
pub let table_get_hovered_column = () -> i32 => unsafe { c_table_get_hovered_column() }

/// `ImGui::TableSetBgColor` — change the color of a cell, row, or column. See ImGuiTableBgTarget_ flags for details.
pub let table_set_bg_color = (target: i32, color: u32, column_n: i32 = -1) -> void => unsafe { c_table_set_bg_color(target, color, column_n) }

/// `ImGui::Columns`.
pub let columns = (count: i32 = 1, id: Maybe<string> = None, borders: bool = true) -> void => with_maybe_cstring(id, (c_id) => unsafe { c_columns_ex(count, c_id, borders) })

/// `ImGui::NextColumn` — next column, defaults to current row or next row if the current row is finished
pub let next_column = () -> void => unsafe { c_next_column() }

/// `ImGui::GetColumnIndex` — get current column index
pub let get_column_index = () -> i32 => unsafe { c_get_column_index() }

/// `ImGui::GetColumnWidth` — get column width (in pixels). pass -1 to use current column
pub let get_column_width = (column_index: i32 = -1) -> f32 => unsafe { c_get_column_width(column_index) }

/// `ImGui::SetColumnWidth` — set column width (in pixels). pass -1 to use current column
pub let set_column_width = (column_index: i32, width: f32) -> void => unsafe { c_set_column_width(column_index, width) }

/// `ImGui::GetColumnOffset` — get position of column line (in pixels, from the left side of the contents region). pass -1 to use current column, otherwise 0..GetColumnsCount() inclusive. column 0 is typically 0.0f
pub let get_column_offset = (column_index: i32 = -1) -> f32 => unsafe { c_get_column_offset(column_index) }

/// `ImGui::SetColumnOffset` — set position of column line (in pixels, from the left side of the contents region). pass -1 to use current column
pub let set_column_offset = (column_index: i32, offset_x: f32) -> void => unsafe { c_set_column_offset(column_index, offset_x) }

/// `ImGui::GetColumnsCount`.
