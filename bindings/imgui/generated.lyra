/// `ImGui::Begin`.
pub let begin = (name: string, flags: i32 = 0) -> bool => name.with_cstring((c_name) => unsafe { c_begin(c_name, nullptr, flags) })

/// `ImGui::Begin`.
pub let begin_closable = (name: string, open: mut bool, flags: i32 = 0) -> bool => {
  let c_open = unsafe { &mut open }
  name.with_cstring((c_name) => unsafe { c_begin(c_name, c_open, flags) })
}

