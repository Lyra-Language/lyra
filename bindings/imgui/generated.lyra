/// `ImGui::SetScrollHereY` — adjust scrolling amount to make current cursor position visible. center_y_ratio=0.0: top, 0.5: center, 1.0: bottom. When using to make a "default/current item" visible, consider using SetItemDefaultFocus() instead.
pub let set_scroll_here_y = (center_y_ratio: f32 = 0.5) -> void => unsafe { c_set_scroll_here_y(center_y_ratio) }

