/// `ImGui::TabItemButton` — create a Tab behaving like a button. return true when clicked. cannot be selected in the tab bar.
pub let tab_item_button = (label: string, flags: i32 = 0) -> bool => label.with_cstring((c_label) => unsafe { c_tab_item_button(c_label, flags) })

/// `ImGui::SetTabItemClosed` — notify TabBar or Docking system of a closed tab/window ahead (useful to reduce visual flicker on reorderable tab bars). For tab-bar: call after BeginTabBar() and before Tab submissions. Otherwise call with a window name.
pub let set_tab_item_closed = (tab_or_docked_window_label: string) -> void => tab_or_docked_window_label.with_cstring((c_tab_or_docked_window_label) => unsafe { c_set_tab_item_closed(c_tab_or_docked_window_label) })

/// `ImGui::DockSpace`.
pub let dock_space = (dockspace_id: u32, size: Vec2 = Vec2 { x: 0.0, y: 0.0 }, flags: i32 = 0) -> u32 => unsafe { c_dock_space_ex(dockspace_id, size, flags, WindowClass(nullptr)) }

/// `ImGui::DockSpaceOverViewport`.
pub let dock_space_over_viewport = (dockspace_id: u32 = 0, flags: i32 = 0) -> u32 => unsafe { c_dock_space_over_viewport_ex(dockspace_id, Viewport(nullptr), flags, WindowClass(nullptr)) }

/// `ImGui::SetNextWindowDockID` — set next window dock id
pub let set_next_window_dock_id = (dock_id: u32, cond: i32 = 0) -> void => unsafe { c_set_next_window_dock_id(dock_id, cond) }

/// `ImGui::SetNextWindowClass` — set next window class (control docking compatibility + provide hints to platform backend via custom viewport flags and platform parent/child relationship)
pub let set_next_window_class = (window_class: WindowClass) -> void => unsafe { c_set_next_window_class(window_class) }

/// `ImGui::GetWindowDockID` — get dock id of current window, or 0 if not associated to any docking node.
pub let get_window_dock_id = () -> u32 => unsafe { c_get_window_dock_id() }

/// `ImGui::IsWindowDocked` — is current window docked into another window?
pub let is_window_docked = () -> bool => unsafe { c_is_window_docked() }

/// `ImGui::LogToTTY` — start logging to tty (stdout)
pub let log_to_tty = (auto_open_depth: i32 = -1) -> void => unsafe { c_log_to_tty(auto_open_depth) }

/// `ImGui::LogToFile` — start logging to file
pub let log_to_file = (auto_open_depth: i32 = -1, filename: Maybe<string> = None) -> void => with_maybe_cstring(filename, (c_filename) => unsafe { c_log_to_file(auto_open_depth, c_filename) })

/// `ImGui::LogToClipboard` — start logging to OS clipboard
pub let log_to_clipboard = (auto_open_depth: i32 = -1) -> void => unsafe { c_log_to_clipboard(auto_open_depth) }

/// `ImGui::LogFinish` — stop logging (close file, etc.)
pub let log_finish = () -> void => unsafe { c_log_finish() }

/// `ImGui::LogButtons` — helper to display buttons for logging to tty/file/clipboard
pub let log_buttons = () -> void => unsafe { c_log_buttons() }

/// `ImGui::LogText` — pass text data straight to log (without being displayed)
pub let log_text = (text: string) -> void => text.with_cstring((c_text) => unsafe { c_log_text_unformatted(c_text) })

/// `ImGui::BeginDragDropSource` — call after submitting an item which may be dragged. when this return true, you can call SetDragDropPayload() + EndDragDropSource()
pub let begin_drag_drop_source = (flags: i32 = 0) -> bool => unsafe { c_begin_drag_drop_source(flags) }

/// `ImGui::EndDragDropSource` — only call EndDragDropSource() if BeginDragDropSource() returns true!
pub let end_drag_drop_source = () -> void => unsafe { c_end_drag_drop_source() }

/// `ImGui::BeginDragDropTarget` — call after submitting an item that may receive a payload. If this returns true, you can call AcceptDragDropPayload() + EndDragDropTarget()
pub let begin_drag_drop_target = () -> bool => unsafe { c_begin_drag_drop_target() }

/// `ImGui::AcceptDragDropPayload` — accept contents of a given type. If ImGuiDragDropFlags_AcceptBeforeDelivery is set you can peek into the payload before the mouse button is released.
pub let accept_drag_drop_payload = (type_: string, flags: i32 = 0) -> Payload => type_.with_cstring((c_type_) => unsafe { c_accept_drag_drop_payload(c_type_, flags) })

/// `ImGui::EndDragDropTarget` — only call EndDragDropTarget() if BeginDragDropTarget() returns true!
pub let end_drag_drop_target = () -> void => unsafe { c_end_drag_drop_target() }

/// `ImGui::GetDragDropPayload` — peek directly into the current payload from anywhere. returns NULL when drag and drop is finished or inactive. use ImGuiPayload::IsDataType() to test for the payload type.
pub let get_drag_drop_payload = () -> Payload => unsafe { c_get_drag_drop_payload() }

/// `ImGui::BeginDisabled`.
pub let begin_disabled = (disabled: bool = true) -> void => unsafe { c_begin_disabled(disabled) }

/// `ImGui::EndDisabled`.
pub let end_disabled = () -> void => unsafe { c_end_disabled() }

/// `ImGui::PushClipRect`.
pub let push_clip_rect = (clip_rect_min: Vec2, clip_rect_max: Vec2, intersect_with_current_clip_rect: bool) -> void => unsafe { c_push_clip_rect(clip_rect_min, clip_rect_max, intersect_with_current_clip_rect) }

/// `ImGui::PopClipRect`.
pub let pop_clip_rect = () -> void => unsafe { c_pop_clip_rect() }

/// `ImGui::SetItemDefaultFocus` — make last item the default focused item of a newly appearing window.
pub let set_item_default_focus = () -> void => unsafe { c_set_item_default_focus() }

/// `ImGui::SetKeyboardFocusHere` — focus keyboard on the next widget. Use positive 'offset' to access sub components of a multiple component widget. Use -1 to access previous widget.
pub let set_keyboard_focus_here = (offset: i32 = 0) -> void => unsafe { c_set_keyboard_focus_here_ex(offset) }

/// `ImGui::SetNavCursorVisible` — alter visibility of keyboard/gamepad cursor. by default: show when using an arrow key, hide when clicking with mouse.
pub let set_nav_cursor_visible = (visible: bool) -> void => unsafe { c_set_nav_cursor_visible(visible) }

/// `ImGui::SetNextItemAllowOverlap` — allow next item to be overlapped by a subsequent item. Typically useful with InvisibleButton(), Selectable(), TreeNode() covering an area where subsequent items may need to be added. Note that both Selectable() and TreeNode() have dedicated flags doing this.
pub let set_next_item_allow_overlap = () -> void => unsafe { c_set_next_item_allow_overlap() }

/// `ImGui::IsItemHovered` — is the last item hovered? (and usable, aka not blocked by a popup, etc.). See ImGuiHoveredFlags for more options.
pub let is_item_hovered = (flags: i32 = 0) -> bool => unsafe { c_is_item_hovered(flags) }

/// `ImGui::IsItemActive` — is the last item active? (e.g. button being held, text field being edited. This will continuously return true while holding mouse button on an item. Items that don't interact will always return false)
pub let is_item_active = () -> bool => unsafe { c_is_item_active() }

/// `ImGui::IsItemFocused` — is the last item focused for keyboard/gamepad navigation?
pub let is_item_focused = () -> bool => unsafe { c_is_item_focused() }

/// `ImGui::IsItemClicked` — is the last item hovered and mouse clicked on? (**)  == IsMouseClicked(mouse_button) && IsItemHovered()Important. (**) this is NOT equivalent to the behavior of e.g. Button(). Read comments in function definition.
pub let is_item_clicked = (mouse_button: i32 = 0) -> bool => unsafe { c_is_item_clicked_ex(mouse_button) }

/// `ImGui::IsItemVisible` — is the last item visible? (items may be out of sight because of clipping/scrolling)
pub let is_item_visible = () -> bool => unsafe { c_is_item_visible() }

/// `ImGui::IsItemEdited` — did the last item modify its underlying value this frame? or was pressed? This is generally the same as the "bool" return value of many widgets.
pub let is_item_edited = () -> bool => unsafe { c_is_item_edited() }

/// `ImGui::IsItemActivated` — was the last item just made active (item was previously inactive).
pub let is_item_activated = () -> bool => unsafe { c_is_item_activated() }

/// `ImGui::IsItemDeactivated` — was the last item just made inactive (item was previously active). Useful for Undo/Redo patterns with widgets that require continuous editing.
pub let is_item_deactivated = () -> bool => unsafe { c_is_item_deactivated() }

/// `ImGui::IsItemDeactivatedAfterEdit` — was the last item just made inactive and made a value change when it was active? (e.g. Slider/Drag moved). Useful for Undo/Redo patterns with widgets that require continuous editing. Note that you may get false positives (some widgets such as Combo()/ListBox()/Selectable() will return true even when clicking an already selected item).
pub let is_item_deactivated_after_edit = () -> bool => unsafe { c_is_item_deactivated_after_edit() }

/// `ImGui::IsItemToggledOpen` — was the last item open state toggled? set by TreeNode().
pub let is_item_toggled_open = () -> bool => unsafe { c_is_item_toggled_open() }

/// `ImGui::IsAnyItemHovered` — is any item hovered?
pub let is_any_item_hovered = () -> bool => unsafe { c_is_any_item_hovered() }

/// `ImGui::IsAnyItemActive` — is any item active?
pub let is_any_item_active = () -> bool => unsafe { c_is_any_item_active() }

/// `ImGui::IsAnyItemFocused` — is any item focused?
pub let is_any_item_focused = () -> bool => unsafe { c_is_any_item_focused() }

/// `ImGui::GetItemID` — get ID of last item (~~ often same ImGui::GetID(label) beforehand)
pub let get_item_id = () -> u32 => unsafe { c_get_item_id() }

/// `ImGui::GetItemRectMin` — get upper-left bounding rectangle of the last item (screen space)
pub let get_item_rect_min = () -> Vec2 => unsafe { c_get_item_rect_min() }

/// `ImGui::GetItemRectMax` — get lower-right bounding rectangle of the last item (screen space)
pub let get_item_rect_max = () -> Vec2 => unsafe { c_get_item_rect_max() }

/// `ImGui::GetItemRectSize` — get size of last item
pub let get_item_rect_size = () -> Vec2 => unsafe { c_get_item_rect_size() }

/// `ImGui::GetItemFlags` — get generic flags of last item
pub let get_item_flags = () -> i32 => unsafe { c_get_item_flags() }

/// `ImGui::GetItemClickedCountWithSingleClickDelay` — [BETA] building block for disambiguation between single-click and double-click. Returns 1 on single-click but delayed by io.MouseSingleClickDelay after mouse release. Returns 2+ on double-click or repeated clicks.
pub let get_item_clicked_count_with_single_click_delay = (mouse_button: i32 = 0, delay: f32 = -1.0) -> i32 => unsafe { c_get_item_clicked_count_with_single_click_delay_ex(mouse_button, delay) }

/// `ImGui::GetMainViewport` — return primary/default viewport. This can never be NULL.
pub let get_main_viewport = () -> Viewport => unsafe { c_get_main_viewport() }

/// `ImGui::GetBackgroundDrawList` — get background draw list for the given viewport or viewport associated to the current window. this draw list will be the first rendering one. Useful to quickly draw shapes/text behind dear imgui contents.
pub let get_background_draw_list = () -> DrawList => unsafe { c_get_background_draw_list_ex(Viewport(nullptr)) }

/// `ImGui::GetForegroundDrawList` — get foreground draw list for the given viewport or viewport associated to the current window. this draw list will be the top-most rendered one. Useful to quickly draw shapes/text over dear imgui contents.
pub let get_foreground_draw_list = () -> DrawList => unsafe { c_get_foreground_draw_list_ex(Viewport(nullptr)) }

/// `ImGui::IsRectVisible` — test if rectangle (of given size, starting from cursor position) is visible / not clipped.
pub let is_rect_visible_by_size = (size: Vec2) -> bool => unsafe { c_is_rect_visible_by_size(size) }

/// `ImGui::IsRectVisible` — test if rectangle (in screen space) is visible / not clipped. to perform coarse clipping on user's side.
pub let is_rect_visible = (rect_min: Vec2, rect_max: Vec2) -> bool => unsafe { c_is_rect_visible(rect_min, rect_max) }

/// `ImGui::GetTime` — get global imgui time. incremented by io.DeltaTime every frame.
pub let get_time = () -> f64 => unsafe { c_get_time() }

/// `ImGui::GetFrameCount` — get global imgui frame count. incremented by 1 every frame.
pub let get_frame_count = () -> i32 => unsafe { c_get_frame_count() }

/// `ImGui::GetDrawListSharedData` — you may use this when creating your own ImDrawList instances.
pub let get_draw_list_shared_data = () -> DrawListSharedData => unsafe { c_get_draw_list_shared_data() }

/// `ImGui::GetStyleColorName` — get a string corresponding to the enum value (for display, saving, etc.).
pub let get_style_color_name = (idx: i32) -> string => {
  from_cstring(unsafe { c_get_style_color_name(idx) })
}

/// `ImGui::SetStateStorage` — replace current window storage with our own (if you want to manipulate it yourself, typically clear subsection of it)
pub let set_state_storage = (storage: Storage) -> void => unsafe { c_set_state_storage(storage) }

/// `ImGui::GetStateStorage`.
pub let get_state_storage = () -> Storage => unsafe { c_get_state_storage() }

/// `ImGui::CalcTextSize`.
pub let calc_text_size = (text: string, hide_text_after_double_hash: bool = false, wrap_width: f32 = -1.0) -> Vec2 => text.with_cstring((c_text) => unsafe { c_calc_text_size_ex(c_text, nullptr, hide_text_after_double_hash, wrap_width) })

/// `ImGui::ColorConvertU32ToFloat4`.
pub let color_convert_u32_to_float4 = (in_: u32) -> Vec4 => unsafe { c_color_convert_u32_to_float4(in_) }

/// `ImGui::ColorConvertFloat4ToU32`.
pub let color_convert_float4_to_u32 = (in_: Vec4) -> u32 => unsafe { c_color_convert_float4_to_u32(in_) }

/// `ImGui::ColorConvertRGBtoHSV`.
pub let color_convert_rgb_to_hsv = (r: f32, g: f32, b: f32, out_h: mut f32, out_s: mut f32, out_v: mut f32) -> void => {
  let c_out_h = unsafe { &mut out_h }
  let c_out_s = unsafe { &mut out_s }
  let c_out_v = unsafe { &mut out_v }
  unsafe { c_color_convert_rgb_to_hsv(r, g, b, c_out_h, c_out_s, c_out_v) }
}

/// `ImGui::ColorConvertHSVtoRGB`.
pub let color_convert_hsv_to_rgb = (h: f32, s: f32, v: f32, out_r: mut f32, out_g: mut f32, out_b: mut f32) -> void => {
  let c_out_r = unsafe { &mut out_r }
  let c_out_g = unsafe { &mut out_g }
  let c_out_b = unsafe { &mut out_b }
  unsafe { c_color_convert_hsv_to_rgb(h, s, v, c_out_r, c_out_g, c_out_b) }
}

/// `ImGui::IsKeyDown` — is key being held.
pub let is_key_down = (key: i32) -> bool => unsafe { c_is_key_down(key) }

/// `ImGui::IsKeyPressed` — was key pressed (went from !Down to Down)? Repeat rate uses io.KeyRepeatDelay / KeyRepeatRate.
pub let is_key_pressed = (key: i32, repeat: bool = true) -> bool => unsafe { c_is_key_pressed_ex(key, repeat) }

/// `ImGui::IsKeyReleased` — was key released (went from Down to !Down)?
pub let is_key_released = (key: i32) -> bool => unsafe { c_is_key_released(key) }

/// `ImGui::IsKeyChordPressed` — was key chord (mods + key) pressed, e.g. you can pass 'ImGuiMod_Ctrl | ImGuiKey_S' as a key-chord. This doesn't do any routing or focus check, please consider using Shortcut() function instead.
pub let is_key_chord_pressed = (key_chord: i32) -> bool => unsafe { c_is_key_chord_pressed(key_chord) }

/// `ImGui::GetKeyPressedAmount` — uses provided repeat rate/delay. return a count, most often 0 or 1 but might be >1 if RepeatRate is small enough that DeltaTime > RepeatRate
pub let get_key_pressed_amount = (key: i32, repeat_delay: f32, rate: f32) -> i32 => unsafe { c_get_key_pressed_amount(key, repeat_delay, rate) }

/// `ImGui::GetKeyName` — [DEBUG] returns English name of the key. Those names are provided for debugging purpose and are not meant to be saved persistently nor compared.
pub let get_key_name = (key: i32) -> string => {
  from_cstring(unsafe { c_get_key_name(key) })
}

/// `ImGui::SetNextFrameWantCaptureKeyboard` — Override io.WantCaptureKeyboard flag next frame (said flag is left for your application to handle, typically when true it instructs your app to ignore inputs). e.g. force capture keyboard when your widget is being hovered. This is equivalent to setting "io.WantCaptureKeyboard = want_capture_keyboard"; after the next NewFrame() call.
pub let set_next_frame_want_capture_keyboard = (want_capture_keyboard: bool) -> void => unsafe { c_set_next_frame_want_capture_keyboard(want_capture_keyboard) }

/// `ImGui::Shortcut`.
pub let shortcut = (key_chord: i32, flags: i32 = 0) -> bool => unsafe { c_shortcut(key_chord, flags) }

/// `ImGui::SetNextItemShortcut`.
pub let set_next_item_shortcut = (key_chord: i32, flags: i32 = 0) -> void => unsafe { c_set_next_item_shortcut(key_chord, flags) }

/// `ImGui::SetItemKeyOwner` — Set key owner to last item ID if it is hovered or active. Return true when ownership has been set. Roughly equivalent to 'if (TestKeyOwner(key, GetItemID()) && (IsItemHovered() || IsItemActive())) { SetKeyOwner(key, GetItemID());'.
pub let set_item_key_owner = (key: i32) -> bool => unsafe { c_set_item_key_owner(key) }

/// `ImGui::IsMouseDown` — is mouse button held?
pub let is_mouse_down = (button: i32) -> bool => unsafe { c_is_mouse_down(button) }

/// `ImGui::IsMouseClicked` — did mouse button clicked? (went from !Down to Down). Same as GetMouseClickedCount() == 1.
pub let is_mouse_clicked = (button: i32, repeat: bool = false) -> bool => unsafe { c_is_mouse_clicked_ex(button, repeat) }

/// `ImGui::IsMouseReleased` — did mouse button released? (went from Down to !Down)
pub let is_mouse_released = (button: i32) -> bool => unsafe { c_is_mouse_released(button) }

/// `ImGui::IsMouseDoubleClicked` — did mouse button double-clicked? Same as GetMouseClickedCount() == 2. (note that a double-click will also report IsMouseClicked() == true)
pub let is_mouse_double_clicked = (button: i32) -> bool => unsafe { c_is_mouse_double_clicked(button) }

/// `ImGui::IsMouseReleasedWithDelay` — delayed mouse release. Use sparingly. Prefer higher-level helper GetItemClickedCountWithSingleClickDelay(). Generally used with 'delay >= io.MouseDoubleClickTime' + combined with a 'io.MouseClickedLastCount==1' test.
pub let is_mouse_released_with_delay = (button: i32, delay: f32 = -1.0) -> bool => unsafe { c_is_mouse_released_with_delay_ex(button, delay) }

/// `ImGui::GetMouseClickedCount` — return the number of successive mouse-clicks at the time where a click happen (otherwise 0).
pub let get_mouse_clicked_count = (button: i32) -> i32 => unsafe { c_get_mouse_clicked_count(button) }

/// `ImGui::IsMouseHoveringRect` — is mouse hovering given bounding rect (in screen space). clipped by current clipping settings, but disregarding of other consideration of focus/window ordering/popup-block.
pub let is_mouse_hovering_rect = (r_min: Vec2, r_max: Vec2, clip: bool = true) -> bool => unsafe { c_is_mouse_hovering_rect_ex(r_min, r_max, clip) }

/// `ImGui::IsAnyMouseDown` — [WILL OBSOLETE] is any mouse button held? This was designed for backends, but prefer having backend maintain a mask of held mouse buttons, because upcoming input queue system will make this invalid.
pub let is_any_mouse_down = () -> bool => unsafe { c_is_any_mouse_down() }

/// `ImGui::GetMousePos` — shortcut to ImGui::GetIO().MousePos provided by user, to be consistent with other calls
pub let get_mouse_pos = () -> Vec2 => unsafe { c_get_mouse_pos() }

/// `ImGui::GetMousePosOnOpeningCurrentPopup` — retrieve mouse position at the time of opening popup we have BeginPopup() into (helper to avoid user backing that value themselves)
pub let get_mouse_pos_on_opening_current_popup = () -> Vec2 => unsafe { c_get_mouse_pos_on_opening_current_popup() }

/// `ImGui::IsMouseDragging` — is mouse dragging? (uses io.MouseDraggingThreshold if lock_threshold < 0.0f)
pub let is_mouse_dragging = (button: i32, lock_threshold: f32 = -1.0) -> bool => unsafe { c_is_mouse_dragging(button, lock_threshold) }

/// `ImGui::GetMouseDragDelta` — return the delta from the initial clicking position while the mouse button is pressed or was just released. This is locked and return 0.0f until the mouse moves past a distance threshold at least once (uses io.MouseDraggingThreshold if lock_threshold < 0.0f)
pub let get_mouse_drag_delta = (button: i32 = 0, lock_threshold: f32 = -1.0) -> Vec2 => unsafe { c_get_mouse_drag_delta(button, lock_threshold) }

/// `ImGui::ResetMouseDragDelta`.
pub let reset_mouse_drag_delta = (button: i32 = 0) -> void => unsafe { c_reset_mouse_drag_delta_ex(button) }

/// `ImGui::GetMouseCursor` — get desired mouse cursor shape. Important: reset in ImGui::NewFrame(), this is updated during the frame. valid before Render(). If you use software rendering by setting io.MouseDrawCursor ImGui will render those for you
pub let get_mouse_cursor = () -> i32 => unsafe { c_get_mouse_cursor() }

/// `ImGui::SetMouseCursor` — set desired mouse cursor shape
pub let set_mouse_cursor = (cursor_type: i32) -> void => unsafe { c_set_mouse_cursor(cursor_type) }

/// `ImGui::SetNextFrameWantCaptureMouse` — Override io.WantCaptureMouse flag next frame (said flag is left for your application to handle, typical when true it instructs your app to ignore inputs). This is equivalent to setting "io.WantCaptureMouse = want_capture_mouse;" after the next NewFrame() call.
pub let set_next_frame_want_capture_mouse = (want_capture_mouse: bool) -> void => unsafe { c_set_next_frame_want_capture_mouse(want_capture_mouse) }

/// `ImGui::GetClipboardText`.
pub let get_clipboard_text = () -> string => {
  from_cstring(unsafe { c_get_clipboard_text() })
}

/// `ImGui::SetClipboardText`.
pub let set_clipboard_text = (text: string) -> void => text.with_cstring((c_text) => unsafe { c_set_clipboard_text(c_text) })

/// `ImGui::LoadIniSettingsFromDisk` — call after CreateContext() and before the first call to NewFrame(). NewFrame() automatically calls LoadIniSettingsFromDisk(io.IniFilename).
pub let load_ini_settings_from_disk = (ini_filename: string) -> void => ini_filename.with_cstring((c_ini_filename) => unsafe { c_load_ini_settings_from_disk(c_ini_filename) })

/// `ImGui::LoadIniSettingsFromMemory` — call after CreateContext() and before the first call to NewFrame() to provide .ini data from your own data source.
pub let load_ini_settings_from_memory = (ini_data: string, ini_size: u64 = 0) -> void => ini_data.with_cstring((c_ini_data) => unsafe { c_load_ini_settings_from_memory(c_ini_data, ini_size) })

/// `ImGui::SaveIniSettingsToDisk` — this is automatically called (if io.IniFilename is not empty) a few seconds after any modification that should be reflected in the .ini file (and also by DestroyContext).
pub let save_ini_settings_to_disk = (ini_filename: string) -> void => ini_filename.with_cstring((c_ini_filename) => unsafe { c_save_ini_settings_to_disk(c_ini_filename) })

/// `ImGui::SaveIniSettingsToMemory` — return a zero-terminated string with the .ini data which you can save by your own mean. call when io.WantSaveIniSettings is set, then save data by your own mean and clear io.WantSaveIniSettings.
pub let save_ini_settings_to_memory = (out_ini_size: mut u64) -> string => {
  let c_out_ini_size = unsafe { &mut out_ini_size }
  from_cstring(unsafe { c_save_ini_settings_to_memory(c_out_ini_size) })
}

/// `ImGui::DebugTextEncoding`.
pub let debug_text_encoding = (text: string) -> void => text.with_cstring((c_text) => unsafe { c_debug_text_encoding(c_text) })

/// `ImGui::DebugFlashStyleColor`.
pub let debug_flash_style_color = (idx: i32) -> void => unsafe { c_debug_flash_style_color(idx) }

/// `ImGui::DebugStartItemPicker`.
pub let debug_start_item_picker = () -> void => unsafe { c_debug_start_item_picker() }

/// `ImGui::FindViewportByID` — this is a helper for backends.
pub let find_viewport_by_id = (viewport_id: u32) -> Viewport => unsafe { c_find_viewport_by_id(viewport_id) }

/// `ScaleAllSizes` — Scale all spacing/padding/thickness values. Do not scale fonts. See comments in definition. Consider not calling this if your initial scale factor if <1.0.
pub let scale_all_sizes = (self: Style, scale_factor: f32) -> void => unsafe { c_style_scale_all_sizes(self, scale_factor) }

/// `AddKeyEvent` — Queue a new key down/up event. Key should be "translated" (as in, generally ImGuiKey_A matches the key end-user would use to emit an 'A' character)
pub let add_key_event = (self: IO, key: i32, down: bool) -> void => unsafe { c_io_add_key_event(self, key, down) }

/// `AddKeyAnalogEvent` — Queue a new key down/up event for analog values (e.g. ImGuiKey_Gamepad_ values). Dead-zones should be handled by the backend.
pub let add_key_analog_event = (self: IO, key: i32, down: bool, v: f32) -> void => unsafe { c_io_add_key_analog_event(self, key, down, v) }

/// `AddMousePosEvent` — Queue a mouse position update. Use -FLT_MAX,-FLT_MAX to signify no mouse (e.g. app not focused and not hovered)
pub let add_mouse_pos_event = (self: IO, x: f32, y: f32) -> void => unsafe { c_io_add_mouse_pos_event(self, x, y) }

/// `AddMouseButtonEvent` — Queue a mouse button change
pub let add_mouse_button_event = (self: IO, button: i32, down: bool) -> void => unsafe { c_io_add_mouse_button_event(self, button, down) }

/// `AddMouseWheelEvent` — Queue a mouse wheel update. wheel_y<0: scroll down, wheel_y>0: scroll up, wheel_x<0: scroll right, wheel_x>0: scroll left.
pub let add_mouse_wheel_event = (self: IO, wheel_x: f32, wheel_y: f32) -> void => unsafe { c_io_add_mouse_wheel_event(self, wheel_x, wheel_y) }

/// `AddMouseSourceEvent` — Queue a mouse source change (Mouse/TouchScreen/Pen)
pub let add_mouse_source_event = (self: IO, source: i32) -> void => unsafe { c_io_add_mouse_source_event(self, source) }

/// `AddMouseViewportEvent` — Queue a mouse hovered viewport. Requires backend to set ImGuiBackendFlags_HasMouseHoveredViewport to call this (for multi-viewport support).
pub let add_mouse_viewport_event = (self: IO, id: u32) -> void => unsafe { c_io_add_mouse_viewport_event(self, id) }

/// `AddFocusEvent` — Queue a gain/loss of focus for the application (generally based on OS/platform focus of your window)
pub let add_focus_event = (self: IO, focused: bool) -> void => unsafe { c_io_add_focus_event(self, focused) }

/// `AddInputCharacter` — Queue a new character input
pub let add_input_character = (self: IO, c: u32) -> void => unsafe { c_io_add_input_character(self, c) }

/// `AddInputCharacterUTF16` — Queue a new character input from a UTF-16 character, it can be a surrogate
pub let add_input_character_utf16 = (self: IO, c: u16) -> void => unsafe { c_io_add_input_character_utf16(self, c) }

/// `AddInputCharactersUTF8` — Queue a new characters input from a UTF-8 string
pub let add_input_characters_utf8 = (self: IO, str: string) -> void => str.with_cstring((c_str) => unsafe { c_io_add_input_characters_utf8(self, c_str) })

/// `SetKeyEventNativeData` — [Optional] Specify index for legacy <1.87 IsKeyXXX() functions with native indices + specify native keycode, scancode.
pub let set_key_event_native_data = (self: IO, key: i32, native_keycode: i32, native_scancode: i32, native_legacy_index: i32 = -1) -> void => unsafe { c_io_set_key_event_native_data_ex(self, key, native_keycode, native_scancode, native_legacy_index) }

/// `SetAppAcceptingEvents` — Set master flag for accepting key/mouse/text events (default to true). Useful if you have native dialog boxes that are interrupting your application loop/refresh, and you want to disable events being queued while your app is frozen.
pub let set_app_accepting_events = (self: IO, accepting_events: bool) -> void => unsafe { c_io_set_app_accepting_events(self, accepting_events) }

/// `ClearEventsQueue` — Clear all incoming events.
pub let clear_events_queue = (self: IO) -> void => unsafe { c_io_clear_events_queue(self) }

/// `ClearInputKeys` — Clear current keyboard/gamepad state + current frame text input buffer. Equivalent to releasing all keys/buttons.
pub let clear_input_keys = (self: IO) -> void => unsafe { c_io_clear_input_keys(self) }

/// `ClearInputMouse` — Clear current mouse state.
pub let clear_input_mouse = (self: IO) -> void => unsafe { c_io_clear_input_mouse(self) }

/// `DeleteChars`.
pub let delete_chars = (self: InputTextCallbackData, pos: i32, bytes_count: i32) -> void => unsafe { c_input_text_callback_data_delete_chars(self, pos, bytes_count) }

/// `InsertChars`.
pub let insert_chars = (self: InputTextCallbackData, pos: i32, text: string) -> void => text.with_cstring((c_text) => unsafe { c_input_text_callback_data_insert_chars(self, pos, c_text, nullptr) })

/// `SelectAll`.
pub let select_all = (self: InputTextCallbackData) -> void => unsafe { c_input_text_callback_data_select_all(self) }

/// `SetSelection`.
pub let set_selection = (self: InputTextCallbackData, s: i32, e: i32) -> void => unsafe { c_input_text_callback_data_set_selection(self, s, e) }

/// `ClearSelection`.
pub let clear_selection = (self: InputTextCallbackData) -> void => unsafe { c_input_text_callback_data_clear_selection(self) }

/// `HasSelection`.
pub let has_selection = (self: InputTextCallbackData) -> bool => unsafe { c_input_text_callback_data_has_selection(self) }

/// `Clear`.
pub let clear = (self: Payload) -> void => unsafe { c_payload_clear(self) }

/// `IsDataType`.
pub let is_data_type = (self: Payload, type_: string) -> bool => type_.with_cstring((c_type_) => unsafe { c_payload_is_data_type(self, c_type_) })

/// `IsPreview`.
pub let is_preview = (self: Payload) -> bool => unsafe { c_payload_is_preview(self) }

/// `IsDelivery`.
pub let is_delivery = (self: Payload) -> bool => unsafe { c_payload_is_delivery(self) }

/// `empty`.
pub let text_range_empty = (self: TextFilterTextRange) -> bool => unsafe { c_text_filter_text_range_empty(self) }

/// `split`.
pub let text_range_split = (self: TextFilterTextRange, separator: i8, out: VectorTextRange) -> void => unsafe { c_text_filter_text_range_split(self, separator, out) }

/// `Draw` — Helper calling InputText+Build
pub let draw = (self: TextFilter, label: string = "Filter (inc,-exc)", width: f32 = 0.0) -> bool => label.with_cstring((c_label) => unsafe { c_text_filter_draw(self, c_label, width) })

/// `PassFilter`.
pub let pass_filter = (self: TextFilter, text: string) -> bool => text.with_cstring((c_text) => unsafe { c_text_filter_pass_filter(self, c_text, nullptr) })

/// `Build`.
pub let build = (self: TextFilter) -> void => unsafe { c_text_filter_build(self) }

/// `Clear`.
pub let clear = (self: TextFilter) -> void => unsafe { c_text_filter_clear(self) }

/// `IsActive`.
pub let is_active = (self: TextFilter) -> bool => unsafe { c_text_filter_is_active(self) }

/// `begin`.
pub let begin_text_buffer = (self: TextBuffer) -> string => {
  from_cstring(unsafe { c_text_buffer_begin(self) })
}

/// `end` — Buf is zero-terminated, so end() will point on the zero-terminator
pub let end_text_buffer = (self: TextBuffer) -> string => {
  from_cstring(unsafe { c_text_buffer_end(self) })
}

/// `size`.
pub let size = (self: TextBuffer) -> i32 => unsafe { c_text_buffer_size(self) }

/// `empty`.
pub let empty = (self: TextBuffer) -> bool => unsafe { c_text_buffer_empty(self) }

/// `clear`.
pub let clear = (self: TextBuffer) -> void => unsafe { c_text_buffer_clear(self) }

/// `resize` — Similar to resize(0) on ImVector: empty string but don't free buffer.
pub let resize = (self: TextBuffer, size: i32) -> void => unsafe { c_text_buffer_resize(self, size) }

/// `reserve`.
pub let reserve = (self: TextBuffer, capacity: i32) -> void => unsafe { c_text_buffer_reserve(self, capacity) }

/// `c_str`.
pub let c_str = (self: TextBuffer) -> string => {
  from_cstring(unsafe { c_text_buffer_c_str(self) })
}

/// `append`.
pub let append = (self: TextBuffer, str: string) -> void => str.with_cstring((c_str) => unsafe { c_text_buffer_append(self, c_str, nullptr) })

/// `Clear`.
pub let clear = (self: Storage) -> void => unsafe { c_storage_clear(self) }

/// `GetInt`.
pub let get_int = (self: Storage, key: u32, default_val: i32 = 0) -> i32 => unsafe { c_storage_get_int(self, key, default_val) }

/// `SetInt`.
pub let set_int = (self: Storage, key: u32, val: i32) -> void => unsafe { c_storage_set_int(self, key, val) }

/// `GetBool`.
pub let get_bool = (self: Storage, key: u32, default_val: bool = false) -> bool => unsafe { c_storage_get_bool(self, key, default_val) }

/// `SetBool`.
pub let set_bool = (self: Storage, key: u32, val: bool) -> void => unsafe { c_storage_set_bool(self, key, val) }

/// `GetFloat`.
pub let get_float = (self: Storage, key: u32, default_val: f32 = 0.0) -> f32 => unsafe { c_storage_get_float(self, key, default_val) }

/// `SetFloat`.
pub let set_float = (self: Storage, key: u32, val: f32) -> void => unsafe { c_storage_set_float(self, key, val) }

/// `GetIntRef`.
pub let get_int_ref = (self: Storage, key: u32, default_val: i32 = 0) -> ^mut i32 => unsafe { c_storage_get_int_ref(self, key, default_val) }

/// `GetBoolRef`.
pub let get_bool_ref = (self: Storage, key: u32, default_val: bool = false) -> ^mut bool => unsafe { c_storage_get_bool_ref(self, key, default_val) }

/// `GetFloatRef`.
pub let get_float_ref = (self: Storage, key: u32, default_val: f32 = 0.0) -> ^mut f32 => unsafe { c_storage_get_float_ref(self, key, default_val) }

/// `BuildSortByKey`.
pub let build_sort_by_key = (self: Storage) -> void => unsafe { c_storage_build_sort_by_key(self) }

/// `SetAllInt`.
pub let set_all_int = (self: Storage, val: i32) -> void => unsafe { c_storage_set_all_int(self, val) }

/// `Begin`.
pub let begin_list_clipper = (self: ListClipper, items_count: i32, items_height: f32 = -1.0) -> void => unsafe { c_list_clipper_begin(self, items_count, items_height) }

/// `End` — Automatically called on the last call of Step() that returns false.
pub let end_list_clipper = (self: ListClipper) -> void => unsafe { c_list_clipper_end(self) }

/// `Step` — Call until it returns false. The DisplayStart/DisplayEnd fields will be set and you can process/draw those items.
pub let step = (self: ListClipper) -> bool => unsafe { c_list_clipper_step(self) }

/// `IncludeItemByIndex`.
pub let include_item_by_index = (self: ListClipper, item_index: i32) -> void => unsafe { c_list_clipper_include_item_by_index(self, item_index) }

/// `IncludeItemsByIndex` — item_end is exclusive e.g. use (42, 42+1) to make item 42 never clipped.
pub let include_items_by_index = (self: ListClipper, item_begin: i32, item_end: i32) -> void => unsafe { c_list_clipper_include_items_by_index(self, item_begin, item_end) }

/// `SeekCursorForItem`.
pub let seek_cursor_for_item = (self: ListClipper, item_index: i32) -> void => unsafe { c_list_clipper_seek_cursor_for_item(self, item_index) }

/// `SetHSV`.
pub let set_hsv = (self: Color, h: f32, s: f32, v: f32, a: f32 = 1.0) -> void => unsafe { c_im_color_set_hsv(self, h, s, v, a) }

/// `ApplyRequests` — Apply selection requests coming from BeginMultiSelect() and EndMultiSelect() functions. It uses 'items_count' passed to BeginMultiSelect()
pub let apply_requests = (self: SelectionBasicStorage, ms_io: MultiSelectIO) -> void => unsafe { c_selection_basic_storage_apply_requests(self, ms_io) }

/// `Contains` — Query if an item id is in selection.
pub let contains = (self: SelectionBasicStorage, id: u32) -> bool => unsafe { c_selection_basic_storage_contains(self, id) }

/// `Clear` — Clear selection
pub let clear = (self: SelectionBasicStorage) -> void => unsafe { c_selection_basic_storage_clear(self) }

/// `Swap` — Swap two selections
pub let swap = (self: SelectionBasicStorage, r: SelectionBasicStorage) -> void => unsafe { c_selection_basic_storage_swap(self, r) }

/// `SetItemSelected` — Add/remove an item from selection (generally done by ApplyRequests() function)
pub let set_item_selected = (self: SelectionBasicStorage, id: u32, selected: bool) -> void => unsafe { c_selection_basic_storage_set_item_selected(self, id, selected) }

/// `GetStorageIdFromIndex` — Convert index to item id based on provided adapter.
pub let get_storage_id_from_index = (self: SelectionBasicStorage, idx: i32) -> u32 => unsafe { c_selection_basic_storage_get_storage_id_from_index(self, idx) }

/// `ApplyRequests` — Apply selection requests by using AdapterSetItemSelected() calls
pub let apply_requests = (self: SelectionExternalStorage, ms_io: MultiSelectIO) -> void => unsafe { c_selection_external_storage_apply_requests(self, ms_io) }

/// `GetTexID` — == (TexRef._TexData ? TexRef._TexData->TexID : TexRef._TexID)
pub let get_tex_id = (self: DrawCmd) -> u64 => unsafe { c_draw_cmd_get_tex_id(self) }

/// `Clear` — Do not clear Channels[] so our allocations are reused next frame
