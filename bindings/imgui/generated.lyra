/// `ImGui::GetWindowPos` — get current window position in screen space (IT IS UNLIKELY YOU EVER NEED TO USE THIS. Consider always using GetCursorScreenPos() and GetContentRegionAvail() instead)
pub let get_window_pos = () -> Vec2 => unsafe { c_get_window_pos() }

/// `ImGui::GetWindowSize` — get current window size (IT IS UNLIKELY YOU EVER NEED TO USE THIS. Consider always using GetCursorScreenPos() and GetContentRegionAvail() instead)
pub let get_window_size = () -> Vec2 => unsafe { c_get_window_size() }

/// `ImGui::GetWindowWidth` — get current window width (IT IS UNLIKELY YOU EVER NEED TO USE THIS). Shortcut for GetWindowSize().x.
pub let get_window_width = () -> f32 => unsafe { c_get_window_width() }

/// `ImGui::GetWindowHeight` — get current window height (IT IS UNLIKELY YOU EVER NEED TO USE THIS). Shortcut for GetWindowSize().y.
pub let get_window_height = () -> f32 => unsafe { c_get_window_height() }

/// `ImGui::GetWindowViewport` — get viewport currently associated to the current window.
pub let get_window_viewport = () -> Viewport => unsafe { c_get_window_viewport() }

/// `ImGui::SetNextWindowPos` — set next window position. call before Begin(). use pivot=(0.5f,0.5f) to center on given point, etc.
pub let set_next_window_pos = (pos: Vec2, cond: i32 = 0, pivot: Vec2 = Vec2 { x: 0.0, y: 0.0 }) -> void => unsafe { c_set_next_window_pos_ex(pos, cond, pivot) }

/// `ImGui::SetNextWindowSize` — set next window size. set axis to 0.0f to force an auto-fit on this axis. call before Begin()
pub let set_next_window_size = (size: Vec2, cond: i32 = 0) -> void => unsafe { c_set_next_window_size(size, cond) }

/// `ImGui::SetNextWindowContentSize` — set next window content size (~ scrollable client area, which enforce the range of scrollbars). Not including window decorations (title bar, menu bar, etc.) nor WindowPadding. set an axis to 0.0f to leave it automatic. call before Begin()
pub let set_next_window_content_size = (size: Vec2) -> void => unsafe { c_set_next_window_content_size(size) }

/// `ImGui::SetNextWindowCollapsed` — set next window collapsed state. call before Begin()
pub let set_next_window_collapsed = (collapsed: bool, cond: i32 = 0) -> void => unsafe { c_set_next_window_collapsed(collapsed, cond) }

/// `ImGui::SetNextWindowFocus` — set next window to be focused / top-most. call before Begin()
pub let set_next_window_focus = () -> void => unsafe { c_set_next_window_focus() }

/// `ImGui::SetNextWindowScroll` — set next window scrolling value (use < 0.0f to not affect a given axis).
pub let set_next_window_scroll = (scroll: Vec2) -> void => unsafe { c_set_next_window_scroll(scroll) }

/// `ImGui::SetNextWindowBgAlpha` — set next window background color alpha. helper to easily override the Alpha component of ImGuiCol_WindowBg/ChildBg/PopupBg. you may also use ImGuiWindowFlags_NoBackground.
pub let set_next_window_bg_alpha = (alpha: f32) -> void => unsafe { c_set_next_window_bg_alpha(alpha) }

/// `ImGui::SetNextWindowViewport` — set next window viewport
pub let set_next_window_viewport = (viewport_id: u32) -> void => unsafe { c_set_next_window_viewport(viewport_id) }

/// `ImGui::SetWindowPos` — (not recommended) set current window position - call within Begin()/End(). prefer using SetNextWindowPos(), as this may incur tearing and side-effects.
pub let set_window_pos = (pos: Vec2, cond: i32 = 0) -> void => unsafe { c_set_window_pos(pos, cond) }

/// `ImGui::SetWindowSize` — (not recommended) set current window size - call within Begin()/End(). set to ImVec2(0, 0) to force an auto-fit. prefer using SetNextWindowSize(), as this may incur tearing and minor side-effects.
pub let set_window_size = (size: Vec2, cond: i32 = 0) -> void => unsafe { c_set_window_size(size, cond) }

/// `ImGui::SetWindowCollapsed` — (not recommended) set current window collapsed state. prefer using SetNextWindowCollapsed().
pub let set_window_collapsed = (collapsed: bool, cond: i32 = 0) -> void => unsafe { c_set_window_collapsed(collapsed, cond) }

/// `ImGui::SetWindowFocus` — (not recommended) set current window to be focused / top-most. prefer using SetNextWindowFocus().
pub let set_window_focus = () -> void => unsafe { c_set_window_focus() }

/// `ImGui::SetWindowPos` — set named window position.
pub let set_window_pos_str = (name: string, pos: Vec2, cond: i32 = 0) -> void => name.with_cstring((c_name) => unsafe { c_set_window_pos_str(c_name, pos, cond) })

/// `ImGui::SetWindowSize` — set named window size. set axis to 0.0f to force an auto-fit on this axis.
pub let set_window_size_str = (name: string, size: Vec2, cond: i32 = 0) -> void => name.with_cstring((c_name) => unsafe { c_set_window_size_str(c_name, size, cond) })

/// `ImGui::SetWindowCollapsed` — set named window collapsed state
pub let set_window_collapsed_str = (name: string, collapsed: bool, cond: i32 = 0) -> void => name.with_cstring((c_name) => unsafe { c_set_window_collapsed_str(c_name, collapsed, cond) })

/// `ImGui::SetWindowFocus` — set named window to be focused / top-most. use NULL to remove focus.
pub let set_window_focus_str = (name: string) -> void => name.with_cstring((c_name) => unsafe { c_set_window_focus_str(c_name) })

