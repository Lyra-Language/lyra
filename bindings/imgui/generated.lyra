/// Set the variable if the object/window has no persistently saved data (no entry in .ini file)
pub const COND_FIRST_USE_EVER: i32 = 4

/// Set the variable if the object/window is appearing after being hidden/inactive (or the first time)
pub const COND_APPEARING: i32 = 8

pub const TABLE_FLAGS_NONE: i32 = 0

/// Enable resizing columns.
pub const TABLE_FLAGS_RESIZABLE: i32 = 1

/// Enable reordering columns in header row. (Need calling TableSetupColumn() + TableHeadersRow() to display headers, or using ImGuiTableFlags_ContextMenuInBody to access context-menu without headers).
pub const TABLE_FLAGS_REORDERABLE: i32 = 2

/// Enable hiding/disabling columns in context menu.
pub const TABLE_FLAGS_HIDEABLE: i32 = 4

/// Enable sorting. Call TableGetSortSpecs() to obtain sort specs. Also see ImGuiTableFlags_SortMulti and ImGuiTableFlags_SortTristate.
pub const TABLE_FLAGS_SORTABLE: i32 = 8

/// Disable persisting columns order, width, visibility and sort settings in the .ini file.
pub const TABLE_FLAGS_NO_SAVED_SETTINGS: i32 = 16

/// Right-click on columns body/contents will also display table context menu. By default it is available in TableHeadersRow().
pub const TABLE_FLAGS_CONTEXT_MENU_IN_BODY: i32 = 32

/// Set each RowBg color with ImGuiCol_TableRowBg or ImGuiCol_TableRowBgAlt (equivalent of calling TableSetBgColor with ImGuiTableBgFlags_RowBg0 on each row manually)
pub const TABLE_FLAGS_ROW_BG: i32 = 64

/// Draw horizontal borders between rows.
pub const TABLE_FLAGS_BORDERS_INNER_H: i32 = 128

/// Draw horizontal borders at the top and bottom.
pub const TABLE_FLAGS_BORDERS_OUTER_H: i32 = 256

/// Draw vertical borders between columns.
pub const TABLE_FLAGS_BORDERS_INNER_V: i32 = 512

/// Draw vertical borders on the left and right sides.
pub const TABLE_FLAGS_BORDERS_OUTER_V: i32 = 1024

/// Draw horizontal borders.
pub const TABLE_FLAGS_BORDERS_H: i32 = 384

/// Draw vertical borders.
pub const TABLE_FLAGS_BORDERS_V: i32 = 1536

/// Draw inner borders.
pub const TABLE_FLAGS_BORDERS_INNER: i32 = 640

/// Draw outer borders.
pub const TABLE_FLAGS_BORDERS_OUTER: i32 = 1280

/// Draw all borders.
pub const TABLE_FLAGS_BORDERS: i32 = 1920

/// [ALPHA] Disable vertical borders in columns Body (borders will always appear in Headers). -> May move to style
pub const TABLE_FLAGS_NO_BORDERS_IN_BODY: i32 = 2048

/// [ALPHA] Disable vertical borders in columns Body until hovered for resize (borders will always appear in Headers). -> May move to style
pub const TABLE_FLAGS_NO_BORDERS_IN_BODY_UNTIL_RESIZE: i32 = 4096

/// Columns default to _WidthFixed or _WidthAuto (if resizable or not resizable), matching contents width.
pub const TABLE_FLAGS_SIZING_FIXED_FIT: i32 = 8192

/// Columns default to _WidthFixed or _WidthAuto (if resizable or not resizable), matching the maximum contents width of all columns. Implicitly enable ImGuiTableFlags_NoKeepColumnsVisible.
pub const TABLE_FLAGS_SIZING_FIXED_SAME: i32 = 16384

/// Columns default to _WidthStretch with default weights proportional to each columns contents widths.
pub const TABLE_FLAGS_SIZING_STRETCH_PROP: i32 = 24576

/// Columns default to _WidthStretch with default weights all equal, unless overridden by TableSetupColumn().
pub const TABLE_FLAGS_SIZING_STRETCH_SAME: i32 = 32768

/// Make outer width auto-fit to columns, overriding outer_size.x value. Only available when ScrollX/ScrollY are disabled and Stretch columns are not used.
pub const TABLE_FLAGS_NO_HOST_EXTEND_X: i32 = 65536

/// Make outer height stop exactly at outer_size.y (prevent auto-extending table past the limit). Only available when ScrollX/ScrollY are disabled. Data below the limit will be clipped and not visible.
pub const TABLE_FLAGS_NO_HOST_EXTEND_Y: i32 = 131072

/// Disable keeping column always minimally visible when ScrollX is off and table gets too small. Not recommended if columns are resizable.
pub const TABLE_FLAGS_NO_KEEP_COLUMNS_VISIBLE: i32 = 262144

/// Disable distributing remainder width to stretched columns (width allocation on a 100-wide table with 3 columns: Without this flag: 33,33,34. With this flag: 33,33,33). With larger number of columns, resizing will appear to be less smooth.
pub const TABLE_FLAGS_PRECISE_WIDTHS: i32 = 524288

/// Disable clipping rectangle for every individual columns (reduce draw command count, items will be able to overflow into other columns). Generally incompatible with TableSetupScrollFreeze().
pub const TABLE_FLAGS_NO_CLIP: i32 = 1048576

/// Default if BordersOuterV is on. Enable outermost padding. Generally desirable if you have headers.
pub const TABLE_FLAGS_PAD_OUTER_X: i32 = 2097152

/// Default if BordersOuterV is off. Disable outermost padding.
pub const TABLE_FLAGS_NO_PAD_OUTER_X: i32 = 4194304

/// Disable inner padding between columns (double inner padding if BordersOuterV is on, single inner padding if BordersOuterV is off).
pub const TABLE_FLAGS_NO_PAD_INNER_X: i32 = 8388608

/// Enable horizontal scrolling. Require 'outer_size' parameter of BeginTable() to specify the container size. Changes default sizing policy. Because this creates a child window, ScrollY is currently generally recommended when using ScrollX.
pub const TABLE_FLAGS_SCROLL_X: i32 = 16777216

/// Enable vertical scrolling. Require 'outer_size' parameter of BeginTable() to specify the container size.
pub const TABLE_FLAGS_SCROLL_Y: i32 = 33554432

/// Hold shift when clicking headers to sort on multiple column. TableGetSortSpecs() may return specs where (SpecsCount > 1).
pub const TABLE_FLAGS_SORT_MULTI: i32 = 67108864

/// Allow no sorting, disable default sorting. TableGetSortSpecs() may return specs where (SpecsCount == 0).
pub const TABLE_FLAGS_SORT_TRISTATE: i32 = 134217728

/// Highlight column headers when hovered (may evolve into a fuller highlight)
pub const TABLE_FLAGS_HIGHLIGHT_HOVERED_COLUMN: i32 = 268435456

pub const TABLE_COLUMN_FLAGS_NONE: i32 = 0

/// Overriding/master disable flag: hide column, won't show in context menu (unlike calling TableSetColumnEnabled() which manipulates the user accessible state)
pub const TABLE_COLUMN_FLAGS_DISABLED: i32 = 1

/// Default as a hidden/disabled column.
pub const TABLE_COLUMN_FLAGS_DEFAULT_HIDE: i32 = 2

/// Default as a sorting column.
pub const TABLE_COLUMN_FLAGS_DEFAULT_SORT: i32 = 4

/// Column will stretch. Preferable with horizontal scrolling disabled (default if table sizing policy is _SizingStretchSame or _SizingStretchProp).
pub const TABLE_COLUMN_FLAGS_WIDTH_STRETCH: i32 = 8

/// Column will not stretch. Preferable with horizontal scrolling enabled (default if table sizing policy is _SizingFixedFit and table is resizable).
pub const TABLE_COLUMN_FLAGS_WIDTH_FIXED: i32 = 16

/// Disable manual resizing.
pub const TABLE_COLUMN_FLAGS_NO_RESIZE: i32 = 32

/// Disable manual reordering this column, this will also prevent other columns from crossing over this column.
pub const TABLE_COLUMN_FLAGS_NO_REORDER: i32 = 64

/// Disable ability to hide/disable this column.
pub const TABLE_COLUMN_FLAGS_NO_HIDE: i32 = 128

/// Disable clipping for this column (all NoClip columns will render in a same draw command).
pub const TABLE_COLUMN_FLAGS_NO_CLIP: i32 = 256

/// Disable ability to sort on this field (even if ImGuiTableFlags_Sortable is set on the table).
pub const TABLE_COLUMN_FLAGS_NO_SORT: i32 = 512

/// Disable ability to sort in the ascending direction.
pub const TABLE_COLUMN_FLAGS_NO_SORT_ASCENDING: i32 = 1024

/// Disable ability to sort in the descending direction.
pub const TABLE_COLUMN_FLAGS_NO_SORT_DESCENDING: i32 = 2048

/// TableHeadersRow() will submit an empty label for this column. Convenient for some small columns. Name will still appear in context menu or in angled headers. You may append into this cell by calling TableSetColumnIndex() right after the TableHeadersRow() call.
pub const TABLE_COLUMN_FLAGS_NO_HEADER_LABEL: i32 = 4096

/// Disable header text width contribution to automatic column width.
pub const TABLE_COLUMN_FLAGS_NO_HEADER_WIDTH: i32 = 8192

/// Make the initial sort direction Ascending when first sorting on this column (default).
pub const TABLE_COLUMN_FLAGS_PREFER_SORT_ASCENDING: i32 = 16384

/// Make the initial sort direction Descending when first sorting on this column.
pub const TABLE_COLUMN_FLAGS_PREFER_SORT_DESCENDING: i32 = 32768

/// Use current Indent value when entering cell (default for column 0).
pub const TABLE_COLUMN_FLAGS_INDENT_ENABLE: i32 = 65536

/// Ignore current Indent value when entering cell (default for columns > 0). Indentation changes _within_ the cell will still be honored.
pub const TABLE_COLUMN_FLAGS_INDENT_DISABLE: i32 = 131072

/// TableHeadersRow() will submit an angled header row for this column. Note this will add an extra row.
pub const TABLE_COLUMN_FLAGS_ANGLED_HEADER: i32 = 262144

/// Status: is enabled == not hidden by user/api (referred to as "Hide" in _DefaultHide and _NoHide) flags.
pub const TABLE_COLUMN_FLAGS_IS_ENABLED: i32 = 16777216

/// Status: is visible == is enabled AND not clipped by scrolling.
pub const TABLE_COLUMN_FLAGS_IS_VISIBLE: i32 = 33554432

/// Status: is currently part of the sort specs
pub const TABLE_COLUMN_FLAGS_IS_SORTED: i32 = 67108864

/// Status: is hovered by mouse
pub const TABLE_COLUMN_FLAGS_IS_HOVERED: i32 = 134217728

pub const TABLE_ROW_FLAGS_NONE: i32 = 0

/// Identify header row (set default background color + width of its contents accounted differently for auto column width)
pub const TABLE_ROW_FLAGS_HEADERS: i32 = 1

pub const TABLE_BG_TARGET_NONE: i32 = 0

/// Set row background color 0 (generally used for background, automatically set when ImGuiTableFlags_RowBg is used)
pub const TABLE_BG_TARGET_ROW_BG0: i32 = 1

/// Set row background color 1 (generally used for selection marking)
pub const TABLE_BG_TARGET_ROW_BG1: i32 = 2

/// Set cell background color (top-most color)
pub const TABLE_BG_TARGET_CELL_BG: i32 = 3

pub const LIST_CLIPPER_FLAGS_NONE: i32 = 0

/// [Internal] Disabled modifying table row counters. Avoid assumption that 1 clipper item == 1 table row.
pub const LIST_CLIPPER_FLAGS_NO_SET_TABLE_ROW_COUNTERS: i32 = 1

pub const MULTI_SELECT_FLAGS_NONE: i32 = 0

/// Disable selecting more than one item. This is available to allow single-selection code to share same code/logic if desired. It essentially disables the main purpose of BeginMultiSelect() tho!
pub const MULTI_SELECT_FLAGS_SINGLE_SELECT: i32 = 1

/// Disable Ctrl+A shortcut to select all.
pub const MULTI_SELECT_FLAGS_NO_SELECT_ALL: i32 = 2

/// Disable Shift+selection mouse/keyboard support (useful for unordered 2D selection). With BoxSelect is also ensure contiguous SetRange requests are not combined into one. This allows not handling interpolation in SetRange requests.
pub const MULTI_SELECT_FLAGS_NO_RANGE_SELECT: i32 = 4

/// Disable selecting items when navigating (useful for e.g. supporting range-select in a list of checkboxes).
pub const MULTI_SELECT_FLAGS_NO_AUTO_SELECT: i32 = 8

/// Disable clearing selection when navigating or selecting another one (generally used with ImGuiMultiSelectFlags_NoAutoSelect. useful for e.g. supporting range-select in a list of checkboxes).
pub const MULTI_SELECT_FLAGS_NO_AUTO_CLEAR: i32 = 16

/// Disable clearing selection when clicking/selecting an already selected item.
pub const MULTI_SELECT_FLAGS_NO_AUTO_CLEAR_ON_RESELECT: i32 = 32

/// Enable box-selection with same width and same x pos items (e.g. full row Selectable()). Box-selection works better with little bit of spacing between items hit-box in order to be able to aim at empty space.
pub const MULTI_SELECT_FLAGS_BOX_SELECT1D: i32 = 64

/// Enable box-selection with varying width or varying x pos items support (e.g. different width labels, or 2D layout/grid). This is slower: alters clipping logic so that e.g. horizontal movements will update selection of normally clipped items.
pub const MULTI_SELECT_FLAGS_BOX_SELECT2D: i32 = 128

/// Disable scrolling when box-selecting and moving mouse near edges of scope.
pub const MULTI_SELECT_FLAGS_BOX_SELECT_NO_SCROLL: i32 = 256

/// Clear selection when pressing Escape while scope is focused.
pub const MULTI_SELECT_FLAGS_CLEAR_ON_ESCAPE: i32 = 512

/// Clear selection when clicking on empty location within scope.
pub const MULTI_SELECT_FLAGS_CLEAR_ON_CLICK_VOID: i32 = 1024

/// Scope for _BoxSelect and _ClearOnClickVoid is whole window (Default). Use if BeginMultiSelect() covers a whole window or used a single time in same window.
pub const MULTI_SELECT_FLAGS_SCOPE_WINDOW: i32 = 2048

/// Scope for _BoxSelect and _ClearOnClickVoid is rectangle encompassing BeginMultiSelect()/EndMultiSelect(). Use if BeginMultiSelect() is called multiple times in same window.
pub const MULTI_SELECT_FLAGS_SCOPE_RECT: i32 = 4096

/// Apply selection on mouse down when clicking on unselected item, on mouse up when clicking on selected item. (Default)
pub const MULTI_SELECT_FLAGS_SELECT_ON_AUTO: i32 = 8192

/// Apply selection on mouse down when clicking on any items. Prevents Drag and Drop from being used on multiple-selection, but allows e.g. BoxSelect to always reselect even when clicking inside an existing selection. (Excel style behavior)
pub const MULTI_SELECT_FLAGS_SELECT_ON_CLICK_ALWAYS: i32 = 16384

/// Apply selection on mouse release when clicking an unselected item. Allow dragging an unselected item without altering selection.
pub const MULTI_SELECT_FLAGS_SELECT_ON_CLICK_RELEASE: i32 = 32768

/// [Temporary] Enable navigation wrapping on X axis. Provided as a convenience because we don't have a design for the general Nav API for this yet. When the more general feature be public we may obsolete this flag in favor of new one.
pub const MULTI_SELECT_FLAGS_NAV_WRAP_X: i32 = 65536

/// Disable default right-click processing, which selects item on mouse down, and is designed for context-menus.
pub const MULTI_SELECT_FLAGS_NO_SELECT_ON_RIGHT_CLICK: i32 = 131072

pub const SELECTION_REQUEST_TYPE_NONE: i32 = 0

/// Request app to clear selection (if Selected==false) or select all items (if Selected==true). We cannot set RangeFirstItem/RangeLastItem as its contents is entirely up to user (not necessarily an index)
pub const SELECTION_REQUEST_TYPE_SET_ALL: i32 = 1

/// Request app to select/unselect [RangeFirstItem..RangeLastItem] items (inclusive) based on value of Selected. Only EndMultiSelect() request this, app code can read after BeginMultiSelect() and it will always be false.
pub const SELECTION_REQUEST_TYPE_SET_RANGE: i32 = 2

pub const DRAW_FLAGS_NONE: i32 = 0

/// Round top-left corner only (when rounding > 0.0f, we default to all corners).
pub const DRAW_FLAGS_ROUND_CORNERS_TOP_LEFT: i32 = 16

/// Round top-right corner only (when rounding > 0.0f, we default to all corners).
pub const DRAW_FLAGS_ROUND_CORNERS_TOP_RIGHT: i32 = 32

/// Round bottom-left corner only (when rounding > 0.0f, we default to all corners).
pub const DRAW_FLAGS_ROUND_CORNERS_BOTTOM_LEFT: i32 = 64

/// Round bottom-right corner only (when rounding > 0.0f, we default to all corners).
pub const DRAW_FLAGS_ROUND_CORNERS_BOTTOM_RIGHT: i32 = 128

/// Disable rounding even if `float rounding > 0.0f`. This is NOT zero, NOT an implicit flag!
pub const DRAW_FLAGS_ROUND_CORNERS_NONE: i32 = 256

/// (Default!!)
pub const DRAW_FLAGS_ROUND_CORNERS_ALL: i32 = 240

pub const DRAW_FLAGS_ROUND_CORNERS_TOP: i32 = 48

pub const DRAW_FLAGS_ROUND_CORNERS_BOTTOM: i32 = 192

pub const DRAW_FLAGS_ROUND_CORNERS_LEFT: i32 = 80

pub const DRAW_FLAGS_ROUND_CORNERS_RIGHT: i32 = 160

/// PathStroke(), AddPolyline(): specify that shape should be closed.
pub const DRAW_FLAGS_CLOSED: i32 = 512

pub const DRAW_LIST_FLAGS_NONE: i32 = 0

/// Enable anti-aliased lines/borders (*2 the number of triangles for 1.0f wide line or lines thin enough to be drawn using textures, otherwise *3 the number of triangles)
pub const DRAW_LIST_FLAGS_ANTI_ALIASED_LINES: i32 = 1

/// Enable anti-aliased lines/borders using textures when possible. Require backend to render with bilinear filtering (NOT point/nearest filtering).
pub const DRAW_LIST_FLAGS_ANTI_ALIASED_LINES_USE_TEX: i32 = 2

/// Enable anti-aliased edge around filled shapes (rounded rectangles, circles).
pub const DRAW_LIST_FLAGS_ANTI_ALIASED_FILL: i32 = 4

/// Can emit 'VtxOffset > 0' to allow large meshes. Set when 'ImGuiBackendFlags_RendererHasVtxOffset' is enabled.
pub const DRAW_LIST_FLAGS_ALLOW_VTX_OFFSET: i32 = 8

/// Disable automatically snapping AddText() calls to pixel boundaries.
pub const DRAW_LIST_FLAGS_TEXT_NO_PIXEL_SNAP: i32 = 16

/// 4 components per pixel, each is unsigned 8-bit. Total size = TexWidth * TexHeight * 4
pub const TEXTURE_FORMAT_RGBA32: i32 = 0

/// 1 component per pixel, each is unsigned 8-bit. Total size = TexWidth * TexHeight
pub const TEXTURE_FORMAT_ALPHA8: i32 = 1

pub const TEXTURE_STATUS_OK: i32 = 0

/// Backend destroyed the texture.
pub const TEXTURE_STATUS_DESTROYED: i32 = 1

/// Requesting backend to create the texture. Set status OK when done.
pub const TEXTURE_STATUS_WANT_CREATE: i32 = 2

/// Requesting backend to update specific blocks of pixels (write to texture portions which have never been used before). Set status OK when done.
pub const TEXTURE_STATUS_WANT_UPDATES: i32 = 3

/// Requesting backend to destroy the texture. Set status to Destroyed when done.
pub const TEXTURE_STATUS_WANT_DESTROY: i32 = 4

pub const FONT_ATLAS_FLAGS_NONE: i32 = 0

/// Don't round the height to next power of two
pub const FONT_ATLAS_FLAGS_NO_POWER_OF_TWO_HEIGHT: i32 = 1

/// Don't build software mouse cursors into the atlas (save a little texture memory)
pub const FONT_ATLAS_FLAGS_NO_MOUSE_CURSORS: i32 = 2

/// Don't build thick line textures into the atlas (save a little texture memory, allow support for point/nearest filtering). The AntiAliasedLinesUseTex features uses them, otherwise they will be rendered using polygons (more expensive for CPU/GPU).
pub const FONT_ATLAS_FLAGS_NO_BAKED_LINES: i32 = 4

pub const FONT_FLAGS_NONE: i32 = 0

/// Disable throwing an error/assert when calling AddFontXXX() with missing file/data. Calling code is expected to check AddFontXXX() return value.
pub const FONT_FLAGS_NO_LOAD_ERROR: i32 = 2

/// [Internal] Disable loading new glyphs.
pub const FONT_FLAGS_NO_LOAD_GLYPHS: i32 = 4

/// [Internal] Disable loading new baked sizes, disable garbage collecting current ones. e.g. if you want to lock a font to a single size. Important: if you use this to preload given sizes, consider the possibility of multiple font density used on Retina display.
pub const FONT_FLAGS_LOCK_BAKED_SIZES: i32 = 8

/// [Internal] Reference size was not set explicitly.
pub const FONT_FLAGS_IMPLICIT_REF_SIZE: i32 = 16

pub const VIEWPORT_FLAGS_NONE: i32 = 0

/// Represent a Platform Window
pub const VIEWPORT_FLAGS_IS_PLATFORM_WINDOW: i32 = 1

/// Represent a Platform Monitor (unused yet)
pub const VIEWPORT_FLAGS_IS_PLATFORM_MONITOR: i32 = 2

/// Platform Window: Is created/managed by the user application? (rather than our backend)
pub const VIEWPORT_FLAGS_OWNED_BY_APP: i32 = 4

/// Platform Window: Disable platform decorations: title bar, borders, etc. (generally set all windows, but if ImGuiConfigFlags_ViewportsDecoration is set we only set this on popups/tooltips)
pub const VIEWPORT_FLAGS_NO_DECORATION: i32 = 8

/// Platform Window: Disable platform task bar icon (generally set on popups/tooltips, or all windows if ImGuiConfigFlags_ViewportsNoTaskBarIcon is set)
pub const VIEWPORT_FLAGS_NO_TASK_BAR_ICON: i32 = 16

/// Platform Window: Don't take focus when created.
pub const VIEWPORT_FLAGS_NO_FOCUS_ON_APPEARING: i32 = 32

/// Platform Window: Don't take focus when clicked on.
pub const VIEWPORT_FLAGS_NO_FOCUS_ON_CLICK: i32 = 64

/// Platform Window: Make mouse pass through so we can drag this window while peaking behind it.
pub const VIEWPORT_FLAGS_NO_INPUTS: i32 = 128

/// Platform Window: Renderer doesn't need to clear the framebuffer ahead (because we will fill it entirely).
pub const VIEWPORT_FLAGS_NO_RENDERER_CLEAR: i32 = 256

/// Platform Window: Avoid merging this window into another host window. This can only be set via ImGuiWindowClass viewport flags override (because we need to now ahead if we are going to create a viewport in the first place!).
pub const VIEWPORT_FLAGS_NO_AUTO_MERGE: i32 = 512

/// Platform Window: Display on top (for tooltips only).
pub const VIEWPORT_FLAGS_TOP_MOST: i32 = 1024

/// Viewport can host multiple imgui windows (secondary viewports are associated to a single window). // FIXME: In practice there's still probably code making the assumption that this is always and only on the MainViewport. Will fix once we add support for "no main viewport".
pub const VIEWPORT_FLAGS_CAN_HOST_OTHER_WINDOWS: i32 = 2048

/// Platform Window: Window is minimized, can skip render. When minimized we tend to avoid using the viewport pos/size for clipping window or testing if they are contained in the viewport.
pub const VIEWPORT_FLAGS_IS_MINIMIZED: i32 = 4096

/// Platform Window: Window is focused (last call to Platform_GetWindowFocus() returned true)
pub const VIEWPORT_FLAGS_IS_FOCUSED: i32 = 8192

// ── Functions ───────────────────────────────────────────────────────────────

/// `GetTexID` — == (_TexData ? _TexData->TexID : _TexID) // Implemented below in the file.
pub let get_tex_id = (self: TextureRef) -> u64 => unsafe { c_texture_ref_get_tex_id(self) }

/// `ImGui::GetIO` — access the ImGuiIO structure (mouse/keyboard/gamepad inputs, time, various configuration options/flags)
pub let get_io = () -> IO => unsafe { c_get_io() }

/// `ImGui::GetStyle` — access the Style structure (colors, sizes). Always use PushStyleColor(), PushStyleVar() to modify style mid-frame!
pub let get_style = () -> Style => unsafe { c_get_style() }

/// `ImGui::ShowDemoWindow` — create Demo window. demonstrate most ImGui features. call this to learn about the library! try to make it always available in your application!
pub let show_demo_window = () -> void => unsafe { c_show_demo_window(nullptr) }

/// `ImGui::ShowDemoWindow` — create Demo window. demonstrate most ImGui features. call this to learn about the library! try to make it always available in your application!
pub let show_demo_window_closable = (open: mut bool) -> void => {
  let c_open = unsafe { &mut open }
  unsafe { c_show_demo_window(c_open) }
}

/// `ImGui::ShowMetricsWindow` — create Metrics/Debugger window. display Dear ImGui internals: windows, draw commands, various internal state, etc.
