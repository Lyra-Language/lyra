/// `ImGui::PopStyleVar`.
pub let pop_style_var = (count: i32 = 1) -> void => unsafe { c_pop_style_var_ex(count) }

/// `ImGui::PushItemFlag` — modify specified shared item flag, e.g. PushItemFlag(ImGuiItemFlags_NoTabStop, true)
pub let push_item_flag = (option: i32, enabled: bool) -> void => unsafe { c_push_item_flag(option, enabled) }

/// `ImGui::PopItemFlag`.
pub let pop_item_flag = () -> void => unsafe { c_pop_item_flag() }

/// `ImGui::PushItemWidth` — push width of items for common large "item+label" widgets. >0.0f: width in pixels, <0.0f align xx pixels to the right of window (so -FLT_MIN always align width to the right side).
pub let push_item_width = (item_width: f32) -> void => unsafe { c_push_item_width(item_width) }

/// `ImGui::PopItemWidth`.
pub let pop_item_width = () -> void => unsafe { c_pop_item_width() }

/// `ImGui::SetNextItemWidth` — set width of the _next_ common large "item+label" widget. >0.0f: width in pixels, <0.0f align xx pixels to the right of window (so -FLT_MIN always align width to the right side)
pub let set_next_item_width = (item_width: f32) -> void => unsafe { c_set_next_item_width(item_width) }

/// `ImGui::CalcItemWidth` — width of item given pushed settings and current cursor position. NOT necessarily the width of last item unlike most 'Item' functions.
pub let calc_item_width = () -> f32 => unsafe { c_calc_item_width() }

/// `ImGui::PushTextWrapPos` — push word-wrapping position for Text*() commands. < 0.0f: no wrapping; 0.0f: wrap to end of window (or column); > 0.0f: wrap at 'wrap_pos_x' position in window local space
pub let push_text_wrap_pos = (wrap_local_pos_x: f32 = 0.0) -> void => unsafe { c_push_text_wrap_pos(wrap_local_pos_x) }

/// `ImGui::PopTextWrapPos`.
pub let pop_text_wrap_pos = () -> void => unsafe { c_pop_text_wrap_pos() }

/// `ImGui::GetFontTexUvWhitePixel` — get UV coordinate for a white pixel, useful to draw custom shapes via the ImDrawList API
pub let get_font_tex_uv_white_pixel = () -> Vec2 => unsafe { c_get_font_tex_uv_white_pixel() }

/// `ImGui::GetColorU32` — retrieve given style color with style alpha applied and optional extra alpha multiplier, packed as a 32-bit value suitable for ImDrawList
pub let get_color_u32 = (idx: i32, alpha_mul: f32 = 1.0) -> u32 => unsafe { c_get_color_u32_ex(idx, alpha_mul) }

/// `ImGui::GetColorU32` — retrieve given color with style alpha applied, packed as a 32-bit value suitable for ImDrawList
pub let get_color_u32_vec4 = (col: Vec4) -> u32 => unsafe { c_get_color_u32_vec4(col) }

/// `ImGui::GetColorU32` — retrieve given color with style alpha applied, packed as a 32-bit value suitable for ImDrawList
pub let get_color_u32_u32 = (col: u32, alpha_mul: f32 = 1.0) -> u32 => unsafe { c_get_color_u32_u32_ex(col, alpha_mul) }

/// `ImGui::GetCursorScreenPos` — cursor position, absolute coordinates. THIS IS YOUR BEST FRIEND (prefer using this rather than GetCursorPos(), also more useful to work with ImDrawList API).
pub let get_cursor_screen_pos = () -> Vec2 => unsafe { c_get_cursor_screen_pos() }

/// `ImGui::SetCursorScreenPos` — cursor position, absolute coordinates. THIS IS YOUR BEST FRIEND.
pub let set_cursor_screen_pos = (pos: Vec2) -> void => unsafe { c_set_cursor_screen_pos(pos) }

/// `ImGui::GetContentRegionAvail` — available space from current position. THIS IS YOUR BEST FRIEND.
pub let get_content_region_avail = () -> Vec2 => unsafe { c_get_content_region_avail() }

/// `ImGui::GetCursorPos` — [window-local] cursor position in window-local coordinates. This is not your best friend.
pub let get_cursor_pos = () -> Vec2 => unsafe { c_get_cursor_pos() }

/// `ImGui::GetCursorPosX` — [window-local] "
pub let get_cursor_pos_x = () -> f32 => unsafe { c_get_cursor_pos_x() }

/// `ImGui::GetCursorPosY` — [window-local] "
pub let get_cursor_pos_y = () -> f32 => unsafe { c_get_cursor_pos_y() }

/// `ImGui::SetCursorPos` — [window-local] "
pub let set_cursor_pos = (local_pos: Vec2) -> void => unsafe { c_set_cursor_pos(local_pos) }

/// `ImGui::SetCursorPosX` — [window-local] "
pub let set_cursor_pos_x = (local_x: f32) -> void => unsafe { c_set_cursor_pos_x(local_x) }

/// `ImGui::SetCursorPosY` — [window-local] "
pub let set_cursor_pos_y = (local_y: f32) -> void => unsafe { c_set_cursor_pos_y(local_y) }

/// `ImGui::GetCursorStartPos` — [window-local] initial cursor position, in window-local coordinates. Call GetCursorScreenPos() after Begin() to get the absolute coordinates version.
pub let get_cursor_start_pos = () -> Vec2 => unsafe { c_get_cursor_start_pos() }

/// `ImGui::Separator` — separator, generally horizontal. inside a menu bar or in horizontal layout mode, this becomes a vertical separator.
pub let separator = () -> void => unsafe { c_separator() }

/// `ImGui::SameLine` — call between widgets or groups to layout them horizontally. X position given in window coordinates.
pub let same_line = (offset_from_start_x: f32 = 0.0, spacing: f32 = -1.0) -> void => unsafe { c_same_line_ex(offset_from_start_x, spacing) }

/// `ImGui::NewLine` — undo a SameLine() or force a new line when in a horizontal-layout context.
pub let new_line = () -> void => unsafe { c_new_line() }

/// `ImGui::Spacing` — add vertical spacing.
pub let spacing = () -> void => unsafe { c_spacing() }

/// `ImGui::Dummy` — add a dummy item of given size. unlike InvisibleButton(), Dummy() won't take the mouse click or be navigable into.
pub let dummy = (size: Vec2) -> void => unsafe { c_dummy(size) }

/// `ImGui::Indent` — move content position toward the right, by indent_w, or style.IndentSpacing if indent_w <= 0
pub let indent = (indent_w: f32 = 0.0) -> void => unsafe { c_indent_ex(indent_w) }

/// `ImGui::Unindent` — move content position back to the left, by indent_w, or style.IndentSpacing if indent_w <= 0
pub let unindent = (indent_w: f32 = 0.0) -> void => unsafe { c_unindent_ex(indent_w) }

/// `ImGui::BeginGroup` — lock horizontal starting position
pub let begin_group = () -> void => unsafe { c_begin_group() }

/// `ImGui::EndGroup` — unlock horizontal starting position + capture the whole group bounding box into one "item" (so you can use IsItemHovered() or layout primitives such as SameLine() on whole group, etc.)
pub let end_group = () -> void => unsafe { c_end_group() }

/// `ImGui::AlignTextToFramePadding` — vertically align upcoming text baseline to FramePadding.y so that it will align properly to regularly framed items (call if you have text on a line before a framed item)
pub let align_text_to_frame_padding = () -> void => unsafe { c_align_text_to_frame_padding() }

/// `ImGui::GetTextLineHeight` — ~ FontSize
pub let get_text_line_height = () -> f32 => unsafe { c_get_text_line_height() }

/// `ImGui::GetTextLineHeightWithSpacing` — ~ FontSize + style.ItemSpacing.y (distance in pixels between 2 consecutive lines of text)
pub let get_text_line_height_with_spacing = () -> f32 => unsafe { c_get_text_line_height_with_spacing() }

/// `ImGui::GetFrameHeight` — ~ FontSize + style.FramePadding.y * 2
pub let get_frame_height = () -> f32 => unsafe { c_get_frame_height() }

/// `ImGui::GetFrameHeightWithSpacing` — ~ FontSize + style.FramePadding.y * 2 + style.ItemSpacing.y (distance in pixels between 2 consecutive lines of framed widgets)
pub let get_frame_height_with_spacing = () -> f32 => unsafe { c_get_frame_height_with_spacing() }

/// `ImGui::PushID` — push string into the ID stack (will hash string).
pub let push_id = (str_id: string) -> void => str_id.with_cstring((c_str_id) => unsafe { c_push_id(c_str_id) })

/// `ImGui::PushID` — push string into the ID stack (will hash string).
pub let push_id_str = (str_id_begin: string, str_id_end: string) -> void => str_id_begin.with_cstring((c_str_id_begin) => str_id_end.with_cstring((c_str_id_end) => unsafe { c_push_id_str(c_str_id_begin, c_str_id_end) }))

/// `ImGui::PushID` — push integer into the ID stack (will hash integer).
pub let push_id_int = (int_id: i32) -> void => unsafe { c_push_id_int(int_id) }

/// `ImGui::PopID` — pop from the ID stack.
pub let pop_id = () -> void => unsafe { c_pop_id() }

/// `ImGui::GetID` — calculate unique ID (hash of whole ID stack + given parameter). e.g. if you want to query into ImGuiStorage yourself
pub let get_id = (str_id: string) -> u32 => str_id.with_cstring((c_str_id) => unsafe { c_get_id(c_str_id) })

/// `ImGui::GetID`.
pub let get_id_str = (str_id_begin: string, str_id_end: string) -> u32 => str_id_begin.with_cstring((c_str_id_begin) => str_id_end.with_cstring((c_str_id_end) => unsafe { c_get_id_str(c_str_id_begin, c_str_id_end) }))

/// `ImGui::GetID`.
pub let get_id_int = (int_id: i32) -> u32 => unsafe { c_get_id_int(int_id) }

/// `ImGui::TextUnformatted` — raw text without formatting. Practically equivalent to 'Text("%s", text)' but doesn't require null terminated string if 'text_end' is specified.
pub let text_unformatted = (text: string) -> void => text.with_cstring((c_text) => unsafe { c_text_unformatted_ex(c_text, nullptr) })

/// `ImGui::TextColored` — shortcut for PushStyleColor(ImGuiCol_Text, col); Text(fmt, ...); PopStyleColor();
pub let text_colored = (col: Vec4, text: string) -> void => text.with_cstring((c_text) => unsafe { c_text_colored_unformatted(col, c_text) })

/// `ImGui::TextDisabled` — shortcut for PushStyleColor(ImGuiCol_Text, style.Colors[ImGuiCol_TextDisabled]); Text(fmt, ...); PopStyleColor();
pub let text_disabled = (text: string) -> void => text.with_cstring((c_text) => unsafe { c_text_disabled_unformatted(c_text) })

/// `ImGui::TextWrapped` — shortcut for PushTextWrapPos(0.0f); Text(fmt, ...); PopTextWrapPos();. Note that this won't work on an auto-resizing window if there's no other widgets to extend the window width, yoy may need to set a size using SetNextWindowSize().
pub let text_wrapped = (text: string) -> void => text.with_cstring((c_text) => unsafe { c_text_wrapped_unformatted(c_text) })

/// `ImGui::LabelText` — display text+label aligned the same way as value+label widgets
pub let label_text = (label: string, text: string) -> void => label.with_cstring((c_label) => text.with_cstring((c_text) => unsafe { c_label_text_unformatted(c_label, c_text) }))

/// `ImGui::BulletText` — shortcut for Bullet()+Text()
pub let bullet_text = (text: string) -> void => text.with_cstring((c_text) => unsafe { c_bullet_text_unformatted(c_text) })

/// `ImGui::SeparatorText` — currently: formatted text with a horizontal line
pub let separator_text = (label: string) -> void => label.with_cstring((c_label) => unsafe { c_separator_text(c_label) })

/// `ImGui::Button` — button
pub let button = (label: string, size: Vec2 = Vec2 { x: 0.0, y: 0.0 }) -> bool => label.with_cstring((c_label) => unsafe { c_button_ex(c_label, size) })

/// `ImGui::SmallButton` — button with (FramePadding.y == 0) to easily embed within text
pub let small_button = (label: string) -> bool => label.with_cstring((c_label) => unsafe { c_small_button(c_label) })

/// `ImGui::InvisibleButton` — flexible button behavior without the visuals, frequently useful to build custom behaviors using the public api (along with IsItemActive, IsItemHovered, etc.)
pub let invisible_button = (str_id: string, size: Vec2, flags: i32 = 0) -> bool => str_id.with_cstring((c_str_id) => unsafe { c_invisible_button(c_str_id, size, flags) })

/// `ImGui::ArrowButton` — square button with an arrow shape
