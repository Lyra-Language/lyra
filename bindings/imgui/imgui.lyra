@link("lyra-imgui")
@link("SDL3", pkg: "sdl3")
module bindings.imgui
//! Bindings to Dear ImGui (docking branch) — an immediate-mode UI: each frame the
//! program describes its whole interface again, and a widget call answers what the user
//! did to it. No widget objects, no callbacks; the state is the program's own.
//!
//! ```
//! import bindings.imgui.{ create_host, begin_frame, end_frame, destroy_host,
//!   HOST_DOCKING, HOST_VIEWPORTS, begin, end, button, checkbox }
//!
//! let main = () -> void => {
//!   let Some(host) = create_host("Tool", 1280, 800, HOST_DOCKING | HOST_VIEWPORTS) else {
//!     return
//!   }
//!   var loud = false
//!   for begin_frame(host) {
//!     if begin("Settings") {
//!       checkbox("Loud", loud)
//!       if button("Save") { save(loud) }
//!     }
//!     end()
//!     end_frame(host, 0.1, 0.1, 0.12)
//!   }
//!   destroy_host(host)
//! }
//! ```
//!
//! **Two halves.** This file, over `host.cpp`, is what C++ has to do for Lyra: the *host*
//! (the window, the SDL_GPU device and the frame loop — four calls), text input over a
//! Lyra `string`, and textures. Everything else — the widgets, the draw list, the enums,
//! and the fields of `ImGuiIO`, `ImGuiStyle` and `ImGuiViewport` as methods
//! (`get_io().delta_time()`) — is generated from dear_bindings' `dcimgui.json` (`gen/`).
//!
//! **The C half is `lib/liblyra-imgui.a`**, which `./build.sh` builds from a pinned,
//! downloaded ImGui (`build.sh` in this directory). It needs no C++ runtime, so the two
//! `@link`s above are the whole link line.
//!
//! **Multi-viewports**: with [HOST_VIEWPORTS], a window dragged outside the main one
//! becomes an OS window of its own — onto another monitor, say. That is why the renderer
//! is SDL_GPU: SDL_Renderer's ImGui backend has no multi-viewport support.

import std.ffi
import std.ffi.{ cstring_len }

// ── The host ─────────────────────────────────────────────────────────────────

/// A running ImGui host: the main window, its GPU device and the ImGui context.
pub newtype Host = ^u8

/// [create_host] flags, combined with `|`. Docking lets windows dock into each other and
/// into the main window.
pub const HOST_DOCKING: u32 = 1
/// Let a window leave the main one as an OS window of its own (multi-monitor).
pub const HOST_VIEWPORTS: u32 = 2
/// The main window has no title bar of the system's: the program draws one, its main
/// menu bar begun with [begin_title_bar] and ended with [end_title_bar]. The window's edges still resize it, and the bar's
/// empty stretch moves it, as a title bar's would.
pub const HOST_CUSTOM_TITLE_BAR: u32 = 4

/// Open the main window with ImGui in it, or `None` if SDL could not — the SDL3
/// binding's `last_error` says why. The size is in points; the window is scaled for the
/// primary display's density. Initialises SDL's video and gamepad subsystems, which
/// [destroy_host] quits.
pub let create_host = (
  title: string,
  width: i32,
  height: i32,
  flags: u32
) -> Maybe<Host> => {
  let h = title.with_cstring((t) => unsafe {
    lyra_imgui_host_create(t, width, height, flags)
  })
  if h == nullptr { None } else { Some(h) }
}

/// Pump events and start a frame; `false` once the user has asked to quit, and then no
/// frame was started. While the main window is minimised it waits instead of answering.
pub let begin_frame = (host: Host) -> bool => unsafe { lyra_imgui_host_begin_frame(host) }

/// Draw the frame — the main window cleared to `(r, g, b)` behind ImGui, then every
/// torn-off window — and present it.
pub let end_frame = (host: Host, r: f32, g: f32, b: f32) -> void =>
  unsafe { lyra_imgui_host_end_frame(host, r, g, b) }

/// Close the window and shut ImGui and SDL down. The host must not be used afterwards.
pub let destroy_host = (host: Host) -> void => unsafe { lyra_imgui_host_destroy(host) }

// ── Text ─────────────────────────────────────────────────────────────────────

/// `ImGui::Text` — a line of text. ImGui's own `Text` is printf-style and is not bound;
/// build the string with interpolation (`text("fps: ${fps}")`) instead.
pub let text = (s: string) -> void => text_unformatted(s)

/// `ImGui::InputText` over a Lyra string: edits `value` in place and answers whether this
/// frame changed it. Any length — the buffer grows as the user types.
pub let input_text = (label: string, value: mut string, flags: i32 = 0) -> bool =>
  edit_text(label, None, value, flags, false, Vec2 { x: 0.0, y: 0.0 })

/// [input_text] showing `hint` in grey while `value` is empty.
pub let input_text_with_hint = (
  label: string,
  hint: string,
  value: mut string,
  flags: i32 = 0
) -> bool => edit_text(label, Some(hint), value, flags, false, Vec2 { x: 0.0, y: 0.0 })

/// [input_text] over several lines, in a box `size` large (`0` in either axis takes the
/// default).
pub let input_text_multiline = (
  label: string,
  value: mut string,
  size: Vec2 = Vec2 { x: 0.0, y: 0.0 },
  flags: i32 = 0
) -> bool => edit_text(label, None, value, flags, true, size)

// ── Textures ─────────────────────────────────────────────────────────────────

/// An RGBA texture ImGui can draw — tiles, sprites, a canvas. Made by [create_texture],
/// filled by [update_texture], drawn by [image], [image_button] and a draw list's
/// [add_image], and released by [destroy_texture], which must not run while the frame
/// being built still draws it (the drawing happens at `end_frame`).
@must_release(destroy_texture)
pub struct Texture {
  host: Host,
  handle: ^u8,
  width: i32,
  height: i32,
}

/// How a texture is sampled when drawn at another size than its own.
pub data Filter =
  /// Every texel a crisp square: pixel art, tiles, sprites. The default here.
  Nearest
  /// Smoothed between texels: photographs, art drawn at fractional scales.
  | Linear

/// A `width` × `height` texture, its pixels undefined until [update_texture]; `None` for
/// a size of zero or when the GPU refuses.
pub let create_texture = (host: Host, width: i32, height: i32) -> Maybe<Texture> => {
  if width <= 0 || height <= 0 { return None }
  let handle = unsafe { lyra_imgui_texture_create(host, width, height) }
  if handle == nullptr {
    None
  } else {
    Some(Texture { host: host, handle: handle, width: width, height: height })
  }
}

/// Replace every pixel: `rgba` is width × height × 4 bytes, rows top to bottom. Uploaded at
/// once, so the frame being built draws the new pixels. `false` if `rgba` is the wrong
/// length or the upload failed.
pub let update_texture = (texture: Texture, rgba: []u8) -> bool => {
  if rgba.len() != i64(texture.width) * i64(texture.height) * 4 { return false }
  unsafe {
    lyra_imgui_texture_update(
      texture.host,
      texture.handle,
      rgba.data(),
      texture.width,
      texture.height
    )
  }
}

/// Release the texture's GPU memory.
pub let destroy_texture = (texture: Texture) -> void =>
  unsafe { lyra_imgui_texture_destroy(texture.host, texture.handle) }

/// `ImGui::Image`: the texture's `uv0`..`uv1` region (0..1 across the texture) as an item
/// `size` pixels large.
pub let image = (
  texture: Texture,
  size: Vec2,
  uv0: Vec2 = Vec2 { x: 0.0, y: 0.0 },
  uv1: Vec2 = Vec2 { x: 1.0, y: 1.0 },
  filter: Filter = Nearest
) -> void =>
  unsafe { lyra_imgui_image(texture.handle, size, uv0, uv1, filter == Nearest) }

/// `ImGui::ImageButton`: [image] as a button, identified by `id`; answers whether it was
/// pressed.
pub let image_button = (
  id: string,
  texture: Texture,
  size: Vec2,
  uv0: Vec2 = Vec2 { x: 0.0, y: 0.0 },
  uv1: Vec2 = Vec2 { x: 1.0, y: 1.0 },
  filter: Filter = Nearest
) -> bool => id.with_cstring((c_id) => unsafe {
  lyra_imgui_image_button(c_id, texture.handle, size, uv0, uv1, filter == Nearest)
})

impl DrawList {
  /// `ImDrawList::AddImage`: the texture's `uv0`..`uv1` region stretched over the rectangle
  /// `p_min`..`p_max`, tinted by `col` (white leaves it as it is).
  pub let add_image = (
    self,
    texture: Texture,
    p_min: Vec2,
    p_max: Vec2,
    uv0: Vec2 = Vec2 { x: 0.0, y: 0.0 },
    uv1: Vec2 = Vec2 { x: 1.0, y: 1.0 },
    col: u32 = 0xFFFFFFFF,
    filter: Filter = Nearest
  ) -> void => unsafe {
    lyra_imgui_draw_list_add_image(
      self,
      texture.handle,
      p_min,
      p_max,
      uv0,
      uv1,
      col,
      filter == Nearest
    )
  }
}

// ── Quitting ─────────────────────────────────────────────────────────────────

/// Take back the quit the user just asked for — closing the main window, or Cmd+Q — so
/// the next [begin_frame] starts a frame instead of answering false. How a program with
/// unsaved work asks before it goes:
///
/// ```
/// for {
///   if !begin_frame(host) {
///     if !has_unsaved_work { break }
///     cancel_quit(host)
///     asking = true      // and show the question in the frames that follow
///     continue
///   }
///   …
/// }
/// ```
pub let cancel_quit = (host: Host) -> void => unsafe { lyra_imgui_host_cancel_quit(host) }

// ── File dialogs ─────────────────────────────────────────────────────────────

/// A choice of file types in a dialog: its label and the extensions it admits, without
/// dots, joined by `;` (`"vega;json"`), or `"*"` for every file.
pub struct FileFilter {
  name: string,
  extensions: string,
}

/// What a file dialog answered, under the tag its request was shown with.
pub data DialogAnswer =
  /// The path the user chose.
  Chosen(i32, string)
  /// The user closed the dialog without choosing.
  | Cancelled(i32)
  /// The dialog could not be shown; SDL's reason.
  | DialogFailed(i32, string)

/// Show the system's open-file dialog, modal to the main window. It returns at once;
/// the answer arrives later from [poll_dialog], under `tag`. `default_location` is a
/// folder or file to start at. `false` when the request could not be made (out of
/// memory), and then no answer will come.
pub let show_open_dialog = (
  host: Host,
  tag: i32,
  filters: []FileFilter,
  default_location: Maybe<string> = None
) -> bool => show_dialog(host, tag, false, filters, default_location)

/// [show_open_dialog]'s twin for choosing where to save; the path may not exist yet.
pub let show_save_dialog = (
  host: Host,
  tag: i32,
  filters: []FileFilter,
  default_location: Maybe<string> = None
) -> bool => show_dialog(host, tag, true, filters, default_location)

/// The oldest dialog answer not yet taken, or `None`. Call it each frame while a dialog
/// is open: SDL answers asynchronously, possibly from another thread, and the host keeps
/// the answers until they are polled.
pub let poll_dialog = (host: Host) -> Maybe<DialogAnswer> => {
  var tag: i32 = 0
  var kind: i32 = -1
  let c_tag = unsafe { &mut tag }
  let c_kind = unsafe { &mut kind }
  let answered = unsafe { lyra_imgui_poll_file_dialog(host, c_tag, c_kind) }
  match kind {
    0 => Some(Chosen(tag, from_cstring(answered))),
    1 => Some(Cancelled(tag)),
    2 => Some(DialogFailed(tag, from_cstring(answered))),
    _ => None,
  }
}

// ── Testing ──────────────────────────────────────────────────────────────────

/// A host with no window and no GPU, for testing an interface: every [begin_frame] is a
/// real ImGui frame of `width` × `height` points, one 1/60 s step later, and its only input
/// is what the program injects through `get_io()` — `add_mouse_pos_event`,
/// `add_mouse_button_event`, `add_key_event` (`MOD_CTRL` is a key too),
/// `add_input_characters_utf8`. Events are applied at the next [begin_frame].
///
/// Runs where there is no display. It never reads or writes `imgui.ini`, and macOS's
/// Cmd/Ctrl swap is off, so an injected `MOD_CTRL | KEY_Z` is the same chord everywhere.
/// `HOST_VIEWPORTS` is ignored (a torn-off window needs a platform), textures are `None`,
/// and file dialogs are recorded rather than shown: [take_dialog_request], [answer_dialog].
pub let create_headless_host = (width: i32, height: i32, flags: u32) -> Maybe<Host> => {
  let h = unsafe { lyra_imgui_host_create_headless(width, height, flags) }
  if h == nullptr { None } else { Some(h) }
}

/// A font from a TrueType or OpenType file, for `push_font_float` — loaded into `host`'s
/// context the first time it is asked for, and the same font after (a font belongs to the
/// context that loaded it, so the host keeps it); `None` when the file cannot be read. Its
/// size is chosen as it is pushed (ImGui 1.92's fonts are dynamic); `offset_y` moves every
/// glyph down (negative: up) by that many pixels at `size`, scaled with the size drawn — for
/// a font whose line metrics set its letters low or high.
pub let font_file = (
  host: Host,
  path: string,
  size: f32 = 13.0,
  offset_y: f32 = 0.0
) -> Maybe<Font> => {
  let font = path.with_cstring((c_path) => unsafe { lyra_imgui_host_font_file(
    host,
    c_path,
    size,
    offset_y
  ) })
  if font == nullptr { None } else { Some(font) }
}

/// Scale the whole interface — text, padding, spacing — by `scale`, for readability: 1 is
/// as the host set it up (the display's density already applied), 1.25 a quarter larger.
/// From the host's own style each time, so scales never compound; clamped to 0.5–3.
pub let set_ui_scale = (host: Host, scale: f32) -> void =>
  unsafe { lyra_imgui_host_set_ui_scale(host, scale) }

/// A status bar across the bottom of the main window, a line tall, which the dock space and
/// other windows leave room for: `true` when its contents may be drawn — text and widgets,
/// laid out as a menu bar's, left to right. Call [end_status_bar] after, whatever it
/// answered. Call it before `dock_space_over_viewport`, which then fits above it.
pub let begin_status_bar = (name: string) -> bool =>
  name.with_cstring((n) => unsafe { lyra_imgui_begin_status_bar(n) })

/// Finish the bar [begin_status_bar] began.
pub let end_status_bar = () -> void => unsafe { lyra_imgui_end_status_bar() }

/// The scale [set_ui_scale] last applied, clamped; 1 until it is called.
pub let ui_scale = (host: Host) -> f32 => unsafe { lyra_imgui_host_ui_scale(host) }

// ── The window's own title bar ───────────────────────────────────────────────

/// Whether the host was made with [HOST_CUSTOM_TITLE_BAR], so the program draws the
/// window's title bar ([begin_title_bar]).
pub let has_custom_title_bar = (host: Host) -> bool =>
  unsafe { lyra_imgui_host_custom_title_bar(host) }

/// The main window's title as the system shows it — the Dock, the Window menu, the
/// taskbar — even where the window shows no title bar of the system's.
pub let set_window_title = (host: Host, title: string) -> void =>
  title.with_cstring((t) => unsafe { lyra_imgui_host_set_title(host, t) })

/// The window's buttons drawn as macOS's traffic lights — red, yellow and green circles,
/// their glyphs under the pointer — or, `false`, as glyphs on the bar. A look's choice.
pub let set_traffic_lights = (host: Host, on: bool) -> void =>
  unsafe { lyra_imgui_host_set_traffic_lights(host, on) }

/// The main menu bar as the window's title bar: `begin_main_menu_bar`, and where the host
/// has [HOST_CUSTOM_TITLE_BAR] on macOS, the window's buttons at its left end, in macOS's
/// order — close, minimize, maximize — before the menus that follow. `true` when the bar is
/// drawn: the program's menus go after it, then [end_title_bar]; `false`, and neither.
/// `after_button` is called after each button is drawn with its name — `"Close"`,
/// `"Minimize"`, `"Maximize"` — for a test to find it by.
pub let begin_title_bar = (host: Host, after_button: (string) -> void) -> bool => {
  if !begin_main_menu_bar() { return false }
  if has_custom_title_bar(host) && buttons_on_the_left(host) {
    unsafe { lyra_imgui_title_bar_start(host) }
    window_button(host, WINDOW_CLOSE, after_button)
    window_button(host, WINDOW_MINIMIZE, after_button)
    window_button(host, WINDOW_MAXIMIZE, after_button)
    same_line()
  }
  true
}

/// The rest of the title bar [begin_title_bar] began, after the program's menus, and the
/// bar ended. With [HOST_CUSTOM_TITLE_BAR]: `title` centred on the bar (or left out where
/// the menus leave no room for it), the stretch after the menus the window is moved by —
/// double-clicked, it does what a title bar's double-click does — and off macOS the
/// window's buttons at the right end: minimize, maximize (restore, when it is maximised),
/// close. **Close asks to quit as the system's close button does**: the next [begin_frame]
/// answers false, and [cancel_quit] takes it back.
pub let end_title_bar = (
  host: Host,
  title: string,
  after_button: (string) -> void
) -> void => {
  if has_custom_title_bar(host) {
    let right = !buttons_on_the_left(host)
    let buttons: i32 = if right { 3 } else { 0 }
    title.with_cstring((t) => unsafe { lyra_imgui_title_bar(host, t, buttons) })
    if right {
      window_button(host, WINDOW_MINIMIZE, after_button)
      window_button(host, WINDOW_MAXIMIZE, after_button)
      window_button(host, WINDOW_CLOSE, after_button)
    }
  }
  end_main_menu_bar()
}

/// Which of the window's buttons `lyra_imgui_window_button` draws.
const WINDOW_MINIMIZE: i32 = 0
const WINDOW_MAXIMIZE: i32 = 1
const WINDOW_CLOSE: i32 = 2

/// Whether the window's buttons go at the bar's left end: on macOS, where they always have.
let buttons_on_the_left = (host: Host) -> bool =>
  unsafe { lyra_imgui_host_window_buttons_left(host) }

/// One of the window's buttons, named to `after_button`, and what it does when clicked.
let window_button = (host: Host, kind: i32, after_button: (string) -> void) -> void => {
  let pressed = unsafe { lyra_imgui_window_button(host, kind) }
  if kind == WINDOW_MINIMIZE {
    after_button("Minimize")
    if pressed { unsafe { lyra_imgui_host_minimize(host) } }
  } else if kind == WINDOW_MAXIMIZE {
    after_button("Maximize")
    if pressed { unsafe { lyra_imgui_host_toggle_maximized(host) } }
  } else {
    after_button("Close")
    if pressed { request_quit(host) }
  }
}

/// Whether the main window is maximised (never, headless).
pub let is_maximized = (host: Host) -> bool => unsafe { lyra_imgui_host_maximized(host) }

/// Ask the host to quit, as closing its window does: the next [begin_frame] answers false,
/// and [cancel_quit] takes it back. How a test reaches "unsaved changes?".
pub let request_quit = (host: Host) -> void =>
  unsafe { lyra_imgui_host_request_quit(host) }

/// A file dialog a headless host was asked to show: its tag, and whether it saves.
pub struct DialogRequest {
  tag: i32,
  save: bool,
}

/// The dialog a headless host was last asked to show, once; `None` when none was. A real
/// host shows its dialogs and answers `None`.
pub let take_dialog_request = (host: Host) -> Maybe<DialogRequest> => {
  var tag: i32 = 0
  var save = false
  let c_tag = unsafe { &mut tag }
  let c_save = unsafe { &mut save }
  if unsafe { lyra_imgui_host_take_dialog_request(host, c_tag, c_save) } {
    Some(DialogRequest { tag: tag, save: save })
  } else {
    None
  }
}

/// Queue `answer` as the system's dialog would, for [poll_dialog] to hand back — how a
/// test chooses a file.
pub let answer_dialog = (host: Host, answer: DialogAnswer) -> void => match answer {
  Chosen(tag, path) => queue_answer(host, tag, 0, Some(path)),
  Cancelled(tag) => queue_answer(host, tag, 1, None),
  DialogFailed(tag, why) => queue_answer(host, tag, 2, Some(why)),
}

// ── Colours ──────────────────────────────────────────────────────────────────

/// `IM_COL32(r, g, b, a)`: a packed colour for the draw-list functions
/// (`draw_list.add_rect_filled(p0, p1, col32(255, 0, 0))`).
pub let col32 = pure (r: u8, g: u8, b: u8, a: u8 = 255) -> u32 =>
  (u32(a) << 24) | (u32(b) << 16) | (u32(g) << 8) | u32(r)

// ── Private helpers ──────────────────────────────────────────────────────────

/// The three `input_text`s' one body. The host copies `value` into a buffer ImGui can
/// grow and answers that buffer; it is copied back only when the user changed it.
let edit_text = (
  label: string,
  hint: Maybe<string>,
  value: mut string,
  flags: i32,
  multiline: bool,
  size: Vec2
) -> bool => {
  var changed = false
  let c_changed = unsafe { &mut changed }
  let current = value
  let edited = label.with_cstring((l) => with_maybe_cstring(
    hint,
    (h) => current.with_cstring((v) => unsafe {
      lyra_imgui_input_text(l, h, v, flags, multiline, size, c_changed)
    })
  ))
  if changed { value = from_cstring(edited) }
  changed
}

/// Both dialogs' one body: the filters cross as `name\tpattern` lines, which the host
/// parses into SDL's array and keeps until the answer.
let show_dialog = (
  host: Host,
  tag: i32,
  save: bool,
  filters: []FileFilter,
  default_location: Maybe<string>
) -> bool => {
  let filter_lines = filters.map((f) => "${f.name}\t${f.extensions}\n").join("")
  filter_lines.with_cstring((t) => with_maybe_cstring(
    default_location,
    (d) => unsafe { lyra_imgui_show_file_dialog(host, tag, save, t, d) }
  ))
}

let queue_answer = (host: Host, tag: i32, kind: i32, text: Maybe<string>) -> void =>
  with_maybe_cstring(
    text,
    (t) => unsafe { lyra_imgui_host_queue_dialog_answer(host, tag, kind, t) }
  )

/// Lend `s` to C as a NUL-terminated string, or NULL for `None`.
let with_maybe_cstring = pure (s: Maybe<string>, f: (^u8) -> t) -> t => match s {
  Some(text) => text.with_cstring(f),
  None => f(nullptr),
}

/// Copy a C string ImGui answers into a Lyra string; NULL is `""`.
let from_cstring = pure (p: ^u8) -> string =>
  if p == nullptr { "" } else { unsafe { p.decode_utf8(cstring_len(p)) } }

// ── Externs (host.cpp) ───────────────────────────────────────────────────────

@symbol("lyra_imgui_host_create")
unsafe extern lyra_imgui_host_create: (
  title: ^u8,
  width: i32,
  height: i32,
  flags: u32
) -> Host

@symbol("lyra_imgui_host_begin_frame")
unsafe extern lyra_imgui_host_begin_frame: (host: Host) -> bool

@symbol("lyra_imgui_host_end_frame")
unsafe extern lyra_imgui_host_end_frame: (host: Host, r: f32, g: f32, b: f32) -> void

@symbol("lyra_imgui_host_destroy")
unsafe extern lyra_imgui_host_destroy: (host: Host) -> void

@symbol("lyra_imgui_host_font_file")
unsafe extern lyra_imgui_host_font_file: (
  host: Host,
  path: ^u8,
  size: f32,
  offset_y: f32
) -> Font

@symbol("lyra_imgui_host_set_ui_scale")
unsafe extern lyra_imgui_host_set_ui_scale: (host: Host, scale: f32) -> void

@symbol("lyra_imgui_begin_status_bar")
unsafe extern lyra_imgui_begin_status_bar: (name: ^u8) -> bool

@symbol("lyra_imgui_end_status_bar")
unsafe extern lyra_imgui_end_status_bar: () -> void

@symbol("lyra_imgui_host_custom_title_bar")
unsafe extern lyra_imgui_host_custom_title_bar: (host: Host) -> bool

@symbol("lyra_imgui_host_set_title")
unsafe extern lyra_imgui_host_set_title: (host: Host, title: ^u8) -> void

@symbol("lyra_imgui_host_maximized")
unsafe extern lyra_imgui_host_maximized: (host: Host) -> bool

@symbol("lyra_imgui_host_minimize")
unsafe extern lyra_imgui_host_minimize: (host: Host) -> void

@symbol("lyra_imgui_host_toggle_maximized")
unsafe extern lyra_imgui_host_toggle_maximized: (host: Host) -> void

