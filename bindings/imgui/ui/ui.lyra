// ── The tree ─────────────────────────────────────────────────────────────────

/// One element of an interface: its attributes, and for a container its children. `e` is
/// the program's event type — what choosing, clicking or toggling an element stands for.
pub data Node<e> =
  /// A window; its children are drawn while it is open (not collapsed or off-screen).
  Window(WindowAttrs<e>, []Node<e>)
  /// The main menu bar, across the top of the main viewport; its children are [Menu]s.
  | MainMenuBar([]Node<e>)
  /// A window's own menu bar — its window needs `WINDOW_FLAGS_MENU_BAR`.
  | MenuBar([]Node<e>)
  /// A menu: its title in a bar, or a submenu's item in another menu.
  | Menu(MenuAttrs, []Node<e>)
  | MenuItem(MenuItemAttrs<e>)
  | Button(ButtonAttrs<e>)
  | Checkbox(CheckboxAttrs<e>)
  /// A drop-down: its preview shown closed, its children (`Selectable`s) open.
  | Combo(ComboAttrs, []Node<e>)
  /// A choice in a [Combo] (or a list): its event when picked.
  | Selectable(SelectableAttrs<e>)
  /// One of a set of choices, shown as a round button: its event when picked.
  | Radio(RadioAttrs<e>)
  /// A whole number typed or stepped: `on_change` with the new value as it is edited,
  /// `on_commit` when the edit is done.
  | InputInt(InputIntAttrs<e>)
  /// A line of text typed: `on_change` with the new text as it is edited, `on_commit`
  /// when the edit is done.
  | InputText(InputTextAttrs<e>)
  /// A number dragged along a bar between two ends: `on_change` with the new value as it is
  /// dragged, `on_commit` when it is let go.
  | Slider(SliderAttrs<e>)
  /// A color's swatch, which opens ImGui's picker when clicked: `on_change` with the new
  /// color as it is picked, `on_commit` when the edit is done.
  | ColorEdit(ColorEditAttrs<e>)
  /// A modal popup over the window, **open while it is in the tree**: put it there to
  /// show it, leave it out to have it gone. A `closes` button in it closes it as it is
  /// clicked; Escape is its `on_escape`.
  | Modal(ModalAttrs<e>, []Node<e>)
  /// Where the caller draws something of its own (a picture, a canvas): `seen` is called
  /// with it at its place, in the window as it stands there.
  | Slot(string)
  /// Labelled fields lined up: each [Field]'s label right-aligned in a column as wide as
  /// the widest, its controls starting together past it.
  | Form([]Node<e>)
  /// A label and its controls on one line — in a [Form], in its column.
  | Field(FieldAttrs, []Node<e>)
  | Text(TextAttrs)
  | Separator
  /// A line with a label in it.
  | SeparatorText(string)
  /// Its children side by side, rather than each on a line of its own.
  | Row([]Node<e>)
  /// A component's elements: its [Sheet] styles them, and nothing outside them.
  | Component(Sheet, []Node<e>)
  /// Its children as they are, in place — several elements where one is expected (a
  /// markup loop's body), with no layout or style of its own.
  | Fragment([]Node<e>)

pub struct WindowAttrs<e> {
  title: string,
  /// What the window's close button stands for; `None`, no close button.
  on_close: Maybe<e> = None,
  /// `WINDOW_FLAGS_*`, combined with `|`.
  flags: i32 = 0,
  /// Opened in the middle of the main viewport (each time it appears).
  centered: bool = false,
  /// Its classes, space-separated, for a [Sheet]'s selectors: `"primary wide"`.
  class: string = "",
  /// `width` and `height` are its size on first use; ImGui remembers it after.
  style: Style = Style {},
}

pub struct MenuAttrs {
  label: string,
  /// A menu greyed out cannot be opened.
  enabled: bool = true,
  /// Its classes, space-separated, for a [Sheet]'s selectors: `"primary wide"`.
  class: string = "",
  style: Style = Style {},
}

pub struct MenuItemAttrs<e> {
  label: string,
  on_select: e,
  /// What a program's own tests or tools know it by; `""`, its label.
  id: string = "",
  /// Shown beside the label, and pressed from anywhere with [pressed_shortcut].
  shortcut: Maybe<Shortcut> = None,
  checked: bool = false,
  enabled: bool = true,
  /// Its classes, space-separated, for a [Sheet]'s selectors: `"primary wide"`.
  class: string = "",
  style: Style = Style {},
}

pub struct ButtonAttrs<e> {
  label: string,
  on_click: e,
  enabled: bool = true,
  /// In a [Modal], it closes the modal as it is clicked.
  closes: bool = false,
  /// What a program's own tests or tools know it by; `""`, its label.
  id: string = "",
  /// Its classes, space-separated, for a [Sheet]'s selectors: `"primary wide"`.
  class: string = "",
  /// `width` and `height` size it; unset, it fits its label.
  style: Style = Style {},
}

pub struct CheckboxAttrs<e> {
  label: string,
  checked: bool,
  /// The checkbox does not write `checked`: a click is this event, and the program flips it.
  on_toggle: e,
  enabled: bool = true,
  /// What a program's own tests or tools know it by; `""`, its label.
  id: string = "",
  /// Its classes, space-separated, for a [Sheet]'s selectors: `"primary wide"`.
  class: string = "",
  style: Style = Style {},
}

pub struct ComboAttrs {
  /// ImGui's label: shown beside it, and its identity (`##scale` hides the text).
  label: string,
  /// What it shows while closed: the chosen option's label.
  preview: string,
  /// What a program's own tests or tools know it by; `""`, its label.
  id: string = "",
  class: string = "",
  /// `width` (or `width_em`) is the field's.
  style: Style = Style {},
}

pub struct SelectableAttrs<e> {
  label: string,
  /// Shown chosen.
  selected: bool = false,
  on_select: e,
  /// What a program's own tests or tools know it by; `""`, its label.
  id: string = "",
  class: string = "",
  style: Style = Style {},
}

pub struct RadioAttrs<e> {
  label: string,
  /// Shown chosen.
  selected: bool = false,
  on_select: e,
  /// What a program's own tests or tools know it by; `""`, its label.
  id: string = "",
  enabled: bool = true,
  class: string = "",
  style: Style = Style {},
}

/// **Change and commit**: the widget does not write `value` — each edit is `on_change` with
/// the value it would now hold, which the program keeps (or refuses); a keystroke, a click
/// on a step, each frame a step is held. When the edit is over — Enter, or the focus gone
/// after a change — `on_commit` follows, once: where an undo step or a save belongs.
pub struct InputIntAttrs<e> {
  /// ImGui's label: beside it, and its identity (`##width` hides the text).
  label: string,
  value: i64,
  /// What the − and + buttons add; 0 shows none.
  step: i64 = 1,
  on_change: (i64) -> e,
  on_commit: Maybe<e> = None,
  /// What a program's own tests or tools know it by; `""`, its label.
  id: string = "",
  enabled: bool = true,
  class: string = "",
  /// `width` (or `width_em`) is the field's.
  style: Style = Style {},
}

/// As [InputIntAttrs], over a line of text.
pub struct InputTextAttrs<e> {
  label: string,
  value: string,
  /// Shown greyed while `value` is empty: what to type there.
  hint: string = "",
  on_change: (string) -> e,
  on_commit: Maybe<e> = None,
  id: string = "",
  enabled: bool = true,
  class: string = "",
  style: Style = Style {},
}

/// As [InputIntAttrs], over a number between `min` and `max`, dragged along a bar (or typed,
/// Ctrl-clicked); one typed past either end is that end. `format` is how the bar shows it,
/// printf's way: `"%.0f pt"`.
pub struct SliderAttrs<e> {
  label: string,
  value: f32,
  min: f32,
  max: f32,
  format: string = "%.3f",
  on_change: (f32) -> e,
  on_commit: Maybe<e> = None,
  id: string = "",
  enabled: bool = true,
  class: string = "",
  /// `width` (or `width_em`) is the bar's.
  style: Style = Style {},
}

/// As [InputIntAttrs], over a color, `0xRRGGBB` as people write them (not [col32]'s byte
/// order; [rgb_channels] and [rgb_of] convert). Its swatch opens ImGui's picker, and with
/// `inputs` its three channels are fields beside it.
pub struct ColorEditAttrs<e> {
  label: string,
  value: u32,
  inputs: bool = true,
  on_change: (u32) -> e,
  on_commit: Maybe<e> = None,
  id: string = "",
  enabled: bool = true,
  class: string = "",
  style: Style = Style {},
}

pub struct ModalAttrs<e> {
  /// Its title, and its identity: `Import PNG###import` keeps one popup as the title changes.
  title: string,
  /// `WINDOW_FLAGS_*`, combined with `|`.
  flags: i32 = 0,
  /// What Escape stands for, which also closes it; `None`, Escape does nothing.
  on_escape: Maybe<e> = None,
  class: string = "",
  style: Style = Style {},
}

pub struct FieldAttrs {
  label: string,
  class: string = "",
  /// The label's.
  style: Style = Style {},
}

pub struct TextAttrs {
  text: string,
  /// Greyed: the theme's disabled text colour.
  disabled: bool = false,
  /// Wrapped at the window's edge rather than running past it.
  wrapped: bool = false,
  /// Its classes, space-separated, for a [Sheet]'s selectors: `"primary wide"`.
  class: string = "",
  style: Style = Style {},
}

/// A menu item's key, held with the primary modifier — Cmd on macOS, Ctrl elsewhere:
/// `"n"`, `","`, or a key by its name (`"PgUp"`, `"PgDn"`). [key_known] says whether ImGui
/// can press it.
pub struct Shortcut {
  key: string,
  shift: bool = false,
  /// Alt (Option on a Mac) held too.
  alt: bool = false,
  /// The primary modifier held; `false` for a key of Alt's alone (`Alt+1`).
  primary: bool = true,
}

/// How an element looks, in its own terms; a field unset leaves the theme's (or an
/// enclosing element's). Pushed for the element and everything inside it.
pub struct Style {
  /// Text colour, `col32(r, g, b)`.
  color: Maybe<u32> = None,
  /// Fill: a button's face, a checkbox's box, a menu item's highlight, a window's or a
  /// menu's background. A button's and checkbox's hovered and pressed fills are shades of it.
  background: Maybe<u32> = None,
  /// Space inside the edge: a button's or checkbox's frame, a window's or menu's border.
  padding: Maybe<Vec2> = None,
  /// Corner radius of the same.
  rounding: Maybe<f32> = None,
  /// 0–1, multiplied into the opacity already in force.
  opacity: Maybe<f32> = None,
  /// A button's, combo's or window's size, in pixels; unset, the element's own.
  width: Maybe<f32> = None,
  height: Maybe<f32> = None,
  /// The width in ems, the font's size: it grows with the interface. `width` wins.
  width_em: Maybe<f32> = None,
}

/// A component's styles: rules matched against its own elements.
pub struct Sheet {
  rules: []StyleRule = [],
}

/// `style` for every element `selector` matches: `Button`, `.primary` or `Button.primary`.
pub struct StyleRule {
  selector: string,
  style: Style,
}

impl Style {
  /// This style laid over `base`: each field this one sets, else `base`'s.
  pub let over = pure (self, base: Style) -> Style => Style {
    color: self.color.or(base.color),
    background: self.background.or(base.background),
    padding: self.padding.or(base.padding),
    rounding: self.rounding.or(base.rounding),
    opacity: self.opacity.or(base.opacity),
    width: self.width.or(base.width),
    height: self.height.or(base.height),
    width_em: self.width_em.or(base.width_em),
  }
}

impl Sheet {
  /// The style this sheet gives an element of `tag` with `classes`, its inline `style`
  /// laid over it: matching rules applied least specific first, a later one after an
  /// earlier of the same specificity.
  pub let style_for = pure (
    self,
    tag: string,
    classes: string,
    inline: Style
  ) -> Style => {
    var out = Style {}
    for rank in [1, 10, 11] {
      for rule in self.rules {
        if specificity(rule.selector, tag, classes) == rank { out = rule.style.over(out) }
      }
    }
    inline.over(out)
  }
}

// ── Drawing ──────────────────────────────────────────────────────────────────

impl []Node<e> {
  /// `nodes` drawn; the events of this frame, in the order drawn. `seen` is called with each
  /// element just after ImGui has it as its last item — a menu's or window's header, before
  /// its children — which is where a caller asks ImGui about it (`get_item_rect_min`).
  pub let render = (self, seen: (Node<e>) -> void) -> []e => {
    var events: []e = []
    for node in self { draw(node, Sheet {}, seen, events) }
    events
  }

  /// The enabled menu item in `nodes` whose shortcut was pressed this frame, if one was —
  /// a menu's keys working while the menu is closed, which ImGui's own do not.
  pub let pressed_shortcut = (self) -> Maybe<e> => {
    for it in menu_items(self) {
      if !it.enabled { continue }
      let Some(s) = it.shortcut else { continue }
      let Some(key) = imgui_key(s.key) else { continue }
      let chord = key |
        (if s.primary { MOD_CTRL } else { 0 }) |
        (if s.shift { MOD_SHIFT } else { 0 }) |
        (if s.alt { MOD_ALT } else { 0 })
      if is_key_chord_pressed(chord) { return Some(it.on_select) }
    }
    None
  }

  /// Every menu item in `nodes`, at any depth, in the order drawn.
  pub let menu_items = pure (self) -> []MenuItemAttrs<e> => {
    var out: []MenuItemAttrs<e> = []
    for node in self { collect_items(node, out) }
    out
  }
}

/// How a shortcut is spelled beside its item: `Cmd+Shift+S`, `Ctrl+O`.
pub let shortcut_text = (s: Shortcut) -> string => {
  var parts: []string = []
  if s.primary { parts.push(primary_key_name()) }
  if s.alt { parts.push("Alt") }
  if s.shift { parts.push("Shift") }
  // A key named is shown as named; a character, capitalised.
  parts.push(if s.key.len() == 1 { s.key.to_ascii_upper() } else { s.key })
  parts.join("+")
}

/// `"Cmd"` on macOS, where ImGui reads Command as its Ctrl modifier; `"Ctrl"` elsewhere.
pub let primary_key_name = () -> string =>
  if get_io().config_mac_osx_behaviors() { "Cmd" } else { "Ctrl" }

/// Whether ImGui has a key for a [Shortcut]'s `key` — one it does not can never be pressed.
pub let key_known = pure (key: string) -> bool => imgui_key(key).is_some()

/// `0xRRGGBB` as the three channels ImGui's color editors edit, 0 to 1.
pub let rgb_channels = pure (rgb: u32) -> [3]f32 => #[
  f32((rgb >> 16) & 0xFF) / 255.0,
  f32((rgb >> 8) & 0xFF) / 255.0,
  f32(rgb & 0xFF) / 255.0,
]

/// Three channels, 0 to 1 (outside it, the nearer end), as `0xRRGGBB`.
pub let rgb_of = pure (c: [3]f32) -> u32 => {
  let r = u32((c[0].clamp(0.0, 1.0) * 255.0).round())
  let g = u32((c[1].clamp(0.0, 1.0) * 255.0).round())
  let b = u32((c[2].clamp(0.0, 1.0) * 255.0).round())
  (r << 16) | (g << 8) | b
}

/// The menu item's id: its own, else its label.
pub let item_id = pure (it: MenuItemAttrs<e>) -> string =>
  if it.id.len() > 0 { it.id } else { it.label }

// ── Each element ─────────────────────────────────────────────────────────────

impl Node<e> {
  /// What a program knows `node` by: its `id` where it has one (an empty one, its label),
  /// else `""` — for a `seen` that names what it is shown (`probe(node_id(node))`).
  pub let node_id = pure (self) -> string => match self {
    MenuItem(it) => item_id(it),
    Button(b) => if b.id.len() > 0 { b.id } else { b.label },
    Checkbox(c) => if c.id.len() > 0 { c.id } else { c.label },
    Combo(c, _) => if c.id.len() > 0 { c.id } else { c.label },
    Selectable(o) => if o.id.len() > 0 { o.id } else { o.label },
    Radio(r) => if r.id.len() > 0 { r.id } else { r.label },
    InputInt(i) => if i.id.len() > 0 { i.id } else { i.label },
    InputText(i) => if i.id.len() > 0 { i.id } else { i.label },
    Slider(sl) => if sl.id.len() > 0 { sl.id } else { sl.label },
    ColorEdit(c) => if c.id.len() > 0 { c.id } else { c.label },
    _ => "",
  }

  let draw = (
    self,
    sheet: Sheet,
    seen: (Node<e>) -> void,
    events: mut []e
  ) -> void =>
    match self {
      Window(w, children) => {
        let style = sheet.style_for("Window", w.class, w.style)
        let pushed = push_style(style, WindowPart)
        let width = width_of(style)
        if width.is_some() || style.height.is_some() {
          set_next_window_size(
            Vec2 { x: width.unwrap_or(0.0), y: style.height.unwrap_or(0.0) },
            COND_FIRST_USE_EVER
          )
        }
        if w.centered {
          set_next_window_pos(
            get_main_viewport().get_center(),
            COND_APPEARING,
            Vec2 { x: 0.5, y: 0.5 }
          )
        }
        var open = true
        let visible = match w.on_close {
          Some(_) => begin_closable(w.title, open, w.flags),
          None => begin(w.title, w.flags),
        }
        seen(self)
        if visible { for child in children { draw(child, sheet, seen, events) } }
        end()
        pop_style(pushed)
        if !open { if let Some(event) = w.on_close { events.push(event) } }
      },
      MainMenuBar(children) => {
        if begin_main_menu_bar() {
          for child in children { draw(child, sheet, seen, events) }
          end_main_menu_bar()
        }
      },
      MenuBar(children) => {
        if begin_menu_bar() {
          for child in children { draw(child, sheet, seen, events) }
          end_menu_bar()
        }
      },
      Menu(m, children) => {
        let style = sheet.style_for("Menu", m.class, m.style)
        let pushed = push_style(style, MenuPart)
        let open = begin_menu(m.label, m.enabled)
        seen(self)
        if open {
          for child in children { draw(child, sheet, seen, events) }
          end_menu()
        }
        pop_style(pushed)
      },
      MenuItem(it) => {
        let style = sheet.style_for("MenuItem", it.class, it.style)
        let pushed = push_style(style, ItemPart)
        let shortcut = match it.shortcut {
          Some(s) => Some(shortcut_text(s)),
          None => None,
        }
        let picked = menu_item(it.label, shortcut, it.checked, it.enabled)
        seen(self)
        pop_style(pushed)
        if picked { events.push(it.on_select) }
      },
      Button(b) => {
        let style = sheet.style_for("Button", b.class, b.style)
        let pushed = push_style(style, FramePart)
        let size = Vec2 {
          x: width_of(style).unwrap_or(0.0),
          y: style.height.unwrap_or(0.0)
        }
        begin_disabled(!b.enabled)
        let clicked = button(b.label, size)
        end_disabled()
        seen(self)
        pop_style(pushed)
        if clicked {
          events.push(b.on_click)
          if b.closes { close_current_popup() }
        }
      },
      Checkbox(c) => {
        let style = sheet.style_for("Checkbox", c.class, c.style)
        let pushed = push_style(style, FramePart)
        var value = c.checked
        begin_disabled(!c.enabled)
        let toggled = checkbox(c.label, value)
        end_disabled()
        seen(self)
        pop_style(pushed)
        if toggled { events.push(c.on_toggle) }
      },
      Combo(c, children) => {
        let style = sheet.style_for("Combo", c.class, c.style)
        let pushed = push_style(style, FramePart)
        if let Some(w) = width_of(style) { set_next_item_width(w) }
        let open = begin_combo(c.label, c.preview)
        seen(self)
        if open {
          for child in children { draw(child, sheet, seen, events) }
          end_combo()
        }
        pop_style(pushed)
      },
      Selectable(o) => {
        let style = sheet.style_for("Selectable", o.class, o.style)
        let pushed = push_style(style, ItemPart)
        let picked = selectable(o.label, o.selected)
        seen(self)
        pop_style(pushed)
        if picked { events.push(o.on_select) }
      },
      Radio(r) => {
        let style = sheet.style_for("Radio", r.class, r.style)
        let pushed = push_style(style, FramePart)
        begin_disabled(!r.enabled)
        let picked = radio_button(r.label, r.selected)
        end_disabled()
        seen(self)
        pop_style(pushed)
        if picked { events.push(r.on_select) }
      },
      InputInt(i) => {
        let style = sheet.style_for("InputInt", i.class, i.style)
        let pushed = push_style(style, FramePart)
        if let Some(w) = width_of(style) { set_next_item_width(w) }
        var value = i32(i.value)
        begin_disabled(!i.enabled)
        let changed = input_int(i.label, value, i32(i.step))
        let done = is_item_deactivated_after_edit()
        end_disabled()
        seen(self)
        pop_style(pushed)
        if changed { events.push(i.on_change(i64(value))) }
        if done { if let Some(event) = i.on_commit { events.push(event) } }
      },
      InputText(i) => {
        let style = sheet.style_for("InputText", i.class, i.style)
        let pushed = push_style(style, FramePart)
        if let Some(w) = width_of(style) { set_next_item_width(w) }
        var value = i.value
        begin_disabled(!i.enabled)
        let changed = if i.hint.len() > 0 {
          input_text_with_hint(i.label, i.hint, value)
        } else {
          input_text(i.label, value)
        }
        let done = is_item_deactivated_after_edit()
        end_disabled()
        seen(self)
        pop_style(pushed)
        if changed { events.push(i.on_change(value)) }
        if done { if let Some(event) = i.on_commit { events.push(event) } }
      },
      Slider(sl) => {
        let style = sheet.style_for("Slider", sl.class, sl.style)
        let pushed = push_style(style, FramePart)
        if let Some(w) = width_of(style) { set_next_item_width(w) }
        var value = sl.value
        begin_disabled(!sl.enabled)
        let changed = slider_float(
          sl.label,
          value,
          sl.min,
          sl.max,
          sl.format,
          SLIDER_FLAGS_ALWAYS_CLAMP
        )
        let done = is_item_deactivated_after_edit()
        end_disabled()
        seen(self)
        pop_style(pushed)
        if changed { events.push(sl.on_change(value)) }
        if done { if let Some(event) = sl.on_commit { events.push(event) } }
      },
      ColorEdit(c) => {
        let style = sheet.style_for("ColorEdit", c.class, c.style)
        let pushed = push_style(style, FramePart)
        if let Some(w) = width_of(style) { set_next_item_width(w) }
        var channels = rgb_channels(c.value)
        begin_disabled(!c.enabled)
        let changed = color_edit3(
          c.label,
          channels,
          if c.inputs { 0 } else { COLOR_EDIT_FLAGS_NO_INPUTS }
        )
        let done = is_item_deactivated_after_edit()
        end_disabled()
        seen(self)
        pop_style(pushed)
        if changed { events.push(c.on_change(rgb_of(channels))) }
        if done { if let Some(event) = c.on_commit { events.push(event) } }
      },
      Modal(m, children) => {
        let style = sheet.style_for("Modal", m.class, m.style)
        let pushed = push_style(style, WindowPart)
        if !is_popup_open(m.title) { let _ = open_popup(m.title) }
        if begin_popup_modal(m.title, m.flags) {
          for child in children { draw(child, sheet, seen, events) }
          if let Some(event) = m.on_escape {
            if is_key_pressed(KEY_ESCAPE) {
              events.push(event)
              close_current_popup()
            }
          }
          end_popup()
        }
        pop_style(pushed)
      },
      Slot(_) => seen(self),
      Form(children) => {
        var column: f32 = 0.0
        for child in children {
          if let Field(f, _) = child { column = column.max(calc_text_size(f.label).x) }
        }
        for child in children {
          match child {
            Field(f, fields) => draw_field(child, f, fields, column, sheet, seen, events),
            _ => draw(child, sheet, seen, events),
          }
        }
      },
      Field(f, fields) =>
        draw_field(self, f, fields, calc_text_size(f.label).x, sheet, seen, events),
      Text(t) => {
        let style = sheet.style_for("Text", t.class, t.style)
        let pushed = push_style(style, TextPart)
        if t.disabled {
          text_disabled(t.text)
        } else if t.wrapped {
          text_wrapped(t.text)
        } else {
          text(t.text)
        }
        seen(self)
        pop_style(pushed)
      },
      Separator => separator(),
      SeparatorText(label) => separator_text(label),
      Row(children) => {
        for i, child in children {
          if i > 0 { same_line() }
          draw(child, sheet, seen, events)
        }
      },
      // Its own sheet in place of the enclosing one: selectors stop at the boundary.
      Component(own, children) => { for child in children { draw(child, own, seen, events) } },
      Fragment(children) => { for child in children { draw(child, sheet, seen, events) } },
    }

  /// A field's label right-aligned in a `column` that wide, on its controls' line, and its
  /// controls side by side after it.
  let draw_field = (
    self,
    f: FieldAttrs,
    fields: []Node<e>,
    column: f32,
    sheet: Sheet,
    seen: (Node<e>) -> void,
    events: mut []e
  ) -> void => {
    let style = sheet.style_for("Field", f.class, f.style)
    let pushed = push_style(style, TextPart)
    set_cursor_pos_x(get_cursor_pos_x() + column - calc_text_size(f.label).x)
    align_text_to_frame_padding()
    text(f.label)
    seen(self)
    pop_style(pushed)
    for child in fields {
      same_line()
      draw(child, sheet, seen, events)
    }
  }

  let collect_items = (self, out: mut []MenuItemAttrs<e>) -> void => match self {
    MenuItem(it) => out.push(it),
    Window(_, children) => { for child in children { collect_items(child, out) } },
    MainMenuBar(children) => { for child in children { collect_items(child, out) } },
    MenuBar(children) => { for child in children { collect_items(child, out) } },
    Menu(_, children) => { for child in children { collect_items(child, out) } },
    Row(children) => { for child in children { collect_items(child, out) } },
    Component(_, children) => { for child in children { collect_items(child, out) } },
    Fragment(children) => { for child in children { collect_items(child, out) } },
    Combo(_, children) => { for child in children { collect_items(child, out) } },
    Modal(_, children) => { for child in children { collect_items(child, out) } },
    Form(children) => { for child in children { collect_items(child, out) } },
    Field(_, children) => { for child in children { collect_items(child, out) } },
    _ => {},
  }
}

impl Style {
  /// A style's width in pixels: `width`, else `width_em` ems of the current font.
  let width_of = (self) -> Maybe<f32> => match self.width {
    Some(w) => Some(w),
    None => self.width_em.map((em) => em * get_font_size()),
  }

  /// `style` pushed for an element of `part`.
  let push_style = (self, part: Part) -> Pushed => {
    var colors: i32 = 0
    var vars: i32 = 0
    if let Some(c) = self.color {
      push_style_color(COL_TEXT, c)
      colors += 1
    }
    if let Some(fill) = self.background {
      for (slot, color) in fills(part, fill) {
        push_style_color(slot, color)
        colors += 1
      }
    }
    if let Some(o) = self.opacity {
      push_style_var(STYLE_VAR_ALPHA, get_style().alpha() * o)
      vars += 1
    }
    if let Some(p) = self.padding {
      match part {
        WindowPart => { push_style_var_vec2(STYLE_VAR_WINDOW_PADDING, p); vars += 1 },
        MenuPart => { push_style_var_vec2(STYLE_VAR_WINDOW_PADDING, p); vars += 1 },
        FramePart => { push_style_var_vec2(STYLE_VAR_FRAME_PADDING, p); vars += 1 },
        _ => {},
      }
    }
    if let Some(r) = self.rounding {
      match part {
        WindowPart => { push_style_var(STYLE_VAR_WINDOW_ROUNDING, r); vars += 1 },
        MenuPart => { push_style_var(STYLE_VAR_POPUP_ROUNDING, r); vars += 1 },
        FramePart => { push_style_var(STYLE_VAR_FRAME_ROUNDING, r); vars += 1 },
        _ => {},
      }
    }
    Pushed { colors: colors, vars: vars }
  }
}

// ── Style ────────────────────────────────────────────────────────────────────

/// How specific `selector` is for an element of `tag` with `classes` (space-separated):
/// 1 for its tag, 10 for one of its classes, 11 for both; 0 when it does not match.
let specificity = pure (selector: string, tag: string, classes: string) -> i64 => {
  let parts = selector.split(".")
  if parts.len() > 2 { return 0 }
  let want_tag = parts[0]
  let want_class = if parts.len() == 2 { parts[1] } else { "" }
  if want_tag.len() > 0 && want_tag != tag { return 0 }
  if want_class.len() > 0 && classes
    .split(" ")
    .filter((c) => c == want_class)
    .len() == 0 {
    return 0
  }
  (if want_tag.len() > 0 { 1 } else { 0 }) + (if want_class.len() > 0 { 10 } else { 0 })
}

/// Which of ImGui's colours and sizes a [Style]'s fields mean, by the kind of element.
data Part = WindowPart | MenuPart | ItemPart | FramePart | TextPart

/// How many colours and variables [push_style] pushed, for [pop_style].
struct Pushed {
  colors: i32,
  vars: i32,
}

let pop_style = (pushed: Pushed) -> void => {
  if pushed.colors > 0 { pop_style_color(pushed.colors) }
  if pushed.vars > 0 { pop_style_var(pushed.vars) }
}

/// The colours a `background` sets for an element of `part`: a frame's hovered and
/// pressed fills are lighter shades of it.
let fills = pure (part: Part, fill: u32) -> [](i32, u32) => match part {
  WindowPart => [(COL_WINDOW_BG, fill)],
  MenuPart => [(COL_POPUP_BG, fill)],
  ItemPart => [(COL_HEADER_HOVERED, fill)],
  FramePart => [
    (COL_BUTTON, fill),
    (COL_BUTTON_HOVERED, lighter(fill, 24)),
    (COL_BUTTON_ACTIVE, lighter(fill, 48)),
    (COL_FRAME_BG, fill),
    (COL_FRAME_BG_HOVERED, lighter(fill, 24)),
    (COL_FRAME_BG_ACTIVE, lighter(fill, 48)),
  ],
  TextPart => [],
}

/// `color` (`col32`) with `amount` added to each of red, green and blue; alpha kept.
let lighter = pure (color: u32, amount: u32) -> u32 => {
  var out = color & 0xFF000000
  for shift in [0, 8, 16] {
    let channel = (color >> u32(shift)) & 0xFF
    out = out | ((channel + amount).min(255) << u32(shift))
  }
  out
}

/// ImGui's key for a [Shortcut]'s `key`; `None` for one it does not have.
let imgui_key = pure (key: string) -> Maybe<i32> => match key {
  "a" => Some(KEY_A),
  "b" => Some(KEY_B),
  "c" => Some(KEY_C),
  "d" => Some(KEY_D),
  "e" => Some(KEY_E),
  "f" => Some(KEY_F),
  "g" => Some(KEY_G),
  "h" => Some(KEY_H),
  "i" => Some(KEY_I),
  "j" => Some(KEY_J),
  "k" => Some(KEY_K),
  "l" => Some(KEY_L),
  "m" => Some(KEY_M),
  "n" => Some(KEY_N),
  "o" => Some(KEY_O),
  "p" => Some(KEY_P),
  "q" => Some(KEY_Q),
  "r" => Some(KEY_R),
  "s" => Some(KEY_S),
  "t" => Some(KEY_T),
  "u" => Some(KEY_U),
  "v" => Some(KEY_V),
  "w" => Some(KEY_W),
  "x" => Some(KEY_X),
  "y" => Some(KEY_Y),
  "z" => Some(KEY_Z),
  "0" => Some(KEY_0),
  "1" => Some(KEY_1),
  "2" => Some(KEY_2),
  "3" => Some(KEY_3),
  "4" => Some(KEY_4),
  "5" => Some(KEY_5),
  "6" => Some(KEY_6),
  "7" => Some(KEY_7),
  "8" => Some(KEY_8),
  "9" => Some(KEY_9),
  "," => Some(KEY_COMMA),
  "." => Some(KEY_PERIOD),
  "=" => Some(KEY_EQUAL),
  "-" => Some(KEY_MINUS),
  "/" => Some(KEY_SLASH),
  "PgUp" => Some(KEY_PAGE_UP),
  "PgDn" => Some(KEY_PAGE_DOWN),
  _ => None,
}
