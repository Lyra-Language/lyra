module bindings.raylib
//! Shaders — a GL program of your own, and the texture slots raylib feeds it.
//!
//! **raylib draws a model unlit unless it is given a shader.** The default one is
//! `finalColor = texel * colDiffuse * vertexColor` — read out of the library itself — so
//! there is no light at all, and the normal, occlusion, metallic-roughness and emission
//! textures a glTF file carries are loaded into the material and then never sampled. A
//! model looks flat, or wrong, for that reason alone. [set_model_material_shader] is how a
//! program replaces it.
//!
//! **What raylib supplies without being asked.** `LoadShaderFromMemory` looks up a fixed
//! set of names, and `DrawMesh` uploads each one it found: the attributes `vertexPosition`,
//! `vertexTexCoord`, `vertexTexCoord2`, `vertexNormal`, `vertexTangent` and `vertexColor`;
//! the matrices `mvp`, `matModel`, `matView`, `matProjection` and `matNormal`; the colour
//! `colDiffuse`; and the samplers `texture0`, `texture1` and `texture2` for the albedo,
//! metalness and normal slots. A shader written against those names needs nothing more.
//! Any other slot needs [bind_shader_map] to say which sampler receives it.
//!
//! **A uniform of the program's own is set by type** — [set_shader_float] through
//! [set_shader_vec4], their arrays, [set_shader_int], [set_shader_matrix] and
//! [set_shader_texture] — at the location [shader_location] found. raylib's
//! `SetShaderValue` takes a `const void *`; each setter hands it its value's address as
//! `^u8` (`pointer_at(p.address())`) with the uniform type that matches, so a `vec3` is
//! never sent as four floats.
//!
//! **A uniform reaches every draw of a shader mode, as its last value.** raylib batches 2D
//! draws and sends them at [end_shader_mode]; a uniform changed between two rectangles in
//! one mode reaches both with the second value (measured). To draw with two values, end
//! the mode and begin it again between them. A mesh is drawn at once ([draw_model],
//! [draw_mesh]), so there a uniform set between two draws reaches only the second.

import std.ffi.{ with_cstrings }

/// Compile a shader from GLSL source, or `None` if it did not compile and link — raylib
/// logs the compiler's message — or there is no window.
///
/// **A failed compile does not look like a failure to raylib**: it answers the default
/// shader in its place, a valid program that draws unlit. Testing for that is what makes
/// the failure a `None` rather than a model that silently stayed flat.
pub let load_shader_from_memory = (vertex: string, fragment: string) -> Maybe<Shader> => {
  if !window_ready() { return None }
  let s = with_cstrings(
    vertex,
    fragment,
    (v, f) => unsafe { rl_load_shader_from_memory(v, f) }
  )
  if s.id != 0 && s.id != unsafe { rl_shader_id_default() } { Some(s) } else { None }
}

/// Whether a shader is a live GPU program.
pub let shader_valid = (shader: Shader) -> bool => unsafe { rl_shader_valid(shader) } != 0

/// The location of a uniform, or `None` where the shader has none of that name — which
/// includes one it declares and never reads, since GLSL drops those.
pub let shader_location = (shader: Shader, uniform: string) -> Maybe<i32> => {
  let loc = uniform.with_cstring((u) => unsafe { rl_shader_location(shader, u) })
  if loc < 0 { None } else { Some(loc) }
}

/// Feed one of a material's texture slots — a `MATERIAL_MAP_*` constant — to the sampler
/// named `uniform`. `false` where the shader has no such sampler.
///
/// raylib binds slot `i`'s texture to texture unit `i` and sets the sampler it finds at
/// location `SHADER_LOC_MAP_ALBEDO + i`; only the first three have names it looks up
/// itself (`texture0`..`texture2`), so occlusion, emission and the rest reach a shader only
/// through this.
pub let bind_shader_map = (shader: Shader, map: i32, uniform: string) -> bool => {
  if i64(map) < 0 || i64(map) >= MATERIAL_MAP_COUNT {
    panic("material map ${map} out of range for ${MATERIAL_MAP_COUNT} slots")
  }
  match shader_location(shader, uniform) {
    Some(loc) => {
      unsafe { shader.locs.offset(SHADER_LOC_MAP_ALBEDO + i64(map))^ = loc }
      true
    },
    None => false,
  }
}

/// Free a shader's GPU program. [unload_model] does not, since one shader is usually drawn
/// with by several models: unload it after the last of them.
pub let unload_shader = (shader: Shader) -> void => unsafe { rl_unload_shader(shader) }

// ---------------------------------------------------------------------------------------
// Uniform values
//
// `loc` is from [shader_location]; a negative one is ignored by raylib, as GL ignores it.
// A value holds until it is set again — a program keeps its uniforms between draws.
// ---------------------------------------------------------------------------------------

pub let set_shader_float = (shader: Shader, loc: i32, value: f32) -> void =>
  unsafe {
    rl_set_shader_value(shader, loc, pointer_at((&value).address()), UNIFORM_FLOAT)
  }

pub let set_shader_vec2 = (shader: Shader, loc: i32, value: Vector2) -> void =>
  unsafe {
    rl_set_shader_value(shader, loc, pointer_at((&value).address()), UNIFORM_VEC2)
  }

pub let set_shader_vec3 = (shader: Shader, loc: i32, value: Vector3) -> void =>
  unsafe {
    rl_set_shader_value(shader, loc, pointer_at((&value).address()), UNIFORM_VEC3)
  }

pub let set_shader_vec4 = (shader: Shader, loc: i32, value: Vector4) -> void =>
  unsafe {
    rl_set_shader_value(shader, loc, pointer_at((&value).address()), UNIFORM_VEC4)
  }

/// An `int` uniform — and a sampler's texture unit, which GLSL sets as one.
pub let set_shader_int = (shader: Shader, loc: i32, value: i32) -> void =>
  unsafe { rl_set_shader_value(shader, loc, pointer_at((&value).address()), UNIFORM_INT) }

/// A `float name[n]` uniform, from its first element: `values.len()` of them are set.
pub let set_shader_floats = (shader: Shader, loc: i32, values: []f32) -> void =>
  set_values(shader, loc, unsafe { values.data().address() }, UNIFORM_FLOAT, values.len())

pub let set_shader_vec2s = (shader: Shader, loc: i32, values: []Vector2) -> void =>
  set_values(shader, loc, unsafe { values.data().address() }, UNIFORM_VEC2, values.len())

pub let set_shader_vec3s = (shader: Shader, loc: i32, values: []Vector3) -> void =>
  set_values(shader, loc, unsafe { values.data().address() }, UNIFORM_VEC3, values.len())

pub let set_shader_vec4s = (shader: Shader, loc: i32, values: []Vector4) -> void =>
  set_values(shader, loc, unsafe { values.data().address() }, UNIFORM_VEC4, values.len())

pub let set_shader_ints = (shader: Shader, loc: i32, values: []i32) -> void =>
  set_values(shader, loc, unsafe { values.data().address() }, UNIFORM_INT, values.len())

/// A `mat4` uniform. [Matrix]'s fields are raylib's row-major names; GLSL receives the
/// translation as column 3 (`m[3].xyz`), as raylib's own `mvp` arrives.
pub let set_shader_matrix = (shader: Shader, loc: i32, value: Matrix) -> void =>
  unsafe { rl_set_shader_value_matrix(shader, loc, value) }

/// A `sampler2D` uniform, given a texture for the shader mode's draws: set it inside
/// [begin_shader_mode] or just before. The texture stays the caller's.
pub let set_shader_texture = (shader: Shader, loc: i32, texture: Texture2D) -> void =>
  unsafe { rl_set_shader_value_texture(shader, loc, texture) }

/// An array uniform's `n` elements, from the address of the first; nothing for an empty
/// array, whose count of 0 GL would refuse.
let set_values = (shader: Shader, loc: i32, first: u64, kind: i32, n: i64) -> void =>
  if n > 0 {
    unsafe { rl_set_shader_value_v(shader, loc, pointer_at(first), kind, i32(n)) }
  }

// raylib's `SHADER_UNIFORM_*` (`ShaderUniformDataType`), the ones the setters send.
const UNIFORM_FLOAT: i32 = 0
const UNIFORM_VEC2: i32 = 1
const UNIFORM_VEC3: i32 = 2
const UNIFORM_VEC4: i32 = 3
const UNIFORM_INT: i32 = 4

// ---------------------------------------------------------------------------------------
// Shader mode — 2D drawing through a program of your own
// ---------------------------------------------------------------------------------------

/// Draw the shapes and textures that follow through `shader` instead of raylib's default,
/// until [end_shader_mode]. Its vertex stage receives raylib's names (`vertexPosition`,
/// `vertexTexCoord`, `vertexColor`, `mvp`); see the module note on when uniforms arrive.
pub let begin_shader_mode = (shader: Shader) -> void =>
  unsafe { rl_begin_shader_mode(shader) }

/// Send the shader mode's draws, and go back to the default shader.
pub let end_shader_mode = () -> void => unsafe { rl_end_shader_mode() }

// ---------------------------------------------------------------------------------------
// Render state
// ---------------------------------------------------------------------------------------

/// Whether triangles facing away from the camera are skipped — raylib's default, and right
/// for a closed mesh. Off to draw a double-sided surface from behind: a glass pane, a leaf,
/// a panel modelled as one sheet.
pub let set_backface_culling = (on: bool) -> void =>
  if on { unsafe { rl_enable_backface_culling() } } else { unsafe { rl_disable_backface_culling() } }

/// Whether drawing writes depth. Off while drawing see-through surfaces over the opaque ones
/// already drawn, so that one pane does not hide another or what lies behind it; the depth
/// *test* still runs, so they stay behind anything nearer.
pub let set_depth_write = (on: bool) -> void =>
  if on { unsafe { rl_enable_depth_mask() } } else { unsafe { rl_disable_depth_mask() } }

/// raylib's `SHADER_LOC_MAP_ALBEDO`: the first of the locations array's per-slot sampler
/// entries, one for each `MATERIAL_MAP_*` in order.
const SHADER_LOC_MAP_ALBEDO: i64 = 15

// ---------------------------------------------------------------------------------------
// Foreign declarations
// ---------------------------------------------------------------------------------------

@symbol("LoadShaderFromMemory")
unsafe extern rl_load_shader_from_memory: (vertex: ^u8, fragment: ^u8) -> Shader
@symbol("SetShaderValue")
unsafe extern rl_set_shader_value: (
  shader: Shader,
  loc: i32,
  value: ^u8,
  kind: i32
) -> void
@symbol("SetShaderValueV")
unsafe extern rl_set_shader_value_v:
  (shader: Shader, loc: i32, values: ^u8, kind: i32, count: i32) -> void
@symbol("SetShaderValueMatrix")
unsafe extern rl_set_shader_value_matrix: (
  shader: Shader,
  loc: i32,
  value: Matrix
) -> void
@symbol("SetShaderValueTexture")
unsafe extern rl_set_shader_value_texture: (
  shader: Shader,
  loc: i32,
  texture: Texture2D
) -> void
@symbol("BeginShaderMode")
unsafe extern rl_begin_shader_mode: (shader: Shader) -> void
@symbol("EndShaderMode")
unsafe extern rl_end_shader_mode: () -> void
@symbol("IsShaderValid")
unsafe extern rl_shader_valid: (shader: Shader) -> u8
@symbol("GetShaderLocation")
unsafe extern rl_shader_location: (shader: Shader, uniform: ^u8) -> i32
@symbol("UnloadShader")
unsafe extern rl_unload_shader: (shader: Shader) -> void
@symbol("rlEnableBackfaceCulling")
unsafe extern rl_enable_backface_culling: () -> void
@symbol("rlDisableBackfaceCulling")
unsafe extern rl_disable_backface_culling: () -> void
@symbol("rlEnableDepthMask")
unsafe extern rl_enable_depth_mask: () -> void
@symbol("rlDisableDepthMask")
unsafe extern rl_disable_depth_mask: () -> void
@symbol("rlGetShaderIdDefault")
unsafe extern rl_shader_id_default: () -> u32
@symbol("rlGetShaderLocsDefault")
unsafe extern rl_shader_locs_default: () -> ^mut i32
