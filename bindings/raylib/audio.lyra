module bindings.raylib
//! Sound.
//!
//! **This is the first part of the module that owns a resource**, and raylib does not
//! signal failure the way SDL does: `LoadSound` answers a `Sound` whose handle is invalid
//! rather than a NULL, so the `Maybe` here is built on `IsSoundValid` instead of a null
//! check. The wrappers below hand back a `Maybe<Sound>` for that reason and no other.
//!
//! **Unloading is the caller's**, and nothing here can make it otherwise: Lyra has no
//! destructors, so a `Sound` is freed by calling [unload_sound] and by nothing else.
//! Leaking one costs a buffer until the process exits, which for a game is survivable and
//! for a long-running program is not. The alternative — a handle that frees itself — needs
//! a language feature this does not have, and inventing a half of it in a binding module
//! would be worse than saying so.

import std.ffi.{ with_cstring }

/// `AudioStream` — raylib's internal playback handle. Its two pointers are opaque: nothing
/// on this side reads through them, and they are here so the struct's **layout** matches.
pub struct AudioStream {
  buffer: ^u8,
  processor: ^u8,
  sample_rate: u32,
  sample_size: u32,
  channels: u32,
}

/// `Sound` — a stream plus its length. 40 bytes, so it crosses in memory rather than in
/// registers; `pkg/abi` decides that, and nothing here has to.
///
/// The samples belong to raylib, so [unload_sound] is the call that gives them back and
/// `@must_release` is what makes forgetting it a warning rather than a silent leak.
@must_release(unload_sound)
pub struct Sound {
  stream: AudioStream,
  frame_count: u32,
}

/// `Wave` — decoded samples, before they become a playable [Sound].
///
/// It is a separate type because it is a separate lifetime: a `Wave` holds the decoded
/// buffer, [sound_from_wave] copies what it needs, and the wave can then be unloaded
/// while the sound plays on.
@must_release(unload_wave)
pub struct Wave {
  frame_count: u32,
  sample_rate: u32,
  sample_size: u32,
  channels: u32,
  data: ^u8,
}

@symbol("InitAudioDevice")
unsafe extern rl_init_audio: () -> void

@symbol("CloseAudioDevice")
unsafe extern rl_close_audio: () -> void

@symbol("IsAudioDeviceReady")
unsafe extern rl_audio_ready: () -> u8

@symbol("SetMasterVolume")
unsafe extern rl_set_master_volume: (volume: f32) -> void

@symbol("LoadSound")
unsafe extern rl_load_sound: (path: ^u8) -> Sound

@symbol("LoadWaveFromMemory")
unsafe extern rl_load_wave_from_memory: (kind: ^u8, data: ^u8, size: i32) -> Wave

@symbol("LoadSoundFromWave")
unsafe extern rl_load_sound_from_wave: (wave: Wave) -> Sound

@symbol("IsSoundValid")
unsafe extern rl_sound_valid: (sound: Sound) -> u8

@symbol("UnloadSound")
unsafe extern rl_unload_sound: (sound: Sound) -> void

@symbol("IsWaveValid")
unsafe extern rl_wave_valid: (wave: Wave) -> u8

@symbol("UnloadWave")
unsafe extern rl_unload_wave: (wave: Wave) -> void

@symbol("PlaySound")
unsafe extern rl_play_sound: (sound: Sound) -> void

@symbol("StopSound")
unsafe extern rl_stop_sound: (sound: Sound) -> void

@symbol("IsSoundPlaying")
unsafe extern rl_sound_playing: (sound: Sound) -> u8

@symbol("SetSoundVolume")
unsafe extern rl_set_sound_volume: (sound: Sound, volume: f32) -> void

@symbol("SetSoundPitch")
unsafe extern rl_set_sound_pitch: (sound: Sound, pitch: f32) -> void

/// Bring up the audio device. Nothing below works before this, and raylib logs rather than
/// returning a failure — [audio_ready] is how to ask.
pub let init_audio_device = () -> void => unsafe { rl_init_audio() }

/// Shut the audio device down. Unload sounds before this, not after.
pub let close_audio_device = () -> void => unsafe { rl_close_audio() }

/// Whether the device came up. A machine with no output device is the ordinary case here —
/// a CI runner, a container — so a program that wants to run anywhere should ask and carry
/// on quietly rather than treating silence as an error.
pub let audio_ready = () -> bool => unsafe { rl_audio_ready() } != 0

/// Overall output volume, 0.0 through 1.0.
pub let set_master_volume = (volume: f32) -> void =>
  unsafe { rl_set_master_volume(volume) }

/// Load a sound from a file, or `None` if raylib could not.
///
/// **The `Maybe` is built on `IsSoundValid`, not on a null check.** raylib answers a
/// `Sound` whose internal handle is invalid rather than a null pointer, so there is nothing
/// to compare against `nullptr` — which is why this is the one binding in the module where
/// the failure test is a call rather than a comparison.
pub let load_sound = (path: string) -> Maybe<Sound> => {
  let s = path.with_cstring((p) => unsafe { rl_load_sound(p) })
  if sound_valid(s) { Some(s) } else { None }
}

/// Decode samples from bytes already in memory, or `None` if they were not a `kind`.
///
/// `kind` is the format's extension, with or without the dot — `"wav"` and `".wav"` both
/// work. **raylib itself requires the dot**, silently returning an empty `Wave` without
/// one, which is a trap worth absorbing here rather than documenting: the caller is
/// naming a format, not a filename, and which spelling raylib happens to want is not
/// their problem.
///
/// It exists so a program can carry its sounds as data rather than as files beside the
/// executable, which is what `examples/raylib/breakout.lyra` does: it synthesises its
/// tones and never touches the disk. The `[]u8` stays Lyra's — raylib copies what it
/// needs — and taking the buffer's address is this function's `unsafe`, not the caller's.
pub let wave_from_memory = (kind: string, bytes: []u8) -> Maybe<Wave> => {
  let ext = if kind.starts_with(".") { kind } else { "." ++ kind }
  let w = ext.with_cstring((k) =>
    unsafe { rl_load_wave_from_memory(k, bytes.data(), i32(bytes.len())) })
  if wave_valid(w) { Some(w) } else { None }
}

/// Whether a wave holds usable samples.
pub let wave_valid = (wave: Wave) -> bool => unsafe { rl_wave_valid(wave) } != 0

/// Turn decoded samples into something playable, or `None` if they were not usable.
///
/// The wave may be unloaded afterwards: raylib copies what the sound needs.
pub let sound_from_wave = (wave: Wave) -> Maybe<Sound> => {
  let s = unsafe { rl_load_sound_from_wave(wave) }
  if sound_valid(s) { Some(s) } else { None }
}

/// Whether a sound's handle is usable.
pub let sound_valid = (sound: Sound) -> bool => unsafe { rl_sound_valid(sound) } != 0

/// Free a sound. **Nothing calls this for you** — see the module note.
pub let unload_sound = (sound: Sound) -> void => unsafe { rl_unload_sound(sound) }

/// Free a wave's decoded buffer.
pub let unload_wave = (wave: Wave) -> void => unsafe { rl_unload_wave(wave) }

/// Play a sound, from the start. Playing one already playing restarts it.
pub let play_sound = (sound: Sound) -> void => unsafe { rl_play_sound(sound) }

/// Stop a sound.
pub let stop_sound = (sound: Sound) -> void => unsafe { rl_stop_sound(sound) }

/// Whether a sound is still playing.
pub let sound_playing = (sound: Sound) -> bool => unsafe { rl_sound_playing(sound) } != 0

/// One sound's volume, 0.0 through 1.0.
pub let set_sound_volume = (sound: Sound, volume: f32) -> void =>
  unsafe { rl_set_sound_volume(sound, volume) }

/// One sound's pitch, 1.0 being its recorded speed. Cheapest way to get several sounds out
/// of one buffer.
pub let set_sound_pitch = (sound: Sound, pitch: f32) -> void =>
  unsafe { rl_set_sound_pitch(sound, pitch) }

// ---------------------------------------------------------------------------------------
// Music — a stream decoded as it plays
//
// The difference from a [Sound] is where the samples live. A `Sound` is decoded whole into
// memory and played from there, which is right for a footstep and wrong for a four-minute
// track; a `Music` keeps a decoder open and is fed a buffer at a time, which is why it
// needs [update_music] called every frame and a `Sound` does not.
// ---------------------------------------------------------------------------------------

/// `Music` — a streaming decoder. 56 bytes, and the widest aggregate this module passes.
///
/// **`looping` is a `u8`, not a `bool`.** C's `_Bool` is a byte and Lyra's `bool` is a
/// bit, so `bool` is refused at the boundary (`lyra-E063`) and the byte is what crosses.
/// The layout was checked against C's own `sizeof` and `offsetof` rather than reasoned
/// about: 56 bytes with `stream` at 0, `frame_count` at 32, `looping` at 36, `ctx_type` at
/// 40 and `ctx_data` at 48. A wrong answer here would not be a mismatch but garbage.
@must_release(unload_music)
pub struct Music {
  stream: AudioStream,
  frame_count: u32,
  looping: u8,
  ctx_type: i32,
  ctx_data: ^u8,
}

/// Open a music file for streaming, or `None` if it could not be read.
pub let load_music = (path: string) -> Maybe<Music> => {
  let m = path.with_cstring((p) => unsafe { rl_load_music(p) })
  if music_valid(m) { Some(m) } else { None }
}

/// Open music from bytes already in memory. `kind` is the extension, with or without the
/// dot — normalised here, as [wave_from_memory] does and for the same raylib convention.
pub let music_from_memory = (kind: string, bytes: []u8) -> Maybe<Music> => {
  if bytes.len() == 0 {
    None
  } else {
    let ext = if kind.starts_with(".") { kind } else { "." ++ kind }
    let m = ext.with_cstring((k) =>
      unsafe { rl_music_from_memory(k, bytes.data(), i32(bytes.len())) })
    if music_valid(m) { Some(m) } else { None }
  }
}

pub let music_valid = pure (music: Music) -> bool => unsafe { rl_music_valid(music) } != 0

/// Close the decoder and free its buffers. Nothing does this for you.
pub let unload_music = (music: Music) -> void => unsafe { rl_unload_music(music) }

pub let play_music = (music: Music) -> void => unsafe { rl_play_music(music) }

/// **Call this every frame while music plays**, or the buffer runs dry and the sound
/// stops. It is the whole difference between a `Music` and a `Sound`, and forgetting it
/// produces a track that plays for a fraction of a second and then silence.
pub let update_music = (music: Music) -> void => unsafe { rl_update_music(music) }

pub let music_playing = (music: Music) -> bool => unsafe { rl_music_playing(music) } != 0
pub let stop_music = (music: Music) -> void => unsafe { rl_stop_music(music) }
pub let pause_music = (music: Music) -> void => unsafe { rl_pause_music(music) }
pub let resume_music = (music: Music) -> void => unsafe { rl_resume_music(music) }

/// Jump to a position in seconds.
pub let seek_music = (music: Music, seconds: f32) -> void =>
  unsafe { rl_seek_music(music, seconds) }

pub let set_music_volume = (music: Music, volume: f32) -> void =>
  unsafe { rl_set_music_volume(music, volume) }
pub let set_music_pitch = (music: Music, pitch: f32) -> void =>
  unsafe { rl_set_music_pitch(music, pitch) }
/// Stereo placement, -1.0 left through 0.0 centre to 1.0 right.
pub let set_music_pan = (music: Music, pan: f32) -> void =>
  unsafe { rl_set_music_pan(music, pan) }

/// The track's whole length in seconds.
pub let music_length = pure (music: Music) -> f32 => unsafe { rl_music_length(music) }
/// How far into the track playback has reached, in seconds.
pub let music_played = (music: Music) -> f32 => unsafe { rl_music_played(music) }

// ---------------------------------------------------------------------------------------
// The rest of Wave and Sound
// ---------------------------------------------------------------------------------------

/// Load a wave from a file, or `None` if it could not be decoded.
pub let load_wave = (path: string) -> Maybe<Wave> => {
  let w = path.with_cstring((p) => unsafe { rl_load_wave(p) })
  if wave_valid(w) { Some(w) } else { None }
}

/// `SoundAlias` — a second playback head over another sound's samples.
///
/// **A wrapper struct rather than a bare [Sound], and the reason is a double free.** The
/// two are the same twenty bytes to C, but they are released by *different* functions:
/// `UnloadSound` frees the sample data and `UnloadSoundAlias` does not, because the
/// original still owns it. One type for both would mean `@must_release` naming
/// `unload_sound` on an alias — a diagnostic confidently advising the call that corrupts
/// the heap, which is worse than no diagnostic at all.
///
/// The cost is one field access at each playback call, and the type is what makes the
/// mixup unwritable.
@must_release(unload_sound_alias)
pub struct SoundAlias {
  sound: Sound,
}

/// A second voice for a sound, sharing its samples.
///
/// **What lets one sound play twice at once.** `play_sound` on a sound already playing
/// restarts it; an alias is a separate playback head over the same data, so a rapid-fire
/// effect wants a handful of them. Reach the playable value through `.sound`.
pub let sound_alias = (source: Sound) -> Maybe<SoundAlias> => {
  let a = unsafe { rl_sound_alias(source) }
  if sound_valid(a) { Some(SoundAlias { sound: a }) } else { None }
}

/// Free an alias without touching the samples it borrowed.
pub let unload_sound_alias = (alias: SoundAlias) -> void =>
  unsafe { rl_unload_sound_alias(alias.sound) }

/// Replace a sound's samples. `frames` counts frames, not bytes.
pub let update_sound = (sound: Sound, samples: []u8, frames: i64) -> bool => {
  if samples.len() == 0 {
    false
  } else {
    unsafe { rl_update_sound(sound, samples.data(), i32(frames)) }
    true
  }
}

pub let pause_sound = (sound: Sound) -> void => unsafe { rl_pause_sound(sound) }
pub let resume_sound = (sound: Sound) -> void => unsafe { rl_resume_sound(sound) }
/// Stereo placement, -1.0 left through 0.0 centre to 1.0 right.
pub let set_sound_pan = (sound: Sound, pan: f32) -> void =>
  unsafe { rl_set_sound_pan(sound, pan) }

/// Write a wave to a file — `.wav` or `.qoa`, taken from the extension.
pub let export_wave = (wave: Wave, path: string) -> bool =>
  path.with_cstring((p) => unsafe { rl_export_wave(wave, p) }) != 0

/// Write a wave as a C array in a header file, which is how raylib's own examples embed
/// audio.
pub let export_wave_as_code = (wave: Wave, path: string) -> bool =>
  path.with_cstring((p) => unsafe { rl_export_wave_as_code(wave, p) }) != 0

/// An independent copy of a wave's samples. The copy is the caller's to unload.
pub let wave_copy = (wave: Wave) -> Maybe<Wave> => {
  let c = unsafe { rl_wave_copy(wave) }
  if wave_valid(c) { Some(c) } else { None }
}

/// Trim a wave to a frame range, in place.
pub let crop_wave = (self: mut Wave, first_frame: i64, last_frame: i64) -> void =>
  unsafe { rl_wave_crop(&mut self, i32(first_frame), i32(last_frame)) }

/// Convert a wave's sample rate, bit depth or channel count, in place.
pub let format_wave =
  (self: mut Wave, sample_rate: i64, sample_size: i64, channels: i64) -> void =>
    unsafe { rl_wave_format(&mut self, i32(sample_rate), i32(sample_size), i32(channels)) }

/// A wave's samples as `[]f32`, one entry per frame per channel, normalised to -1.0..1.0.
///
/// It copies into an array Lyra owns and hands raylib's buffer straight back, so there is
/// nothing further to release — the same arrangement `image_colors` uses, and for the same
/// reason: a raw pointer would be faster and would put a lifetime nothing tracks into the
/// caller's hands.
pub let wave_samples = (wave: Wave) -> []f32 => {
  var out: []f32 = []
  let total = i64(wave.frame_count) * i64(wave.channels)
  if total > 0 {
    let raw = unsafe { rl_wave_samples(wave) }
    if raw != nullptr {
      var i = 0
      for i < total {
        out.push(unsafe { raw.offset(i)^ })
        i += 1
      }
      unsafe { rl_unload_wave_samples(raw) }
    }
  }
  out
}

/// The master volume, as [set_master_volume] last left it.
pub let master_volume = pure () -> f32 => unsafe { rl_master_volume() }

// ---------------------------------------------------------------------------------------
// Audio streams — samples a program generates itself
//
// The rung below [Music]: no decoder, no file, just a buffer the program fills and hands
// over. What a synthesiser or a network voice chat writes into.
//
// **`AudioStream` deliberately carries no `@must_release`**, though a loaded one must be
// unloaded. It is a *field* of both [Sound] and [Music], and the marker is on a binding's
// type rather than on its provenance — so marking it would demand a release for every
// `sound.stream` a program reads, which borrows rather than owns. The obligation is real
// and this is the one place in the module it has to be remembered rather than checked.
// ---------------------------------------------------------------------------------------

/// A stream a program feeds itself. `sample_size` is bits per sample: 8, 16 or 32.
pub let load_audio_stream = (sample_rate: i64, sample_size: i64, channels: i64) -> Maybe<AudioStream> => {
  let s = unsafe { rl_load_audio_stream(u32(sample_rate), u32(sample_size), u32(channels)) }
  if audio_stream_valid(s) { Some(s) } else { None }
}

pub let audio_stream_valid = pure (stream: AudioStream) -> bool =>
  unsafe { rl_audio_stream_valid(stream) } != 0

/// Free the stream. See the note above on why this is not `@must_release`-checked.
pub let unload_audio_stream = (stream: AudioStream) -> void =>
  unsafe { rl_unload_audio_stream(stream) }

/// Hand the stream more samples. Ask [audio_stream_processed] first — writing to a stream
/// that has not drained its buffer drops the data.
pub let update_audio_stream = (stream: AudioStream, samples: []u8, frames: i64) -> bool => {
  if samples.len() == 0 {
    false
  } else {
    unsafe { rl_update_audio_stream(stream, samples.data(), i32(frames)) }
    true
  }
}

/// Whether the stream has finished with its current buffer and wants more.
pub let audio_stream_processed = (stream: AudioStream) -> bool =>
  unsafe { rl_audio_stream_processed(stream) } != 0

pub let play_audio_stream = (stream: AudioStream) -> void =>
  unsafe { rl_play_audio_stream(stream) }
pub let stop_audio_stream = (stream: AudioStream) -> void =>
  unsafe { rl_stop_audio_stream(stream) }
pub let pause_audio_stream = (stream: AudioStream) -> void =>
  unsafe { rl_pause_audio_stream(stream) }
pub let resume_audio_stream = (stream: AudioStream) -> void =>
  unsafe { rl_resume_audio_stream(stream) }
pub let audio_stream_playing = (stream: AudioStream) -> bool =>
  unsafe { rl_audio_stream_playing(stream) } != 0
pub let set_audio_stream_volume = (stream: AudioStream, volume: f32) -> void =>
  unsafe { rl_set_audio_stream_volume(stream, volume) }
pub let set_audio_stream_pitch = (stream: AudioStream, pitch: f32) -> void =>
  unsafe { rl_set_audio_stream_pitch(stream, pitch) }
pub let set_audio_stream_pan = (stream: AudioStream, pan: f32) -> void =>
  unsafe { rl_set_audio_stream_pan(stream, pan) }

/// The buffer size new streams are created with, in frames.
pub let set_audio_stream_buffer_size = (frames: i64) -> void =>
  unsafe { rl_set_audio_stream_buffer_size(i32(frames)) }

// **raylib's five callback-taking audio functions are not bound, and cannot be today.**
//
//   SetAudioStreamCallback, AttachAudioStreamProcessor, DetachAudioStreamProcessor,
//   AttachAudioMixedProcessor, DetachAudioMixedProcessor
//
// A C callback is a bare code address, and Lyra's function values are `{code, env}`
// closures uniformly — so only a **top-level function** may cross (`lyra-E066`). A wrapper
// cannot forward one: its callback *parameter* is a closure whatever it happens to hold,
// and the compiler has no way to know the value came from a top-level function. Since an
// extern cannot be `pub`, a caller cannot reach the raw declaration either, and the
// module's usual arrangement — Lyra over a private extern — has nowhere to stand.
//
// What would fix it is a way to say "this parameter is a bare function pointer", which is
// a language question rather than a binding one. See todo.md.

