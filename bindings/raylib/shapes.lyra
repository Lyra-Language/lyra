  (center: Vector2, sides: i32, radius: f32, rotation: f32, color: Color) -> void

@symbol("DrawPolyLines")
unsafe extern rl_draw_poly_lines:
  (center: Vector2, sides: i32, radius: f32, rotation: f32, color: Color) -> void

@symbol("DrawPolyLinesEx")
unsafe extern rl_draw_poly_lines_ex:
  (center: Vector2, sides: i32, radius: f32, rotation: f32, thick: f32, color: Color) -> void

@symbol("DrawSplineLinear")
unsafe extern rl_draw_spline_linear:
  (points: ^Vector2, count: i32, thick: f32, color: Color) -> void

