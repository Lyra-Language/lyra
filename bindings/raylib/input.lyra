module bindings.raylib
//! Keyboard, mouse, touch and gamepad.
//!
//! **Every constant here is generated from raylib's own enums** rather than transcribed,
//! which is the only way a table of 152 numbers is trustworthy. A wrong key code is a key
//! that never fires — silent, and indistinguishable from a keyboard problem.
//!
//! The three tenses matter and are easy to confuse. `*_pressed` is true on the **frame the
//! button went down** and false after; `*_down` is true for as long as it is held;
//! `*_released` is the mirror of pressed. A menu wants pressed, a movement key wants down,
//! and using the wrong one gives a control that either repeats furiously or fires once.

// `copy_c_string` lives in `raylib.lyra` and is visible here without an import: this is
// one module across several files, so a second copy would be a duplicate definition
// rather than two private helpers.
import std.ffi.{ with_cstring }

// ---------------------------------------------------------------------------------------
// Keyboard
// ---------------------------------------------------------------------------------------

/// Whether the key went down this frame.
pub let key_pressed = pure (key: i32) -> bool => unsafe { rl_key_pressed(key) } != 0

/// Whether the key went down this frame **or** repeated, as a held key does in a text
/// field. What a backspace wants and a jump button does not.
pub let key_pressed_repeat = pure (key: i32) -> bool =>
  unsafe { rl_key_pressed_repeat(key) } != 0

/// Whether the key is held.
pub let key_down = pure (key: i32) -> bool => unsafe { rl_key_down(key) } != 0

/// Whether the key came up this frame.
pub let key_released = pure (key: i32) -> bool => unsafe { rl_key_released(key) } != 0

/// Whether the key is not held.
pub let key_up = pure (key: i32) -> bool => unsafe { rl_key_up(key) } != 0

/// The next key from the queue, or `None` when it is empty.
///
/// **A queue, not a state**: call it in a loop until it answers `None` to drain a frame's
/// worth. Reading it once a frame loses keys when two arrive together.
pub let next_key_pressed = () -> Maybe<i32> => {
  let k = unsafe { rl_key_pressed_queue() }
  if k == 0 { None } else { Some(k) }
}

/// The next **character** from the queue, as a Unicode code point, or `None`.
///
/// Separate from [next_key_pressed] because it is a different question: this is what the
/// keyboard layout produced, so it accounts for shift, dead keys and alternative layouts.
/// Text entry wants this; a shortcut wants the key.
pub let next_char_pressed = () -> Maybe<rune> => {
  let c = unsafe { rl_char_pressed_queue() }
  if c == 0 { None } else { Some(rune(c)) }
}

/// A key's name as the current layout spells it, or `None` where it has none.
///
/// **`None` is the common answer, not the rare one.** It comes from GLFW's
/// `glfwGetKeyName`, which answers only for keys that *print* something: `KEY_A` is "a"
/// under a US layout and "q" under a French one, which is the point — but `KEY_SPACE`,
/// `KEY_F1`, `KEY_ENTER` and every other non-printing key answer nothing at all. It also
/// needs [init_window] to have run, since the layout comes from the window system.
/// Measured, all three.
pub let key_name = (key: i32) -> Maybe<string> => copy_c_string(unsafe { rl_key_name(key) })

/// The key that closes the window, `KEY_ESCAPE` by default. `KEY_NULL` disables it, which
/// a program that wants to confirm before quitting needs.
pub let set_exit_key = (key: i32) -> void => unsafe { rl_set_exit_key(key) }

// ---------------------------------------------------------------------------------------
// Mouse
// ---------------------------------------------------------------------------------------

pub let mouse_pressed = pure (button: i32) -> bool => unsafe { rl_mouse_pressed(button) } != 0
pub let mouse_down = pure (button: i32) -> bool => unsafe { rl_mouse_down(button) } != 0
pub let mouse_released = pure (button: i32) -> bool => unsafe { rl_mouse_released(button) } != 0
pub let mouse_up = pure (button: i32) -> bool => unsafe { rl_mouse_up(button) } != 0

/// The pointer, in screen coordinates.
pub let mouse_position = pure () -> Vector2 => unsafe { rl_mouse_position() }

/// How far the pointer moved since the last frame.
///
/// **The reading that still works with the cursor captured** ([disable_cursor]), where the
/// position stops changing because the pointer is locked. A camera reads this.
pub let mouse_delta = pure () -> Vector2 => unsafe { rl_mouse_delta() }

pub let set_mouse_position = (x: i64, y: i64) -> void =>
  unsafe { rl_set_mouse_position(i32(x), i32(y)) }

/// Shift every reported pointer position by a constant.
pub let set_mouse_offset = (x: i64, y: i64) -> void =>
  unsafe { rl_set_mouse_offset(i32(x), i32(y)) }

/// Scale every reported pointer position. With [set_mouse_offset], this is how a program
/// rendering to a fixed-size target maps the pointer into it.
pub let set_mouse_scale = (x: f32, y: f32) -> void => unsafe { rl_set_mouse_scale(x, y) }

/// Wheel movement this frame, positive away from the user. The larger axis of the two
/// when a trackpad reports both.
pub let mouse_wheel = pure () -> f32 => unsafe { rl_mouse_wheel() }

/// Wheel movement on both axes, which a trackpad produces and a wheel does not.
pub let mouse_wheel_v = pure () -> Vector2 => unsafe { rl_mouse_wheel_v() }

/// The pointer's shape — one of the `MOUSE_CURSOR_*` constants.
pub let set_mouse_cursor = (cursor: i32) -> void => unsafe { rl_set_mouse_cursor(cursor) }

// ---------------------------------------------------------------------------------------
// Touch
// ---------------------------------------------------------------------------------------

/// How many fingers are down.
pub let touch_count = pure () -> i64 => i64(unsafe { rl_touch_count() })

/// One touch point's position, by index into `0..touch_count()`.
pub let touch_position = pure (index: i64) -> Vector2 =>
  unsafe { rl_touch_position(i32(index)) }

/// A touch point's identifier, which stays the same as a finger moves.
pub let touch_id = pure (index: i64) -> i64 => i64(unsafe { rl_touch_id(i32(index)) })

// ---------------------------------------------------------------------------------------
// Gamepad
// ---------------------------------------------------------------------------------------

/// Whether a gamepad is connected at this index.
pub let gamepad_available = pure (pad: i64) -> bool =>
  unsafe { rl_gamepad_available(i32(pad)) } != 0

/// The gamepad's name, or `None` when none is connected there.
pub let gamepad_name = (pad: i64) -> Maybe<string> =>
  copy_c_string(unsafe { rl_gamepad_name(i32(pad)) })

pub let gamepad_pressed = pure (pad: i64, button: i32) -> bool =>
  unsafe { rl_gamepad_pressed(i32(pad), button) } != 0
pub let gamepad_down = pure (pad: i64, button: i32) -> bool =>
  unsafe { rl_gamepad_down(i32(pad), button) } != 0
pub let gamepad_released = pure (pad: i64, button: i32) -> bool =>
  unsafe { rl_gamepad_released(i32(pad), button) } != 0
pub let gamepad_up = pure (pad: i64, button: i32) -> bool =>
  unsafe { rl_gamepad_up(i32(pad), button) } != 0

/// The last gamepad button pressed on any pad, or `None`.
pub let last_gamepad_button = () -> Maybe<i32> => {
  let b = unsafe { rl_gamepad_button_pressed() }
  if b == 0 { None } else { Some(b) }
}

/// How many analogue axes this pad reports.
pub let gamepad_axis_count = pure (pad: i64) -> i64 =>
  i64(unsafe { rl_gamepad_axis_count(i32(pad)) })

/// One axis, -1.0 to 1.0. A trigger rests at -1.0 rather than 0.0, which is the surprise.
pub let gamepad_axis = pure (pad: i64, axis: i32) -> f32 =>
  unsafe { rl_gamepad_axis(i32(pad), axis) }

/// Rumble both motors for `seconds`, each at 0.0 to 1.0.
pub let set_gamepad_vibration = (pad: i64, left: f32, right: f32, seconds: f32) -> void =>
  unsafe { rl_set_gamepad_vibration(i32(pad), left, right, seconds) }

/// Install SDL-format controller mappings, answering how many were added.
pub let set_gamepad_mappings = (mappings: string) -> i64 =>
  i64(mappings.with_cstring((m) => unsafe { rl_set_gamepad_mappings(m) }))

