// ---------------------------------------------------------------------------------------
// The externs
// ---------------------------------------------------------------------------------------

@symbol("IsKeyPressed")
unsafe extern pure rl_key_pressed: (key: i32) -> u8
@symbol("IsKeyPressedRepeat")
unsafe extern pure rl_key_pressed_repeat: (key: i32) -> u8
@symbol("IsKeyDown")
unsafe extern pure rl_key_down: (key: i32) -> u8
@symbol("IsKeyReleased")
unsafe extern pure rl_key_released: (key: i32) -> u8
@symbol("IsKeyUp")
unsafe extern pure rl_key_up: (key: i32) -> u8
@symbol("GetKeyPressed")
unsafe extern rl_key_pressed_queue: () -> i32
@symbol("GetCharPressed")
unsafe extern rl_char_pressed_queue: () -> i32
@symbol("GetKeyName")
unsafe extern rl_key_name: (key: i32) -> ^u8
@symbol("SetExitKey")
unsafe extern rl_set_exit_key: (key: i32) -> void
@symbol("IsMouseButtonPressed")
unsafe extern pure rl_mouse_pressed: (button: i32) -> u8
@symbol("IsMouseButtonDown")
unsafe extern pure rl_mouse_down: (button: i32) -> u8
@symbol("IsMouseButtonReleased")
unsafe extern pure rl_mouse_released: (button: i32) -> u8
@symbol("IsMouseButtonUp")
unsafe extern pure rl_mouse_up: (button: i32) -> u8
@symbol("GetMousePosition")
unsafe extern pure rl_mouse_position: () -> Vector2
@symbol("GetMouseDelta")
unsafe extern pure rl_mouse_delta: () -> Vector2
@symbol("SetMousePosition")
unsafe extern rl_set_mouse_position: (x: i32, y: i32) -> void
@symbol("SetMouseOffset")
unsafe extern rl_set_mouse_offset: (x: i32, y: i32) -> void
@symbol("SetMouseScale")
unsafe extern rl_set_mouse_scale: (x: f32, y: f32) -> void
@symbol("GetMouseWheelMove")
unsafe extern pure rl_mouse_wheel: () -> f32
@symbol("GetMouseWheelMoveV")
unsafe extern pure rl_mouse_wheel_v: () -> Vector2
@symbol("SetMouseCursor")
unsafe extern rl_set_mouse_cursor: (cursor: i32) -> void
@symbol("GetTouchPointCount")
unsafe extern pure rl_touch_count: () -> i32
@symbol("GetTouchPosition")
unsafe extern pure rl_touch_position: (index: i32) -> Vector2
@symbol("GetTouchPointId")
unsafe extern pure rl_touch_id: (index: i32) -> i32
@symbol("IsGamepadAvailable")
unsafe extern pure rl_gamepad_available: (pad: i32) -> u8
@symbol("GetGamepadName")
unsafe extern rl_gamepad_name: (pad: i32) -> ^u8
@symbol("IsGamepadButtonPressed")
unsafe extern pure rl_gamepad_pressed: (pad: i32, button: i32) -> u8
@symbol("IsGamepadButtonDown")
unsafe extern pure rl_gamepad_down: (pad: i32, button: i32) -> u8
@symbol("IsGamepadButtonReleased")
unsafe extern pure rl_gamepad_released: (pad: i32, button: i32) -> u8
@symbol("IsGamepadButtonUp")
unsafe extern pure rl_gamepad_up: (pad: i32, button: i32) -> u8
@symbol("GetGamepadButtonPressed")
unsafe extern rl_gamepad_button_pressed: () -> i32
@symbol("GetGamepadAxisCount")
unsafe extern pure rl_gamepad_axis_count: (pad: i32) -> i32
@symbol("GetGamepadAxisMovement")
unsafe extern pure rl_gamepad_axis: (pad: i32, axis: i32) -> f32
@symbol("SetGamepadVibration")
unsafe extern rl_set_gamepad_vibration:
  (pad: i32, left: f32, right: f32, seconds: f32) -> void
@symbol("SetGamepadMappings")
unsafe extern rl_set_gamepad_mappings: (mappings: ^u8) -> i32
