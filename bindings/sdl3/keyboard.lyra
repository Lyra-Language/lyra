module bindings.sdl3
//! The keyboard as a set of held keys — the question a game asks every frame, as opposed
//! to the event queue's "what just happened" — plus the modifiers held and the names of
//! keys. The `SCANCODE_*`, `KEY_*` and `MOD_*` constants are in `keys.lyra`, generated
//! from the SDL headers.

@symbol("SDL_GetKeyboardState")
unsafe extern sdl_get_keyboard_state: (numkeys: ^mut i32) -> ^u8

/// Whether the key at `scancode` is down right now.
///
/// **Current as of the last time the event queue was drained** — SDL updates the state as
/// it pumps events, so a loop reads it after its `poll_event` loop, not before.
///
/// SDL answers an array of C `bool`s (bytes) indexed by scancode, valid for the life of
/// the program. The index is checked against the length SDL reports, so an out-of-range
/// scancode is a key that is never held rather than a read past the array.
pub let key_held = (scancode: u32) -> bool => {
  var length: i32 = 0
  let keys = unsafe { sdl_get_keyboard_state(&mut length) }
  if keys == nullptr || i64(scancode) >= i64(length) {
    false
  } else {
    unsafe { keys.offset(i64(scancode))^ } != 0
  }
}

@symbol("SDL_GetModState")
unsafe extern sdl_get_mod_state: () -> u16

@symbol("SDL_GetKeyName")
unsafe extern sdl_get_key_name: (key: u32) -> ^u8

@symbol("SDL_GetScancodeName")
unsafe extern sdl_get_scancode_name: (scancode: u32) -> ^u8

/// The modifier keys held now, as a `MOD_*` mask — test with `&`:
/// `modifiers() & MOD_CTRL != 0`. Read it while handling a `KeyDown` to tell `s` from
/// Ctrl+S; like [key_held], it is current as of the last event-queue drain.
pub let modifiers = () -> u16 => unsafe { sdl_get_mod_state() }

/// A key code's name as SDL spells it for people — `"PageUp"`, `"A"`, `"Left Shift"` —
/// or `""` for a code SDL does not know. Printable keys are named by the character the
/// current layout puts on them.
pub let key_name = (key: u32) -> string => c_name(unsafe { sdl_get_key_name(key) })

/// A scancode's name, independent of layout — `"Return"`, `"Keypad 5"` — or `""`.
pub let scancode_name = (scancode: u32) -> string =>
  c_name(unsafe { sdl_get_scancode_name(scancode) })

/// SDL's names are static strings it owns; this copies one out. SDL answers `""` rather
/// than NULL for an unknown code, but NULL is checked anyway.
let c_name = pure (p: ^u8) -> string =>
  if p == nullptr { "" } else { unsafe { p.decode_utf8(cstring_len(p)) } }
