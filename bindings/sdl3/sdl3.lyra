@link("SDL3", pkg: "sdl3")
module bindings.sdl3
//! Bindings to SDL3 — the shape `todo.md` calls for: a per-library module owning its
//! `extern`s and exporting Lyra over them, Rust's `*-sys` pattern.
//!
//! **The externs are private, and that is structural rather than stylistic.** There is no
//! `pub extern` — precisely so two libraries both declaring `strlen` cannot collide on a
//! program-wide name — so what a binding module exports is always the Lyra it puts over
//! them. That constraint is what makes this module worth having: the wrappers are where
//! `unsafe` stops, where a NULL becomes a `Maybe`, and where C's untagged event union
//! becomes a `data` type a `match` can be exhaustive over. **A program using this module
//! writes no `unsafe` at all.**
//!
//! **`@link("SDL3")` rides the declarations**, so a program that imports this module links
//! against SDL3 by saying nothing — the flags are collected across every module in the
//! compile. **`pkg: "sdl3"` says where the library is**: it names the pkg-config package,
//! which lyrac asks for the directory, so a Homebrew install needs no `LIBRARY_PATH`.
//! (That variable still applies on top, for a library pkg-config does not know.)
//!
//! ```
//! import bindings.sdl3.{ init, quit, create_window, INIT_VIDEO }
//!
//! let main = () -> void => {
//!   if !init(INIT_VIDEO) { println("no SDL"); return }
//!   match create_window("hello", 640, 480) {
//!     Some(w) => { … ; destroy_window(w) },
//!     None => println("no window"),
//!   }
//!   quit()
//! }
//! ```
//!
//! **Not `vendor/`**, which would be the conventional name: this directory sits inside a
//! Go module, and `vendor/` at a Go module root is Go's own — creating one breaks every
//! `go` command in the repo until it is removed.
//!
//! **Resolution**: a module path resolves under a *root*, so `bindings.sdl3` is
//! `<root>/bindings/sdl3/` exactly as `std.prelude` is `<root>/std/prelude/`. `./build.sh`
//! links `bindings` beside `std` in `build/`, so the built compiler finds this with no
//! environment set up. Running the compiler from source (`go run ./cmd/lyrac`) needs
//! `LYRA_STD=$(pwd)` from `lyra/`, for the same reason it does for the prelude.
//!
//! What is bound is what the examples in `examples/SDL3/` draw with, grown one example at a
//! time towards an NES-style game. Deliberately not the whole of SDL — every entry point is
//! a maintenance commitment and an ABI claim nobody checks, which is the argument that
//! decided there would be no `std.libc` either.

import std.ffi.{ cstring_len }

/// `SDL_INIT_VIDEO`, which implies the event subsystem.
pub const INIT_VIDEO: u32 = 0x00000020

/// `SDL_INIT_AUDIO`, for `open_audio`. `init` may be called again to add it to what is
/// already up, so a program can treat a failure here as "no sound" rather than "no SDL".
pub const INIT_AUDIO: u32 = 0x00000010

/// `SDL_INIT_GAMEPAD`, which implies the joystick and event subsystems. Combine with
/// `|`: `init(INIT_VIDEO | INIT_GAMEPAD)`.
pub const INIT_GAMEPAD: u32 = 0x00002000

/// `SDL_INIT_EVENTS` alone, for a program that wants the queue and no display.
pub const INIT_EVENTS: u32 = 0x00004000

@symbol("SDL_Init")
unsafe extern sdl_init: (flags: u32) -> bool

@symbol("SDL_Quit")
unsafe extern sdl_quit: () -> void

@symbol("SDL_GetError")
unsafe extern sdl_get_error: () -> ^u8

/// Bring up the named subsystems. `false` means SDL refused; [last_error] says why.
///
/// SDL3's predicates answer C's `bool`, and every extern here declares it as Lyra's `bool`:
/// `_Bool` crosses as `i1 zeroext`, clang's own spelling (pkg/backend/FFI.md), so no wrapper
/// converts a `1`. Only a `bool` inside a *callback's* signature is refused (lyra-E063). The
/// binding declared them `u8` and compared with `!= 0` until 09/28, on a reading of that
/// rule that was never its scope.
pub let init = (flags: u32) -> bool => unsafe { sdl_init(flags) }

/// Shut SDL down. Safe to call whether or not [init] succeeded.
pub let quit = () -> void => unsafe { sdl_quit() }

/// SDL's account of the last failure, or `""` when it has nothing to say.
///
/// `SDL_GetError` never answers NULL — it returns an empty string instead — but this
/// checks anyway: the cost is one comparison, and the alternative is `cstring_len`
/// walking from address zero.
pub let last_error = () -> string => {
  let p = unsafe { sdl_get_error() }
  if p == nullptr {
    ""
  } else {
    unsafe { p.decode_utf8(cstring_len(p)) }
  }
}
