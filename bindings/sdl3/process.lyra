module bindings.sdl3
//! Other programs: started, waited for, stopped.
//!
//! SDL's process API rather than `posix_spawn` directly, for the same reason the rest of
//! this module exists: it is one call on every platform SDL runs on, and it finds a bare
//! program name on the `PATH`.

/// An `SDL_Process *`: a program started with [create_process]. Hand it to
/// [destroy_process] once finished with — whether or not the program has ended.
pub type Process = ^u8

@symbol("SDL_CreateProcess")
unsafe extern sdl_create_process: (args: ^^u8, pipe_stdio: bool) -> Process

@symbol("SDL_WaitProcess")
unsafe extern sdl_wait_process: (
  process: Process,
  block: bool,
  exitcode: ^mut i32
) -> bool

@symbol("SDL_KillProcess")
unsafe extern sdl_kill_process: (process: Process, force: bool) -> bool

@symbol("SDL_DestroyProcess")
unsafe extern sdl_destroy_process: (process: Process) -> void

@symbol("SDL_CreateProcessWithProperties")
unsafe extern sdl_create_process_with_properties: (props: u32) -> Process

/// Its output (`datasize` bytes, NUL-terminated, the caller's to `SDL_free`) once it has
/// ended, and its exit code.
@symbol("SDL_ReadProcess")
unsafe extern sdl_read_process: (
  process: Process,
  datasize: ^mut u64,
  exitcode: ^mut i32
) -> ^u8

/// An `SDL_IOStream *` is opaque; it is typed `^^u8` because that is what the pointer
/// property's setter is declared to take (Lyra has no pointer casts, and C's is `void *`).
@symbol("SDL_IOFromFile")
unsafe extern sdl_io_from_file: (file: ^u8, mode: ^u8) -> ^^u8

@symbol("SDL_CloseIO")
unsafe extern sdl_close_io: (stream: ^^u8) -> bool

@symbol("SDL_free")
unsafe extern sdl_free: (mem: ^u8) -> void

@symbol("SDL_CreateProperties")
unsafe extern sdl_create_properties: () -> u32

@symbol("SDL_DestroyProperties")
unsafe extern sdl_destroy_properties: (props: u32) -> void

@symbol("SDL_SetPointerProperty")
unsafe extern sdl_set_pointer_property: (props: u32, name: ^u8, value: ^^u8) -> bool

@symbol("SDL_SetNumberProperty")
unsafe extern sdl_set_number_property: (props: u32, name: ^u8, value: i64) -> bool

@symbol("SDL_SetBooleanProperty")
unsafe extern sdl_set_boolean_property: (props: u32, name: ^u8, value: bool) -> bool

/// `SDL_CreateProcessWithProperties`' properties (`SDL_PROP_PROCESS_CREATE_*`).
const PROP_ARGS: string = "SDL.process.create.args"
const PROP_STDIN: string = "SDL.process.create.stdin_option"
const PROP_STDOUT: string = "SDL.process.create.stdout_option"
const PROP_STDOUT_STREAM: string = "SDL.process.create.stdout_source"
const PROP_STDERR_TO_STDOUT: string = "SDL.process.create.stderr_to_stdout"

/// `SDL_ProcessIO`: no stream, one this program reads (`SDL_ReadProcess`), or one it
/// supplies (a file).
const STDIO_NULL: i64 = 1
const STDIO_APP: i64 = 2
const STDIO_REDIRECT: i64 = 3

/// Start the program `args[0]` (a path, or a name found on the `PATH`) with the rest of
/// `args` as its arguments, its output going where this program's does; `None` when it
/// cannot be started (or `args` is empty).
pub let create_process = (args: []string) -> Maybe<Process> => {
  if args.len() == 0 { return None }
  // `const char * const *`, NULL-terminated. The pointers are into `args`, which the
  // caller holds for the length of the call — SDL copies what it keeps.
  var pointers: []^u8 = []
  for a in args { pointers.push(unsafe { a.cstring_ptr() }) }
  pointers.push(nullptr)
  let process = unsafe { sdl_create_process(pointers.data(), false) }
  if process == nullptr { None } else { Some(process) }
}

/// Run the program `args[0]` with the rest of `args` as its arguments, to its end: its exit
/// code and everything it wrote, standard error and standard output together, as one
/// string. `None` when it cannot be started (or `args` is empty). The caller waits the
/// whole run — for a short tool (a compiler), not a program that keeps going.
pub let run_process = (args: []string) -> Maybe<(i64, string)> => {
  if args.len() == 0 { return None }
  var pointers: []^u8 = []
  for a in args { pointers.push(unsafe { a.cstring_ptr() }) }
  pointers.push(nullptr)
  let props = unsafe { sdl_create_properties() }
  unsafe {
    sdl_set_pointer_property(props, PROP_ARGS.cstring_ptr(), pointers.data())
    sdl_set_number_property(props, PROP_STDIN.cstring_ptr(), STDIO_NULL)
    sdl_set_number_property(props, PROP_STDOUT.cstring_ptr(), STDIO_APP)
    sdl_set_boolean_property(props, PROP_STDERR_TO_STDOUT.cstring_ptr(), true)
  }
  let process = unsafe { sdl_create_process_with_properties(props) }
  // SDL reads `pointers` here, not when the property is set, and an array is freed after
  // its last use: this one keeps it until now.
  let _ = pointers.len()
  unsafe { sdl_destroy_properties(props) }
  if process == nullptr { return None }
  var size: u64 = 0
  var code: i32 = 0
  let written = unsafe { sdl_read_process(process, &mut size, &mut code) }
  unsafe { sdl_destroy_process(process) }
  if written == nullptr { return None }
  let output = unsafe { written.decode_utf8(i64(size)) }
  unsafe { sdl_free(written) }
  Some((i64(code), output))
}

/// Start the program `args[0]` with the rest of `args` as its arguments, its standard error
/// and output written together to the file at `output` (made, or emptied first): for a
/// caller that polls it with [wait_process] and reads the file once it has ended, rather
/// than waiting on it — a file, not a pipe, so a long output never stalls a program nobody
/// is reading from. `None` when it cannot be started, or the file cannot be opened.
pub let create_process_to_file = (args: []string, output: string) -> Maybe<Process> => {
  if args.len() == 0 { return None }
  let stream = unsafe { sdl_io_from_file(output.cstring_ptr(), "w".cstring_ptr()) }
  if stream == nullptr { return None }
  var pointers: []^u8 = []
  for a in args { pointers.push(unsafe { a.cstring_ptr() }) }
  pointers.push(nullptr)
  let props = unsafe { sdl_create_properties() }
  unsafe {
    sdl_set_pointer_property(props, PROP_ARGS.cstring_ptr(), pointers.data())
    sdl_set_number_property(props, PROP_STDIN.cstring_ptr(), STDIO_NULL)
    sdl_set_number_property(props, PROP_STDOUT.cstring_ptr(), STDIO_REDIRECT)
    sdl_set_pointer_property(props, PROP_STDOUT_STREAM.cstring_ptr(), stream)
    sdl_set_boolean_property(props, PROP_STDERR_TO_STDOUT.cstring_ptr(), true)
  }
  let process = unsafe { sdl_create_process_with_properties(props) }
  // As in `run_process`: the array is read at the create, and must live until then.
  let _ = pointers.len()
  unsafe { sdl_destroy_properties(props) }
  // The program holds the file now; this side's handle is not needed.
  let _ = unsafe { sdl_close_io(stream) }
  if process == nullptr { None } else { Some(process) }
}

/// The program's exit code once it has ended: waiting for that when `block`, and `None`
/// at once if it is still running when not.
pub let wait_process = (process: Process, block: bool) -> Maybe<i64> => {
  var code: i32 = 0
  let ended = unsafe { sdl_wait_process(process, block, &mut code) }
  if ended { Some(i64(code)) } else { None }
}

/// Ask the program to stop (`SIGTERM`), or make it (`SIGKILL`) when `force`. Whether it was
/// still running to be asked.
pub let kill_process = (process: Process, force: bool) -> bool =>
  unsafe { sdl_kill_process(process, force) }

/// Forget the program. One still running is left running.
pub let destroy_process = (process: Process) -> void =>
  unsafe { sdl_destroy_process(process) }
