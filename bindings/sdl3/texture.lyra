module bindings.sdl3
//! Textures: images on the GPU, drawn whole or a cell at a time, flipped, and tinted — made
//! once from a program's own pixels ([create_texture]), or the streaming kind a program
//! draws itself, a frame of pixels at a time.
//!
//! SDL itself only makes a texture from pixels or a surface; loading one from a PNG is
//! `bindings.sdl3_image`'s [load_texture], a separate library with its own module.

/// An `SDL_Texture *` together with its size, so a program can lay out a sprite sheet
/// without asking SDL.
///
/// **A struct rather than a `type`** because `@must_release` needs one (todo.md), and a
/// texture is exactly the resource it is for: GPU memory SDL frees only on request.
/// `handle` is SDL's and nothing outside these bindings reads it.
@must_release(destroy_texture)
pub struct Texture {
  handle: ^u8,
  width: f32,
  height: f32,
}

/// `SDL_ScaleMode`, for [set_default_scale_mode] and [set_texture_scale_mode].
///
/// `SCALE_NEAREST` is what pixel art wants: the default, `SCALE_LINEAR`, blurs every edge
/// the logical presentation scales up. `SCALE_PIXELART` (SDL 3.4) is nearest sampling
/// that stays crisp at non-integer scales too.
pub const SCALE_NEAREST: i32 = 0
pub const SCALE_LINEAR: i32 = 1
pub const SCALE_PIXELART: i32 = 2

/// `SDL_FlipMode`, for [draw_texture_flipped]. `FLIP_BOTH` is both at once — a 180°
/// turn, not a diagonal flip.
pub const FLIP_NONE: i32 = 0
pub const FLIP_HORIZONTAL: i32 = 1
pub const FLIP_VERTICAL: i32 = 2
pub const FLIP_BOTH: i32 = 3

/// `SDL_FPoint` — the rotation centre [draw_texture_flipped] leaves NULL (the middle).
struct Point {
  x: f32,
  y: f32,
}

/// `SDL_PIXELFORMAT_XRGB8888` and `SDL_TEXTUREACCESS_STREAMING`, the one pairing
/// [create_streaming_texture] makes: a texel is a `u32` holding `0x00RRGGBB`.
const PIXELFORMAT_XRGB8888: u32 = 0x16161804
const TEXTUREACCESS_STREAMING: i32 = 1

/// `SDL_PIXELFORMAT_ARGB8888` and `SDL_TEXTUREACCESS_STATIC`, what [create_texture] makes: a
/// texel is a `u32` holding `0xAARRGGBB`. A *packed* format, so the number means the same
/// on every byte order, as the streaming kind's does.
const PIXELFORMAT_ARGB8888: u32 = 0x16362004
const TEXTUREACCESS_STATIC: i32 = 0

/// `SDL_BlendMode`, for [set_texture_blend]: how a drawn texel meets what is beneath.
///
/// `BLEND_ALPHA`, what [create_texture] sets, covers by the texel's alpha. `BLEND_ADD` adds
/// its colour (times its alpha) to what is there — light: a glow, a spark, fire — so dark
/// texels change nothing. `BLEND_NONE` copies the texel, alpha and all; `BLEND_MULTIPLY`
/// darkens by it, a shadow or a tint over the scene.
pub const BLEND_NONE: u32 = 0
pub const BLEND_ALPHA: u32 = 1
pub const BLEND_ADD: u32 = 2
pub const BLEND_MULTIPLY: u32 = 8

/// `SDL_BLENDMODE_BLEND`: a texel's alpha says how much of it covers what is beneath.
const BLENDMODE_BLEND: u32 = BLEND_ALPHA

@symbol("SDL_CreateTexture")
unsafe extern sdl_create_texture: (
  renderer: Renderer,
  format: u32,
  access: i32,
  w: i32,
  h: i32
) -> ^u8

@symbol("SDL_UpdateTexture")
unsafe extern sdl_update_texture: (
  texture: ^u8,
  rect: ^PixelRect,
  pixels: ^u32,
  pitch: i32
) -> bool

@symbol("SDL_DestroyTexture")
unsafe extern sdl_destroy_texture: (texture: ^u8) -> void

@symbol("SDL_GetTextureSize")
unsafe extern sdl_get_texture_size: (texture: ^u8, w: ^mut f32, h: ^mut f32) -> bool

@symbol("SDL_SetTextureBlendMode")
unsafe extern sdl_set_texture_blend_mode: (texture: ^u8, mode: u32) -> bool

@symbol("SDL_SetTextureScaleMode")
unsafe extern sdl_set_texture_scale_mode: (texture: ^u8, mode: i32) -> bool

@symbol("SDL_SetDefaultTextureScaleMode")
unsafe extern sdl_set_default_texture_scale_mode: (renderer: Renderer, mode: i32) -> bool

@symbol("SDL_RenderTexture")
unsafe extern sdl_render_texture: (
  renderer: Renderer,
  texture: ^u8,
  src: ^Rect,
  dst: ^Rect
) -> bool

@symbol("SDL_RenderTextureRotated")
unsafe extern sdl_render_texture_rotated: (
  renderer: Renderer,
  texture: ^u8,
  src: ^Rect,
  dst: ^Rect,
  angle: f64,
  center: ^Point,
  flip: i32,
) -> bool

@symbol("SDL_SetTextureColorMod")
unsafe extern sdl_set_texture_color_mod: (texture: ^u8, r: u8, g: u8, b: u8) -> bool

@symbol("SDL_SetTextureAlphaMod")
unsafe extern sdl_set_texture_alpha_mod: (texture: ^u8, alpha: u8) -> bool

/// Take ownership of a texture another binding made, reading its size — or `None` for
/// NULL, which is how every SDL constructor reports failure.
///
/// **`unsafe` because the pointer is kept**: nothing can check that `handle` is a live
/// `SDL_Texture *` rather than any other pointer, and the result will be destroyed as one.
/// It is how `bindings.sdl3_image` hands its textures over.
pub let adopt_texture = unsafe (handle: ^u8) -> Maybe<Texture> => {
  if handle == nullptr {
    None
  } else {
    var w: f32 = 0.0
    var h: f32 = 0.0
    sdl_get_texture_size(handle, &mut w, &mut h)
    Some(Texture { handle: handle, width: w, height: h })
  }
}

/// A texture a program fills itself, `width` × `height` texels of `0x00RRGGBB` — an
/// emulator's screen, say — or `None` if SDL cannot make one. Fill it with
/// [update_texture], as often as every frame.
pub let create_streaming_texture = (
  renderer: Renderer,
  width: i64,
  height: i64
) -> Maybe<Texture> =>
  unsafe {
    adopt_texture(sdl_create_texture(
      renderer,
      PIXELFORMAT_XRGB8888,
      TEXTUREACCESS_STREAMING,
      i32(width),
      i32(height)
    ))
  }

/// A texture of `width` × `height` texels from `pixels`, row by row, `0xAARRGGBB` each —
/// a sprite sheet or a tile set a program holds as data — or `None` if SDL cannot make one,
/// or there is not exactly one pixel per texel. It is drawn **blended**: alpha 0 is
/// transparent, so a sprite's background shows what is behind it.
pub let create_texture = (
  renderer: Renderer,
  width: i64,
  height: i64,
  pixels: []u32
) -> Maybe<Texture> => {
  if width <= 0 || height <= 0 || pixels.len() != width * height {
    return None
  }
  let made = unsafe {
    adopt_texture(sdl_create_texture(
      renderer,
      PIXELFORMAT_ARGB8888,
      TEXTUREACCESS_STATIC,
      i32(width),
      i32(height)
    ))
  }
  let Some(texture) = made else { return None }
  let filled = unsafe {
    sdl_update_texture(texture.handle, nullptr, pixels.data(), i32(width * 4)) &&
      sdl_set_texture_blend_mode(texture.handle, BLENDMODE_BLEND)
  }
  if filled {
    Some(texture)
  } else {
    destroy_texture(texture)
    None
  }
}

/// Replace a streaming texture's texels with `pixels`, row by row, `0x00RRGGBB` each. Fails
/// (answers `false`, changing nothing) unless there is exactly one per texel.
pub let update_texture = (texture: Texture, pixels: []u32) -> bool => {
  let width = i64(round(texture.width))
  if pixels.len() == 0 || pixels.len() != width * i64(round(texture.height)) {
    false
  } else {
    unsafe { sdl_update_texture(texture.handle, nullptr, pixels.data(), i32(width * 4)) }
  }
}

/// Replace the `area` of a texture made by [create_texture] with `pixels`, row by row,
/// `0xAARRGGBB` each — a glyph added to an atlas. Fails (answers `false`, changing nothing)
/// unless there is exactly one pixel per texel of `area`.
pub let update_texture_area = (
  texture: Texture,
  area: PixelRect,
  pixels: []u32
) -> bool => {
  if area.w <= 0 || area.h <= 0 || pixels.len() != i64(area.w) * i64(area.h) {
    false
  } else {
    unsafe { sdl_update_texture(texture.handle, &area, pixels.data(), area.w * 4) }
  }
}

/// Free a texture. It must not be drawn afterwards.
pub let destroy_texture = (texture: Texture) -> void =>
  unsafe { sdl_destroy_texture(texture.handle) }

/// How textures created *from now on* are sampled when scaled. Set it before loading.
pub let set_default_scale_mode = (renderer: Renderer, mode: i32) -> bool =>
  unsafe { sdl_set_default_texture_scale_mode(renderer, mode) }

/// How this texture is sampled when scaled, whatever the renderer's default was when it was
/// made.
pub let set_texture_scale_mode = (texture: Texture, mode: i32) -> bool =>
  unsafe { sdl_set_texture_scale_mode(texture.handle, mode) }

/// Draw the `src` part of a texture into `dst`, stretching it to fit — for a sprite sheet,
/// `src` is one cell and `dst` the same size where it goes on screen.
pub let draw_texture = (
  renderer: Renderer,
  texture: Texture,
  src: Rect,
  dst: Rect
) -> bool =>
  unsafe { sdl_render_texture(renderer, texture.handle, &src, &dst) }

/// [draw_texture], mirrored by a `FLIP_*` constant. The NES flipped sprites in hardware so
/// one drawing could face both ways; this is the same economy.
pub let draw_texture_flipped = (
  renderer: Renderer,
  texture: Texture,
  src: Rect,
  dst: Rect,
  flip: i32,
) -> bool =>
  unsafe { sdl_render_texture_rotated(
    renderer,
    texture.handle,
    &src,
    &dst,
    0.0,
    nullptr,
    flip
  ) }

/// [draw_texture], turned `angle` degrees clockwise about the middle of `dst` and mirrored
/// by a `FLIP_*` constant.
pub let draw_texture_rotated = (
  renderer: Renderer,
  texture: Texture,
  src: Rect,
  dst: Rect,
  angle: f64,
  flip: i32,
) -> bool =>
  unsafe { sdl_render_texture_rotated(
    renderer,
    texture.handle,
    &src,
    &dst,
    angle,
    nullptr,
    flip
  ) }

/// How the texture's texels meet what they are drawn over: a `BLEND_*` constant. The
/// **texture's state**, as its colour and alpha are: set it back after a draw that changed it.
pub let set_texture_blend = (texture: Texture, mode: u32) -> bool =>
  unsafe { sdl_set_texture_blend_mode(texture.handle, mode) }

/// Multiply every texel by `color` when drawing (its `a` is ignored — see
/// [set_texture_alpha]). White leaves the texture as it is, so a sprite drawn in light
/// greys can be tinted into several palettes.
pub let set_texture_color = (texture: Texture, color: Color) -> bool =>
  unsafe { sdl_set_texture_color_mod(texture.handle, color.r, color.g, color.b) }

/// Multiply every texel's alpha by `alpha / 255` when drawing.
pub let set_texture_alpha = (texture: Texture, alpha: u8) -> bool =>
  unsafe { sdl_set_texture_alpha_mod(texture.handle, alpha) }
