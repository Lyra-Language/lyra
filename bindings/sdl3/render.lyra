module bindings.sdl3
//! The 2D renderer: colours, primitives, debug text, a logical screen size, and reading
//! the frame back out.

/// An `SDL_Renderer *`. A `type` for the reason [Window] is one.
pub type Renderer = ^u8

/// An `SDL_Surface *`, which only [save_screenshot] and [read_pixels] ever hold — so it
/// stays private. An `alias`, not a `type`, so a surface passes where `^u8` is taken:
/// `SDL_DestroySurface` is declared over `^u8`, as `bindings.sdl3_image` declares it.
alias Surface = ^u8

/// `SDL_FRect` — the rectangle SDL draws, in floats.
///
/// It crosses **by pointer**, which is what `SDL_RenderFillRect` asks for, so this is an
/// ordinary struct and the boundary has nothing to be clever about. Lyra's struct layout
/// already matches C's — the FFI fixture proves `sizeof` and every `offsetof` — so this is
/// a transcription and nothing more.
pub struct Rect {
  x: f32,
  y: f32,
  w: f32,
  h: f32,
}

/// `SDL_Color`. Components are 0–255; `a` is 255 for opaque.
pub struct Color {
  r: u8,
  g: u8,
  b: u8,
  a: u8,
}

/// A frame read back from the renderer ([read_pixels]): `width` × `height` pixels, row by
/// row, `0xAARRGGBB` each — what a test compares against the picture it expected.
pub struct Pixels {
  width: i64,
  height: i64,
  argb: []u32,
}

/// `SDL_Rect` — a rectangle in whole pixels: what SDL clips drawing to ([set_clip]), and the
/// part of a texture [update_texture_area] writes.
pub struct PixelRect {
  x: i32,
  y: i32,
  w: i32,
  h: i32,
}

/// `SDL_Vertex` — one corner of a triangle [draw_geometry] draws: where it is, its colour
/// (`0.0`–`1.0` a channel, alpha not premultiplied), and where in a texture it reads
/// (`0.0`–`1.0` across and down). SDL nests a point, a colour and a point; eight floats in a
/// row are the same layout, and a program fills them by name.
pub struct Vertex {
  x: f32,
  y: f32,
  r: f32,
  g: f32,
  b: f32,
  a: f32,
  u: f32,
  v: f32,
}

/// An opaque colour, which is nearly every colour a program names.
pub let rgb = pure (r: u8, g: u8, b: u8) -> Color => Color { r: r, g: g, b: b, a: 255 }

/// `SDL_RendererLogicalPresentation`, for [set_logical_presentation].
///
/// `PRESENT_INTEGER_SCALE` is the one a pixel-art program wants: the logical screen is
/// scaled by a whole number and letterboxed, so every logical pixel is the same size.
pub const PRESENT_DISABLED: i32 = 0
pub const PRESENT_STRETCH: i32 = 1
pub const PRESENT_LETTERBOX: i32 = 2
pub const PRESENT_OVERSCAN: i32 = 3
pub const PRESENT_INTEGER_SCALE: i32 = 4

/// `SDL_DEBUG_TEXT_FONT_CHARACTER_SIZE`: every [debug_text] glyph is this many pixels
/// square, so a string is `8 * length` wide.
pub const DEBUG_TEXT_SIZE: f32 = 8.0

@symbol("SDL_CreateRenderer")
unsafe extern sdl_create_renderer: (window: Window, name: ^u8) -> Renderer

@symbol("SDL_DestroyRenderer")
unsafe extern sdl_destroy_renderer: (renderer: Renderer) -> void

@symbol("SDL_SetRenderLogicalPresentation")
unsafe extern sdl_set_render_logical_presentation: (
  renderer: Renderer,
  w: i32,
  h: i32,
  mode: i32,
) -> bool

@symbol("SDL_SetRenderVSync")
unsafe extern sdl_set_render_vsync: (renderer: Renderer, vsync: i32) -> bool

@symbol("SDL_SetRenderDrawColor")
unsafe extern sdl_set_draw_color: (renderer: Renderer, r: u8, g: u8, b: u8, a: u8) -> bool

@symbol("SDL_SetRenderDrawBlendMode")
unsafe extern sdl_set_render_draw_blend_mode: (renderer: Renderer, mode: u32) -> bool

@symbol("SDL_SetRenderScale")
unsafe extern sdl_set_render_scale: (renderer: Renderer, x: f32, y: f32) -> bool

@symbol("SDL_GetRenderOutputSize")
unsafe extern sdl_get_render_output_size: (
  renderer: Renderer,
  w: ^mut i32,
  h: ^mut i32
) -> bool

@symbol("SDL_RenderClear")
unsafe extern sdl_render_clear: (renderer: Renderer) -> bool

@symbol("SDL_RenderPoint")
unsafe extern sdl_render_point: (renderer: Renderer, x: f32, y: f32) -> bool

@symbol("SDL_RenderLine")
unsafe extern sdl_render_line: (
  renderer: Renderer,
  x1: f32,
  y1: f32,
  x2: f32,
  y2: f32
) -> bool

@symbol("SDL_RenderRect")
unsafe extern sdl_render_rect: (renderer: Renderer, rect: ^Rect) -> bool

@symbol("SDL_RenderFillRect")
unsafe extern sdl_render_fill_rect: (renderer: Renderer, rect: ^Rect) -> bool

@symbol("SDL_RenderDebugText")
unsafe extern sdl_render_debug_text: (
  renderer: Renderer,
  x: f32,
  y: f32,
  text: ^u8
) -> bool

@symbol("SDL_RenderCoordinatesFromWindow")
unsafe extern sdl_render_coordinates_from_window: (
  renderer: Renderer,
  window_x: f32,
  window_y: f32,
  x: ^mut f32,
  y: ^mut f32,
) -> bool

@symbol("SDL_RenderPresent")
unsafe extern sdl_render_present: (renderer: Renderer) -> bool

@symbol("SDL_RenderReadPixels")
unsafe extern sdl_render_read_pixels: (renderer: Renderer, rect: ^Rect) -> Surface

@symbol("SDL_SaveBMP")
unsafe extern sdl_save_bmp: (surface: Surface, file: ^u8) -> bool

@symbol("SDL_GetCurrentRenderOutputSize")
unsafe extern sdl_get_current_render_output_size: (
  renderer: Renderer,
  w: ^mut i32,
  h: ^mut i32
) -> bool

@symbol("SDL_ReadSurfacePixel")
unsafe extern sdl_read_surface_pixel: (
  surface: Surface,
  x: i32,
  y: i32,
  r: ^mut u8,
  g: ^mut u8,
  b: ^mut u8,
  a: ^mut u8,
) -> bool

// Over `^u8`, not `Surface`: `bindings.sdl3_image` declares it so, and the backend compares two
// declarations of one C symbol with an alias's name unexpanded (todo.md).
@symbol("SDL_DestroySurface")
unsafe extern sdl_destroy_surface: (surface: ^u8) -> void

@symbol("SDL_RenderGeometry")
unsafe extern sdl_render_geometry: (
  renderer: Renderer,
  texture: ^u8,
  vertices: ^Vertex,
  num_vertices: i32,
  indices: ^i32,
  num_indices: i32,
) -> bool

@symbol("SDL_SetRenderClipRect")
unsafe extern sdl_set_render_clip_rect: (renderer: Renderer, rect: ^PixelRect) -> bool

impl Window {
  /// The renderer for a window, or `None` if SDL could not make one.
  ///
  /// `nullptr` asks SDL to choose a driver, which is the call the null literal exists for:
  /// before it there was no way to pass NULL and no way to test one either.
  pub let create_renderer = (self) -> Maybe<Renderer> => {
    let r = unsafe { sdl_create_renderer(self, nullptr) }
    if r == nullptr { None } else { Some(r) }
  }

  /// A renderer of the kind named — `"gpu"` for SDL's GPU renderer, the one custom shaders
  /// run on ([create_msl_effect]) — or `None` if SDL has no such renderer here.
  pub let create_named_renderer = (self, name: string) -> Maybe<Renderer> => {
    let r = name.with_cstring((n) => unsafe { sdl_create_renderer(self, n) })
    if r == nullptr { None } else { Some(r) }
  }
}

/// Release a renderer.
pub let destroy_renderer = (renderer: Renderer) -> void =>
  unsafe { sdl_destroy_renderer(renderer) }

impl Renderer {
  /// Draw in a `width` × `height` coordinate space whatever size the window is. `mode` is a
  /// `PRESENT_*` constant and says how that space is fitted to the window.
  ///
  /// Everything drawn is scaled — points become squares and [debug_text] grows with them —
  /// which is exactly the look of a low-resolution screen blown up.
  pub let set_logical_presentation = (
    self,
    width: i32,
    height: i32,
    mode: i32,
  ) -> bool =>
    unsafe { sdl_set_render_logical_presentation(self, width, height, mode) }

  /// Wait for the display's refresh on [present], which paces a loop at the display's rate
  /// with no timing code at all. `false` turns it off.
  pub let set_vsync = (self, on: bool) -> bool =>
    unsafe { sdl_set_render_vsync(self, if on { 1 } else { 0 }) }

  /// Set the colour subsequent drawing uses.
  pub let set_draw_color = (self, color: Color) -> bool =>
    unsafe { sdl_set_draw_color(self, color.r, color.g, color.b, color.a) }

  /// Fill the whole target with the current draw colour.
  pub let clear = (self) -> bool => unsafe { sdl_render_clear(self) }

  /// How what is drawn next — points, lines, rectangles — meets what is there: `BLEND_NONE`
  /// (replacing it, SDL's default), or `BLEND_ALPHA` for a colour's alpha to see through.
  pub let set_draw_blend = (self, mode: u32) -> bool =>
    unsafe { sdl_set_render_draw_blend_mode(self, mode) }

  /// Draw everything that follows `x` and `y` times its size — [debug_text]'s 8-pixel letters
  /// grown for a large screen. `1, 1` is as drawn.
  pub let set_scale = (self, x: f32, y: f32) -> bool =>
    unsafe { sdl_set_render_scale(self, x, y) }

  /// The whole window's size, in its real pixels — a phone's, not its points — whatever logical
  /// screen is drawn in it (`SDL_GetCurrentRenderOutputSize` answers that screen's share).
  pub let output_size = (self) -> (i64, i64) => {
    var w: i32 = 0
    var h: i32 = 0
    unsafe { sdl_get_render_output_size(self, &mut w, &mut h) }
    (i64(w), i64(h))
  }

  /// Plot one point in the current draw colour.
  pub let draw_point = (self, x: f32, y: f32) -> bool =>
    unsafe { sdl_render_point(self, x, y) }

  /// Draw a line between two points, both ends included.
  pub let draw_line = (self, x1: f32, y1: f32, x2: f32, y2: f32) -> bool =>
    unsafe { sdl_render_line(self, x1, y1, x2, y2) }

  /// Outline one rectangle, one pixel wide, inside its bounds.
  pub let draw_rect = (self, rect: Rect) -> bool =>
    unsafe { sdl_render_rect(self, &rect) }

  /// Fill one rectangle with the current draw colour.
  ///
  /// The rectangle is taken **by reference** here as it is in C — `&rect` at the call is the
  /// address of the caller's own storage, and SDL only reads through it.
  pub let fill_rect = (self, rect: Rect) -> bool =>
    unsafe { sdl_render_fill_rect(self, &rect) }

  /// Write `text` with SDL's built-in 8×8 font, top-left corner at (`x`, `y`), in the
  /// current draw colour. It covers ASCII only — anything else draws as a placeholder.
  pub let debug_text = (self, x: f32, y: f32, text: string) -> bool =>
    text.with_cstring((t) => unsafe { sdl_render_debug_text(self, x, y, t) })

  /// Show everything drawn since the last present.
  pub let present = (self) -> bool =>
    unsafe { sdl_render_present(self) }

  /// Write what has been drawn this frame to `path` as a BMP. Call it **before** [present],
  /// which is what hands the frame away.
  ///
  /// The image is the window's real pixels, not the logical screen's, so a 256×240 screen in
  /// a 768×720 window saves at 768×720.
  pub let save_screenshot = (self, path: string) -> bool => {
    let surface = unsafe { sdl_render_read_pixels(self, nullptr) }
    if surface == nullptr {
      false
    } else {
      let saved = path.with_cstring((p) => unsafe { sdl_save_bmp(surface, p) })
      unsafe { sdl_destroy_surface(surface) }
      saved
    }
  }

  /// What has been drawn this frame, as pixels — or `None` if SDL cannot read it back. Call
  /// it **before** [present], as [save_screenshot].
  ///
  /// The size is the window's real pixels, not the logical screen's, as a screenshot's is:
  /// a test that wants one pixel per logical pixel opens its window at scale 1.
  ///
  /// A pixel at a time (`SDL_ReadSurfacePixel`), which converts from whatever format the
  /// renderer reads in: slow for a large window, and only a test reads a frame back.
  pub let read_pixels = (self) -> Maybe<Pixels> => {
    var w: i32 = 0
    var h: i32 = 0
    if !unsafe { sdl_get_current_render_output_size(self, &mut w, &mut h) } {
      return None
    }
    let surface = unsafe { sdl_render_read_pixels(self, nullptr) }
    if surface == nullptr {
      return None
    }
    var argb: []u32 = []
    var r: u8 = 0
    var g: u8 = 0
    var b: u8 = 0
    var a: u8 = 0
    var whole = true
    for y in 0..<h {
      for x in 0..<w {
        if !unsafe { sdl_read_surface_pixel(
          surface,
          x,
          y,
          &mut r,
          &mut g,
          &mut b,
          &mut a
        ) } {
          whole = false
        }
        argb.push(u32(a) << 24 | u32(r) << 16 | u32(g) << 8 | u32(b))
      }
    }
    unsafe { sdl_destroy_surface(surface) }
    if whole { Some(Pixels { width: i64(w), height: i64(h), argb: argb }) } else { None }
  }

  /// A window position — a mouse event's, or [mouse_state]'s — in the renderer's own
  /// coordinates: the logical screen when one is set, with its scale and letterboxing
  /// undone. A point in the letterbox answers a position off the logical screen (negative,
  /// or past its size), which is how a program tells the mouse is outside it.
  pub let window_to_render = (self, x: f32, y: f32) -> (f32, f32) => {
    var rx: f32 = 0.0
    var ry: f32 = 0.0
    unsafe { sdl_render_coordinates_from_window(self, x, y, &mut rx, &mut ry) }
    (rx, ry)
  }

  /// Draw triangles, each three of `indices` naming its corners in `vertices`, coloured by
  /// them and blended by their alpha as [set_draw_blend] says. Anything a rectangle cannot
  /// be — a rounded corner, an edge softened to look smooth — is triangles. Nothing to draw
  /// draws nothing.
  pub let draw_geometry = (self, vertices: []Vertex, indices: []i32) -> bool => {
    if vertices.len() == 0 || indices.len() == 0 {
      return true
    }
    unsafe { sdl_render_geometry(
      self,
      nullptr,
      vertices.data(),
      i32(vertices.len()),
      indices.data(),
      i32(indices.len())
    ) }
  }

  /// [draw_geometry] reading `texture` at each corner's `u`, `v`, its texels multiplied by
  /// the corners' colour — white leaves them as they are — and blended as the texture's
  /// [set_texture_blend] says.
  pub let draw_textured_geometry = (
    self,
    texture: Texture,
    vertices: []Vertex,
    indices: []i32,
  ) -> bool => {
    if vertices.len() == 0 || indices.len() == 0 {
      return true
    }
    unsafe { sdl_render_geometry(
      self,
      texture.handle,
      vertices.data(),
      i32(vertices.len()),
      indices.data(),
      i32(indices.len())
    ) }
  }

  /// Draw only inside `rect`, in the renderer's coordinates, until [clear_clip] — or another
  /// `set_clip`, which replaces it rather than narrowing it.
  pub let set_clip = (self, rect: PixelRect) -> bool =>
    unsafe { sdl_set_render_clip_rect(self, &rect) }

  /// Draw anywhere again.
  pub let clear_clip = (self) -> bool =>
    unsafe { sdl_set_render_clip_rect(self, nullptr) }
}
