module bindings.sdl3
//! The event queue — and the one place in these bindings where the conversion is
//! interesting rather than mechanical.
//!
//! **`SDL_Event` is an untagged union and `Event` is a tagged one**, which is the whole
//! difference between C's model and Lyra's. A union records nothing about which member is
//! live, so reading one is `unsafe`; a `data` type carries a discriminant, which is what
//! lets `match` be exhaustive over it. [poll_event] is the conversion: it reads the tag,
//! reads the one member that tag licenses, and answers a value that cannot lie about
//! which it is.
//!
//! That conversion has to happen *somewhere*, and here is the right somewhere — once, in
//! the binding, rather than in every program's event loop. It is why a caller of this
//! module writes no `unsafe`.

/// `SDL_KeyboardEvent`, field for field.
///
/// Every field is present although only `key` is read: the layout is what puts `key` at
/// offset 28, and a missing `reserved` or `which` would move it and read a neighbouring
/// field instead. That is the boundary's characteristic failure — it links cleanly and
/// gives a plausible wrong answer.
///
/// `down` and `repeat` are C's `bool`, a **byte**; Lyra's is one bit and is refused at the
/// boundary, so they are `u8`.
struct KeyboardEvent {
  kind: u32,
  reserved: u32,
  timestamp: u64,
  window_id: u32,
  which: u32,
  scancode: u32,
  key: u32,
  modifiers: u16,
  raw: u16,
  down: u8,
  repeat: u8,
}

/// `SDL_MouseMotionEvent`.
struct MouseMotionEvent {
  kind: u32,
  reserved: u32,
  timestamp: u64,
  window_id: u32,
  which: u32,
  state: u32,
  x: f32,
  y: f32,
  xrel: f32,
  yrel: f32,
}

/// `SDL_MouseButtonEvent`.
struct MouseButtonEvent {
  kind: u32,
  reserved: u32,
  timestamp: u64,
  window_id: u32,
  which: u32,
  button: u8,
  down: u8,
  clicks: u8,
  padding: u8,
  x: f32,
  y: f32,
}

/// `SDL_MouseWheelEvent`. The integer tick counts (3.2.12+) are transcribed for the layout
/// and not read: a trackpad scrolls in fractions, and the fractions are what a program
/// wants to accumulate.
struct MouseWheelEvent {
  kind: u32,
  reserved: u32,
  timestamp: u64,
  window_id: u32,
  which: u32,
  x: f32,
  y: f32,
  direction: u32,
  mouse_x: f32,
  mouse_y: f32,
  integer_x: i32,
  integer_y: i32,
}

/// `SDL_GamepadDeviceEvent` — a pad arriving or leaving.
struct GamepadDeviceEvent {
  kind: u32,
  reserved: u32,
  timestamp: u64,
  which: u32,
}

/// `SDL_GamepadButtonEvent` — a pad's button pressed or let go.
struct GamepadButtonEvent {
  kind: u32,
  reserved: u32,
  timestamp: u64,
  which: u32,
  button: u8,
  down: u8,
  padding1: u8,
  padding2: u8,
}

/// `SDL_TouchFingerEvent` — a finger on a touch screen (or a trackpad), its place normalised
/// to 0–1 across the window.
struct TouchFingerEvent {
  kind: u32,
  reserved: u32,
  timestamp: u64,
  touch: u64,
  finger: u64,
  x: f32,
  y: f32,
  dx: f32,
  dy: f32,
  pressure: f32,
  window: u32,
}

/// `SDL_WindowEvent` — something that happened to a window; `data1` and `data2` are its new
/// size for a resize.
struct WindowEvent {
  kind: u32,
  reserved: u32,
  timestamp: u64,
  window_id: u32,
  data1: i32,
  data2: i32,
}

/// `SDL_TextInputEvent` — text typed, UTF-8, in memory SDL owns: copied out as the event is
/// read.
struct TextInputEvent {
  kind: u32,
  reserved: u32,
  timestamp: u64,
  window_id: u32,
  text: ^u8,
}

/// `SDL_DropEvent` — a file (or text) dropped on the window, or a drop beginning or ending:
/// where, and for a file its path, UTF-8 in memory SDL owns.
struct DropEvent {
  kind: u32,
  reserved: u32,
  timestamp: u64,
  window_id: u32,
  x: f32,
  y: f32,
  source: ^u8,
  data: ^u8,
}

/// `SDL_TextEditingEvent` — an input method's composition, UTF-8 in memory SDL owns, and the
/// part of it selected (`start`, `length` in characters; -1 for none).
struct TextEditingEvent {
  kind: u32,
  reserved: u32,
  timestamp: u64,
  window_id: u32,
  text: ^u8,
  start: i32,
  length: i32,
}

/// `SDL_Event` — 128 bytes, read as a `u32` to find the tag and as a struct to read the
/// payload that tag selects.
///
/// The `padding` member is what fixes the size at 128. SDL declares it so the union's size
/// never changes as it adds event types; without it Lyra would size the union at 40 — the
/// largest real member here — and `SDL_PollEvent` would write 88 bytes past the end of the
/// caller's stack slot. That is a stack smash rather than a wrong value, which is why the
/// member is transcribed even though nothing reads it.
union RawEvent {
  kind: u32,
  key: KeyboardEvent,
  motion: MouseMotionEvent,
  button: MouseButtonEvent,
  wheel: MouseWheelEvent,
  device: GamepadDeviceEvent,
  gamepad_button: GamepadButtonEvent,
  finger: TouchFingerEvent,
  window: WindowEvent,
  text: TextInputEvent,
  editing: TextEditingEvent,
  drop: DropEvent,
  padding: [128]u8,
}

const EVENT_QUIT: u32 = 0x100
const EVENT_TERMINATING: u32 = 0x101
const EVENT_WILL_ENTER_BACKGROUND: u32 = 0x103
const EVENT_DID_ENTER_FOREGROUND: u32 = 0x106
const EVENT_KEY_DOWN: u32 = 0x300
const EVENT_KEY_UP: u32 = 0x301
const EVENT_TEXT_EDITING: u32 = 0x302
const EVENT_TEXT_INPUT: u32 = 0x303
const EVENT_WINDOW_FOCUS_GAINED: u32 = 0x20E
const EVENT_WINDOW_FOCUS_LOST: u32 = 0x20F
const EVENT_WINDOW_RESIZED: u32 = 0x206
const EVENT_DROP_FILE: u32 = 0x1000
const EVENT_DROP_BEGIN: u32 = 0x1002
const EVENT_DROP_COMPLETE: u32 = 0x1003
const EVENT_WINDOW_DISPLAY_SCALE_CHANGED: u32 = 0x214
const EVENT_MOUSE_MOTION: u32 = 0x400
const EVENT_MOUSE_BUTTON_DOWN: u32 = 0x401
const EVENT_MOUSE_BUTTON_UP: u32 = 0x402
const EVENT_MOUSE_WHEEL: u32 = 0x403
/// `SDL_MOUSEWHEEL_FLIPPED`: the platform's "natural scrolling" is on, and the amounts
/// arrive negated. [poll_event] undoes it, so a wheel event always means the same thing, and
/// says it did — for a scroll view, which moves its content the way the system's do.
const WHEEL_FLIPPED: u32 = 1
const EVENT_GAMEPAD_BUTTON_DOWN: u32 = 0x651
const EVENT_GAMEPAD_ADDED: u32 = 0x653
const EVENT_GAMEPAD_REMOVED: u32 = 0x654
const EVENT_FINGER_DOWN: u32 = 0x700
const EVENT_FINGER_UP: u32 = 0x701
const EVENT_FINGER_MOTION: u32 = 0x702
const EVENT_FINGER_CANCELED: u32 = 0x703


/// One thing that happened, as a type that records which thing it is.
///
/// `Other` carries the raw SDL event code, so a program can recognise something these
/// bindings do not model without the module having to grow a variant for it — and so that
/// widening this enumeration later never silently changes what an existing `match` does.
pub data Event =
  | Quit
  | KeyDown(u32)
  | KeyUp(u32)
  | MouseMotion(f32, f32)
  /// A button pressed at (x, y), and the clicks in a row it makes — 1, 2 for a double click,
  /// 3 for a triple — counted by SDL at the system's double-click speed.
  | MouseDown(u8, f32, f32, u8)
  | MouseUp(u8, f32, f32)
  /// Scrolled by (x, y): x positive to the right, y positive away from the user — the
  /// same direction whatever the platform's natural-scrolling setting — and whether that
  /// setting is on (the amounts arrived flipped).
  | MouseWheel(f32, f32, bool)
  | GamepadAdded(u32)
  | GamepadRemoved(u32)
  /// A gamepad's button pressed: the pad's id, and the button (`BUTTON_*`).
  | GamepadButtonDown(u32, u8)
  /// A finger touching, moving or lifted — its id, and where, `0.0`–`1.0` across and down
  /// the window. A finger the system took back (a gesture of its own) is lifted.
  | FingerDown(u64, f32, f32)
  | FingerMotion(u64, f32, f32)
  | FingerUp(u64, f32, f32)
  /// The app about to leave the screen (another app, the home screen, a call), and back on
  /// it: on a phone, a game pauses between them. **Arrives late**: SDL asks for these in a
  /// callback (`SDL_AddEventWatch`), and polled they can come only when the app is running
  /// again — enough to stop a game catching up the time it was away.
  | WillEnterBackground
  | DidEnterForeground
  /// The system is ending the app.
  | Terminating
  /// Text typed — a key's character, or what an input method composed — while the window
  /// asks for text ([start_text_input]). A key's [KeyDown] arrives as well.
  | TextInput(string)
  /// An input method's text being composed — not yet typed — with the part selected in it:
  /// where it starts and how long it is, in characters (`-1` for none). An empty text ends the
  /// composition.
  | TextEditing(string, i32, i32)
  /// The window gained the keyboard's focus, or lost it.
  | WindowFocusGained
  | WindowFocusLost
  /// The window was resized, to a width and height in its own coordinates (points, which
  /// a high-density display shows at more than one pixel each).
  | WindowResized(i32, i32)
  /// The window's display scale changed ([window_display_scale]): it moved to another
  /// display, or the user changed the scale of this one.
  | WindowScaleChanged
  /// Files dropped on the window — or, on a Mac, opened from Finder — arrive between a
  /// [DropBegin] and a [DropComplete], a [DropFile] a path.
  | DropBegin
  | DropFile(string)
  | DropComplete
  | Other(u32)

@symbol("SDL_PollEvent")
unsafe extern sdl_poll_event: (event: ^mut RawEvent) -> bool

/// Take the next event off the queue, or `None` when it is empty.
///
/// **The tag is read first, and only then the member it licenses.** That is the whole
/// discipline an untagged union asks of a reader, and doing it here means no caller ever
/// has to: what comes back is a `data` value whose variant *is* the fact that was checked.
pub let poll_event = () -> Maybe<Event> => {
  // A union Lyra allocated and SDL writes through — the direction that proves the size,
  // since a short buffer would be a stack smash rather than a wrong answer.
  var raw = RawEvent { padding: #[0; 128] }
  let got = unsafe { sdl_poll_event(&mut raw) }
  if !got {
    None
  } else {
    Some(classify(raw))
  }
}

/// [poll_event], with the modifiers held as a key event was made (`MOD_*`; 0 for any other
/// event) — the event's own, where `modifiers()` is what is held when it is asked, which for
/// an event further back in the queue is not the same.
pub let poll_event_with_modifiers = () -> Maybe<(Event, u16)> => {
  var raw = RawEvent { padding: #[0; 128] }
  if !unsafe { sdl_poll_event(&mut raw) } { return None }
  Some((classify(raw), key_modifiers_of(raw)))
}

/// [wait_event], with the modifiers held as a key event was made, as
/// [poll_event_with_modifiers] answers them.
pub let wait_event_with_modifiers = (timeout_ms: i64) -> Maybe<(Event, u16)> => {
  var raw = RawEvent { padding: #[0; 128] }
  let wait = i32(timeout_ms.clamp(-1, 2147483647))
  if !unsafe { sdl_wait_event_timeout(&mut raw, wait) } { return None }
  Some((classify(raw), key_modifiers_of(raw)))
}

/// A key event's own modifiers; 0 for any other event.
let key_modifiers_of = pure (raw: RawEvent) -> u16 => {
  let kind = unsafe { raw.kind }
  if kind == EVENT_KEY_DOWN || kind == EVENT_KEY_UP { unsafe { raw.key.modifiers } } else { 0 }
}

@symbol("SDL_WaitEventTimeout")
unsafe extern sdl_wait_event_timeout: (event: ^mut RawEvent, timeout_ms: i32) -> bool

/// [poll_event], waiting up to `timeout_ms` milliseconds for an event when there is none —
/// `None` if none came. A program that draws only when something happens sleeps here
/// rather than spinning; a negative `timeout_ms` waits as long as it takes.
pub let wait_event = (timeout_ms: i64) -> Maybe<Event> => {
  var raw = RawEvent { padding: #[0; 128] }
  let wait = i32(timeout_ms.clamp(-1, 2147483647))
  if unsafe { sdl_wait_event_timeout(
    &mut raw,
    wait
  ) } { Some(classify(raw)) } else { None }
}

/// Have SDL call `filter` with each event as it is queued — including those it sends while
/// the system holds the main thread, as macOS does for as long as a window is resized by
/// dragging, when a program's own loop gets nothing. `filter` is a C callback, so a top-level
/// function (`lyra-E066`), given `userdata` and the event's first word (`^u32`, read with
/// [live_resize]); it answers 1. An extern, so the call is `unsafe { add_event_watch(f, nullptr) }`.
@symbol("SDL_AddEventWatch")
pub extern add_event_watch: (filter: (^u8, ^u32) -> u8, userdata: ^u8) -> bool

/// Whether `event`, as an event watch is handed it, is the frame a live resize asks for:
/// a window exposed while it is being resized (`SDL_EVENT_WINDOW_EXPOSED` with `data1` 1),
/// to be drawn there and then.
pub let live_resize = pure (event: ^u32) -> bool => unsafe {
  event.offset(0)^ == EVENT_WINDOW_EXPOSED && event.offset(5)^ == 1
}

/// `SDL_EVENT_WINDOW_EXPOSED`; a window event's `data1` is its sixth 32-bit word.
const EVENT_WINDOW_EXPOSED: u32 = 0x204

/// Read the tag, then the one member it selects.
let classify = pure (raw: RawEvent) -> Event => {
  let kind = unsafe { raw.kind }
  if kind == EVENT_QUIT {
    Quit
  } else if kind == EVENT_KEY_DOWN {
    KeyDown(unsafe { raw.key.key })
  } else if kind == EVENT_KEY_UP {
    KeyUp(unsafe { raw.key.key })
  } else if kind == EVENT_MOUSE_MOTION {
    MouseMotion(unsafe { raw.motion.x }, unsafe { raw.motion.y })
  } else if kind == EVENT_MOUSE_BUTTON_DOWN {
    MouseDown(
      unsafe { raw.button.button },
      unsafe { raw.button.x },
      unsafe { raw.button.y },
      unsafe { raw.button.clicks }
    )
  } else if kind == EVENT_MOUSE_BUTTON_UP {
    MouseUp(
      unsafe { raw.button.button },
      unsafe { raw.button.x },
      unsafe { raw.button.y }
    )
  } else if kind == EVENT_MOUSE_WHEEL {
    let flipped = unsafe { raw.wheel.direction } == WHEEL_FLIPPED
    let sign: f32 = if flipped { -1.0 } else { 1.0 }
    MouseWheel(unsafe { raw.wheel.x } * sign, unsafe { raw.wheel.y } * sign, flipped)
  } else if kind == EVENT_TEXT_INPUT {
    TextInput(c_name(unsafe { raw.text.text }))
  } else if kind == EVENT_TEXT_EDITING {
    TextEditing(
      c_name(unsafe { raw.editing.text }),
      unsafe { raw.editing.start },
      unsafe { raw.editing.length }
    )
  } else if kind == EVENT_WINDOW_FOCUS_GAINED {
    WindowFocusGained
  } else if kind == EVENT_WINDOW_FOCUS_LOST {
    WindowFocusLost
  } else if kind == EVENT_DROP_BEGIN {
    DropBegin
  } else if kind == EVENT_DROP_FILE {
    DropFile(c_name(unsafe { raw.drop.data }))
  } else if kind == EVENT_DROP_COMPLETE {
    DropComplete
  } else if kind == EVENT_WINDOW_RESIZED {
    WindowResized(unsafe { raw.window.data1 }, unsafe { raw.window.data2 })
  } else if kind == EVENT_WINDOW_DISPLAY_SCALE_CHANGED {
    WindowScaleChanged
  } else if kind == EVENT_TERMINATING {
    Terminating
  } else if kind == EVENT_WILL_ENTER_BACKGROUND {
    WillEnterBackground
  } else if kind == EVENT_DID_ENTER_FOREGROUND {
    DidEnterForeground
  } else if kind == EVENT_GAMEPAD_BUTTON_DOWN {
    GamepadButtonDown(
      unsafe { raw.gamepad_button.which },
      unsafe { raw.gamepad_button.button }
    )
  } else if kind == EVENT_FINGER_DOWN {
    FingerDown(
      unsafe { raw.finger.finger },
      unsafe { raw.finger.x },
      unsafe { raw.finger.y }
    )
  } else if kind == EVENT_FINGER_MOTION {
    FingerMotion(
      unsafe { raw.finger.finger },
      unsafe { raw.finger.x },
      unsafe { raw.finger.y }
    )
  } else if kind == EVENT_FINGER_UP || kind == EVENT_FINGER_CANCELED {
    FingerUp(
      unsafe { raw.finger.finger },
      unsafe { raw.finger.x },
      unsafe { raw.finger.y }
    )
  } else if kind == EVENT_GAMEPAD_ADDED {
    GamepadAdded(unsafe { raw.device.which })
  } else if kind == EVENT_GAMEPAD_REMOVED {
    GamepadRemoved(unsafe { raw.device.which })
  } else {
    Other(kind)
  }
}
