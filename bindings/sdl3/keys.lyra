pub const MOD_RGUI: u16 = 0x0800
pub const MOD_NUM: u16 = 0x1000
pub const MOD_CAPS: u16 = 0x2000
pub const MOD_MODE: u16 = 0x4000
pub const MOD_SCROLL: u16 = 0x8000
pub const MOD_CTRL: u16 = 0x00c0
