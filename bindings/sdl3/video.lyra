module bindings.sdl3
//! Windows.

import std.ffi

/// An `SDL_Window *`.
///
/// **A `type` over a raw pointer**, which is the shape a C handle wants and costs
/// nothing: it is a `^u8` at run time, and `isFFISafe` looks through it, so an extern may
/// take one directly. What it buys is that a `Window` and a [Renderer] are different
/// types, where two bare `^u8`s are interchangeable and getting them the wrong way round
/// links cleanly.
///
/// It is deliberately **not** a struct wrapping the pointer: a handle is one machine word,
/// and the only operations on it are "hand it back to SDL" and "is it null".
pub type Window = ^u8

/// `SDL_WindowFlags` for [create_window], combined with `|`. `0` is an ordinary window.
pub const WINDOW_FULLSCREEN: u64 = 0x0000000000000001
pub const WINDOW_HIDDEN: u64 = 0x0000000000000008
/// Let the user resize the window. With a logical presentation the renderer rescales
/// on its own, so a program that set one has nothing to do when this happens.
pub const WINDOW_RESIZABLE: u64 = 0x0000000000000020
/// Ask for a backing store at the display's real pixel density.
pub const WINDOW_HIGH_PIXEL_DENSITY: u64 = 0x0000000000002000

/// Whether the system is set to a light or a dark appearance (`SDL_GetSystemTheme`) —
/// unknown where it does not say, or before SDL's video is started.
pub data SystemTheme = ThemeUnknown | ThemeLight | ThemeDark

pub let system_theme = () -> SystemTheme => match unsafe { sdl_get_system_theme() } {
  1 => ThemeLight,
  2 => ThemeDark,
  _ => ThemeUnknown,
}

@symbol("SDL_GetSystemTheme")
unsafe extern sdl_get_system_theme: () -> i32

@symbol("SDL_CreateWindow")
unsafe extern sdl_create_window: (title: ^u8, w: i32, h: i32, flags: u64) -> Window

@symbol("SDL_DestroyWindow")
unsafe extern sdl_destroy_window: (window: Window) -> void

@symbol("SDL_SetWindowFullscreen")
unsafe extern sdl_set_window_fullscreen: (window: Window, fullscreen: bool) -> bool

@symbol("SDL_SetWindowSize")
unsafe extern sdl_set_window_size: (window: Window, w: i32, h: i32) -> bool

@symbol("SDL_SetWindowMinimumSize")
unsafe extern sdl_set_window_minimum_size: (window: Window, w: i32, h: i32) -> bool

@symbol("SDL_SetWindowMaximumSize")
unsafe extern sdl_set_window_maximum_size: (window: Window, w: i32, h: i32) -> bool

@symbol("SDL_SetWindowResizable")
unsafe extern sdl_set_window_resizable: (window: Window, resizable: bool) -> bool

@symbol("SDL_SetWindowTitle")
unsafe extern sdl_set_window_title: (window: Window, title: ^u8) -> bool

/// Open a window, or `None` if SDL could not — [last_error] says why.
///
/// **This is where a C convention becomes the language's own.** SDL answers NULL on
/// failure, which is indistinguishable from success in a bare `^u8`; a `Maybe` makes the
/// failure a case the caller has to handle. The `extern` stays a transcription of the C
/// prototype and the interpretation happens here, which is the same division
/// `read_line`/`parse_i64` draws.
///
/// `with_cstring` lends the title's bytes for the call and takes them back, so no buffer
/// has to be kept alive by hand — and it is `pure noalloc`, since a Lyra string already
/// carries the NUL a C call needs.
pub let create_window = (
  title: string,
  width: i32,
  height: i32,
  flags: u64
) -> Maybe<Window> => {
  let w = title.with_cstring((t) => unsafe { sdl_create_window(t, width, height, flags) })
  if w == nullptr { None } else { Some(w) }
}

/// Close a window. The handle must not be used afterwards; nothing here can check that.
pub let destroy_window = (window: Window) -> void => unsafe { sdl_destroy_window(window) }

/// Enter or leave fullscreen — SDL's borderless desktop mode, which changes no display
/// mode and so is cheap to toggle.
pub let set_fullscreen = (window: Window, on: bool) -> bool =>
  unsafe { sdl_set_window_fullscreen(window, on) }

/// Resize the window's client area to `width` × `height` (in screen coordinates). Not in
/// fullscreen, where the size is the display's; SDL applies it on leaving.
pub let set_window_size = (window: Window, width: i32, height: i32) -> bool =>
  unsafe { sdl_set_window_size(window, width, height) }

/// The least size the user may make the window, in screen coordinates (`0, 0` for none) —
/// and [set_window_maximum_size] the greatest.
pub let set_window_minimum_size = (window: Window, width: i32, height: i32) -> bool =>
  unsafe { sdl_set_window_minimum_size(window, width, height) }

pub let set_window_maximum_size = (window: Window, width: i32, height: i32) -> bool =>
  unsafe { sdl_set_window_maximum_size(window, width, height) }

/// Whether the user may resize the window at all (`WINDOW_RESIZABLE` after it is made).
pub let set_window_resizable = (window: Window, resizable: bool) -> bool =>
  unsafe { sdl_set_window_resizable(window, resizable) }

/// The window's title bar.
pub let set_window_title = (window: Window, title: string) -> bool =>
  title.with_cstring((t) => unsafe { sdl_set_window_title(window, t) })

@symbol("SDL_GetWindowSize")
unsafe extern sdl_get_window_size: (window: Window, w: ^mut i32, h: ^mut i32) -> bool

@symbol("SDL_GetWindowDisplayScale")
unsafe extern sdl_get_window_display_scale: (window: Window) -> f32

@symbol("SDL_GetWindowPixelDensity")
unsafe extern sdl_get_window_pixel_density: (window: Window) -> f32

/// The window's size in its own coordinates — points, which a high-density display shows at
/// more than one pixel each; a mouse event's position is in the same coordinates.
pub let window_size = (window: Window) -> (i64, i64) => {
  var w: i32 = 0
  var h: i32 = 0
  unsafe { sdl_get_window_size(window, &mut w, &mut h) }
  (i64(w), i64(h))
}

/// How large the window's content should be drawn: the pixel density of a high-density
/// display times the scale the user chose for it (Windows' 150%, say). An interface laid
/// out in its own units draws at this many pixels a unit. `1.0` if SDL cannot say.
pub let window_display_scale = (window: Window) -> f32 => {
  let scale = unsafe { sdl_get_window_display_scale(window) }
  if scale > 0.0 { scale } else { 1.0 }
}

/// Pixels a point of the window's coordinates covers across: `2.0` on a Retina display,
/// `1.0` on most others — whatever scale the user chose, which [window_display_scale] has.
/// `1.0` if SDL cannot say.
pub let window_pixel_density = (window: Window) -> f32 => {
  let density = unsafe { sdl_get_window_pixel_density(window) }
  if density > 0.0 { density } else { 1.0 }
}
