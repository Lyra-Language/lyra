@link("lyra-menubar")
module bindings.menubar
//! A native menu bar for a program whose window belongs to SDL — on macOS the real one at
//! the top of the screen; elsewhere [install] answers `false` and nothing else happens.
//!
//! **Built, then read like events.** A program describes its menus once, [install]s them,
//! and each frame, after draining its window events, drains [poll_menu] for the tags of
//! items chosen since. Nothing calls back into Lyra — a chosen item is queued by the C
//! half (`menubar.m`), because AppKit calls a method on an object and Lyra cannot hand C a
//! function. SDL's event pump runs AppKit's, so a choice made by click or key equivalent is
//! queued during the program's own `poll_event`.
//!
//! ```
//! menu("File")
//! item("Save", "s", COMMAND, SAVE)
//! window_menu()
//! let native = install("My Game")
//! …
//! for running {
//!   // poll_event() until None, then:
//!   var choosing = true
//!   for choosing {
//!     match poll_menu() {
//!       None => { choosing = false },
//!       Some(tag) => on_menu(state, tag),
//!     }
//!   }
//! }
//! ```
//!
//! **A key equivalent reaches the program twice**: SDL reports ⌘S as a key press before
//! AppKit gives it to the menu. A program with a native menu leaves ⌘ keys to it.
//!
//! **The application menu is made for you** — Hide, Hide Others, Show All and Quit, which
//! sends `terminate:` and so reaches the program as SDL's quit event, like closing the
//! window. [install] replaces the bar SDL made at `init`, so call it after that.
//!
//! **The C half is an archive `build.sh` builds**: `build/lib/liblyra-menubar.a`, from
//! `menubar.m` on macOS and the do-nothing `menubar_stub.c` elsewhere, so a program using
//! this module links everywhere. `lyrac` searches the install's `lib/`, so a program built
//! with `build/lyrac` needs no `LIBRARY_PATH`. The archive names AppKit itself (autolinked
//! through `-fmodules`), which `@link` has no way to spell.

import std.ffi.{ with_cstrings }

/// Modifier bits for an [item]'s key equivalent, combined with `|`. ⌘ is `COMMAND`.
pub const COMMAND: u32 = 1
pub const SHIFT: u32 = 2
pub const OPTION: u32 = 4
pub const CONTROL: u32 = 8

/// Start a new top-level menu, after those already begun. Items added after this go in it.
pub let menu = (title: string) -> void => title.with_cstring((t) => unsafe {
  lyra_menubar_menu(t)
})

/// Add an item to the current menu. `key` is its key equivalent (`""` for none), shown
/// beside it and held with `mods`; a capital letter implies Shift, as AppKit has it.
/// `tag` is what [poll_menu] answers when the item is chosen — **zero or more**, and each
/// used once, since [set_checked] and [set_enabled] find the item by it.
pub let item = (title: string, key: string, mods: u32, tag: i32) -> void =>
  with_cstrings(title, key, (t, k) => unsafe { lyra_menubar_item(t, k, mods, tag) })

/// A line between items in the current menu.
pub let separator = () -> void => unsafe { lyra_menubar_separator() }

/// The standard Window menu — Minimize (⌘M), Zoom, Bring All to Front — at this position
/// in the bar. By convention it comes last but for Help.
pub let window_menu = () -> void => unsafe { lyra_menubar_window_menu() }

/// Put the menus built so far into the menu bar, after the application menu, whose items
/// are named for `app_name`. Answers whether there is a native menu bar: `false` off
/// macOS, where every other function here quietly does nothing.
pub let install = (app_name: string) -> bool => app_name.with_cstring((a) => unsafe {
  lyra_menubar_install(a)
})

/// The tag of the oldest item chosen and not yet read, or `None`.
pub let poll_menu = () -> Maybe<i32> => {
  let tag = unsafe { lyra_menubar_next() }
  if tag < 0 { None } else { Some(tag) }
}

/// Show a checkmark beside the item tagged `tag`, or take it away.
pub let set_checked = (tag: i32, checked: bool) -> void => unsafe {
  lyra_menubar_set_checked(tag, checked)
}

/// Let the item tagged `tag` be chosen, or grey it out.
pub let set_enabled = (tag: i32, enabled: bool) -> void => unsafe {
  lyra_menubar_set_enabled(tag, enabled)
}

@symbol("lyra_menubar_menu")
unsafe extern lyra_menubar_menu: (title: ^u8) -> void

@symbol("lyra_menubar_item")
unsafe extern lyra_menubar_item: (title: ^u8, key: ^u8, mods: u32, tag: i32) -> void

@symbol("lyra_menubar_separator")
unsafe extern lyra_menubar_separator: () -> void

@symbol("lyra_menubar_window_menu")
unsafe extern lyra_menubar_window_menu: () -> void

@symbol("lyra_menubar_install")
unsafe extern lyra_menubar_install: (app_name: ^u8) -> bool

@symbol("lyra_menubar_next")
unsafe extern lyra_menubar_next: () -> i32

@symbol("lyra_menubar_set_checked")
unsafe extern lyra_menubar_set_checked: (tag: i32, checked: bool) -> void

@symbol("lyra_menubar_set_enabled")
unsafe extern lyra_menubar_set_enabled: (tag: i32, enabled: bool) -> void
