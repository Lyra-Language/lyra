@link("lyra-menubar")
module bindings.menubar
//! A native menu bar for a program whose window belongs to SDL — on macOS the real one at
//! the top of the screen; elsewhere [install] answers `false` and nothing else happens.
//!
//! **Built, then read like events.** A program describes its menus once, [install]s them,
//! and each frame, after draining its window events, drains [poll_menu] for the tags of
//! items chosen since. Nothing calls back into Lyra — a chosen item is queued by the C
//! half (`menubar.m`), because AppKit calls a method on an object and Lyra cannot hand C a
//! function. SDL's event pump runs AppKit's, so a choice made by click or key equivalent is
//! queued during the program's own `poll_event`.
//!
//! ```
//! menu("File")
//! item("Save", "s", COMMAND, SAVE)
//! window_menu()
//! let native = install("My Game")
//! …
//! for running {
//!   // poll_event() until None, then:
//!   var choosing = true
//!   for choosing {
//!     match poll_menu() {
//!       None => { choosing = false },
//!       Some(tag) => on_menu(state, tag),
//!     }
//!   }
//! }
//! ```
//!
//! **A key equivalent reaches the program twice**: SDL reports ⌘S as a key press before
//! AppKit gives it to the menu. A program with a native menu leaves ⌘ keys to it.
//!
//! **The application menu is made for you** — Hide, Hide Others, Show All and Quit, which
//! sends `terminate:` and so reaches the program as SDL's quit event, like closing the
//! window. [install] replaces the bar SDL made at `init`, so call it after that.
//!
//! **A settings window comes the same way** ([grid_window]): rows of buttons, read with
//! [poll_menu] like items, and the keys pressed in it captured as SDL scancodes
//! ([capture_keys], [poll_key]) — a window of AppKit's own, whose keys SDL never sees.
//!
//! **The C half is an archive `build.sh` builds**: `build/lib/liblyra-menubar.a`, from
//! `menubar.m` on macOS and the do-nothing `menubar_stub.c` elsewhere, so a program using
//! this module links everywhere. `lyrac` searches the install's `lib/`, so a program built
//! with `build/lyrac` needs no `LIBRARY_PATH`. The archive names AppKit itself (autolinked
//! through `-fmodules`), which `@link` has no way to spell.

import std.ffi.{ with_cstrings, CBuffer, cstring_len }

/// Modifier bits for an [item]'s key equivalent, combined with `|`. ⌘ is `COMMAND`.
pub const COMMAND: u32 = 1
pub const SHIFT: u32 = 2
pub const OPTION: u32 = 4
pub const CONTROL: u32 = 8

/// Start a new top-level menu, after those already begun. Items added after this go in it.
/// A menu titled `Edit` holds only what is put in it: AppKit's own additions to an Edit
/// menu (Writing Tools, AutoFill, Dictation, Emoji & Symbols) are kept out.
pub let menu = (title: string) -> void => title.with_cstring((t) => unsafe {
  lyra_menubar_menu(t)
})

/// Start the application menu's own items — About, Settings — which [install] puts above
/// its Hide and Quit (it makes those itself). Items added after this go there, until the
/// next [menu].
pub let app_menu = () -> void => unsafe { lyra_menubar_app_menu() }

/// Add an item to the current menu. `key` is its key equivalent (`""` for none), shown
/// beside it and held with `mods`; a capital letter implies Shift, as AppKit has it.
/// `tag` is what [poll_menu] answers when the item is chosen — **zero or more**, and each
/// used once, since [set_checked] and [set_enabled] find the item by it.
pub let item = (title: string, key: string, mods: u32, tag: i32) -> void =>
  with_cstrings(title, key, (t, k) => unsafe { lyra_menubar_item(t, k, mods, tag) })

/// Start a submenu titled `title` in the current menu — File's Open Recent. Items added after
/// it go in it until [end_submenu]; submenus nest.
pub let submenu = (title: string) -> void => title.with_cstring((t) => unsafe {
  lyra_menubar_submenu(t)
})

/// Back to the menu the current submenu was begun in.
pub let end_submenu = () -> void => unsafe { lyra_menubar_end_submenu() }

/// A greyed title over the items after it, as macOS heads a section of a menu.
pub let header = (title: string) -> void => title.with_cstring((t) => unsafe {
  lyra_menubar_header(t)
})

/// A slider from `min` to `max`, set to `value`, as an item of the current menu. Moving it
/// makes [poll_menu] answer `tag`, as choosing an item does — once for a drag, however
/// long — and [slider_value] says where it was left. Like an item's, a tag is used once.
pub let slider = (min: f64, max: f64, value: f64, tag: i32) -> void => unsafe {
  lyra_menubar_slider(min, max, value, tag)
}

/// Where the slider tagged `tag` stands (0 for no such slider, or off macOS).
pub let slider_value = (tag: i32) -> f64 => unsafe { lyra_menubar_slider_value(tag) }

/// A line between items in the current menu.
pub let separator = () -> void => unsafe { lyra_menubar_separator() }

/// The standard Window menu — Minimize (⌘M), Zoom, Bring All to Front — at this position
/// in the bar. By convention it comes last but for Help.
pub let window_menu = () -> void => unsafe { lyra_menubar_window_menu() }

/// Put the menus built so far into the menu bar, after the application menu, whose items
/// are named for `app_name`. Answers whether there is a native menu bar: `false` off
/// macOS, where every other function here quietly does nothing.
pub let install = (app_name: string) -> bool => app_name.with_cstring((a) => unsafe {
  lyra_menubar_install(a)
})

/// The installed menu bar as text — a line a menu, its items indented beneath with their key
/// equivalents (`Cmd+Shift+S`), `[x]` when checked, `(off)` when greyed, `---` a separator,
/// a submenu's title ending ` >` with its items indented beneath it; then the grid window,
/// if there is one, `window <title>` and a line a row: its label, then `[title]` a button,
/// `(on)` when pressed in —
/// for a program's tests to read back what it installed. Empty off macOS.
pub let describe = () -> string => {
  let p = unsafe { lyra_menubar_describe() }
  if p.is_null() { return "" }
  CBuffer { ptr: p, len: unsafe { cstring_len(p) } }.decode_utf8()
}

/// The tag of the oldest item chosen and not yet read, or `None`.
pub let poll_menu = () -> Maybe<i32> => {
  let tag = unsafe { lyra_menubar_next() }
  if tag < 0 { None } else { Some(tag) }
}

/// Retitle the item — or grid window button — tagged `tag`.
pub let set_title = (tag: i32, title: string) -> void =>
  title.with_cstring((t) => unsafe {
    lyra_menubar_set_title(tag, t)
  })

/// Show a checkmark beside the item tagged `tag`, or take it away; a grid window button
/// shows pressed in.
pub let set_checked = (tag: i32, checked: bool) -> void => unsafe {
  lyra_menubar_set_checked(tag, checked)
}

/// Let the item (or grid window button) tagged `tag` be chosen, or grey it out.
pub let set_enabled = (tag: i32, enabled: bool) -> void => unsafe {
  lyra_menubar_set_enabled(tag, enabled)
}

// ── The grid window ──────────────────────────────────────────────────────────

/// Start a **grid window** — a settings window's rows of buttons — titled `title`, its
/// `columns` headed across the top (the first over the row labels, so usually `""`).
/// Built like the menus: [grid_row] begins a row, [grid_cell] adds a button to it, and a
/// button pressed is read with [poll_menu], by its tag, as a menu item is. Closing the
/// window answers `close_tag` there too. Replaces any grid window built before; shown,
/// laid out the first time, by [show_grid]. Nothing off macOS.
///
/// ```
/// grid_window("Settings", ["", "Key"], CLOSED)
/// grid_row("Jump")
/// grid_cell("Space", JUMP)
/// grid_note("Click a key's button, then press the key.")
/// // on the Settings… item:
/// show_grid()
/// ```
pub let grid_window = (title: string, columns: []string, close_tag: i32) -> void =>
  with_cstrings(title, columns.join("\t"), (t, c) => unsafe {
    lyra_menubar_grid_window(t, c, close_tag)
  })

/// Begin a row of the grid window, labelled `label` at its left.
pub let grid_row = (label: string) -> void => label.with_cstring((l) => unsafe {
  lyra_menubar_grid_row(l)
})

/// A button in the current row, titled `title`, its press answering `tag` from
/// [poll_menu]. [set_title] retitles it and [set_checked] shows it pressed in — the one
/// listening for a key, say.
pub let grid_cell = (title: string, tag: i32) -> void =>
  title.with_cstring((t) => unsafe {
    lyra_menubar_grid_cell(t, tag)
  })

/// A line of small text beneath the grid: what its buttons do.
pub let grid_note = (text: string) -> void => text.with_cstring((t) => unsafe {
  lyra_menubar_grid_note(t)
})

/// Show the grid window in front, and make it the key window.
pub let show_grid = () -> void => unsafe { lyra_menubar_show_grid() }

/// Whether keys pressed in the grid window are **captured** — kept for [poll_key] rather
/// than handed to AppKit — for a program asking which key to use for something. The window
/// is AppKit's, so SDL never sees them. A key held with ⌘ is never captured (⌘W still
/// closes the window); ⌘ and ⌃ themselves, Shift and Option are, as they are pressed.
/// Turning capture off forgets keys not yet read.
pub let capture_keys = (on: bool) -> void => unsafe { lyra_menubar_capture_keys(on) }

/// The SDL scancode (`bindings.sdl3`'s `SCANCODE_…`, the key's position) of the oldest key
/// captured and not yet read, or `None`.
pub let poll_key = () -> Maybe<u32> => {
  let scancode = unsafe { lyra_menubar_next_key() }
  if scancode == 0 { None } else { Some(scancode) }
}

/// A modal Open panel titled `title`, offering files with one of `extensions` (without the
/// dot; none for any file), and the path chosen — `None` if it was cancelled, or off macOS.
/// Modal: the program waits for the answer, and nothing calls back.
pub let choose_file = (title: string, extensions: []string) -> Maybe<string> => {
  let p = with_cstrings(title, extensions.join(","), (t, e) => unsafe {
    lyra_menubar_choose_file(t, e)
  })
  if p.is_null() { return None }
  // The shim keeps the path until the next call; this copies it out.
  Some(CBuffer { ptr: p, len: unsafe { cstring_len(p) } }.decode_utf8())
}

/// A modal alert: `message`, with `detail` beneath it, and an OK button. Nothing off macOS.
pub let alert = (message: string, detail: string) -> void =>
  with_cstrings(message, detail, (m, d) => unsafe { lyra_menubar_alert(m, d) })

