@link("SDL3_image")
module bindings.sdl3_image
//! SDL3_image: PNG (and JPEG, WebP, …) files straight to a texture.
//!
//! **A module of its own because it is a library of its own**: a program that never loads
//! an image should not link `SDL3_image`, and `@link` is per module. It builds on
//! `bindings.sdl3` — the [Texture] it answers is that module's, released by its
//! `destroy_texture`.
//!
//! `brew install sdl3_image` (Debian: `libsdl3-image-dev`); Homebrew puts it beside SDL3,
//! so the same `LIBRARY_PATH` finds both.

import bindings.sdl3.{ Renderer, Texture, adopt_texture }
import std.ffi

@symbol("IMG_LoadTexture")
unsafe extern img_load_texture: (renderer: Renderer, file: ^u8) -> ^u8

/// Load an image file as a texture for `renderer`, or `None` if it cannot be read or
/// decoded — `last_error()` says which.
///
/// The texture is sampled with the renderer's default scale mode *at the time of the
/// call*, so a pixel-art program sets `SCALE_NEAREST` first.
pub let load_texture = (renderer: Renderer, path: string) -> Maybe<Texture> => {
  let handle = path.with_cstring((p) => unsafe { img_load_texture(renderer, p) })
  unsafe { adopt_texture(handle) }
}
