@link("tree-sitter")
module bindings.treesitter
//! The tree-sitter runtime: a parser, the tree it builds, and the nodes of that tree.
//!
//! Enough of `tree_sitter/api.h` for a tree walk — parse a string, take the root, visit
//! children by index, read each node's kind and byte span. Queries, cursors and editing are
//! not bound. A grammar is a separate symbol (`tree_sitter_lyra`, in `lyra_grammar.lyra`).
//!
//! **A `TSNode` crosses by value**: four `u32` of context and two pointers, 32 bytes the
//! runtime hands back and takes again on every call. It is spelled here with the four
//! words as fields rather than a `[4]u32`, the same layout either way, and nothing reads
//! them: a node is opaque to Lyra and only ever handed back to the runtime.
//!
//! Link with `-ltree-sitter`: `brew install tree-sitter` or `libtree-sitter-dev`, with its
//! directory on `LIBRARY_PATH` (`pkg-config --variable=libdir tree-sitter`).

import std.ffi.{ CBuffer, cstring, cstring_len, data, decode_utf8, is_null }

/// A grammar, as its generated `tree_sitter_<name>()` answers it.
pub struct Language {
  raw: ^u8,
}

/// A parser; set to one language, reusable across many strings. Release with
/// `parser_delete`.
@must_release(parser_delete)
pub struct Parser {
  raw: ^u8,
}

/// A parsed tree. Its nodes are valid while it lives; release with `tree_delete`.
@must_release(tree_delete)
pub struct Tree {
  raw: ^u8,
}

/// A node of a tree: a position in the parse, valid while its tree is.
pub struct Node {
  c0: u32,
  c1: u32,
  c2: u32,
  c3: u32,
  id: ^u8,
  tree: ^u8,
}

/// A parser for `language`, or `None` if the runtime refuses the grammar (a version it
/// cannot load).
pub let new_parser = (language: Language) -> Maybe<Parser> => {
  let raw = unsafe { ts_parser_new() }
  if raw.is_null() { return None }
  if !unsafe { ts_parser_set_language(raw, language.raw) } {
    unsafe { ts_parser_delete(raw) }
    return None
  }
  Some(Parser { raw: raw })
}

/// Releases a parser.
pub let parser_delete = (parser: own Parser) -> void =>
  unsafe { ts_parser_delete(parser.raw) }

/// Parses `source` into a tree, or `None` if the parser has no language or was
/// cancelled. A syntax error is not a failure here: the tree carries `ERROR` nodes, which
/// `has_error` reports.
pub let parse = (parser: Parser, source: string) -> Maybe<Tree> => {
  let bytes = source.cstring()
  let raw = unsafe { ts_parser_parse_string(
    parser.raw,
    nullptr,
    bytes.data(),
    u32(bytes.len() - 1)
  ) }
  if raw.is_null() { None } else { Some(Tree { raw: raw }) }
}

/// Releases a tree; its nodes are invalid afterwards.
pub let tree_delete = (tree: own Tree) -> void => unsafe { ts_tree_delete(tree.raw) }

/// The tree's root node.
pub let root = (tree: Tree) -> Node => unsafe { ts_tree_root_node(tree.raw) }

/// The node's kind, as the grammar names it (`"call_expr"`, `"identifier"`, `"("`).
pub let kind = (node: Node) -> string => {
  let p = unsafe { ts_node_type(node) }
  let len = unsafe { cstring_len(p) }
  CBuffer { ptr: p, len: len }.decode_utf8()
}

/// The byte offset where the node's text starts.
pub let start_byte = (node: Node) -> i64 => i64(unsafe { ts_node_start_byte(node) })

/// The byte offset just past the node's text.
pub let end_byte = (node: Node) -> i64 => i64(unsafe { ts_node_end_byte(node) })

/// How many children the node has, named and anonymous alike.
pub let child_count = (node: Node) -> i64 => i64(unsafe { ts_node_child_count(node) })

/// The node's `i`th child, counting anonymous tokens.
///
/// # Panics
/// Traps when `i` is out of range, as `xs[i]` does.
pub let child = (node: Node, i: i64) -> Node => {
  if i < 0 || i >= child_count(node) { panic("child: index out of range") }
  unsafe { ts_node_child(node, u32(i)) }
}

/// Whether the node is a named rule rather than an anonymous token.
pub let is_named = (node: Node) -> bool => unsafe { ts_node_is_named(node) }

/// Whether the node or anything under it is a syntax error or a missing token.
pub let has_error = (node: Node) -> bool => unsafe { ts_node_has_error(node) }

/// The child the grammar gives `name` for this node (`"body"`, `"condition"`), or `None`
/// when the field is absent — an optional field the source did not fill, or a name this
/// node's rule does not have.
///
/// **A `Maybe`, and that is the point of binding it this way.** The C function answers a
/// *null node* for an absent field, a value that looks like every other node and whose
/// accessors are undefined behaviour rather than an error. Go's binding has the same shape
/// and it is the compiler's hazard 2: `ChildByFieldName` returns a real nil, and calling
/// `ChildCount` on it **hangs inside the CGO binding** rather than panicking, so the
/// mistake presents as a wedged editor. Here the absent case has no Node to call anything
/// on, and a caller that forgets it does not compile. The collector asks this question
/// more than any other, which is what makes it worth the wrapper.
pub let field = (node: Node, name: string) -> Maybe<Node> => {
  // The byte length, not `name.len()`: that counts runes, and a field name being ASCII
  // today is not a reason to write the line that stops being true.
  var spelling = name.cstring()
  let found = unsafe {
    ts_node_child_by_field_name(node, &spelling[0], u32(spelling.len() - 1))
  }
  if unsafe { ts_node_is_null(found) } { None } else { Some(found) }
}

/// How many **named** children the node has — its rule's own children, without the
/// punctuation. A walk over a list's elements wants this rather than `child_count`.
///
/// A comment is a named node and can sit anywhere `extras` allows, so this count includes
/// comments; the compiler's hazard 16 is exactly that mistake made once already.
pub let named_child_count = (node: Node) -> i64 =>
  i64(unsafe { ts_node_named_child_count(node) })

/// The node's `i`th named child.
///
/// # Panics
/// Traps when `i` is out of range, as `xs[i]` does.
pub let named_child = (node: Node, i: i64) -> Node => {
  if i < 0 || i >= named_child_count(node) { panic("named_child: index out of range") }
  unsafe { ts_node_named_child(node, u32(i)) }
}

/// Whether the node is one the parser *inserted* to recover — a token the grammar required
/// and the source did not have. It occupies no bytes, so it is invisible to a walk that
/// only reads spans, and it is not an `ERROR` node either: `has_error` is true for the tree
/// but the node itself reads as an ordinary one of its kind.
pub let is_missing = (node: Node) -> bool => unsafe { ts_node_is_missing(node) }

/// The node's own text, from the source's **bytes**.
///
/// `source` is the byte view (`s.cstring()`), not the string: every offset tree-sitter
/// reports counts bytes, while a Lyra `string` slices by rune, so indexing the string with
/// these numbers silently reads the wrong text the moment the file is not ASCII. Taking
/// the byte array as a parameter makes that impossible to get wrong at a call site, and
/// costs the caller one `cstring()` for the whole file rather than one per token.
pub let text = (node: Node, source: []u8) -> string =>
  source.slice(start_byte(node), end_byte(node)).decode_utf8()

// ---------------------------------------------------------------------------------------
// Foreign declarations
// ---------------------------------------------------------------------------------------

@symbol("ts_parser_new")
unsafe extern ts_parser_new: () -> ^u8
@symbol("ts_parser_delete")
unsafe extern ts_parser_delete: (parser: ^u8) -> void
@symbol("ts_parser_set_language")
unsafe extern ts_parser_set_language: (parser: ^u8, language: ^u8) -> bool
@symbol("ts_parser_parse_string")
unsafe extern ts_parser_parse_string: (
  parser: ^u8,
  old_tree: ^u8,
  source: ^u8,
  length: u32
) -> ^u8
@symbol("ts_tree_delete")
unsafe extern ts_tree_delete: (tree: ^u8) -> void
@symbol("ts_tree_root_node")
unsafe extern ts_tree_root_node: (tree: ^u8) -> Node
@symbol("ts_node_type")
unsafe extern ts_node_type: (node: Node) -> ^u8
@symbol("ts_node_start_byte")
unsafe extern ts_node_start_byte: (node: Node) -> u32
@symbol("ts_node_end_byte")
unsafe extern ts_node_end_byte: (node: Node) -> u32
@symbol("ts_node_child_count")
unsafe extern ts_node_child_count: (node: Node) -> u32
@symbol("ts_node_child")
unsafe extern ts_node_child: (node: Node, index: u32) -> Node
@symbol("ts_node_is_named")
unsafe extern ts_node_is_named: (node: Node) -> bool
@symbol("ts_node_has_error")
unsafe extern ts_node_has_error: (node: Node) -> bool
@symbol("ts_node_child_by_field_name")
unsafe extern ts_node_child_by_field_name: (node: Node, name: ^u8, name_len: u32) -> Node
@symbol("ts_node_is_null")
unsafe extern ts_node_is_null: (node: Node) -> bool
@symbol("ts_node_named_child_count")
unsafe extern ts_node_named_child_count: (node: Node) -> u32
@symbol("ts_node_named_child")
unsafe extern ts_node_named_child: (node: Node, index: u32) -> Node
@symbol("ts_node_is_missing")
unsafe extern ts_node_is_missing: (node: Node) -> bool
