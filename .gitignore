.DS_Store

# Build output (./build.sh): the binaries plus a `std` symlink. Ignored as a
# directory rather than binary-by-binary, so a new command cannot land in the source
# tree unnoticed — and so a stale compiler is one `rm -rf build` away rather than
# something that sits in the root for months looking like a source file.
/build/

# Coverage profiles (generated by CI and `go test -coverprofile`)
cover.out

# Test binaries and profiles left behind by `go test -cpuprofile`/`-bench`.
# They are build artifacts of a measurement, not of the project.
*.test
*.out

# Dear ImGui saves its window layout beside whatever ran it (examples/imgui). Where the
# layout lives is the host's to choose eventually; until then, never a source file.
imgui.ini
